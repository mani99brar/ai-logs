export const meta = {
  name: 'review-visibility-audit',
  description: 'Adversarial audit of the PRD_REVIEW_VISIBILITY implementation: dimension finders, then per-finding refutation panel',
  phases: [{ title: 'Find', detail: 'six lenses over the uncommitted diff vs the PRDs' }, { title: 'Verify', detail: 'three skeptics per finding, majority refutes' }],
}

const REPO = '/home/agentops/dev/md-manager-ultra'
const SPEC = '/tmp/claude-1000/-home-agentops-dev-md-manager-ultra/9ef1cac0-1832-43a8-bc1f-712f36914ef4/scratchpad/DESIGN_REVIEW_VISIBILITY.md'

const FINDINGS = {
  type: 'object', required: ['findings'],
  properties: { findings: { type: 'array', items: { type: 'object', required: ['title', 'file', 'severity', 'evidence', 'failure'], properties: {
    title: { type: 'string' }, file: { type: 'string', description: 'repo-relative path and line if known' },
    severity: { type: 'string', enum: ['P0', 'P1', 'P2'] },
    evidence: { type: 'string', description: 'what you read or ran that shows the defect' },
    failure: { type: 'string', description: 'concrete input/state -> wrong outcome' },
    fix: { type: 'string' },
  } } } },
}
const VERDICT = { type: 'object', required: ['refuted', 'reason'], properties: { refuted: { type: 'boolean' }, reason: { type: 'string' }, severity: { type: 'string', enum: ['P0', 'P1', 'P2'] } } }

const context = `Repository: ${REPO} (git branch ultra; the work is UNCOMMITTED: inspect it with "git status" and "git diff" plus the untracked files). Read-only audit: do not edit files, do not commit. You may run tests and scripts (Python: /home/agentops/dev/md-manager/.venv/bin/python; never run the Playwright browser suite, it is slow and stateful; never touch ~/.local/state/md-manager-workflows). Requirements: docs/PRD_REVIEW_VISIBILITY.md, docs/PRD_REVIEWER_PANE.md, docs/PRD_REVIEW_RESULT.md, docs/PRD_RUN_INPUTS.md, and the design spec at ${SPEC}. The handoff draft docs/HANDOFF_REVIEW_VISIBILITY.md summarises what was built. Report only defects you can point at with file and line and a concrete failure; skip style. Return an empty list if you find nothing real.`

const LENSES = [
  { key: 'controller-protocol', prompt: `${context}\n\nLENS: correctness and fail-closed behaviour of the slice A controller (workflow/automatic.py, workflow/interactive.py, workflow/pipeline.py). Hunt for: any path that launches a second reviewer; resume paths that do not reconcile the same session; a completion file accepted without every binding (run_id, node_id, launch_token, bundle_sha256, candidate_commit, schema) or while the session is working; identity checks that can be bypassed; stop logic that can signal the wrong session; KeyboardInterrupt handling that marks the receipt blocked or stops the reviewer; export CLI that could launch or mutate; regressions to existing worker behaviour; wait loops that spin without sleeping; exceptions that leave receipts inconsistent. Read the tests and check whether they actually exercise these paths.` },
  { key: 'adapter-security', prompt: `${context}\n\nLENS: server adapter (server/projects.ts, server/projectRoutes.ts, server/projects.test.ts). Hunt for: absolute paths or run-directory names leaking through any new payload or error message; unbounded reads; the review diff artifact served without hash/size verification or via symlinks; requirement_found_in computed on redacted text or with fuzzy matching; routes reachable with other methods; malformed export sections that crash instead of RUN_STORAGE_INVALID; contract conformance gaps (payload not validated before send); legacy 1.0.0 exports that now fail; the review node's session_id/result_uri taken from values; timestamp normalisation bugs; truncation splitting escapes.` },
  { key: 'export-shape-consistency', prompt: `${context}\n\nLENS: shape consistency across the three producers/consumers of run-state.json 1.2.0: workflow/export_state.py (writes), server/projects.ts reviewSectionSchema/inputsSectionSchema (reads strictly), tests/project-workflows/seed.ts (mimics the writer for candidate-mode browser tests), plus the contract payload schemas in contracts/projects/v1.ts. Find every field where one side writes something another side rejects or drops (types, nullability, key names, timestamp formats, worker keys, diff path, mode mapping, argv/command). Actually exercise it: build a run directory with the Python export (see workflow/test_export.py for a fixture) and feed the resulting run-state.json to the adapter via a small tsx script or the existing test harness; report any RUN_STORAGE_INVALID.` },
  { key: 'prd-completeness', prompt: `${context}\n\nLENS: PRD completeness. For every work item and acceptance criterion in the three slice PRDs (PRD_REVIEWER_PANE.md sections 3-5, PRD_REVIEW_RESULT.md sections 2-4, PRD_RUN_INPUTS.md sections 3-6) and every row of the "What is shown" table, locate the implementing code and the test that proves it. Report each item that is missing, only partially implemented, implemented differently from the PRD without being recorded in docs/HANDOFF_REVIEW_VISIBILITY.md section 6 or the PRD decisions log, or "proven" only by a test that does not assert the PRD's claim. Include docs the PRDs require (RUNBOOK, feature README) if they misdescribe behaviour.` },
  { key: 'ui-and-tests', prompt: `${context}\n\nLENS: the viewer (src/projects/**, src/App.css) and the browser tests (tests/project-workflows/**). Hunt for: scenarios whose assertions do not match the PRD tables (PRD_REVIEW_RESULT.md section 4, PRD_RUN_INPUTS.md section 6); tests that pass trivially (assertions on fixtures instead of the rendered page, optional assertions, phase-conditional weakening); mocks that diverge from the real adapter's payloads; seeds that would be rejected by the real adapter; UI states that can throw (null review, missing inputs, legacy runs, result_uri outside the reviews route, blocked review); quote highlighting that can miss or double-mark; accessibility regressions (tablist without keyboard, missing labels); layout overflow at 420px; anything that fetches outside the run's scoped routes.` },
  { key: 'python-tests-honesty', prompt: `${context}\n\nLENS: are the Python tests honest? Read workflow/test_automatic.py, workflow/test_pipeline.py, workflow/test_interactive.py, workflow/test_export.py. For each test that claims to cover a PRD acceptance item (three-process recovery with an interrupted reviewer, rejected completion files, deadline, print fallback, blocked state, export re-export, feature launch), check that the assertion would fail if the behaviour regressed (e.g. delete the relevant production line mentally or actually run a quick mutation with a temporary copy under /tmp, never editing the repo). Report tests that pass vacuously, mock the very thing under test, or leave a PRD claim untested.` },
]

phase('Find')
const found = (await parallel(LENSES.map(lens => () => agent(lens.prompt, { label: `find:${lens.key}`, phase: 'Find', schema: FINDINGS })))).filter(Boolean).flatMap((result, index) => result.findings.map(finding => ({ ...finding, lens: LENSES[index].key })))
log(`${found.length} raw findings`)

const seen = new Set()
const unique = found.filter(finding => { const key = `${finding.file}|${finding.title}`.toLowerCase(); if (seen.has(key)) return false; seen.add(key); return true })
log(`${unique.length} unique findings to verify`)

phase('Verify')
const verified = await parallel(unique.map(finding => () =>
  parallel(['reproduce it from the code and tests: default to refuted unless you can show the concrete failing path', 'argue the opposite: find the check or test that already prevents it; refuted=true if such protection exists', 'assess whether it matters against the PRDs and the fail-closed philosophy: refuted=true if it is style, speculative, or explicitly accepted in docs/HANDOFF_REVIEW_VISIBILITY.md section 6 or the PRD decisions log'].map((stance, index) => () =>
    agent(`${context}\n\nA reviewer claims (lens ${finding.lens}, severity ${finding.severity}): "${finding.title}" in ${finding.file}. Evidence given: ${finding.evidence}. Failure claimed: ${finding.failure}. Suggested fix: ${finding.fix ?? 'none'}.\n\nYour stance: ${stance}. Be rigorous and specific; cite file and line. Set refuted=true if the claim is wrong, already handled, or not a real defect; refuted=false only if you confirm it. Also give your own severity.`, { label: `verify:${finding.lens}:${index}`, phase: 'Verify', schema: VERDICT })))
    .then(votes => ({ finding, votes: votes.filter(Boolean) }))))
const confirmed = verified.filter(Boolean).filter(item => item.votes.length > 0 && item.votes.filter(vote => !vote.refuted).length >= 2)
  .map(item => ({ ...item.finding, verdicts: item.votes.map(vote => `${vote.refuted ? 'refuted' : 'confirmed'} (${vote.severity ?? '?'}): ${vote.reason}`) }))
const refuted = verified.filter(Boolean).filter(item => !(item.votes.filter(vote => !vote.refuted).length >= 2)).map(item => ({ title: item.finding.title, file: item.finding.file, reasons: item.votes.map(vote => vote.reason) }))
log(`${confirmed.length} confirmed, ${refuted.length} refuted`)
return { confirmed, refuted }
