import { createHash } from 'node:crypto'
import { lstat, readFile as defaultReadFile } from 'node:fs/promises'
import { isAbsolute, join, relative, resolve, sep } from 'node:path'

export type Source = 'Pi' | 'Claude'

/** The only directories a request can ever address. A request source is mapped, never used as a directory name. */
const SOURCE_DIRECTORIES: Readonly<Record<Source, string>> = { Pi: 'pi', Claude: 'claude' }

export function isSource(value: unknown): value is Source {
  return value === 'Pi' || value === 'Claude'
}

export function isMarkdownName(name: string): boolean {
  return name.toLowerCase().endsWith('.md')
}

/** A rejected request. `status` is the HTTP status; `message` is safe to send to the client. */
export class PathError extends Error {
  readonly status: 400 | 404
  constructor(status: 400 | 404, message: string) {
    super(message)
    this.status = status
  }
}

const INVALID_PATH = 'The file path is invalid.'
const NOT_FOUND = 'The file was not found or is not a Markdown file.'

/**
 * Splits a relative path into safe components. Rejects before any normalisation: `..` and `.` components,
 * empty components (leading, trailing or doubled separators), backslashes, NULs and absolute forms,
 * including Windows drive letters and UNC prefixes.
 */
export function splitRelativePath(path: string): string[] {
  if (typeof path !== 'string' || path.length === 0) throw new PathError(400, INVALID_PATH)
  if (path.includes('\0') || path.includes('\\')) throw new PathError(400, INVALID_PATH)
  if (path.startsWith('/') || isAbsolute(path) || /^[A-Za-z]:/.test(path)) throw new PathError(400, INVALID_PATH)
  const components = path.split('/')
  for (const component of components) {
    if (component === '' || component === '.' || component === '..') throw new PathError(400, INVALID_PATH)
  }
  return components
}

export type ResolvedFile = { source: Source; path: string; absolutePath: string }

/**
 * The shared filesystem validator for every route that takes a path. It maps the source to its fixed
 * directory, validates the relative components, checks containment on the resolved path, then walks the
 * real filesystem from the source root to the target so that no symlink at any level is ever followed.
 * The target must be a regular Markdown file; anything else is reported as not found.
 */
export async function resolveMarkdownFile(root: string, source: unknown, path: unknown): Promise<ResolvedFile> {
  if (!isSource(source)) throw new PathError(400, 'The source must be Pi or Claude.')
  if (typeof path !== 'string') throw new PathError(400, INVALID_PATH)
  const components = splitRelativePath(path)
  const sourceRoot = resolve(root, SOURCE_DIRECTORIES[source])
  const absolutePath = resolve(sourceRoot, ...components)
  const inside = relative(sourceRoot, absolutePath)
  if (!inside || inside === '..' || inside.startsWith(`..${sep}`) || isAbsolute(inside)) {
    throw new PathError(400, INVALID_PATH)
  }
  if (!isMarkdownName(components[components.length - 1])) throw new PathError(404, NOT_FOUND)

  const rootStats = await lstat(sourceRoot).catch(() => null)
  if (!rootStats || rootStats.isSymbolicLink() || !rootStats.isDirectory()) throw new PathError(404, NOT_FOUND)
  let current = sourceRoot
  for (let i = 0; i < components.length; i += 1) {
    current = join(current, components[i])
    const stats = await lstat(current).catch(() => null)
    if (!stats || stats.isSymbolicLink()) throw new PathError(404, NOT_FOUND)
    const isLast = i === components.length - 1
    if (isLast ? !stats.isFile() : !stats.isDirectory()) throw new PathError(404, NOT_FOUND)
  }
  return { source, path: components.join('/'), absolutePath }
}

export type ReadFile = (path: string) => Promise<Buffer>

export type FileDocument = { source: Source; path: string; content: string; hash: string }

/** Reads the bytes once; the content and the SHA-256 digest both come from that single read. */
export async function readMarkdownFile(root: string, source: unknown, path: unknown, readFile: ReadFile = defaultReadFile): Promise<FileDocument> {
  const file = await resolveMarkdownFile(root, source, path)
  const bytes = await readFile(file.absolutePath)
  return {
    source: file.source,
    path: file.path,
    content: bytes.toString('utf8'),
    hash: createHash('sha256').update(bytes).digest('hex'),
  }
}
