import { MAX_INPUT_MESSAGES_PER_SECOND, validateDuelInputMessage, type DuelInputMessage } from "@pirate-sea-race/protocol";
import type { DropReason } from "./inputGate.js";

const TICKS_PER_SECOND = 60;

/**
 * One duel client's input channel on the server, with the world input gate's limits unchanged: at most
 * MAX_INPUT_MESSAGES_PER_SECOND messages per second of room time, MAX_INPUT_MESSAGE_BYTES each, sequence numbers
 * strictly increasing, and no frame more than MAX_INPUT_LEAD_FRAMES past the server's. Every drop is counted.
 * Accepted messages go on to the duel authority, which keeps the first copy of each frame's input.
 */
export class DuelInputGate {
  private lastAcceptedSeq = 0;
  private windowStart = Number.NEGATIVE_INFINITY;
  private windowCount = 0;
  readonly dropped: Record<DropReason, number> = {
    "rate-limited": 0,
    oversized: 0,
    malformed: 0,
    "stale-sequence": 0,
    "future-frame": 0,
  };

  /**
   * Takes one untrusted message at room tick `tick` (60 a second, for the rate window) when the duel's current frame
   * is `serverFrame` (negative during the countdown). Returns the accepted message, or undefined when it was dropped.
   */
  receive(message: unknown, tick: number, serverFrame: number): DuelInputMessage | undefined {
    if (tick - this.windowStart >= TICKS_PER_SECOND) {
      this.windowStart = tick;
      this.windowCount = 0;
    }
    if (++this.windowCount > MAX_INPUT_MESSAGES_PER_SECOND) {
      this.dropped["rate-limited"]++;
      return undefined;
    }
    const result = validateDuelInputMessage(message, { lastAcceptedSeq: this.lastAcceptedSeq, serverFrame });
    if (!result.ok) {
      this.dropped[result.reason]++;
      return undefined;
    }
    this.lastAcceptedSeq = result.input.seq;
    return result.input;
  }
}
