  for (const folder of ['Zeta', 'alpha', '10-ten', '2-two']) await scratch.dir('pi', dir, folder)
  for (const file of ['b.md', 'A.md', 'UPPER.MD', 'notes.txt', 'readme.markdown', 'x.md.bak']) await scratch.file('pi', dir, file)

  await page.goto(href('pi', dir))
  await expect(rowNames(page)).toHaveText(['2-two', '10-ten', 'alpha', 'Zeta', 'A.md', 'b.md', 'UPPER.MD'])
  await expect(counts(page)).toHaveText('4 folders · 3 files')
  await expect(page.getByText('notes.txt')).toHaveCount(0)
  await expect(page.getByText('readme.markdown')).toHaveCount(0)

  const fileRow = rows(page).filter({ hasText: 'A.md' })
  await expect(fileRow.getByRole('link')).toHaveCount(0)
  await expect(fileRow.locator('.row')).toHaveCSS('cursor', 'default')
  await expect(rows(page).filter({ hasText: 'alpha' }).locator('.row')).toHaveCSS('cursor', 'pointer')
})

