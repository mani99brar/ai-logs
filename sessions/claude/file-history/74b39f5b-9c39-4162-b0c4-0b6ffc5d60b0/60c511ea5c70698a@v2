/// <reference lib="dom" />
import { test as base, expect, type Page } from '@playwright/test'
import { mkdir, rm, writeFile } from 'node:fs/promises'
import { execFile } from 'node:child_process'
import { promisify } from 'node:util'
import { fileURLToPath } from 'node:url'
import { join } from 'node:path'
import { randomUUID } from 'node:crypto'

const fixtureRoot = fileURLToPath(new URL('../fixtures/', import.meta.url))
const apiUrl = 'http://127.0.0.1:3001/api/entries'
const run = promisify(execFile)

type SourceSlug = 'pi' | 'claude'

/**
 * Mutation-based setup: every artifact lives under a uniquely named directory inside a committed source folder
 * and is removed when the test ends, whether it passed or failed. Committed sample files are never touched.
 */
class Scratch {
  private readonly created: string[] = []

  /** Creates a uniquely named directory directly under fixtures/<source>/ and returns its name. */
  async root(source: SourceSlug, suffix = ''): Promise<string> {
    const name = `pw-${randomUUID().slice(0, 8)}${suffix}`
    const absolute = join(fixtureRoot, source, name)
    await mkdir(absolute)
    this.created.push(absolute)
    return name
  }

  async dir(source: SourceSlug, ...segments: string[]): Promise<void> {
    await mkdir(join(fixtureRoot, source, ...segments), { recursive: true })
  }

  async file(source: SourceSlug, ...segments: string[]): Promise<void> {
    await mkdir(join(fixtureRoot, source, ...segments.slice(0, -1)), { recursive: true })
    await writeFile(join(fixtureRoot, source, ...segments), '')
  }

  async remove(source: SourceSlug, ...segments: string[]): Promise<void> {
    await rm(join(fixtureRoot, source, ...segments), { recursive: true, force: true })
  }

  async cleanup(): Promise<void> {
    for (const path of this.created.splice(0)) await rm(path, { recursive: true, force: true })
  }
}

const test = base.extend<{ scratch: Scratch }>({
  // eslint-disable-next-line no-empty-pattern -- Playwright fixture signature
  scratch: async ({}, provide) => {
    const scratch = new Scratch()
    try {
      await provide(scratch)
    } finally {
      await scratch.cleanup()
    }
  },
})

const href = (source: SourceSlug, ...segments: string[]) => '/' + [source, ...segments].map(encodeURIComponent).join('/')

const rows = (page: Page) => page.locator('.rows > li')
const rowNames = (page: Page) => page.locator('.rows .row__name')
const folderRow = (page: Page, name: string) => page.getByRole('link', { name: `${name} Folder`, exact: true })
const refreshButton = (page: Page) => page.getByRole('button', { name: 'Refresh' })
const counts = (page: Page) => page.locator('.counts')
const crumbs = (page: Page) => page.getByRole('navigation', { name: 'Breadcrumb' })
const status = (page: Page) => page.getByRole('status')

test.beforeAll(async ({ request }) => {
  await expect.poll(async () => (await request.get(apiUrl)).status(), { timeout: 30_000 }).toBe(200)
})

test('home lists both sources as navigable rows and each opens its root', async ({ page }) => {
  await page.goto('/')
  await expect(crumbs(page).locator('[aria-current="page"]')).toHaveText('Home')
  await expect(page.getByRole('link', { name: 'Pi Source', exact: true })).toBeVisible()
  await expect(page.getByRole('link', { name: 'Claude Source', exact: true })).toBeVisible()

  await page.getByRole('link', { name: 'Pi Source' }).click()
  await expect(page).toHaveURL('/pi')
  await expect(rowNames(page)).toHaveText(['skills', 'workflow.md'])
  await expect(folderRow(page, 'skills')).toBeVisible()
  await expect(counts(page)).toHaveText('1 folder · 1 file')
  await expect(page.getByText('notes.txt')).toHaveCount(0)

  await page.goto('/claude')
  await expect(rowNames(page)).toHaveText(['subagents', 'empty.md', 'workflow.md'])
  await expect(counts(page)).toHaveText('1 folder · 2 files')
  // Duplicate filenames stay distinguishable by source: same name, different breadcrumb and URL.
  await expect(crumbs(page).locator('[aria-current="page"]')).toHaveText('Claude')
})

