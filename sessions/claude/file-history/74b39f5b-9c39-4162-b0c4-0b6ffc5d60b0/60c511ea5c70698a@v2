for (const failure of ['http', 'network'] as const) {
  test(`initial ${failure} failure shows an error with a working Retry`, async ({ page }) => {
    await page.route('**/api/entries', route => failure === 'http'
      ? route.fulfill({ status: 500, json: { error: 'Listing failed' } })
      : route.abort())
    await page.goto('/pi')
