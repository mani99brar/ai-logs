test('refresh reflects additions and removals, keeps the current folder, and updates counts together', async ({ page, scratch }) => {
  const dir = await scratch.root('pi')
  await scratch.file('pi', dir, 'one.md')

  await page.goto(href('pi', dir))
  await expect(rowNames(page)).toHaveText(['one.md'])
  await expect(counts(page)).toHaveText('0 folders · 1 file')

  await scratch.file('pi', dir, 'two.md')
  await scratch.dir('pi', dir, 'sub')
  await refreshButton(page).focus()
  await page.keyboard.press('Enter')
  await expect(status(page)).toHaveText('Listing refreshed.')
  await expect(rowNames(page)).toHaveText(['sub', 'one.md', 'two.md'])
  await expect(counts(page)).toHaveText('1 folder · 2 files')
  await expect(page).toHaveURL(href('pi', dir))
  await expect(refreshButton(page)).toBeFocused()

  await scratch.remove('pi', dir, 'two.md')
  await scratch.remove('pi', dir, 'sub')
  await refreshButton(page).click()
  await expect(rowNames(page)).toHaveText(['one.md'])
  await expect(counts(page)).toHaveText('0 folders · 1 file')
})

test('refresh is disabled while pending and sends a single request', async ({ page }) => {
  await page.goto('/pi')
  await expect(folderRow(page, 'skills')).toBeVisible()

  let release!: () => void
  const held = new Promise<void>(resolve => { release = resolve })
  let requests = 0
  await page.route('**/api/entries', async route => {
    requests += 1
    await held
    await route.continue()
  })

  await refreshButton(page).click()
  await expect(refreshButton(page)).toBeDisabled()
  await expect(status(page)).toHaveText('Refreshing…')
  await refreshButton(page).click({ force: true })
  await refreshButton(page).click({ force: true })
  expect(requests).toBe(1)

  release()
  await expect(status(page)).toHaveText('Listing refreshed.')
  await expect(refreshButton(page)).toBeEnabled()
  await expect(folderRow(page, 'skills')).toBeVisible()
})

test('refresh failure keeps the previous rows and flags them as potentially outdated', async ({ page }) => {
  await page.goto('/pi')
  await expect(rowNames(page)).toHaveText(['skills', 'workflow.md'])

  await page.route('**/api/entries', route => route.fulfill({ status: 500, json: { error: 'Listing failed' } }))
  await refreshButton(page).click()
  const alert = page.locator('[data-state="stale"]')
  await expect(alert).toHaveRole('alert')
  await expect(alert).toContainText('may be outdated')
  await expect(alert).toContainText('refresh again')
  await expect(rowNames(page)).toHaveText(['skills', 'workflow.md'])
  await expect(counts(page)).toHaveText('1 folder · 1 file')

  await page.unroute('**/api/entries')
  await refreshButton(page).click()
  await expect(status(page)).toHaveText('Listing refreshed.')
  await expect(alert).toHaveCount(0)
})

