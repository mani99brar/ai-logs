  await expect(page.getByRole('link', { name: 'Pi Source' })).toBeFocused()
  await page.keyboard.press('Enter')
  await expect(page).toHaveURL('/pi')
  // Focus continues from the current breadcrumb rather than falling off the page.
  await expect(crumbs(page).locator('[aria-current="page"]')).toBeFocused()
  await page.keyboard.press('Shift+Tab')
  await expect(crumbs(page).getByRole('link', { name: 'Home' })).toBeFocused()
  await page.keyboard.press('Tab')
  await expect(refreshButton(page)).toBeFocused()
  await page.keyboard.press('Enter')
