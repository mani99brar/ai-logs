// ---------- Routing helpers ----------

const NavigateContext = createContext<(href: string) => void>(() => {})

type LinkProps = { href: string; className?: string; children: ReactNode; 'aria-current'?: 'page' }

/** A real anchor (works with the keyboard, middle-click and screen readers) that navigates in-app on plain clicks. */
function Link({ href, children, ...rest }: LinkProps) {
  const navigate = useContext(NavigateContext)
  const onClick = (event: MouseEvent<HTMLAnchorElement>) => {
    if (!isPlainNavigation(event)) return
    event.preventDefault()
    navigate(href)
  }
  return <a href={href} onClick={onClick} {...rest}>{children}</a>
}

// ---------- Breadcrumbs ----------

type Crumb = { label: string; href: string }

function crumbsFor(location: Location): Crumb[] {
  const crumbs: Crumb[] = [{ label: 'Home', href: homeHref }]
  if (location.kind === 'unknown') crumbs.push({ label: location.slug, href: '/' + encodeURIComponent(location.slug) })
  if (location.kind === 'folder') {
    crumbs.push({ label: location.source, href: folderHref(location.source, []) })
    location.segments.forEach((segment, index) => {
      crumbs.push({ label: segment, href: folderHref(location.source, location.segments.slice(0, index + 1)) })
    })
  }
  return crumbs
}

function Breadcrumbs({ location, currentRef }: { location: Location; currentRef: RefObject<HTMLSpanElement | null> }) {
  const crumbs = crumbsFor(location)
  const [expanded, setExpanded] = useState(false)
  const collapsible = crumbs.length > 3
  const last = crumbs.length - 1
  return (
    <nav aria-label="Breadcrumb" className="breadcrumbs">
      <ol className="crumbs" data-expanded={expanded || undefined}>
        {crumbs.map((crumb, index) => {
          const isLast = index === last
          const isMiddle = collapsible && index > 0 && !isLast
          return (
            <li key={crumb.href} className={isMiddle ? 'crumb crumb--collapsible' : 'crumb'}>
              {index > 0 && <span className="crumb__separator" aria-hidden="true">/</span>}
              {isLast
                ? <span className="crumb__current" aria-current="page" tabIndex={-1} ref={currentRef}>{crumb.label}</span>
                : <Link href={crumb.href} className="crumb__link">{crumb.label}</Link>}
            </li>
          )
        }).flatMap((item, index) => (index === 0 && collapsible
          ? [item, (
            // On narrow screens this stands in for the intermediate crumbs until expanded; wide screens never show it.
            <li key="ellipsis" className="crumb crumb--ellipsis">
              <span className="crumb__separator" aria-hidden="true">/</span>
              <button
                type="button"
                className="crumb__ellipsis"
                aria-expanded={expanded}
                aria-label={expanded ? 'Hide intermediate folders' : `Show ${last - 1} intermediate folders`}
                onClick={() => setExpanded(value => !value)}
              >
                …
              </button>
            </li>
          )]
          : [item]))}
      </ol>
    </nav>
  )
}

// ---------- Rows ----------

function SourceRows() {
  return (
    <ul className="rows" aria-label="Sources">
      {sources.map(({ source }) => (
        <li key={source}>
          <Link href={folderHref(source, [])} className="row row--nav">
            <SourceIcon />
            <span className="row__name">{source}</span>
            <span className="row__type">Source</span>
            <ChevronIcon />
          </Link>
        </li>
      ))}
    </ul>
  )
}

function FolderRows({ source, segments, entries }: { source: Source; segments: string[]; entries: Entry[] }) {
  const label = segments.length === 0 ? `Contents of ${source}` : `Contents of ${segments[segments.length - 1]}`
  if (entries.length === 0) return <p className="notice" data-state="empty">This folder is empty.</p>
  return (
    <>
      <div className="rows-header" aria-hidden="true">
        <span className="rows-header__name">Name</span>
        <span className="rows-header__type">Type</span>
      </div>
      <ul className="rows" aria-label={label}>
        {entries.map(entry => (
          <li key={entry.path}>
            {entry.kind === 'directory'
              ? (
                <Link href={folderHref(source, entrySegments(entry))} className="row row--nav">
                  <FolderIcon />
                  <span className="row__name">{entryName(entry)}</span>
                  <span className="row__type">Folder</span>
                  <ChevronIcon />
                </Link>
              )
              : (
                <div className="row row--file">
                  <MarkdownIcon />
                  <span className="row__name">{entryName(entry)}</span>
                  <span className="row__type">Markdown</span>
                </div>
              )}
          </li>
        ))}
      </ul>
      <p className="counts">{formatCounts(countChildren(entries))}</p>
    </>
  )
}

function MissingFolder({ location }: { location: Location }) {
  if (location.kind === 'unknown') {
    return (
      <div className="notice" data-state="missing">
        <p>There is no source named “{location.slug}”. Only Pi and Claude are available.</p>
        <Link href={homeHref} className="button-link">Go to Home</Link>
      </div>
    )
  }
  if (location.kind !== 'folder') return null
  return (
    <div className="notice" data-state="missing">
      <p>The folder “{location.segments.join('/')}” doesn’t exist in {location.source}. It may have been renamed or removed.</p>
      <Link href={folderHref(location.source, [])} className="button-link">Go to {location.source}</Link>
    </div>
  )
}

// ---------- Data ----------

type Listing =
  | { status: 'loading' }
  | { status: 'failed'; message: string }
  | { status: 'ready'; tree: Tree; stale: boolean }

const failureMessage = 'Unable to load the Pi and Claude folders. Check that the API is running and both fixture folders are readable.'

async function fetchEntries(signal: AbortSignal): Promise<Entry[]> {
  const response = await fetch('/api/entries', { signal })
  if (!response.ok) throw new Error(`Listing failed with status ${response.status}`)
  const data = await response.json() as { entries: Entry[] }
  return data.entries
}

type ListingSetters = {
  setListing: Dispatch<SetStateAction<Listing>>
  setAnnouncement: Dispatch<SetStateAction<string>>
  setRefreshing: Dispatch<SetStateAction<boolean>>
}

/** Fetches the flat entry list once and applies the outcome. A refresh failure keeps the previous rows and marks them stale. */
async function loadListing(mode: 'initial' | 'refresh', signal: AbortSignal, { setListing, setAnnouncement, setRefreshing }: ListingSetters) {
  try {
    const entries = await fetchEntries(signal)
    if (signal.aborted) return
    setListing({ status: 'ready', tree: buildTree(entries), stale: false })
    setAnnouncement(mode === 'initial' ? '' : 'Listing refreshed.')
  } catch {
    if (signal.aborted) return
    if (mode === 'initial') {
      setListing({ status: 'failed', message: failureMessage })
    } else {
      setListing(current => current.status === 'ready' ? { ...current, stale: true } : { status: 'failed', message: failureMessage })
    }
    setAnnouncement('')
  } finally {
    if (!signal.aborted) setRefreshing(false)
  }
}

function App() {
  const { pathname, navigate, restoreScroll } = useLocation()
  const location = useMemo(() => parsePathname(pathname), [pathname])
  const [listing, setListing] = useState<Listing>({ status: 'loading' })
  const [refreshing, setRefreshing] = useState(false)
  const [announcement, setAnnouncement] = useState('Loading folders…')
  const inFlight = useRef<AbortController | null>(null)

  const start = useCallback((mode: 'initial' | 'refresh') => {
    inFlight.current?.abort()
    const controller = new AbortController()
    inFlight.current = controller
    void loadListing(mode, controller.signal, { setListing, setAnnouncement, setRefreshing })
  }, [])

  useEffect(() => {
    start('initial')
    return () => inFlight.current?.abort()
  }, [start])

  const retry = () => {
    setListing({ status: 'loading' })
    setAnnouncement('Loading folders…')
    start('initial')
  }

  const busy = listing.status === 'loading' || refreshing

  const refresh = () => {
    if (busy) return
    setRefreshing(true)
    setAnnouncement('Refreshing…')
    start('refresh')
  }

  useLayoutEffect(() => {
    if (listing.status === 'ready') restoreScroll()
  }, [listing.status, pathname, restoreScroll])

  // After an in-app route change the previously focused row is gone, so keyboard and screen reader users
  // continue from the current breadcrumb. The initial page load keeps the browser's default focus.
  const previousPathname = useRef(pathname)
  const currentCrumb = useRef<HTMLSpanElement | null>(null)
  useEffect(() => {
    if (previousPathname.current === pathname) return
    previousPathname.current = pathname
    currentCrumb.current?.focus({ preventScroll: true })
  }, [pathname])

  let content: ReactNode = null
  if (listing.status === 'failed') {
    content = (
      <div className="notice notice--error" role="alert" data-state="error">
        <p>{listing.message}</p>
        <button type="button" onClick={retry}>Retry</button>
      </div>
    )
  } else if (listing.status === 'ready') {
    if (location.kind === 'home') content = <SourceRows />
    else if (location.kind === 'unknown') content = <MissingFolder location={location} />
    else {
      const children = childrenOf(listing.tree, location.source, location.segments)
      content = children
        ? <FolderRows source={location.source} segments={location.segments} entries={children} />
        : <MissingFolder location={location} />
    }
  }

  return (
    <NavigateContext.Provider value={navigate}>
      <div className="app">
        <header className="masthead">
          <h1>MD Manager</h1>
        </header>
        <div className="toolbar">
          <Breadcrumbs key={pathname} location={location} currentRef={currentCrumb} />
          <button
            type="button"
            className="refresh"
            onClick={refresh}
            aria-disabled={busy}
          >
            <RefreshIcon />
            <span>Refresh</span>
          </button>
        </div>
        <p className="status" role="status" aria-live="polite" data-visible={announcement ? 'true' : undefined}>{announcement}</p>
        {listing.status === 'ready' && listing.stale && (
          <p className="notice notice--warning" role="alert" data-state="stale">
            Refresh failed, so this listing may be outdated. Check that the API is running and both fixture folders are readable, then refresh again.
          </p>
        )}
        <main className="content" aria-busy={busy || undefined}>
          {content}
        </main>
      </div>
    </NavigateContext.Provider>
  )
}

export default App
