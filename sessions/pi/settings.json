{
  "lastChangelogVersion": "0.85.1",
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "packages": [
    "npm:pi-subagents",
    "npm:pi-mcp-adapter",
    "npm:pi-web-access"
  ],
  "subagents": {
    "watchdog": {
      "enabled": true,
      "main": {
        "enabled": true
      }
    },
    "agentOverrides": {
      "researcher": {
        "tools": [
          "read",
          "write",
          "web_search",
          "fetch_content",
          "get_search_content",
          "source_check",
          "mcp"
        ]
      },
      "evidence-auditor": {
        "tools": [
          "read",
          "web_search",
          "fetch_content",
          "get_search_content",
          "source_check",
          "mcp"
        ]
      },
      "worker": {
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "edit",
          "write",
          "contact_supervisor",
          "web_search",
          "fetch_content",
          "get_search_content",
          "source_check",
          "mcp"
        ]
      },
      "reviewer": {
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "contact_supervisor",
          "web_search",
          "fetch_content",
          "get_search_content",
          "source_check",
          "mcp"
        ]
      }
    }
  },
  "terminal": {
    "showTerminalProgress": true
  }
}
