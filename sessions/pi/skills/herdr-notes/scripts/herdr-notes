#!/usr/bin/env bash
set -euo pipefail

readonly NOTES_DIR="${HERDR_NOTES_NOTES_DIR:-$HOME/.pi/agent/notes/herdr}"
readonly PLUGIN_BASE="$HOME/.config/herdr/plugins/github"

find_binary() {
  local candidate
  while IFS= read -r candidate; do
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done < <(find "$PLUGIN_BASE" -maxdepth 3 -type f -path '*/bin/herdr-notes' -print 2>/dev/null | sort -r)

  printf 'herdr-notes: installed plugin binary not found under %s\n' "$PLUGIN_BASE" >&2
  printf 'Install it with: herdr plugin install cyperx84/herdr-notes --yes\n' >&2
  return 1
}

mkdir -p "$NOTES_DIR"
chmod 700 "$NOTES_DIR"

export HERDR_NOTES_NOTES_DIR="$NOTES_DIR"
exec "$(find_binary)" "$@"
