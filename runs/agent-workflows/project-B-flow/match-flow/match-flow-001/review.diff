diff --git a/packages/simulation/src/match/match.test.ts b/packages/simulation/src/match/match.test.ts
new file mode 100644
index 0000000..b227158
--- /dev/null
+++ b/packages/simulation/src/match/match.test.ts
@@ -0,0 +1,427 @@
+import { describe, expect, it } from "vitest";
+import {
+  createMatchConfig,
+  createMatchState,
+  elapsed,
+  hashState,
+  matchRules,
+  remaining,
+  stepMatch,
+  type MatchConfig,
+  type MatchEvent,
+  type MatchInput,
+  type MatchReport,
+  type MatchState,
+} from "./index.js";
+
+const PUBLIC = createMatchConfig({ kind: "public" });
+const PRIVATE = createMatchConfig({ kind: "private" });
+const READY = 400;
+const DEPARTURE = 900;
+const DURATION = 42_000;
+
+/** Recursively frozen, so a step that mutated its input would throw. */
+function deepFreeze<T>(value: T): T {
+  if (typeof value === "object" && value !== null && !Object.isFrozen(value)) {
+    Object.freeze(value);
+    for (const child of Object.values(value)) deepFreeze(child);
+  }
+  return value;
+}
+
+/** Drives one match through frozen states and inputs, keeping every event. */
+class Script {
+  state: MatchState;
+  events: MatchEvent[] = [];
+  last: readonly MatchEvent[] = [];
+
+  constructor(
+    readonly config: MatchConfig,
+    tick = 0,
+  ) {
+    this.state = deepFreeze(createMatchState(config, tick));
+  }
+
+  at(tick: number, ...reports: MatchReport[]): this {
+    const input: MatchInput = deepFreeze({ tick, reports });
+    const stepped = stepMatch(this.config, this.state, input);
+    this.state = deepFreeze(stepped.state);
+    this.last = stepped.events;
+    this.events.push(...stepped.events);
+    return this;
+  }
+
+  kinds(): string[] {
+    return this.last.map((event) => event.kind);
+  }
+}
+
+const join = (...ids: string[]): MatchReport[] => ids.map((playerId) => ({ kind: "join", playerId }));
+const leave = (...ids: string[]): MatchReport[] => ids.map((playerId) => ({ kind: "leave", playerId }));
+const start = (playerId: string): MatchReport => ({ kind: "start", playerId });
+const claimEnd = (tick: number, winner: string): MatchReport => ({ kind: "match-ended", tick, reason: "claim", winner });
+const deadlineEnd = (tick: number): MatchReport => ({ kind: "match-ended", tick, reason: "deadline", winner: null });
+const FAULT: MatchReport = { kind: "fault" };
+const EIGHT = ["p1", "p2", "p3", "p4", "p5", "p6", "p7", "p8"];
+
+/** A private match of `ids` that the first id starts at tick 10: control starts at 410. */
+function privateRunning(ids: string[]): Script {
+  return new Script(PRIVATE).at(1, ...join(...ids)).at(10, start(ids[0]!)).at(10 + READY);
+}
+
+describe("match config", () => {
+  it("takes the public seats and the private limits from the content rules and the duration from the claim rules", () => {
+    expect(PUBLIC).toEqual({ kind: "public", custom: false, seats: 8, minPlayers: 8, readyTicks: 400, departureTicks: 900, durationTicks: 42_000, startingGold: 50 });
+    expect(PRIVATE).toEqual({ kind: "private", custom: true, seats: 8, minPlayers: 2, readyTicks: 400, departureTicks: 900, durationTicks: 42_000, startingGold: 50 });
+    expect(() => createMatchConfig({ kind: "private", rules: { ...matchRules, readyTicks: 0 } })).toThrow(/readyTicks/);
+    expect(() => createMatchConfig({ kind: "private", durationTicks: 0 })).toThrow(RangeError);
+    expect(() => createMatchConfig({ kind: "ranked" as never })).toThrow(RangeError);
+    expect(createMatchState(PRIVATE)).toMatchObject({ tick: 0, phase: "lobby", custom: true, players: [], host: null, end: null, results: null });
+  });
+});
+
+describe("phases (§2)", () => {
+  it("moves a full public lobby through ready, departure and exploration on their ticks", () => {
+    const script = new Script(PUBLIC).at(1, ...join(...EIGHT.slice(0, 7)));
+    expect(script.state.phase).toBe("lobby");
+    script.at(5, ...join("p8"));
+    expect(script.state.phase).toBe("ready");
+    expect(script.state.readyTick).toBe(5);
+    expect(script.last.at(-1)).toEqual({ kind: "phase-changed", tick: 5, from: "lobby", to: "ready" });
+    script.at(5 + READY - 1);
+    expect(script.state.phase).toBe("ready");
+    script.at(5 + READY);
+    expect(script.last).toEqual([
+      { kind: "phase-changed", tick: 405, from: "ready", to: "departure" },
+      { kind: "control-started", tick: 405 },
+    ]);
+    expect(script.state).toMatchObject({ phase: "departure", controlStartTick: 405, readyTick: null });
+    script.at(405 + DEPARTURE - 1);
+    expect(script.state.phase).toBe("departure");
+    script.at(405 + DEPARTURE);
+    expect(script.last).toEqual([{ kind: "phase-changed", tick: 1305, from: "departure", to: "exploration" }]);
+    script.at(5_000, deadlineEnd(5_000));
+    expect(script.state.phase).toBe("ended");
+    expect(script.events.filter((event) => event.kind === "phase-changed").map((event) => event.kind === "phase-changed" && event.to)).toEqual([
+      "ready",
+      "departure",
+      "exploration",
+      "ended",
+    ]);
+    expect(script.state.custom).toBe(false);
+    expect(script.state.results!.custom).toBe(false);
+  });
+
+  it("refuses a start request in a public match and never starts one short-handed", () => {
+    const script = new Script(PUBLIC).at(1, ...join(...EIGHT.slice(0, 7)), start("p1"));
+    expect(script.last.at(-1)).toEqual({ kind: "start-refused", tick: 1, playerId: "p1", reason: "public" });
+    expect(script.state).toMatchObject({ phase: "lobby", host: null });
+    script.at(2_000);
+    expect(script.state.phase).toBe("lobby");
+  });
+
+  it("refuses the ninth joiner of a full lobby", () => {
+    const script = new Script(PRIVATE).at(1, ...join(...EIGHT, "p9"));
+    expect(script.last.filter((event) => event.kind === "join-refused")).toEqual([{ kind: "join-refused", tick: 1, playerId: "p9", reason: "full" }]);
+    expect(script.state.players).toHaveLength(8);
+    const full = new Script(PUBLIC).at(1, ...join(...EIGHT, "p9"));
+    expect(full.last.filter((event) => event.kind === "join-refused")).toHaveLength(1);
+    expect(full.state.phase).toBe("ready");
+  });
+
+  it("starts a private match of two to eight players on the host's request and marks it custom", () => {
+    const script = new Script(PRIVATE).at(1, ...join("host"));
+    expect(script.last).toEqual([
+      { kind: "player-joined", tick: 1, playerId: "host" },
+      { kind: "host-changed", tick: 1, playerId: "host" },
+    ]);
+    script.at(2, start("host"));
+    expect(script.last).toEqual([{ kind: "start-refused", tick: 2, playerId: "host", reason: "too-few" }]);
+    script.at(3, ...join("guest"), start("guest"));
+    expect(script.last.at(-1)).toEqual({ kind: "start-refused", tick: 3, playerId: "guest", reason: "not-host" });
+    expect(script.state.phase).toBe("lobby");
+    script.at(4, start("host"));
+    expect(script.last).toEqual([{ kind: "phase-changed", tick: 4, from: "lobby", to: "ready" }]);
+    expect(script.state).toMatchObject({ phase: "ready", readyTick: 4, custom: true });
+    script.at(4, start("host"));
+    expect(script.last).toEqual([]);
+    script.at(5, start("host"));
+    expect(script.last).toEqual([]);
+    const eight = new Script(PRIVATE).at(1, ...join(...EIGHT)).at(2, start("p1"));
+    expect(eight.state.phase).toBe("ready");
+  });
+
+  it("passes the private host to the earliest joiner still present", () => {
+    const script = new Script(PRIVATE).at(1, ...join("zed", "amy")).at(2, ...join("bob")).at(3, ...leave("zed"));
+    expect(script.last).toEqual([
+      { kind: "player-left", tick: 3, playerId: "zed" },
+      { kind: "host-changed", tick: 3, playerId: "amy" },
+    ]);
+    script.at(4, ...leave("amy", "bob"));
+    expect(script.state.host).toBeNull();
+    expect(script.state.phase).toBe("lobby");
+    script.at(5, ...join("cat"));
+    expect(script.state.host).toBe("cat");
+  });
+
+  it("refuses late joiners after the lobby, including a player who left after control start", () => {
+    const ready = new Script(PRIVATE).at(1, ...join("a", "b")).at(2, start("a")).at(3, ...join("late"));
+    expect(ready.last).toEqual([{ kind: "join-refused", tick: 3, playerId: "late", reason: "started" }]);
+    const script = privateRunning(["a", "b", "c"]);
