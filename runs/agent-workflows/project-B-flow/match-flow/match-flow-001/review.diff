+import { afterAll, describe, expect, it } from "vitest";
+import { nextInt } from "../random.js";
+import {
+  createMatchConfig,
+  createMatchState,
+  elapsed,
+  hashState,
+  MATCH_END_REASONS,
+  MATCH_PHASES,
+  matchRules,
+  remaining,
+  replayMatch,
+  stepMatch,
+  type MatchConfig,
+  type MatchEvent,
+  type MatchInput,
+  type MatchKind,
+  type MatchReport,
+  type MatchState,
+} from "./index.js";
+
+type Draw = (bound: number) => number;
+
+function generator(seed: number): Draw {
+  let rng = seed >>> 0;
+  return (bound) => {
+    const drawn = nextInt(rng, bound);
+    rng = drawn.state;
+    return drawn.value;
+  };
+}
+
+/** Recursively frozen, so a step that mutated its input would throw. */
+function deepFreeze<T>(value: T): T {
+  if (typeof value === "object" && value !== null && !Object.isFrozen(value)) {
+    Object.freeze(value);
+    for (const child of Object.values(value)) deepFreeze(child);
+  }
+  return value;
+}
+
+interface Scenario {
+  readonly seed: number;
+  readonly kind: MatchKind;
+  /** Per mille, for each report slot. */
+  readonly leavePerMille: number;
+  readonly claimPerMille: number;
+  readonly faultPerMille: number;
+  /** Per mille of ticks that jump ahead by up to 60 ticks. */
+  readonly skipPerMille: number;
+}
+
+/** Compressed times, so the deadline is reachable: a 1 s ready check, 1.5 s of departure, 20 s matches. */
+const QUICK = { rules: { ...matchRules, readyTicks: 20, departureTicks: 30 }, durationTicks: 400 };
+const IDS = ["c0", "c1", "c2", "c3", "c4", "c5", "c6", "c7", "c8", "c9", "c10", "C"];
+const ISLANDS = ["palm", "ash", "mist", "ruin"];
+const MAX_STEPS = 700;
+
+const SCENARIOS: Scenario[] = Array.from({ length: 60 }, (_, index) => {
+  const draw = generator(20260925 + index * 7919);
+  return {
+    seed: 1_000 + index,
+    kind: index % 2 === 0 ? "private" : "public",
+    leavePerMille: [20, 60, 150, 300][index % 4]!,
+    // A third of the scenarios never claim or fault, so they run to the deadline or empty out.
+    claimPerMille: index % 3 === 0 ? 0 : 2 + draw(6),
+    faultPerMille: index % 3 === 0 ? 0 : draw(3),
+    skipPerMille: [0, 100, 400][index % 3]!,
+  };
+});
+
+const EXERCISED = new Set<string>();
+const MUST_EXERCISE = [
+  ...MATCH_PHASES.map((phase) => `phase:${phase}`),
+  ...MATCH_END_REASONS.map((reason) => `end:${reason}`),
+  "ready->lobby",
+  "join-refused:started",
+  "join-refused:full",
+  "start-refused:public",
+  "start-refused:not-host",
+  "start-refused:too-few",
+  "transition-skipped",
+  "stale-input",
+  "left-in-results",
+];
+
+const RANK = new Map<string, number>(MATCH_PHASES.map((phase, index) => [phase, index]));
+
+interface Tally {
+  collected: number;
+  thefts: number;
+  lost: number;
+  duelsWon: number;
+  duelsLost: number;
+  duelsDrawn: number;
+  gold: number | null;
+  cachesClaimed: number;
+  islands: Set<string>;
+}
+
+/** Plays one seeded match the way a room would: it reads the state to choose each tick's reports. */
+function play(config: MatchConfig, scenario: Scenario): { inputs: MatchInput[]; events: MatchEvent[]; state: MatchState } {
+  const draw = generator(scenario.seed);
+  const chance = (perMille: number) => draw(1000) < perMille;
+  let state = deepFreeze(createMatchState(config));
+  const inputs: MatchInput[] = [];
+  const events: MatchEvent[] = [];
+  let tick = 0;
+  let resultsSeen = 0;
+
+  for (let step = 0; step < MAX_STEPS && state.end === null; step++) {
+    const before = state;
+    tick += 1 + (chance(scenario.skipPerMille) ? draw(60) : 0);
+    const controlStart = state.controlStartTick ?? (state.readyTick !== null ? state.readyTick + config.readyTicks : null);
+    const deadline = controlStart === null ? null : controlStart + config.durationTicks;
+    // A room steps every tick near the deadline, so the claim module's deadline report lands on its own tick.
+    if (deadline !== null && tick > deadline) tick = deadline;
+    if (tick <= state.tick) tick = state.tick + 1;
+    const running = state.controlStartTick !== null || (controlStart !== null && tick >= controlStart);
+    const inPlayers = state.controlStartTick !== null ? state.players.map((player) => player.id) : [];
+    const pick = <T,>(list: readonly T[]) => list[draw(list.length)]!;
+
+    const reports: MatchReport[] = [];
+    const slots = draw(5);
+    for (let slot = 0; slot < slots; slot++) {
+      const roll = draw(1000);
+      if (roll < 250) reports.push({ kind: "join", playerId: pick(IDS) });
+      else if (roll < 250 + scenario.leavePerMille) reports.push({ kind: "leave", playerId: pick(IDS) });
+      else if (roll < 400 + scenario.leavePerMille) {
+        const host = state.host;
+        reports.push({ kind: "start", playerId: host !== null && chance(700) ? host : pick(IDS) });
+      } else if (inPlayers.length >= 2 && roll < 500 + scenario.leavePerMille) {
+        const a = pick(inPlayers);
+        const others = inPlayers.filter((id) => id !== a);
+        const b = pick(others);
+        const outcome = draw(3);
+        reports.push({ kind: "duel-ended", playerIds: [a, b], winner: outcome === 0 ? null : outcome === 1 ? a : b });
+      } else if (inPlayers.length > 0) {
+        const playerId = pick(inPlayers);
+        switch (draw(6)) {
+          case 0:
+            reports.push({ kind: "collected", playerId });
+            break;
+          case 1:
+            reports.push({ kind: "stole", playerId });
+            break;
+          case 2:
+            reports.push({ kind: "lost", playerId });
+            break;
+          case 3:
+            reports.push({ kind: "cache-claimed", playerId });
+            break;
+          case 4:
+            reports.push({ kind: "island-visited", playerId, island: pick(ISLANDS) });
+            break;
+          default:
+            reports.push({ kind: "gold", playerId, gold: draw(200) });
+        }
+      }
+    }
+    if (running && inPlayers.length > 0 && chance(scenario.claimPerMille)) reports.push({ kind: "match-ended", tick, reason: "claim", winner: pick(inPlayers) });
+    if (chance(scenario.faultPerMille)) reports.push({ kind: "fault" });
+    if (deadline !== null && tick === deadline) {
+      // The claim module ends on its deadline tick unless a claim completed on it.
+      if (!reports.some((report) => report.kind === "match-ended")) reports.push({ kind: "match-ended", tick, reason: "deadline", winner: null });
+    }
+
+    const input = deepFreeze({ tick, reports });
+    const stepped = stepMatch(config, before, input);
+    inputs.push(input);
+    events.push(...stepped.events);
+    state = deepFreeze(stepped.state);
+
+    // Invariants of one step.
+    let phase = before.phase;
+    for (const event of stepped.events) {
+      if (event.kind === "phase-changed") {
+        expect(event.from).toBe(phase);
+        const backwards = RANK.get(event.to)! <= RANK.get(event.from)!;
+        if (backwards) {
+          expect([event.from, event.to]).toEqual(["ready", "lobby"]);
+          EXERCISED.add("ready->lobby");
+        }
+        phase = event.to;
+        if (event.tick < tick) EXERCISED.add("transition-skipped");
+      }
+      if (event.kind === "control-started") {
+        expect(before.readyTick).not.toBeNull();
+        expect(event.tick).toBe(before.readyTick! + config.readyTicks);
+      }
+      if (event.kind === "join-refused") EXERCISED.add(`join-refused:${event.reason}`);
+      if (event.kind === "start-refused") EXERCISED.add(`start-refused:${event.reason}`);
+      if (event.kind === "match-ended") {
+        resultsSeen++;
+        expect(event.results).toBe(state.results);
+      }
+    }
+    expect(phase).toBe(state.phase);
+    EXERCISED.add(`phase:${state.phase}`);
+    expect(state.tick).toBe(tick);
+    expect(state.end === null).toBe(state.results === null);
+    expect(state.end === null).toBe(state.phase !== "ended");
+    const present = state.players.filter((player) => !player.left);
+    expect(present.length).toBeLessThanOrEqual(config.seats);
+    if (state.phase === "ready") expect(present.length).toBeGreaterThanOrEqual(config.minPlayers);
+    if (state.phase === "lobby" || state.phase === "ready") expect(state.players.every((player) => !player.left)).toBe(true);
+    if (!config.custom) expect(state.host).toBeNull();
+    else if (state.end === null) expect(state.host).toBe(present.length === 0 ? null : [...present].sort((a, b) => a.order - b.order)[0]!.id);
+    if (state.phase === "exploration") expect(tick).toBeGreaterThanOrEqual(state.controlStartTick! + config.departureTicks);
+    if (state.phase === "departure") expect(tick).toBeLessThan(state.controlStartTick! + config.departureTicks);
+    for (const probe of [tick - 100, tick, tick + 100]) {
+      const [spent, left] = [elapsed(state, probe), remaining(state, probe)];
+      expect(spent).toBeGreaterThanOrEqual(0);
+      expect(left).toBeGreaterThanOrEqual(0);
+      if (spent <= config.durationTicks) expect(spent + left).toBe(config.durationTicks);
+    }
+    hashState(state);
+
+    // A repeated or stale input changes nothing.
+    if (step % 17 === 0) {
+      const again = stepMatch(config, state, input);
+      expect(again.state).toBe(state);
+      expect(again.events).toEqual([]);
+      EXERCISED.add("stale-input");
+    }
+  }
+  expect(resultsSeen).toBe(state.end === null ? 0 : 1);
+  return { inputs, events, state };
+}
+
+/** Counts every accomplishment report from control start to the end, independently of the step. */
+function tally(inputs: readonly MatchInput[], state: MatchState): Map<string, Tally> {
+  const tallies = new Map<string, Tally>();
+  const of = (id: string) => {
+    let entry = tallies.get(id);
+    if (entry === undefined) {
+      entry = { collected: 0, thefts: 0, lost: 0, duelsWon: 0, duelsLost: 0, duelsDrawn: 0, gold: null, cachesClaimed: 0, islands: new Set() };
+      tallies.set(id, entry);
+    }
+    return entry;
+  };
+  if (state.controlStartTick === null) return tallies;
+  for (const input of inputs) {
+    if (input.tick < state.controlStartTick || (state.end !== null && input.tick > state.end.tick)) continue;
+    for (const report of input.reports) {
+      switch (report.kind) {
+        case "collected":
+          of(report.playerId).collected++;
+          break;
+        case "stole":
+          of(report.playerId).thefts++;
+          break;
+        case "lost":
+          of(report.playerId).lost++;
+          break;
+        case "cache-claimed":
+          of(report.playerId).cachesClaimed++;
+          break;
+        case "island-visited":
+          of(report.playerId).islands.add(report.island);
+          break;
+        case "gold":
+          of(report.playerId).gold = report.gold;
+          break;
+        case "duel-ended":
+          for (const id of report.playerIds) {
+            if (report.winner === null) of(id).duelsDrawn++;
+            else if (report.winner === id) of(id).duelsWon++;
+            else of(id).duelsLost++;
+          }
+          break;
+        default:
+          break;
+      }
+    }
+  }
+  return tallies;
+}
+
+describe("match flow properties", () => {
+  afterAll(() => {
+    expect(MUST_EXERCISE.filter((label) => !EXERCISED.has(label))).toEqual([]);
+  });
+
+  for (const scenario of SCENARIOS) {
+    it(`keeps its invariants: seed ${scenario.seed}, ${scenario.kind}, leaves ${scenario.leavePerMille}‰, skips ${scenario.skipPerMille}‰`, () => {
+      const config = createMatchConfig({ kind: scenario.kind, ...QUICK });
+      const { inputs, events, state } = play(config, scenario);
+
+      // Replaying the same inputs gives the same state, events and hash; so does replaying them with repeats.
+      const first = replayMatch(config, createMatchState(config), inputs);
+      expect(first.hash).toBe(hashState(state));
+      expect(first.events).toEqual(events);
+      const repeated = inputs.flatMap((input, index) => (index % 3 === 0 ? [input, input] : [input]));
+      expect(replayMatch(config, createMatchState(config), repeated).hash).toBe(first.hash);
+
+      expect(events.filter((event) => event.kind === "control-started").length).toBe(state.controlStartTick === null ? 0 : 1);
+      expect(events.filter((event) => event.kind === "match-ended").length).toBeLessThanOrEqual(1);
+
+      if (state.end === null) return;
+      EXERCISED.add(`end:${state.end.reason}`);
+      const results = state.results!;
+      expect(results.winner === null).toBe(state.end.reason !== "claim");
+      expect(results.players.map((player) => player.id).sort()).toEqual(state.players.map((player) => player.id).sort());
+      expect(results.players.filter((player) => player.winner).map((player) => player.id)).toEqual(results.winner === null ? [] : [results.winner]);
+      for (let index = 1; index < results.players.length; index++) {
+        const a = results.players[index - 1]!;
+        const b = results.players[index]!;
+        const ordered = Number(a.winner) > Number(b.winner) || (a.winner === b.winner && (a.rubbingsHeld > b.rubbingsHeld || (a.rubbingsHeld === b.rubbingsHeld && a.id < b.id)));
+        expect(ordered).toBe(true);
+      }
+      const tallies = tally(inputs, state);
+      for (const line of results.players) {
+        const expected = tallies.get(line.id);
+        const player = state.players.find((candidate) => candidate.id === line.id)!;
+        expect(line.left).toBe(player.left);
+        if (line.left) EXERCISED.add("left-in-results");
+        expect({
+          collected: line.collected,
+          thefts: line.thefts,
+          lost: line.lost,
+          duelsWon: line.duelsWon,
+          duelsLost: line.duelsLost,
+          duelsDrawn: line.duelsDrawn,
+          gold: line.gold,
+          cachesClaimed: line.cachesClaimed,
+          islandsVisited: line.islandsVisited,
+        }).toEqual({
+          collected: expected?.collected ?? 0,
+          thefts: expected?.thefts ?? 0,
+          lost: expected?.lost ?? 0,
+          duelsWon: expected?.duelsWon ?? 0,
+          duelsLost: expected?.duelsLost ?? 0,
+          duelsDrawn: expected?.duelsDrawn ?? 0,
+          gold: expected?.gold ?? config.startingGold,
+          cachesClaimed: expected?.cachesClaimed ?? 0,
+          islandsVisited: expected?.islands.size ?? 0,
+        });
+        expect(line.rubbingsHeld).toBe(Math.max(0, line.collected + line.thefts + line.cachesClaimed - line.lost));
+      }
+
+      // Nothing after the end changes anything.
+      const after = stepMatch(config, state, { tick: state.tick + 1, reports: [{ kind: "fault" }, { kind: "join", playerId: "late" }] });
+      expect(after.state).toBe(state);
+      expect(after.events).toEqual([]);
+    });
+  }
+});
diff --git a/packages/simulation/src/match/state.ts b/packages/simulation/src/match/state.ts
new file mode 100644
index 0000000..aee0db9
--- /dev/null
+++ b/packages/simulation/src/match/state.ts
@@ -0,0 +1,236 @@
+import { claimRules } from "@pirate-sea-race/content/claim";
+import { matchRules as defaultMatchRules, validateMatchRules, type MatchRules } from "@pirate-sea-race/content/match";
+import { objectiveRules } from "@pirate-sea-race/content/objectives";
+
+export type MatchKind = "public" | "private";
+
+/** §2's phases in the order a match moves through them; only `ready` may fall back, to `lobby`. */
+export const MATCH_PHASES = ["lobby", "ready", "departure", "exploration", "ended"] as const;
+export type MatchPhase = (typeof MATCH_PHASES)[number];
+
+export const MATCH_END_REASONS = ["claim", "deadline", "abandoned", "aborted"] as const;
+/** `claim` has a winner; a `deadline` (§2), an `abandoned` room and an `aborted` match (§12) have none. */
+export type MatchEndReason = (typeof MATCH_END_REASONS)[number];
+
+/** Static flow data for one match; the step reads it and it never changes. */
+export interface MatchConfig {
+  readonly kind: MatchKind;
+  /** §2: private matches are marked custom. */
+  readonly custom: boolean;
+  /** The most players the lobby admits. */
+  readonly seats: number;
+  /** The fewest present players that start a match, or keep a ready check going; a public match needs every seat. */
+  readonly minPlayers: number;
+  readonly readyTicks: number;
+  readonly departureTicks: number;
+  /** World ticks from control start to the deadline: the claim rules' `deadlineTicks`, for the timer only. */
+  readonly durationTicks: number;
+  /** A player's gold in the results until the caller reports another balance. */
+  readonly startingGold: number;
+}
+
+export interface MatchConfigOptions {
+  readonly kind: MatchKind;
+  readonly rules?: MatchRules;
+  /** Defaults to the claim rules' deadline, which must be the one the caller's claim config uses. */
+  readonly durationTicks?: number;
+  /** Defaults to the objective rules' starting gold. */
+  readonly startingGold?: number;
+}
+
+export function requireInteger(value: unknown, name: string): void {
+  if (typeof value !== "number" || !Number.isSafeInteger(value)) throw new RangeError(`${name} must be a safe integer, got ${String(value)}`);
+}
+
+export function requireId(value: unknown, name: string): void {
+  if (typeof value !== "string" || value.length === 0) throw new RangeError(`${name} must be a non-empty string`);
+}
+
+/** Builds a match's flow config from the content rules, refusing invalid rules. */
+export function createMatchConfig(options: MatchConfigOptions): MatchConfig {
+  if (options.kind !== "public" && options.kind !== "private") throw new RangeError(`kind must be public or private, got ${String(options.kind)}`);
+  const rules = validateMatchRules(options.rules ?? defaultMatchRules);
+  if (!rules.ok) throw new RangeError(`invalid match rules: ${rules.issues.join("; ")}`);
+  const durationTicks = options.durationTicks ?? claimRules.deadlineTicks;
+  const startingGold = options.startingGold ?? objectiveRules.startingGold;
+  requireInteger(durationTicks, "durationTicks");
+  requireInteger(startingGold, "startingGold");
+  if (durationTicks <= 0) throw new RangeError(`durationTicks must be positive, got ${durationTicks}`);
+  if (startingGold < 0) throw new RangeError(`startingGold must not be negative, got ${startingGold}`);
+  const isPublic = options.kind === "public";
+  return {
+    kind: options.kind,
+    custom: !isPublic,
+    seats: isPublic ? rules.value.publicSeats : rules.value.privateMaxPlayers,
+    minPlayers: isPublic ? rules.value.publicSeats : rules.value.privateMinPlayers,
+    readyTicks: rules.value.readyTicks,
+    departureTicks: rules.value.departureTicks,
+    durationTicks,
+    startingGold,
+  };
+}
+
+/** What a player accomplished, counted from the caller's reports after control start. */
+export interface MatchPlayerStats {
+  readonly collected: number;
+  readonly thefts: number;
+  readonly lost: number;
+  readonly duelsWon: number;
+  readonly duelsLost: number;
+  readonly duelsDrawn: number;
+  /** The last reported balance. */
+  readonly gold: number;
+  readonly cachesClaimed: number;
+  /** Distinct island ids, sorted. */
+  readonly islands: readonly string[];
+}
+
+export interface MatchPlayer {
+  readonly id: string;
+  /** Join order, for passing the private host on. */
+  readonly order: number;
+  /** Left after control start; a player who leaves before it is removed. */
+  readonly left: boolean;
+  readonly stats: MatchPlayerStats;
+}
+
+export interface MatchEnd {
+  readonly reason: MatchEndReason;
+  /** Only a claim has one. */
+  readonly winner: string | null;
+  readonly tick: number;
+}
+
+/** One line of the results screen. */
+export interface MatchPlayerResult {
+  readonly id: string;
+  readonly winner: boolean;
+  readonly left: boolean;
+  /** collected + thefts + cachesClaimed − lost, never below 0. */
+  readonly rubbingsHeld: number;
+  readonly collected: number;
+  readonly thefts: number;
+  readonly lost: number;
+  readonly duelsWon: number;
+  readonly duelsLost: number;
+  readonly duelsDrawn: number;
+  readonly gold: number;
+  readonly cachesClaimed: number;
+  readonly islandsVisited: number;
+}
+
+export interface MatchResults {
+  readonly reason: MatchEndReason;
+  readonly winner: string | null;
+  readonly tick: number;
+  readonly custom: boolean;
+  /** Match time played, from control start to the end (0 if control never started). */
+  readonly elapsedTicks: number;
+  /** The winner first, then by rubbings held (most first), then by id. */
+  readonly players: readonly MatchPlayerResult[];
+}
+
+/** The flow state: plain integer data that `hashState` covers entirely. */
+export interface MatchState {
+  /** The last world tick processed. */
+  readonly tick: number;
+  readonly phase: MatchPhase;
+  readonly custom: boolean;
+  readonly durationTicks: number;
+  /** Sorted by id. */
+  readonly players: readonly MatchPlayer[];
+  readonly nextOrder: number;
+  /** The private match's host, who may start it; always null in a public match. */
+  readonly host: string | null;
+  /** The tick the current ready check began, while in `ready`. */
+  readonly readyTick: number | null;
+  /** The world tick player control started on (§2); the timer and every other module's clock count from it. */
+  readonly controlStartTick: number | null;
+  /** Set once; the state never changes afterwards. */
+  readonly end: MatchEnd | null;
+  /** Built once, when the match ends. */
+  readonly results: MatchResults | null;
+}
+
+/** An empty lobby before any tick: the first step processes a later tick. */
+export function createMatchState(config: MatchConfig, tick = 0): MatchState {
+  requireInteger(tick, "tick");
+  if (tick < 0) throw new RangeError(`tick must not be negative, got ${tick}`);
+  return {
+    tick,
+    phase: "lobby",
+    custom: config.custom,
+    durationTicks: config.durationTicks,
+    players: [],
+    nextOrder: 0,
+    host: null,
+    readyTick: null,
+    controlStartTick: null,
+    end: null,
+    results: null,
+  };
+}
+
+/** An accomplishment the caller reports after control start; the module only counts them. */
+export type MatchStatEvent =
+  /** Collected a rubbing from a source. */
+  | { readonly kind: "collected"; readonly playerId: string }
+  /** Took a rubbing from a duel loser. */
+  | { readonly kind: "stole"; readonly playerId: string }
+  /** Lost a rubbing: to a thief, or into a recovery cache. */
+  | { readonly kind: "lost"; readonly playerId: string }
+  /** A settled duel; `winner` null is a draw (a match-end freeze or a cancellation counts as the caller reports it). */
+  | { readonly kind: "duel-ended"; readonly playerIds: readonly [string, string]; readonly winner: string | null }
+  /** Claimed a rubbing from a recovery cache. */
+  | { readonly kind: "cache-claimed"; readonly playerId: string }
+  | { readonly kind: "island-visited"; readonly playerId: string; readonly island: string }
+  /** The player's gold balance now. */
+  | { readonly kind: "gold"; readonly playerId: string; readonly gold: number };
+
+/** The claim module's `match-ended` event, passed on unchanged. */
+export interface ClaimEndReport {
+  readonly kind: "match-ended";
+  readonly tick: number;
+  readonly reason: "claim" | "deadline";
+  readonly winner: string | null;
+}
+
+export type MatchReport =
+  | { readonly kind: "join"; readonly playerId: string }
+  /** The seat is released (§12: an explicit quit or an expired reservation); a mere disconnection is not a leave. */
+  | { readonly kind: "leave"; readonly playerId: string }
+  /** The private host asks to start. */
+  | { readonly kind: "start"; readonly playerId: string }
+  | MatchStatEvent
+  | ClaimEndReport
+  /** §12: the server process failed; abort with no winner and no competitive penalty. */
+  | { readonly kind: "fault" };
+
+/** What happened up to one world tick. */
+export interface MatchInput {
+  /** A tick at or before the state's is stale: the step ignores the whole input. Later ticks may skip ahead. */
+  readonly tick: number;
+  /** Applied in order after the timed transitions up to `tick`. */
+  readonly reports: readonly MatchReport[];
+}
+
+export type JoinRefusal = "started" | "full";
+export type StartRefusal = "public" | "not-host" | "too-few";
+
+/** Something that happened, for the caller to apply or show. */
+export type MatchEvent =
+  | { readonly kind: "player-joined"; readonly tick: number; readonly playerId: string }
+  /** §2: late arrivals wait for another match. */
+  | { readonly kind: "join-refused"; readonly tick: number; readonly playerId: string; readonly reason: JoinRefusal }
+  | { readonly kind: "player-left"; readonly tick: number; readonly playerId: string }
+  | { readonly kind: "host-changed"; readonly tick: number; readonly playerId: string | null }
+  | { readonly kind: "start-refused"; readonly tick: number; readonly playerId: string; readonly reason: StartRefusal }
+  | { readonly kind: "phase-changed"; readonly tick: number; readonly from: MatchPhase; readonly to: MatchPhase }
+  /** Player control starts: pass `tick` to the claim config and to the encounter rules' spawn protection. */
+  | { readonly kind: "control-started"; readonly tick: number }
+  | { readonly kind: "match-ended"; readonly tick: number; readonly reason: MatchEndReason; readonly winner: string | null; readonly results: MatchResults };
+
+export interface MatchStepResult {
+  readonly state: MatchState;
+  readonly events: readonly MatchEvent[];
+}
