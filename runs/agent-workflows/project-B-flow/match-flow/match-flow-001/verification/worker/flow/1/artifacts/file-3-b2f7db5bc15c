import { describe, expect, it } from "vitest";
import { SPAWN_PROTECTION_SECONDS } from "../encounters/rules.js";
import { rulesPresets } from "../rules.js";
import { WORLD_STEPS_PER_SECOND } from "../sailing.js";
import { DEPARTURE_SECONDS, matchRules, PRIVATE_MIN_PLAYERS, PUBLIC_SEATS, READY_COUNTDOWN_SECONDS, validateMatchRules } from "./index.js";

function issuesOf(candidate: unknown): string[] {
  const result = validateMatchRules(candidate);
  return result.ok ? [] : result.issues;
}

describe("match rules (§2)", () => {
  it("count a 20 s ready check and 45 s of departure in world ticks, with eight public seats and a private minimum of 2", () => {
    expect(WORLD_STEPS_PER_SECOND).toBe(20);
    expect([READY_COUNTDOWN_SECONDS, DEPARTURE_SECONDS, PRIVATE_MIN_PLAYERS, PUBLIC_SEATS]).toEqual([20, 45, 2, 8]);
    expect(DEPARTURE_SECONDS).toBe(SPAWN_PROTECTION_SECONDS);
    expect(PUBLIC_SEATS).toBe(rulesPresets.alpha.maxPlayers);
    expect(matchRules).toEqual({ readyTicks: 400, departureTicks: 900, publicSeats: 8, privateMinPlayers: 2, privateMaxPlayers: 8 });
    expect(validateMatchRules(matchRules)).toEqual({ ok: true, value: matchRules });
  });

  it("refuse a ready countdown of 0", () => {
    expect(issuesOf({ ...matchRules, readyTicks: 0 })).toEqual(["readyTicks: Too small: expected number to be >0"]);
  });

  it("refuse a zero departure, fractional ticks, seat counts outside 2–8, a minimum above the maximum and unknown fields", () => {
    expect(issuesOf({ ...matchRules, departureTicks: 0 })[0]).toMatch(/^departureTicks:/);
    expect(issuesOf({ ...matchRules, readyTicks: 1.5 })[0]).toMatch(/^readyTicks:/);
    expect(issuesOf({ ...matchRules, publicSeats: 9 })[0]).toMatch(/^publicSeats:/);
    expect(issuesOf({ ...matchRules, privateMinPlayers: 1 })[0]).toMatch(/^privateMinPlayers:/);
    expect(issuesOf({ ...matchRules, privateMinPlayers: 5, privateMaxPlayers: 4 })).toEqual([
      "privateMinPlayers: a private minimum of 5 players exceeds the maximum of 4",
    ]);
    const { publicSeats: _, ...missing } = matchRules;
    expect(issuesOf(missing)[0]).toMatch(/^publicSeats:/);
    expect(issuesOf({ ...matchRules, extra: 1 })).toHaveLength(1);
  });
});
