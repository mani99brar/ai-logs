import { z } from "zod";
import { SPAWN_PROTECTION_SECONDS } from "../encounters/rules.js";
import { formatIssues, privateMatch, rulesPresets, type ValidationResult } from "../rules.js";
import { WORLD_STEPS_PER_SECOND } from "../sailing.js";

/** §2: the ready check lasts 20 seconds while clients preload arenas. */
export const READY_COUNTDOWN_SECONDS = 20;
/** §2: departure is the 45 seconds of spawn protection from control start; the encounter rules grant the protection. */
export const DEPARTURE_SECONDS = SPAWN_PROTECTION_SECONDS;
/** §2: private tests may start with two to eight players. */
export const PRIVATE_MIN_PLAYERS = 2;
/** §2: public matches do not start short-handed; they need every seat of the eight-player preset. */
export const PUBLIC_SEATS = rulesPresets.alpha.maxPlayers;

/** The match flow rules (§2) in world ticks (20 a second) and seats. */
export const matchRulesSchema = z
  .strictObject({
    /** World ticks from the ready check to control start. */
    readyTicks: z.int().positive(),
    /** World ticks from control start to exploration: a HUD label, the protection itself is the encounter rules'. */
    departureTicks: z.int().positive(),
    /** Players a public match needs before its ready check. */
    publicSeats: z.int().min(2).max(8),
    /** The fewest players a private match starts with. */
    privateMinPlayers: z.int().min(2).max(8),
    /** The most players a private match admits. */
    privateMaxPlayers: z.int().min(2).max(8),
  })
  .superRefine((rules, ctx) => {
    if (rules.privateMinPlayers > rules.privateMaxPlayers) {
      ctx.addIssue({
        code: "custom",
        path: ["privateMinPlayers"],
        message: `a private minimum of ${rules.privateMinPlayers} players exceeds the maximum of ${rules.privateMaxPlayers}`,
      });
    }
  });

export type MatchRules = z.infer<typeof matchRulesSchema>;

export const matchRules: MatchRules = {
  readyTicks: READY_COUNTDOWN_SECONDS * WORLD_STEPS_PER_SECOND,
  departureTicks: DEPARTURE_SECONDS * WORLD_STEPS_PER_SECOND,
  publicSeats: PUBLIC_SEATS,
  privateMinPlayers: PRIVATE_MIN_PLAYERS,
  privateMaxPlayers: privateMatch.maxPlayers,
};

export function validateMatchRules(candidate: unknown): ValidationResult<MatchRules> {
  const parsed = matchRulesSchema.safeParse(candidate);
  return parsed.success ? { ok: true, value: parsed.data } : { ok: false, issues: formatIssues(parsed.error) };
}
