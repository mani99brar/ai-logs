{
  "version": "1.2.0",
  "feature": "Kleros v2 Shutter reveal justification",
  "independent_review": true,
  "integration_approval": true,
  "max_verification_attempts": 3,
  "setup": [
    {
      "argv": ["bash", "features/_shared/web-setup.sh", "install"],
      "timeout_seconds": 1200
    },
    {
      "argv": ["bash", "features/_shared/web-setup.sh", "build"],
      "timeout_seconds": 1800
    },
    {
      "argv": ["bash", "features/_shared/web-setup.sh", "codegen"],
      "timeout_seconds": 600
    }
  ],
  "workers": [
    {
      "node_id": "web",
      "role": "frontend",
      "required_check_kinds": ["typecheck", "unit"],
      "owned_paths": [
        "web/src/pages/Cases/CaseDetails/Voting/Shutter",
        "web/src/actions/reveal",
        "web/src/hooks/useRevealVote.ts"
      ],
      "checks": [
        {
          "id": "typecheck",
          "kind": "typecheck",
          "argv": ["yarn", "workspace", "@kleros/kleros-v2-web", "check-types"],
          "timeout_seconds": 900,
          "scenarios": []
        },
        {
          "id": "lint",
          "kind": "typecheck",
          "argv": ["yarn", "workspace", "@kleros/kleros-v2-web", "check-style"],
          "timeout_seconds": 900,
          "scenarios": []
        },
        {
          "id": "unit",
          "kind": "unit",
          "argv": ["yarn", "workspace", "@kleros/kleros-v2-web", "test"],
          "timeout_seconds": 900,
          "scenarios": []
        }
      ]
    }
  ]
}
