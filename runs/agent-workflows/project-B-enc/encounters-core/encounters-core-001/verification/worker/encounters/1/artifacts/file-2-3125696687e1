import { describe, expect, it } from "vitest";
import { ENGAGEMENT_RANGE_TILES, SIGHT_RADIUS_TILES, WORLD_STEPS_PER_SECOND } from "../sailing.js";
import { encounterRules, secondsToTicks, validateEncounterRules } from "./index.js";

function issuesOf(candidate: unknown): string[] {
  const result = validateEncounterRules(candidate);
  return result.ok ? [] : result.issues;
}

describe("encounter rules (§2, §6, §14)", () => {
  it("hold §6's timings in world ticks and the decided ranges and cones", () => {
    expect(WORLD_STEPS_PER_SECOND).toBe(20);
    expect(secondsToTicks(0.6)).toBe(12);
    expect(encounterRules.grapple).toEqual({ windupTicks: 20, rangeTiles: ENGAGEMENT_RANGE_TILES, hitConeHeadings: 4, targetConeHeadings: 8, missCooldownTicks: 120 });
    expect(encounterRules.challenge).toEqual({ windupTicks: 12, rangeTiles: 2, hitConeHeadings: 4, targetConeHeadings: 8, missCooldownTicks: 120 });
    expect(encounterRules).toMatchObject({
      maxDuels: 4,
      transitionTicks: 60,
      readyTimeoutTicks: 200,
      spawnProtectionTicks: 900,
      winProtectionTicks: 160,
      drawProtectionTicks: 160,
      respawnDelayTicks: 300,
      respawnProtectionTicks: 400,
      respawnClearRadiusTiles: SIGHT_RADIUS_TILES,
      drawReturnMinSeparationTiles: 3,
      drawReturnMaxDistanceTiles: 6,
    });
    expect(validateEncounterRules(encounterRules)).toEqual({ ok: true, value: encounterRules });
  });

  it("refuse a negative duration", () => {
    expect(issuesOf({ ...encounterRules, respawnDelayTicks: -1 })[0]).toMatch(/^respawnDelayTicks:/);
    expect(issuesOf({ ...encounterRules, grapple: { ...encounterRules.grapple, missCooldownTicks: -120 } })[0]).toMatch(/^grapple\.missCooldownTicks:/);
    expect(issuesOf({ ...encounterRules, challenge: { ...encounterRules.challenge, windupTicks: -12 } })[0]).toMatch(/^challenge\.windupTicks:/);
  });

  it("refuse a range above the sight radius, but allow one exactly at it", () => {
    const beyond = { ...encounterRules, grapple: { ...encounterRules.grapple, rangeTiles: SIGHT_RADIUS_TILES + 1 } };
    expect(issuesOf(beyond)[0]).toMatch(/^grapple\.rangeTiles:/);
    expect(issuesOf({ ...encounterRules, challenge: { ...encounterRules.challenge, rangeTiles: SIGHT_RADIUS_TILES } })).toEqual([]);
  });

  it("refuse a zero windup, fractional ticks, cones past a half turn, bad return geometry and unknown fields", () => {
    expect(issuesOf({ ...encounterRules, grapple: { ...encounterRules.grapple, windupTicks: 0 } })[0]).toMatch(/^grapple\.windupTicks:/);
    expect(issuesOf({ ...encounterRules, transitionTicks: 1.5 })[0]).toMatch(/^transitionTicks:/);
    expect(issuesOf({ ...encounterRules, grapple: { ...encounterRules.grapple, hitConeHeadings: 33 } })[0]).toMatch(/^grapple\.hitConeHeadings:/);
    expect(issuesOf({ ...encounterRules, readyTimeoutTicks: 59 })[0]).toMatch(/^readyTimeoutTicks:/);
    expect(issuesOf({ ...encounterRules, drawReturnMinSeparationTiles: 13 })[0]).toMatch(/^drawReturnMinSeparationTiles:/);
    expect(issuesOf({ ...encounterRules, extra: 1 })).toHaveLength(1);
  });
});
