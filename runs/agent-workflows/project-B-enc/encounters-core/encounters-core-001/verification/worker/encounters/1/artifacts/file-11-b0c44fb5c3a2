import { isNavigable, type SeaMapDefinition } from "@pirate-sea-race/content";
import { distanceSquared, seaLineOfSight, tileCentre, tileOf, type EncounterPoint } from "./geometry.js";

/** Where a draw or cancellation returns its two players, in the duel's player order. */
export interface SeparateReturnRequest {
  /** The encounter position: between the two players where the hit landed. */
  readonly encounter: EncounterPoint;
  /** Each player's own position when the hit landed. */
  readonly players: readonly [EncounterPoint, EncounterPoint];
  /** Sub-units: the two points are at least this far apart... */
  readonly minSeparation: number;
  /** ...and each is within this far of the encounter position. */
  readonly maxDistance: number;
}

export interface RespawnRequest {
  readonly encounter: EncounterPoint;
  /** The loser's own position when the hit landed. */
  readonly own: EncounterPoint;
  /** Every other active player's position (§6: away from nearby opponents). */
  readonly opponents: readonly EncounterPoint[];
  /** Sub-units: a dock is clear when no opponent is this close to it. */
  readonly clearRadius: number;
}

export interface RespawnPoint {
  readonly x: number;
  readonly y: number;
  /** The dock the loser respawns at, or null where the mode has no docks. */
  readonly dockId: number | null;
}

/**
 * What differs between the sea and the islands: line of sight and where a duel's players return. Each is a pure
 * function of its arguments; the step calls it with the duel's mode.
 */
export interface ModeRules {
  lineOfSight(from: EncounterPoint, to: EncounterPoint): boolean;
  separateReturn(request: SeparateReturnRequest): readonly [EncounterPoint, EncounterPoint];
  respawnPoint(request: RespawnRequest): RespawnPoint;
}

/**
 * The sea (§6 at sea), fully specified:
 * - line of sight: the supercover line between the ships' tiles touches no land;
 * - a draw returns both ships to the centres of two distinct navigable tiles within `maxDistance` of the encounter
 *   and at least `minSeparation` apart, the pair nearest (by the sum of squared distances) to where each ship was,
 *   ties to the lower first tile then the lower second tile, row-major; a sea with no such pair leaves each ship
 *   where it was;
 * - a loser respawns at the centre of the dock nearest the encounter with no opponent within `clearRadius`, ties to
 *   the lower dock id; if every dock has one, the dock farthest from its nearest opponent, ties to the lower id.
 */
export function seaModeRules(map: SeaMapDefinition): ModeRules {
  if (map.docks.length === 0) throw new RangeError(`${map.name} has no dock to respawn at`);
  const docks = map.docks.map((dock) => ({ id: dock.id, point: tileCentre(map, dock) }));
  return {
    lineOfSight: (from, to) => seaLineOfSight(map, from, to),

    separateReturn({ encounter, players, minSeparation, maxDistance }) {
      const reach = Math.ceil(maxDistance / map.subUnitsPerTile) + 1;
      const centre = tileOf(map, encounter);
      const candidates: EncounterPoint[] = [];
      for (let tileY = centre.tileY - reach; tileY <= centre.tileY + reach; tileY++) {
        for (let tileX = centre.tileX - reach; tileX <= centre.tileX + reach; tileX++) {
          if (!isNavigable(map, tileX, tileY)) continue;
          const point = tileCentre(map, { tileX, tileY });
          if (distanceSquared(encounter, point) <= maxDistance * maxDistance) candidates.push(point);
        }
      }
      const [a, b] = players;
      const toA = candidates.map((point) => distanceSquared(a, point));
      const toB = candidates.map((point) => distanceSquared(b, point));
      let best: { cost: number; p: number; q: number } | null = null;
      for (let p = 0; p < candidates.length; p++) {
        for (let q = 0; q < candidates.length; q++) {
          if (p === q || distanceSquared(candidates[p]!, candidates[q]!) < minSeparation * minSeparation) continue;
          const cost = toA[p]! + toB[q]!;
          // Strictly less keeps the first pair in (p, q) order among equals.
          if (best === null || cost < best.cost) best = { cost, p, q };
        }
      }
      if (best === null) return [{ x: a.x, y: a.y }, { x: b.x, y: b.y }];
      return [candidates[best.p]!, candidates[best.q]!];
    },

    respawnPoint({ encounter, opponents, clearRadius }) {
      const nearestOpponent = (point: EncounterPoint) =>
        opponents.reduce((nearest, opponent) => Math.min(nearest, distanceSquared(point, opponent)), Number.MAX_SAFE_INTEGER);
      let chosen: { id: number; point: EncounterPoint; key: number } | null = null;
      for (const dock of docks) {
        if (nearestOpponent(dock.point) <= clearRadius * clearRadius) continue;
        const key = distanceSquared(encounter, dock.point);
        if (chosen === null || key < chosen.key) chosen = { ...dock, key };
      }
      if (chosen === null) {
        for (const dock of docks) {
          const key = nearestOpponent(dock.point);
          if (chosen === null || key > chosen.key) chosen = { ...dock, key };
        }
      }
      const { id, point } = chosen!;
      return { x: point.x, y: point.y, dockId: id };
    },
  };
}

/**
 * The islands, as a placeholder until walking on islands exists (`objectives-endgame` replaces it): nothing blocks
 * line of sight, and every return stays at the player's own position.
 */
export const footPlaceholderRules: ModeRules = {
  lineOfSight: () => true,
  separateReturn: ({ players: [a, b] }) => [
    { x: a.x, y: a.y },
    { x: b.x, y: b.y },
  ],
  respawnPoint: ({ own }) => ({ x: own.x, y: own.y, dockId: null }),
};
