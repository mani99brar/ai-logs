import { createSeaMap, HEADING_COUNT, seaMap, Terrain, terrainAt, type SeaMapDefinition } from "@pirate-sea-race/content";
import { describe, expect, it } from "vitest";
import { HEADING_DX, HEADING_DY, normalizeHeading } from "../heading.js";
import { nextInt } from "../random.js";
import { bearing, headingDifference, seaLineOfSight, supercover, tileCentre, withinCone, withinRange, type TileCell } from "./index.js";

function sea(rows: readonly string[]): SeaMapDefinition {
  return createSeaMap({ name: "test", widthTiles: rows[0]!.length, heightTiles: rows.length, rows, islands: [], spawnSlots: [], hub: { tileX: 0, tileY: 0 } });
}

const key = (cell: TileCell) => `${cell.tileX},${cell.tileY}`;
const cellSet = (cells: readonly TileCell[]) => [...new Set(cells.map(key))].sort();

/**
 * The reference: the tiles whose closed square the segment between the two tile centres meets, by exact rational
 * clipping in doubled coordinates. A segment through a tile corner meets all four tiles around it, which is the
 * supercover's rule for a corner crossing.
 */
function touchedTiles(from: TileCell, to: TileCell): string[] {
  const touched: string[] = [];
  const [x0, y0, dx, dy] = [2 * from.tileX + 1, 2 * from.tileY + 1, 2 * (to.tileX - from.tileX), 2 * (to.tileY - from.tileY)];
  for (let tileY = Math.min(from.tileY, to.tileY); tileY <= Math.max(from.tileY, to.tileY); tileY++) {
    for (let tileX = Math.min(from.tileX, to.tileX); tileX <= Math.max(from.tileX, to.tileX); tileX++) {
      // The parameter interval [lo, hi] as fractions with positive denominators; start with [0, 1].
      let lo: [number, number] = [0, 1];
      let hi: [number, number] = [1, 1];
      let empty = false;
      for (const [origin, delta, cell] of [
        [x0, dx, tileX],
        [y0, dy, tileY],
      ] as const) {
        const [min, max] = [2 * cell, 2 * cell + 2];
        if (delta === 0) {
          if (origin < min || origin > max) empty = true;
          continue;
        }
        let enter: [number, number] = [min - origin, delta];
        let leave: [number, number] = [max - origin, delta];
        if (delta < 0) [enter, leave] = [[origin - max, -delta], [origin - min, -delta]];
        if (enter[0] * lo[1] > lo[0] * enter[1]) lo = enter;
        if (leave[0] * hi[1] < hi[0] * leave[1]) hi = leave;
      }
      if (!empty && lo[0] * hi[1] <= hi[0] * lo[1]) touched.push(key({ tileX, tileY }));
    }
  }
  return touched.sort();
}

describe("supercover line", () => {
  it("counts both tiles beside an exact corner crossing", () => {
    expect(cellSet(supercover({ tileX: 0, tileY: 0 }, { tileX: 2, tileY: 2 }))).toEqual(["0,0", "0,1", "1,0", "1,1", "1,2", "2,1", "2,2"]);
    expect(cellSet(supercover({ tileX: 0, tileY: 0 }, { tileX: 3, tileY: 0 }))).toEqual(["0,0", "1,0", "2,0", "3,0"]);
    expect(cellSet(supercover({ tileX: 4, tileY: 4 }, { tileX: 4, tileY: 4 }))).toEqual(["4,4"]);
  });

  it("is exactly the set of tiles the segment touches, the same in both directions", () => {
    let pairs = 0;
    for (let a = 0; a < 81; a++) {
      for (let b = 0; b < 81; b++) {
        const from = { tileX: a % 9, tileY: Math.floor(a / 9) };
        const to = { tileX: b % 9, tileY: Math.floor(b / 9) };
        const forward = supercover(from, to);
        expect(cellSet(forward)).toEqual(touchedTiles(from, to));
        expect(cellSet(supercover(to, from))).toEqual(cellSet(forward));
        expect(forward[0]).toEqual(from);
        expect(forward.at(-1)).toEqual(to);
        pairs++;
      }
    }
    expect(pairs).toBe(6561);
  });
});

describe("ship line of sight", () => {
  const map = sea([
    "..........", //
    "....#.....",
    "..........",
    "....%.....",
    "....D.....",
    "..........",
  ]);
  const at = (tileX: number, tileY: number) => tileCentre(map, { tileX, tileY });

  it("is blocked by land and not by shoals or docks, in both directions", () => {
    expect(seaLineOfSight(map, at(1, 1), at(8, 1))).toBe(false);
    expect(seaLineOfSight(map, at(8, 1), at(1, 1))).toBe(false);
    expect(seaLineOfSight(map, at(1, 3), at(8, 3))).toBe(true);
    expect(seaLineOfSight(map, at(8, 3), at(1, 3))).toBe(true);
    expect(seaLineOfSight(map, at(1, 4), at(8, 4))).toBe(true);
    expect(seaLineOfSight(map, at(1, 0), at(8, 0))).toBe(true);
  });

  it("is blocked when the line only grazes a land tile's corner", () => {
    // From (6,0) to (4,2) the segment passes exactly through the corner (5,2) of the land tile (4,1) without entering it.
    expect(seaLineOfSight(map, at(6, 0), at(4, 2))).toBe(false);
    expect(seaLineOfSight(map, at(4, 2), at(6, 0))).toBe(false);
    // One tile further east it passes the corners (7,1) and (6,2): clear.
    expect(seaLineOfSight(map, at(7, 0), at(5, 2))).toBe(true);
    // Straight past the land tile's side, touching no corner of it.
    expect(seaLineOfSight(map, at(5, 0), at(5, 2))).toBe(true);
  });

  it("is symmetric over every pair of sea tiles within engagement range on the slice sea", () => {
    let seeded = 0x5eed;
    let blocked = 0;
    let clear = 0;
    for (let trial = 0; trial < 3000; trial++) {
      const draw = (bound: number) => {
        const next = nextInt(seeded, bound);
        seeded = next.state;
        return next.value;
      };
      const a = { tileX: draw(seaMap.widthTiles), tileY: draw(seaMap.heightTiles) };
      const b = { tileX: Math.min(seaMap.widthTiles - 1, Math.max(0, a.tileX + draw(13) - 6)), tileY: Math.min(seaMap.heightTiles - 1, Math.max(0, a.tileY + draw(13) - 6)) };
      const forward = seaLineOfSight(seaMap, tileCentre(seaMap, a), tileCentre(seaMap, b));
      expect(seaLineOfSight(seaMap, tileCentre(seaMap, b), tileCentre(seaMap, a))).toBe(forward);
      const land = supercover(a, b).some((cell) => terrainAt(seaMap, cell.tileX, cell.tileY) === Terrain.Land);
      expect(forward).toBe(!land);
      if (forward) clear++;
      else blocked++;
    }
    expect(blocked).toBeGreaterThan(20);
    expect(clear).toBeGreaterThan(20);
  });
});

describe("bearing and cones", () => {
  const origin = { x: 10_000, y: 10_000 };
  const along = (heading: number, scale = 3) => ({ x: origin.x + HEADING_DX[normalizeHeading(heading)]! * scale, y: origin.y + HEADING_DY[normalizeHeading(heading)]! * scale });

  it("gives every table heading as its own bearing, and none for a zero offset", () => {
    for (let heading = 0; heading < HEADING_COUNT; heading++) expect(bearing(origin, along(heading))).toBe(heading);
    expect(bearing(origin, origin)).toBeNull();
  });

  it("breaks an exact tie between two headings to the lower one, across the wrap too", () => {
    // (20, 1)·(1024, 0) = 20480 = (20, 1)·(1019, 100); likewise (20, -1) between headings 63 and 0.
    expect(20 * HEADING_DX[0]! + 1 * HEADING_DY[0]!).toBe(20 * HEADING_DX[1]! + 1 * HEADING_DY[1]!);
    expect(bearing({ x: 0, y: 0 }, { x: 20, y: 1 })).toBe(0);
    expect(20 * HEADING_DX[63]! - 1 * HEADING_DY[63]!).toBe(20 * HEADING_DX[0]! - 1 * HEADING_DY[0]!);
    expect(bearing({ x: 0, y: 0 }, { x: 20, y: -1 })).toBe(0);
  });

  it("measures ±N as the circular difference", () => {
    expect(headingDifference(62, 2)).toBe(4);
    expect(headingDifference(2, 62)).toBe(4);
    expect(headingDifference(0, 32)).toBe(32);
    expect(headingDifference(10, 10)).toBe(0);
  });

  it.each([4, 8])("includes a target exactly ±%i headings off and excludes one a heading further", (cone) => {
    for (const aim of [0, 5, 30, 62]) {
      expect(withinCone(origin, along(aim + cone), aim, cone)).toBe(true);
      expect(withinCone(origin, along(aim - cone), aim, cone)).toBe(true);
      expect(withinCone(origin, along(aim + cone + 1), aim, cone)).toBe(false);
      expect(withinCone(origin, along(aim - cone - 1), aim, cone)).toBe(false);
    }
  });

  it("counts distance 0 inside every cone", () => {
    for (const heading of [0, 17, 63]) expect(withinCone(origin, origin, heading, 0)).toBe(true);
  });
});

describe("squared-distance ranges", () => {
  it("include the exact boundary and exclude one sub-unit beyond, on the axes and diagonally", () => {
    const range = 6 * 256;
    const origin = { x: 0, y: 0 };
    expect(withinRange(origin, { x: range, y: 0 }, range)).toBe(true);
    expect(withinRange(origin, { x: 0, y: -range }, range)).toBe(true);
    expect(withinRange(origin, { x: range + 1, y: 0 }, range)).toBe(false);
    // 2·1086² = 2 358 792 ≤ 1536² = 2 359 296 < 1087² + 1086² = 2 360 965.
    expect(withinRange(origin, { x: 1086, y: 1086 }, range)).toBe(true);
    expect(withinRange(origin, { x: 1087, y: -1086 }, range)).toBe(false);
    expect(withinRange(origin, origin, range)).toBe(true);
  });
});
