import { z } from "zod";
import { formatIssues, type ValidationResult } from "../rules.js";
import { ENGAGEMENT_RANGE_TILES, SIGHT_RADIUS_TILES, WORLD_STEPS_PER_SECOND } from "../sailing.js";

/** §6 at sea: the grapple's telegraphed windup. */
export const GRAPPLE_WINDUP_SECONDS = 1;
/** §6 on islands: the visible lunge. */
export const CHALLENGE_LUNGE_SECONDS = 0.6;
/** §6 on islands: "close range". A placeholder until walking on islands exists. */
export const CHALLENGE_RANGE_TILES = 2;
/** §6: a miss costs this long before the next attempt; the grapple uses the challenge's six seconds. */
export const MISS_COOLDOWN_SECONDS = 6;
/** The hit area at landing: within this many headings (of 64) of the aim locked at the start, ±22.5°. */
export const HIT_CONE_HEADINGS = 4;
/** Target choice at the start: within this many headings of the attacker's own heading, ±45°. */
export const TARGET_CONE_HEADINGS = 8;
/** §14: at most this many 1v1 duels at once, counted from reservation to settlement. */
export const MAX_SIMULTANEOUS_DUELS = 4;
/** §6: the transition's visible countdown. */
export const TRANSITION_COUNTDOWN_SECONDS = 3;
/** §6: a client not ready this long after the reservation forfeits. */
export const READY_TIMEOUT_SECONDS = 10;
/** §2: departure protection from the start of player control. */
export const SPAWN_PROTECTION_SECONDS = 45;
/** §6: the winner's escape protection. */
export const WIN_PROTECTION_SECONDS = 8;
/** §6: a draw's (or a cancellation's) protection. */
export const DRAW_PROTECTION_SECONDS = 8;
/** §6: the loser respawns this long after the fight ended... */
export const RESPAWN_DELAY_SECONDS = 15;
/** ...with this long of protection. */
export const RESPAWN_PROTECTION_SECONDS = 20;
/** §6: a draw returns both players to separate points at least this far apart... */
export const DRAW_RETURN_MIN_SEPARATION_TILES = 3;
/** ...and within this far of the encounter. */
export const DRAW_RETURN_MAX_DISTANCE_TILES = 6;

/** Whole world ticks (20 a second) for a duration in seconds. */
export function secondsToTicks(seconds: number): number {
  return Math.round(seconds * WORLD_STEPS_PER_SECOND);
}

const ticks = z.int().nonnegative();
const headings = z.int().min(0).max(32);

/** One attack kind (§6): the sea grapple or the island challenge. */
export const attackRulesSchema = z.strictObject({
  /** The telegraph: the attempt lands this many ticks after it starts. At least one, so it can be escaped. */
  windupTicks: z.int().positive(),
  /** Centre to centre, at the start and at landing; within the sight radius, so no one attacks what they cannot see. */
  rangeTiles: z.int().positive().max(SIGHT_RADIUS_TILES),
  hitConeHeadings: headings,
  targetConeHeadings: headings,
  missCooldownTicks: ticks,
});

export type AttackRules = z.infer<typeof attackRulesSchema>;

/** The encounter rules of §2, §6 and §14 in world ticks and tiles; the simulation converts tiles to sub-units. */
export const encounterRulesSchema = z
  .strictObject({
    grapple: attackRulesSchema,
    challenge: attackRulesSchema,
    maxDuels: z.int().positive(),
    transitionTicks: ticks,
    readyTimeoutTicks: ticks,
    spawnProtectionTicks: ticks,
    winProtectionTicks: ticks,
    drawProtectionTicks: ticks,
    respawnDelayTicks: ticks,
    respawnProtectionTicks: ticks,
    /** A loser respawns at the nearest dock with no opponent this close (the sight radius, §3). */
    respawnClearRadiusTiles: z.int().positive(),
    drawReturnMinSeparationTiles: z.int().positive(),
    drawReturnMaxDistanceTiles: z.int().positive(),
  })
  .superRefine((rules, ctx) => {
    if (rules.readyTimeoutTicks < rules.transitionTicks) {
      ctx.addIssue({
        code: "custom",
        path: ["readyTimeoutTicks"],
        message: `the ready timeout (${rules.readyTimeoutTicks} ticks) ends before the countdown (${rules.transitionTicks} ticks)`,
      });
    }
    if (rules.drawReturnMinSeparationTiles > 2 * rules.drawReturnMaxDistanceTiles) {
      ctx.addIssue({
        code: "custom",
        path: ["drawReturnMinSeparationTiles"],
        message: `two points within ${rules.drawReturnMaxDistanceTiles} tiles cannot be ${rules.drawReturnMinSeparationTiles} tiles apart`,
      });
    }
  });

export type EncounterRules = z.infer<typeof encounterRulesSchema>;

export const encounterRules: EncounterRules = {
  grapple: {
    windupTicks: secondsToTicks(GRAPPLE_WINDUP_SECONDS),
    rangeTiles: ENGAGEMENT_RANGE_TILES,
    hitConeHeadings: HIT_CONE_HEADINGS,
    targetConeHeadings: TARGET_CONE_HEADINGS,
    missCooldownTicks: secondsToTicks(MISS_COOLDOWN_SECONDS),
  },
  challenge: {
    windupTicks: secondsToTicks(CHALLENGE_LUNGE_SECONDS),
    rangeTiles: CHALLENGE_RANGE_TILES,
    hitConeHeadings: HIT_CONE_HEADINGS,
    targetConeHeadings: TARGET_CONE_HEADINGS,
    missCooldownTicks: secondsToTicks(MISS_COOLDOWN_SECONDS),
  },
  maxDuels: MAX_SIMULTANEOUS_DUELS,
  transitionTicks: secondsToTicks(TRANSITION_COUNTDOWN_SECONDS),
  readyTimeoutTicks: secondsToTicks(READY_TIMEOUT_SECONDS),
  spawnProtectionTicks: secondsToTicks(SPAWN_PROTECTION_SECONDS),
  winProtectionTicks: secondsToTicks(WIN_PROTECTION_SECONDS),
  drawProtectionTicks: secondsToTicks(DRAW_PROTECTION_SECONDS),
  respawnDelayTicks: secondsToTicks(RESPAWN_DELAY_SECONDS),
  respawnProtectionTicks: secondsToTicks(RESPAWN_PROTECTION_SECONDS),
  respawnClearRadiusTiles: SIGHT_RADIUS_TILES,
  drawReturnMinSeparationTiles: DRAW_RETURN_MIN_SEPARATION_TILES,
  drawReturnMaxDistanceTiles: DRAW_RETURN_MAX_DISTANCE_TILES,
};

export function validateEncounterRules(candidate: unknown): ValidationResult<EncounterRules> {
  const parsed = encounterRulesSchema.safeParse(candidate);
  return parsed.success ? { ok: true, value: parsed.data } : { ok: false, issues: formatIssues(parsed.error) };
}
