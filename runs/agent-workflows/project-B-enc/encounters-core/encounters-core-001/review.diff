+import { HEADING_COUNT, Terrain, terrainAt, type SeaMapDefinition } from "@pirate-sea-race/content";
+import { HEADING_DX, HEADING_DY, normalizeHeading } from "../heading.js";
+
+/**
+ * The encounter geometry, defined once (docs/encounters.md): integer sub-units, squared distances, the 64-heading
+ * table. Nothing here rounds a fraction or calls a transcendental function.
+ */
+
+/** A point in integer sub-units. */
+export interface EncounterPoint {
+  readonly x: number;
+  readonly y: number;
+}
+
+/** Squared distance, refusing coordinates whose square would not be an exact integer. */
+export function distanceSquared(from: EncounterPoint, to: EncounterPoint): number {
+  const dx = to.x - from.x;
+  const dy = to.y - from.y;
+  const squared = dx * dx + dy * dy;
+  if (!Number.isSafeInteger(squared)) throw new RangeError(`(${from.x}, ${from.y}) and (${to.x}, ${to.y}) are too far apart`);
+  return squared;
+}
+
+/** Within `range` sub-units, centre to centre; a point exactly on the boundary is inside. */
+export function withinRange(from: EncounterPoint, to: EncounterPoint, range: number): boolean {
+  return distanceSquared(from, to) <= range * range;
+}
+
+/**
+ * The heading (of 64) pointing most nearly along the offset: the one whose unit vector has the largest dot product
+ * with it, ties to the lower heading. A zero offset has no bearing (null).
+ */
+export function bearing(from: EncounterPoint, to: EncounterPoint): number | null {
+  const dx = to.x - from.x;
+  const dy = to.y - from.y;
+  if (dx === 0 && dy === 0) return null;
+  let best = 0;
+  let bestDot = dx * HEADING_DX[0]! + dy * HEADING_DY[0]!;
+  for (let heading = 1; heading < HEADING_COUNT; heading++) {
+    const dot = dx * HEADING_DX[heading]! + dy * HEADING_DY[heading]!;
+    if (dot > bestDot) {
+      best = heading;
+      bestDot = dot;
+    }
+  }
+  return best;
+}
+
+/** The circular difference between two headings, 0 to 32. */
+export function headingDifference(a: number, b: number): number {
+  const difference = normalizeHeading(a - b);
+  return Math.min(difference, HEADING_COUNT - difference);
+}
+
+/**
+ * Whether `to` lies within ±`cone` headings of `heading` seen from `from`. Distance 0 is inside every cone:
+ * overlapping ships do not block each other.
+ */
+export function withinCone(from: EncounterPoint, to: EncounterPoint, heading: number, cone: number): boolean {
+  const toward = bearing(from, to);
+  return toward === null || headingDifference(toward, heading) <= cone;
+}
+
+/** A tile, by its column and row. */
+export interface TileCell {
+  readonly tileX: number;
+  readonly tileY: number;
+}
+
+/**
+ * Every tile the segment between the centres of two tiles touches: a supercover line. Where it passes exactly
+ * through a tile corner, both tiles beside the corner count. The set is the same in either direction; the list runs
+ * from `from` to `to`.
+ */
+export function supercover(from: TileCell, to: TileCell): TileCell[] {
+  const nx = Math.abs(to.tileX - from.tileX);
+  const ny = Math.abs(to.tileY - from.tileY);
+  const sx = to.tileX > from.tileX ? 1 : -1;
+  const sy = to.tileY > from.tileY ? 1 : -1;
+  let x = from.tileX;
+  let y = from.tileY;
+  const cells: TileCell[] = [{ tileX: x, tileY: y }];
+  let ix = 0;
+  let iy = 0;
+  while (ix < nx || iy < ny) {
+    // Compares where the segment next crosses a vertical and a horizontal tile edge, in exact integers.
+    const decision = (1 + 2 * ix) * ny - (1 + 2 * iy) * nx;
+    if (decision === 0) {
+      cells.push({ tileX: x + sx, tileY: y }, { tileX: x, tileY: y + sy });
+      x += sx;
+      y += sy;
+      ix++;
+      iy++;
+    } else if (decision < 0) {
+      x += sx;
+      ix++;
+    } else {
+      y += sy;
+      iy++;
+    }
+    cells.push({ tileX: x, tileY: y });
+  }
+  return cells;
+}
+
+/** The tile holding a point. */
+export function tileOf(map: SeaMapDefinition, point: EncounterPoint): TileCell {
+  return { tileX: Math.floor(point.x / map.subUnitsPerTile), tileY: Math.floor(point.y / map.subUnitsPerTile) };
+}
+
+/** The centre of a tile, in sub-units. */
+export function tileCentre(map: SeaMapDefinition, tile: TileCell): EncounterPoint {
+  const half = Math.floor(map.subUnitsPerTile / 2);
+  return { x: tile.tileX * map.subUnitsPerTile + half, y: tile.tileY * map.subUnitsPerTile + half };
+}
+
+/**
+ * Ship line of sight: the supercover line between the centres of the two ships' tiles touches no land. Shoals and
+ * docks do not block (ships see over reefs); a tile off the map blocks.
+ */
+export function seaLineOfSight(map: SeaMapDefinition, from: EncounterPoint, to: EncounterPoint): boolean {
+  for (const cell of supercover(tileOf(map, from), tileOf(map, to))) {
+    const terrain = terrainAt(map, cell.tileX, cell.tileY);
+    if (terrain === undefined || terrain === Terrain.Land) return false;
+  }
+  return true;
+}
