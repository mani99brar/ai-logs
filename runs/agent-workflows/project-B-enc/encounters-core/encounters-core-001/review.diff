+import { createSeaMap, isNavigable, type SeaMapDefinition } from "@pirate-sea-race/content";
+import { describe, expect, it } from "vitest";
+import {
+  createEncounterConfig,
+  createEncounterState,
+  duelMarkers,
+  hashState,
+  stepEncounters,
+  tileCentre,
+  tileOf,
+  type DuelReport,
+  type EncounterConfig,
+  type EncounterEvent,
+  type EncounterPlayerInput,
+  type EncounterState,
