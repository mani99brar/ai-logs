+import { FEINT_REAPPEARANCE_FRAMES, strikesWithHitbox } from "@pirate-sea-race/content/moves";
+import { worldBox, type Facing, type WorldBox } from "./boxes.js";
+import { boltBox, restingStance } from "./entities.js";
+import { findMove, type DuelConfig, type FighterState, type Stance } from "./state.js";
+
+/**
+ * What the renderer must show of a fighter, even inside a smoke screen (§9: no uncounterable invisibility; §8: effects
+ * never hide the actionable part of an attack). When `obscured`, the renderer may hide which move is starting up (its
+ * startup animation), and nothing else.
+ */
+export interface FighterTells {
+  /** Inside a smoke screen: the startup animation may be obscured. */
+  readonly obscured: boolean;
+  /** Always shown: where the fighter is, which way it faces, its stance's hurtbox, and its health bar. */
+  readonly x: number;
+  readonly y: number;
+  readonly facing: Facing;
+  readonly stance: Stance;
+  readonly hurtbox: WorldBox;
+  readonly health: number;
+  readonly stamina: number;
+  /** A move is in its startup: at least a generic startup flash is shown, even when the move itself is hidden. */
+  readonly startingUp: boolean;
+  /** The active hitbox of a move that strikes: never hidden. */
+  readonly activeHitbox: WorldBox | null;
+  /** In a feint's readable reappearance (its first `FEINT_REAPPEARANCE_FRAMES` of recovery): never hidden. */
+  readonly reappearing: boolean;
+  /** The fighter's bolt: never hidden. */
+  readonly bolt: WorldBox | null;
+}
+
+/** The tells of a fighter as it stands in a state. */
+export function fighterTells(config: DuelConfig, fighter: FighterState): FighterTells {
+  const { moveset } = config;
+  const stance = restingStance(fighter);
+  const move = fighter.action === "attack" && fighter.moveId !== null ? findMove(moveset, fighter.moveId) : null;
+  const frame = fighter.actionFrame;
+  const startup = move?.timing.startup ?? 0;
+  const activeEnd = startup + (move?.timing.active ?? 0);
+  return {
+    obscured: fighter.obscured,
+    x: fighter.x,
+    y: fighter.y,
+    facing: fighter.facing,
+    stance,
+    hurtbox: worldBox(moveset.fighter.hurtboxes[stance], fighter.x, fighter.y, fighter.facing),
+    health: fighter.health,
+    stamina: fighter.stamina,
+    startingUp: move !== null && frame <= startup,
+    activeHitbox: move !== null && strikesWithHitbox(move) && frame > startup && frame <= activeEnd ? worldBox(move.hitbox, fighter.x, fighter.y, fighter.facing) : null,
+    reappearing: move !== null && move.effect === "feint" && frame > activeEnd && frame <= activeEnd + FEINT_REAPPEARANCE_FRAMES,
+    bolt: fighter.bolt === null ? null : boltBox(moveset, fighter.bolt),
+  };
+}
