+import { describe, expect, it } from "vitest";
+import { nextInt } from "../random.js";
+import { createDuelState, defaultDuelConfig as config, duelInput as I, hashState, MOVESET_VERSION, stepDuel, type DuelInputs, type DuelResult, type DuelState } from "./index.js";
+
+/**
+ * Golden traces of the Duelist mirror, recorded before the kits changed the step (at commit 4c90df5, by a throwaway
+ * recorder run from outside the repository). A duel created without kits must reproduce them frame by frame: only the
+ * moveset version and the new kit and entity fields (`kit`, `bolt`, `zone`, `obscured`) may differ.
+ *
+ * Each duel is played by a seeded random policy (`mirrorPlayers`) that reads only fields older than the kits, so the
+ * inputs are the recorded ones as long as the states match. For each duel: the hash (`hashState`) of every frame's legacy projection, from frame 0 up to the
+ * result, as one string of 16-digit hashes, and the projection itself as JSON every 300 frames, to diagnose a mismatch.
+ */
+interface GoldenDuel {
+  readonly seed: number;
+  /** Frames stepped up to and including the result. */
+  readonly frames: number;
+  readonly result: DuelResult;
+  readonly hashes: string;
+  /** The projection at frames 0, 300, 600, ... */
+  readonly checkpoints: readonly string[];
+}
+
+/** Every field a fighter had before the kits. */
+const LEGACY_FIGHTER_FIELDS = [
+  "x",
+  "y",
+  "vx",
+  "vy",
+  "facing",
+  "health",
+  "stamina",
+  "staminaIdle",
+  "action",
+  "actionFrame",
+  "timer",
+  "moveId",
+  "moveHit",
+  "crouching",
+  "combo",
+  "held",
+  "buffer",
+] as const;
+
+/** The fields the kits added to a fighter, with their value in a duel without kits. */
+const KIT_FIELDS = { kit: "duelist", bolt: null, zone: null, obscured: false } as const;
+
+/** Everything of a state that existed before the kits, but the moveset version. */
+function legacy(state: DuelState) {
+  return {
+    frame: state.frame,
+    phase: state.phase,
+    rng: state.rng,
+    fighters: state.fighters.map((fighter) => Object.fromEntries(LEGACY_FIGHTER_FIELDS.map((field) => [field, fighter[field]]))),
+    events: state.events,
+    result: state.result,
+  };
+}
+
+/** The recorder's input policy, verbatim. */
+/**
+ * A seeded random player pair for the Duelist mirror. Each player follows random plans (movement, guard, attacks of
+ * every kind, more often up close), and reacts at random to what it sees: it may guard (standing or crouching) when the
+ * opponent starts an attack, try to escape a grab, and follow up on an opponent in hitstun. It reads only fields
+ * that existed before the kits.
+ */
+function mirrorPlayers(seed: number): (state: DuelState) => DuelInputs {
+  let rng = seed;
+  const draw = (bound: number) => {
+    const drawn = nextInt(rng, bound);
+    rng = drawn.state;
+    return drawn.value;
+  };
+  const held = [0, 0];
+  const left = [0, 0];
+  return (state) => {
+    for (const player of [0, 1] as const) {
+      const self = state.fighters[player];
+      const other = state.fighters[player === 0 ? 1 : 0];
+      const back = self.x < other.x ? I("left") : I("right");
+      const forward = self.x < other.x ? I("right") : I("left");
+      const gap = Math.abs(self.x - other.x);
+      if (self.action === "thrown" && self.actionFrame >= 2 && draw(100) < 7) {
+        held[player] = I("light", "heavy");
+        left[player] = 1;
+      } else if (other.action === "attack" && other.actionFrame === 1 && gap < 2400 && draw(100) < 50) {
+        held[player] = back | (draw(100) < 35 ? I("down") : 0);
+        left[player] = other.timer + 2;
+      } else if (other.action === "hitstun" && other.actionFrame === 1 && gap < 1600 && draw(100) < 50) {
+        held[player] = [I("light"), I("heavy"), I("down", "light"), I("special1")][draw(4)]!;
+        left[player] = 1;
+      } else if (left[player] === 0) {
+        const approach = gap > 2400 ? [forward, forward, forward, I("dash")] : [];
+        const moves = [0, back, back, back | I("down"), forward, forward, forward, I("down"), I("up") | forward, I("dash"), back | I("dash"), I("left", "right"), ...approach];
+        const attacks = [I("light"), I("light"), I("heavy"), I("down", "heavy"), forward | I("heavy"), I("down", "light"), I("special1"), I("special2"), I("light", "heavy"), I("light", "heavy")];
+        const attack = draw(100) < (gap < 1800 ? 45 : 10);
+        held[player] = attack ? attacks[draw(attacks.length)]! : moves[draw(moves.length)]!;
+        left[player] = attack || (held[player]! & I("up")) !== 0 ? 1 + draw(2) : 1 + draw(16);
+      }
+      left[player]!--;
+    }
+    return [held[0]!, held[1]!];
+  };
+}
