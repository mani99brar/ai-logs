+describe("the Duelist mirror without kits", () => {
+  it("covers at least 5,000 frames before the results, with guarding, throws, escapes and guard breaks", () => {
+    expect(GOLDEN.reduce((sum, duel) => sum + duel.frames, 0)).toBeGreaterThanOrEqual(5000);
+    const kinds = new Set<string>();
+    for (const duel of GOLDEN) {
+      const players = mirrorPlayers(duel.seed);
+      let state = createDuelState(config, { seed: duel.seed });
+      while (state.result === null) {
+        state = stepDuel(config, state, players(state));
+        for (const event of state.events) kinds.add(event.kind);
+      }
+    }
+    expect([...kinds].sort()).toEqual(["block", "grab", "guard-break", "hit", "throw", "throw-escape"]);
+    expect(GOLDEN.map((duel) => duel.result.reason).sort()).toEqual(["ko", "ko", "timeout"]);
+  });
+
+  it.each(GOLDEN)("reproduces every frame of the recorded duel with seed $seed", (duel) => {
+    expect(duel.hashes.length).toBe(16 * (duel.frames + 1));
+    const players = mirrorPlayers(duel.seed);
+    let state = createDuelState(config, { seed: duel.seed });
+    for (let frame = 0; frame <= duel.frames; frame++) {
+      if (frame > 0) state = stepDuel(config, state, players(state));
+      const projected = legacy(state);
+      if (frame % 300 === 0) expect(projected, `frame ${frame}`).toEqual(JSON.parse(duel.checkpoints[frame / 300]!));
+      if (hashState(projected) !== duel.hashes.slice(16 * frame, 16 * frame + 16)) {
+        // Show the difference against the last checkpoint's frame first, then fail on this one.
+        expect(hashState(projected), `frame ${frame} (last checkpoint ${300 * Math.floor(frame / 300)})`).toBe(duel.hashes.slice(16 * frame, 16 * frame + 16));
+      }
+      for (const fighter of state.fighters) {
+        expect(Object.keys(fighter).sort()).toEqual([...LEGACY_FIGHTER_FIELDS, ...Object.keys(KIT_FIELDS)].sort());
+        expect(fighter).toMatchObject(KIT_FIELDS);
+      }
+    }
+    expect(state.result).toEqual(duel.result);
+    expect(state.movesetVersion).toBe(MOVESET_VERSION);
+  });
+});
