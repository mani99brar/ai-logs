+describe("fruit kits (§9)", () => {
+  it("hold the Duelist, Ember and Smoke kits, each two valid specials in the one moveset", () => {
+    expect(KIT_IDS).toEqual(["duelist", "ember", "smoke"]);
+    expect(duelistMoveset.kits).toEqual({
+      duelist: { special1: "advancing-thrust", special2: "counter-slash" },
+      ember: { special1: "flame-bolt-cast", special2: "rising-flare" },
+      smoke: { special1: "feint-dash", special2: "smoke-screen" },
+    });
+    expect(duelistMoveset.moves).toEqual([...duelistMoves, ...emberMoves, ...smokeMoves]);
+    for (const kit of KIT_IDS) {
+      for (const id of [duelistMoveset.kits[kit].special1, duelistMoveset.kits[kit].special2]) {
+        const move = byId(id);
+        expect(validateDuelMove(move), id).toMatchObject({ ok: true });
+        expect(move.category).toBe("special");
+      }
+    }
+    // The Duelist's commands keep its specials, so a duel without kits is unchanged.
+    expect([duelistMoveset.commands.special1, duelistMoveset.commands.special2]).toEqual(["advancing-thrust", "counter-slash"]);
+  });
+
+  it("give each move one effect: the flame bolt casts a projectile, the screen a zone, the feint only moves", () => {
+    expect(Object.fromEntries(duelistMoveset.moves.map((move) => [move.timing.id, move.effect]))).toMatchObject({
+      jab: "strike",
+      throw: "strike",
+      "rising-flare": "strike",
+      "flame-bolt-cast": "projectile",
+      "smoke-screen": "zone",
+      "feint-dash": "feint",
+    });
+    expect(duelistMoveset.moves.filter((move) => !strikesWithHitbox(move)).map((move) => move.timing.id)).toEqual(["flame-bolt-cast", "feint-dash", "smoke-screen"]);
+  });
+
+  it("keep every new special within §8's budgets (docs/fruit-kits.md's named checks)", () => {
+    expect(kitBudgetIssues(duelistMoveset)).toEqual([]);
+    const cast = byId("flame-bolt-cast");
+    const projectileRow = baselineFrameBudgets.find((row) => row.id === "projectile-special")!;
+    expect(cast.timing.startup).toBeGreaterThanOrEqual(projectileRow.startup);
+    expect(cast.timing.recovery).toBeGreaterThanOrEqual(projectileRow.recovery);
+    for (const id of ["rising-flare", "feint-dash", "smoke-screen"]) expect(byId(id).timing.startup, id).toBeGreaterThanOrEqual(byId("counter-slash").timing.startup);
+    expect(byId("rising-flare").timing.recovery).toBeGreaterThanOrEqual(30);
+    expect(byId("feint-dash").timing.recovery).toBeGreaterThanOrEqual(FEINT_REAPPEARANCE_FRAMES);
+    const flare = byId("rising-flare");
+    expect(flare.blockstun - flare.timing.active - flare.timing.recovery).toBe(flare.timing.onBlock.kind === "frames" ? flare.timing.onBlock.advantage : NaN);
+    expect(cast.projectile!.blockstun - cast.timing.active - cast.timing.recovery).toBeLessThan(0);
+  });
+
+  it.each([
