    effect: "strike",
    category: "special",
    stance: "standing",
    guard: "high",
    hitbox: { x: px(4), y: px(40), w: px(72), h: px(136) },
    damage: 120,
    hitstun: 30,
    blockstun: 12,
    hitPushback: px(8),
