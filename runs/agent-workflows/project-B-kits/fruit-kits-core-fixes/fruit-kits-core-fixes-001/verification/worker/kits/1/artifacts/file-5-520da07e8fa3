import { duelArena, duelistFighter, duelistMoves, duelRules } from "./duelist.js";
import { duelKits, emberMoves, smokeMoves } from "./kits.js";
import type { DuelMoveset } from "./schema.js";
import { movesetVersion } from "./version.js";

/**
 * The duel's move data: the rules, the arena, the fighter's body, the Duelist's normals and specials, and the Ember
 * and Smoke kits' specials (§9). Every kit shares the body, normals, throw and guard; a fighter's kit picks its two
 * specials. A duel without kits is the Duelist mirror.
 */
export const duelistMoveset: DuelMoveset = {
  rules: duelRules,
  arena: duelArena,
  fighter: duelistFighter,
  moves: [...duelistMoves, ...emberMoves, ...smokeMoves],
  commands: {
    light: "jab",
    downLight: "anti-air",
    heavy: "heavy-mid",
    downHeavy: "low-sweep",
    forwardHeavy: "launcher",
    special1: duelKits.duelist.special1,
    special2: duelKits.duelist.special2,
    throw: "throw",
  },
  kits: duelKits,
};

/** Identifies all the move data, every kit included: the hash of `duelistMoveset`, so any change to the data changes it. */
export const MOVESET_VERSION = movesetVersion(duelistMoveset);
