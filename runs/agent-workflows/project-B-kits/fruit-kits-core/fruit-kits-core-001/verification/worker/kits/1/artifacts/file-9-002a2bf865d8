import type { DuelMoveset, DuelProjectile, DuelZone } from "@pirate-sea-race/content/moves";
import { divTrunc } from "../fixed.js";
import { overlaps, worldBox, type Facing, type WorldBox } from "./boxes.js";
import { currentMoveFrame, findMove, type Bolt, type FighterState, type Stance, type Zone } from "./state.js";

/** The strike data of a fighter's bolt: its cast move's `projectile`. */
export function projectileOf(moveset: DuelMoveset, bolt: Bolt): DuelProjectile {
  const projectile = findMove(moveset, bolt.moveId).projectile;
  if (projectile === undefined) throw new Error(`"${bolt.moveId}" releases no bolt`);
  return projectile;
}

/** The zone data of a fighter's smoke screen: its cast move's `zone`. */
export function zoneDataOf(moveset: DuelMoveset, zone: Zone): DuelZone {
  const data = findMove(moveset, zone.moveId).zone;
  if (data === undefined) throw new Error(`"${zone.moveId}" lays no zone`);
  return data;
}

/** The way a bolt flies: 1 is right. */
export function boltDirection(bolt: Bolt): Facing {
  return bolt.vx < 0 ? -1 : 1;
}

/** A bolt's box in arena coordinates, at its position or at `x`. */
export function boltBox(moveset: DuelMoveset, bolt: Bolt, x = bolt.x): WorldBox {
  return worldBox(projectileOf(moveset, bolt).box, x, bolt.y, boltDirection(bolt));
}

/** A smoke screen's box in arena coordinates. */
export function zoneBox(moveset: DuelMoveset, zone: Zone): WorldBox {
  return worldBox(zoneDataOf(moveset, zone).box, zone.x, 0, zone.facing);
}

/** The hurtbox stance of a fighter as it stands in a state (the step's own stance also reads the frame's input). */
export function restingStance(fighter: FighterState): Stance {
  if (fighter.y > 0 || fighter.vy > 0 || fighter.action === "jump") return "airborne";
  return fighter.crouching ? "crouching" : "standing";
}

/**
 * The bolt a fighter's projectile special releases this frame (its first active frame, judged from the start-of-frame
 * state), or null. The slot must be empty; the cast cannot start otherwise, so this only guards the invariant.
 */
export function releasedBolt(moveset: DuelMoveset, fighter: FighterState): Bolt | null {
  if (fighter.action !== "attack" || fighter.moveId === null || fighter.bolt !== null) return null;
  const move = findMove(moveset, fighter.moveId);
  const { projectile } = move;
  if (projectile === undefined || currentMoveFrame(fighter) !== move.timing.startup + 1) return null;
  return {
    moveId: move.timing.id,
    x: fighter.x + fighter.facing * projectile.spawn.x,
    y: fighter.y + projectile.spawn.y,
    vx: fighter.facing * projectile.speed,
    life: projectile.life,
  };
}

/** The smoke screen a fighter's zone special lays this frame (its first active frame), where it stands, or null. */
export function laidZone(moveset: DuelMoveset, fighter: FighterState): Zone | null {
  if (fighter.action !== "attack" || fighter.moveId === null || fighter.zone !== null) return null;
  const move = findMove(moveset, fighter.moveId);
  if (move.zone === undefined || currentMoveFrame(fighter) !== move.timing.startup + 1) return null;
  return { moveId: move.timing.id, x: fighter.x, facing: fighter.facing, life: move.zone.life };
}

/** One bolt's path this frame: from `from` to `from + travel` (a bolt released this frame does not move yet). */
export interface BoltPath {
  readonly bolt: Bolt;
  readonly from: number;
  readonly travel: number;
}

/**
 * Substeps for this frame's sweep: enough that no bolt moves more than half the narrowest box involved (a bolt or a
 * hurtbox) per substep, so two bolts closing fast, or a bolt and a hurtbox, cannot pass through each other.
 */
export function substeps(moveset: DuelMoveset, paths: readonly (BoltPath | null)[]): number {
  const widths = [...Object.values(moveset.fighter.hurtboxes).map((box) => box.w)];
  for (const path of paths) if (path !== null) widths.push(projectileOf(moveset, path.bolt).box.w);
  const narrowest = Math.min(...widths);
  let count = 1;
  for (const path of paths) {
    if (path !== null) count = Math.max(count, divTrunc(2 * Math.abs(path.travel) + narrowest - 1, narrowest));
  }
  return count;
}

/** The bolt's x after substep `k` of `count` (0 is the start of the frame, `count` the end). */
export function pathX(path: BoltPath, k: number, count: number): number {
  return path.from + divTrunc(path.travel * k, count);
}

/** The first substep (0 to `count`) at which the bolt's box overlaps `target`, or null. */
export function firstReach(moveset: DuelMoveset, path: BoltPath, count: number, target: WorldBox): number | null {
  for (let k = 0; k <= count; k++) if (overlaps(boltBox(moveset, path.bolt, pathX(path, k, count)), target)) return k;
  return null;
}

/** The first substep at which two bolts, moved in step, overlap, or null. */
export function firstMeeting(moveset: DuelMoveset, a: BoltPath, b: BoltPath, count: number): number | null {
  for (let k = 0; k <= count; k++) {
    if (overlaps(boltBox(moveset, a.bolt, pathX(a, k, count)), boltBox(moveset, b.bolt, pathX(b, k, count)))) return k;
  }
  return null;
}

/** Whether a bolt whose box ends at `x` has reached a wall (any part of it outside the arena). */
export function atWall(moveset: DuelMoveset, bolt: Bolt, x: number): boolean {
  const box = boltBox(moveset, bolt, x);
  return box.x0 < 0 || box.x1 > moveset.arena.width;
}

/** Whether a fighter's hurtbox, as it stands, is inside any of the smoke screens. */
export function insideZone(moveset: DuelMoveset, fighter: FighterState, zones: readonly (Zone | null)[]): boolean {
  const body = worldBox(moveset.fighter.hurtboxes[restingStance(fighter)], fighter.x, fighter.y, fighter.facing);
  return zones.some((zone) => zone !== null && overlaps(zoneBox(moveset, zone), body));
}
