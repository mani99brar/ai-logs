import { describe, expect, it } from "vitest";
import { canonicalize } from "../hash.js";
import { nextInt } from "../random.js";
import {
  canAct,
  createDuelInputLog,
  createDuelState,
  defaultDuelConfig as config,
  duelInput as I,
  fighterTells,
  hashState,
  KIT_IDS,
  mirrorDuelInput,
  replayDuel,
  restoreDuel,
  sliceDuelInputLog,
  snapshotDuel,
  traceDuel,
  type DuelEvent,
  type DuelInputs,
  type DuelState,
  type FighterState,
  type KitId,
} from "./index.js";

const { rules, arena } = config.moveset;
const U = I("special1");
const SPECIAL2 = I("special2");
const LIGHT = I("light");
const HEAVY = I("heavy");

function duel(kits: readonly [KitId, KitId], x0: number, x1: number): DuelState {
  return createDuelState(config, { x: [x0, x1], kits });
}

function hold(frames: number, p1 = 0, p2 = 0): DuelInputs[] {
  return Array.from({ length: frames }, () => [p1, p2] as const);
}

/** `frames` of neutral input with the given presses: `[frame, p1, p2]` (frames count from 1). */
function presses(frames: number, ...at: readonly (readonly [number, number, number])[]): DuelInputs[] {
  const inputs = hold(frames);
  for (const [frame, p1, p2] of at) inputs[frame - 1] = [p1, p2];
  return inputs;
}

function run(state: DuelState, inputs: readonly DuelInputs[]): DuelState[] {
  return traceDuel(config, state, inputs);
}

function events(trace: readonly DuelState[]): string[] {
  return trace.flatMap((state) => state.events.map((event) => `${state.frame} ${event.kind} ${event.attacker} ${event.moveId}`));
}

/** The pairs of §9's slice: every fruit against the Duelist, the fruits against each other, and the fruit mirrors. */
const PAIRS: readonly (readonly [KitId, KitId])[] = [
  ["duelist", "ember"],
  ["duelist", "smoke"],
  ["ember", "smoke"],
  ["ember", "ember"],
  ["smoke", "smoke"],
];

describe("Duelist vs Ember", () => {
  it("Ember controls space where the Duelist has limited long-range pressure", () => {
    // 250 px apart, both use U: the advancing thrust falls short and runs into the flame bolt.
    const trace = run(duel(["duelist", "ember"], 3000, 7000), presses(90, [1, U, U]));
    expect(events(trace)).toEqual([expect.stringMatching(/^\d+ hit 1 flame-bolt$/)]);
  });

  it("Ember's long recovery is punished when a jump clears the bolt", () => {
    const trace = run(duel(["duelist", "ember"], 4000, 6560), presses(80, [1, 0, U], [5, I("up", "right"), 0], [45, HEAVY, 0]));
    expect(events(trace)).toEqual(["64 hit 0 heavy-mid"]);
  });

  it("the Duelist's reliable close combat: a jab beats the bolt's 22-frame startup up close", () => {
    const trace = run(duel(["duelist", "ember"], 5000, 5700), presses(40, [1, LIGHT, U]));
    expect(events(trace)).toEqual(["8 hit 0 jab"]);
    expect(trace.every((state) => state.fighters[1].bolt === null)).toBe(true);
  });

  it("a whiffed rising flare is punished by a Duelist heavy", () => {
    const inputs = presses(80, [1, 0, SPECIAL2]);
    for (let frame = 16; frame <= 22; frame++) inputs[frame - 1] = [I("right"), 0];
    inputs[22] = [HEAVY, 0];
    expect(events(run(duel(["duelist", "ember"], 4000, 5600), inputs))).toEqual(["41 hit 0 heavy-mid"]);
  });
});

describe("Duelist vs Smoke", () => {
  it("Smoke changes spacing: the feint passes through a heavy, then cancels into a jab that punishes it", () => {
    // The Duelist's heavy is active on frames 19-22; the feint, started on frame 13, is invulnerable until frame 22.
    const trace = run(duel(["smoke", "duelist"], 4400, 6000), presses(60, [1, 0, HEAVY], [13, U, 0], [37, LIGHT, 0]));
    expect(events(trace)).toEqual(["44 hit 0 jab"]);
    expect(trace[43]!.fighters[1]).toMatchObject({ action: "attack", moveId: "heavy-mid" });
  });

  it("Smoke obscures its intent inside its screen, but not its position, health or active hitboxes", () => {
    const trace = run(duel(["smoke", "duelist"], 3000, 3600), presses(50, [1, SPECIAL2, 0], [35, LIGHT, 0]));
    expect(fighterTells(config, trace[36]!.fighters[0])).toMatchObject({ obscured: true, startingUp: true, x: 3000, health: 1000 });
    expect(fighterTells(config, trace[42]!.fighters[0]).activeHitbox).not.toBeNull();
  });

  it("Smoke's reappearance is readable: the Duelist's jab lands in it; Smoke's specials never deal damage", () => {
    // The feint ends 30 px from the Duelist, who presses J on the reappearance's first frame.
    const trace = run(duel(["smoke", "duelist"], 4000, 5600), presses(40, [1, U, 0], [13, 0, LIGHT]));
    expect(events(trace)).toEqual(["20 hit 1 jab"]);
    expect(trace[19]!.fighters[0]).toMatchObject({ moveId: "feint-dash", actionFrame: 19 });
    expect(trace.every((state) => state.fighters[1].health === 1000)).toBe(true);
  });

  it("the Duelist's reliable close combat: the counter slash goes through Smoke's jab", () => {
    const trace = run(duel(["smoke", "duelist"], 5000, 5600), presses(40, [1, LIGHT, 0], [3, 0, SPECIAL2]));
    expect(events(trace)).toEqual(["11 hit 1 counter-slash"]);
  });
});

describe("Ember vs Smoke", () => {
  it("Ember controls space: the bolt hits Smoke at range, which has no projectile to answer", () => {
    const trace = run(duel(["smoke", "ember"], 3000, 7000), presses(90, [1, 0, U]));
    expect(events(trace)).toEqual([expect.stringMatching(/^\d+ hit 1 flame-bolt$/)]);
  });

  it("Smoke feints through the bolt and punishes the Ember's long recovery", () => {
    // Timed so the bolt passes inside the feint's invulnerable dash; the jab lands on frame 63, the Ember recovers on 65.
    const trace = run(duel(["smoke", "ember"], 4000, 6400), presses(100, [1, 0, U], [32, U, 0], [56, LIGHT, 0]));
    expect(events(trace)).toEqual(["63 hit 0 jab"]);
    expect(canAct(trace[62]!.fighters[1])).toBe(false);
    // A feint started two frames earlier leaves the reappearance inside the bolt.
    expect(events(run(duel(["smoke", "ember"], 4000, 6400), presses(100, [1, 0, U], [30, U, 0])))).toEqual(["40 hit 1 flame-bolt"]);
  });

  it("Smoke's readable reappearance is punished by the rising flare", () => {
    const trace = run(duel(["smoke", "ember"], 4000, 6000), presses(80, [1, U, 0], [13, 0, SPECIAL2]));
    expect(events(trace)).toEqual(["22 hit 1 rising-flare"]);
    expect(fighterTells(config, trace[21]!.fighters[0]).reappearing).toBe(true);
  });
});

describe("Ember vs Ember", () => {
  it("bolts cancel each other: neither controls the space alone", () => {
    const trace = run(duel(["ember", "ember"], 3000, 7000), presses(120, [1, U, U]));
    expect(events(trace)).toEqual([]);
    expect(trace[120]!.fighters.map((fighter) => fighter.bolt)).toEqual([null, null]);
  });

  it("the rising flare punishes a jump; a whiffed flare is punished in turn", () => {
    expect(events(run(duel(["ember", "ember"], 4000, 6400), presses(60, [1, I("up", "right"), 0], [12, 0, SPECIAL2])))).toEqual(["24 hit 1 rising-flare"]);
    const inputs = presses(80, [1, 0, SPECIAL2]);
    for (let frame = 16; frame <= 22; frame++) inputs[frame - 1] = [I("right"), 0];
    inputs[22] = [HEAVY, 0];
    expect(events(run(duel(["ember", "ember"], 4000, 5600), inputs))).toEqual(["41 hit 0 heavy-mid"]);
  });
