new file mode 100644
index 0000000..a499cc5
--- /dev/null
+++ b/apps/web/src/duelKeyboard.ts
@@ -0,0 +1,69 @@
+import { DUEL_INPUT } from "@pirate-sea-race/content/moves";
+
+/** The duel's keyboard defaults (§8): WASD or the arrows move, J light, K heavy, U and I the specials, Shift dash. */
+export const DUEL_KEYS: Readonly<Record<keyof typeof DUEL_INPUT, readonly string[]>> = {
+  left: ["KeyA", "ArrowLeft"],
+  right: ["KeyD", "ArrowRight"],
+  up: ["KeyW", "ArrowUp"],
+  down: ["KeyS", "ArrowDown"],
+  light: ["KeyJ"],
+  heavy: ["KeyK"],
+  special1: ["KeyU"],
+  special2: ["KeyI"],
+  dash: ["ShiftLeft", "ShiftRight"],
+};
+
+const BIT_OF_CODE = new Map<string, number>(
+  (Object.entries(DUEL_KEYS) as [keyof typeof DUEL_INPUT, readonly string[]][]).flatMap(([name, codes]) => codes.map((code) => [code, DUEL_INPUT[name]] as const)),
+);
+
+/** The input bits for a set of held key codes. Opposite directions both held stay in: the step makes them neutral. */
+export function duelBits(codes: Iterable<string>): number {
+  let bits = 0;
+  for (const code of codes) bits |= BIT_OF_CODE.get(code) ?? 0;
+  return bits;
+}
+
+/**
+ * The duel's keyboard adapter. `bits()` is what is held now, plus every key pressed since the last frame the client
+ * tagged: a tap that goes down and up between two frames still counts for one frame. The caller calls `framesTagged()`
+ * once the pressed keys have been tagged into a frame. Every key is released when the window loses focus.
+ */
+export class DuelKeyboard {
+  private readonly held = new Set<string>();
+  private tapped = 0;
+
+  constructor(target: Window) {
+    target.addEventListener("keydown", (event) => {
+      if (!BIT_OF_CODE.has(event.code) || isTyping(event.target)) return;
+      event.preventDefault();
+      this.press(event.code);
+    });
+    target.addEventListener("keyup", (event) => this.release(event.code));
+    target.addEventListener("blur", () => this.held.clear());
+  }
+
+  press(code: string): void {
+    this.held.add(code);
+    this.tapped |= BIT_OF_CODE.get(code) ?? 0;
+  }
+
+  release(code: string): void {
+    this.held.delete(code);
+  }
+
+  bits(): number {
+    return duelBits(this.held) | this.tapped;
+  }
+
+  /** The keys pressed so far have made it into a tagged frame; a tap released since then no longer counts. */
+  framesTagged(): void {
+    this.tapped = 0;
+  }
+}
+
+/** Keys typed into a text field or a menu are not moves; a checkbox or a button does not take them. */
+function isTyping(target: EventTarget | null): boolean {
+  if (target instanceof HTMLInputElement) return target.type !== "checkbox" && target.type !== "button";
+  return target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement;
+}
