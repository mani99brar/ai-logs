+    await expect(host.getByTestId("duel-corrections")).toHaveAttribute("data-count", /^\d+$/);
+
+    await attachScreenshot(host, testInfo, "duel-online");
+  } finally {
+    await hostContext.close();
+    await guestContext.close();
+  }
+});
