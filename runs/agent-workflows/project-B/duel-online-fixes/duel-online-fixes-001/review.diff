+const J = duelInput("light");
+const K = duelInput("heavy");
+
+async function track(client: Promise<HeadlessDuelClient>): Promise<HeadlessDuelClient> {
+  const joined = await client;
+  clients.push(joined);
+  return joined;
+}
+
+function roomOf(client: HeadlessDuelClient): DuelRoom {
+  return matchMaker.getLocalRoomById(client.room.roomId) as unknown as DuelRoom;
