index 0000000..a09220c
--- /dev/null
+++ b/apps/web/src/duelHud.ts
@@ -0,0 +1,108 @@
+import type { DuelRoomPhase } from "@pirate-sea-race/protocol";
+import type { DuelState, PlayerIndex } from "@pirate-sea-race/simulation/duel";
+
+export type DuelConnectionStatus = "connected" | "reconnecting" | "disconnected";
+
+export interface DuelHudModel {
+  readonly code: string;
+  readonly practice: boolean;
+  readonly phase: DuelRoomPhase;
+  readonly status: DuelConnectionStatus;
+  /** This browser's player, 0 or 1. */
+  readonly self: PlayerIndex;
+  /** Frames left in the countdown. */
+  readonly countdown: number;
+  /** Seats connected, by player. */
+  readonly connected: readonly [boolean, boolean];
+  /** The newest state stepped from the server's confirmed inputs: the authoritative health, stamina and clock. */
+  readonly confirmed: DuelState;
+  readonly maxHealth: number;
+  readonly maxStamina: number;
+  readonly roundFrames: number;
+  readonly overtimeFrames: number;
+  readonly rttMs: number;
+  readonly inputDelay: number;
+  readonly corrections: number;
+  readonly result: { readonly winner: number; readonly reason: string } | undefined;
+}
+
+function field(root: ParentNode, id: string): HTMLElement {
+  const element = root.querySelector<HTMLElement>(`[data-testid="${id}"]`);
+  if (element === null) throw new Error(`missing duel HUD field ${id}`);
+  return element;
+}
+
+/**
+ * The round clock in whole seconds (§7: 60 seconds, then 10 of overtime on equal health). It reads 0 on the round's
+ * last frame, where a timeout is decided; overtime starts on the frame after.
+ */
+export function roundClock(frame: number, roundFrames: number, overtimeFrames: number): { seconds: number; overtime: boolean } {
+  if (frame <= roundFrames) return { seconds: Math.ceil((roundFrames - frame) / 60), overtime: false };
+  return { seconds: Math.max(0, Math.ceil((roundFrames + overtimeFrames - frame) / 60)), overtime: true };
+}
+
+const REASONS: Record<string, string> = {
+  ko: "KO",
+  "double-ko": "double KO",
+  timeout: "time",
+  overtime: "overtime",
+  forfeit: "forfeit",
+};
+
+/** "Player 1 wins by KO", "Draw (double KO)", and "Both forfeit: no winner" when both forfeited on the same frame (§12). */
+export function resultText(winner: number, reason: string): string {
+  if (winner < 0 && reason === "forfeit") return "Both forfeit: no winner";
+  const how = REASONS[reason] ?? reason;
+  return winner < 0 ? `Draw (${how})` : `Player ${winner + 1} wins by ${how}`;
+}
+
+function playerName(model: DuelHudModel, player: PlayerIndex): string {
+  if (player === model.self) return `Player ${player + 1} (you)`;
+  return model.practice ? `Player ${player + 1} (dummy)` : `Player ${player + 1}`;
+}
+
+/**
+ * The duel HUD (§13): both health bars and stamina, the round clock and the connection line, all from the confirmed
+ * (server-equal) state, then the result. Data attributes carry the exact numbers for the browser tests.
+ */
+export function renderDuelHud(root: ParentNode, model: DuelHudModel): void {
+  field(root, "duel-code").textContent = model.practice ? `${model.code} (practice)` : model.code;
+  field(root, "duel-status").textContent = model.status;
+  const phase = field(root, "duel-phase");
+  phase.textContent = model.phase === "countdown" ? `Fight in ${Math.ceil(model.countdown / 60)}` : model.phase;
+  phase.dataset["phase"] = model.phase;
+
+  for (const player of [0, 1] as const) {
+    const fighter = model.confirmed.fighters[player];
+    field(root, `duel-name-${player}`).textContent = `${playerName(model, player)}${model.practice && player === 1 ? "" : model.connected[player] ? "" : " (away)"}`;
+    const health = field(root, `duel-health-${player}`);
+    health.dataset["value"] = String(fighter.health);
+    health.style.setProperty("--fill", `${(100 * fighter.health) / model.maxHealth}%`);
+    field(root, `duel-health-text-${player}`).textContent = `${fighter.health} / ${model.maxHealth}`;
+    const stamina = field(root, `duel-stamina-${player}`);
+    stamina.dataset["value"] = String(fighter.stamina);
+    stamina.style.setProperty("--fill", `${(100 * fighter.stamina) / model.maxStamina}%`);
+  }
+
+  const clock = roundClock(model.confirmed.frame, model.roundFrames, model.overtimeFrames);
+  const clockField = field(root, "duel-clock");
+  clockField.textContent = clock.overtime ? `OT ${clock.seconds}` : String(clock.seconds);
+  clockField.dataset["frame"] = String(model.confirmed.frame);
+  clockField.dataset["seconds"] = String(clock.seconds);
+
+  field(root, "duel-rtt").textContent = `${Math.round(model.rttMs)} ms`;
+  field(root, "duel-delay").textContent = model.inputDelay > 0 ? `${model.inputDelay} frames` : "measuring";
+  field(root, "duel-delay").dataset["frames"] = String(model.inputDelay);
+  field(root, "duel-corrections").textContent = String(model.corrections);
+  field(root, "duel-corrections").dataset["count"] = String(model.corrections);
+
+  const result = field(root, "duel-result");
+  result.hidden = model.result === undefined;
+  if (model.result !== undefined) {
