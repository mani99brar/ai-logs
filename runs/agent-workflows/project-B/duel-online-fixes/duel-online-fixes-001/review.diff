+/** The refusal a request ends with; fails the test if the request succeeds. */
+async function refusal(attempt: Promise<unknown>): Promise<{ code: unknown; message: string }> {
+  const error: unknown = await attempt.then(
+    () => expect.fail("the request was admitted"),
+    (reason: unknown) => reason,
+  );
+  return { code: (error as { code?: unknown }).code, message: (error as Error).message };
+}
+
+/** The pairs the server applied, by frame, from the bundles a client received. */
+function appliedPairs(bundles: readonly DuelFrameBundle[]): Map<number, { pair: readonly [number, number]; substituted: [boolean, boolean] }> {
+  const pairs = new Map<number, { pair: readonly [number, number]; substituted: [boolean, boolean] }>();
+  for (const bundle of bundles) {
+    const first = bundle.frame - bundle.inputs.length + 1;
+    bundle.inputs.forEach((pair, index) => {
+      pairs.set(first + index, { pair, substituted: [((bundle.substituted >> (2 * index)) & 1) === 1, ((bundle.substituted >> (2 * index + 1)) & 1) === 1] });
+    });
+  }
+  return pairs;
+}
