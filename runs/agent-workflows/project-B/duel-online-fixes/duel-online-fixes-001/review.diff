index 0000000..b6d9a97
--- /dev/null
+++ b/packages/simulation/src/netcode/clock.ts
@@ -0,0 +1,44 @@
+import { FRAME_MS } from "./timing.js";
+
+interface OriginSample {
+  readonly atMs: number;
+  readonly originMs: number;
+}
+
+/**
+ * The client's estimate of the server's duel frame, from the frames the server stamps on its messages and the
+ * measured round trip. Each message that left the server right after frame F and arrived at local time T suggests
+ * that the server's frame 0 was at `T - rtt / 2 - F * FRAME_MS` on the local clock. Delays only ever add, so the
+ * earliest suggestion within the last `windowMs` is the estimate: jitter and stalls behind a lost packet are ignored,
+ * and a server that drifts is followed within the window.
+ *
+ * Pure: the caller passes every time in milliseconds on one monotonic local clock (for example `performance.now()`).
+ */
+export class DuelClock {
+  private readonly samples: OriginSample[] = [];
+  private origin: number | undefined;
+
+  constructor(private readonly windowMs = 2000) {}
+
+  /** A message stamped with server frame `serverFrame` arrived at `arrivalMs`, with the round trip currently `rttMs`. */
+  observe(serverFrame: number, arrivalMs: number, rttMs: number): void {
+    this.samples.push({ atMs: arrivalMs, originMs: arrivalMs - rttMs / 2 - serverFrame * FRAME_MS });
+    while (this.samples.length > 1 && this.samples[0]!.atMs < arrivalMs - this.windowMs) this.samples.shift();
+    this.origin = Math.min(...this.samples.map((sample) => sample.originMs));
+  }
+
+  get synced(): boolean {
+    return this.origin !== undefined;
+  }
+
+  /** The server's current frame (fractional) at local time `nowMs`, or undefined before the first observation. */
+  serverFrameAt(nowMs: number): number | undefined {
+    return this.origin === undefined ? undefined : (nowMs - this.origin) / FRAME_MS;
+  }
+
+  /** Forgets every observation, for example after the connection was replaced. */
+  reset(): void {
+    this.samples.length = 0;
+    this.origin = undefined;
+  }
+}
diff --git a/packages/simulation/src/netcode/events.ts b/packages/simulation/src/netcode/events.ts
new file mode 100644
index 0000000..09a35b9
--- /dev/null
+++ b/packages/simulation/src/netcode/events.ts
@@ -0,0 +1,56 @@
+import type { DuelEvent, DuelResult, DuelState } from "../duel/state.js";
+
+/** A duel event with the frame it happened on and an id that is the same whenever that frame is simulated again. */
+export interface DuelFeedEvent {
+  readonly id: string;
+  readonly frame: number;
+  readonly event: DuelEvent | null;
+  /** Set on the frame the duel ended (KO, double KO or the clock). */
+  readonly result: DuelResult | null;
+}
+
+/**
+ * The stable id of an event (§15: "replayed events use stable IDs"): the frame, the kind, the attacker and the move.
+ * A frame never holds two events with all four equal, and a correction that re-simulates the frame produces the
+ * same id, so a view that remembers ids shows each hit, block, throw or KO once.
+ */
+export function duelEventId(frame: number, event: DuelEvent): string {
+  return `${frame}:${event.kind}:${event.attacker}:${event.moveId}`;
+}
+
+export function duelResultId(result: DuelResult): string {
+  return `${result.frame}:result:${result.reason}`;
+}
+
+/**
+ * Remembers the ids already handed out, so each event of a simulated frame is reported once however often rollback
+ * re-simulates the frame. Ids older than the pruned frame are forgotten.
+ */
+export class DuelEventFeed {
+  private readonly seen = new Map<string, number>();
+  private readonly fresh: DuelFeedEvent[] = [];
+
+  /** Records the events of a state just simulated (predicted, replayed or confirmed). */
+  observe(state: DuelState): void {
+    for (const event of state.events) this.add({ id: duelEventId(state.frame, event), frame: state.frame, event, result: null });
+    if (state.result !== null && state.result.frame === state.frame) {
+      this.add({ id: duelResultId(state.result), frame: state.frame, event: null, result: state.result });
+    }
+  }
+
+  /** The events not handed out before, oldest first. */
+  drain(): DuelFeedEvent[] {
+    return this.fresh.splice(0);
+  }
+
+  /** Forgets ids from before `frame`. */
+  prune(frame: number): void {
+    for (const [id, at] of this.seen) if (at < frame) this.seen.delete(id);
+  }
+
+  private add(event: DuelFeedEvent): void {
+    if (this.seen.has(event.id)) return;
+    this.seen.set(event.id, event.frame);
+    this.fresh.push(event);
+  }
+}
