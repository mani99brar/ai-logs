+  }, 30_000);
+
+  it("forfeits a player absent for ten seconds", async () => {
+    const { host, proxy } = await startDuel(true);
+    const room = roomOf(host);
+    proxy.sever({ refuse: true });
+    const droppedAt = Date.now();
