+import { validateDuelInputMessage, type DuelInputMessage } from "@pirate-sea-race/protocol";
+import { InputAdmission, type DropReason } from "./inputGate.js";
+
+/**
+ * One duel client's input channel on the server, with the world input gate's limits unchanged, because it admits
+ * messages through the same `InputAdmission`: at most MAX_INPUT_MESSAGES_PER_SECOND messages per second of room time,
+ * MAX_INPUT_MESSAGE_BYTES each, sequence numbers strictly increasing, and no frame more than MAX_INPUT_LEAD_FRAMES
+ * past the server's. Every drop is counted. Accepted messages go on to the duel authority, which keeps the first copy
+ * of each frame's input.
+ */
+export class DuelInputGate {
+  private readonly admission = new InputAdmission(validateDuelInputMessage);
+
+  /** Messages dropped, by reason. */
+  get dropped(): Record<DropReason, number> {
+    return this.admission.dropped;
+  }
+
+  /**
+   * Takes one untrusted message at room tick `tick` (60 a second, for the rate window) when the duel's current frame
+   * is `serverFrame` (negative during the countdown). Returns the accepted message, or undefined when it was dropped.
+   */
+  receive(message: unknown, tick: number, serverFrame: number): DuelInputMessage | undefined {
+    const result = this.admission.admit(message, tick, serverFrame);
+    return result.ok ? result.input : undefined;
+  }
+}
