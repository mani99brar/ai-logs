+/** A client session driven by a fake clock at an exact 60 Hz, with the server's probes and bundles fed in. */
+function sessionRig(options: { player?: PlayerIndex; initial?: DuelState; delay?: number } = {}) {
+  const initial = options.initial ?? closeDuel(40);
+  const session = new DuelClientSession({ config, player: options.player ?? 0, initial });
+  session.inputDelay = options.delay ?? 3;
+  // The server's frame 0 is at local time 1000 and the link is instant: messages arrive on a frame's edge, and the
+  // client ticks in the middle of a frame.
+  const edge = (frame: number) => 1000 + frame * FRAME_MS;
+  const at = (frame: number) => edge(frame) + FRAME_MS / 2;
+  session.receiveProbe({ frame: -60, rtt: 0 }, edge(-60));
+  const sent: OutgoingDuelInput[] = [];
+  const sentAt: number[] = [];
+  const tick = (now: number, bits: number) => {
+    const message = session.tick(now, bits);
+    if (message === undefined) return;
+    sent.push(message);
+    sentAt.push(now);
+  };
+  return { session, sent, sentAt, at, edge, tick, initial };
+}
