import { schema, t, type SchemaType } from "@colyseus/schema";

/**
 * The synced mirror of the plain simulation state. The room copies the simulation into it after every world step;
 * Colyseus sends clients the deltas at the patch rate. Clients decode it by reflection and import these types only.
 */
export const ShipSchema = schema(
  {
    id: t.string(),
    slot: t.uint8(),
    x: t.int32(),
    y: t.int32(),
    heading: t.uint8(),
    speed: t.int16(),
    /** The dock the ship is moored at, or -1 at sea. */
    dock: t.int8(),
  },
  "Ship",
);
export type ShipSchema = SchemaType<typeof ShipSchema>;

export const MatchStateSchema = schema(
  {
    code: t.string(),
    protocolVersion: t.uint16(),
    /** Private matches are custom matches (§2). */
    custom: t.boolean(),
    /** Players in the match, visible or not. */
    players: t.uint8(),
    /** The simulation frame at the last world step. */
    frame: t.uint32(),
    worldTick: t.uint32(),
    /**
     * Filtered per client (§16): each client's StateView holds its own ship and the ships inside its sight radius,
     * and Colyseus encodes no other entry of this map into that client's messages.
     */
    ships: t.map(ShipSchema).view(),
  },
  "MatchState",
);
export type MatchStateSchema = SchemaType<typeof MatchStateSchema>;

/** One seat of a duel: its player index (slot 0 is player one, the creator), its session and whether it is connected. */
export const DuelSeatSchema = schema(
  {
    sessionId: t.string(),
    slot: t.uint8(),
    connected: t.boolean(),
    /** The latest round trip the server measured for this seat, in milliseconds. */
    rtt: t.uint16(),
  },
  "DuelSeat",
);
export type DuelSeatSchema = SchemaType<typeof DuelSeatSchema>;

/**
 * A duel room's lobby state, synced at the patch rate. The duel's frame data does not travel here: inputs, applied
 * inputs, hashes and snapshots are Colyseus messages (the duel protocol in docs/duel.md).
 */
export const DuelRoomStateSchema = schema(
  {
    code: t.string(),
    protocolVersion: t.uint16(),
    /** A practice room: one player against the server's dummy (player two). */
    practice: t.boolean(),
    /** The dummy's behaviour in a practice room ("idle" or "guard"), empty otherwise. */
    dummy: t.string(),
    /** "waiting", "countdown", "fighting" or "over". */
    phase: t.string(),
    /** Frames left in the countdown. */
    countdown: t.uint16(),
    /** The seed both sides create the duel's frame-0 state from. */
    seed: t.uint32(),
    /** The shared input delay in frames, once chosen (0 before). */
    inputDelay: t.uint8(),
    seats: t.array(DuelSeatSchema),
    /** Once over: the winner's slot, or -1 for a draw. */
    winner: t.int8(),
    /** Once over: "ko", "double-ko", "timeout", "overtime" or "forfeit". */
    reason: t.string(),
    /** Once over: the frame the duel ended on. */
    resultFrame: t.uint32(),
  },
  "DuelRoomState",
);
export type DuelRoomStateSchema = SchemaType<typeof DuelRoomStateSchema>;
