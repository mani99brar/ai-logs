import type { PlayerIndex } from "@pirate-sea-race/simulation/duel";
import type { DuelFeedEvent } from "@pirate-sea-race/simulation/netcode";

/**
 * The client's buffer of events the arena has not drawn yet: filled from the session on every tick, so none is lost
 * while the arena is not drawing (a hidden tab), and drained when it draws. It keeps the newest `capacity`.
 */
export class PendingDuelEvents {
  private readonly events: DuelFeedEvent[] = [];

  constructor(private readonly capacity = 32) {}

  collect(fresh: readonly DuelFeedEvent[]): void {
    this.events.push(...fresh);
    if (this.events.length > this.capacity) this.events.splice(0, this.events.length - this.capacity);
  }

  drain(): DuelFeedEvent[] {
    return this.events.splice(0);
  }
}

/** A short text the arena shows for one event: over the fighter it happened to, or centred for the result. */
export interface ArenaFlash {
  readonly id: string;
  readonly text: string;
  readonly over: PlayerIndex | "centre";
  /** The scene time (ms) it disappears at. */
  readonly until: number;
}

/** The flash for an event: the damage of a hit or a throw, the guard, the grab, or the KO or time at the end. */
export function flashFor(fresh: DuelFeedEvent, time: number): ArenaFlash {
  if (fresh.result !== null) {
    const text = fresh.result.reason === "ko" || fresh.result.reason === "double-ko" ? "K.O." : "TIME";
    return { id: fresh.id, text, over: "centre", until: time + 1500 };
  }
  const event = fresh.event!;
  const text = {
    hit: `-${event.damage}`,
    block: "guard",
    "guard-break": "guard break",
    grab: "grab",
    throw: `throw -${event.damage}`,
    "throw-escape": "escape",
    "throw-clash": "clash",
  }[event.kind];
  return { id: fresh.id, text, over: event.attacker === 0 ? 1 : 0, until: time + 450 };
}

/**
 * The arena's flashes, one per event id: an id already shown (while it is among the last `remember` ids) is not shown
 * again, whatever re-reports it.
 */
export class ArenaFlashes {
  private readonly showing: ArenaFlash[] = [];
  private readonly shown: string[] = [];

  constructor(private readonly remember = 64) {}

  /** The flashes on screen now. */
  get current(): readonly ArenaFlash[] {
    return this.showing;
  }

  /** Takes the events drained at scene time `time`; returns the flashes to draw for the new ones. */
  add(events: readonly DuelFeedEvent[], time: number): ArenaFlash[] {
    const added: ArenaFlash[] = [];
    for (const fresh of events) {
      if (this.shown.includes(fresh.id)) continue;
      this.shown.push(fresh.id);
      if (this.shown.length > this.remember) this.shown.shift();
      const flash = flashFor(fresh, time);
      this.showing.push(flash);
      added.push(flash);
    }
    return added;
  }

  /** Takes off and returns the flashes whose time is up at `time`. */
  expire(time: number): ArenaFlash[] {
    const gone = this.showing.filter((flash) => time >= flash.until);
    for (const flash of gone) this.showing.splice(this.showing.indexOf(flash), 1);
    return gone;
  }
}
