/** One duel frame in milliseconds (60 Hz, §8). */
export const FRAME_MS = 1000 / 60;

/** The shared input delay's bounds, in frames (§15). */
export const MIN_INPUT_DELAY = 3;
export const MAX_INPUT_DELAY = 8;

/**
 * Frames of margin the input delay adds on top of the one-way latency: one for the client's send cadence (a message
 * every second frame) and one for the error of the client's estimate of the server's frame.
 */
export const INPUT_DELAY_MARGIN_FRAMES = 2;

/** A connection as the server measured it from its round-trip probes. */
export interface LinkStats {
  /** Median round-trip time, in milliseconds. */
  readonly rttMs: number;
  /** Interquartile range of the round-trip samples: their spread without the rare stall behind a lost packet. */
  readonly jitterMs: number;
  readonly samples: number;
}

function quantile(sorted: readonly number[], q: number): number {
  const position = (sorted.length - 1) * q;
  const low = Math.floor(position);
  const high = Math.ceil(position);
  return sorted[low]! + (sorted[high]! - sorted[low]!) * (position - low);
}

/** Round-trip samples summarised as median and interquartile range; undefined without samples. */
export function linkStats(rttSamplesMs: readonly number[]): LinkStats | undefined {
  if (rttSamplesMs.length === 0) return undefined;
  const sorted = [...rttSamplesMs].sort((a, b) => a - b);
  return { rttMs: quantile(sorted, 0.5), jitterMs: quantile(sorted, 0.75) - quantile(sorted, 0.25), samples: sorted.length };
}

/**
 * The shared input delay for a duel (§15), chosen once from both players' links: enough frames for the slower
 * player's input to cross one way (half the round trip, plus twice the jitter) before the server steps the frame it is
 * tagged for, plus INPUT_DELAY_MARGIN_FRAMES, kept within [MIN_INPUT_DELAY, MAX_INPUT_DELAY]. A player with no
 * measurement gets the maximum. Inputs that still arrive late (a loss stall) are substituted and corrected by rollback.
 */
export function chooseInputDelay(links: readonly (LinkStats | undefined)[]): number {
  if (links.length === 0 || links.some((link) => link === undefined)) return MAX_INPUT_DELAY;
  const oneWayMs = Math.max(...links.map((link) => link!.rttMs / 2 + 2 * link!.jitterMs));
  const frames = Math.ceil(oneWayMs / FRAME_MS) + INPUT_DELAY_MARGIN_FRAMES;
  return Math.min(MAX_INPUT_DELAY, Math.max(MIN_INPUT_DELAY, frames));
}

/**
 * The shared input delay straight from each player's round-trip samples (what the room measured during the
 * countdown): `chooseInputDelay` over their `linkStats`. A player with no samples gets the maximum.
 */
export function inputDelayFromSamples(rttSamplesMs: readonly (readonly number[])[]): number {
  return chooseInputDelay(rttSamplesMs.map((samples) => linkStats(samples)));
}
