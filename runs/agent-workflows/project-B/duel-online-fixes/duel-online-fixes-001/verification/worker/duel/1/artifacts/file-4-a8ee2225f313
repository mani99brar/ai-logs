import { describe, expect, it } from "vitest";
import { DUEL_INPUT_MASK } from "@pirate-sea-race/content/moves";
import {
  DUEL_BUNDLE_FRAMES,
  DUEL_INPUT_BITS_MAX,
  DUEL_INPUT_MESSAGES_PER_SECOND,
  DUEL_SNAPSHOT_EVERY_BUNDLES,
  INPUT_HOLD_FRAMES,
  MAX_DUEL_INPUTS_PER_MESSAGE,
  MAX_INPUT_LEAD_FRAMES,
  MAX_INPUT_MESSAGE_BYTES,
  MAX_INPUT_MESSAGES_PER_SECOND,
} from "@pirate-sea-race/protocol";
import {
  BUNDLE_FRAMES,
  HELD_INPUT_FRAMES,
  INPUTS_PER_MESSAGE,
  MESSAGES_PER_SECOND,
  SNAPSHOT_EVERY_BUNDLES,
} from "@pirate-sea-race/simulation/netcode";
import { DuelInputGate } from "./duelInputGate.js";
import { InputGate } from "./inputGate.js";

const message = (seq: number, frame: number, inputs: number[] = [0, 0]) => ({ seq, frame, inputs });

describe("DuelInputGate", () => {
  it("accepts a batch and hands it on", () => {
    const gate = new DuelInputGate();
    expect(gate.receive(message(1, 12, [16, 48]), 1, 5)).toEqual(message(1, 12, [16, 48]));
  });

  it("keeps the world gate's limits: rate, size, sequence and future frames", () => {
    const gate = new DuelInputGate();
    for (let seq = 1; seq <= MAX_INPUT_MESSAGES_PER_SECOND; seq++) expect(gate.receive(message(seq, 10), 100, 5)).toBeDefined();
    expect(gate.receive(message(100, 10), 159, 5)).toBeUndefined();
    expect(gate.dropped["rate-limited"]).toBe(1);
    // A second of room ticks later, the window starts again.
    expect(gate.receive(message(101, 70), 160, 65)).toBeDefined();
    expect(gate.receive(message(101, 70), 161, 65)).toBeUndefined();
    expect(gate.receive(message(102, 65 + MAX_INPUT_LEAD_FRAMES + 1), 161, 65)).toBeUndefined();
    expect(gate.receive({ ...message(103, 70), pad: "x".repeat(MAX_INPUT_MESSAGE_BYTES) }, 161, 65)).toBeUndefined();
    expect(gate.receive(message(104, 70, [DUEL_INPUT_BITS_MAX + 1]), 161, 65)).toBeUndefined();
    expect(gate.dropped).toEqual({ "rate-limited": 1, "stale-sequence": 1, "future-frame": 1, oversized: 1, malformed: 1 });
  });

  it("admits and drops exactly as the world gate does, message for message", () => {
    const world = new InputGate();
    const duel = new DuelInputGate();
    let seq = 0;
    for (let tick = 0; tick < 200; tick++) {
      // About 100 messages a second, with a repeated sequence number and a frame too far ahead now and then.
      for (let copy = 0; copy < (tick % 3 === 0 ? 3 : 1); copy++) {
        seq += tick % 17 === 0 && copy === 1 ? 0 : 1;
        const frame = tick % 23 === 0 ? tick + MAX_INPUT_LEAD_FRAMES + 1 : tick;
        const worldDrop = world.receive({ seq, frame, buttons: 0, moveX: 0, moveY: 0 }, tick);
        const duelAccepted = duel.receive(message(seq, frame), tick, tick);
        expect(duelAccepted === undefined).toBe(worldDrop !== undefined);
      }
    }
    expect(duel.dropped).toEqual(world.dropped);
    expect(duel.dropped["rate-limited"]).toBeGreaterThan(0);
    expect(duel.dropped["stale-sequence"]).toBeGreaterThan(0);
    expect(duel.dropped["future-frame"]).toBeGreaterThan(0);
  });

  it("counts the lead from the countdown's negative frames", () => {
    const gate = new DuelInputGate();
    expect(gate.receive(message(1, MAX_INPUT_LEAD_FRAMES - 10), 0, -10)).toBeDefined();
    expect(gate.receive(message(2, MAX_INPUT_LEAD_FRAMES - 9), 0, -10)).toBeUndefined();
  });
});

// The protocol depends on neither content nor the simulation, so the server, which reads all three, checks that the
// netcode's constants are the protocol's.
describe("duel protocol constants", () => {
  it("agree between the protocol, the move data and the netcode", () => {
    expect(DUEL_INPUT_BITS_MAX).toBe(DUEL_INPUT_MASK);
    expect(INPUTS_PER_MESSAGE).toBe(MAX_DUEL_INPUTS_PER_MESSAGE);
    expect(MESSAGES_PER_SECOND).toBe(DUEL_INPUT_MESSAGES_PER_SECOND);
    expect(HELD_INPUT_FRAMES).toBe(INPUT_HOLD_FRAMES);
    expect(BUNDLE_FRAMES).toBe(DUEL_BUNDLE_FRAMES);
    expect(SNAPSHOT_EVERY_BUNDLES).toBe(DUEL_SNAPSHOT_EVERY_BUNDLES);
  });
});
