import { Client, type Room } from "@colyseus/sdk";
import { CREATE_TOKEN_BYTES, DUEL_ROOM, formatCreateToken, normalizeMatchCode, PROTOCOL_VERSION } from "@pirate-sea-race/protocol";
import type { DuelRoomStateSchema } from "@pirate-sea-race/server/schema";

export type DuelRoom = Room<unknown, DuelRoomStateSchema>;

/** Creates a duel (or a practice duel against the server's dummy) with a fresh one-time token. */
export function createDuel(endpoint: string, practice: boolean): Promise<DuelRoom> {
  const createToken = formatCreateToken(crypto.getRandomValues(new Uint8Array(CREATE_TOKEN_BYTES)));
  return new Client(endpoint).create<DuelRoomStateSchema>(DUEL_ROOM, {
    protocolVersion: PROTOCOL_VERSION,
    createToken,
    ...(practice ? { practice: true } : {}),
  });
}

export function joinDuel(endpoint: string, code: string): Promise<DuelRoom> {
  return new Client(endpoint).join<DuelRoomStateSchema>(DUEL_ROOM, { protocolVersion: PROTOCOL_VERSION, code: normalizeMatchCode(code) });
}
