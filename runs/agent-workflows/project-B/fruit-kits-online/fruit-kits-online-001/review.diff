+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { DuelClient as DuelClientType } from "./duelClient.js";
+import type { DuelLobby, DuelTransport } from "./duelTransport.js";
+
+/**
+ * The browser's duel client builds its duel's frame-0 state from the lobby's seed and kits (§9), exactly as the server
+ * did, so the per-frame hashes cover the kits. The page's `window` is a stand-in here: an event target with timers.
+ */
+let DuelClient: typeof DuelClientType;
+
+beforeEach(async () => {
+  vi.useFakeTimers();
+  vi.stubGlobal("window", Object.assign(new EventTarget(), { setInterval, clearInterval }));
+  ({ DuelClient } = await import("./duelClient.js"));
+});
+
+afterEach(() => {
+  vi.useRealTimers();
+  vi.unstubAllGlobals();
+});
+
+/** The duel HUD's fields without a DOM: each `[data-testid]` lookup gets a recording stand-in. */
+function fakeHud() {
+  const fields = new Map<string, { textContent: string; hidden: boolean; dataset: Record<string, string>; style: { setProperty(): void } }>();
+  const field = (id: string) => {
+    let found = fields.get(id);
+    if (found === undefined) fields.set(id, (found = { textContent: "", hidden: false, dataset: {}, style: { setProperty: () => undefined } }));
+    return found;
+  };
+  return { root: { querySelector: (selector: string) => field(/data-testid="([^"]+)"/.exec(selector)![1]!) } as unknown as HTMLElement, field };
+}
+
+function client(lobby: Partial<DuelLobby>) {
+  const current: DuelLobby = {
+    code: "ABC123",
+    practice: false,
+    phase: "countdown",
+    countdown: 180,
+    seed: 7,
+    kits: "ember,duelist",
+    inputDelay: 0,
+    seats: [
+      { sessionId: "them", slot: 0, connected: true },
+      { sessionId: "me", slot: 1, connected: true },
+    ],
+    winner: -1,
+    reason: "",
+    ...lobby,
+  };
+  const none = () => () => undefined;
+  const transport: DuelTransport = { sessionId: "me", lobby: () => current, send: () => undefined, onMessage: none, onDrop: none, onReconnect: none, onLeave: none, ready: () => undefined };
+  const hud = fakeHud();
+  const duel = new DuelClient(transport, hud.root);
+  return { duel, hud };
+}
+
+describe("the browser's duel client and the kits (§9)", () => {
+  it("builds the duel's state with the lobby's kits, player one's first", () => {
+    const { duel } = client({});
+    vi.advanceTimersByTime(20);
+    expect(duel.state()!.fighters.map((fighter) => fighter.kit)).toEqual(["ember", "duelist"]);
+    duel.dispose();
+  });
+
+  it("builds no state from a lobby whose kits it cannot read, and shows the Duelist mirror meanwhile", () => {
+    const { duel, hud } = client({ kits: "" });
+    vi.advanceTimersByTime(60);
+    expect(duel.state()).toBeUndefined();
+    expect(hud.field("duel-kit-0").textContent).toBe("Duelist · U Advancing thrust · I Counter slash");
+    expect(hud.field("duel-kit-1").textContent).toBe("Duelist · U Advancing thrust · I Counter slash");
+    duel.dispose();
+  });
+
+  it("shows the lobby's kits in the HUD before the fight's state exists (waiting for a fighter)", () => {
+    const { duel, hud } = client({ phase: "waiting" });
+    vi.advanceTimersByTime(60);
+    expect(duel.state()).toBeUndefined();
+    expect(hud.field("duel-kit-0").textContent).toBe("Ember · U Flame bolt · I Rising flare");
+    expect(hud.field("duel-kit-1").textContent).toBe("Duelist · U Advancing thrust · I Counter slash");
+    duel.dispose();
+  });
+});
