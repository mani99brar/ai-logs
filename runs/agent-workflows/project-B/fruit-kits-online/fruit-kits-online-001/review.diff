+    expect(threats.filter(Boolean)).toHaveLength(jab.timing.active);
+    const active = states.findIndex((state) => arenaDrawing(config, state).fighters[0].threat !== null);
+    expect(arenaDrawing(config, states[active]!).fighters[0].threat).toEqual(toCanvas(config, fighterTells(config, states[active]!.fighters[0]).activeHitbox!));
+  });
+
+  it("draws the smoke screen as a zone, and an obscured fighter's startup as a generic flash with its move hidden", () => {
+    const screen = findMove(config.moveset, "smoke-screen");
+    const states = trace(["smoke", "duelist"], 60, [1, I("special2"), 0], [40, I("light"), 0]);
+    const laid = states.findIndex((state) => state.fighters[0].zone !== null);
+    expect(laid).toBe(screen.timing.startup + 1);
+    const drawing = arenaDrawing(config, states[laid]!);
+    expect(drawing.zones).toHaveLength(1);
