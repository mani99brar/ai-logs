diff --git a/apps/web/src/pageKeys.ts b/apps/web/src/pageKeys.ts
new file mode 100644
index 0000000..6bbbc6f
--- /dev/null
+++ b/apps/web/src/pageKeys.ts
@@ -0,0 +1,19 @@
+import { isTyping } from "./keyboard.js";
+
+/** A panel of the match page that reads keys: §3's ruin panel, §9's fruit panel. */
+export interface KeyPanel {
+  readonly isOpen: boolean;
+  /** True when the key was the panel's. */
+  keydown(event: Pick<KeyboardEvent, "code" | "repeat">): boolean;
+}
+
+/**
+ * A keydown in the match page, for its panels: never a key typed into a text field (as the helm's rule, `isTyping`),
+ * and one panel at a time: while the fruit panel is open R opens no ruin, and while the ruin panel is open F inspects
+ * no fruit. True when a panel took the key, so the page prevents its default.
+ */
+export function panelKeydown(event: Pick<KeyboardEvent, "code" | "repeat" | "target">, panels: { readonly ruins: KeyPanel; readonly fruit: KeyPanel }): boolean {
+  if (isTyping(event.target)) return false;
+  if (!panels.fruit.isOpen && panels.ruins.keydown(event)) return true;
+  return !panels.ruins.isOpen && panels.fruit.keydown(event);
+}
