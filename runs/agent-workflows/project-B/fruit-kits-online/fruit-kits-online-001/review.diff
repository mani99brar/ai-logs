@@ -0,0 +1,425 @@
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { isNavigable, seaMap } from "@pirate-sea-race/content";
+import { encounterRules } from "@pirate-sea-race/content/encounters";
+import { defaultDuelConfig, DUEL_INPUT, findMove } from "@pirate-sea-race/simulation/duel";
+import { checkFruitState, fruitRules, kitDescriptions } from "@pirate-sea-race/simulation/fruits";
+import { Buttons, FruitMessageType, MAX_INSPECT_FRUIT_PER_SECOND } from "@pirate-sea-race/protocol";
+import { startGameServer, type RunningGameServer } from "@pirate-sea-race/server";
+import { HeadlessClient, ImpairmentProxy, sleep, type Movement } from "@pirate-sea-race/test-tools";
+import { containsText, HOLD_E, openWater, playersAt, roomOf, startThroughLobby, tracker, until, type Seat } from "./seaDuelSetup.js";
+import { tuned } from "./rubbingsSetup.js";
+
+/**
+ * §9's fruit in the match room: four pedestals, one at each regular island's highest-id dock, dealt from the fruit's
+ * own seed (pinned here, test-only: Ember on Palm Key and Mist Cay, Smoke on Ember Rock and Old Stones). A player
+ * moored there inspects (F) and holds F for three seconds to eat; releasing, casting off, a grapple's reservation or a
+ * disconnect interrupts it; the kit then goes into every duel at sea the player fights. Players drive it as a browser
+ * does: E to moor, the input's fruit button held, the inspect message, J to grapple. Every test's rooms check the
+ * ledger's and the room's invariants after every world tick (`tracker`), and the fruit state's own here.
+ */
+let server: RunningGameServer;
+let endpoint: string;
+
+const FRUITS = ["ember", "smoke", "smoke", "ember"] as const;
+
+beforeAll(async () => {
+  server = await startGameServer({ port: 0, host: "127.0.0.1", handleSignals: false, testPlacement: true, matchTuning: tuned({ testFruits: FRUITS, testHooks: true }) });
+  endpoint = `http://127.0.0.1:${server.port}`;
+});
+
+afterAll(async () => {
+  await server.close();
+});
+
+/** Each island's pedestal dock: its highest-id dock. */
+const pedestalDock = (island: number) => seaMap.docks.filter((dock) => dock.island === island).at(-1)!;
+const PALM = pedestalDock(0);
+const EMBER_ROCK = pedestalDock(1);
+const MIST = pedestalDock(3);
