+      OUTLINE.stagger,
+      OUTLINE.thrown,
+      OUTLINE.thrown,
+      OUTLINE.free,
+    ]);
+  });
+});
+
+describe("the duel HUD's kits (§9)", () => {
+  it("shows each fighter's kit and its U and I moves", () => {
+    expect(kitText("ember")).toBe("Ember · U Flame bolt · I Rising flare");
+    const page = fakePage();
+    const confirmed = createDuelState(config, { kits: ["smoke", "duelist"] });
+    const { rules } = config.moveset;
