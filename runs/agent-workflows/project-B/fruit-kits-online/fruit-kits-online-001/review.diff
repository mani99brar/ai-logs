diff --git a/apps/web/src/arenaDrawing.ts b/apps/web/src/arenaDrawing.ts
new file mode 100644
index 0000000..f98cae2
--- /dev/null
+++ b/apps/web/src/arenaDrawing.ts
@@ -0,0 +1,152 @@
+import { fighterTells, findMove, zoneBox, type DuelConfig, type DuelState, type FighterState, type PlayerIndex, type WorldBox } from "@pirate-sea-race/simulation/duel";
+
+/**
+ * What the arena draws of a duel's state (§9's "what the renderer must show", `docs/fruit-kits.md`), as plain shapes in
+ * arena pixels, from the duel's own `fighterTells`: each fighter's body (its stance's hurtbox), its bolt as a moving
+ * sprite, its smoke screen as a translucent zone, a generic startup flash for a fighter the screen obscures (whose move
+ * name is then hidden), the feint's reappearance, and the threat hitbox of a move that strikes. A cast, a feint or a
+ * screen never draws its box as a threat. No Phaser here: the arena scene copies this onto its canvas, and unit tests
+ * read it directly.
+ */
+
+/** The arena's height on the canvas, and the floor's height in pixels from its top. */
+export const ARENA_HEIGHT = 320;
+export const FLOOR = ARENA_HEIGHT - 40;
+
+export interface Rect {
+  readonly x: number;
+  readonly y: number;
+  readonly w: number;
+  readonly h: number;
+}
+
+/** A box in sub-pixels (y up from the floor) as arena pixels (y down from the top). */
+export function toCanvas(config: DuelConfig, box: WorldBox): Rect {
+  const sub = config.moveset.arena.subPixelsPerPixel;
+  return { x: box.x0 / sub, y: FLOOR - box.y1 / sub, w: (box.x1 - box.x0) / sub, h: (box.y1 - box.y0) / sub };
+}
+
+export interface FighterDrawing {
+  readonly index: PlayerIndex;
+  readonly body: Rect;
+  readonly facing: number;
+  /** Inside a smoke screen: the move being started is hidden, and a generic flash shows instead. */
+  readonly obscured: boolean;
+  /** A generic startup flash: an obscured fighter starting a move. */
+  readonly startupFlash: boolean;
+  /** Starting a move where the move itself may show (not obscured). */
+  readonly startingUp: boolean;
+  /** In a feint's readable reappearance. */
+  readonly reappearing: boolean;
+  /** The active hitbox of a move that strikes, drawn as a threat; null otherwise. */
+  readonly threat: Rect | null;
+  /** The text over the fighter: its action and move, with the move hidden while an obscured startup runs. */
+  readonly label: string;
+}
+
+export interface BoltDrawing {
+  readonly owner: PlayerIndex;
+  readonly box: Rect;
+}
+
+export interface ZoneDrawing {
+  readonly owner: PlayerIndex;
+  readonly box: Rect;
+}
+
+export interface ArenaDrawing {
+  readonly fighters: readonly [FighterDrawing, FighterDrawing];
+  readonly bolts: readonly BoltDrawing[];
+  readonly zones: readonly ZoneDrawing[];
+}
+
+/** The fighter's action with its move and the move's frame ("Flame bolt 12"), or a crouching state marked low. */
+function actionLabel(config: DuelConfig, fighter: FighterState): string {
+  if (fighter.action === "attack" && fighter.moveId !== null) return `${findMove(config.moveset, fighter.moveId).timing.name} ${fighter.actionFrame}`;
+  return fighter.crouching && fighter.action !== "crouch" ? `${fighter.action} (low)` : fighter.action;
+}
+
+/** One fighter's drawing, from its tells. */
+export function fighterDrawing(config: DuelConfig, fighter: FighterState, index: PlayerIndex): FighterDrawing {
+  const tells = fighterTells(config, fighter);
+  const hidden = tells.obscured && tells.startingUp;
+  return {
+    index,
+    body: toCanvas(config, tells.hurtbox),
+    facing: tells.facing,
+    obscured: tells.obscured,
+    startupFlash: hidden,
+    startingUp: tells.startingUp && !hidden,
+    reappearing: tells.reappearing,
+    threat: tells.activeHitbox === null ? null : toCanvas(config, tells.activeHitbox),
+    label: hidden ? "…" : actionLabel(config, fighter),
+  };
+}
+
+/** Everything the arena draws of a state: both fighters, every bolt and every smoke screen. */
+export function arenaDrawing(config: DuelConfig, state: DuelState): ArenaDrawing {
+  const [a, b] = state.fighters;
+  const bolts: BoltDrawing[] = [];
+  const zones: ZoneDrawing[] = [];
+  state.fighters.forEach((fighter, owner) => {
+    const tells = fighterTells(config, fighter);
+    if (tells.bolt !== null) bolts.push({ owner: owner as PlayerIndex, box: toCanvas(config, tells.bolt) });
+    if (fighter.zone !== null) zones.push({ owner: owner as PlayerIndex, box: toCanvas(config, zoneBox(config.moveset, fighter.zone)) });
+  });
+  return { fighters: [fighterDrawing(config, a, 0), fighterDrawing(config, b, 1)], bolts, zones };
+}
+
+/** What the arena scene draws §9's tells with, in arena pixels: Phaser's graphics in the scene, a recording fake in tests. */
+export interface ArenaPen {
+  /** A smoke screen: a translucent zone. */
+  zone(box: Rect): void;
+  /** A bolt: a flame sprite where it flies. */
+  bolt(box: Rect): void;
+  /** The generic startup flash around an obscured fighter's body. */
+  startupFlash(body: Rect): void;
+  /** The feint's reappearance around the fighter's body. */
+  reappearance(body: Rect): void;
+}
+
+/** Draws the tells of a drawing: every smoke screen, every bolt, and each fighter's startup flash and reappearance. */
+export function drawTells(pen: ArenaPen, drawing: ArenaDrawing): void {
+  for (const zone of drawing.zones) pen.zone(zone.box);
+  for (const bolt of drawing.bolts) pen.bolt(bolt.box);
+  for (const fighter of drawing.fighters) {
+    if (fighter.startupFlash) pen.startupFlash(fighter.body);
+    if (fighter.reappearing) pen.reappearance(fighter.body);
+  }
+}
+
+/** Outline colours: hit, blocking, staggered, thrown, a threat (a striking move's active frames), a startup, and free. */
+export const OUTLINE = {
+  hit: 0xff5a4f,
+  block: 0xffffff,
+  stagger: 0xff9f1c,
+  thrown: 0xc77dff,
+  threat: 0xff3b30,
+  startup: 0xfff3b0,
+  /** An obscured fighter's startup outline is the generic flash's white, never the move's own. */
+  hidden: 0xffffff,
+  free: 0x0b1620,
+} as const;
+
+/** The outline colour that tells the fighter's state at a glance; in an attack, a threat only when its move strikes. */
+export function outlineColor(fighter: FighterState, drawing: FighterDrawing): number {
+  switch (fighter.action) {
+    case "hitstun":
+    case "knockdown":
+      return OUTLINE.hit;
+    case "blockstun":
+      return OUTLINE.block;
+    case "stagger":
+      return OUTLINE.stagger;
+    case "thrown":
+    case "throw-break":
+      return OUTLINE.thrown;
+    case "attack":
+      return drawing.threat !== null ? OUTLINE.threat : drawing.startupFlash ? OUTLINE.hidden : OUTLINE.startup;
+    default:
+      return OUTLINE.free;
+  }
+}
