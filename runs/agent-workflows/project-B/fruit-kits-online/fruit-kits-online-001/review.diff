+    expect(screened.drawn.map((line) => line.split(" ")[0])).toEqual(["zone", "flash"]);
+
+    const feint = trace(["smoke", "duelist"], 40, [1, I("special1"), 0]);
+    const back = feint.findIndex((state) => fighterTells(config, state.fighters[0]).reappearing);
+    const reappearing = recordingPen();
+    drawTells(reappearing.pen, arenaDrawing(config, feint[back]!));
+    expect(reappearing.drawn.map((line) => line.split(" ")[0])).toEqual(["reappear"]);
+  });
+
+  it("outlines a striking move's active frames as a threat, a cast's as a startup, and an obscured startup as the flash's white", () => {
+    const outline = (state: DuelState) => outlineColor(state.fighters[0], arenaDrawing(config, state).fighters[0]);
+    const jab = trace(["duelist", "duelist"], 20, [1, I("light"), 0]);
+    expect(outline(jab[1]!)).toBe(OUTLINE.startup);
+    expect(jab.some((state) => outline(state) === OUTLINE.threat)).toBe(true);
+    const cast = trace(["ember", "duelist"], 40, [1, I("special1"), 0]);
+    expect(cast.slice(1, 30).every((state) => outline(state) === OUTLINE.startup)).toBe(true);
+    const smoky = trace(["smoke", "duelist"], 60, [1, I("special2"), 0], [40, I("light"), 0]);
+    const starting = smoky.findIndex((state, frame) => frame >= 40 && fighterTells(config, state.fighters[0]).startingUp);
+    expect(outline(smoky[starting]!)).toBe(OUTLINE.hidden);
+    const base = createDuelState(config);
+    const as = (action: DuelState["fighters"][0]["action"]) => {
+      const state = { ...base, fighters: [{ ...base.fighters[0], action }, base.fighters[1]] as const } as DuelState;
+      return outline(state);
+    };
+    expect([as("hitstun"), as("knockdown"), as("blockstun"), as("stagger"), as("thrown"), as("throw-break"), as("idle")]).toEqual([
+      OUTLINE.hit,
+      OUTLINE.hit,
