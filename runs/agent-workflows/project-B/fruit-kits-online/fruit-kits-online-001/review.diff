+    expect(states.every((state) => arenaDrawing(config, state).fighters[0].threat === null || state.frame > 40)).toBe(true);
+    // The jab started inside the screen: a generic flash, its name hidden; the body and facing still drawn.
+    const starting = states.findIndex((state, frame) => frame >= 40 && fighterTells(config, state.fighters[0]).startingUp);
+    const obscured = arenaDrawing(config, states[starting]!).fighters[0];
+    expect(obscured).toMatchObject({ obscured: true, startupFlash: true, startingUp: false, label: "…" });
+    expect(obscured.body).toEqual(toCanvas(config, fighterTells(config, states[starting]!.fighters[0]).hurtbox));
+    // Out of the smoke, the same startup shows the move.
+    const clear = arenaDrawing(config, trace(["duelist", "duelist"], 2, [1, I("light"), 0])[1]!).fighters[0];
+    expect(clear).toMatchObject({ obscured: false, startupFlash: false, startingUp: true });
+    expect(clear.label).toMatch(/^Jab 1$/i);
+  });
+
+  it("draws the feint's readable reappearance", () => {
+    const states = trace(["smoke", "duelist"], 40, [1, I("special1"), 0]);
+    const reappearing = states.flatMap((state, frame) => (arenaDrawing(config, state).fighters[0].reappearing ? [frame] : []));
+    expect(reappearing.length).toBeGreaterThan(0);
+    expect(reappearing).toEqual(states.flatMap((state, frame) => (fighterTells(config, state.fighters[0]).reappearing ? [frame] : [])));
+  });
+
+  it("places boxes on the canvas with y down from the floor, and labels a crouching block as low", () => {
+    expect(toCanvas(config, { x0: 0, x1: 32, y0: 0, y1: 32 })).toEqual({ x: 0, y: FLOOR - 32 / config.moveset.arena.subPixelsPerPixel, w: 2, h: 2 });
+    const state = createDuelState(config);
+    const crouching = { ...state, fighters: [{ ...state.fighters[0], action: "blockstun" as const, crouching: true }, state.fighters[1]] as const };
+    expect(arenaDrawing(config, crouching as DuelState).fighters[0].label).toBe("blockstun (low)");
+    const crouch = { ...state, fighters: [{ ...state.fighters[0], action: "crouch" as const, crouching: true }, state.fighters[1]] as const };
+    expect(arenaDrawing(config, crouch as DuelState).fighters[0].label).toBe("crouch");
+  });
+});
+
+describe("the arena's pen (§9's tells) and outlines", () => {
+  const recordingPen = () => {
+    const drawn: string[] = [];
+    const at = (box: Rect) => `${Math.round(box.x)},${Math.round(box.y)}`;
+    const pen: ArenaPen = {
+      zone: (box) => drawn.push(`zone ${at(box)}`),
+      bolt: (box) => drawn.push(`bolt ${at(box)}`),
+      startupFlash: (body) => drawn.push(`flash ${at(body)}`),
+      reappearance: (body) => drawn.push(`reappear ${at(body)}`),
+    };
+    return { pen, drawn };
+  };
+
+  it("draws a bolt, a smoke screen, an obscured startup's flash and a reappearance, and nothing for a plain fighter", () => {
+    const quiet = recordingPen();
+    drawTells(quiet.pen, arenaDrawing(config, createDuelState(config)));
+    expect(quiet.drawn).toEqual([]);
+
+    const bolt = trace(["ember", "duelist"], 30, [1, I("special1"), 0]).at(-1)!;
+    const flying = recordingPen();
+    drawTells(flying.pen, arenaDrawing(config, bolt));
+    const box = arenaDrawing(config, bolt).bolts[0]!.box;
+    expect(flying.drawn).toEqual([`bolt ${Math.round(box.x)},${Math.round(box.y)}`]);
+
+    const smoky = trace(["smoke", "duelist"], 60, [1, I("special2"), 0], [40, I("light"), 0]);
+    const starting = smoky.findIndex((state, frame) => frame >= 40 && fighterTells(config, state.fighters[0]).startingUp);
+    const screened = recordingPen();
