diff --git a/packages/protocol/src/fruits.ts b/packages/protocol/src/fruits.ts
new file mode 100644
index 0000000..487ce3f
--- /dev/null
+++ b/packages/protocol/src/fruits.ts
@@ -0,0 +1,99 @@
+import { z } from "zod";
+import { encodedSize } from "./input.js";
+
+/**
+ * The fruit messages (protocol v9, §9 and §16). Four pedestals stand at island docks, each holding one fruit. A player
+ * moored at a pedestal's dock inspects it (F) and alone gets its kit's description back; holding F (the input's fruit
+ * button) for three seconds eats it. Whether a pedestal is full travels in the synced state, in sight only; a player's
+ * own kit and eating progress travel in their private status; the kits of a duel's two fighters travel in that duel's
+ * lobby, to its fighters only.
+ */
+export const FruitMessageType = {
+  /** Client → server: inspect the pedestal at the dock this player is moored at (`InspectFruitMessage`). */
+  Inspect: "inspect-fruit",
+  /** Server → client: what that pedestal holds, to the inspector only (`FruitInspectedMessage`). */
+  Inspected: "fruit-kit",
+} as const;
+
+/**
+ * The duel kits (content's `KIT_IDS`, which the protocol does not depend on; a server unit test keeps them equal), and
+ * the ones a pedestal can hold (every kit but the Duelist, which every player starts with).
+ */
+export const DUEL_KIT_NAMES = ["duelist", "ember", "smoke"] as const;
+export const FRUIT_KIT_NAMES = ["ember", "smoke"] as const;
+export type DuelKitName = (typeof DUEL_KIT_NAMES)[number];
+export type FruitKitName = (typeof FRUIT_KIT_NAMES)[number];
+
+/** The largest inspect request accepted. A valid one is `{}`. */
+export const MAX_INSPECT_FRUIT_BYTES = 16;
+/** Inspect requests a client may send per second before the server drops the rest. */
+export const MAX_INSPECT_FRUIT_PER_SECOND = 8;
+
+/** An inspect request carries nothing: the server knows where the sender is moored. */
+export const inspectFruitMessageSchema = z.strictObject({});
+export type InspectFruitMessage = z.infer<typeof inspectFruitMessageSchema>;
+
+/** Validates an untrusted inspect request: its size, then its schema. */
+export function validateInspectFruitMessage(message: unknown): InspectFruitMessage | undefined {
+  const size = encodedSize(message);
+  if (size === undefined || size > MAX_INSPECT_FRUIT_BYTES) return undefined;
+  const parsed = inspectFruitMessageSchema.safeParse(message);
+  return parsed.success ? parsed.data : undefined;
+}
+
+const text = z.string().min(1).max(120);
+
+/**
+ * What a pedestal holds, to the player moored at its dock who inspected it (§9: read the kit before committing): the
+ * island it stands on, and its fruit's kit with §9's description (the two specials, U then I, the advantage and the
+ * vulnerability), or that it is empty. Strict: nothing else rides along.
+ */
+export const fruitInspectedMessageSchema = z.discriminatedUnion("full", [
+  z.strictObject({
+    island: z.int().min(0),
+    full: z.literal(true),
+    kit: z.enum(FRUIT_KIT_NAMES),
+    name: text,
+    specials: z.tuple([text, text]),
+    advantage: text,
+    vulnerability: text,
+  }),
+  z.strictObject({ island: z.int().min(0), full: z.literal(false) }),
+]);
+export type FruitInspectedMessage = z.infer<typeof fruitInspectedMessageSchema>;
+
+/** Parses an inspection the server sent, or undefined when it is not one. */
+export function parseFruitInspectedMessage(message: unknown): FruitInspectedMessage | undefined {
+  const parsed = fruitInspectedMessageSchema.safeParse(message);
+  return parsed.success ? parsed.data : undefined;
+}
+
+/**
+ * A duel's two kits as its lobby syncs them (`kits`), player one's first: "ember,duelist". Both fighters' clients
+ * build the duel's frame-0 state from them and the seed, exactly as the server did.
+ */
+export function formatDuelKits(kits: readonly [DuelKitName, DuelKitName]): string {
+  return kits.join(",");
+}
+
+/** The two kits of a lobby's `kits`, or undefined when it is not two known kits. */
+export function parseDuelKits(value: string | undefined): [DuelKitName, DuelKitName] | undefined {
+  const parts = (value ?? "").split(",");
+  if (parts.length !== 2 || !parts.every((part) => (DUEL_KIT_NAMES as readonly string[]).includes(part))) return undefined;
+  return parts as [DuelKitName, DuelKitName];
+}
+
+/**
+ * Test-only fruit deal (protocol v9), so a scenario knows which pedestal holds which fruit. The dev and test entry reads
+ * it (never the production `main`); it is off unless the variable is set. The kit on each regular island's pedestal,
+ * in island order and comma-separated, two of each fruit kit: for example `ember,smoke,smoke,ember`.
+ */
+export const TEST_FRUITS_ENV = "PIRATE_SEA_RACE_TEST_FRUITS";
+export type TestFruits = readonly FruitKitName[];
+
+/** Parses a test-only fruit deal, or undefined when a kit is unknown. The server checks the count against its sites. */
+export function parseTestFruits(value: string): TestFruits | undefined {
+  const kits = value.split(",").map((part) => part.trim());
+  if (!kits.every((kit) => (FRUIT_KIT_NAMES as readonly string[]).includes(kit))) return undefined;
+  return kits as FruitKitName[];
+}
