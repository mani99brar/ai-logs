import * as Phaser from "phaser";
import { defaultDuelConfig, type DuelState } from "@pirate-sea-race/simulation/duel";
import type { DuelFeedEvent } from "@pirate-sea-race/simulation/netcode";
import { ARENA_HEIGHT, arenaDrawing, drawTells, FLOOR, outlineColor, toCanvas } from "./arenaDrawing.js";
import { ArenaFlashes, type ArenaFlash } from "./duelEvents.js";
import { cssColor } from "./matchView.js";

const config = defaultDuelConfig;
const { moveset } = config;
const SUB = moveset.arena.subPixelsPerPixel;
export const ARENA_WIDTH = moveset.arena.width / SUB;
export { ARENA_HEIGHT };

export const FIGHTER_COLORS = [0xf4b942, 0x3dd6d0] as const;
const BACKGROUND = 0x1b2a38;
const FLOOR_COLOR = 0x3b5266;
const HURTBOX_COLOR = 0x46e06b;
const HITBOX_COLOR = 0xff3b30;
const PUSHBOX_COLOR = 0x6aa9ff;
/** §9's tells: a bolt's flame, a smoke screen, the generic startup flash and the feint's reappearance. */
const BOLT_COLOR = 0xff7a1a;
const BOLT_CORE = 0xffe066;
const SMOKE_COLOR = 0xb8c2cc;
const FLASH_COLOR = 0xffffff;
const REAPPEAR_COLOR = 0x7df9ff;

/** What the arena draws from: the client's predicted duel, its fresh events, and the view options. */
export interface ArenaSource {
  /** The predicted state to draw, or undefined before the duel exists. */
  state(): DuelState | undefined;
  /** Events of newly simulated frames, each once (stable ids). */
  drainEvents(): DuelFeedEvent[];
  /** The predicted state of an earlier frame, while the client still holds it. */
  stateAt(frame: number): DuelState | undefined;
  /** The developer toggle: draw hurtboxes, pushboxes and active hitboxes. */
  showBoxes(): boolean;
  /** Big centred text: the countdown, or the result. */
  banner(): string;
  /** Called once the arena is up (at sea the fight waits for both fighters' arenas, §6). */
  ready?(): void;
}

/** A fighter as drawn this frame, for the DOM report the browser tests read. */
export interface DrawnFighter {
  readonly x: number;
  readonly y: number;
  readonly action: string;
  readonly moveId: string | null;
  readonly facing: number;
  readonly health: number;
}

/**
 * The duel arena with placeholder shapes: each fighter is its stance's hurtbox in its colour, outlined by its state
 * (red when hit, white when blocking, yellow in startup, red while its hitbox is active), with a nose on the side it
 * faces and its current move above it. The developer toggle adds every hurtbox, pushbox and active hitbox. Hits,
 * blocks, throws and the KO flash once each, by their stable event ids (`ArenaFlashes`). The scene reports what it
 * drew as data attributes on its report element (`data-fighters`, `data-boxes`, `data-frame`) for the browser tests.
 *
 * It is one scene of the page's one game: the whole game of a standalone duel (`startArena`), or in a match the scene
 * the sea gives way to for a duel at sea, started with that duel's source (`scene.start("arena", { source })`). On a
 * canvas larger than the arena, the camera scales it to fit and centres it.
 */
export class ArenaScene extends Phaser.Scene {
  private graphics!: Phaser.GameObjects.Graphics;
  private smoke!: Phaser.GameObjects.Graphics;
  private tells!: Phaser.GameObjects.Graphics;
  private boxes!: Phaser.GameObjects.Graphics;
  private labels: Phaser.GameObjects.Text[] = [];
  private bannerText!: Phaser.GameObjects.Text;
  private flashes = new ArenaFlashes();
  private readonly flashTexts = new Map<string, Phaser.GameObjects.Text>();
  private lastReport = "";
  private lastTellsReport = "";
  /** Frames whose active hitbox was drawn, since the page loaded. */
  private hitboxFrames = 0;
  /** The frame drawn last: hitboxes of the frames stepped since then are drawn too, so a slow render misses none. */
  private lastDrawnFrame = -1;

  constructor(
    private readonly report: HTMLElement,
    private source?: ArenaSource,
  ) {
    super("arena");
  }

  /** A start with a new source (the next duel at sea) begins a fresh picture. */
  init(data?: { source?: ArenaSource }): void {
    if (data?.source === undefined || data.source === this.source) return;
    this.source = data.source;
    this.flashes = new ArenaFlashes();
    this.flashTexts.clear();
    this.lastReport = "";
    this.lastTellsReport = "";
    this.lastDrawnFrame = -1;
  }

  create(): void {
    const camera = this.cameras.main;
    camera.setBackgroundColor(BACKGROUND);
    const zoom = Math.min(this.scale.width / ARENA_WIDTH, this.scale.height / ARENA_HEIGHT);
    if (zoom !== 1) camera.setZoom(zoom).centerOn(ARENA_WIDTH / 2, ARENA_HEIGHT / 2);
    const floor = this.add.graphics();
    floor.fillStyle(FLOOR_COLOR, 1);
    floor.fillRect(0, FLOOR, ARENA_WIDTH, ARENA_HEIGHT - FLOOR);
    this.graphics = this.add.graphics().setDepth(1);
    this.smoke = this.add.graphics().setDepth(1.5);
    this.tells = this.add.graphics().setDepth(1.7);
    this.boxes = this.add.graphics().setDepth(2);
    const style = { fontFamily: "system-ui, sans-serif", fontSize: "12px", color: "#e8f1f5" };
    this.labels = [this.add.text(0, 0, "", style).setOrigin(0.5, 1).setDepth(3), this.add.text(0, 0, "", style).setOrigin(0.5, 1).setDepth(3)];
    this.bannerText = this.add
      .text(ARENA_WIDTH / 2, 90, "", { fontFamily: "system-ui, sans-serif", fontSize: "36px", color: "#fff3b0" })
      .setOrigin(0.5, 0.5)
      .setDepth(4);
    this.source?.ready?.();
  }

  override update(time: number): void {
    const source = this.source;
    if (source === undefined) return;
    const state = source.state();
    this.graphics.clear();
    this.smoke.clear();
    this.tells.clear();
    this.boxes.clear();
    this.bannerText.setText(source.banner());
    if (state === undefined) return;
    const showBoxes = source.showBoxes();
    const drawing = arenaDrawing(config, state);
    let hurtboxes = 0;
    let hitboxes = 0;
    state.fighters.forEach((fighter, index) => {
      const drawn = drawing.fighters[index]!;
      const body = drawn.body;
      const knockedDown = fighter.action === "knockdown";
      this.graphics.fillStyle(FIGHTER_COLORS[index]!, 1);
      if (knockedDown) this.graphics.fillRect(body.x - body.h / 4, FLOOR - body.w / 2, body.h / 2, body.w / 2);
      else this.graphics.fillRect(body.x, body.y, body.w, body.h);
      this.graphics.lineStyle(3, outlineColor(fighter, drawn), 1);
      if (!knockedDown) this.graphics.strokeRect(body.x, body.y, body.w, body.h);
      // The nose: which way the fighter faces.
      const noseX = drawn.facing === 1 ? body.x + body.w : body.x;
      this.graphics.fillStyle(0x0b1620, 1);
      this.graphics.fillTriangle(noseX, body.y + 10, noseX + 8 * drawn.facing, body.y + 16, noseX, body.y + 22);
      this.labels[index]!.setPosition(body.x + body.w / 2, body.y - 4).setText(drawn.label);
      if (!showBoxes) return;
      hurtboxes++;
      this.boxes.lineStyle(2, HURTBOX_COLOR, 1);
      this.boxes.strokeRect(body.x - 3, body.y - 3, body.w + 6, body.h + 6);
      const { halfWidth, height } = moveset.fighter.pushbox;
      const push = toCanvas(config, { x0: fighter.x - halfWidth, x1: fighter.x + halfWidth, y0: fighter.y, y1: fighter.y + height });
      this.boxes.lineStyle(1, PUSHBOX_COLOR, 0.8);
      this.boxes.strokeRect(push.x, push.y, push.w, push.h);
    });
    // §9's tells: smoke screens as translucent zones over the fighters, then over the smoke every bolt as a flame, an
    // obscured fighter's generic startup flash and the feint's reappearance.
    drawTells(
      {
        zone: ({ x, y, w, h }) => {
          this.smoke.fillStyle(SMOKE_COLOR, 0.55);
          this.smoke.fillRect(x, y, w, h);
        },
        bolt: ({ x, y, w, h }) => {
          this.tells.fillStyle(BOLT_COLOR, 1);
          this.tells.fillEllipse(x + w / 2, y + h / 2, w, h);
          this.tells.fillStyle(BOLT_CORE, 1);
          this.tells.fillEllipse(x + w / 2, y + h / 2, w / 2, h / 2);
        },
        startupFlash: ({ x, y, w, h }) => {
          this.tells.lineStyle(3, FLASH_COLOR, 0.9);
          this.tells.strokeCircle(x + w / 2, y + h / 2, Math.max(w, h) / 2 + 8);
        },
        reappearance: ({ x, y, w, h }) => {
          this.tells.lineStyle(3, REAPPEAR_COLOR, 1);
          this.tells.strokeRect(x - 6, y - 6, w + 12, h + 12);
        },
      },
      drawing,
    );
    if (showBoxes) {
      // Every threat (a striking move's active hitbox) since the last picture: at 60 fps just this frame's, on a slower
      // render the skipped ones too. A cast, a feint or a screen never strikes, so its box is never a threat.
      const first = Math.min(state.frame, Math.max(this.lastDrawnFrame + 1, state.frame - 60));
      for (let frame = first; frame <= state.frame; frame++) {
        const past = frame === state.frame ? state : source.stateAt(frame);
        const active = past === undefined ? [] : arenaDrawing(config, past).fighters.flatMap((fighter) => (fighter.threat === null ? [] : [fighter.threat]));
        if (active.length > 0 && frame > this.lastDrawnFrame) this.hitboxFrames++;
        for (const box of active) {
          if (frame === state.frame) hitboxes++;
          this.boxes.fillStyle(HITBOX_COLOR, frame === state.frame ? 0.6 : 0.3);
          this.boxes.fillRect(box.x, box.y, box.w, box.h);
        }
      }
    }
    this.lastDrawnFrame = state.frame;

    for (const flash of this.flashes.add(source.drainEvents(), time)) this.flash(flash, state);
    for (const flash of this.flashes.expire(time)) {
      this.flashTexts.get(flash.id)?.destroy();
      this.flashTexts.delete(flash.id);
    }

    const drawn: DrawnFighter[] = state.fighters.map((fighter) => ({
      x: fighter.x,
      y: fighter.y,
      action: fighter.action,
      moveId: fighter.moveId,
      facing: fighter.facing,
      health: fighter.health,
    }));
    const report = JSON.stringify(drawn);
    if (report !== this.lastReport) {
      this.report.dataset["fighters"] = report;
      this.lastReport = report;
    }
    // What the tells drew, for the browser tests: each bolt's owner and centre, each screen, and each fighter's flags.
    const bolts = drawing.bolts.map((bolt) => ({ owner: bolt.owner, x: Math.round(bolt.box.x + bolt.box.w / 2), y: Math.round(bolt.box.y + bolt.box.h / 2) }));
    const zones = drawing.zones.map((zone) => ({ owner: zone.owner, x: Math.round(zone.box.x), w: Math.round(zone.box.w) }));
    const tells = drawing.fighters.map(({ obscured, startupFlash, reappearing }) => ({ obscured, startupFlash, reappearing }));
    const tellsReport = JSON.stringify({ bolts, zones, tells });
    if (tellsReport !== this.lastTellsReport) {
      this.report.dataset["bolts"] = JSON.stringify(bolts);
      this.report.dataset["zones"] = JSON.stringify(zones);
      this.report.dataset["tells"] = JSON.stringify(tells);
      this.lastTellsReport = tellsReport;
    }
    this.report.dataset["frame"] = String(state.frame);
    this.report.dataset["boxes"] = JSON.stringify({ shown: showBoxes, hurtboxes, hitboxes, hitboxFrames: this.hitboxFrames });
  }

  /** A short text over the fighter an event happened to (the flash's text and lifetime come from `flashFor`). */
  private flash(flash: ArenaFlash, state: DuelState): void {
    const x = flash.over === "centre" ? ARENA_WIDTH / 2 : state.fighters[flash.over].x / SUB;
    const y = flash.over === "centre" ? 140 : FLOOR - 120;
    const label = this.add.text(x, y, flash.text, { fontFamily: "system-ui, sans-serif", fontSize: "18px", color: cssColor(0xfff3b0) }).setOrigin(0.5, 0.5).setDepth(5);
    this.flashTexts.set(flash.id, label);
  }
}

/**
 * The arena is a few flat shapes, so it uses Phaser's canvas renderer: without a GPU (a software WebGL) WebGL would
 * cost the main thread tens of milliseconds a frame, which the client's 4 ms tick and the round-trip probes share.
 */
export function startArena(parent: HTMLElement, source: ArenaSource): Phaser.Game {
  return new Phaser.Game({
    type: Phaser.CANVAS,
    parent,
    width: ARENA_WIDTH,
    height: ARENA_HEIGHT,
    backgroundColor: BACKGROUND,
    banner: false,
    audio: { noAudio: true },
    scene: new ArenaScene(parent, source),
  });
}

export { HITBOX_COLOR, HURTBOX_COLOR };
