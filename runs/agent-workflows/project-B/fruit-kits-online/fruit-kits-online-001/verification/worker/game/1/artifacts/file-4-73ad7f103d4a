import { describe, expect, it } from "vitest";
import { seaMap } from "@pirate-sea-race/content";
import { KIT_IDS } from "@pirate-sea-race/content/moves";
import { DUEL_KIT_NAMES, FRUIT_KIT_NAMES, fruitInspectedMessageSchema } from "@pirate-sea-race/protocol";
import { createFruitConfig, createFruitState, FRUIT_KIT_IDS, kitDescriptions, stepFruits } from "@pirate-sea-race/simulation/fruits";
import { rulesPresets } from "@pirate-sea-race/content";
import { createMatchFruits, inspectionOf, pedestalAtDock, pedestalSites } from "./fruits.js";
import { deriveSeed, MASTER_SECRET_BYTES, type SeedSystem } from "./matchSeeds.js";
import { dockCentre, islandDocks, sourceSites } from "./objectives.js";

const sites = pedestalSites(seaMap);
const secretOf = (fill: number) => new Uint8Array(MASTER_SECRET_BYTES).fill(fill);
const kitsOf = (fruits: ReturnType<typeof createMatchFruits>) => fruits.pedestals.map((pedestal) => pedestal.kit);

describe("the pedestals' sites (§9)", () => {
  it("are four distinct docks on the slice sea, one per regular island, each at the island's highest-id dock", () => {
    expect(sites).toHaveLength(4);
    expect(sites.map((site) => site.island)).toEqual([0, 1, 2, 3]);
    expect(sites.map((site) => site.id)).toEqual(["pedestal-0", "pedestal-1", "pedestal-2", "pedestal-3"]);
    expect(new Set(sites.map((site) => site.dock)).size).toBe(4);
    for (const site of sites) {
      const docks = islandDocks(seaMap, site.island);
      expect(site.dock).toBe(Math.max(...docks));
      expect(seaMap.docks[site.dock]!.island).toBe(site.island);
      expect({ x: site.x, y: site.y }).toEqual(dockCentre(seaMap, site.dock));
    }
    // Each island has two docks here, so a pedestal never stands at the island's first source's dock.
    const sources = sourceSites(seaMap);
    for (const site of sites) expect(sources.find((source) => source.island === site.island)).not.toMatchObject({ x: site.x, y: site.y });
    // As many sites as the slice's fruit deal needs.
    expect(sites).toHaveLength(FRUIT_KIT_IDS.length * 2);
    expect(() => createFruitState(sites, 1, rulesPresets.slice)).not.toThrow();
  });

  it("refuse a map whose island has no dock", () => {
    expect(() => pedestalSites({ ...seaMap, docks: seaMap.docks.filter((dock) => dock.island !== 2) })).toThrow(/island 2 has no dock/);
  });

  it("find the pedestal at a dock, and none at another dock or at sea", () => {
    expect(pedestalAtDock(sites, sites[1]!.dock)).toBe(sites[1]);
    expect(pedestalAtDock(sites, islandDocks(seaMap, 1)[0]!)).toBeUndefined();
    expect(pedestalAtDock(sites, -1)).toBeUndefined();
  });
});

describe("the fruit deal's seed (§3, §9, §16)", () => {
  it("is the fruit's own derivation of the master secret: distinct from every other system's, the same deal for the same secret whatever the match code", () => {
    const secret = secretOf(5);
    const seed = deriveSeed(secret, "fruit");
    const fruits = createMatchFruits({ sites, seed });
    expect(fruits).toEqual(createFruitState(sites, seed, rulesPresets.slice));
    const others: SeedSystem[] = ["world", "ledger", "final-socket", "intel", "ruins", "duel:1", "ruins:1"];
    for (const system of others) expect(deriveSeed(secret, system)).not.toBe(seed);
    // The derivation reads only the secret and the system: no match code can reach the deal.
    expect(deriveSeed.length).toBe(2);
    expect(createMatchFruits({ sites, seed: deriveSeed(secretOf(5), "fruit") })).toEqual(fruits);
    // Two of each fruit kit, and some secret deals them otherwise.
    expect([...kitsOf(fruits)].sort()).toEqual(["ember", "ember", "smoke", "smoke"]);
    let fill = 6;
    while (kitsOf(createMatchFruits({ sites, seed: deriveSeed(secretOf(fill), "fruit") })).join() === kitsOf(fruits).join() && fill < 200) fill++;
    expect(fill).toBeLessThan(200);
  });

  it("is pinned only by the test-only deal, which must hold two of each fruit kit", () => {
    const pinned = createMatchFruits({ sites, seed: 3, layout: ["ember", "smoke", "smoke", "ember"] });
    expect(kitsOf(pinned)).toEqual(["ember", "smoke", "smoke", "ember"]);
    expect(pinned.pedestals.every((pedestal) => pedestal.eatenBy === null)).toBe(true);
    expect(() => createMatchFruits({ sites, seed: 3, layout: ["ember", "ember", "ember", "smoke"] })).toThrow(/test fruit deal/);
    expect(() => createMatchFruits({ sites, seed: 3, layout: ["ember", "smoke"] })).toThrow(/test fruit deal/);
  });
});

describe("an inspection (§9, §16)", () => {
  it("sends the pedestal's island, kit and §9 description while full, and only that it is empty once eaten", () => {
    const fruits = createMatchFruits({ sites, seed: 1, layout: ["ember", "smoke", "smoke", "ember"] });
    const inspected = inspectionOf(fruits, sites[0]!);
    const { name, specials, advantage, vulnerability } = kitDescriptions.ember;
    expect(inspected).toEqual({ island: 0, full: true, kit: "ember", name, specials: [...specials], advantage, vulnerability });
    expect(fruitInspectedMessageSchema.parse(inspected)).toEqual(inspected);
    const config = createFruitConfig();
    let state = fruits;
    for (let tick = 1; tick <= config.eatTicks; tick++) {
      state = stepFruits(config, state, { tick, players: [{ playerId: "a", pedestalId: "pedestal-0", holding: true, reserved: false, disconnected: false, left: false }] }).state;
    }
    expect(inspectionOf(state, sites[0]!)).toEqual({ island: 0, full: false });
    expect(inspectionOf(state, sites[1]!)).toMatchObject({ full: true, kit: "smoke" });
  });

  it("names the kits as the protocol does", () => {
    expect([...DUEL_KIT_NAMES]).toEqual([...KIT_IDS]);
    expect([...FRUIT_KIT_NAMES]).toEqual([...FRUIT_KIT_IDS]);
  });
});
