import { Buttons } from "@pirate-sea-race/protocol";

/** What the player asks of their ship: protocol axes (moveX turns, moveY is the throttle, up ahead) and buttons. */
export interface Helm {
  readonly moveX: number;
  readonly moveY: number;
  readonly buttons: number;
}

export const NEUTRAL_HELM: Helm = { moveX: 0, moveY: 0, buttons: 0 };

const KEYS = {
  left: ["KeyA", "ArrowLeft"],
  right: ["KeyD", "ArrowRight"],
  up: ["KeyW", "ArrowUp"],
  down: ["KeyS", "ArrowDown"],
  interact: ["KeyE"],
  grapple: ["KeyJ"],
} as const;

/** Buttons kept from a tap until the next read: interact (E) and the grapple (J, §8). */
const LATCHED: readonly [readonly string[], number][] = [
  [KEYS.interact, Buttons.Interact],
  [KEYS.grapple, Buttons.Grapple],
];

const HELM_CODES = new Set<string>(Object.values(KEYS).flat());

/** Converts two opposing keys into one axis: both held is neutral, whatever order they were pressed in (§8). */
export function axis(negative: boolean, positive: boolean): number {
  return (positive ? 1 : 0) - (negative ? 1 : 0);
}

/**
 * The keyboard input adapter (§8 defaults): up is throttle, down brakes (and reverses slowly from a stop), left and
 * right turn, E interacts (docks), J grapples. It tracks held keys and releases them all (and forgets a tap) when the
 * window loses focus, so a ship never keeps sailing, docks or grapples on a key the page missed. The page reads it on
 * a timer, so a tap of E or J that goes down and up between two reads is kept until the next read, as the duel
 * keyboard keeps its taps: it counts once.
 */
export class KeyboardHelm {
  private readonly held = new Set<string>();
  private tapped = 0;

  constructor(target: Window) {
    target.addEventListener("keydown", (event) => {
      if (!HELM_CODES.has(event.code) || isTyping(event.target)) return;
      event.preventDefault();
      this.press(event.code);
    });
    target.addEventListener("keyup", (event) => this.release(event.code));
    target.addEventListener("blur", () => {
      this.held.clear();
      this.tapped = 0;
    });
  }

  press(code: string): void {
    if (!HELM_CODES.has(code)) return;
    this.held.add(code);
    for (const [codes, button] of LATCHED) if (codes.includes(code)) this.tapped |= button;
  }

  release(code: string): void {
    this.held.delete(code);
  }

  /** What is held now, plus a button tapped since the last read. Reading it clears the tap. */
  helm(): Helm {
    const any = (codes: readonly string[]) => codes.some((code) => this.held.has(code));
    let buttons = this.tapped;
    for (const [codes, button] of LATCHED) if (any(codes)) buttons |= button;
    this.tapped = 0;
    return {
      moveX: axis(any(KEYS.left), any(KEYS.right)),
      moveY: axis(any(KEYS.up), any(KEYS.down)),
      buttons,
    };
  }
}

/**
 * Whether a key went to a text field (an input or a text area), which keeps its keys: the helm and the page's panels
 * ignore them. Read from the element's tag, so unit tests in Node can pass a stand-in.
 */
export function isTyping(target: EventTarget | null): boolean {
  const tag = (target as { tagName?: unknown } | null)?.tagName;
  return tag === "INPUT" || tag === "TEXTAREA";
}
