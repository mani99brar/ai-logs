import { rulesPresets, type RulesPresetId, type SeaMapDefinition } from "@pirate-sea-race/content";
import type { FruitInspectedMessage, TestFruits } from "@pirate-sea-race/protocol";
import { createFruitState, inspectPedestal, type FruitSite, type FruitState } from "@pirate-sea-race/simulation/fruits";
import { dockCentre, islandDocks, MATCH_PRESET } from "./objectives.js";

/**
 * The room's side of §9's fruit pedestals (`docs/fruits.md`): where the pedestals stand on the sea, a match's deal and
 * what an inspection sends. The fruit rules alone decide who eats what; nothing here eats a fruit.
 */

/** A pedestal on the sea: the fruit rules' site, plus the island and the dock a player moors at to reach it. */
export interface PedestalSite extends FruitSite {
  readonly island: number;
  readonly dock: number;
}

/**
 * The pedestal sites (§9: distinct from the rubbing sources): one on each regular island, at that island's highest-id
 * dock, so it stands at another dock than the island's first source whenever the island has more than one. Pedestal
 * `pedestal-<island>`, in island order.
 */
export function pedestalSites(map: SeaMapDefinition, presetId: RulesPresetId = MATCH_PRESET): PedestalSite[] {
  const sites: PedestalSite[] = [];
  for (let island = 0; island < rulesPresets[presetId].islands; island++) {
    const docks = islandDocks(map, island);
    if (docks.length === 0) throw new Error(`${map.name}: island ${island} has no dock for its pedestal`);
    const dock = Math.max(...docks);
    sites.push({ id: `pedestal-${island}`, island, dock, ...dockCentre(map, dock) });
  }
  return sites;
}

export interface MatchFruitsOptions {
  readonly sites: readonly PedestalSite[];
  /** The fruit seed derived from the match's master secret (`deriveSeed('fruit')`), never the match code (§3, §16). */
  readonly seed: number;
  /** Test-only: the kit on each site, in site order, instead of the seeded deal. */
  readonly layout?: TestFruits | undefined;
}

/**
 * A new match's fruit state: the fruit rules' seeded deal onto the sites. A test-only layout replaces the deal's kits,
 * and must hold the same fruit as the deal (two of each kit).
 */
export function createMatchFruits(options: MatchFruitsOptions): FruitState {
  const dealt = createFruitState(options.sites, options.seed >>> 0, rulesPresets[MATCH_PRESET]);
  const layout = options.layout;
  if (layout === undefined) return dealt;
  const deck = dealt.pedestals.map((pedestal) => pedestal.kit).sort();
  if ([...layout].sort().join() !== deck.join()) throw new Error(`test fruit deal: ${layout.join(",")} is not a deal of ${deck.join(",")}`);
  return { ...dealt, pedestals: dealt.pedestals.map((pedestal, index) => ({ ...pedestal, kit: layout[index]! })) };
}

/** The pedestal at a dock, if one stands there. */
export function pedestalAtDock(sites: readonly PedestalSite[], dock: number): PedestalSite | undefined {
  return sites.find((site) => site.dock === dock);
}

/**
 * What an inspection of a pedestal sends its inspector (§9, §16): the fruit's kit with its description, or that the
 * pedestal is empty. Only ever sent to a player moored at that pedestal's dock.
 */
export function inspectionOf(fruits: FruitState, site: PedestalSite): FruitInspectedMessage {
  // Every site is one of the state's pedestals.
  const inspected = inspectPedestal(fruits, site.id)!;
  if (!inspected.full) return { island: site.island, full: false };
  const { name, specials, advantage, vulnerability } = inspected.description;
  return { island: site.island, full: true, kit: inspected.kit, name, specials: [specials[0], specials[1]], advantage, vulnerability };
}
