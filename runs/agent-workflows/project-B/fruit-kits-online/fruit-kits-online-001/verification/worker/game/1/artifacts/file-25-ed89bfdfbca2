import { describe, expect, it } from "vitest";
import { RuinMessageType, type RuinClueMessage, type RuinOpenedMessage, type RuinResultMessage } from "@pirate-sea-race/protocol";
import { clueFor, createRuins } from "@pirate-sea-race/simulation/ruins";
import {
  attemptOf,
  canOpenRuin,
  EMPTY_ENTRY,
  enter,
  entryText,
  gridOf,
  lockoutLine,
  panelKey,
  pathCells,
  ruinLine,
  RuinPanel,
  ruinPanelView,
  sightedRuinsLine,
  tabletsOf,
  verdictLines,
  type Entry,
  type PanelKey,
  type RuinPanelView,
} from "./ruinPanel.js";

const sequence: Extract<RuinClueMessage, { kind: "sequence" }> = {
  kind: "sequence",
  length: 3,
  tablets: [
    { symbol: "sun", hint: { relation: "at", other: null, position: 0 } },
    { symbol: "moon", hint: { relation: "absent", other: null, position: null } },
    { symbol: "tide", hint: { relation: "right-after", other: "sun", position: null } },
    { symbol: "storm", hint: { relation: "absent", other: null, position: null } },
    { symbol: "anchor", hint: { relation: "not-at", other: null, position: 2 } },
    { symbol: "skull", hint: { relation: "after", other: "tide", position: null } },
  ],
};

/**
 *   S . # .
 *   . # . .
 *   . . . G
 *   . . # .
 */
const grid: Extract<RuinClueMessage, { kind: "navigation" }> = {
  kind: "navigation",
  size: 4,
  start: { x: 0, y: 0 },
  goal: { x: 3, y: 2 },
  blocked: [
    { x: 2, y: 0 },
    { x: 1, y: 1 },
    { x: 2, y: 3 },
  ],
};

const keys = (clue: RuinClueMessage, codes: readonly string[], from: Entry = EMPTY_ENTRY): Entry =>
  codes.reduce((entry, code) => {
    const key = panelKey(clue.kind, code);
    return key === undefined ? entry : enter(clue, entry, key);
  }, from);

describe("the clue as the panel lays it out (§3)", () => {
  it("shows the six tablets in display order, each with its key, glyph and inscription", () => {
    expect(tabletsOf(sequence)).toEqual([
      { key: 1, symbol: "sun", name: "Sun", glyph: "☀", text: "Sun comes first" },
      { key: 2, symbol: "moon", name: "Moon", glyph: "☾", text: "Moon is not in the sequence" },
      { key: 3, symbol: "tide", name: "Tide", glyph: "≈", text: "Tide comes right after Sun" },
      { key: 4, symbol: "storm", name: "Storm", glyph: "ϟ", text: "Storm is not in the sequence" },
      { key: 5, symbol: "anchor", name: "Anchor", glyph: "⚓", text: "Anchor does not come last" },
      { key: 6, symbol: "skull", name: "Skull", glyph: "☠", text: "Skull comes somewhere after Tide" },
    ]);
  });

  it("draws the grid row by row from the north, with the start, the goal and the blocked cells", () => {
    const rows = gridOf(grid).map((row) => row.map((cell) => ({ start: "S", goal: "G", blocked: "#", open: "." })[cell.kind]).join(""));
    expect(rows).toEqual(["S.#.", ".#..", "...G", "..#."]);
    expect(gridOf(grid)[2]![3]).toEqual({ x: 3, y: 2, kind: "goal" });
  });

  it("builds the panel's view from the clue, and hides it without one", () => {
    const hidden = ruinPanelView(undefined, EMPTY_ENTRY, 0, 0, []);
    expect(hidden).toMatchObject({ hidden: true, kind: "", tablets: [], grid: [], canSubmit: false });
    const tablets = ruinPanelView({ island: 0, clue: sequence, lockedUntil: 0, solved: false }, keys(sequence, ["Digit1", "Digit3", "Digit6"]), 0, 10, []);
    expect(tablets).toMatchObject({ hidden: false, kind: "sequence", island: 0, grid: [], path: [], chosen: ["sun", "tide", "skull"], canSubmit: true });
    expect(tablets.tablets).toHaveLength(6);
    const walk = ruinPanelView({ island: 1, clue: grid, lockedUntil: 0, solved: false }, keys(grid, ["ArrowDown", "ArrowDown"]), 0, 10, []);
    expect(walk).toMatchObject({ kind: "navigation", tablets: [], path: ["0,0", "0,1", "0,2"], canSubmit: false, entry: "S S" });
    expect(walk.grid).toHaveLength(4);
  });
});

describe("the digit keys and the tablets", () => {
  it("choose the tablet shown with that number: Digit1–6 follow the clue's tablet order, in every ruin the rules deal", () => {
    const islands = [0, 1, 2, 3].map((island) => ({ island, sourceIds: [`source-${island}-0`, `source-${island}-1`] }));
    let sequences = 0;
    for (let seed = 1; seed <= 40; seed++) {
      for (const ruin of Object.values(createRuins({ seed, islands }).ruins)) {
        const clue = clueFor(ruin) as RuinClueMessage;
        if (clue.kind !== "sequence") continue;
        sequences++;
        const tablets = tabletsOf(clue);
        expect(tablets.map((tablet) => tablet.key)).toEqual([1, 2, 3, 4, 5, 6]);
        for (const tablet of tablets) {
          expect(panelKey(clue.kind, `Digit${tablet.key}`)).toEqual({ kind: "symbol", symbol: tablet.symbol });
          expect(panelKey(clue.kind, `Numpad${tablet.key}`)).toEqual({ kind: "symbol", symbol: tablet.symbol });
        }
      }
    }
    expect(sequences).toBeGreaterThan(10);
  });
});

describe("entering an answer", () => {
  it("picks symbols by keys 1–6 or clicks, in order, once each, up to the sequence's length; Backspace undoes", () => {
    expect(keys(sequence, ["Digit1", "Numpad3"]).symbols).toEqual(["sun", "tide"]);
    // A repeated symbol and a fourth are ignored; 7, letters and arrows are not the panel's keys for a sequence.
    expect(keys(sequence, ["Digit1", "Digit1", "Digit3", "Digit6", "Digit2"]).symbols).toEqual(["sun", "tide", "skull"]);
    expect(panelKey("sequence", "Digit7")).toBeUndefined();
    expect(panelKey("sequence", "ArrowUp")).toBeUndefined();
    expect(panelKey("sequence", "KeyW")).toBeUndefined();
    expect(keys(sequence, ["Digit1", "Digit3", "Backspace", "Digit5"]).symbols).toEqual(["sun", "anchor"]);
    expect(keys(sequence, ["Backspace"]).symbols).toEqual([]);
    const clicked = enter(sequence, enter(sequence, EMPTY_ENTRY, { kind: "symbol", symbol: "skull" }), { kind: "symbol", symbol: "moon" });
    expect(clicked.symbols).toEqual(["skull", "moon"]);
    // A move means nothing to a sequence.
    expect(enter(sequence, EMPTY_ENTRY, { kind: "move", move: "N" })).toBe(EMPTY_ENTRY);
  });

  it("walks the grid with the arrows or WASD, never off it or onto a blocked cell; Backspace undoes", () => {
    expect(keys(grid, ["ArrowDown", "KeyS", "KeyD", "ArrowRight", "KeyD"]).moves).toEqual(["S", "S", "E", "E", "E"]);
    // North off the grid, and east into the blocked cell, are not taken.
    expect(keys(grid, ["ArrowUp", "KeyW", "ArrowLeft", "KeyA"]).moves).toEqual([]);
    expect(keys(grid, ["ArrowDown", "ArrowRight"]).moves).toEqual(["S"]);
    expect(keys(grid, ["KeyD", "KeyD"]).moves).toEqual(["E"]);
    expect(keys(grid, ["ArrowDown", "ArrowDown", "Backspace", "ArrowRight"]).moves).toEqual(["S"]);
    expect(panelKey("navigation", "Digit1")).toBeUndefined();
    expect(pathCells(grid, ["S", "S", "E"])).toEqual([
      { x: 0, y: 0 },
      { x: 0, y: 1 },
      { x: 0, y: 2 },
      { x: 1, y: 2 },
    ]);
    // A symbol means nothing to a grid; a path stops at 16 moves.
    expect(enter(grid, EMPTY_ENTRY, { kind: "symbol", symbol: "sun" })).toBe(EMPTY_ENTRY);
    const long = keys(grid, Array.from({ length: 20 }, (_, index) => (index % 2 === 0 ? "ArrowDown" : "ArrowUp")));
    expect(long.moves).toHaveLength(16);
  });

  it("has an attempt only when complete: every symbol, or a path ending on the goal", () => {
    expect(attemptOf(sequence, keys(sequence, ["Digit1", "Digit3"]))).toBeUndefined();
    expect(attemptOf(sequence, keys(sequence, ["Digit1", "Digit3", "Digit6"]))).toEqual({ kind: "sequence", symbols: ["sun", "tide", "skull"] });
    expect(attemptOf(grid, EMPTY_ENTRY)).toBeUndefined();
    expect(attemptOf(grid, keys(grid, ["KeyS", "KeyS", "KeyD", "KeyD"]))).toBeUndefined();
    expect(attemptOf(grid, keys(grid, ["KeyS", "KeyS", "KeyD", "KeyD", "KeyD"]))).toEqual({ kind: "navigation", moves: ["S", "S", "E", "E", "E"] });
  });

  it("writes the entry for the player to check", () => {
    expect(entryText(sequence, keys(sequence, ["Digit1"]))).toBe("☀ Sun → _ → _");
    expect(entryText(grid, EMPTY_ENTRY)).toBe("Start at S; walk to G");
    expect(entryText(grid, keys(grid, ["KeyS", "KeyS", "KeyD"]))).toBe("S S E");
  });

  it("reads Enter as submit, Escape as close and Backspace as undo for either kind", () => {
    for (const kind of ["sequence", "navigation"] as const) {
      expect(panelKey(kind, "Enter")).toEqual({ kind: "submit" });
      expect(panelKey(kind, "NumpadEnter")).toEqual({ kind: "submit" });
      expect(panelKey(kind, "Escape")).toEqual({ kind: "close" });
      expect(panelKey(kind, "Backspace")).toEqual({ kind: "undo" });
      expect(panelKey(kind, "KeyE")).toBeUndefined();
    }
  });
});

describe("the HUD and the verdicts", () => {
  it("says what the ruin at the island is, and whether R opens it", () => {
    expect(ruinLine({ ruin: "locked", ruinOpen: false, ruinLockedUntil: 0 })).toEqual({ text: "Sealed: rubbings locked. Press R for the clue", state: "locked" });
    expect(ruinLine({ ruin: "unlocked", ruinOpen: false, ruinLockedUntil: 0 })).toEqual({ text: "Opened by another captain. R: solve it too (+40 gold)", state: "unlocked" });
    expect(ruinLine({ ruin: "solved", ruinOpen: false, ruinLockedUntil: 0 })).toEqual({ text: "Solved by you", state: "solved" });
    expect(ruinLine({ ruin: "", ruinOpen: false, ruinLockedUntil: 0 })).toEqual({ text: "", state: "none" });
    expect(ruinLine(undefined).state).toBe("none");
    expect(["locked", "unlocked", "solved", ""].map((ruin) => canOpenRuin({ ruin, ruinOpen: false, ruinLockedUntil: 0 }))).toEqual([true, true, false, false]);
    expect(canOpenRuin(undefined)).toBe(false);
  });

  it("lists the ruins in sight, sealed or open", () => {
    const names = ["Palm Key", "Ember Rock"];
    expect(sightedRuinsLine([], (island) => names[island]!)).toEqual({ text: "", state: "none" });
    expect(
      sightedRuinsLine(
        [
          { island: 1, unlocked: true },
          { island: 0, unlocked: false },
        ],
        (island) => names[island]!,
      ),
    ).toEqual({ text: "Palm Key: sealed, Ember Rock: open", state: "0:sealed,1:open" });
  });

  it("counts a lockout down in whole seconds", () => {
    expect(lockoutLine(160, 100)).toEqual({ text: "Locked out: try again in 3 s", state: "locked", seconds: 3 });
    expect(lockoutLine(160, 141)).toMatchObject({ seconds: 1 });
    expect(lockoutLine(160, 160)).toEqual({ text: "", state: "none" });
    expect(lockoutLine(0, 5)).toEqual({ text: "", state: "none" });
  });

  it("words the verdicts: the gold and the unlock, a wrong answer, a refusal", () => {
    const base: RuinResultMessage = { requestId: "a", island: 0, outcome: "solved", reason: null, lockedUntil: 0, gold: 40, unlocked: true };
    expect(verdictLines(base).map((line) => line.text)).toEqual(["Ruin solved: +40 gold", "The island's rubbings are unlocked"]);
    expect(verdictLines({ ...base, unlocked: false }).map((line) => line.text)).toEqual(["Ruin solved: +40 gold"]);
    expect(verdictLines({ ...base, outcome: "wrong", gold: 0, unlocked: false, lockedUntil: 60 })[0]!.state).toBe("wrong");
    expect(verdictLines({ ...base, outcome: "refused", reason: "locked-out", gold: 0, unlocked: false })[0]).toEqual({
      text: "Still locked out: wait for the countdown",
      state: "refused:locked-out",
    });
    expect(verdictLines({ ...base, outcome: "refused", reason: "stale-tick", gold: 0, unlocked: false })[0]!.text).toBe("The ruin did not take that answer");
    expect(verdictLines({ ...base, outcome: "refused", reason: null, gold: 0, unlocked: false })[0]!.state).toBe("refused:");
  });
});

describe("the panel's behaviour (RuinPanel)", () => {
  const opened: RuinOpenedMessage = { island: 0, clue: sequence, lockedUntil: 0, solved: false };
  const moored = { ruin: "locked", ruinOpen: false, ruinLockedUntil: 0 };
  const open = { ...moored, ruinOpen: true };

  function panel() {
    const sent: { type: string; message: unknown }[] = [];
    const views: RuinPanelView[] = [];
    const ruins = new RuinPanel(
      (type, message) => sent.push({ type, message }),
      (view) => views.push(view),
      "t",
    );
    return { ruins, sent, last: () => views.at(-1)! };
  }
  const press = (ruins: RuinPanel, ...codes: string[]) => codes.map((code) => ruins.keydown({ code, repeat: false }));

  it("opens with R only where the HUD offers it, and not on a held key's repeat", () => {
    const { ruins, sent } = panel();
    expect(press(ruins, "KeyR")).toEqual([false]);
    ruins.update({ ...moored, ruin: "solved" }, 10);
    expect(press(ruins, "KeyR")).toEqual([false]);
    ruins.update(moored, 10);
    expect(ruins.keydown({ code: "KeyR", repeat: true })).toBe(false);
    expect(press(ruins, "KeyE", "KeyR")).toEqual([false, true]);
    expect(sent).toEqual([{ type: RuinMessageType.Open, message: {} }]);
    expect(ruins.isOpen).toBe(false);
  });

  it("shows the clue, takes keys and clicks, and submits a complete answer once per press with a fresh request id", () => {
    const { ruins, sent, last } = panel();
    ruins.update(moored, 10);
    ruins.clue(opened);
    ruins.update(open, 11);
    expect(ruins.isOpen).toBe(true);
    expect(last()).toMatchObject({ hidden: false, kind: "sequence", canSubmit: false });
    // Enter before the answer is complete sends nothing.
    press(ruins, "Digit1", "Enter");
    expect(sent).toEqual([]);
    ruins.press({ kind: "symbol", symbol: "tide" });
    press(ruins, "Digit6");
    expect(last()).toMatchObject({ chosen: ["sun", "tide", "skull"], canSubmit: true });
    press(ruins, "Enter");
    ruins.press({ kind: "submit" });
    expect(sent).toEqual([
      { type: RuinMessageType.Answer, message: { requestId: "t-1", attempt: { kind: "sequence", symbols: ["sun", "tide", "skull"] } } },
      { type: RuinMessageType.Answer, message: { requestId: "t-2", attempt: { kind: "sequence", symbols: ["sun", "tide", "skull"] } } },
    ]);
    // Keys the panel does not use are left to the page.
    expect(press(ruins, "KeyE", "ArrowUp")).toEqual([false, false]);
    // Malformed clues and verdicts are ignored.
    ruins.clue({ island: 0 });
    ruins.result({ outcome: "solved" });
    expect(last()).toMatchObject({ hidden: false, chosen: ["sun", "tide", "skull"] });
  });

  it("does not open for the clue of a ruin this player already solved", () => {
    const { ruins, last } = panel();
    ruins.update({ ...open, ruin: "solved" }, 10);
    ruins.clue({ ...opened, solved: true });
    expect(ruins.isOpen).toBe(false);
    expect(last().hidden).toBe(true);
  });

  it("counts a wrong answer's lockout down, clears the entry and refuses to submit until it ends", () => {
    const { ruins, sent, last } = panel();
    ruins.update(moored, 10);
    ruins.clue(opened);
    ruins.update(open, 11);
    press(ruins, "Digit1", "Digit2", "Digit3", "Enter");
    ruins.result({ requestId: "t-1", island: 0, outcome: "wrong", reason: null, lockedUntil: 71, gold: 0, unlocked: false });
    expect(last()).toMatchObject({ chosen: [], lockout: { state: "locked", seconds: 3 }, verdict: [{ state: "wrong" }] });
    press(ruins, "Digit1", "Digit3", "Digit6", "Enter");
    expect(last().canSubmit).toBe(false);
    expect(sent).toHaveLength(1);
    ruins.update(open, 71);
    expect(last()).toMatchObject({ lockout: { state: "none" }, canSubmit: true });
    press(ruins, "Enter");
    expect(sent).toHaveLength(2);
  });

  it("closes on a solve (showing the gold and the unlock in the HUD), on Escape, and when the server closes the session", () => {
    const { ruins, last } = panel();
    ruins.update(moored, 10);
    ruins.clue(opened);
    ruins.update(open, 11);
    ruins.result({ requestId: "t-1", island: 0, outcome: "solved", reason: null, lockedUntil: 0, gold: 40, unlocked: true });
    expect(ruins.isOpen).toBe(false);
    expect(last().hidden).toBe(true);
    expect(ruins.lastVerdict.map((line) => line.text)).toEqual(["Ruin solved: +40 gold", "The island's rubbings are unlocked"]);
    // Opening again clears it.
    ruins.update(moored, 12);
    press(ruins, "KeyR");
    expect(ruins.lastVerdict).toEqual([]);
    ruins.result({ requestId: "t-1", island: 0, outcome: "solved", reason: null, lockedUntil: 0, gold: 40, unlocked: true });
    // Away from the island the verdict goes.
    ruins.update({ ruin: "", ruinOpen: false, ruinLockedUntil: 0 }, 20);
    expect(ruins.lastVerdict).toEqual([]);

    ruins.update(moored, 30);
    ruins.clue(opened);
    ruins.update(open, 31);
    press(ruins, "Escape");
    expect(ruins.isOpen).toBe(false);

    // The clue arrives before the status shows the session: the panel stays until the session has opened and closed.
    ruins.update(moored, 39);
    ruins.clue(opened);
    ruins.update(moored, 40);
    expect(ruins.isOpen).toBe(true);
    ruins.update(open, 41);
    ruins.update(moored, 42);
    expect(ruins.isOpen).toBe(false);
    // And a clue arriving after the status: the session is known open at once.
    ruins.update(open, 50);
    ruins.clue(opened);
    ruins.update(undefined, 51);
    expect(ruins.isOpen).toBe(false);
  });

  it("keeps the entry when the same ruin's clue comes again, and starts afresh for another island", () => {
    const { ruins, last } = panel();
    ruins.update(open, 10);
    ruins.clue(opened);
    press(ruins, "Digit1");
    ruins.clue(opened);
    expect(last().chosen).toEqual(["sun"]);
    ruins.clue({ island: 1, clue: grid, lockedUntil: 0, solved: false });
    expect(last()).toMatchObject({ kind: "navigation", chosen: [], path: ["0,0"] });
    ruins.press({ kind: "move", move: "S" } satisfies PanelKey);
    ruins.press({ kind: "undo" });
    expect(last().path).toEqual(["0,0"]);
    ruins.press({ kind: "close" });
    ruins.press({ kind: "undo" });
    expect(last().hidden).toBe(true);
  });
});
