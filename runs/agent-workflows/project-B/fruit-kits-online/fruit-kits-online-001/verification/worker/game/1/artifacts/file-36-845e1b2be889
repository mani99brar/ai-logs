const context: InputContext = { lastAcceptedSeq: 4, serverFrame: 300 };
const valid = { seq: 5, frame: 301, buttons: 0, moveX: 1, moveY: -0.5 };

describe("input validation", () => {
  it("accepts a valid input", () => {
    expect(validateInputMessage(valid, context)).toEqual({ ok: true, input: valid });
  });

  it.each([
    ["undefined", undefined],
    ["a string", "left"],
    ["an array", [5, 301, 0, 1, 0]],
    ["a missing field", { seq: 5, frame: 301, buttons: 0, moveX: 1 }],
    ["an extra field", { ...valid, x: 100 }],
    ["a fractional sequence", { ...valid, seq: 5.5 }],
    ["a negative frame", { ...valid, frame: -1 }],
    ["a string axis", { ...valid, moveX: "1" }],
    ["a NaN axis", { ...valid, moveX: Number.NaN }],
    ["buttons out of range", { ...valid, buttons: 0x10000 }],
    ["a BigInt field", { ...valid, seq: 5n }],
  ])("rejects a malformed input: %s", (_label, message) => {
    expect(validateInputMessage(message, context)).toEqual({ ok: false, reason: "malformed" });
  });

  it("rejects an oversized input before parsing it", () => {
    const padded = { ...valid, padding: "x".repeat(MAX_INPUT_MESSAGE_BYTES) };
    expect(validateInputMessage(padded, context)).toEqual({ ok: false, reason: "oversized" });
    expect(validateInputMessage({ ...valid, note: "é".repeat(70) }, context)).toEqual({ ok: false, reason: "oversized" });
  });

  it("rejects a future-frame input", () => {
    const limit = context.serverFrame + MAX_INPUT_LEAD_FRAMES;
    expect(validateInputMessage({ ...valid, frame: limit }, context).ok).toBe(true);
    expect(validateInputMessage({ ...valid, frame: limit + 1 }, context)).toEqual({ ok: false, reason: "future-frame" });
  });

  it("rejects a repeated or older sequence number", () => {
    expect(validateInputMessage({ ...valid, seq: 4 }, context)).toEqual({ ok: false, reason: "stale-sequence" });
    expect(validateInputMessage({ ...valid, seq: 1 }, context)).toEqual({ ok: false, reason: "stale-sequence" });
  });

  it("rejects movement axes outside [-1, 1] rather than clamping them", () => {
    for (const axis of [1.0001, -1.5, 2, Number.POSITIVE_INFINITY]) {
      expect(validateInputMessage({ ...valid, moveX: axis }, context)).toEqual({ ok: false, reason: "malformed" });
      expect(validateInputMessage({ ...valid, moveY: axis }, context)).toEqual({ ok: false, reason: "malformed" });
    }
    expect(validateInputMessage({ ...valid, moveX: -1, moveY: 1 }, context).ok).toBe(true);
  });
});

describe("join options", () => {
  it("normalises typed codes to the canonical form", () => {
    expect(normalizeMatchCode("  k7q2mx ")).toBe("K7Q2MX");
  });

  it("accepts a canonical code and refuses anything else", () => {
    expect(joinMatchOptionsSchema.safeParse({ protocolVersion: PROTOCOL_VERSION, code: "K7Q2MX" }).success).toBe(true);
    for (const code of ["k7q2mx", "K7Q2M", "K7Q2MXX", "K7-2MX", ""]) {
      expect(joinMatchOptionsSchema.safeParse({ protocolVersion: PROTOCOL_VERSION, code }).success).toBe(false);
    }
  });
});

describe("create tokens", () => {
  it("formats 128 random bits as 32 lowercase hex digits", () => {
    expect(CREATE_TOKEN_BYTES * 8).toBeGreaterThanOrEqual(128);
    const token = formatCreateToken(Uint8Array.from({ length: CREATE_TOKEN_BYTES }, (_, index) => index * 17));
    expect(token).toBe("00112233445566778899aabbccddeeff");
    expect(createTokenSchema.safeParse(token).success).toBe(true);
  });

  it("refuses anything but a well-formed token in a create request", () => {
    const token = "0123456789abcdef0123456789abcdef";
    expect(createMatchOptionsSchema.safeParse({ protocolVersion: PROTOCOL_VERSION, createToken: token }).success).toBe(true);
    for (const createToken of [undefined, "", token.toUpperCase(), token.slice(1), `${token}0`, 42]) {
      expect(createMatchOptionsSchema.safeParse({ protocolVersion: PROTOCOL_VERSION, createToken }).success).toBe(false);
    }
  });
});

describe("refusal messages", () => {
  it("stay under 100 bytes, whatever version the client claims", () => {
    const messages = [
      MALFORMED_MATCH_REQUEST_MESSAGE,
      NO_SUCH_MATCH_MESSAGE,
      MATCH_CODE_REQUIRED_MESSAGE,
      MATCH_UNAVAILABLE_MESSAGE,
      matchFullMessage(8),
      ...[PROTOCOL_VERSION - 1, Number.MAX_SAFE_INTEGER, -Number.MAX_SAFE_INTEGER, "x".repeat(500), undefined, 1.5].map(
        protocolMismatchMessage,
      ),
    ];
    for (const message of messages) expect(encodedSize(message)! - 2).toBeLessThan(100);
  });

  it("names both protocol versions", () => {
    expect(protocolMismatchMessage(1)).toBe(
      `Protocol version mismatch: client v1, server v${PROTOCOL_VERSION}. Reload the page to update.`,
    );
    expect(protocolMismatchMessage("1; drop")).toContain("client v?,");
  });
});

describe("protocol v8 (the ruins)", () => {
  const sequence = { requestId: "r1", attempt: { kind: "sequence", symbols: ["tide", "sun", "skull"] } };
  const navigation = { requestId: "r-2_x", attempt: { kind: "navigation", moves: ["N", "E", "E", "S"] } };

  it("has an empty open request and an answer carrying a request id and an attempt", () => {
    expect(RuinMessageType).toEqual({ Open: "open-ruin", Answer: "answer-ruin", Clue: "ruin-clue", Result: "ruin-result" });
    expect(validateOpenRuinMessage({})).toEqual({});
    for (const candidate of [{ island: 0 }, null, "open", { pad: "x".repeat(20) }]) expect(validateOpenRuinMessage(candidate)).toBeUndefined();
    expect(validateAnswerRuinMessage(sequence)).toEqual(sequence);
    expect(validateAnswerRuinMessage(navigation)).toEqual(navigation);
    const longest = { requestId: "x".repeat(32), attempt: { kind: "navigation", moves: Array.from({ length: MAX_RUIN_MOVES }, () => "N") } };
    expect(validateAnswerRuinMessage(longest)).toEqual(longest);
    expect(JSON.stringify(longest).length).toBeLessThan(MAX_ANSWER_RUIN_BYTES);
  });

  it.each([
    ["an unknown symbol", { ...sequence, attempt: { kind: "sequence", symbols: ["gold"] } }],
    ["no symbols", { ...sequence, attempt: { kind: "sequence", symbols: [] } }],
    ["an unknown move", { ...navigation, attempt: { kind: "navigation", moves: ["NE"] } }],
    ["too many moves", { ...navigation, attempt: { kind: "navigation", moves: Array.from({ length: MAX_RUIN_MOVES + 1 }, () => "N") } }],
    ["moves under the sequence kind", { ...sequence, attempt: { kind: "sequence", moves: ["N"] } }],
    ["an unknown kind", { ...sequence, attempt: { kind: "riddle", symbols: ["sun"] } }],
    ["no request id", { attempt: sequence.attempt }],
    ["a request id with spaces", { ...sequence, requestId: "a b" }],
    ["a long request id", { ...sequence, requestId: "x".repeat(33) }],
    ["an extra field", { ...sequence, island: 0 }],
    ["an extra attempt field", { ...sequence, attempt: { ...sequence.attempt, answer: true } }],
    ["an oversized message", { ...sequence, attempt: { ...sequence.attempt, symbols: Array.from({ length: 40 }, () => "sun") } }],
    ["a string", "tide,sun,skull"],
  ])("refuses an answer with %s", (_label, candidate) => {
    expect(validateAnswerRuinMessage(candidate)).toBeUndefined();
  });

  it("parses the clue and the verdict the server sends, and refuses anything more", () => {
    const clue = {
      island: 1,
      clue: { kind: "sequence", length: 3, tablets: [{ symbol: "sun", hint: { relation: "right-after", other: "moon", position: null } }] },
      lockedUntil: 0,
      solved: false,
    };
    expect(parseRuinClueMessage(clue)).toEqual(clue);
    const grid = { island: 2, clue: { kind: "navigation", size: 4, start: { x: 0, y: 0 }, goal: { x: 3, y: 3 }, blocked: [{ x: 1, y: 1 }] }, lockedUntil: 90, solved: true };
    expect(parseRuinClueMessage(grid)).toEqual(grid);
    // A clue never carries an answer or a path length.
    expect(parseRuinClueMessage({ ...clue, clue: { ...clue.clue, answer: ["sun", "moon", "tide"] } })).toBeUndefined();
    expect(parseRuinClueMessage({ ...grid, clue: { ...grid.clue, minMoves: 6 } })).toBeUndefined();
    const result = { requestId: "r1", island: 1, outcome: "solved", reason: null, lockedUntil: 0, gold: 40, unlocked: true };
    expect(parseRuinResultMessage(result)).toEqual(result);
    expect(parseRuinResultMessage({ ...result, outcome: "maybe" })).toBeUndefined();
    expect(parseRuinResultMessage({ ...result, answer: ["sun"] })).toBeUndefined();
  });

  it("parses the test-only ruins, per island or for the rest, and refuses malformed ones", () => {
    expect(TEST_RUINS_ENV).toBe("PIRATE_SEA_RACE_TEST_RUINS");
    expect(TEST_NEXT_MATCH_RUINS_PATH).toBe("/__test/next-match-ruins");
    expect(parseTestRuins("*=open")).toEqual({ "*": "open" });
    expect(parseTestRuins("0=sequence, 1=navigation,*=open")).toEqual({ "0": "sequence", "1": "navigation", "*": "open" });
    for (const bad of ["", "0", "0=riddle", "x=open", "0=open,0=sequence", "100=open", "0=Open"]) expect(parseTestRuins(bad)).toBeUndefined();
    expect(testRuinsSchema.safeParse({ "0": "sequence" }).success).toBe(true);
    for (const bad of [{ "0": "riddle" }, { x: "open" }, "0=open", null]) expect(testRuinsSchema.safeParse(bad).success).toBe(false);
  });
});

describe("protocol v7 (the lobby, the reveals and the results)", () => {
  it("accepts only an empty start request from a client", () => {
    expect(MatchMessageType).toEqual({ Start: "start-match", StartRefused: "start-refused", Reveal: "reveal" });
    expect(validateStartMatchMessage({})).toEqual({});
    for (const candidate of [{ host: true }, "start", null, [], { pad: "x".repeat(40) }]) expect(validateStartMatchMessage(candidate)).toBeUndefined();
    expect(startRefusedMessageSchema.parse({ reason: "too-few" })).toEqual({ reason: "too-few" });
    expect(encodedSize(MATCH_STARTED_MESSAGE)).toBeLessThan(100);
  });

  it("parses each reveal the server sends, and refuses anything else", () => {
    const reveals = [
      { kind: "final-sector", tick: 10, sector: 1, name: "Northern Waters" },
      { kind: "final-route", tick: 10, x: 11_136, y: 4224, restored: false },
      { kind: "final-route-inactive", tick: 12 },
      { kind: "sector-reveal", tick: 20, sources: [{ sector: 0, name: "North-West Reach" }], caches: [] },
      { kind: "carrier-report", tick: 30, seenTick: 30, carriers: [{ sector: 4, name: "Central Waters", type: "sun" }] },
    ];
    expect(reveals.map((reveal) => reveal.kind)).toEqual([...REVEAL_KINDS]);
    for (const reveal of reveals) expect(parseRevealMessage(reveal)).toEqual(reveal);
    // A rumor is not a reveal (it comes with intel-online), and no reveal names a player.
    expect(parseRevealMessage({ kind: "rumor", tick: 1 })).toBeUndefined();
    expect(parseRevealMessage({ kind: "final-sector", tick: 10, sector: 1, name: "Northern Waters", playerId: "p1" })).toBeUndefined();
    expect(parseRevealMessage({ kind: "carrier-report", tick: 30, seenTick: 30, carriers: [{ sector: 4, name: "Central Waters", type: "gold" }] })).toBeUndefined();
  });

  it("parses the test-only timings and final-socket secret, and refuses malformed ones", () => {
    expect(TEST_TIMINGS_ENV).toBe("PIRATE_SEA_RACE_TEST_TIMINGS");
    expect(TEST_FINAL_SECRET_ENV).toBe("PIRATE_SEA_RACE_TEST_FINAL_SECRET");
    expect(parseTestTimings("ready=60,protection=20,match=12000")).toEqual({ ready: 60, protection: 20, match: 12_000 });
    expect(parseTestTimings("sectors=200, carriers=600")).toEqual({ sectors: 200, carriers: 600 });
    for (const bad of ["", "ready", "ready=0", "ready=-1", "ready=1.5", "speed=3", "ready=1,ready=2", "not timings"]) expect(parseTestTimings(bad)).toBeUndefined();
    expect(parseTestFinalSecret("3")).toBe(3);
    expect(parseTestFinalSecret("4294967295")).toBe(0xffffffff);
    for (const bad of ["", "-1", "4294967296", "0x10", "not a secret"]) expect(parseTestFinalSecret(bad)).toBeUndefined();
  });

  it("validates the test-only next match's timings: a subset of the timing names, each a positive whole number of ticks", () => {
    expect(TEST_NEXT_MATCH_TIMINGS_PATH).toBe("/__test/next-match-timings");
    expect(testTimingsSchema.safeParse({ match: 400 }).data).toEqual({ match: 400 });
    expect(testTimingsSchema.safeParse({ ready: 60, protection: 20, match: 12_000, sectors: 200, carriers: 600 }).success).toBe(true);
    expect(testTimingsSchema.safeParse({}).success).toBe(true);
    for (const bad of [{ match: 0 }, { match: -1 }, { match: 1.5 }, { match: "400" }, { speed: 3 }, { match: 10_000_000 }, "match=400", null]) {
      expect(testTimingsSchema.safeParse(bad).success).toBe(false);
    }
  });
});

describe("protocol v6 (rubbings: the theft choice)", () => {
  const choice = { duel: "d1", type: "moon" };

  it("accepts a theft choice naming a duel lobby and a rubbing type", () => {
    expect(RubbingMessageType.ChooseTheft).toBe("choose-theft");
    expect(validateChooseTheftMessage(choice)).toEqual(choice);
    for (const type of RUBBING_TYPE_NAMES) expect(validateChooseTheftMessage({ ...choice, type })).toEqual({ ...choice, type });
  });

  it.each([
    ["an unknown type", { ...choice, type: "gold" }],
    ["no duel", { type: "sun" }],
    ["an empty duel", { ...choice, duel: "" }],
    ["a long duel key", { ...choice, duel: "d".repeat(17) }],
    ["an extra field", { ...choice, rubbingId: "moon-1" }],
    ["an oversized message", { ...choice, duel: "d1", pad: "x".repeat(100) }],
    ["a string", "moon"],
    ["null", null],
  ])("refuses %s", (_label, candidate) => {
    expect(validateChooseTheftMessage(candidate)).toBeUndefined();
  });

  it("parses the test-only source layout, one group of types per island", () => {
    expect(TEST_SOURCES_ENV).toBe("PIRATE_SEA_RACE_TEST_SOURCES");
    expect(parseTestSourceLayout("sun,sun|moon,moon")).toEqual([["sun", "sun"], ["moon", "moon"]]);
    expect(parseTestSourceLayout("sun,Sun")).toBeUndefined();
    expect(parseTestSourceLayout("sun;moon")).toBeUndefined();
  });
});

describe("protocol v5 (the grapple, and duels at sea)", () => {
  it("the axes still steer a ship and interact docks it; the grapple is a new button bit", () => {
    expect(validateInputMessage({ ...valid, moveX: 0, moveY: 0, buttons: Buttons.Interact }, context).ok).toBe(true);
    expect(Buttons.Grapple).toBe(2);
    expect(Buttons.Grapple & Buttons.Interact).toBe(0);
    expect(validateInputMessage({ ...valid, buttons: Buttons.Grapple | Buttons.Interact }, context).ok).toBe(true);
    expect(Buttons.Fruit).toBe(4);
    expect(Buttons.Fruit & (Buttons.Grapple | Buttons.Interact)).toBe(0);
    expect(validateInputMessage({ ...valid, buttons: Buttons.Fruit }, context).ok).toBe(true);
  });
});

describe("test placement requests", () => {
  // A small map: the server builds the schema from its sea map.
  const bounds = { widthTiles: 40, heightTiles: 30 };
  const testPlacementSchema = createTestPlacementSchema(bounds);
  const placement = { code: "K7Q2MX", sessionId: "abc123", tileX: 20, tileY: 15, heading: 0 };

  it("accepts a placement on a tile with a heading", () => {
    expect(testPlacementSchema.safeParse(placement).success).toBe(true);
    expect(testPlacementSchema.safeParse({ ...placement, heading: PLACEMENT_HEADING_COUNT - 1 }).success).toBe(true);
  });

  it.each([
    ["a fractional tile", { ...placement, tileX: 1.5 }],
    ["a negative tile", { ...placement, tileY: -1 }],
    ["a tile east of the map", { ...placement, tileX: bounds.widthTiles }],
    ["a tile south of the map", { ...placement, tileY: bounds.heightTiles }],
    ["a heading beyond the circle", { ...placement, heading: PLACEMENT_HEADING_COUNT }],
    ["a negative heading", { ...placement, heading: -1 }],
    ["a malformed code", { ...placement, code: "nope" }],
    ["an extra field", { ...placement, speed: 64 }],
  ])("refuses %s", (_label, candidate) => {
    expect(testPlacementSchema.safeParse(candidate).success).toBe(false);
  });
});

describe("protocol v9 (the fruit)", () => {
  const ember = {
    island: 0,
    full: true,
    kit: "ember",
    name: "Ember",
    specials: ["Flame bolt", "Rising flare"],
    advantage: "Controls space and punishes jumps",
    vulnerability: "Long recovery if attacks miss",
  };

  it("is version 9, with an empty inspect request, F as the input's fruit button and the kit names", () => {
    expect(PROTOCOL_VERSION).toBe(9);
    expect(FruitMessageType).toEqual({ Inspect: "inspect-fruit", Inspected: "fruit-kit" });
    expect(validateInspectFruitMessage({})).toEqual({});
    for (const candidate of [{ island: 0 }, null, "inspect", { pad: "x".repeat(MAX_INSPECT_FRUIT_BYTES) }]) expect(validateInspectFruitMessage(candidate)).toBeUndefined();
    expect(validateInspectFruitMessage({ toJSON: () => 1n })).toBeUndefined();
    expect([...DUEL_KIT_NAMES]).toEqual(["duelist", "ember", "smoke"]);
    expect([...FRUIT_KIT_NAMES]).toEqual(["ember", "smoke"]);
  });

  it("parses the inspection the server sends, full or empty, and refuses anything more", () => {
    expect(parseFruitInspectedMessage(ember)).toEqual(ember);
    expect(parseFruitInspectedMessage({ island: 2, full: false })).toEqual({ island: 2, full: false });
    for (const bad of [
      { ...ember, kit: "duelist" },
      { ...ember, specials: ["Flame bolt"] },
      { ...ember, pedestal: "pedestal-0" },
      { island: 2, full: false, kit: "smoke" },
      { ...ember, island: -1 },
      "ember",
    ]) {
      expect(parseFruitInspectedMessage(bad)).toBeUndefined();
    }
  });

  it("carries a duel's two kits in its lobby, and refuses anything but two known kits", () => {
    expect(formatDuelKits(["ember", "duelist"])).toBe("ember,duelist");
    expect(parseDuelKits("ember,duelist")).toEqual(["ember", "duelist"]);
    expect(parseDuelKits("duelist,smoke")).toEqual(["duelist", "smoke"]);
    for (const bad of [undefined, "", "ember", "ember,duelist,smoke", "Ember,duelist", "spring,duelist"]) expect(parseDuelKits(bad)).toBeUndefined();
  });

  it("parses the test-only fruit deal, and refuses an unknown kit", () => {
    expect(TEST_FRUITS_ENV).toBe("PIRATE_SEA_RACE_TEST_FRUITS");
    expect(parseTestFruits("ember,smoke, smoke,ember")).toEqual(["ember", "smoke", "smoke", "ember"]);
    for (const bad of ["", "ember,duelist", "Ember", "ember;smoke"]) expect(parseTestFruits(bad)).toBeUndefined();
  });
});
