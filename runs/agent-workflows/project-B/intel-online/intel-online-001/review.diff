@@ -0,0 +1,527 @@
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { isNavigable, seaMap } from "@pirate-sea-race/content";
+import { JournalMessageType, journalMessageSchema, MAX_BUY_RUMOR_PER_SECOND, type JournalMessage } from "@pirate-sea-race/protocol";
+import { startGameServer, type MatchRoom, type RunningGameServer } from "@pirate-sea-race/server";
+import { objectiveRules } from "@pirate-sea-race/simulation/objectives";
+import { HeadlessClient, ImpairmentProxy, sleep, type Movement } from "@pirate-sea-race/test-tools";
+import { GUEST_SEAT, HOST_SEAT, placePair, tuned } from "./rubbingsSetup.js";
+import { collectAt, containsText, HOLD_E, HUB_X, OPEN_ROW, openWater, playersAt, roomOf, startThroughLobby, tracker, until, EAST, type Seat } from "./seaDuelSetup.js";
+
+/**
+ * §3 and §11's intel through the real room: start rumors, fresh and replacement leads, the journal log in each player's
+ * own status, and targeted rumor purchases, read from what the headless clients received (and, for §16, from their raw
+ * frames). Every island seals one Sun and one Moon here (test-only), so collecting an island's Sun leaves a rumor about
+ * it stale. Players start with 40 gold (test-only), so one rumor (25) is affordable and a second is not. The rooms check
+ * `checkLedger` (the gold identity among it) and their own invariant after every world tick (`tracker`). Cases that
+ * need one exact tick line requests up with the room's test hooks (`testBuyRumor`, `stepWorldTicks`) while the clock is
+ * paused.
+ */
+const LAYOUT = [
+  ["sun", "moon"],
+  ["sun", "moon"],
+  ["sun", "moon"],
+  ["sun", "moon"],
+];
+const GOLD = 40;
+const PRICE = objectiveRules.rumorPrice;
+let server: RunningGameServer;
+let endpoint: string;
+
+beforeAll(async () => {
+  const matchTuning = tuned({
+    sourceLayout: LAYOUT,
+    objectives: { ...objectiveRules, collectTicks: 20, cacheClaimTicks: 20, startingGold: GOLD },
+    testHooks: true,
+  });
+  server = await startGameServer({ port: 0, host: "127.0.0.1", handleSignals: false, testPlacement: true, matchTuning });
+  endpoint = `http://127.0.0.1:${server.port}`;
+});
+
+afterAll(async () => {
+  await server.close();
+});
+
+/** Open water in a row south of the hub, one seat per player, out of every dock's way. */
+const seat = (index: number): Seat => ({ tileX: HUB_X - 8 + index * 4, tileY: OPEN_ROW, heading: EAST });
+const dockOf = (island: number, which = 0) => seaMap.docks.filter((dock) => dock.island === island)[which]!;
+
+/** Open water `distance` tiles from a dock, in a straight clear line from it, facing the dock (a grapple's aim). */
+function seatOff(dock: { tileX: number; tileY: number }, distance: number): Seat {
+  for (const [dx, dy] of [
+    [-1, 0],
+    [1, 0],
+    [0, -1],
+    [0, 1],
+  ] as const) {
+    const at = { tileX: dock.tileX + dx * distance, tileY: dock.tileY + dy * distance, heading: 0 };
+    if (!isNavigable(seaMap, at.tileX, at.tileY) || !openWater(at, { ...dock, heading: 0 })) continue;
+    return { ...at, heading: (Math.round((Math.atan2(-dy, -dx) / (2 * Math.PI)) * 64) + 64) % 64 };
+  }
+  throw new Error(`no open water ${distance} tiles off dock ${dock.tileX},${dock.tileY}`);
+}
+
+async function moor(client: HeadlessClient, dock: { id: number; tileX: number; tileY: number }): Promise<void> {
+  await client.placeShip(endpoint, { tileX: dock.tileX, tileY: dock.tileY, heading: 0 });
+  await client.holdUntil(HOLD_E, () => client.ship()?.dock === dock.id, 5000);
+}
+
+/** The player's start rumor, once it arrived. */
+async function startRumor(client: HeadlessClient): Promise<Extract<JournalMessage, { kind: "rumor" }>> {
+  await client.waitFor(() => client.leads.some((lead) => lead.kind === "rumor" && lead.reason === "start"));
+  return client.leads.find((lead) => lead.kind === "rumor" && lead.reason === "start") as Extract<JournalMessage, { kind: "rumor" }>;
+}
+
+/** The ledger's purchases for a player. */
+const purchasesOf = (room: MatchRoom, id: string) => room.ledgerState.requests.filter((outcome) => outcome.kind === "purchase" && outcome.playerId === id);
+const goldOf = (room: MatchRoom, id: string) => room.ledgerState.players.find((player) => player.id === id)!.gold;
+
+/** Holds the room's clock after the current world tick. */
+async function pause(room: MatchRoom): Promise<void> {
+  room.pauseAfterTick(room.matchState.worldTick);
+  await until(() => room.worldPaused, 2000, "the pause");
+}
+
+/** The targeted leads a player received (rumors, or sighting entries, bought), each once (a replay resends its lead). */
+const targetedLeads = (client: HeadlessClient) =>
+  [...new Map(client.leads.map((lead) => [JSON.stringify(lead), lead])).values()].flatMap((lead) =>
+    lead.kind === "rumor" && lead.reason === "targeted" ? [lead.type] : lead.kind === "carrier-sighting" ? lead.sightings.filter((each) => each.reason === "targeted").map((each) => each.type) : [],
+  );
+
+describe.concurrent("rumors and the journal (§3, §11)", () => {
+  it("gives every player a start rumor at control start: an island with a sealed source of a type they lack, never a carrier; the journal and the offers show it", async ({ onTestFinished }) => {
+    const track = tracker(onTestFinished);
+    const clients = await playersAt(endpoint, [seat(0), seat(1), seat(2)], track);
+    const room = roomOf(clients[0]!);
+    const controlStart = room.flowState.controlStartTick!;
+    for (const client of clients) {
+      const rumor = await startRumor(client);
+      expect(rumor.tick).toBe(controlStart);
+      expect(rumor.entry).toBe(1);
+      // No cache exists yet, so it names an island, where a source of that type is still sealed.
+      expect(rumor.target.kind).toBe("island");
+      const island = rumor.target.kind === "island" ? rumor.target.island : -1;
+      expect(rumor.target.name).toBe(seaMap.islands[island]!.name);
