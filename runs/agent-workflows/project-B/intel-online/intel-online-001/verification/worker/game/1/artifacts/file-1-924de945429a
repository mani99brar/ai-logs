/** Who holds a rubbing at a location: its owner, or the player a duel reserves it for; nobody at a source or a cache. */
const holderOf = (location: RubbingLocation): string | undefined => (location.kind === "player" || location.kind === "duel" ? location.playerId : undefined);

const sameTarget = (channel: LedgerChannel | null, target: InteractTarget): boolean =>
  channel !== null &&
  (target.kind === "collect"
    ? channel.kind === "collect" && channel.sourceId === target.sourceId
    : channel.kind === "claim" && channel.cacheId === target.cacheId && channel.rubbingId === target.rubbingId);

/**
 * One private match (§14): the only writer of its state. It runs the shared simulation on a 60 Hz fixed step,
 * applies validated client intent, and mirrors the simulation into the synced schema after every world step.
 *
 * The match flow (§2, §5): the match module (`stepMatch`) runs the lobby, the host's start, the ready countdown and
 * control start, then the end and the results; ships take input only between control start and the end. From control
 * start each world tick runs §5's order: the encounters (reservations first), the ledger's holds, the claim channel
 * (`stepClaim`), the flow (with the tick's accomplishments and the claim's end), then intel (`stepIntel`, whose reveals
 * and leads go to exactly their recipients, with the targeted rumor purchases decided around it and charged only when a
 * lead is delivered). A world tick that throws aborts the match (§12). Every system's
 * seed is derived from one private master secret per match (`deriveSeed`), never from the match code.
 *
 * Encounters (§6): each world step the room builds the tick's snapshot for `stepEncounters` (every ship, whether its
 * player is connected, pressed the grapple, or has a loaded arena) and applies the events: a landed grapple stops both
 * ships and opens a duel at sea, a `DuelMachine` (the standalone duel room's own) whose fight starts when the rules
 * say so; its end goes back as a report; the returns and respawns move ships. Reserved and respawning ships get
 * neutral input.
 *
 * Rubbings (§4, §11, §12): the objective ledger is the only writer of rubbings and gold; the room calls its operations
 * and never moves either itself. Holding E moored at an island's dock collects its first eligible source, or else
 * claims a rubbing from a recovery cache at that dock. A reservation reserves the duel in the ledger; the fight's end
 * is reported to it; the room reports `settled` to the encounter rules only when the ledger has settled the duel (the
 * winner's theft choice, or the default at the deadline), and only then do the players return. The world tick drives
 * every §12 timer: a drop disconnects the player in the ledger at once (the ship stays, and can be grappled), a
 * fighter away from an unfinished duel forfeits it after `duelAbsenceTicks`, the seat expires at the ledger's
 * deadline into a cache at the respawn dock, and any other leave is a quit into a cache at the nearest dock by sea.
 * No path removes a ship while the ledger still counts its player; `checkInvariants` checks that and `checkLedger`
 * after every tick.
 *
 * Fruit (§9): four pedestals at island docks, dealt from the fruit's own seed. A player moored at a pedestal's dock
 * inspects it (the kit goes to them only) and eats it by holding F for three seconds; the fruit rules alone decide who
 * eats, and each world tick hears this tick's reservations and disconnects. Every duel at sea starts with both
 * fighters' kits in its frame-0 state.
 *
 * Visibility (§16): every client has a Colyseus StateView. After each mirror the room puts into it the client's own
 * ship and every ship inside that ship's sight radius, and takes out the rest, so a ship out of sight is never encoded
 * into that client's patches. Ships in a duel or waiting to respawn are hidden from everyone else (a duel shows as a
 * marker). Grapples, markers and caches are filtered by the same sight rule (a grapple's target is blanked for a
 * viewer who cannot see it); a player's status (gold, rubbings, what their island and dock hold, their theft choice)
 * and duel go to that player only, and a duel's frames and probes are messages to its two fighters. A fighter or a
 * player waiting to respawn sees no other ship. Terrain is static content every client already has, so it is not
 * synced at all.
 */
export class MatchRoom extends Room<{ state: MatchStateSchema; metadata: MatchMetadata }> {
  override maxClients = privateMatch.maxPlayers;
  /** A flood ceiling: past it Colyseus disconnects the client. Excess input is dropped well below it, in InputGate. */
  override maxMessagesPerSecond = MAX_INPUT_MESSAGES_PER_SECOND * 4;
  override patchRate = PATCH_INTERVAL_MS;
  override state = new MatchStateSchema();

  private readonly config = defaultSimulationConfig;
  private tuning: MatchTuning = DEFAULT_MATCH_TUNING;
  private encounterConfig: EncounterConfig = createEncounterConfig({ map: defaultSimulationConfig.map });
  private simulation: MatchState = createMatchState(0);
  private encounters: EncounterState = createEncounterState(this.encounterConfig);
  private ledger: LedgerState = createMatchLedger({ map: defaultSimulationConfig.map, seed: 0, rules: objectiveRules });
  /** §3's ruins, one per regular island, dealt from their own seed; they alone decide opens, answers and lockouts. */
  private ruins: RuinsState = createMatchRuins({ islands: [], seed: () => 0 }).ruins;
  /** Each player's recent ruin answers by request id: a retry gets the first verdict, never a second judgement. */
  private readonly ruinRequests = new RuinRequests<RuinResultMessage>();
  /** Ruin messages per session in the current second, for the rate cap. */
  private readonly ruinRate = new Map<string, { windowStart: number; count: number }>();
  /** §9's pedestals, one per regular island at its highest-id dock, and the fruit rules' state, dealt from their own seed. */
  private pedestals: readonly PedestalSite[] = [];
  private readonly fruitConfig: FruitConfig = createFruitConfig();
  private fruits: FruitState = { tick: 0, pedestals: [], channels: [], meals: [] };
  /** Fruit inspections per session in the current second, for the rate cap. */
  private readonly fruitRate = new Map<string, { windowStart: number; count: number }>();
  private readonly gates = new Map<string, InputGate>();
  /** Duels at sea by encounter id, from the grapple until their lobby leaves the fighters' views. */
  private readonly seaDuels = new Map<string, SeaDuel>();
  private nextDuelKey = 1;
  /** Players whose connection dropped and who have not come back or left. */
  private readonly away = new Map<string, Away>();
  /** Players who started a collection, a cache claim or a treasure claim this tick: their protection ends on the next (§6). */
  private protectionEndedNext = new Map<string, "claim" | "collection">();
  private readonly notices = new Map<string, Notices>();
  /** Ledger duels whose settlement is already in the players' notices. */
  private readonly noticed = new Set<string>();
  /** Theft choices per session in the current second, for the rate cap. */
  private readonly choiceRate = new Map<string, { windowStart: number; count: number }>();
  /** Reports the rules refused (none are expected), for tests. */
  private refusedReports = 0;
  /** Ledger requests the room made that the ledger refused, by operation and reason, for tests. */
  private readonly refusals: string[] = [];
  /** Invariant violations found after a world tick (none are expected), for tests. */
  private readonly violations: string[] = [];
  /** The creator's one-time token; cleared once the creator's seat is taken. */
  private createToken: string | undefined;

  /** The match's private master secret (§3, §16): every system's seed is derived from it, never from the code. */
  private secret: Uint8Array = new Uint8Array(32);
  /** Duels at sea opened so far, for their derived seeds. */
  private duelsOpened = 0;
  /** The final island (§3, §5): its socket and its claim point, the treasure circle's centre. Never synced to everyone. */
  private finalIsland: { readonly socket: number; readonly claimPoint: ClaimPoint } = { socket: 0, claimPoint: { x: 0, y: 0 } };
  /** §2's match flow: the lobby, the ready countdown, control start, the timer, the end and the results. */
  private flowConfig: FlowConfig = matchConfigFor(DEFAULT_MATCH_TUNING);
  private flow: FlowState = createFlowState(this.flowConfig);
  /** Reports for the flow's next step: joins, leaves and start requests between ticks, accomplishments on a tick. */
  private flowReports: FlowReport[] = [];
  /** Reports dropped before the flow's step for naming a player it does not know (none are expected), for tests. */
  private readonly droppedReports: FlowReport[] = [];
  /** §5's claim channel, from control start. */
  private claimConfig: ClaimConfig | undefined;
  private claim: ClaimState | undefined;
  /** §2 and §5's reveals, from control start. */
  private intelConfig: IntelConfig | undefined;
  private intel: IntelState | undefined;
  /** Each player's route to the final island, once revealed to them. */
  private readonly routes = new Map<string, Route>();
  /** §3, §13: each player's journal log, fed by every lead they receive (intel's own journal keeps no sightings). */
  private readonly journal = new JournalLog();
  /** §11: the targeted rumor requests waiting for a world tick, and every decision kept for replays. */
  private readonly rumors = new RumorBook();
  /** Purchase requests per session in the current second, for the rate cap. */
  private readonly rumorRate = new Map<string, { windowStart: number; count: number }>();
  /** What a targeted rumor about each missing type would yield for each player, as their status shows it. */
  private readonly rumorOffers = new Map<string, string>();
  /** §13: the islands each player has had in sight or moored at, with each one's unlocked state as last seen. */
  private readonly knownIslands = new Map<string, Map<number, boolean>>();
  /** The (player, island) pairs already reported as visited, and each player's last reported gold. */
  private readonly visited = new Set<string>();
  private readonly reportedGold = new Map<string, number>();
  /** Start requests per session in the current second, for the rate cap. */
  private readonly startRate = new Map<string, { windowStart: number; count: number }>();
  /** Where each rubbing was at the last world tick, for the results' accomplishments. */
  private readonly lastLocations = new Map<string, RubbingLocation>();
  /** Test-only hooks (`testHooks`): a fault injected into the next world tick, and a world tick to pause after. */
  private faultNext = false;
  private pauseAt: number | undefined;
  private paused = false;

  static override async onAuth(_token: string, options: unknown, _context: AuthContext): Promise<true> {
    return authorizeEntry(options);
  }

  /** The match's timings; the server's test-only setting overrides it in a subclass (`startGameServer`). */
  protected matchTuning(): MatchTuning {
    return DEFAULT_MATCH_TUNING;
  }

  override async onCreate(options: unknown): Promise<void> {
    // Only a token-carrying request creates a match. A join by code reaches here only when its match filled up or
    // closed after authorizeEntry admitted it (joinOrCreate then falls back to create).
    const parsed = createMatchOptionsSchema.safeParse(options);
    if (!parsed.success) throw new ServerError(ErrorCode.MATCHMAKE_INVALID_CRITERIA, MATCH_UNAVAILABLE_MESSAGE);
    this.createToken = parsed.data.createToken;
    const code = await this.allocateCode();
    this.tuning = this.matchTuning();
    this.encounterConfig = createEncounterConfig({ map: this.config.map, rules: this.tuning.encounters });
    this.encounters = createEncounterState(this.encounterConfig);
    // One private master secret per match; each system gets its own seed derived from it, never the match code (§3, §16).
    this.secret = this.tuning.masterSecret();
    this.simulation = createMatchState(this.seedOf("world"));
    this.ledger = createMatchLedger({ map: this.config.map, seed: this.seedOf("ledger"), rules: this.tuning.objectives, layout: this.tuning.sourceLayout });
    this.finalIsland = finalIslandOf(this.config.map, this.tuning.finalSocketSecret ?? this.seedOf("final-socket"));
    // Every source starts locked behind its island's ruin (§3); only a test opens islands from the start.
    const dealt = createMatchRuins({
      islands: ruinIslandsOf(this.ledger),
      seed: (attempt) => this.seedOf(attempt === 0 ? "ruins" : `ruins:${attempt}`),
      settings: this.tuning.testRuins,
    });
    this.ruins = dealt.ruins;
    this.ledger = openIslandsInLedger(this.ledger, dealt.openIslands);
    // §9's fruit, dealt onto the pedestals from the fruit's own seed (only a test pins the deal).
    this.pedestals = pedestalSites(this.config.map);
    this.fruits = createMatchFruits({ sites: this.pedestals, seed: this.seedOf("fruit"), layout: this.tuning.testFruits });
    for (const site of this.pedestals) {
      const marker = new PedestalMarkerSchema();
      marker.island = site.island;
      marker.dock = site.dock;
      marker.x = site.x;
      marker.y = site.y;
      this.state.pedestals.set(site.id, marker);
    }
    for (const island of Object.keys(this.ruins.ruins)) {
      const marker = new RuinMarkerSchema();
      const centre = islandCentre(this.config.map, Number(island));
      marker.island = Number(island);
      marker.x = centre.x;
      marker.y = centre.y;
      this.state.ruins.set(island, marker);
    }
    this.flowConfig = matchConfigFor(this.tuning);
    this.flow = createFlowState(this.flowConfig);
    this.state.code = code;
    this.state.protocolVersion = PROTOCOL_VERSION;
    this.state.custom = privateMatch.custom;
    this.state.minPlayers = this.flowConfig.minPlayers;
    this.state.durationTicks = this.flowConfig.durationTicks;
    this.state.readyTicks = this.flowConfig.readyTicks;
    this.state.treasureRadius = this.tuning.claim.circleRadiusTiles * this.config.map.subUnitsPerTile;
    this.state.finalSector = "";
    this.state.finalSectorIndex = -1;
    this.state.endReason = "";
    this.state.phase = this.flow.phase;
    // Colyseus copied the filterBy fields of the create request, the token among them, into the listing's metadata.
    // Replacing the metadata drops the token before the listing is first stored.
    await this.setMatchmaking({ metadata: { code, custom: privateMatch.custom, started: false } });

    this.onMessage(MessageType.Input, (client, message: unknown) => {
      this.gates.get(client.sessionId)?.receive(message, this.simulation.frame);
    });
    // A duel's messages reach only its machine, and only from its two fighters.
    this.onMessage(DuelMessageType.Input, (client, message: unknown) => this.duelOfSession(client.sessionId)?.machine.receiveInput(client.sessionId, message));
    this.onMessage(DuelMessageType.Probe, (client, message: unknown) => this.duelOfSession(client.sessionId)?.machine.receiveProbeReply(client.sessionId, message));
    this.onMessage(DuelMessageType.Ready, (client, message: unknown) => {
      if (duelReadyMessageSchema.safeParse(message).success) this.duelOfSession(client.sessionId)?.machine.markReady(client.sessionId);
    });
    this.onMessage(RubbingMessageType.ChooseTheft, (client, message: unknown) => this.receiveTheftChoice(client.sessionId, message));
    this.onMessage(MatchMessageType.Start, (client, message: unknown) => this.receiveStart(client.sessionId, message));
    this.onMessage(RuinMessageType.Open, (client, message: unknown) => this.receiveOpenRuin(client.sessionId, message));
    this.onMessage(RuinMessageType.Answer, (client, message: unknown) => this.receiveAnswerRuin(client.sessionId, message));
    this.onMessage(FruitMessageType.Inspect, (client, message: unknown) => this.receiveInspectFruit(client.sessionId, message));
    this.onMessage(JournalMessageType.BuyRumor, (client, message: unknown) => this.receiveBuyRumor(client.sessionId, message));
    // Unknown message types are dropped, not answered: Colyseus would otherwise disconnect the sender.
    this.onMessage("*", () => undefined);
    this.setFixedTimestep(() => this.advance(), STEPS_PER_SECOND);
  }

  /**
   * The room's own admission check, which also covers `joinById` (no listing filter applies there): the one seat
   * carrying the creator's token, then only seats carrying this match's code. Throwing refuses and frees the seat.
   */
  override onJoin(client: Client, options: unknown): void {
    this.admit(options);
    // §2: a match that has left its lobby takes no one new, whatever path the request took.
    if (this.flow.phase !== "lobby") throw new ServerError(JoinRefusal.MatchFull, MATCH_STARTED_MESSAGE);
    this.flowReports.push({ kind: "join", playerId: client.sessionId });
    this.simulation = addShip(this.config, this.simulation, client.sessionId);
    this.ledgerStep("addPlayer", addPlayer(this.ledger, { playerId: client.sessionId, tick: this.simulation.worldTick }));
    this.gates.set(client.sessionId, new InputGate());
    client.view = new StateView();
    this.mirror();
  }

  /**
   * A player's connection dropped without leaving (§12). The ledger marks them disconnected at once (their hold is
   * cancelled and their seat reserved until its deadline); the ship stays in the world and can be grappled. A fighter
   * in an unfinished duel is marked away, the fight going on with their input substituted, and forfeits if still away
   * after `duelAbsenceTicks`. Colyseus keeps the socket's seat for the outer bound only.
   */
  override onDrop(client: Client): void {
    const id = client.sessionId;
    // A request refused in onJoin (a wrong code, a used token) still drops and leaves, but never became a player.
    if (findPlayer(this.ledger, id) === undefined) return;
    const tick = this.simulation.worldTick;
    this.ledgerStep("disconnectPlayer", disconnectPlayer(this.ledger, { playerId: id, tick }));
    const duel = this.duelOfSession(id);
    const fighting = duel !== undefined && duel.machine.outcome === undefined;
    if (fighting) duel.machine.drop(id);
    const reconnection = this.allowReconnection(client, this.tuning.reconnectionSeconds);
    reconnection.catch(() => undefined);
    this.away.set(id, { reconnection, duelAbsentSince: fighting ? tick : undefined });
  }

  /** The same player is back before the deadline: the same identity, view, ship and rubbings; a fighter resumes. */
  override onReconnect(client: Client): void {
    const id = client.sessionId;
    this.away.delete(id);
    this.ledgerStep("reconnectPlayer", reconnectPlayer(this.ledger, { playerId: id, tick: this.simulation.worldTick }));
    this.duelOfSession(id)?.machine.reconnect(id);
  }

  /**
   * A player is gone for good. Unless the reservation already expired (the world tick removed them), this is a quit:
   * a consented leave, or Colyseus' outer bound closing first. The ledger forfeits a duel in progress and sends the
   * rest of their rubbings into a cache at the dock nearest their ship by sea; then the ship leaves.
   */
  override onLeave(client: Client): void {
    const id = client.sessionId;
    const player = findPlayer(this.ledger, id);
    if (player !== undefined && player.status !== "left") {
      this.quit(id);
      this.flowReports.push({ kind: "leave", playerId: id });
    }
    this.removePlayer(id);
    client.view?.dispose();
    client.view = undefined;
    this.mirror();
  }

  /**
   * Test-only (the server's test-placement setting, off by default): puts a player's ship at rest on a navigable tile.
   * Visibility follows at once, as after any move.
   */
  placeShip(sessionId: string, placement: Placement): void {
    this.simulation = placeShip(this.config, this.simulation, sessionId, placement);
    this.mirror();
  }

  /** The ship ids a client's view holds, for tests and diagnostics. */
  viewedShipIds(sessionId: string): string[] {
    const view = this.clients.get(sessionId)?.view;
    if (view === undefined) return [];
    return [...this.state.ships.values()].filter((ship) => view.has(ship)).map((ship) => ship.id);
  }

  /** Inputs dropped per client and reason, for tests and diagnostics. */
  droppedInputs(sessionId: string): InputGate["dropped"] | undefined {
    return this.gates.get(sessionId)?.dropped;
  }

  /** The encounter rules' state, for tests. */
  get encounterState(): EncounterState {
    return this.encounters;
  }

  /** The simulation state, for tests. */
  get matchState(): MatchState {
    return this.simulation;
  }

  /** The objective ledger, for tests. */
  get ledgerState(): LedgerState {
    return this.ledger;
  }

  /** The match's timings, for tests. */
  get timings(): MatchTuning {
    return this.tuning;
  }

  /** Reports the encounter rules refused, for tests (none are expected). */
  get refusedDuelReports(): number {
    return this.refusedReports;
  }

  /** Ledger requests the room made and the ledger refused, as "operation: reason", for tests. */
  get ledgerRefusals(): readonly string[] {
    return this.refusals;
  }

  /** Invariant violations found after any world tick so far (none are expected), for tests. */
  get invariantViolations(): readonly string[] {
    return this.violations;
  }

  /** The duel at sea a player is in (until its lobby leaves their view), for tests and the harness. */
  seaDuelDiagnostics(sessionId: string): SeaDuelDiagnostics | undefined {
    const duel = this.duelOfSession(sessionId);
    if (duel === undefined) return undefined;
    const [a, b] = duel.machine.state.fighters;
    return {
      ...duel.machine.diagnostics(),
      id: duel.id,
      outcome: duel.machine.outcome,
      players: duel.players,
      seed: duel.lobby.seed,
      kits: [a.kit, b.kit],
      inputLog: duel.machine.authority.inputLog(),
    };
  }

  private admit(options: unknown): void {
    this.createToken = admitSeat(options, { code: this.state.code, createToken: this.createToken }, MATCH_ADMISSION);
  }

  /** Applies a ledger step, and remembers a refusal (the room checks before it asks, so none are expected). */
  private ledgerStep<R extends { readonly ok: boolean; readonly rejection: string | null }>(operation: string, stepped: { state: LedgerState; result: R }): R {
    this.ledger = stepped.state;
    if (!stepped.result.ok) this.refusals.push(`${operation}: ${stepped.result.rejection}`);
    return stepped.result;
  }

  /**
   * One frame of the room's clock (60 Hz). Ships sail only while the match runs (§2: player control starts after the
   * ready countdown and stops at the end); before and after, every helm is neutral. On every third frame the world
   * tick runs in §5's order (`worldTick`), and a fault inside it aborts the match (§12).
   */
  private advance(): void {
    if (this.paused) return;
    this.stepFrame();
  }

  /** One frame of the clock, whether or not the test-only pause holds it (`stepWorldTicks` runs it then). */
  private stepFrame(): void {
    const frame = this.simulation.frame + 1;
    const inputs: Record<string, PlayerInput> = {};
    const playing = this.inPlay();
    const held = this.heldPlayers();
    for (const [sessionId, gate] of this.gates) {
      // No control before the start or after the end; a reserved or respawning ship ignores its player's helm (§6).
      if (!playing || held.has(sessionId)) inputs[sessionId] = NEUTRAL_INPUT;
      // A lapsed client gets no entry: its ship sails as neutral, but keeps its mooring throttle until real input.
      else if (!gate.lapsedAt(frame)) inputs[sessionId] = gate.inputAt(frame);
    }
    this.simulation = step(this.config, this.simulation, inputs);
    for (const duel of this.seaDuels.values()) duel.machine.advance();
    if (!isWorldStep(this.simulation.frame)) return;
    const tick = this.simulation.worldTick;
    try {
      this.worldTick(frame, tick, held, playing);
    } catch (error) {
      this.fault(tick, error);
    }
    for (const gate of this.gates.values()) gate.worldStepTaken();
    this.checkInvariants(tick);
    this.mirror();
    if (this.pauseAt !== undefined && tick >= this.pauseAt) {
      this.pauseAt = undefined;
      this.paused = true;
    }
  }

  /**
   * One world tick (20 Hz), in a fixed order. While the match runs: the ledger's clock (closed theft windows settle),
   * the §12 timers, then §5's order: the encounters (accepted reservations first), the ledger's holds, the claim
   * channel, the match flow (with this tick's claim end and accomplishments), and the reveals. Before control start
   * only the timers and the flow run (the lobby and the ready countdown); once the match has ended nothing changes but
   * the settled duels' lobbies leaving their fighters' views.
   */
  private worldTick(frame: number, tick: number, held: ReadonlySet<string>, playing: boolean): void {
    if (this.flow.end !== null) {
      this.closeShownDuels(tick);
      return;
    }
    if (this.faultNext) {
      this.faultNext = false;
      throw new Error("test-only fault injected into the world tick");
    }
    // The ledger's clock first: choice windows that closed settle with the default theft.
    this.ledgerStep("advanceLedger", advanceLedger(this.ledger, { tick }));
    this.runAbsences(tick);
    let claimEnd: FlowReport | undefined;
    if (playing) {
      this.stepEncounters(frame, held);
      // Where everyone is now, for the ruins: casting off or entering a duel closes a session (§3).
      for (const ship of this.simulation.ships) this.syncRuinPresence(ship.id);
      // §9's eating, with this tick's reservations: a duel reserved on this tick interrupts it.
      this.stepFruits(frame, tick);
      this.stepChannels(frame, tick);
      claimEnd = this.stepClaim(frame, tick);
    }
    this.noteSettlements();
    if (playing) this.reportAccomplishments(tick);
    this.stepFlow(tick, claimEnd);
    if (this.flow.controlStartTick !== null && this.flow.end === null) this.stepReveals(tick);
  }

  /** Player control has started and the match has not ended (§2's departure and exploration). */
  private inPlay(): boolean {
    return this.flow.phase === "departure" || this.flow.phase === "exploration";
  }

  /** Players whose ship is reserved for a duel (until it is settled) or waits out of the world to respawn. */
  private heldPlayers(): Set<string> {
    const held = new Set<string>();
    for (const duel of this.encounters.duels) for (const id of duel.players) held.add(id);
    for (const player of this.encounters.players) if (player.respawn !== null) held.add(player.id);
    return held;
  }

  /** The duel at sea a session fights in (until its lobby is removed). */
  private duelOfSession(sessionId: string): SeaDuel | undefined {
    for (const duel of this.seaDuels.values()) if (duel.players.includes(sessionId)) return duel;
    return undefined;
  }

  /** Takes a settled duel's lobby out of its fighters' views. */
  private closeSeaDuel(duel: SeaDuel): void {
    this.state.duels.delete(duel.key);
    this.seaDuels.delete(duel.id);
  }

  /**
   * §12 on the world tick: a fighter away from an unfinished duel for `duelAbsenceTicks` forfeits it (the duel goes on
   * to its settlement; they keep their seat); a disconnected player whose reservation deadline has come is removed,
   * their remaining rubbings going into a cache at the respawn dock the encounter rules would choose.
   */
  private runAbsences(tick: number): void {
    for (const [id, away] of this.away) {
      if (away.duelAbsentSince === undefined) continue;
      const duel = this.duelOfSession(id);
      if (duel === undefined || duel.machine.outcome !== undefined) away.duelAbsentSince = undefined;
      else if (tick - away.duelAbsentSince >= this.tuning.duelAbsenceTicks) {
        duel.machine.leave(id);
        away.duelAbsentSince = undefined;
      }
    }
    for (const player of this.ledger.players) {
      if (player.status !== "disconnected" || player.reservationDeadline === null || tick < player.reservationDeadline) continue;
      const position = this.respawnDockOf(player.id);
      this.ledgerStep("expireReservation", expireReservation(this.ledger, { playerId: player.id, tick, position }));
      // §12: an expired reservation releases the seat, which the flow counts as leaving.
      this.flowReports.push({ kind: "leave", playerId: player.id });
      const duel = this.duelOfSession(player.id);
      if (duel !== undefined && duel.machine.outcome === undefined) duel.machine.leave(player.id);
      const away = this.away.get(player.id);
      this.removePlayer(player.id);
      // The socket's seat goes too: Colyseus then calls onLeave, which finds the player already gone.
      if (typeof away?.reconnection?.reject === "function") away.reconnection.reject(false);
    }
  }

  /** §12 expiry: the dock the encounter rules would respawn this player at, from where their ship is (or waits). */
  private respawnDockOf(id: string): { x: number; y: number } {
    const ship = this.simulation.ships.find((each) => each.id === id);
    const respawn = this.encounters.players.find((each) => each.id === id)?.respawn ?? null;
    const from = respawn !== null ? { x: respawn.x, y: respawn.y } : ship !== undefined ? { x: ship.x, y: ship.y } : dockCentre(this.config.map, 0);
    const waiting = new Set(this.encounters.players.filter((each) => each.respawn !== null).map((each) => each.id));
    const opponents = this.simulation.ships.filter((each) => each.id !== id && !waiting.has(each.id)).map((each) => ({ x: each.x, y: each.y }));
    const point = this.encounterConfig.modes.ship.rules.respawnPoint({ encounter: from, own: from, opponents, clearRadius: this.encounterConfig.respawnClearRadius });
    return { x: point.x, y: point.y };
  }

  /** §12 quit: a duel in progress is forfeited (in the ledger and in the fight), the rest goes to the nearest dock. */
  private quit(id: string): void {
    const ship = this.simulation.ships.find((each) => each.id === id);
    const at = ship ?? dockCentre(this.config.map, 0);
    const position = dockCentre(this.config.map, nearestDockBySea(this.config.map, at.x, at.y));
    this.ledgerStep("quitPlayer", quitPlayer(this.ledger, { playerId: id, tick: this.simulation.worldTick, position }));
    const duel = this.duelOfSession(id);
    if (duel !== undefined && duel.machine.outcome === undefined) duel.machine.leave(id);
  }

  /** The ship and the input channel of a player who has left the ledger's match. */
  private removePlayer(id: string): void {
    this.setRuinPresence(id, null, false);
    this.ruinRequests.forget(id);
    this.ruinRate.delete(id);
    this.journal.forget(id);
    this.rumors.forget(id);
    this.rumorRate.delete(id);
    this.rumorOffers.delete(id);
    this.knownIslands.delete(id);
    this.fruitRate.delete(id);
    this.simulation = removeShip(this.simulation, id);
    this.gates.delete(id);
    this.away.delete(id);
    this.choiceRate.delete(id);
  }

  /**
   * One world tick of §6 (`stepEncounters`): this tick's snapshot of every ship, the reports of duels that ended since
   * the last tick and of duels the ledger has settled, then the events applied. The rules alone choose targets, land
   * or miss grapples, start fights and decide returns; the room moves ships and runs the duels.
   */
  private stepEncounters(frame: number, held: ReadonlySet<string>): void {
    const tick = this.simulation.worldTick;
    const endedBy = this.protectionEndedNext;
    this.protectionEndedNext = new Map();
    const players: EncounterPlayerInput[] = this.simulation.ships.map((ship) => {
      const gate = this.gates.get(ship.id);
      const duel = this.duelOfSession(ship.id);
      return {
        id: ship.id,
        mode: "ship",
        x: ship.x,
        y: ship.y,
        heading: ship.heading,
        connected: this.clients.get(ship.id) !== undefined,
        attack: !held.has(ship.id) && gate !== undefined && !gate.lapsedAt(frame) && (gate.inputAt(frame).buttons & GRAPPLE_BUTTON) !== 0,
        ready: duel?.machine.isReady(ship.id) === true,
        // §6: last tick's collection, cache claim or treasure claim ended this player's protection.
        protectionEndedBy: endedBy.get(ship.id) ?? null,
      };
    });
    const stepped = stepEncounters(this.encounterConfig, this.encounters, { tick, players, reports: this.duelReports(tick), matchOver: false });
    this.encounters = stepped.state;
    for (const event of stepped.events) this.apply(event);
    this.closeShownDuels(tick);
  }

  /** Settled duels whose result has been shown long enough leave their fighters' views. */
  private closeShownDuels(tick: number): void {
    for (const duel of [...this.seaDuels.values()]) if (duel.removeAfterTick !== undefined && tick > duel.removeAfterTick) this.closeSeaDuel(duel);
  }

  /**
   * The reports for this tick. A fight that ended since the last tick is reported to the ledger (unless a player's
   * leaving already decided it there) and its end to the rules, as the ledger recorded it. A duel the ledger has
   * settled (at once for a draw, a cancellation or a win with nothing to steal; otherwise at the winner's choice or the
   * deadline's default) gets its `settled` report, never before: only then do its players return.
   */
  private duelReports(tick: number): DuelReport[] {
    const reports: DuelReport[] = [];
    for (const duel of this.seaDuels.values()) {
      const outcome = duel.machine.outcome;
      if (outcome !== undefined && !duel.ended) {
        duel.ended = true;
        if (findDuel(this.ledger, duel.id)?.phase === "fighting") {
          const winner = outcome.winner === null ? null : duel.players[outcome.winner];
          // §12: both fighters forfeiting on the same frame cancels; a double KO or an exact tie is a draw.
          const result = winner !== null ? "win" : outcome.reason === "forfeit" || outcome.reason === "cancelled" ? "cancelled" : "draw";
          this.ledgerStep("reportDuelResult", reportDuelResult(this.ledger, { duelId: duel.id, tick, outcome: result, ...(winner !== null ? { winner } : {}) }));
        }
        if (!duel.endedByRules) reports.push(this.endReport(duel, tick));
      }
      if (!duel.ended || duel.settled) continue;
      const settled = findDuel(this.ledger, duel.id);
      if (settled === undefined || settled.phase === "settled") {
        duel.settled = true;
        const endTick = this.encounters.duels.find((each) => each.id === duel.id)?.end?.tick ?? tick;
        reports.push({ kind: "settled", duelId: duel.id, tick: Math.min(tick, Math.max(endTick, settled?.settlement?.tick ?? tick)) });
      }
    }
    return reports;
  }

  /** The end report of a fight, as the ledger recorded its result (a quit may have decided it there first). */
  private endReport(duel: SeaDuel, tick: number): DuelReport {
    const result = findDuel(this.ledger, duel.id)?.result;
    if (result?.outcome === "win" && result.winner !== null) return { kind: "end", duelId: duel.id, tick, outcome: "win", winner: result.winner };
    if (result !== null && result !== undefined) return { kind: "end", duelId: duel.id, tick, outcome: result.outcome === "draw" ? "draw" : "cancelled" };
    const outcome = duel.machine.outcome!;
    if (outcome.winner !== null) return { kind: "end", duelId: duel.id, tick, outcome: "win", winner: duel.players[outcome.winner] };
    return { kind: "end", duelId: duel.id, tick, outcome: outcome.reason === "forfeit" || outcome.reason === "cancelled" ? "cancelled" : "draw" };
  }

  private apply(event: EncounterEvent): void {
    switch (event.kind) {
      case "duel-reserved":
        this.ledgerStep("reserveDuel", reserveDuel(this.ledger, { duelId: event.duelId, players: event.players, tick: event.tick }));
        this.openSeaDuel(event.duelId, event.players, event.x, event.y, event.tick);
        return;
      case "duel-started":
        this.seaDuels.get(event.duelId)?.machine.start();
        return;
      case "duel-forfeited":
      case "duel-cancelled": {
        const duel = this.seaDuels.get(event.duelId);
        if (findDuel(this.ledger, event.duelId)?.phase === "fighting") {
          const report = event.kind === "duel-cancelled" ? { outcome: "cancelled" as const } : { outcome: "win" as const, winner: event.winner };
          this.ledgerStep("reportDuelResult", reportDuelResult(this.ledger, { duelId: event.duelId, tick: event.tick, ...report }));
        }
        if (duel === undefined) return;
        duel.endedByRules = true;
        duel.ended = true;
        if (event.kind === "duel-cancelled") duel.machine.end(null, "cancelled");
        else duel.machine.end(duel.players.indexOf(event.winner) as PlayerIndex, "forfeit");
        return;
      }
      case "duel-settled": {
        const duel = this.seaDuels.get(event.duelId);
        if (duel === undefined) return;
        duel.removeAfterTick = event.tick + DUEL_RESULT_TICKS;
        this.state.markers.delete(duel.key);
        return;
      }
      case "player-returned":
      case "player-respawned":
        if (!this.simulation.ships.some((ship) => ship.id === event.playerId)) return;
        this.simulation = returnShip(this.config, this.simulation, event.playerId, {
          x: event.x,
          y: event.y,
          dock: event.kind === "player-respawned" ? (event.dockId ?? NOT_DOCKED) : NOT_DOCKED,
        });
        return;
      case "report-refused":
        this.refusedReports++;
        return;
      default:
        // Attempts, protection and the loser's wait are mirrored from the rules' state.
        return;
    }
  }

  /** A grapple landed: both ships stop, and their duel's countdown starts, in its lobby and marker. */
  private openSeaDuel(id: string, players: readonly [string, string], x: number, y: number, tick: number): void {
    // A winner who attacks again while the last result is still showing: that lobby goes now.
    for (const duel of [...this.seaDuels.values()]) if (duel.players.some((player) => players.includes(player))) this.closeSeaDuel(duel);
    for (const player of players) if (this.simulation.ships.some((ship) => ship.id === player)) this.simulation = stopShip(this.simulation, player);
    const key = `d${this.nextDuelKey++}`;
    const lobby = new SeaDuelSchema();
    lobby.code = this.state.code;
    lobby.practice = false;
    this.state.duels.set(key, lobby);
    const machine = new DuelMachine({
      lobby,
      seed: this.seedOf(`duel:${++this.duelsOpened}`),
      // §9: each fighter's kit, the fruit they ate or the Duelist, fixed in the duel's frame-0 state.
      kits: [kitOf(this.fruits, players[0]), kitOf(this.fruits, players[1])],
      start: "called",
      send: (sessionId, type, message) => this.clients.get(sessionId)?.send(type, message),
    });
    players.forEach((player, slot) => {
      machine.addSeat(player, slot as PlayerIndex);
      if (this.clients.get(player) === undefined) machine.drop(player);
    });
    // A player grappled while away counts as away from the duel from its start.
    for (const player of players) {
      const away = this.away.get(player);
      if (away !== undefined) away.duelAbsentSince = tick;
    }
    machine.beginCountdown();
    const marker = new DuelMarkerSchema();
    marker.x = x;
    marker.y = y;
    marker.startTick = tick;
    this.state.markers.set(key, marker);
    this.seaDuels.set(id, { id, key, players, lobby, machine, endedByRules: false, ended: false, settled: false, removeAfterTick: undefined });
  }

  /**
   * §4 and §12's holds, one world tick: a connected player moored at a dock, out of any duel and holding E works on
   * E's target there (`interactTarget`). The same target as their hold continues it; another starts a new hold from
   * zero; no E, no mooring or no target cancels it (the ledger's rule: progress resets). Starting one ends protection
   * on the next tick.
   */
  private stepChannels(frame: number, tick: number): void {
    const held = this.heldPlayers();
    const ships = new Map(this.simulation.ships.map((ship) => [ship.id, ship]));
    for (const player of this.ledger.players) {
      if (player.status !== "connected") continue;
      const id = player.id;
      const ship = ships.get(id);
      const gate = this.gates.get(id);
      const holding =
        ship !== undefined && gate !== undefined && ship.dock !== NOT_DOCKED && !held.has(id) && !gate.lapsedAt(frame) && (gate.inputAt(frame).buttons & INTERACT_BUTTON) !== 0;
      const target = holding ? interactTarget(this.ledger, this.config.map, id, ship.dock) : undefined;
      if (target === undefined) {
        if (player.channel !== null) this.ledgerStep("cancelChannel", cancelChannel(this.ledger, { playerId: id, tick }));
        continue;
      }
      if (sameTarget(player.channel, target)) {
        const result = this.ledgerStep("progressChannel", progressChannel(this.ledger, { playerId: id, tick }));
        if (result.status === "collected" || result.status === "claimed" || result.status === "failed") {
          const notice = this.noticesOf(id);
          notice.channelResult = result.status === "failed" ? `failed:${result.failure}` : `${result.status}:${target.type}`;
          notice.channelResultAt = tick;
        }
        continue;
      }
      const started =
        target.kind === "collect"
          ? this.ledgerStep("startCollect", startCollect(this.ledger, { playerId: id, sourceId: target.sourceId, tick }))
          : this.ledgerStep("startCacheClaim", startCacheClaim(this.ledger, { playerId: id, cacheId: target.cacheId, rubbingId: target.rubbingId, tick }));
      if (started.ok && !this.protectionEndedNext.has(id)) this.protectionEndedNext.set(id, "collection");
    }
  }

  /**
   * §9's eating, one world tick, after the encounters (so a reservation accepted on this tick interrupts it) and before
   * the ledger's holds and the claim: every player in the match, at the pedestal of the dock their ship is moored at
   * (unless waiting out of the world to respawn), holding F, reserved for a duel, disconnected (a drop cancels the
   * channel, §12). The fruit rules alone decide who eats; each player's last result goes to their notices.
   */
  private stepFruits(frame: number, tick: number): void {
    const ships = new Map(this.simulation.ships.map((ship) => [ship.id, ship]));
    const waiting = new Set(this.encounters.players.filter((player) => player.respawn !== null).map((player) => player.id));
    const players: FruitPlayer[] = [];
    for (const player of this.ledger.players) {
      if (player.status === "left") continue;
      const id = player.id;
      // Every player in the ledger's match has a ship and an input gate (the room's invariant).
      const ship = ships.get(id)!;
      const gate = this.gates.get(id)!;
      players.push({
        playerId: id,
        pedestalId: waiting.has(id) ? null : (pedestalAtDock(this.pedestals, ship.dock)?.id ?? null),
        // A lapsed input is neutral (§12), so a stalled client holds nothing.
        holding: (gate.inputAt(frame).buttons & FRUIT_BUTTON) !== 0,
        reserved: duelOf(this.encounters, id) !== undefined,
        disconnected: player.status === "disconnected",
        left: false,
      });
    }
    const stepped = stepFruits(this.fruitConfig, this.fruits, { tick, players });
    this.fruits = stepped.state;
    for (const result of stepped.results) this.noteFruitResult(result);
  }

  /** A fruit result in its player's notices, for their panel: what ended their last attempt, or the meal. */
  private noteFruitResult(result: FruitResult): void {
    // Only a tick not later than the state's is rejected, and the room steps every world tick once.
    if (result.kind === "tick-rejected") return;
    // F still held at the pedestal the player has just emptied: the meal stays their last result, not a refusal.
    if (result.kind === "eat-refused" && this.fruits.meals.some((meal) => meal.playerId === result.playerId && meal.pedestalId === result.pedestalId)) return;
    const notice = this.noticesOf(result.playerId);
    notice.fruitResultAt = result.tick;
    if (result.kind === "eat-started") notice.fruitResult = "";
    else if (result.kind === "eat-completed") notice.fruitResult = `eaten:${result.kit}`;
    else notice.fruitResult = `${result.kind === "eat-refused" ? "refused" : "interrupted"}:${result.reason}`;
  }

  /**
   * §5's claim channel, one world tick, after the encounters (so a reservation accepted on this tick resets a channel
   * first) and the ledger's holds: every ship whose player is in the match, whether it holds every type (the ledger),
   * holds E, is connected and protected, and every duel the encounter rules hold reserved. Returns the claim's
   * `match-ended`, for the flow's step on the same tick.
   */
  private stepClaim(frame: number, tick: number): FlowReport | undefined {
    if (this.claimConfig === undefined || this.claim === undefined) return undefined;
    const held = this.heldPlayers();
    const records = new Map(this.encounters.players.map((player) => [player.id, player]));
    const players: ClaimPlayer[] = [];
    for (const ship of this.simulation.ships) {
      const player = findPlayer(this.ledger, ship.id);
      if (player === undefined || player.status === "left") continue;
      const gate = this.gates.get(ship.id);
      players.push({
        id: ship.id,
        x: ship.x,
        y: ship.y,
        speed: ship.speed,
        holdsAllTypes: holdsAllTypes(this.ledger, ship.id),
        interact: !held.has(ship.id) && gate !== undefined && !gate.lapsedAt(frame) && (gate.inputAt(frame).buttons & INTERACT_BUTTON) !== 0,
        connected: player.status === "connected" && this.clients.get(ship.id) !== undefined,
        protected: (records.get(ship.id)?.protection ?? null) !== null,
      });
    }
    const encounters = this.encounters.duels.map((duel) => ({ id: duel.id, playerIds: duel.players }));
    const stepped = stepClaim(this.claimConfig, this.claim, { tick, players, encounters });
    this.claim = stepped.state;
    let end: FlowReport | undefined;
    for (const event of stepped.events) end = this.applyClaimEvent(event) ?? end;
    return end;
  }

  private applyClaimEvent(event: ClaimEvent): FlowReport | undefined {
    switch (event.kind) {
      case "claim-interrupted": {
        const notice = this.noticesOf(event.playerId);
        notice.claimInterrupt = event.reason;
        notice.claimInterruptAt = event.tick;
        return undefined;
      }
      case "claim-started":
        this.noticesOf(event.playerId).claimInterrupt = "";
        return undefined;
      case "protection-ended":
        // §6: claiming ends protection; the encounter rules hear it on the next tick.
        this.protectionEndedNext.set(event.playerId, "claim");
        return undefined;
      case "match-ended":
        return { kind: "match-ended", tick: event.tick, reason: event.reason, winner: event.winner };
      default:
        // `claim-completed` shows in the results; `duel-ended-without-theft` is applied when the match ends.
        return undefined;
    }
  }

  /**
   * The accomplishments of this tick (§2's results), read from the ledger, which alone moves rubbings and gold: each
   * rubbing that changed hands since the last tick (from a source: collected; from a cache: a cache claimed; from one
   * player to another: a theft and a loss; from a player into a cache: a loss), each balance that changed, and each
   * island a player first moors at.
   */
  private reportAccomplishments(_tick: number): void {
    // Unknown ids are dropped with every other report's, before the flow's step (`knownFlowReports`).
    const report = (entry: FlowReport) => this.flowReports.push(entry);
    for (const rubbing of this.ledger.rubbings) {
      const before = this.lastLocations.get(rubbing.id);
      this.lastLocations.set(rubbing.id, rubbing.location);
      // The first tick in play only records where each rubbing is.
      if (before === undefined) continue;
      const from = holderOf(before);
      const to = holderOf(rubbing.location);
      if (from === to) continue;
      if (from === undefined && to !== undefined) {
        if (before.kind === "source") report({ kind: "collected", playerId: to });
        else if (before.kind === "cache") report({ kind: "cache-claimed", playerId: to });
      } else if (from !== undefined && to !== undefined) {
        report({ kind: "stole", playerId: to });
        report({ kind: "lost", playerId: from });
      } else if (from !== undefined) {
        report({ kind: "lost", playerId: from });
      }
    }
    for (const player of this.ledger.players) {
      if (this.reportedGold.get(player.id) === player.gold) continue;
      this.reportedGold.set(player.id, player.gold);
      report({ kind: "gold", playerId: player.id, gold: player.gold });
    }
    for (const ship of this.simulation.ships) {
      const island = ship.dock === NOT_DOCKED ? -1 : (this.config.map.docks[ship.dock]?.island ?? -1);
      if (island < 0 || this.visited.has(`${ship.id}:${island}`)) continue;
      this.visited.add(`${ship.id}:${island}`);
      report({ kind: "island-visited", playerId: ship.id, island: String(island) });
    }
  }

  /**
   * §2's match flow, one world tick: the joins, leaves and start requests since the last tick, this tick's
   * accomplishments and the claim's end, in that order. Reports naming a player the flow does not know are dropped
   * first (`knownFlowReports`: the match module throws on them), and counted for tests.
   */
  private stepFlow(tick: number, claimEnd?: FlowReport): void {
    const reports = this.flowReports;
    this.flowReports = [];
    if (claimEnd !== undefined) reports.push(claimEnd);
    this.stepFlowWith(tick, reports);
  }

  private stepFlowWith(tick: number, reports: readonly FlowReport[]): void {
    const known = knownFlowReports(this.flow.players, reports);
    this.droppedReports.push(...known.dropped);
    const stepped = stepMatch(this.flowConfig, this.flow, { tick, reports: known.reports });
    this.flow = stepped.state;
    for (const event of stepped.events) this.applyFlowEvent(event);
  }

  private applyFlowEvent(event: FlowEvent): void {
    switch (event.kind) {
      case "start-refused":
        this.clients.get(event.playerId)?.send(MatchMessageType.StartRefused, { reason: event.reason } satisfies StartRefusedMessage);
        return;
      // No `join-refused`: the room reports a join only in the lobby (onJoin refuses one after it), before any start
      // in the same step, and seats no more players than the flow has seats (docs/match-online-coverage.md).
      case "phase-changed":
        // §2: once the ready countdown starts, admission refuses late arrivals; back in the lobby, it admits again.
        if (event.to === "ready" || event.to === "lobby") void this.setMatchmaking({ metadata: { code: this.state.code, custom: privateMatch.custom, started: event.to === "ready" } });
        return;
      case "control-started":
        this.startControl(event.tick);
        return;
      case "match-ended":
        this.endMatch(event.results);
        return;
      default:
        return;
    }
  }

  /**
   * §2's control start: every ship present gets the encounter rules' departure protection from this tick, the claim
   * config's deadline counts from it (the timer's end), and the reveals' clocks start. The accomplishments start from
   * the first tick in play, which records where each rubbing is and each balance (the starting gold).
   */
  private startControl(tick: number): void {
    // Every ship's player is in the match (the room's invariant): a leave removes the ship at once.
    const ids = this.simulation.ships.map((ship) => ship.id);
    this.encounters = createEncounterState(this.encounterConfig, { tick, spawnProtected: ids });
    this.claimConfig = claimConfigFor(this.tuning, this.finalIsland.claimPoint, tick, this.config.map);
    this.claim = createClaimState(this.claimConfig, tick);
    this.intelConfig = intelConfigFor(this.tuning, this.finalIsland.claimPoint, tick, this.config.map);
    this.intel = createIntelState(this.intelConfig, this.seedOf("intel"), tick - 1);
  }

  /**
   * The match is over (§2, §5): outcomes freeze. A duel still running ends without theft (§2), each fighter's lobby
   * showing the cancellation for a moment; the ships stop taking input; the results are the flow's, recorded once.
   */
  private endMatch(results: MatchResults): void {
    const tick = results.tick;
    for (const duel of this.seaDuels.values()) {
      if (findDuel(this.ledger, duel.id)?.phase === "fighting" && tick >= this.ledger.tick) {
        this.ledgerStep("reportDuelResult", reportDuelResult(this.ledger, { duelId: duel.id, tick, outcome: "cancelled" }));
      }
      if (duel.machine.outcome === undefined) duel.machine.end(null, "cancelled");
      duel.ended = true;
      duel.endedByRules = true;
      duel.removeAfterTick ??= tick + DUEL_RESULT_TICKS;
      this.state.markers.delete(duel.key);
    }
    recordOutcome({ code: this.state.code, results });
    console.log(`match ${this.state.code} ended at tick ${tick}: ${results.reason}${results.winner === null ? ", no winner" : `, won by ${results.winner}`}`);
  }

  /**
   * §2, §3, §5 and §11's intel, one world tick after the flow and after every other ledger operation of the tick: the
   * targeted rumor requests taken for this tick, then `stepIntel` over the ledger's rubbings and the ships, then each
   * delivered purchase charged. Every message goes to exactly its recipients (§16): the reveals as `reveal` messages
   * (the final island's sector to everyone, its exact claim point only to a full-set holder), every lead as a `journal`
   * message to its one player, whose journal log records it.
   *
   * A purchase (§11, `docs/architecture.md`): at most one request per player per tick, oldest first; refused, charging
   * nothing, unless the buyer's ship is moored at a dock on this tick, the ledger has them connected, out of any duel
   * and with the rumor's price, and `targetedRumorAvailability` offers a lead. Then `stepIntel` decides it under a
   * room-namespaced id; only a delivered lead is charged, with the ledger's `purchase` under the client's id. Nothing
   * moves that player's gold between the check and the charge, so a refused charge is a broken invariant: it throws,
   * and the match faults (§12). Every other outcome is one recorded refusal carrying intel's reason.
   */
  private stepReveals(tick: number): void {
    if (this.intelConfig === undefined || this.intel === undefined) return;
    const config = this.intelConfig;
    const view = this.intelView(tick);
    const taken = new Map<string, { readonly playerId: string; readonly request: PendingRumor }>();
    const requests: TargetedRumorRequest[] = [];
    for (const playerId of this.rumors.waiting()) {
      const request = this.rumors.take(playerId)!;
      const refusal = this.rumorRefusal(config, this.intel, view, playerId, request);
      if (refusal !== undefined) {
        this.decideRumor(playerId, request, { outcome: "refused", type: request.type, reason: refusal });
        continue;
      }
      const requestId = intelRequestId(playerId, request.requestId);
      taken.set(requestId, { playerId, request });
      requests.push({ requestId, playerId, type: request.type });
    }
    const stepped = stepIntel(config, this.intel, view, requests);
    this.intel = stepped.state;
    const leads = new Map<string, JournalMessage[]>();
    for (const { to, body } of stepped.messages) {
      const delivered = intelMessageOf(body);
      const recipients = revealRecipients(to, [...this.clients].map((client) => client.sessionId));
      if (delivered.channel === "journal") {
        for (const id of recipients) {
          this.journal.record(id, delivered.message);
          leads.set(id, [...(leads.get(id) ?? []), delivered.message]);
          this.clients.get(id)?.send(JournalMessageType.Lead, delivered.message);
        }
        continue;
      }
      const reveal = delivered.message;
      if (reveal.kind === "final-sector") {
        this.state.finalSector = reveal.name;
        this.state.finalSectorIndex = reveal.sector;
      }
      for (const id of recipients) {
        if (reveal.kind === "final-route") this.routes.set(id, { active: true, x: reveal.x, y: reveal.y });
        if (reveal.kind === "final-route-inactive") {
          const route = this.routes.get(id);
          if (route !== undefined) route.active = false;
        }
        this.clients.get(id)?.send(MatchMessageType.Reveal, reveal);
      }
    }
    for (const outcome of stepped.outcomes) {
      const { playerId, request } = taken.get(outcome.requestId)!;
      if (outcome.result !== "rumor" && outcome.result !== "sighting") {
        // The one branch for every outcome that delivers nothing (covered, capped, none, duplicate): no charge.
        this.decideRumor(playerId, request, { outcome: "refused", type: request.type, reason: outcome.result });
        continue;
      }
      const charged = chargeRumor(this.ledger, playerId, request.requestId, tick);
      this.ledger = charged.state;
      this.decideRumor(playerId, request, { outcome: "bought", type: request.type, price: charged.price, lead: boughtLead(leads.get(playerId)!, request.type)! });
    }
    for (const player of this.ledger.players) {
      if (player.status === "left") continue;
      const held = heldTypes(this.ledger, player.id);
      const offers = config.types.filter((type) => !held.includes(type)).map((type) => {
        const offer = targetedRumorAvailability(config, this.intel!, view, player.id, type);
        return `${type}:${offer === "rumor" || offer === "sighting" ? "available" : offer === "covered" ? "covered" : "none"}`;
      });
      this.rumorOffers.set(player.id, offers.join(","));
    }
  }

  /**
   * Why a targeted rumor request taken on this tick is refused before it reaches `stepIntel`, or undefined: in order,
   * (a) the buyer's ship is not moored at a dock now (or waits out of the world to respawn); (b) the ledger has them
   * disconnected, in a duel (fighting or in its choice window), or short of the rumor's price; (c) there is no lead to
   * sell (`targetedRumorAvailability`: covered, capped or none). A request waits only while its player is in the match.
   */
  private rumorRefusal(config: IntelConfig, intel: IntelState, view: IntelWorldView, playerId: string, request: PendingRumor): RumorRefusalName | undefined {
    const ship = this.simulation.ships.find((each) => each.id === playerId)!;
    const waiting = this.encounters.players.find((each) => each.id === playerId)?.respawn != null;
    if (ship.dock === NOT_DOCKED || waiting) return "not-at-dock";
    const player = findPlayer(this.ledger, playerId)!;
    if (player.status === "disconnected") return "player-disconnected";
    if (activeDuelOf(this.ledger, playerId) !== undefined) return "player-in-duel";
    if (player.gold < itemPrice(this.ledger.rules, "rumor")) return "insufficient-gold";
    const offer = targetedRumorAvailability(config, intel, view, playerId, request.type);
    return offer === "rumor" || offer === "sighting" ? undefined : offer;
  }

  /** A purchase request decided: kept for replays, and answered to its player (a bought lead was just delivered). */
  private decideRumor(playerId: string, request: PendingRumor, decision: RumorDecision): void {
    this.rumors.decide(playerId, request.requestId, decision);
    this.clients.get(playerId)?.send(JournalMessageType.RumorResult, rumorResult(request.requestId, decision, false));
  }

  /**
   * §11: a player asks for a targeted rumor. Rate-capped and validated. A request id the room already decided for this
   * player is answered from its record first, whatever else holds now: a bought one resends its lead, a refused one the
   * same refusal. Otherwise, while the match runs, it waits for a world tick: merged into a pending request with its
   * id, or refused `busy` when two already wait.
   */
  private receiveBuyRumor(sessionId: string, message: unknown): void {
    const frame = this.simulation.frame;
    const rate = this.rumorRate.get(sessionId) ?? { windowStart: frame, count: 0 };
    if (frame - rate.windowStart >= STEPS_PER_SECOND) {
      rate.windowStart = frame;
      rate.count = 0;
    }
    rate.count++;
    this.rumorRate.set(sessionId, rate);
    if (rate.count > MAX_BUY_RUMOR_PER_SECOND) return;
    const request = validateBuyRumorMessage(message);
    if (request !== undefined) this.arriveRumor(sessionId, request);
  }

  private arriveRumor(sessionId: string, request: BuyRumorMessage): void {
    const client = this.clients.get(sessionId);
    const earlier = this.rumors.decided(sessionId, request.requestId);
    if (earlier !== undefined) {
      if (earlier.outcome === "bought") client?.send(JournalMessageType.Lead, earlier.lead);
      client?.send(JournalMessageType.RumorResult, rumorResult(request.requestId, earlier, true));
      return;
    }
    if (!this.inPlay()) {
      client?.send(JournalMessageType.RumorResult, rumorResult(request.requestId, { outcome: "refused", type: request.type, reason: "not-in-play" }, false));
      return;
    }
    const arrival = this.rumors.arrive(sessionId, request);
    if (arrival === "busy") client?.send(JournalMessageType.RumorResult, rumorResult(request.requestId, { outcome: "refused", type: request.type, reason: "busy" }, false));
  }

  /**
   * The world as the intel module reads it: every player in the match at their ship, and every rubbing where the
   * ledger has it. A player who left while a duel still reserves their rubbings stays in the view, at the position
   * they left from, until that duel settles.
   */
  private intelView(tick: number): IntelWorldView {
    const ships = new Map(this.simulation.ships.map((ship) => [ship.id, ship]));
    const holding = new Set(this.ledger.rubbings.flatMap((rubbing) => (rubbing.location.kind === "duel" ? [rubbing.location.playerId] : [])));
    const players = this.ledger.players.flatMap((player) => {
      const ship = ships.get(player.id);
      if (player.status !== "left" && ship !== undefined) return [{ id: player.id, x: ship.x, y: ship.y }];
      if (holding.has(player.id)) return [{ id: player.id, x: player.exit?.x ?? 0, y: player.exit?.y ?? 0 }];
      return [];
    });
    const rubbings: IntelRubbing[] = this.ledger.rubbings.map((rubbing) => {
      const location = rubbing.location;
      switch (location.kind) {
        case "source": {
          const source = this.ledger.sources.find((each) => each.id === location.sourceId)!;
          return { id: rubbing.id, type: rubbing.type, place: { kind: "source", island: source.island, x: source.x, y: source.y } };
        }
        case "cache": {
          const cache = this.ledger.caches.find((each) => each.id === location.cacheId)!;
          return { id: rubbing.id, type: rubbing.type, place: { kind: "cache", x: cache.x, y: cache.y } };
        }
        case "player":
          return { id: rubbing.id, type: rubbing.type, place: { kind: "carried", playerId: location.playerId } };
        case "duel":
          return { id: rubbing.id, type: rubbing.type, place: { kind: "duel", playerId: location.playerId } };
      }
    });
    return { tick, players, rubbings };
  }

  /** §12's server fault: a world tick threw. The match is aborted with no winner and no competitive penalty. */
  private fault(tick: number, error: unknown): void {
    console.error(`match ${this.state.code} fault at world tick ${tick} (aborting):`, error);
    if (this.flow.end !== null) return;
    this.flowReports = [];
    this.stepFlowWith(Math.max(tick, this.flow.tick + 1), [{ kind: "fault" }]);
  }

  /** The private host's start request (§2): rate-capped and validated, then judged by the flow on the next tick. */
  private receiveStart(sessionId: string, message: unknown): void {
    const frame = this.simulation.frame;
    const rate = this.startRate.get(sessionId) ?? { windowStart: frame, count: 0 };
    if (frame - rate.windowStart >= STEPS_PER_SECOND) {
      rate.windowStart = frame;
      rate.count = 0;
    }
    rate.count++;
    this.startRate.set(sessionId, rate);
    if (rate.count > MAX_START_MATCH_PER_SECOND) return;
    if (validateStartMatchMessage(message) === undefined) return;
    // Only a seated player sends messages (onJoin adds them to the ledger and the flow's reports first).
    this.flowReports.push({ kind: "start", playerId: sessionId });
  }

  /** Every player gone: a match that left its lobby ends abandoned (§12), stepped once more before the room closes. */
  override onDispose(): void {
    if (this.flow.end !== null || this.flowReports.length === 0) return;
    const tick = Math.max(this.simulation.worldTick + 1, this.flow.tick + 1);
    // The leavers' rubbings went into caches since the last tick: those losses count before the end.
    if (this.inPlay()) this.reportAccomplishments(tick);
    const reports = this.flowReports;
    this.flowReports = [];
    this.stepFlowWith(tick, reports);
  }

  /** A player's seat: their join order in the flow, from 1 (0 before the flow has seen them join). */
  seatOf(id: string): number {
    const player = this.flow.players.find((each) => each.id === id);
    return player === undefined ? 0 : player.order + 1;
  }

  /** A system's seed, derived from the match's master secret (`deriveSeed`). */
  private seedOf(system: SeedSystem): number {
    return deriveSeed(this.secret, system);
  }

  private requireTestHooks(): void {
    if (!this.tuning.testHooks) throw new Error("the room's test hooks are off (MatchTuning.testHooks)");
  }

  /** Test-only (`testHooks`): the next world tick throws inside the room, as a server fault would (§12: aborted). */
  injectFault(): void {
    this.requireTestHooks();
    this.faultNext = true;
  }

  /**
   * Test-only (`testHooks`): the room's clock stops right after world tick `tick` (patches still go out, messages are
   * still received) until `resumeWorld`, so a test can line an input up with an exact tick.
   */
  pauseAfterTick(tick: number): void {
    this.requireTestHooks();
    this.pauseAt = tick;
  }

  resumeWorld(): void {
    this.requireTestHooks();
    this.paused = false;
  }

  /**
   * Test-only (`testHooks`): reports for the flow's next step, as if the room had made them, so a test can show what
   * the room does with a report naming a player the flow does not know.
   */
  injectFlowReports(reports: readonly FlowReport[]): void {
    this.requireTestHooks();
    this.flowReports.push(...reports);
  }

  /**
   * Test-only (`testHooks`): a targeted rumor request as if it had just arrived from this player (past the rate cap),
   * so a test can line several up for one exact tick while the clock is paused.
   */
  testBuyRumor(sessionId: string, message: BuyRumorMessage): void {
    this.requireTestHooks();
    this.arriveRumor(sessionId, message);
  }

  /** Test-only (`testHooks`): while the clock is paused, runs it for exactly `ticks` world ticks, then holds it again. */
  stepWorldTicks(ticks: number): void {
    this.requireTestHooks();
    if (!this.paused) throw new Error("stepWorldTicks needs the world paused (pauseAfterTick)");
    const target = this.simulation.worldTick + ticks;
    while (this.simulation.worldTick < target) this.stepFrame();
  }

  /** The targeted rumor requests waiting for a world tick, per player, for tests. */
  pendingRumors(sessionId: string): number {
    return this.rumors.pendingCount(sessionId);
  }

  /** A player's journal log as the room keeps it, for tests. */
  journalOf(sessionId: string): readonly JournalEntry[] {
    return this.journal.entries(sessionId);
  }

  /** Reports dropped before the flow's step for naming an unknown player, for tests. */
  get droppedFlowReports(): readonly FlowReport[] {
    return this.droppedReports;
  }

  /** Whether the test-only pause holds the clock now. */
  get worldPaused(): boolean {
    return this.paused;
  }

  /** The match flow's state (phase, host, control start, end, results), for tests. */
  get flowState(): FlowState {
    return this.flow;
  }

  /** The claim config once control has started (its deadline is the timer's end), for tests. */
  get claimConfiguration(): ClaimConfig | undefined {
    return this.claimConfig;
  }

  /** The claim channel's state once control has started, for tests. */
  get claimState(): ClaimState | undefined {
    return this.claim;
  }

  /** The intel module's state once control has started, for tests. */
  get intelState(): IntelState | undefined {
    return this.intel;
  }

  /** The final island this match's secret picked, for tests (never synced to everyone). */
  get finalIslandChoice(): { readonly socket: number; readonly claimPoint: ClaimPoint } {
    return this.finalIsland;
  }

  /** The derived seeds of the systems seeded so far, for tests: each differs, and none reads the match code. */
  derivedSeeds(): Record<"world" | "ledger" | "final-socket" | "intel" | "ruins" | "fruit", number> {
    return {
      world: this.seedOf("world"),
      ledger: this.seedOf("ledger"),
      "final-socket": this.seedOf("final-socket"),
      intel: this.seedOf("intel"),
      ruins: this.seedOf("ruins"),
      fruit: this.seedOf("fruit"),
    };
  }

  /** The fruit rules' state (secret: it holds the deal), for tests. */
  get fruitState(): FruitState {
    return this.fruits;
  }

  /** The pedestals' sites, for tests. */
  get pedestalSites(): readonly PedestalSite[] {
    return this.pedestals;
  }

  /** The ruins' state (secret: it holds the answers), for tests. */
  get ruinsState(): RuinsState {
    return this.ruins;
  }

  /** §4's theft choice from a client: the winner of a duel at sea, in its window, for an eligible type. */
  private receiveTheftChoice(sessionId: string, message: unknown): void {
    const frame = this.simulation.frame;
    const rate = this.choiceRate.get(sessionId) ?? { windowStart: frame, count: 0 };
    if (frame - rate.windowStart >= STEPS_PER_SECOND) {
      rate.windowStart = frame;
      rate.count = 0;
    }
    rate.count++;
    this.choiceRate.set(sessionId, rate);
    if (rate.count > MAX_CHOOSE_THEFT_PER_SECOND) return;
    const choice = validateChooseTheftMessage(message);
    if (choice === undefined) return;
    const duel = [...this.seaDuels.values()].find((each) => each.key === choice.duel && each.players.includes(sessionId));
    if (duel === undefined) return;
    // The ledger checks that this player won, the window is open and the type is eligible; otherwise nothing changes.
    const stepped = chooseTheft(this.ledger, { duelId: duel.id, playerId: sessionId, type: choice.type, tick: this.simulation.worldTick });
    this.ledger = stepped.state;
    this.noteSettlements();
  }

  /** A session's fruit inspections this second: false once over the cap. */
  private withinFruitRate(sessionId: string): boolean {
    const frame = this.simulation.frame;
    const rate = this.fruitRate.get(sessionId) ?? { windowStart: frame, count: 0 };
    if (frame - rate.windowStart >= STEPS_PER_SECOND) {
      rate.windowStart = frame;
      rate.count = 0;
    }
    rate.count++;
    this.fruitRate.set(sessionId, rate);
    return rate.count <= MAX_INSPECT_FRUIT_PER_SECOND;
  }

  /**
   * §9: a player moored at a pedestal's dock inspects it (F). While the match runs, rate-capped and validated; a player
   * in a duel or waiting to respawn inspects nothing. The pedestal's kit and description, or that it is empty, go to
   * this player only (§16): the deal is hidden information.
   */
  private receiveInspectFruit(sessionId: string, message: unknown): void {
    if (!this.withinFruitRate(sessionId) || validateInspectFruitMessage(message) === undefined || !this.inPlay() || this.heldPlayers().has(sessionId)) return;
    // At sea `dock` is NOT_DOCKED, where no pedestal stands.
    const dock = this.simulation.ships.find((ship) => ship.id === sessionId)?.dock ?? NOT_DOCKED;
    const site = pedestalAtDock(this.pedestals, dock);
    if (site === undefined) return;
    this.clients.get(sessionId)?.send(FruitMessageType.Inspected, inspectionOf(this.fruits, site));
  }

  /** A session's ruin messages this second, opens and answers together: false once over the cap. */
  private withinRuinRate(sessionId: string): boolean {
    const frame = this.simulation.frame;
    const rate = this.ruinRate.get(sessionId) ?? { windowStart: frame, count: 0 };
    if (frame - rate.windowStart >= STEPS_PER_SECOND) {
      rate.windowStart = frame;
      rate.count = 0;
    }
    rate.count++;
    this.ruinRate.set(sessionId, rate);
    return rate.count <= MAX_RUIN_MESSAGES_PER_SECOND;
  }

  /**
   * Where a player is, for the ruins (§3): the island whose dock they are moored at while connected and in the world
   * (not waiting to respawn), else nowhere; and whether a duel holds them (the rules close a session in a duel).
   */
  private syncRuinPresence(id: string): void {
    const ship = this.simulation.ships.find((each) => each.id === id);
    const connected = findPlayer(this.ledger, id)?.status === "connected";
    const inDuel = duelOf(this.encounters, id) !== undefined;
    const away = this.encounters.players.find((each) => each.id === id)?.respawn != null;
    // At sea `dock` is NOT_DOCKED, which is no island's dock.
    const island = ship !== undefined && connected && !away ? islandOfDock(this.config.map, ship.dock) : null;
    this.setRuinPresence(id, island, inDuel);
  }

  /** Where a player is, for the ruins; an unchanged report is the rules' duplicate, which changes nothing. */
  private setRuinPresence(id: string, island: number | null, inDuel: boolean): void {
    this.ruins = reportPresence(this.ruins, { playerId: id, island, inDuel, tick: this.simulation.worldTick }).state;
  }

  /**
   * §3: a player moored at an island opens its ruin (R). While the match runs, rate-capped and validated; the rules
   * check the mooring and the duel, and the clue goes to this player only (§16), never the answer.
   */
  private receiveOpenRuin(sessionId: string, message: unknown): void {
    if (!this.withinRuinRate(sessionId) || validateOpenRuinMessage(message) === undefined || !this.inPlay()) return;
    // Presence is current: every world tick in play reports it (a dropped player is no longer connected). At sea there
    // is no island, so no ruin to open: nothing is sent.
    const island = presenceOf(this.ruins, sessionId).island;
    if (island === null) return;
    const opened = openRuin(this.ruins, { playerId: sessionId, island, tick: this.simulation.worldTick });
    this.ruins = opened.state;
    const { clue, lockedUntil: until, solved } = opened.result;
    // A refused open has no clue, which the schema refuses; its strictness refuses any field beyond the site's clue, so
    // nothing else of the puzzle can ride along (§16).
    const sent = ruinClueMessageSchema.safeParse({ island, clue, lockedUntil: until, solved } satisfies Record<keyof RuinOpenedMessage, unknown>);
    if (sent.success) this.clients.get(sessionId)?.send(RuinMessageType.Clue, sent.data);
  }

  /**
   * An answer to the ruin a player has open: rate-capped and validated, then judged by the rules once per request id (a
   * retry gets the first verdict). A solve's events go to the ledger: the first solve unlocks the island's sources for
   * everyone, and every player's first solve mints the completion gold (`grantGold`, reason `ruin`, key the island).
   */
  private receiveAnswerRuin(sessionId: string, message: unknown): void {
    if (!this.withinRuinRate(sessionId)) return;
    const answer = validateAnswerRuinMessage(message);
    if (answer === undefined || !this.inPlay()) return;
    const earlier = this.ruinRequests.get(sessionId, answer.requestId);
    if (earlier !== undefined) {
      this.clients.get(sessionId)?.send(RuinMessageType.Result, earlier);
      return;
    }
    const island = presenceOf(this.ruins, sessionId).island;
    const tick = this.simulation.worldTick;
    // At sea there is no ruin to answer: refused as the rules would refuse any island the player is not at.
    const judged =
      island === null
        ? { state: this.ruins, result: { ok: false, rejection: "not-at-ruin", outcome: null, lockedUntil: 0, events: [] } as const }
        : answerRuin(this.ruins, { playerId: sessionId, island, tick, attempt: answer.attempt });
    this.ruins = judged.state;
    const { result } = judged;
    let gold = 0;
    for (const event of result.events) gold += this.applyRuinEvent(event);
    const verdict: RuinResultMessage = {
      requestId: answer.requestId,
      island: island ?? -1,
      outcome: result.outcome ?? "refused",
      reason: result.rejection,
      lockedUntil: result.lockedUntil,
      gold,
      unlocked: result.events.some((event) => event.kind === "sources-unlocked"),
    };
    this.ruinRequests.remember(sessionId, answer.requestId, verdict);
    this.clients.get(sessionId)?.send(RuinMessageType.Result, verdict);
  }

  /** A ruin event into the ledger; returns the gold it minted for the solver. */
  private applyRuinEvent(event: RuinEvent): number {
    if (event.kind === "sources-unlocked") {
      for (const sourceId of event.sourceIds) {
        // A test may have opened the island from the start: those sources are already unlocked.
        if (this.ledger.sources.find((source) => source.id === sourceId)?.unlocked === true) continue;
        this.ledgerStep("unlockSource", unlockSource(this.ledger, { sourceId, tick: event.tick }));
      }
      return 0;
    }
    const granted = this.ledgerStep("grantGold", grantGold(this.ledger, { playerId: event.playerId, reason: "ruin", sourceKey: String(event.island), tick: event.tick }));
    // The rules award a player's first solve only, and only a player in the match answers: the grant is never refused.
    return granted.grant?.amount ?? 0;
  }

  private noticesOf(id: string): Notices {
    let notices = this.notices.get(id);
    if (notices === undefined) {
      notices = {
        channelResult: "",
        channelResultAt: 0,
        settledRole: "",
        stolen: "",
        goldChange: 0,
        settledAt: 0,
        settledChoice: "",
        choiceDeadline: 0,
        claimInterrupt: "",
        claimInterruptAt: 0,
        fruitResult: "",
        fruitResultAt: 0,
      };
      this.notices.set(id, notices);
    }
    return notices;
  }

  /** Each newly settled ledger duel, in its players' notices: what was stolen and the gold that moved. */
  private noteSettlements(): void {
    for (const duel of this.ledger.duels) {
      if (duel.phase !== "settled" || this.noticed.has(duel.id)) continue;
      this.noticed.add(duel.id);
      this.noteSettlement(duel);
    }
  }

  private noteSettlement(duel: LedgerDuel): void {
    const settlement = duel.settlement!;
    const result = duel.result!;
    // §2's results count a settled win or draw for both fighters; a cancelled duel (both gone, or the match's end)
    // counts for neither. The rubbing and gold it moved are counted from the ledger with the tick's accomplishments.
    if (result.outcome !== "cancelled") this.flowReports.push({ kind: "duel-ended", playerIds: duel.players, winner: result.outcome === "win" ? result.winner : null });
    for (const id of duel.players) {
      const notice = this.noticesOf(id);
      notice.settledAt = settlement.tick;
      notice.stolen = settlement.stolenType ?? "";
      notice.settledChoice = settlement.choice;
      notice.choiceDeadline = duel.choiceDeadline ?? 0;
      if (result.outcome !== "win") {
        notice.settledRole = "draw";
        notice.goldChange = 0;
      } else {
        const winner = result.winner === id;
        notice.settledRole = winner ? "winner" : "loser";
        notice.goldChange = winner ? settlement.gold : -settlement.gold;
      }
    }
  }

  /**
   * After every world tick in development and tests: the ledger's own invariant, and the room's: every player the
   * ledger counts in the match has a ship, and every ship belongs to such a player.
   */
  private checkInvariants(tick: number): void {
    if (!this.tuning.checkInvariants) return;
    const problems = checkLedger(this.ledger);
    const ships = new Set(this.simulation.ships.map((ship) => ship.id));
    for (const player of this.ledger.players) {
      if (player.status !== "left" && !ships.has(player.id)) problems.push(`player ${player.id} is in the ledger's match without a ship`);
    }
    for (const id of ships) {
      const player = findPlayer(this.ledger, id);
      if (player === undefined || player.status === "left") problems.push(`ship ${id} has no player in the ledger's match`);
    }
    if (problems.length === 0) return;
    for (const problem of problems) this.violations.push(`tick ${tick}: ${problem}`);
    console.error(`match ${this.state.code} invariant violated at tick ${tick}: ${problems.join("; ")}`);
  }

  /** Copies the plain simulation state into the synced schema, then updates what each client may see. */
  private mirror(): void {
    this.state.frame = this.simulation.frame;
    this.state.worldTick = this.simulation.worldTick;
    this.state.players = this.simulation.ships.length;
    this.mirrorFlow();
    const present = new Set<string>();
    for (const ship of this.simulation.ships) {
      present.add(ship.id);
      let synced = this.state.ships.get(ship.id);
      if (synced === undefined) {
        synced = new ShipSchema();
        synced.id = ship.id;
        synced.slot = ship.slot;
        this.state.ships.set(ship.id, synced);
      }
      synced.x = ship.x;
      synced.y = ship.y;
      synced.heading = ship.heading;
      synced.speed = ship.speed;
      synced.dock = ship.dock;
      // §5: "warn nearby players": a ship channelling the claim shows it to whoever sees that ship.
      const channel = this.claim?.channel ?? null;
      synced.claiming = channel?.playerId === ship.id;
      synced.claimHeld = synced.claiming ? channel!.progress : 0;
    }
    for (const id of [...this.state.ships.keys()]) if (!present.has(id)) this.state.ships.delete(id);
    this.mirrorEncounters(present);
    this.mirrorObjectives(present);
    this.updateViews();
  }

  /**
   * §2's flow into the synced state, for everyone: the phase, the host, the players in the lobby, the ready countdown's
   * end, control start, the timer (`remaining`) and deadline, the final island's sector once announced (never its
   * position), and the results once the match has ended.
   */
  private mirrorFlow(): void {
    const flow = this.flow;
    this.state.phase = flow.phase;
    this.state.hostSeat = flow.host === null ? 0 : this.seatOf(flow.host);
    this.state.readyEndsAt = flow.readyTick === null ? 0 : flow.readyTick + this.flowConfig.readyTicks;
    this.state.controlStartTick = flow.controlStartTick ?? 0;
    this.state.deadlineTick = this.claimConfig?.deadlineTick ?? 0;
    this.state.remainingTicks = remaining(flow, flow.tick);
    const present = new Set<string>();
    for (const player of flow.players) {
      if (player.left) continue;
      const key = String(player.order + 1);
      present.add(key);
      if (!this.state.roster.has(key)) {
        const entry = new RosterEntrySchema();
        entry.seat = player.order + 1;
        this.state.roster.set(key, entry);
      }
    }
    for (const id of [...this.state.roster.keys()]) if (!present.has(id)) this.state.roster.delete(id);
    const results = flow.results;
    if (results !== null && this.state.endReason === "") {
      this.state.endReason = results.reason;
      this.state.winnerSeat = results.winner === null ? 0 : this.seatOf(results.winner);
      this.state.endTick = results.tick;
      this.state.elapsedTicks = results.elapsedTicks;
      for (const line of results.players) {
        const synced = new ResultLineSchema();
        synced.seat = this.seatOf(line.id);
        synced.winner = line.winner;
        synced.left = line.left;
        synced.rubbingsHeld = line.rubbingsHeld;
        synced.collected = line.collected;
        synced.thefts = line.thefts;
        synced.lost = line.lost;
        synced.duelsWon = line.duelsWon;
        synced.duelsLost = line.duelsLost;
        synced.duelsDrawn = line.duelsDrawn;
        synced.gold = line.gold;
        synced.cachesClaimed = line.cachesClaimed;
        synced.islandsVisited = line.islandsVisited;
        this.state.results.push(synced);
      }
    }
  }

  /** The rules' telegraphs and each player's status into the synced state (markers change only on events). */
  private mirrorEncounters(present: ReadonlySet<string>): void {
    const keys = new Set<string>();
    for (const attempt of this.encounters.attempts) {
      for (const [key, defenderId] of [
        [attempt.attackerId, attempt.defenderId],
        [attempt.attackerId + BLANK_GRAPPLE_SUFFIX, ""],
      ] as const) {
        keys.add(key);
        let synced = this.state.grapples.get(key);
        if (synced === undefined) {
          synced = new GrappleSchema();
          synced.attackerId = attempt.attackerId;
          this.state.grapples.set(key, synced);
        }
        synced.defenderId = defenderId;
        synced.aim = attempt.aim;
        synced.startTick = attempt.startTick;
        synced.landTick = attempt.landTick;
      }
    }
    for (const key of [...this.state.grapples.keys()]) if (!keys.has(key)) this.state.grapples.delete(key);

    const records = new Map(this.encounters.players.map((player) => [player.id, player]));
    for (const id of present) {
      let status = this.state.status.get(id);
      if (status === undefined) {
        status = new PlayerStatusSchema();
        this.state.status.set(id, status);
      }
      const record = records.get(id);
      status.mode = record?.respawn != null ? "respawning" : duelOf(this.encounters, id) !== undefined ? "duel" : "sea";
      status.protection = record?.protection?.source ?? "";
      status.protectedUntil = record?.protection?.endTick ?? 0;
      status.cooldownUntil = record?.cooldownEndTick ?? 0;
      status.respawnAt = record?.respawn?.respawnTick ?? 0;
    }
    for (const id of [...this.state.status.keys()]) if (!present.has(id)) this.state.status.delete(id);
  }

  /**
   * The ledger into the synced state: each player's private status (gold, rubbings, what their island and dock hold
   * while moored there, E's target and progress, their theft choice and their last results), and a contentless marker
   * for each recovery cache.
   */
  private mirrorObjectives(present: ReadonlySet<string>): void {
    const map = this.config.map;
    const ships = new Map(this.simulation.ships.map((ship) => [ship.id, ship]));
    const held = this.heldPlayers();
    for (const id of present) {
      const status = this.state.status.get(id)!;
      const player = findPlayer(this.ledger, id);
      const ship = ships.get(id)!;
      const moored = ship.dock !== NOT_DOCKED && !held.has(id) && player !== undefined;
      status.gold = player?.gold ?? 0;
      status.rubbings = player === undefined ? "" : heldTypes(this.ledger, id).join(",");
      status.islandTypes = moored ? sealedTypesAt(this.ledger, map.docks[ship.dock]!.island).join(",") : "";
      status.cacheTypes = moored ? cachedTypesAt(this.ledger, map, ship.dock).join(",") : "";
      const target = moored && player.status === "connected" ? interactTarget(this.ledger, map, id, ship.dock) : undefined;
      status.target = target === undefined ? "" : `${target.kind}:${target.type}`;
      const channel = player?.channel ?? null;
      status.channel = channel?.kind ?? "";
      status.channelType = channel === null ? "" : (this.ledger.rubbings.find((rubbing) => rubbing.id === channel.rubbingId)?.type ?? "");
      status.channelHeld = channel?.heldTicks ?? 0;
      status.channelTotal = channel === null ? 0 : channel.kind === "collect" ? this.ledger.rules.collectTicks : this.ledger.rules.cacheClaimTicks;
      const choosing = this.ledger.duels.find((duel) => duel.phase === "choosing" && duel.result?.winner === id);
      const options = choosing === undefined ? [] : eligibleTheftTypes(this.ledger, choosing.id);
      status.theftDuel = choosing === undefined || options.length === 0 ? "" : (this.seaDuels.get(choosing.id)?.key ?? "");
      status.theftOptions = status.theftDuel === "" ? "" : options.join(",");
      status.theftDeadline = status.theftDuel === "" ? 0 : choosing!.choiceDeadline!;
      const notice = this.noticesOf(id);
      status.channelResult = notice.channelResult;
      status.channelResultAt = notice.channelResultAt;
      status.settledRole = notice.settledRole;
      status.stolen = notice.stolen;
      status.goldChange = notice.goldChange;
      status.settledAt = notice.settledAt;
      status.settledChoice = notice.settledChoice;
      status.choiceDeadline = notice.choiceDeadline;
      this.mirrorClaim(id, status, ship, player === undefined ? false : holdsAllTypes(this.ledger, id), notice);
      this.mirrorRuin(id, status, moored ? islandOfDock(map, ship.dock) : null);
      this.mirrorFruit(id, status, moored ? pedestalAtDock(this.pedestals, ship.dock) : undefined, notice);
      this.mirrorJournal(id, status, ship, held.has(id));
    }
    for (const marker of this.state.ruins.values()) marker.unlocked = islandUnlocked(this.ledger, marker.island);
    for (const pedestal of this.fruits.pedestals) this.state.pedestals.get(pedestal.id)!.full = pedestal.eatenBy === null;
    const caches = new Set<string>();
    for (const cache of this.ledger.caches) {
      if (cacheRubbings(this.ledger, cache.id).length === 0) continue;
      caches.add(cache.id);
      let synced = this.state.caches.get(cache.id);
      if (synced === undefined) {
        synced = new CacheMarkerSchema();
        synced.x = cache.x;
        synced.y = cache.y;
        synced.dock = cacheDock(map, cache);
        this.state.caches.set(cache.id, synced);
      }
    }
    for (const id of [...this.state.caches.keys()]) if (!caches.has(id)) this.state.caches.delete(id);
  }

  /**
   * §9 in a player's own status only: their kit, whether the pedestal where they are moored is full, their eating
   * progress and how their last attempt ended.
   */
  private mirrorFruit(id: string, status: PlayerStatusSchema, site: PedestalSite | undefined, notice: Notices): void {
    status.kit = kitOf(this.fruits, id);
    status.pedestal = site === undefined ? "" : this.fruits.pedestals.find((pedestal) => pedestal.id === site.id)!.eatenBy === null ? "full" : "empty";
    status.fruitHeld = this.fruits.channels.find((channel) => channel.playerId === id)?.held ?? 0;
    status.fruitTotal = this.fruitConfig.eatTicks;
    status.fruitResult = notice.fruitResult;
    status.fruitResultAt = notice.fruitResultAt;
  }

  /**
   * §3, §11, §13's journal in a player's own status only: their journal log, the islands they have had in sight or
   * moored at (by the ruin markers' sight rule, each one's unlocked state as last seen and whether they solved its
   * ruin), and what a targeted rumor about each missing type would yield.
   */
  private mirrorJournal(id: string, status: PlayerStatusSchema, ship: { x: number; y: number }, away: boolean): void {
    status.journal = JSON.stringify(this.journal.entries(id));
    let known = this.knownIslands.get(id);
    if (known === undefined) {
      known = new Map();
      this.knownIslands.set(id, known);
    }
    for (const marker of this.state.ruins.values()) if (this.islandInSight(ship, marker.island, away)) known.set(marker.island, islandUnlocked(this.ledger, marker.island));
    status.knownIslands = JSON.stringify(
      [...known]
        .sort(([a], [b]) => a - b)
        .map(([island, unlocked]) => ({ island, unlocked, solved: hasSolved(findRuin(this.ruins, island)!, id) })),
    );
    status.rumorOffers = this.rumorOffers.get(id) ?? "";
  }

  /** §3: the ruin of the island a player is moored at, in their own status only: its state, their session and lockout. */
  private mirrorRuin(id: string, status: PlayerStatusSchema, island: number | null): void {
    const ruin = island === null ? undefined : findRuin(this.ruins, island);
    status.ruin = ruin === undefined ? "" : hasSolved(ruin, id) ? "solved" : islandUnlocked(this.ledger, ruin.island) ? "unlocked" : "locked";
    status.ruinOpen = ruin !== undefined && sessionOf(ruin, id) !== undefined;
    status.ruinLockedUntil = ruin === undefined ? 0 : lockedUntil(ruin, id);
  }

  /**
   * A player's own view of the final island (§5, §16): their route once the reveals gave it (inactive while their set
   * is broken), whether they hold every type, and their claim: channelling (with the ticks held and needed), waiting
   * for another claimer to finish, and why their last channel reset.
   */
  private mirrorClaim(id: string, status: PlayerStatusSchema, ship: { x: number; y: number }, fullSet: boolean, notice: Notices): void {
    const route = this.routes.get(id);
    status.seat = this.seatOf(id);
    status.fullSet = fullSet;
    status.routeKnown = route !== undefined;
    status.routeActive = route?.active === true;
    status.routeX = route?.x ?? 0;
    status.routeY = route?.y ?? 0;
    const channel = this.claim?.channel ?? null;
    const config = this.claimConfig;
    const inCircle = route !== undefined && config !== undefined && insideTreasureCircle(config, ship.x, ship.y);
    status.claim = channel?.playerId === id ? "channel" : channel !== null && fullSet && inCircle ? "waiting" : "";
    status.claimHeld = channel?.playerId === id ? channel.progress : 0;
    status.claimTotal = config?.channelTicks ?? this.tuning.claim.channelTicks;
    status.claimInterrupt = notice.claimInterrupt;
    status.claimInterruptAt = notice.claimInterruptAt;
  }

  /**
   * Each client's view (§3, §6, §12, §16): its own ship unless it waits to respawn, the ships it can see that are not
   * in a duel or waiting to respawn, the grapples whose attacker it sees or that aim at it (with the target blanked
   * unless it sees the target too), the duel markers and caches in its sight, its own status and its own duel. A
   * fighter or a player waiting to respawn sees no other ship, grapple, marker or cache. Nothing else is encoded for it.
   */
  private updateViews(): void {
    const inDuel = new Set(this.encounters.duels.flatMap((duel) => duel.players));
    const respawning = new Set(this.encounters.players.filter((player) => player.respawn !== null).map((player) => player.id));
    const ships = new Map(this.simulation.ships.map((ship) => [ship.id, ship]));
    for (const client of this.clients) {
      const view = client.view;
      if (view === undefined) continue;
      const self = client.sessionId;
      const viewer = ships.get(self);
      const away = inDuel.has(self) || respawning.has(self);
      const sync = (item: Parameters<typeof view.add>[0], visible: boolean) => {
        const shown = view.has(item);
        if (visible && !shown) view.add(item);
        else if (!visible && shown) view.remove(item);
      };
      const visible = visibleShipIds(this.config, this.simulation, self);
      for (const [id, ship] of this.state.ships) {
        sync(ship, id === self ? !respawning.has(id) : visible.has(id) && !away && !inDuel.has(id) && !respawning.has(id));
      }
      const sees = (id: string) => {
        const other = ships.get(id);
        return !away && viewer !== undefined && other !== undefined && canSee(this.config, viewer, other);
      };
      for (const attempt of this.encounters.attempts) {
        const aimedAt = attempt.attackerId === self || attempt.defenderId === self;
        const full = aimedAt || (sees(attempt.attackerId) && sees(attempt.defenderId));
        const blank = !full && sees(attempt.attackerId);
        const fullEntry = this.state.grapples.get(attempt.attackerId);
        const blankEntry = this.state.grapples.get(attempt.attackerId + BLANK_GRAPPLE_SUFFIX);
        if (fullEntry !== undefined) sync(fullEntry, full);
        if (blankEntry !== undefined) sync(blankEntry, blank);
      }
      for (const marker of this.state.markers.values()) sync(marker, !away && viewer !== undefined && pointInSight(this.config, viewer, marker));
      for (const cache of this.state.caches.values()) sync(cache, !away && viewer !== undefined && pointInSight(this.config, viewer, cache));
      // A pedestal: whether it is full, for players in sight of its dock (§9, §16); never which fruit.
      for (const pedestal of this.state.pedestals.values()) sync(pedestal, !away && viewer !== undefined && pointInSight(this.config, viewer, pedestal));
      // An island's ruin: whether it is unlocked, for players in sight of the island (a ship moored there always is, §16).
      for (const ruin of this.state.ruins.values()) sync(ruin, viewer !== undefined && this.islandInSight(viewer, ruin.island, away));
      for (const [id, status] of this.state.status) sync(status, id === self);
      for (const lobby of this.state.duels.values()) sync(lobby, lobby.seats.some((seat) => seat.sessionId === self));
    }
  }

  /**
   * The sight rule of islands (§3, §16): an island is in a player's sight when its nearest point is inside their sight
   * radius (a ship moored there always is), unless they are in a duel or waiting to respawn. The ruin markers and the
   * journal's known islands both follow it.
   */
  private islandInSight(viewer: { x: number; y: number }, island: number, away: boolean): boolean {
    return !away && pointInSight(this.config, viewer, nearestIslandPoint(this.config.map, island, viewer.x, viewer.y));
  }

  private async allocateCode(): Promise<string> {
    for (let attempt = 0; attempt < 16; attempt++) {
      const code = generateMatchCode();
      const taken = await matchMaker.query({ name: this.roomName, code });
      if (taken.length === 0) return code;
    }
    throw new ServerError(JoinRefusal.BadRequest, "Could not allocate a match code");
  }
}
