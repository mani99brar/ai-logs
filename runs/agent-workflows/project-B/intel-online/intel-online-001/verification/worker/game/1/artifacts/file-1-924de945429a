/**
 * The room's listing: private matches are found by `code` (Colyseus `filterBy`). It never holds the
 * creator's `createToken`, so a request carrying a token matches no listing.
 */
export interface MatchMetadata {
  code: string;
  custom: boolean;
  /** The match has left its lobby: admission refuses every join (§2: late arrivals wait for another match). */
  started?: boolean;
  /** A `filterBy` field that is never set: no listing holds a token, so no token-carrying request matches one. */
  createToken?: never;
}

/** World updates go out at 20 Hz, the world simulation rate (§15). */
const PATCH_INTERVAL_MS = 1000 / 20;

/** World ticks a second (§15). */
const WORLD_TICKS_PER_SECOND = STEPS_PER_SECOND / WORLD_STEP_INTERVAL;

/**
 * World ticks a settled duel's lobby stays in its fighters' views, so both read the result before their clients return
 * to the sea (2 s). The winner's protection and the loser's respawn already run meanwhile.
 */
export const DUEL_RESULT_TICKS = 40;

/**
 * Colyseus' reconnection window (§12): only an outer bound that keeps the socket's seat open. The world tick decides
 * everything else (the 60 s seat reservation, the 10 s duel absence); if this window closes first, it is a quit.
 */
export const RECONNECTION_OUTER_BOUND_SECONDS = 70;

/** The key suffix of a grapple's blanked twin, the entry for viewers who see the attacker but not the defender (§16). */
export const BLANK_GRAPPLE_SUFFIX = "~";

/**
 * A match's timings and test-only settings. Production uses `DEFAULT_MATCH_TUNING`; tests shorten the timings through
 * `startGameServer({ matchTuning })` (never read by the production entry), and assert in world ticks.
 */
export interface MatchTuning {
  /** The ledger's rules (§4, §11, §12): collection and claim holds, the theft window, the seat reservation, gold. */
  readonly objectives: ObjectiveRules;
  /** The encounter rules (§6): windups, the countdown and ready check, protections, the respawn delay. */
  readonly encounters: EncounterRules;
  /** §12: world ticks a fighter may be away from an unfinished duel before forfeiting it (10 s). */
  readonly duelAbsenceTicks: number;
  /** Colyseus' reconnection window, the outer bound (70 s). */
  readonly reconnectionSeconds: number;
  /** §2's lobby and ready countdown (`readyTicks`); the departure is the encounter rules' spawn protection. */
  readonly match: MatchRules;
  /** §5's claim channel and circle, and §2's deadline: the timer's duration is this `deadlineTicks`. */
  readonly claim: ClaimRules;
  /** §2's minute-20 and minute-28 reveals. */
  readonly intel: IntelRules;
  /** Test-only: deal the sources in this layout (types per island) instead of the private shuffle. */
  readonly sourceLayout: readonly (readonly string[])[] | undefined;
  /**
   * The match's one private master secret (§3, §16), from which every system's seed is derived (`deriveSeed`):
   * production draws it from `node:crypto` (`drawMasterSecret`); tests inject their own to show what follows it.
   */
  readonly masterSecret: () => Uint8Array;
  /** Test-only: the final-socket secret instead of the one derived from the master secret, so a test knows the island. */
  readonly finalSocketSecret: number | undefined;
  /** Test-only: islands whose sources are open from the start, or whose ruin has a pinned kind (`TEST_RUINS_ENV`). */
  readonly testRuins: TestRuins | undefined;
  /** Test-only: the kit on each island's pedestal, in island order, instead of the fruit seed's deal (`TEST_FRUITS_ENV`). */
  readonly testFruits: TestFruits | undefined;
  /** Test-only: the room's `injectFault` and `pauseAfterTick` hooks work (off by default; they throw otherwise). */
  readonly testHooks: boolean;
  /** Check `checkLedger` and the room's own invariant after every world tick (development and tests). */
  readonly checkInvariants: boolean;
}

export const DEFAULT_MATCH_TUNING: MatchTuning = {
  objectives: objectiveRules,
  encounters: encounterRules,
  duelAbsenceTicks: DUEL_RECONNECT_SECONDS * WORLD_TICKS_PER_SECOND,
  reconnectionSeconds: RECONNECTION_OUTER_BOUND_SECONDS,
  match: defaultMatchRules,
  claim: defaultClaimRules,
  intel: defaultIntelRules,
  sourceLayout: undefined,
  masterSecret: drawMasterSecret,
  finalSocketSecret: undefined,
  testRuins: undefined,
  testFruits: undefined,
  testHooks: false,
  checkInvariants: true,
};

