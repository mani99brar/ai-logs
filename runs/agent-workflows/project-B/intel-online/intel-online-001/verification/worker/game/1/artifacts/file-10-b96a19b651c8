import { describe, expect, it } from "vitest";
import { JournalMessageType, PROTOCOL_VERSION, type JournalEntry, type JournalMessage } from "@pirate-sea-race/protocol";
import { kitDescriptions } from "@pirate-sea-race/simulation/fruits";
import {
  bandStarts,
  buyButtons,
  entryText,
  JournalPanel,
  journalStatusOf,
  journalView,
  nextFocus,
  resultLine,
  RUMOR_PRICE,
  SECTOR_NAME_MS,
  sameButtons,
  sectorOverlay,
  toastOf,
  type JournalStatus,
  type JournalView,
  type Toast,
} from "./journal.js";
import { panelKeydown, type KeyPanel } from "./pageKeys.js";

const entry = (patch: Partial<JournalEntry>): JournalEntry => ({
  n: 1,
  kind: "island",
  type: "sun",
  target: "Old Stones",
  island: 2,
  sector: -1,
  reason: "start",
  tick: 100,
  seenTick: 0,
  status: "active",
  replacedBy: 0,
  ...patch,
});
const status = (patch: Partial<JournalStatus> = {}): JournalStatus => ({
  journal: [],
  knownIslands: [],
  offers: [
    { type: "sun", offer: "available" },
    { type: "moon", offer: "available" },
  ],
  rubbings: [],
  gold: 50,
  kit: "duelist",
  moored: true,
  ...patch,
});
const islandName = (island: number) => ["Palm Key", "Ember Rock", "Old Stones", "Mist Cay"][island]!;

describe("the journal's model (journalView)", () => {
  it("speaks protocol v10", () => {
    expect(PROTOCOL_VERSION).toBe(10);
  });

  it("lists every kind of entry newest first, with its reason, a stale one's replacement, and its status", () => {
    const entries = [
      entry({ n: 1, status: "stale", replacedBy: 3 }),
      entry({ n: 2, kind: "sector", type: "moon", target: "Central Waters", island: -1, sector: 4, reason: "targeted" }),
      entry({ n: 3, kind: "sighting", target: "Northern Waters", island: -1, sector: 1, reason: "replacement", tick: 900, seenTick: 300 }),
      entry({ n: 4, kind: "no-lead", type: "moon", target: "", island: -1, reason: "fresh", status: "resolved" }),
      entry({ n: 5, reason: "fresh", status: "stale", replacedBy: 0 }),
    ];
    const view = journalView(true, status({ journal: entries }), undefined, undefined, islandName);
    expect(view.hidden).toBe(false);
    expect(view.rumors.map(({ n, text, reason, status, statusText, replaced }) => ({ n, text, reason, status, statusText, replaced }))).toEqual([
      { n: 5, text: "#5 Sun: Old Stones (island)", reason: "fresh", status: "stale", statusText: " stale", replaced: "Stale: its target no longer holds it" },
      { n: 4, text: "#4 Moon: no lead", reason: "fresh", status: "resolved", statusText: " resolved", replaced: "" },
      { n: 3, text: "#3 Sun: a carrier seen in Northern Waters 30 s before", reason: "sighting", status: "active", statusText: "", replaced: "" },
      { n: 2, text: "#2 Moon: a recovery cache in Central Waters", reason: "targeted", status: "active", statusText: "", replaced: "" },
      { n: 1, text: "#1 Sun: Old Stones (island)", reason: "start", status: "stale", statusText: " stale", replaced: "Replaced by #3: Sun: a carrier seen in Northern Waters 30 s before" },
    ]);
    expect(entryText(entry({ kind: "no-lead", type: "tide" }))).toBe("Tide: no lead");
    // Nothing yet: one line each says so.
    expect(journalView(false, undefined, undefined, undefined, islandName)).toMatchObject({
      hidden: true,
      rumors: [{ text: "No leads yet", status: "empty" }],
      islands: [{ text: "None yet: islands you sight are noted here", state: "empty" }],
      collected: "none yet",
    });
  });

  it("shows the known islands with their ruin as last seen, the collected types and the kit with its §9 description", () => {
    const view = journalView(
      true,
      status({
        knownIslands: [
          { island: 0, unlocked: true, solved: true },
          { island: 1, unlocked: true, solved: false },
          { island: 3, unlocked: false, solved: false },
        ],
        rubbings: ["sun", "moon"],
        kit: "ember",
      }),
      undefined,
      undefined,
      islandName,
    );
    expect(view.islands).toEqual([
      { text: "Palm Key: ruin solved by you", state: "solved" },
      { text: "Ember Rock: ruin unlocked", state: "unlocked" },
      { text: "Mist Cay: ruin locked", state: "locked" },
    ]);
    expect(view.collected).toBe("Sun, Moon");
    const ember = kitDescriptions.ember;
    expect(view.kit).toEqual({ name: ember.name, specials: [`U: ${ember.specials[0]}`, `I: ${ember.specials[1]}`], advantage: ember.advantage, vulnerability: ember.vulnerability });
    expect(journalView(true, status({ kit: "nonsense" }), undefined, undefined, islandName).kit.name).toBe(kitDescriptions.duelist.name);
  });

  it("offers a Buy button per missing type: available, covered, no lead, not at a dock, too little gold, and all disabled while one waits", () => {
    const states = (patch: Partial<JournalStatus>, pending?: string) => buyButtons(status(patch), pending).map((button) => [button.type, button.state, button.disabled]);
    expect(states({})).toEqual([
      ["sun", "available", false],
      ["moon", "available", false],
    ]);
    expect(buyButtons(status(), undefined)[0]!.label).toBe(`Sun: Buy a rumor (${RUMOR_PRICE} gold)`);
    expect(
      states({
        offers: [
          { type: "sun", offer: "covered" },
          { type: "moon", offer: "none" },
        ],
      }),
    ).toEqual([
      ["sun", "covered", true],
      ["moon", "no-lead", true],
    ]);
    expect(states({ moored: false })).toEqual([
      ["sun", "not-at-dock", true],
      ["moon", "not-at-dock", true],
    ]);
    expect(states({ gold: RUMOR_PRICE - 1 })).toEqual([
      ["sun", "gold", true],
      ["moon", "gold", true],
    ]);
    expect(states({ gold: RUMOR_PRICE })[0]).toEqual(["sun", "available", false]);
    expect(states({}, "moon")).toEqual([
      ["sun", "pending", true],
      ["moon", "pending", true],
    ]);
    expect(buyButtons(status(), "moon")[1]!.label).toBe("Moon: asking…");
    expect(buyButtons(undefined, undefined)).toEqual([]);
    expect(states({ offers: [{ type: "moon", offer: "available" }] })).toEqual([["moon", "available", false]]);
  });

  it("says how the last purchase went", () => {
    expect(resultLine(undefined)).toEqual({ text: "", state: "none" });
    expect(resultLine({ requestId: "j1", type: "sun", outcome: "bought", price: 25, replayed: false })).toEqual({ text: "Bought a rumor about Sun (−25 gold)", state: "bought" });
    expect(resultLine({ requestId: "j1", type: "moon", outcome: "refused", reason: "not-at-dock", replayed: false })).toEqual({ text: "Moon: Moor at a dock to buy a rumor, nothing charged", state: "not-at-dock" });
  });
});

describe("the journal's status (journalStatusOf)", () => {
  const fields = {
    journal: JSON.stringify([entry({})]),
    knownIslands: '[{"island":1,"unlocked":false,"solved":false}]',
    rumorOffers: "sun:covered,moon:available",
    rubbings: "moon",
    gold: 30,
    kit: "smoke",
    mode: "sea",
  };

  it("reads the journal, the known islands, the offers, the types, gold and kit from the private status", () => {
    expect(journalStatusOf(fields, 4)).toEqual({
      journal: [entry({})],
      knownIslands: [{ island: 1, unlocked: false, solved: false }],
      offers: [
        { type: "sun", offer: "covered" },
        { type: "moon", offer: "available" },
      ],
      rubbings: ["moon"],
      gold: 30,
      kit: "smoke",
      moored: true,
    });
    expect(journalStatusOf({ ...fields, rubbings: "" }, 4)!.rubbings).toEqual([]);
    expect(journalStatusOf(undefined, 4)).toBeUndefined();
  });

  it("is moored for buying only at a dock and in the world: not at sea, in a duel or waiting to respawn", () => {
    expect(journalStatusOf(fields, 0)!.moored).toBe(true);
    expect(journalStatusOf(fields, -1)!.moored).toBe(false);
    expect(journalStatusOf(fields, undefined)!.moored).toBe(false);
    expect(journalStatusOf({ ...fields, mode: "duel" }, 4)!.moored).toBe(false);
    expect(journalStatusOf({ ...fields, mode: "respawning" }, 4)!.moored).toBe(false);
  });
});

describe("the journal's toasts", () => {
  it("announces each new lead briefly, and a resolved rumor quietly", () => {
    const leads: JournalMessage[] = [
      { kind: "rumor", tick: 1, entry: 1, type: "sun", reason: "start", target: { kind: "island", island: 2, name: "Old Stones" } },
      { kind: "rumor", tick: 1, entry: 2, type: "moon", reason: "targeted", target: { kind: "sector", sector: 4, name: "Central Waters" } },
      { kind: "carrier-sighting", tick: 700, seenTick: 100, sightings: [{ type: "sun", reason: "fresh", sector: 4, name: "Central Waters" }] },
      { kind: "no-lead", tick: 1, type: "moon", reason: "fresh" },
      { kind: "rumor-stale", tick: 1, entry: 1, type: "sun" },
      { kind: "rumor-resolved", tick: 1, entry: 1, type: "sun" },
    ];
    expect(leads.map(toastOf)).toEqual([
      { title: "New lead (start): Sun", detail: "Try Old Stones." },
      { title: "New lead (targeted): Moon", detail: "Try a recovery cache in Central Waters." },
      { title: "Carrier sighting: Sun", detail: "Sun seen in Central Waters, 30 s ago." },
      { title: "No lead: Moon", detail: "Every copy is out of reach for now." },
      { title: "Stale rumor: Sun", detail: "Its target no longer holds it." },
      undefined,
    ]);
  });
});

describe("the journal's behaviour (JournalPanel)", () => {
  const panel = () => {
    const sent: [string, unknown][] = [];
    const views: JournalView[] = [];
    const toasts: Toast[] = [];
    const focus: boolean[] = [];
    const journal = new JournalPanel(
      (type, message) => sent.push([type, message]),
      (view) => views.push(view),
      (toast) => toasts.push(toast),
      (backwards) => focus.push(backwards),
      islandName,
    );
    return { journal, sent, toasts, focus, last: () => views.at(-1)! };
  };
  const key = (code: string, repeat = false, shiftKey = false) => ({ code, repeat, shiftKey });

  it("opens and closes on M, closes on Escape, moves focus on Tab and Shift+Tab while open, and ignores M's auto-repeat", () => {
    const { journal, focus, last } = panel();
    expect(journal.keydown(key("Escape"))).toBe(false);
    expect(journal.keydown(key("Tab"))).toBe(false);
    expect(journal.keydown(key("KeyM"))).toBe(true);
    expect(journal.isOpen).toBe(true);
    expect(last().hidden).toBe(false);
    // Opening puts focus on its first button.
    expect(focus).toEqual([false]);
    expect(journal.keydown(key("KeyM", true))).toBe(true);
    expect(journal.isOpen).toBe(true);
    expect(journal.keydown(key("Tab"))).toBe(true);
    expect(journal.keydown(key("Tab", false, true))).toBe(true);
    expect(focus).toEqual([false, false, true]);
    // Other keys (the helm's, Enter and Space on a focused button) are not the journal's.
    for (const code of ["KeyW", "ArrowUp", "KeyE", "Enter", "Space"]) expect(journal.keydown(key(code))).toBe(false);
    expect(journal.keydown(key("Escape"))).toBe(true);
    expect(journal.isOpen).toBe(false);
    expect(last().hidden).toBe(true);
    journal.keydown(key("KeyM"));
    journal.keydown(key("KeyM"));
    expect(journal.isOpen).toBe(false);
  });

  it("sends a purchase from an available button only, holds every button until its answer, and lets go of a request never answered", () => {
    const { journal, sent, last } = panel();
    journal.update(status({ moored: false }), 10);
    journal.buy("sun");
    expect(sent).toEqual([]);
    journal.update(status(), 11);
    journal.buy("tide");
    expect(sent).toEqual([]);
    journal.buy("sun");
    expect(sent).toEqual([[JournalMessageType.BuyRumor, { requestId: "j1", type: "sun" }]]);
    expect(last().buys.map((button) => button.state)).toEqual(["pending", "pending"]);
    journal.buy("moon");
    expect(sent).toHaveLength(1);
    // Another request's answer, or a malformed one, keeps it waiting.
    journal.result({ requestId: "zz", type: "moon", outcome: "refused", reason: "busy", replayed: false });
    journal.result({ requestId: "j1" });
    expect(last().buys[0]!.state).toBe("pending");
    journal.result({ requestId: "j1", type: "sun", outcome: "bought", price: 25, replayed: false });
    expect(last().message).toEqual({ text: "Bought a rumor about Sun (−25 gold)", state: "bought" });
    journal.update(status({ gold: 25 }), 12);
    expect(last().buys[0]!.state).toBe("available");
    journal.buy("moon");
    expect(sent.at(-1)).toEqual([JournalMessageType.BuyRumor, { requestId: "j2", type: "moon" }]);
    // No answer (the rate cap dropped it): after five seconds the buttons are free again.
    journal.update(status({ gold: 25 }), 12 + 100);
    expect(last().buys[1]!.state).toBe("pending");
    journal.update(status({ gold: 25 }), 12 + 101);
    expect(last().buys[1]!.state).toBe("available");
  });

  it("raises a toast for each new lead once: a replay's resent lead raises none, nor does anything that is not a lead", () => {
    const { journal, toasts } = panel();
    const lead = { kind: "rumor", tick: 5, entry: 3, type: "moon", reason: "targeted", target: { kind: "island", island: 1, name: "Ember Rock" } };
    journal.lead(lead);
    journal.lead(lead);
    journal.lead({ kind: "rumor-resolved", tick: 6, entry: 3, type: "moon" });
    journal.lead({ kind: "rumor", playerId: "x" });
    expect(toasts).toEqual([{ title: "New lead (targeted): Moon", detail: "Try Ember Rock." }]);
    expect(journal.entries()).toEqual([]);
    journal.update(status({ journal: [entry({})] }), 1);
    expect(journal.entries()).toEqual([entry({})]);
  });

  it("gets its keys from the page only when no other panel is open, and takes only its own while it is open (the helm stays live)", () => {
    const recording = (open: boolean, takes: boolean) => {
      const seen: string[] = [];
      const keyPanel: KeyPanel = { isOpen: open, keydown: (event) => (seen.push(event.code), takes) };
      return { keyPanel, seen };
    };
    const event = (code: string, target: unknown = {}) => ({ code, repeat: false, target: target as EventTarget });
    // Closed, with the others closed: M reaches it after the ruin and fruit panels passed.
    const { journal } = panel();
    const ruins = recording(false, false);
    const fruit = recording(false, false);
    expect(panelKeydown(event("KeyM"), { ruins: ruins.keyPanel, fruit: fruit.keyPanel, journal })).toBe(true);
    expect(journal.isOpen).toBe(true);
    // Open: only it hears keys; R and F open nothing over it, and a helm key is nobody's.
    const quiet = recording(false, true);
    expect(panelKeydown(event("KeyR"), { ruins: quiet.keyPanel, fruit: quiet.keyPanel, journal })).toBe(false);
    expect(panelKeydown(event("KeyW"), { ruins: quiet.keyPanel, fruit: quiet.keyPanel, journal })).toBe(false);
    expect(quiet.seen).toEqual([]);
    expect(panelKeydown(event("Escape"), { ruins: quiet.keyPanel, fruit: quiet.keyPanel, journal })).toBe(true);
    expect(journal.isOpen).toBe(false);
    // Another panel open: M does not open the journal over it.
    for (const [ruinsOpen, fruitOpen] of [
      [true, false],
      [false, true],
    ] as const) {
      const other = panel().journal;
      panelKeydown(event("KeyM"), { ruins: recording(ruinsOpen, false).keyPanel, fruit: recording(fruitOpen, false).keyPanel, journal: other });
      expect(other.isOpen).toBe(false);
    }
    // Typed into a text field: never.
    const typed = panel().journal;
    expect(panelKeydown(event("KeyM", { tagName: "INPUT" }), { ruins: ruins.keyPanel, fruit: fruit.keyPanel, journal: typed })).toBe(false);
    expect(typed.isOpen).toBe(false);
  });

  it("keeps the page's Buy buttons while they are the view's, in order, and replaces them otherwise", () => {
    expect(sameButtons(["sun", "moon"], ["sun", "moon"])).toBe(true);
    expect(sameButtons([], [])).toBe(true);
    // The first draw, a type collected (the last one or not), or a new order: replaced.
    expect(sameButtons([], ["sun", "moon"])).toBe(false);
    expect(sameButtons(["sun", "moon"], ["sun"])).toBe(false);
    expect(sameButtons(["sun", "moon"], ["moon"])).toBe(false);
    expect(sameButtons(["sun", "moon"], ["moon", "sun"])).toBe(false);
  });

  it("moves focus through its buttons in order with Tab, backwards with Shift+Tab, wrapping around", () => {
    expect(nextFocus(3, -1, false)).toBe(0);
    expect(nextFocus(3, -1, true)).toBe(2);
    expect(nextFocus(3, 0, false)).toBe(1);
    expect(nextFocus(3, 2, false)).toBe(0);
    expect(nextFocus(3, 0, true)).toBe(2);
    expect(nextFocus(3, 1, true)).toBe(0);
    expect(nextFocus(0, -1, false)).toBe(-1);
  });
});

describe("the sea's sector borders (§3)", () => {
  const TILE = 256;
  const at = (tileX: number, tileY: number) => ({ x: tileX * TILE + 128, y: tileY * TILE + 128 });

  it("shows the 3 × 3 borders only while the journal is open or a sector lead is active", () => {
    const overlay = (journalOpen: boolean, entries: JournalEntry[]) => sectorOverlay({ journalOpen, entries, own: at(55, 55), entered: undefined, now: 0 }).overlay.visible;
    expect(overlay(false, [])).toBe(false);
    expect(overlay(false, [entry({})])).toBe(false);
    expect(overlay(true, [])).toBe(true);
    expect(overlay(false, [entry({ kind: "sector", sector: 4, island: -1 })])).toBe(true);
    expect(overlay(false, [entry({ kind: "sector", sector: 4, island: -1, status: "stale" })])).toBe(false);
    expect(overlay(false, [entry({ kind: "sighting", sector: 4, island: -1 })])).toBe(false);
    // The borders fall where the intel rules' sectors change (111 tiles: 0, 37, 74).
    const { columns, rows } = sectorOverlay({ journalOpen: true, entries: [], own: undefined, entered: undefined, now: 0 }).overlay;
    expect(columns).toEqual([37, 74]);
    expect(rows).toEqual([37, 74]);
    // Hidden, nothing is drawn.
    expect(sectorOverlay({ journalOpen: false, entries: [], own: undefined, entered: undefined, now: 0 }).overlay).toMatchObject({ columns: [], rows: [] });
    expect(bandStarts(224, 3)).toEqual([75, 150]);
    expect(bandStarts(208, 3)).toEqual([70, 139]);
  });

  it("names the sector the ship enters for a moment, while shown", () => {
    let entered: { sector: number; at: number } | undefined;
    const frame = (tileX: number, now: number, journalOpen = true) => {
      const result = sectorOverlay({ journalOpen, entries: [], own: at(tileX, 55), entered, now });
      entered = result.entered;
      return result.overlay;
    };
    expect(frame(55, 0)).toMatchObject({ sector: 4, label: "Central Waters" });
    expect(frame(56, SECTOR_NAME_MS - 1).label).toBe("Central Waters");
    expect(frame(56, SECTOR_NAME_MS).label).toBe("");
    // Into the eastern band: its name, from the moment it is entered.
    expect(frame(80, SECTOR_NAME_MS + 10)).toMatchObject({ sector: 5, label: "Eastern Waters" });
    // Hidden: no name, though the entry is remembered.
    expect(frame(20, SECTOR_NAME_MS + 20, false)).toMatchObject({ visible: false, sector: 3, label: "" });
    // No ship (out of the world): no sector, and the memory stays.
    expect(sectorOverlay({ journalOpen: true, entries: [], own: undefined, entered, now: 0 })).toMatchObject({ overlay: { sector: -1, label: "" }, entered });
  });
});
