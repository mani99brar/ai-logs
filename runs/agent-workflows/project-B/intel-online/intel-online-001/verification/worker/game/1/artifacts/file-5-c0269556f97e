import { schema, t, type SchemaType } from "@colyseus/schema";

/**
 * The synced mirror of the plain simulation state. The room copies the simulation into it after every world step;
 * Colyseus sends clients the deltas at the patch rate. Clients decode it by reflection and import these types only.
 */
export const ShipSchema = schema(
  {
    id: t.string(),
    slot: t.uint8(),
    x: t.int32(),
    y: t.int32(),
    heading: t.uint8(),
    speed: t.int16(),
    /** The dock the ship is moored at, or -1 at sea. */
    dock: t.int8(),
    /** §5: the ship is channelling the treasure claim (whoever sees the ship sees it), and the ticks held so far. */
    claiming: t.boolean(),
    claimHeld: t.uint16(),
  },
  "Ship",
);
export type ShipSchema = SchemaType<typeof ShipSchema>;

/**
 * A telegraphed grapple (§6), from the press until it lands: the attacker, the target the rules chose, the aim locked
 * at the start (a heading of 64) and the world ticks it started and lands on. Keyed by the attacker's id. Each attempt
 * has a second entry, keyed `<attacker id>~`, with `defenderId` blank (§16): a viewer who sees the attacker but not the
 * defender gets that one, so the target's id never reaches them. A view holds at most one of the two.
 */
export const GrappleSchema = schema(
  {
    attackerId: t.string(),
    defenderId: t.string(),
    aim: t.uint8(),
    startTick: t.uint32(),
    landTick: t.uint32(),
  },
  "Grapple",
);
export type GrappleSchema = SchemaType<typeof GrappleSchema>;

/**
 * A duel marker (§6): where a duel runs and the world tick it was reserved on, so players in sight can show crossed
 * swords and the elapsed time. Keyed by an opaque id: nothing names the fighters.
 */
export const DuelMarkerSchema = schema(
  {
    x: t.int32(),
    y: t.int32(),
    startTick: t.uint32(),
  },
  "DuelMarker",
);
export type DuelMarkerSchema = SchemaType<typeof DuelMarkerSchema>;

/**
 * A recovery cache (§12) as others see it: a marker at a dock, with no contents. A player moored at that dock reads
 * the contents in their own status (`cacheTypes`). Keyed by the cache's id.
 */
export const CacheMarkerSchema = schema(
  {
    x: t.int32(),
    y: t.int32(),
    dock: t.int8(),
  },
  "CacheMarker",
);
export type CacheMarkerSchema = SchemaType<typeof CacheMarkerSchema>;

/**
 * An island's ruin as players in sight of the island (or moored there) see it (§3, §16): where it stands and whether
 * it is unlocked, nothing more. Keyed by the island's number.
 */
export const RuinMarkerSchema = schema(
  {
    island: t.uint8(),
    x: t.int32(),
    y: t.int32(),
    unlocked: t.boolean(),
  },
  "RuinMarker",
);
export type RuinMarkerSchema = SchemaType<typeof RuinMarkerSchema>;

/**
 * A fruit pedestal as players in sight of its dock see it (§9, §16): its island, dock and place, and whether it still
 * holds its fruit. Never which fruit: a player moored at its dock reads that only by inspecting it (a message to them).
 * Keyed by the pedestal's id.
 */
export const PedestalMarkerSchema = schema(
  {
    island: t.uint8(),
    dock: t.int8(),
    x: t.int32(),
    y: t.int32(),
    full: t.boolean(),
  },
  "PedestalMarker",
);
export type PedestalMarkerSchema = SchemaType<typeof PedestalMarkerSchema>;

/**
 * A player's own encounter status, for their HUD only: protection and its source until a world tick, the grapple's
 * miss cooldown, and the respawn tick while they wait out of the world after losing a duel (0 when none).
 */
export const PlayerStatusSchema = schema(
  {
    /** "sea", "duel" (reserved or fighting, until the duel is settled) or "respawning". */
    mode: t.string(),
    /** "spawn", "win", "draw", "respawn", or empty when unprotected. */
    protection: t.string(),
    protectedUntil: t.uint32(),
    cooldownUntil: t.uint32(),
    respawnAt: t.uint32(),
    /** §11: the player's gold (the ledger's balance). Private, like everything in this entry (§16). */
    gold: t.uint16(),
    /** §4: the rubbing types the player holds, in type order, comma-separated ("sun,moon"), reserved ones included. */
    rubbings: t.string(),
    /** The types still sealed at the island the player is moored at, one per source (empty when not moored). */
    islandTypes: t.string(),
    /** The types in recovery caches at the dock the player is moored at, one per rubbing (empty when not moored). */
    cacheTypes: t.string(),
    /** What holding E works on here: "collect:<type>", "claim:<type>", or empty. */
    target: t.string(),
    /** The hold in progress: "collect" or "claim", or empty. */
    channel: t.string(),
    channelType: t.string(),
    /** Ticks held so far, and the ticks the hold needs (§4: six seconds). */
    channelHeld: t.uint16(),
    channelTotal: t.uint16(),
    /** The last finished hold: "collected:<type>", "claimed:<type>" or "failed:<reason>", and its world tick. */
    channelResult: t.string(),
    channelResultAt: t.uint32(),
    /** §4: while this player, having won, chooses: their duel lobby's key, the eligible types, and the deadline tick. */
    theftDuel: t.string(),
    theftOptions: t.string(),
    theftDeadline: t.uint32(),
    /** The last duel settlement: "winner", "loser" or "draw" (empty before any), the type stolen, the gold change. */
    settledRole: t.string(),
    stolen: t.string(),
    goldChange: t.int16(),
    settledAt: t.uint32(),
    /**
     * Who picked the stolen type: "winner", "default" (the deadline applied it), "none" (nothing moved), or empty
     * before any settlement; and that duel's choice deadline tick (0 when it had no choice window).
     */
    settledChoice: t.string(),
    choiceDeadline: t.uint32(),
    /** This player's seat in the match ("Player 1" is the first to join), as the roster and the results name it. */
    seat: t.uint8(),
    /** §5: the player holds every rubbing type of the match. */
    fullSet: t.boolean(),
    /**
     * §5, §16: the final island's claim point, only in this player's own entry and only once the reveals gave it to
     * them (a full set). `routeActive` is false while their set is broken; the point stays known.
     */
    routeKnown: t.boolean(),
    routeActive: t.boolean(),
    routeX: t.int32(),
    routeY: t.int32(),
    /** The claim: "channel" (holding E, the ticks held and needed), "waiting" (another claimer holds the channel) or empty. */
    claim: t.string(),
    claimHeld: t.uint16(),
    claimTotal: t.uint16(),
    /** Why the last claim channel reset ("duel", "disconnected", "ineligible", "moved", "released", "deadline"), and when. */
    claimInterrupt: t.string(),
    claimInterruptAt: t.uint32(),
    /**
     * §3: the ruin of the island the player is moored at: "locked", "unlocked" (someone solved it), "solved" (this
     * player did), or empty when not moored at an island with a ruin. Its clue travels only as a message.
     */
    ruin: t.string(),
    /** The player has that ruin open (a session): casting off, a duel or a disconnect closes it. */
    ruinOpen: t.boolean(),
    /** The world tick before which this player's answers there are refused (0 when never locked out). */
    ruinLockedUntil: t.uint32(),
    /** §9: this player's kit, "duelist" until they eat a fruit, then its kit for the rest of the match (private until a duel). */
    kit: t.string(),
    /** The pedestal at the dock the player is moored at: "full", "empty", or empty when there is none. */
    pedestal: t.string(),
    /** Eating in progress: the ticks F has been held (0 when not eating) and the ticks eating takes (§9: three seconds). */
    fruitHeld: t.uint16(),
    fruitTotal: t.uint16(),
    /**
     * The last eating attempt's end: "eaten:<kit>", "interrupted:<reason>" or "refused:<reason>" (the fruit rules'
     * reasons), or empty before any; and its world tick.
     */
    fruitResult: t.string(),
    fruitResultAt: t.uint32(),
    /**
     * §3, §13: this player's journal, the room's log of the leads they received (a JSON array of the protocol's
     * `JournalEntry`, oldest first, at most 24): rumors, sightings and no-lead notices, stale ones linked to what followed.
     */
    journal: t.string(),
    /** §13: the islands this player has had in sight or moored at, as JSON: each one's ruin unlocked as last seen, and solved by them. */
    knownIslands: t.string(),
    /** §11: what a targeted rumor about each missing type would yield now, as `type:offer` pairs ("available", "covered", "none"). */
    rumorOffers: t.string(),
  },
  "PlayerStatus",
);
export type PlayerStatusSchema = SchemaType<typeof PlayerStatusSchema>;

/** One seat of a duel: its player index (slot 0 is player one, the creator), its session and whether it is connected. */
export const DuelSeatSchema = schema(
  {
    sessionId: t.string(),
    slot: t.uint8(),
    connected: t.boolean(),
    /** The latest round trip the server measured for this seat, in milliseconds. */
    rtt: t.uint16(),
  },
  "DuelSeat",
);
export type DuelSeatSchema = SchemaType<typeof DuelSeatSchema>;

/**
 * A duel room's lobby state, synced at the patch rate. The duel's frame data does not travel here: inputs, applied
 * inputs, hashes and snapshots are Colyseus messages (the duel protocol in docs/duel.md).
 */
export const DuelRoomStateSchema = schema(
  {
    code: t.string(),
    protocolVersion: t.uint16(),
    /** A practice room: one player against the server's dummy (player two). */
    practice: t.boolean(),
    /** The dummy's behaviour in a practice room ("idle" or "guard"), empty otherwise. */
    dummy: t.string(),
    /** "waiting", "countdown", "fighting" or "over". */
    phase: t.string(),
    /** Frames left in the countdown. */
    countdown: t.uint16(),
    /** The seed both sides create the duel's frame-0 state from. */
    seed: t.uint32(),
    /** Both fighters' kits (§9), player one's first ("duelist,duelist" in a standalone duel): part of the frame-0 state. */
    kits: t.string(),
    /** The shared input delay in frames, once chosen (0 before). */
    inputDelay: t.uint8(),
    seats: t.array(DuelSeatSchema),
    /** Once over: the winner's slot, or -1 for a draw. */
    winner: t.int8(),
    /** Once over: "ko", "double-ko", "timeout", "overtime" or "forfeit". */
    reason: t.string(),
    /** Once over: the frame the duel ended on. */
    resultFrame: t.uint32(),
  },
  "DuelRoomState",
);
export type DuelRoomStateSchema = SchemaType<typeof DuelRoomStateSchema>;

/**
 * A duel at sea (§14: a simulation object inside the match room): the same lobby a standalone duel room syncs, for its
 * two fighters only. Slot 0 is the attacker, slot 1 the grappled ship. The duel's frames travel as messages, as in a
 * duel room.
 */
export const SeaDuelSchema = schema(
  {
    /** The match code, for the duel HUD. */
    code: t.string(),
    /** Always false: practice is a standalone duel room. */
    practice: t.boolean(),
    /** "countdown", "waiting" (a fighter still loading after the countdown), "fighting" or "over". */
    phase: t.string(),
    countdown: t.uint16(),
    seed: t.uint32(),
    /**
     * Both fighters' kits (§9), the attacker's first: part of the frame-0 state both clients build, and the only place
     * a player's kit reaches another player (the lobby is in its two fighters' views only).
     */
    kits: t.string(),
    inputDelay: t.uint8(),
    seats: t.array(DuelSeatSchema),
    winner: t.int8(),
    /** Once over: "ko", "double-ko", "timeout", "overtime", "forfeit" or "cancelled". */
    reason: t.string(),
    resultFrame: t.uint32(),
  },
  "SeaDuel",
);
export type SeaDuelSchema = SchemaType<typeof SeaDuelSchema>;

/**
 * A player in the match, as the lobby lists them: their seat, numbered from 1 in join order ("Player 2"). Seats, not
 * session ids, name players in everyone's state, so a ship's id first reaches a client when that ship comes into its
 * sight (§16). A client finds its own seat in its private status.
 */
export const RosterEntrySchema = schema(
  {
    seat: t.uint8(),
  },
  "RosterEntry",
);
export type RosterEntrySchema = SchemaType<typeof RosterEntrySchema>;

/** One line of the results screen (§2): a player's seat and accomplishments from control start to the end. */
export const ResultLineSchema = schema(
  {
    seat: t.uint8(),
    winner: t.boolean(),
    left: t.boolean(),
    rubbingsHeld: t.uint8(),
    collected: t.uint8(),
    thefts: t.uint8(),
    lost: t.uint8(),
    duelsWon: t.uint8(),
    duelsLost: t.uint8(),
    duelsDrawn: t.uint8(),
    gold: t.uint16(),
    cachesClaimed: t.uint8(),
    islandsVisited: t.uint8(),
  },
  "ResultLine",
);
export type ResultLineSchema = SchemaType<typeof ResultLineSchema>;

export const MatchStateSchema = schema(
  {
    code: t.string(),
    protocolVersion: t.uint16(),
    /** Private matches are custom matches (§2). */
    custom: t.boolean(),
    /** Players in the match, visible or not. */
    players: t.uint8(),
    /** The simulation frame at the last world step. */
    frame: t.uint32(),
    worldTick: t.uint32(),
    /**
     * Filtered per client (§16): each client's StateView holds its own ship and the ships inside its sight radius,
     * less those in a duel or waiting to respawn (§6), and Colyseus encodes no other entry of this map into that
     * client's messages.
     */
    ships: t.map(ShipSchema).view(),
    /** Telegraphed grapples, filtered like ships: each client's view holds those whose attacker it sees, or aimed at it. */
    grapples: t.map(GrappleSchema).view(),
    /** Duel markers, filtered like ships: each client's view holds those within its sight radius. */
    markers: t.map(DuelMarkerSchema).view(),
    /** Recovery caches, filtered like ships: each client's view holds those within its sight radius (§12, §16). */
    caches: t.map(CacheMarkerSchema).view(),
    /** The islands' ruins, filtered: each client's view holds those of islands in its sight or where it is moored (§16). */
    ruins: t.map(RuinMarkerSchema).view(),
    /** The fruit pedestals, filtered: each client's view holds those whose dock is in its sight (§9, §16). */
    pedestals: t.map(PedestalMarkerSchema).view(),
    /** Each client's view holds only its own entry: its encounter status, gold, rubbings and holds (§16). */
    status: t.map(PlayerStatusSchema).view(),
    /** Duels at sea: each client's view holds only the one it fights in. */
    duels: t.map(SeaDuelSchema).view(),
    /** §2's phase: "lobby", "ready", "departure", "exploration" or "ended". */
    phase: t.string(),
    /** The private host's seat, who may start the match (0: none). */
    hostSeat: t.uint8(),
    /** The players in the match while they are in it, keyed by seat. */
    roster: t.map(RosterEntrySchema),
    /** The fewest players the host may start with (the match module's `PRIVATE_MIN_PLAYERS`). */
    minPlayers: t.uint8(),
    /** The ready countdown's length, and while it runs the world tick player control starts on (0 otherwise). */
    readyTicks: t.uint16(),
    readyEndsAt: t.uint32(),
    /** The world tick player control started on (0 before), the match's duration and the deadline tick (0 before). */
    controlStartTick: t.uint32(),
    durationTicks: t.uint32(),
    deadlineTick: t.uint32(),
    /** The timer (§2): world ticks left, the match module's `remaining`, frozen at the end. */
    remainingTicks: t.uint32(),
    /** The treasure circle's radius in sub-units (§5): public tuning, not where the circle is. */
    treasureRadius: t.uint32(),
    /** §5: the final island's sector once a first full set exists (its name and index; empty and -1 before). */
    finalSector: t.string(),
    finalSectorIndex: t.int8(),
    /** The end (§2, §12): "claim", "deadline", "abandoned" or "aborted" (empty while the match runs), the winner or empty. */
    endReason: t.string(),
    /** The winner's seat (0: no winner). */
    winnerSeat: t.uint8(),
    endTick: t.uint32(),
    elapsedTicks: t.uint32(),
    /** The results screen: the winner first, then by rubbings held, then by id. */
    results: t.array(ResultLineSchema),
  },
  "MatchState",
);
export type MatchStateSchema = SchemaType<typeof MatchStateSchema>;

