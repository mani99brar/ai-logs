<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pirate Sea Race</title>
    <link rel="stylesheet" href="/src/style.css" />
  </head>
  <body>
    <main>
      <section id="landing" aria-labelledby="title">
        <h1 id="title">Pirate Sea Race</h1>
        <p class="tagline">Private test match</p>
        <button id="create-match" type="button">Create match</button>
        <form id="join-form">
          <label for="join-code">Match code</label>
          <input id="join-code" name="code" maxlength="6" autocomplete="off" spellcheck="false" placeholder="K7Q2MX" required />
          <button id="join-match" type="submit">Join</button>
        </form>
        <p id="join-error" role="alert" data-testid="join-error"></p>
        <section class="duel-entry" aria-labelledby="duel-title">
          <h2 id="duel-title">Duel (combat spike)</h2>
          <div class="duel-buttons">
            <button id="create-duel" type="button">Create duel</button>
            <button id="practice-duel" type="button">Practice</button>
          </div>
          <form id="join-duel-form">
            <label for="duel-code">Duel code</label>
            <input id="duel-code" name="duel-code" maxlength="6" autocomplete="off" spellcheck="false" placeholder="K7Q2MX" required />
            <button id="join-duel" type="submit">Join duel</button>
          </form>
          <p id="duel-error" role="alert" data-testid="duel-error"></p>
        </section>
        <p class="version">Protocol v<span data-testid="landing-protocol"></span></p>
      </section>

      <section id="match" hidden>
        <div id="stage">
          <div id="flow-bar" aria-label="Match clock">
            <span data-testid="flow-phase" class="phase"></span>
            <span data-testid="match-timer" class="timer" role="timer" aria-label="Time left"></span>
            <span data-testid="flow-sector" class="sector"></span>
          </div>
          <div id="game" data-testid="game"></div>
          <div id="banner" data-testid="banner" role="status" aria-live="assertive" hidden>
            <strong data-testid="banner-title"></strong>
            <span data-testid="banner-detail"></span>
          </div>
          <div id="compass" data-testid="compass" hidden>
            <span class="arrow" data-testid="compass-arrow" aria-hidden="true">➤</span>
            <span data-testid="compass-text"></span>
          </div>
          <div id="claim-panel" data-testid="claim-panel" hidden>
            <p data-testid="claim-text" aria-live="polite"></p>
            <span data-testid="claim-progress" class="progress claim" role="progressbar" aria-label="Claim progress" hidden></span>
            <p data-testid="claim-risk" class="risk" role="alert"></p>
          </div>
          <section id="ruin-panel" data-testid="ruin-panel" role="dialog" aria-labelledby="ruin-title" hidden>
            <h2 id="ruin-title">The ruin</h2>
            <p class="hint" data-testid="ruin-howto">
              Read the tablets and pick the three symbols in order (click them, or keys 1–6), or walk the grid from S to G with the arrows or
              WASD. Backspace undoes, Enter submits, Escape closes. A wrong answer locks you out for three seconds.
            </p>
            <ol data-testid="ruin-tablets" class="ruin-tablets" hidden></ol>
            <div data-testid="ruin-grid" class="ruin-grid" role="img" aria-label="The ruin's grid" hidden></div>
            <p class="ruin-entry">Your answer: <strong data-testid="ruin-entry"></strong></p>
            <div class="ruin-buttons">
              <button type="button" data-testid="ruin-undo">Undo</button>
              <button type="button" data-testid="ruin-submit" disabled>Submit</button>
              <button type="button" data-testid="ruin-close">Close</button>
            </div>
            <p data-testid="ruin-lockout" class="warning" role="timer" aria-live="polite"></p>
            <p data-testid="ruin-verdict" aria-live="polite"></p>
          </section>
          <section id="fruit-panel" data-testid="fruit-panel" role="dialog" aria-labelledby="fruit-title" hidden>
            <h2 id="fruit-title">Fruit pedestal: <span data-testid="fruit-name"></span></h2>
            <ul class="fruit-specials">
              <li data-testid="fruit-special-u"></li>
              <li data-testid="fruit-special-i"></li>
            </ul>
            <p data-testid="fruit-advantage"></p>
            <p data-testid="fruit-vulnerability"></p>
            <p class="fruit-eat">
              <span data-testid="fruit-progress" class="fruit-ring" role="progressbar" aria-label="Eating progress" hidden></span>
              <strong data-testid="fruit-hint"></strong>
            </p>
            <p data-testid="fruit-message" class="warning" aria-live="polite"></p>
            <p class="hint">Eating a fruit replaces your two specials (U, I) in every duel for the rest of the match. Escape closes.</p>
          </section>
          <section id="journal" data-testid="journal" role="dialog" aria-labelledby="journal-title" hidden>
            <h2 id="journal-title">Journal</h2>
            <p class="hint">M or Escape closes it. Tab moves between its buttons; Enter or Space presses one. You can keep sailing.</p>
            <h3>Current rumors</h3>
            <ol data-testid="journal-rumors" class="journal-rumors"></ol>
            <h3>Buy a targeted rumor</h3>
            <div data-testid="journal-buys" class="journal-buys"></div>
            <p data-testid="journal-message" aria-live="polite"></p>
            <h3>Islands you know</h3>
            <ul data-testid="journal-islands"></ul>
            <h3>Collected types</h3>
            <p data-testid="journal-collected"></p>
            <h3>Your kit: <span data-testid="journal-kit"></span></h3>
            <p data-testid="journal-kit-specials"></p>
            <p data-testid="journal-kit-description"></p>
            <button type="button" data-testid="journal-close">Close</button>
          </section>
          <div id="toast" data-testid="toast" role="status" aria-live="polite" hidden>
            <strong data-testid="toast-title"></strong>
            <span data-testid="toast-detail"></span>
          </div>
          <section id="results" data-testid="results" role="dialog" aria-labelledby="results-headline" hidden>
            <h2 id="results-headline" data-testid="results-headline"></h2>
            <p data-testid="results-detail"></p>
            <table data-testid="results-table">
              <thead></thead>
              <tbody></tbody>
            </table>
            <button id="back-to-lobby" type="button">Back to lobby</button>
          </section>
        </div>
        <aside id="lobby" data-testid="lobby" aria-label="Lobby" hidden>
          <h2>Lobby</h2>
          <p class="code-line">Code <strong data-testid="lobby-code"></strong></p>
          <ul data-testid="lobby-players"></ul>
          <button id="start-match" type="button" data-testid="start-match" hidden>Start match</button>
          <p data-testid="lobby-hint" class="hint" aria-live="polite"></p>
          <p data-testid="lobby-error" class="error" role="alert"></p>
        </aside>
        <aside id="purse" aria-label="Rubbings and gold">
          <dl>
            <dt>Gold</dt>
            <dd data-testid="purse-gold"></dd>
            <dt>Rubbings</dt>
            <dd data-testid="purse-rubbings"></dd>
          </dl>
          <p data-testid="purse-settlement" class="settlement" aria-live="polite"></p>
          <p data-testid="purse-choice" class="settlement"></p>
          <div id="theft-choice" data-testid="theft-choice" role="dialog" aria-label="Choose a rubbing to steal" hidden>
            <h2>Steal a rubbing</h2>
            <div data-testid="theft-options" class="theft-options"></div>
            <p data-testid="theft-deadline" class="hint"></p>
          </div>
        </aside>
        <aside id="hud" aria-label="Match status">
          <dl>
            <dt>Match code</dt>
            <dd data-testid="hud-code"></dd>
            <dt>Protocol</dt>
            <dd data-testid="hud-protocol"></dd>
            <dt>Players</dt>
            <dd data-testid="hud-players"></dd>
            <dt>Status</dt>
            <dd data-testid="hud-status"></dd>
            <dt>Mode</dt>
            <dd data-testid="hud-mode"></dd>
            <dt>You</dt>
            <dd data-testid="hud-self"></dd>
            <dt>Ship</dt>
            <dd data-testid="hud-dock"></dd>
            <dt>Harbour</dt>
            <dd data-testid="hud-dock-hint" aria-live="polite"></dd>
            <dt>Grapple</dt>
            <dd data-testid="hud-grapple"></dd>
            <dt>Warning</dt>
            <dd data-testid="hud-incoming" class="warning" role="alert"></dd>
            <dt>Protection</dt>
            <dd data-testid="hud-protection" aria-live="polite"></dd>
            <dt>Respawn</dt>
            <dd data-testid="hud-respawn" aria-live="polite"></dd>
            <dt>Island</dt>
            <dd data-testid="hud-island"></dd>
            <dt>Ruin</dt>
            <dd>
              <span data-testid="hud-ruin" aria-live="polite"></span>
              <strong data-testid="hud-ruin-verdict" class="ruin-verdict" aria-live="polite"></strong>
            </dd>
            <dt>Kit</dt>
            <dd data-testid="hud-kit"></dd>
            <dt>Fruit</dt>
            <dd data-testid="hud-pedestal" aria-live="polite"></dd>
            <dt>Ruins in sight</dt>
            <dd data-testid="hud-ruins-sighted"></dd>
            <dt>Cache</dt>
            <dd data-testid="hud-cache"></dd>
            <dt>Hold E</dt>
            <dd>
              <span data-testid="hud-hold" aria-live="polite"></span>
              <span data-testid="hud-hold-progress" class="progress" role="progressbar" aria-label="Hold progress" hidden></span>
            </dd>
            <dt>Last</dt>
            <dd data-testid="hud-result" aria-live="polite"></dd>
            <dt>Treasure</dt>
            <dd data-testid="hud-route" aria-live="polite"></dd>
          </dl>
          <h2>Reveals</h2>
          <ol data-testid="reveal-log" class="reveal-log"></ol>
          <h2>Ships in sight</h2>
          <ul data-testid="positions"></ul>
          <p class="hint">
            Up or W: sail ahead. Down or S: brake, then reverse. Left and right (A, D): turn. E: dock beside a dock (the Harbour line says
            when). An island's rubbings are locked behind its ruin: moored there, press R to read its clue and answer it (+40 gold; the first
            solver opens the island for everyone). Some docks have a fruit pedestal: press F to read its fruit, then hold F for three seconds
            to eat it (its kit replaces your specials in duels). Then keep holding E to collect its rubbing (six seconds), or to claim one from a recovery
            cache there. J:
            grapple the nearest ship ahead within six tiles; it lands after a second, unless the target sails out of range or out of its aim. A
            grapple that lands starts a duel; its winner has five seconds to pick a rubbing to steal (1 or 2). Hold every rubbing type and
            your compass points to the final island: stop inside its treasure circle and hold E for ten seconds to win. M opens the
            journal: your rumors, the islands you know, your types and kit, and, moored at a dock, a targeted rumor for 25 gold.
          </p>
        </aside>
      </section>

      <section id="duel" hidden>
        <div id="arena" data-testid="arena"></div>
        <aside id="duel-hud" aria-label="Duel status">
          <dl>
            <dt>Duel code</dt>
            <dd data-testid="duel-code"></dd>
            <dt>Status</dt>
            <dd data-testid="duel-status"></dd>
            <dt>Phase</dt>
            <dd data-testid="duel-phase"></dd>
            <dt>Round clock</dt>
            <dd data-testid="duel-clock"></dd>
          </dl>
          <div class="fighters">
            <div class="fighter p1">
              <span class="name" data-testid="duel-name-0"></span>
              <span class="kit" data-testid="duel-kit-0"></span>
              <div class="bar health" data-testid="duel-health-0" role="img" aria-label="Player 1 health"></div>
              <span class="value" data-testid="duel-health-text-0"></span>
              <div class="bar stamina" data-testid="duel-stamina-0" role="img" aria-label="Player 1 stamina"></div>
            </div>
            <div class="fighter p2">
              <span class="name" data-testid="duel-name-1"></span>
              <span class="kit" data-testid="duel-kit-1"></span>
              <div class="bar health" data-testid="duel-health-1" role="img" aria-label="Player 2 health"></div>
              <span class="value" data-testid="duel-health-text-1"></span>
              <div class="bar stamina" data-testid="duel-stamina-1" role="img" aria-label="Player 2 stamina"></div>
            </div>
          </div>
          <p class="connection" data-testid="duel-connection">
            Round trip <span data-testid="duel-rtt"></span> · input delay <span data-testid="duel-delay"></span> · corrections
            <span data-testid="duel-corrections"></span>
          </p>
          <div id="duel-result" data-testid="duel-result" hidden>
            <h2 data-testid="duel-result-text"></h2>
          </div>
          <label class="toggle"><input id="show-boxes" type="checkbox" data-testid="hitbox-toggle" /> Show hitboxes (developer)</label>
          <label id="dummy-control" class="toggle" hidden>
            Dummy
            <select id="dummy-select" data-testid="dummy-select">
              <option value="idle">idle</option>
              <option value="guard">guard</option>
            </select>
          </label>
          <p class="hint">
            Move: WASD or the arrow keys (hold back to guard, down-back for lows). J light, K heavy, U and I specials, Shift dash, J and K
            together to throw (or to escape a throw). Down + K sweeps low, forward + K launches, down + J is the anti-air.
          </p>
        </aside>
      </section>
    </main>
    <script type="module" src="/src/main.ts"></script>
  </body>
</html>
