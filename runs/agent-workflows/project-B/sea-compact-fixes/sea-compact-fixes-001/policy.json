{
  "version": "1.2.0",
  "feature": "Pirate Sea Race compact sea (review fixes and docking feel)",
  "independent_review": true,
  "integration_approval": true,
  "max_verification_attempts": 3,
  "setup": [
    {
      "argv": [
        "npm",
        "ci"
      ],
      "timeout_seconds": 900
    }
  ],
  "workers": [
    {
      "node_id": "world",
      "role": "fullstack",
      "required_check_kinds": [
        "typecheck",
        "unit",
        "integration",
        "build",
        "browser"
      ],
      "owned_paths": [
        "README.md",
        "docs/architecture.md",
        "assets/source/maps",
        "scripts/build-map.ts",
        "packages/content/src/sailing.ts",
        "packages/content/src/sea.ts",
        "packages/content/src/seaMap.ts",
        "packages/content/src/seaValidation.ts",
        "packages/content/src/tiledMap.ts",
        "packages/content/src/maps",
        "packages/content/src/maps.test.ts",
        "packages/content/src/content.test.ts",
        "packages/content/src/index.ts",
        "packages/simulation/src/step.ts",
        "packages/simulation/src/state.ts",
        "packages/simulation/src/config.ts",
        "packages/simulation/src/visibility.ts",
        "packages/simulation/src/simulation.test.ts",
        "packages/protocol/src",
        "packages/test-tools/src",
        "apps",
        "tests/integration",
        "tests/e2e"
      ],
      "checks": [
        {
          "id": "typecheck",
          "kind": "typecheck",
          "argv": [
            "npm",
            "run",
            "typecheck"
          ],
          "timeout_seconds": 300,
          "scenarios": []
        },
        {
          "id": "unit",
          "kind": "unit",
          "argv": [
            "npm",
            "run",
            "test:unit"
          ],
          "timeout_seconds": 300,
          "scenarios": []
        },
        {
          "id": "integration",
          "kind": "integration",
          "argv": [
            "npm",
            "run",
            "test:integration"
          ],
          "timeout_seconds": 300,
          "scenarios": []
        },
        {
          "id": "build",
          "kind": "build",
          "argv": [
            "npm",
            "run",
            "build"
          ],
          "timeout_seconds": 600,
          "scenarios": []
        },
        {
          "id": "browser",
          "kind": "browser",
          "argv": [
            "npx",
            "--no-install",
            "playwright",
            "test",
            "--config=tests/e2e/playwright.config.ts"
          ],
          "timeout_seconds": 900,
          "scenarios": [
            {
              "id": "join-private-match",
              "description": "One browser creates a private match from the landing page; the HUD shows the code, the protocol version, one player and a connected status."
            },
            {
              "id": "two-ships-sync",
              "description": "Two browsers join the same private match with their ships in sight of each other; one sails with the keyboard and the other browser's view shows that ship at the new server-authoritative position."
            },
            {
              "id": "sail-and-dock",
              "description": "A browser sails its ship around a shoal to an island dock with the keyboard and docks there; the HUD shows the dock and the ship stops at it."
            },
            {
              "id": "out-of-sight",
              "description": "Two browsers in one match with their ships out of sight of each other: neither view lists or draws the other ship until one sails within the sight radius, and it disappears again when it sails away."
            },
            {
              "id": "duel-practice",
              "description": "One browser opens a practice duel against the dummy, lands a jab and then a keyboard throw (J then K a frame apart); the dummy's health bar and the HUD drop by the move data's damage, and hitboxes can be shown."
            },
            {
              "id": "duel-online",
              "description": "Two browsers: one creates a duel, the other joins by its code; after the countdown the first lands a strike on the second, and both views show the same authoritative health, round clock and result, with the connection line showing input delay and corrections."
            }
          ]
        }
      ]
    }
  ]
}
