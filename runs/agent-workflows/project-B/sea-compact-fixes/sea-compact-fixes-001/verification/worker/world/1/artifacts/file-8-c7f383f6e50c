/**
 * Writes `slice-sea.tmj` from the sketch in `sliceSeaSketch.ts`. From the repository root:
 *
 *   node assets/source/maps/sketch.ts && npm run map:build
 */
import { writeFileSync } from "node:fs";
import { sliceSeaTmj } from "./sliceSeaSketch.ts";

const target = new URL("slice-sea.tmj", import.meta.url);
const text = sliceSeaTmj();
writeFileSync(target, text);
const size = JSON.parse(text) as { width: number; height: number };
console.log(`wrote ${target.pathname}: ${size.width} × ${size.height} tiles`);
