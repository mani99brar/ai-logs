import {
  INPUT_HOLD_FRAMES,
  MAX_INPUT_MESSAGES_PER_SECOND,
  validateInputMessage,
  type InputContext,
  type InputRejection,
} from "@pirate-sea-race/protocol";
import { NEUTRAL_INPUT, quantizeAxis, STEPS_PER_SECOND, type PlayerInput } from "@pirate-sea-race/simulation";

export type DropReason = InputRejection | "rate-limited";

/** A protocol validator: `validateInputMessage` for world input, `validateDuelInputMessage` for duel input. */
export type InputValidator<T extends { readonly seq: number }> = (
  message: unknown,
  context: InputContext,
) => { ok: true; input: T } | { ok: false; reason: InputRejection };

/**
 * The admission both input gates share, so their limits cannot drift apart: at most MAX_INPUT_MESSAGES_PER_SECOND
 * messages in each window of STEPS_PER_SECOND room ticks, then the protocol's validation (size, schema, a sequence
 * number above the last accepted one, the future-frame limit). Every drop is counted by reason.
 */
export class InputAdmission<T extends { readonly seq: number }> {
  private lastAcceptedSeq = 0;
  private windowStart = 0;
  private windowCount = 0;
  readonly dropped: Record<DropReason, number> = {
    "rate-limited": 0,
    oversized: 0,
    malformed: 0,
    "stale-sequence": 0,
    "future-frame": 0,
  };

  constructor(private readonly validate: InputValidator<T>) {}

  /**
   * Takes one untrusted message at room tick `tick` (for the rate window) when the server's frame is `serverFrame`
   * (for the future-frame limit). Returns the accepted message, or why it was dropped.
   */
  admit(message: unknown, tick: number, serverFrame: number): { ok: true; input: T } | { ok: false; reason: DropReason } {
    if (tick - this.windowStart >= STEPS_PER_SECOND) {
      this.windowStart = tick;
      this.windowCount = 0;
    }
    if (++this.windowCount > MAX_INPUT_MESSAGES_PER_SECOND) return this.drop("rate-limited");
    const result = this.validate(message, { lastAcceptedSeq: this.lastAcceptedSeq, serverFrame });
    if (!result.ok) return this.drop(result.reason);
    this.lastAcceptedSeq = result.input.seq;
    return result;
  }

  private drop(reason: DropReason): { ok: false; reason: DropReason } {
    this.dropped[reason]++;
    return { ok: false, reason };
  }
}

/**
 * One client's input channel on the server: it admits messages under the rate cap, validates them against the
 * protocol and the client's last sequence, and holds the latest accepted intent for the simulation. A held input
 * lapses to neutral when no fresh one arrives within INPUT_HOLD_FRAMES (§15). World logic reads input only every
 * third frame, so a button pressed at any point since the last world step is latched until the next one (see
 * `worldStepTaken`): a quick tap released between two world steps still counts.
 */
export class InputGate {
  private readonly admission = new InputAdmission(validateInputMessage);
  private held: PlayerInput = NEUTRAL_INPUT;
  private heldAtFrame = 0;
  /** Buttons seen in any accepted message since the last world step. */
  private latchedButtons = 0;

  /** Messages dropped, by reason. */
  get dropped(): Record<DropReason, number> {
    return this.admission.dropped;
  }

  /** Takes one untrusted message at the server's current frame. Returns why it was dropped, or undefined. */
  receive(message: unknown, serverFrame: number): DropReason | undefined {
    // The match room ticks once per frame, so its frame is also the rate window's clock.
    const result = this.admission.admit(message, serverFrame, serverFrame);
    if (!result.ok) return result.reason;
    this.held = {
      buttons: result.input.buttons,
      moveX: quantizeAxis(result.input.moveX),
      moveY: quantizeAxis(result.input.moveY),
    };
    this.heldAtFrame = serverFrame;
    this.latchedButtons |= result.input.buttons;
    return undefined;
  }

  /**
   * Whether the client has sent nothing the simulation could use at `frame`: its held input has lapsed and no button
   * is latched. The match room then gives the simulation no input for the ship at all, rather than neutral input, so a
   * stall cannot release the throttle a moored ship keeps (see `StepInputs`).
   */
  lapsedAt(frame: number): boolean {
    return frame - this.heldAtFrame > INPUT_HOLD_FRAMES && this.latchedButtons === 0;
  }

  /** The intent the simulation uses for `frame`: the held input, plus any button latched since the last world step. */
  inputAt(frame: number): PlayerInput {
    const held = frame - this.heldAtFrame > INPUT_HOLD_FRAMES ? NEUTRAL_INPUT : this.held;
    const buttons = held.buttons | this.latchedButtons;
    return buttons === held.buttons ? held : { ...held, buttons };
  }

  /** Called after each world step has read `inputAt`: latched buttons have been seen and are released. */
  worldStepTaken(): void {
    this.latchedButtons = 0;
  }
}
