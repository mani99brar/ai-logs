new file mode 100644
index 0000000..22f8308
--- /dev/null
+++ b/packages/content/src/moves/version.ts
@@ -0,0 +1,59 @@
+import type { DuelMoveset } from "./schema.js";
+
+/**
+ * Canonical JSON (object keys sorted, safe integers only), the same text `hashState` in `packages/simulation` hashes,
+ * so a moveset's version is also its state hash.
+ */
+function canonical(value: unknown): string {
+  if (value === null) return "null";
+  switch (typeof value) {
+    case "number":
+      if (!Number.isSafeInteger(value)) throw new TypeError(`move data numbers must be safe integers, got ${value}`);
+      return String(value);
+    case "string":
+      return JSON.stringify(value);
+    case "boolean":
+      return value ? "true" : "false";
+    case "object": {
+      if (Array.isArray(value)) return `[${value.map(canonical).join(",")}]`;
+      const entries = Object.keys(value)
+        .sort()
+        .filter((key) => (value as Record<string, unknown>)[key] !== undefined)
+        .map((key) => `${JSON.stringify(key)}:${canonical((value as Record<string, unknown>)[key])}`);
+      return `{${entries.join(",")}}`;
+    }
+    default:
+      throw new TypeError(`move data cannot hold a ${typeof value}`);
+  }
+}
+
+const FNV_OFFSET = 0xcbf29ce484222325n;
+const FNV_PRIME = 0x100000001b3n;
+const MASK_64 = 0xffffffffffffffffn;
+
+/** 64-bit FNV-1a over the UTF-16 code units of a string, as 16 hex digits. */
+function fnv1a64(text: string): string {
+  let hash = FNV_OFFSET;
+  for (let index = 0; index < text.length; index++) {
+    const unit = text.charCodeAt(index);
+    hash = ((hash ^ BigInt(unit & 0xff)) * FNV_PRIME) & MASK_64;
+    hash = ((hash ^ BigInt(unit >>> 8)) * FNV_PRIME) & MASK_64;
+  }
+  return hash.toString(16).padStart(16, "0");
+}
+
+/** Move data is immutable, so each moveset object is hashed once. */
+const versions = new WeakMap<DuelMoveset, string>();
+
+/**
+ * Identifies a moveset by its data: the 64-bit hash of all of it. A duel state records it, and restoring, replaying
+ * or stepping a duel against other data is refused, so changed data can never keep an old version.
+ */
+export function movesetVersion(moveset: DuelMoveset): string {
+  let version = versions.get(moveset);
+  if (version === undefined) {
+    version = fnv1a64(canonical(moveset));
+    versions.set(moveset, version);
+  }
+  return version;
+}
