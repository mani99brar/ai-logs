/** 16 sub-pixels per arena pixel; `px(4)` is 4 pixels. */
const SUB_PIXELS_PER_PIXEL = 16;
const px = (pixels: number) => pixels * SUB_PIXELS_PER_PIXEL;

/** A §8 baseline row by id: the four baseline moves take their timing from the table itself, never a copy. */
function baseline<Id extends (typeof baselineFrameBudgets)[number]["id"]>(id: Id) {
  const row = baselineFrameBudgets.find((candidate) => candidate.id === id);
  if (row === undefined) throw new Error(`no baseline frame budget "${id}"`);
  return row as Extract<(typeof baselineFrameBudgets)[number], { id: Id }>;
}

