{
  "version": "1.2.0",
  "feature": "Pirate Sea Race duel core fixes",
  "independent_review": true,
  "integration_approval": true,
  "max_verification_attempts": 3,
  "setup": [
    {
      "argv": [
        "npm",
        "ci"
      ],
      "timeout_seconds": 900
    }
  ],
  "workers": [
    {
      "node_id": "duel",
      "role": "simulation",
      "required_check_kinds": [
        "typecheck",
        "unit",
        "integration",
        "build"
      ],
      "owned_paths": [
        "packages/simulation/src/duel",
        "packages/simulation/package.json",
        "packages/content/src/moves",
        "packages/content/package.json",
        "packages/test-tools/src/replay",
        "packages/test-tools/package.json",
        "docs/duel.md"
      ],
      "checks": [
        {
          "id": "typecheck",
          "kind": "typecheck",
          "argv": [
            "npm",
            "run",
            "typecheck"
          ],
          "timeout_seconds": 300,
          "scenarios": []
        },
        {
          "id": "unit",
          "kind": "unit",
          "argv": [
            "npm",
            "run",
            "test:unit"
          ],
          "timeout_seconds": 300,
          "scenarios": []
        },
        {
          "id": "integration",
          "kind": "integration",
          "argv": [
            "npm",
            "run",
            "test:integration"
          ],
          "timeout_seconds": 300,
          "scenarios": []
        },
        {
          "id": "build",
          "kind": "build",
          "argv": [
            "npm",
            "run",
            "build"
          ],
          "timeout_seconds": 600,
          "scenarios": []
        }
      ]
    }
  ]
}
