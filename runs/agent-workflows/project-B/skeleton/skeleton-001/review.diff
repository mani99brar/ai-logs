+/**
+ * The sea is a bounded rectangle of tiles laid out like screen coordinates: origin (0,0) at the top-left, x grows
+ * right and y grows down. Every tile is split into a fixed integer number of sub-units, and all positions and speeds
+ * in the simulation are integer sub-units.
+ */
+export interface SeaMapDefinition {
+  readonly widthTiles: number;
+  readonly heightTiles: number;
+  readonly subUnitsPerTile: number;
+}
+
+export const seaMap: SeaMapDefinition = {
+  widthTiles: 48,
+  heightTiles: 32,
+  subUnitsPerTile: 256,
+};
+
+export interface ShipTuning {
+  /** Distance a ship at full throttle covers in one 20 Hz world step. */
+  readonly speedSubUnitsPerWorldStep: number;
+}
+
+/** 64 sub-units per world step is 1280 per second: five tiles a second. */
+export const shipTuning: ShipTuning = {
+  speedSubUnitsPerWorldStep: 64,
+};
+
+/** A prevalidated outer-sea spawn position (§2), as the tile whose centre the ship starts on. */
+export interface SpawnSlot {
+  readonly tileX: number;
+  readonly tileY: number;
+}
+
+/** Eight slots around the outer sea, far enough apart that neighbouring ships start out of engagement range. */
+export const spawnSlots: readonly SpawnSlot[] = [
+  { tileX: 4, tileY: 4 },
+  { tileX: 24, tileY: 3 },
+  { tileX: 43, tileY: 4 },
+  { tileX: 44, tileY: 16 },
+  { tileX: 43, tileY: 27 },
+  { tileX: 24, tileY: 28 },
+  { tileX: 4, tileY: 27 },
+  { tileX: 3, tileY: 16 },
+];
+
+/** A private match (§2): custom, with a ship for every player as soon as they join. */
+export interface PrivateMatchRules {
+  readonly minPlayers: number;
+  readonly maxPlayers: number;
+  readonly custom: true;
+}
+
+export const privateMatch: PrivateMatchRules = {
+  minPlayers: 1,
+  maxPlayers: 8,
+  custom: true,
+};
