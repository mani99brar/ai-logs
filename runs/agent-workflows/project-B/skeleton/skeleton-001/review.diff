@@ -0,0 +1,30 @@
+/** Movement axes enter the simulation as integers in [-AXIS_SCALE, AXIS_SCALE]. */
+export const AXIS_SCALE = 1000;
+
+/** One player's held intent for a step. `buttons` is a bit field; this feature uses movement only. */
+export interface PlayerInput {
+  readonly buttons: number;
+  readonly moveX: number;
+  readonly moveY: number;
+}
+
+export const NEUTRAL_INPUT: PlayerInput = { buttons: 0, moveX: 0, moveY: 0 };
+
+/** Turns a protocol axis in [-1, 1] into simulation units. Out-of-range values clamp; anything non-finite is 0. */
+export function quantizeAxis(axis: number): number {
+  if (!Number.isFinite(axis)) return 0;
+  const clamped = axis < -1 ? -1 : axis > 1 ? 1 : axis;
+  return Math.round(clamped * AXIS_SCALE);
+}
+
+/** Keeps a simulation input inside its integer bounds whatever the caller passed. */
+export function sanitizeInput(input: PlayerInput | undefined): PlayerInput {
+  if (input === undefined) return NEUTRAL_INPUT;
+  const axis = (value: number) =>
+    Number.isInteger(value) ? Math.max(-AXIS_SCALE, Math.min(AXIS_SCALE, value)) : 0;
+  return {
+    buttons: Number.isInteger(input.buttons) ? input.buttons >>> 0 : 0,
+    moveX: axis(input.moveX),
+    moveY: axis(input.moveY),
+  };
+}
diff --git a/packages/simulation/src/random.ts b/packages/simulation/src/random.ts
new file mode 100644
index 0000000..6c6fee0
--- /dev/null
+++ b/packages/simulation/src/random.ts
@@ -0,0 +1,18 @@
+/**
+ * A seeded 32-bit generator (mulberry32). Its whole state is one unsigned integer kept in the match state, so a
+ * snapshot restores the random sequence exactly.
+ */
+export function nextRandom(state: number): { value: number; state: number } {
+  const next = (state + 0x6d2b79f5) >>> 0;
+  let t = next;
+  t = Math.imul(t ^ (t >>> 15), t | 1);
+  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+  return { value: (t ^ (t >>> 14)) >>> 0, state: next };
+}
+
+/** An integer in [0, bound), for bounds up to 2^32. The modulo bias is negligible for the small bounds used here. */
+export function nextInt(state: number, bound: number): { value: number; state: number } {
+  if (!Number.isInteger(bound) || bound <= 0) throw new RangeError(`bound must be a positive integer, got ${bound}`);
+  const drawn = nextRandom(state);
+  return { value: drawn.value % bound, state: drawn.state };
+}
diff --git a/packages/simulation/src/simulation.test.ts b/packages/simulation/src/simulation.test.ts
new file mode 100644
index 0000000..fc0307b
--- /dev/null
+++ b/packages/simulation/src/simulation.test.ts
@@ -0,0 +1,178 @@
+import { describe, expect, it } from "vitest";
+import {
+  AXIS_SCALE,
+  addShip,
+  createMatchState,
+  defaultSimulationConfig as config,
+  hashState,
+  isqrt,
+  mapBounds,
+  quantizeAxis,
+  removeShip,
+  step,
+  toTilePosition,
+  WORLD_STEP_INTERVAL,
+  type MatchState,
+  type PlayerInput,
+} from "./index.js";
+
+interface LoggedInput {
+  readonly frame: number;
+  readonly shipId: string;
+  readonly input: PlayerInput;
+}
+
+/** Replays an input log: each entry becomes that ship's held input from its frame on. */
+function run(initial: MatchState, log: readonly LoggedInput[], steps: number): MatchState {
+  let state = initial;
+  const held: Record<string, PlayerInput> = {};
+  for (let index = 0; index < steps; index++) {
+    const frame = state.frame + 1;
+    for (const entry of log) if (entry.frame === frame) held[entry.shipId] = entry.input;
+    state = step(config, state, held);
+  }
+  return state;
+}
+
+function matchWithShips(seed: number, ids: readonly string[]): MatchState {
+  return ids.reduce((state, id) => addShip(config, state, id), createMatchState(seed));
+}
+
+const move = (moveX: number, moveY: number): PlayerInput => ({ buttons: 0, moveX, moveY });
+
+const inputLog: LoggedInput[] = [
+  { frame: 1, shipId: "a", input: move(AXIS_SCALE, 0) },
+  { frame: 10, shipId: "b", input: move(0, -AXIS_SCALE) },
+  { frame: 90, shipId: "a", input: move(AXIS_SCALE, AXIS_SCALE) },
+  { frame: 200, shipId: "c", input: move(-600, 300) },
+  { frame: 320, shipId: "b", input: move(0, 0) },
+  { frame: 450, shipId: "a", input: move(-AXIS_SCALE, 0) },
+];
+
+describe("determinism", () => {
+  it("gives the same hash for the same initial state and input log after 600 steps", () => {
+    const first = run(matchWithShips(1234, ["a", "b", "c"]), inputLog, 600);
+    const second = run(matchWithShips(1234, ["a", "b", "c"]), inputLog, 600);
+    expect(first.frame).toBe(600);
+    expect(hashState(first)).toBe(hashState(second));
+    expect(first).toEqual(second);
+  });
+
+  it("gives a different hash when one input changes", () => {
+    const changed = inputLog.map((entry, index) => (index === 3 ? { ...entry, input: move(-600, -300) } : entry));
+    const original = run(matchWithShips(1234, ["a", "b", "c"]), inputLog, 600);
+    const altered = run(matchWithShips(1234, ["a", "b", "c"]), changed, 600);
+    expect(hashState(altered)).not.toBe(hashState(original));
+  });
+
+  it("hashes the complete state, including the generator", () => {
+    const state = matchWithShips(1, ["a"]);
+    expect(hashState({ ...state, rng: state.rng + 1 })).not.toBe(hashState(state));
+    expect(hashState({ ...state, frame: 1 })).not.toBe(hashState(state));
+  });
+
+  it("does not depend on key order", () => {
+    const state = matchWithShips(99, ["a", "b"]);
+    const reordered = { ships: state.ships.map((ship) => ({ ...ship })).map((ship) => {
+      const { heading, vy, vx, y, x, slot, id } = ship;
+      return { heading, vy, vx, y, x, slot, id };
+    }), rng: state.rng, worldTick: state.worldTick, frame: state.frame };
+    expect(hashState(reordered)).toBe(hashState(state));
+  });
+
+  it("keeps every number in the state an integer", () => {
+    const state = run(matchWithShips(7, ["a", "b", "c"]), inputLog, 600);
+    for (const ship of state.ships) {
+      for (const value of [ship.x, ship.y, ship.vx, ship.vy, ship.heading, ship.slot]) expect(Number.isInteger(value)).toBe(true);
+    }
+  });
+
+  it("does not mutate the state it is given", () => {
+    const state = Object.freeze(matchWithShips(5, ["a"]));
+    expect(() => step(config, state, { a: move(AXIS_SCALE, 0) })).not.toThrow();
+    expect(state.frame).toBe(0);
+  });
+});
+
+describe("clock", () => {
+  it("advances world logic only on every third step", () => {
+    let state = matchWithShips(42, ["a"]);
+    const start = state.ships[0]!;
+    const inputs = { a: move(AXIS_SCALE, 0) };
+    for (let frame = 1; frame <= 30; frame++) {
+      const before = state;
+      state = step(config, state, inputs);
+      expect(state.frame).toBe(frame);
+      if (frame % WORLD_STEP_INTERVAL === 0) {
+        expect(state.worldTick).toBe(before.worldTick + 1);
+        expect(state.ships[0]!.x).toBeGreaterThan(before.ships[0]!.x);
+      } else {
+        expect(state.worldTick).toBe(before.worldTick);
+        expect(state.ships).toBe(before.ships);
+      }
+    }
+    expect(state.worldTick).toBe(10);
+    expect(state.ships[0]!.x - start.x).toBe(10 * config.ship.speedSubUnitsPerWorldStep);
+  });
+});
+
+describe("movement", () => {
+  it("normalises diagonals with integer maths", () => {
+    const state = step(config, step(config, step(config, matchWithShips(3, ["a"]), {}), {}), { a: move(AXIS_SCALE, AXIS_SCALE) });
+    const ship = state.ships[0]!;
+    const speed = config.ship.speedSubUnitsPerWorldStep;
+    expect(ship.vx).toBe(ship.vy);
+    expect(isqrt(ship.vx * ship.vx + ship.vy * ship.vy)).toBeLessThanOrEqual(speed);
+    expect(ship.vx).toBe(Math.trunc((speed * AXIS_SCALE) / isqrt(2 * AXIS_SCALE * AXIS_SCALE)));
+  });
+
+  it("clamps ships to the map bounds", () => {
+    const state = run(matchWithShips(3, ["a"]), [{ frame: 1, shipId: "a", input: move(-AXIS_SCALE, -AXIS_SCALE) }], 60 * 30);
+    const ship = state.ships[0]!;
+    expect(ship.x).toBe(0);
+    expect(ship.y).toBe(0);
+    const far = run(matchWithShips(3, ["a"]), [{ frame: 1, shipId: "a", input: move(AXIS_SCALE, AXIS_SCALE) }], 60 * 30);
+    expect(far.ships[0]!.x).toBe(mapBounds(config).maxX);
+    expect(far.ships[0]!.y).toBe(mapBounds(config).maxY);
+    const corner = toTilePosition(config, far.ships[0]!.x, far.ships[0]!.y);
+    expect(corner.tileX).toBe(config.map.widthTiles - 1);
+    expect(corner.tileY).toBe(config.map.heightTiles - 1);
+  });
+
+  it("treats an out-of-range simulation axis as clamped", () => {
+    const wild = step(config, step(config, step(config, matchWithShips(3, ["a"]), {}), {}), { a: move(50 * AXIS_SCALE, 0) });
+    expect(wild.ships[0]!.vx).toBe(config.ship.speedSubUnitsPerWorldStep);
+  });
+
+  it("quantizes protocol axes into integer simulation units", () => {
+    expect(quantizeAxis(1)).toBe(AXIS_SCALE);
+    expect(quantizeAxis(-0.5)).toBe(-AXIS_SCALE / 2);
+    expect(quantizeAxis(7)).toBe(AXIS_SCALE);
+    expect(quantizeAxis(Number.NaN)).toBe(0);
+  });
+
+  it("reads a position as a tile plus an offset", () => {
+    const size = config.map.subUnitsPerTile;
+    expect(toTilePosition(config, 3 * size + 5, 2 * size)).toEqual({ tileX: 3, tileY: 2, offsetX: 5, offsetY: 0 });
+  });
+});
+
+describe("spawning", () => {
+  it("gives eight ships eight different slots, chosen by the seeded generator", () => {
+    const ids = ["a", "b", "c", "d", "e", "f", "g", "h"];
+    const state = matchWithShips(2024, ids);
+    expect(new Set(state.ships.map((ship) => ship.slot)).size).toBe(8);
+    expect(() => addShip(config, state, "i")).toThrow(/no free spawn slot/);
+    const other = matchWithShips(2025, ids);
+    expect(other.ships.map((ship) => ship.slot)).not.toEqual(state.ships.map((ship) => ship.slot));
+  });
+
+  it("frees a slot when a ship leaves", () => {
+    const state = removeShip(matchWithShips(1, ["a", "b"]), "a");
+    expect(state.ships.map((ship) => ship.id)).toEqual(["b"]);
+  });
+
+  it("refuses a duplicate ship id", () => {
+    expect(() => addShip(config, matchWithShips(1, ["a"]), "a")).toThrow();
+  });
+});
diff --git a/packages/simulation/src/state.ts b/packages/simulation/src/state.ts
new file mode 100644
index 0000000..a6730d9
--- /dev/null
+++ b/packages/simulation/src/state.ts
@@ -0,0 +1,74 @@
+import { mapBounds, type SimulationConfig } from "./config.js";
+import { nextInt } from "./random.js";
+
+/** 60 fixed steps per second: the one match clock (§15). */
+export const STEPS_PER_SECOND = 60;
+/** World logic runs on every third step, 20 times a second (§15). */
+export const WORLD_STEP_INTERVAL = 3;
+
+/** A ship on the sea. Every number is an integer; positions and velocities are in sub-units. */
+export interface ShipState {
+  readonly id: string;
+  readonly slot: number;
+  readonly x: number;
+  readonly y: number;
+  readonly vx: number;
+  readonly vy: number;
+  /** Eight compass headings, 0 = east, counting clockwise because y grows down. */
+  readonly heading: number;
+}
+
+/** The complete match state: plain, serializable data that `hashState` covers entirely. */
+export interface MatchState {
+  /** Steps completed on the 60 Hz match clock. */
+  readonly frame: number;
+  /** World steps completed (every third frame). */
+  readonly worldTick: number;
+  /** The seeded generator's state. */
+  readonly rng: number;
+  /** In join order. */
+  readonly ships: readonly ShipState[];
+}
+
+export function createMatchState(seed: number): MatchState {
+  if (!Number.isInteger(seed)) throw new RangeError(`seed must be an integer, got ${seed}`);
+  return { frame: 0, worldTick: 0, rng: seed >>> 0, ships: [] };
+}
+
+/** Adds a ship on a random free spawn slot. Two ships never share a slot. */
+export function addShip(config: SimulationConfig, state: MatchState, id: string): MatchState {
+  if (state.ships.some((ship) => ship.id === id)) throw new Error(`ship ${id} already exists`);
+  const taken = new Set(state.ships.map((ship) => ship.slot));
+  const free = config.spawnSlots.map((_, index) => index).filter((index) => !taken.has(index));
+  if (free.length === 0) throw new Error("no free spawn slot");
+  const drawn = nextInt(state.rng, free.length);
+  const slot = free[drawn.value]!;
+  const spawn = config.spawnSlots[slot]!;
+  const half = Math.floor(config.map.subUnitsPerTile / 2);
+  const { maxX, maxY } = mapBounds(config);
+  const ship: ShipState = {
+    id,
+    slot,
+    x: Math.min(spawn.tileX * config.map.subUnitsPerTile + half, maxX),
+    y: Math.min(spawn.tileY * config.map.subUnitsPerTile + half, maxY),
+    vx: 0,
+    vy: 0,
+    heading: 0,
+  };
+  return { ...state, rng: drawn.state, ships: [...state.ships, ship] };
+}
+
+export function removeShip(state: MatchState, id: string): MatchState {
+  return { ...state, ships: state.ships.filter((ship) => ship.id !== id) };
+}
+
+/** A position as the tile it lies on plus the sub-unit offset inside that tile. */
+export function toTilePosition(config: SimulationConfig, x: number, y: number) {
+  const size = config.map.subUnitsPerTile;
+  return {
+    tileX: Math.floor(x / size),
+    tileY: Math.floor(y / size),
+    offsetX: x % size,
+    offsetY: y % size,
+  };
+}
diff --git a/packages/simulation/src/step.ts b/packages/simulation/src/step.ts
new file mode 100644
index 0000000..1e67ad9
--- /dev/null
+++ b/packages/simulation/src/step.ts
@@ -0,0 +1,55 @@
+import { mapBounds, type SimulationConfig } from "./config.js";
+import { clampInt, divTrunc, isqrt } from "./fixed.js";
+import { AXIS_SCALE, sanitizeInput, type PlayerInput } from "./input.js";
+import { WORLD_STEP_INTERVAL, type MatchState, type ShipState } from "./state.js";
+
+/** Held inputs by ship id; a ship without an entry is neutral. */
+export type StepInputs = Readonly<Record<string, PlayerInput>>;
+
+export function isWorldStep(frame: number): boolean {
+  return frame % WORLD_STEP_INTERVAL === 0;
+}
+
+/**
+ * Advances the match clock by one 60 Hz step and returns the new state. World logic (ship movement) runs only when
+ * the new frame is a multiple of WORLD_STEP_INTERVAL. The input state is never mutated.
+ */
+export function step(config: SimulationConfig, state: MatchState, inputs: StepInputs): MatchState {
+  const frame = state.frame + 1;
+  if (!isWorldStep(frame)) return { ...state, frame };
+  return {
+    ...state,
+    frame,
+    worldTick: state.worldTick + 1,
+    ships: state.ships.map((ship) => moveShip(config, ship, sanitizeInput(inputs[ship.id]))),
+  };
+}
+
+function moveShip(config: SimulationConfig, ship: ShipState, input: PlayerInput): ShipState {
+  const speed = config.ship.speedSubUnitsPerWorldStep;
+  const { moveX, moveY } = input;
+  // Diagonals are normalised with an integer square root so full throttle is the same speed in every direction.
+  const length = isqrt(moveX * moveX + moveY * moveY);
+  const divisor = Math.max(length, AXIS_SCALE);
+  const vx = divTrunc(speed * moveX, divisor);
+  const vy = divTrunc(speed * moveY, divisor);
+  const { maxX, maxY } = mapBounds(config);
+  return {
+    ...ship,
+    x: clampInt(ship.x + vx, 0, maxX),
+    y: clampInt(ship.y + vy, 0, maxY),
+    vx,
+    vy,
+    heading: vx === 0 && vy === 0 ? ship.heading : headingOf(vx, vy),
+  };
+}
+
+/** Eight-way heading from the signs of the velocity (0 = east, clockwise with y down). */
+function headingOf(vx: number, vy: number): number {
+  const sx = Math.sign(vx);
+  const sy = Math.sign(vy);
+  const table: Record<string, number> = {
+    "1,0": 0, "1,1": 1, "0,1": 2, "-1,1": 3, "-1,0": 4, "-1,-1": 5, "0,-1": 6, "1,-1": 7,
+  };
+  return table[`${sx},${sy}`] ?? 0;
+}
