@@ -0,0 +1,53 @@
+import { z } from "zod";
+
+/**
+ * A rules preset (§18). The slice deliberately runs with fewer rubbing types, rubbings and islands than the alpha;
+ * keeping the difference in data means slice shortcuts cannot silently ship into the main mode.
+ */
+export const rulesPresetSchema = z
+  .strictObject({
+    id: z.enum(["slice", "alpha"]),
+    maxPlayers: z.int().min(1).max(8),
+    rubbingTypes: z.int().positive(),
+    rubbings: z.int().positive(),
+    islands: z.int().positive(),
+    sourcesPerIsland: z.int().positive(),
+    fruitKits: z.int().positive(),
+  })
+  .superRefine((preset, ctx) => {
+    if (preset.rubbings !== preset.islands * preset.sourcesPerIsland) {
+      ctx.addIssue({
+        code: "custom",
+        path: ["rubbings"],
+        message: `rubbings (${preset.rubbings}) must equal islands × sourcesPerIsland (${preset.islands * preset.sourcesPerIsland})`,
+      });
+    }
+    if (preset.rubbings % preset.rubbingTypes !== 0) {
+      ctx.addIssue({
+        code: "custom",
+        path: ["rubbingTypes"],
+        message: `rubbings (${preset.rubbings}) must split evenly across ${preset.rubbingTypes} types`,
+      });
+    }
+  });
+
+export type RulesPreset = z.infer<typeof rulesPresetSchema>;
+export type RulesPresetId = RulesPreset["id"];
+
+export const rulesPresets = {
+  /** Stage 2: four private players, four small islands with two sources each, two rubbing types, two fruits. */
+  slice: { id: "slice", maxPlayers: 4, rubbingTypes: 2, rubbings: 8, islands: 4, sourcesPerIsland: 2, fruitKits: 2 },
+  /** Stage 3: eight players, 12 islands with one source each, four rubbing types, six fruits. */
+  alpha: { id: "alpha", maxPlayers: 8, rubbingTypes: 4, rubbings: 12, islands: 12, sourcesPerIsland: 1, fruitKits: 6 },
+} as const satisfies Record<RulesPresetId, RulesPreset>;
+
+export type ValidationResult<T> = { ok: true; value: T } | { ok: false; issues: string[] };
+
+export function formatIssues(error: z.ZodError): string[] {
+  return error.issues.map((issue) => `${issue.path.join(".") || "(root)"}: ${issue.message}`);
+}
+
+export function validateRulesPreset(candidate: unknown): ValidationResult<RulesPreset> {
+  const parsed = rulesPresetSchema.safeParse(candidate);
+  return parsed.success ? { ok: true, value: parsed.data } : { ok: false, issues: formatIssues(parsed.error) };
+}
