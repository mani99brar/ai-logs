@@ -0,0 +1,21 @@
+/** Integer square root (floor) by Newton's method, so no floating-point transcendental ever enters the step. */
+export function isqrt(value: number): number {
+  if (!Number.isSafeInteger(value) || value < 0) throw new RangeError(`isqrt needs a non-negative safe integer, got ${value}`);
+  if (value < 2) return value;
+  let x = value;
+  let y = Math.floor((x + 1) / 2);
+  while (y < x) {
+    x = y;
+    y = Math.floor((x + Math.floor(value / x)) / 2);
+  }
+  return x;
+}
+
+/** Integer division rounding toward zero. */
+export function divTrunc(numerator: number, denominator: number): number {
+  return Math.trunc(numerator / denominator);
+}
+
+export function clampInt(value: number, min: number, max: number): number {
+  return value < min ? min : value > max ? max : value;
+}
diff --git a/packages/simulation/src/hash.ts b/packages/simulation/src/hash.ts
new file mode 100644
index 0000000..e5e3239
--- /dev/null
+++ b/packages/simulation/src/hash.ts
@@ -0,0 +1,48 @@
+/**
+ * Canonical serialization: object keys sorted, integers only for numbers, no undefined. Two equal states always
+ * serialize to the same string, whatever order their keys were written in.
+ */
+export function canonicalize(value: unknown): string {
+  if (value === null) return "null";
+  switch (typeof value) {
+    case "number":
+      if (!Number.isSafeInteger(value)) throw new TypeError(`state numbers must be safe integers, got ${value}`);
+      return String(value);
+    case "string":
+      return JSON.stringify(value);
+    case "boolean":
+      return value ? "true" : "false";
+    case "object": {
+      if (Array.isArray(value)) return `[${value.map(canonicalize).join(",")}]`;
+      const prototype = Object.getPrototypeOf(value);
+      if (prototype !== Object.prototype && prototype !== null) throw new TypeError("state must be plain data");
+      const entries = Object.keys(value)
+        .sort()
+        .filter((key) => (value as Record<string, unknown>)[key] !== undefined)
+        .map((key) => `${JSON.stringify(key)}:${canonicalize((value as Record<string, unknown>)[key])}`);
+      return `{${entries.join(",")}}`;
+    }
+    default:
+      throw new TypeError(`state cannot hold a ${typeof value}`);
+  }
+}
+
+const FNV_OFFSET = 0xcbf29ce484222325n;
+const FNV_PRIME = 0x100000001b3n;
+const MASK_64 = 0xffffffffffffffffn;
+
+/** 64-bit FNV-1a over the UTF-16 code units of a string, as 16 hex digits. */
+export function fnv1a64(text: string): string {
+  let hash = FNV_OFFSET;
+  for (let index = 0; index < text.length; index++) {
+    const unit = text.charCodeAt(index);
+    hash = ((hash ^ BigInt(unit & 0xff)) * FNV_PRIME) & MASK_64;
+    hash = ((hash ^ BigInt(unit >>> 8)) * FNV_PRIME) & MASK_64;
+  }
+  return hash.toString(16).padStart(16, "0");
+}
+
+/** A stable hash of the complete match state, independent of JavaScript engine and key order. */
+export function hashState(state: unknown): string {
+  return fnv1a64(canonicalize(state));
+}
