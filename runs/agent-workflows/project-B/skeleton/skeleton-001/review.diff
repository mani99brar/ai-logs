+  color: #e8f1f5;
+}
+
+body {
+  margin: 0;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+main {
+  padding: 1.5rem;
+}
+
+#landing:not([hidden]) {
+  max-width: 24rem;
+  margin: 4rem auto;
+  display: grid;
+  gap: 1rem;
+}
+
+h1 {
+  margin: 0;
+}
+
+.tagline,
+.version,
+.hint {
+  color: #9bb8c6;
+  margin: 0;
+}
+
+button,
+input {
+  font: inherit;
+  padding: 0.5rem 0.75rem;
+}
+
+#join-form {
+  display: flex;
+  gap: 0.5rem;
+  align-items: center;
+}
+
+#join-code {
+  text-transform: uppercase;
+  width: 7rem;
+}
+
+#join-error {
+  color: #ff9b8a;
+  min-height: 1.5em;
+  margin: 0;
+}
+
+#match:not([hidden]) {
+  display: flex;
+  gap: 1.5rem;
+  align-items: flex-start;
+}
+
+#game canvas {
+  display: block;
+}
+
+#hud dl {
+  display: grid;
+  grid-template-columns: auto auto;
+  gap: 0.25rem 1rem;
+  margin: 0;
+}
+
+#hud dt {
+  color: #9bb8c6;
+}
+
+#hud dd {
+  margin: 0;
+  font-variant-numeric: tabular-nums;
+}
+
+#hud ul {
+  list-style: none;
+  padding: 0;
+  font-variant-numeric: tabular-nums;
