new file mode 100644
index 0000000..c20fbe9
--- /dev/null
+++ b/packages/protocol/src/input.ts
@@ -0,0 +1,78 @@
+import { z } from "zod";
+
+export const MessageType = {
+  /** Client → server: the player's held intent. */
+  Input: "input",
+} as const;
+
+/** Largest input message accepted, measured as its JSON encoding. A valid one is well under 100 bytes. */
+export const MAX_INPUT_MESSAGE_BYTES = 128;
+/** How far ahead of the server's current frame an input's frame tag may be (§15: reject future-frame spam). */
+export const MAX_INPUT_LEAD_FRAMES = 30;
+/** Input messages a client may send per second of match time before the server drops the rest. */
+export const MAX_INPUT_MESSAGES_PER_SECOND = 60;
+/** The server repeats a held input for at most this many frames (250 ms) without a fresh one, then goes neutral. */
+export const INPUT_HOLD_FRAMES = 15;
+
+export const MAX_SEQUENCE = 2 ** 31 - 1;
+
+/** Button bits. Only movement is used in this feature; the bit field is reserved for world actions. */
+export const Buttons = {
+  Interact: 1 << 0,
+} as const;
+
+/**
+ * One frame-tagged input (§16): a strictly increasing sequence number, the client's estimate of the server frame,
+ * a button bit field and movement axes bounded to [-1, 1]. Axes outside the range are rejected, not clamped.
+ */
+export const inputMessageSchema = z.strictObject({
+  seq: z.int().min(1).max(MAX_SEQUENCE),
+  frame: z.int().min(0).max(MAX_SEQUENCE),
+  buttons: z.int().min(0).max(0xffff),
+  moveX: z.number().min(-1).max(1),
+  moveY: z.number().min(-1).max(1),
+});
+
+export type InputMessage = z.infer<typeof inputMessageSchema>;
+
+export type InputRejection = "oversized" | "malformed" | "stale-sequence" | "future-frame";
+
+export type InputValidation = { ok: true; input: InputMessage } | { ok: false; reason: InputRejection };
+
+/** What the server knows when a message arrives: the last sequence it accepted from this client, and its frame. */
+export interface InputContext {
+  readonly lastAcceptedSeq: number;
+  readonly serverFrame: number;
+}
+
+/** Size of a decoded message as JSON, or undefined when it cannot be encoded (cycles, BigInt). */
+export function encodedSize(message: unknown): number | undefined {
+  try {
+    const json = JSON.stringify(message);
+    return json === undefined ? undefined : utf8Length(json);
+  } catch {
+    return undefined;
+  }
+}
+
+function utf8Length(text: string): number {
+  let bytes = 0;
+  for (const char of text) {
+    const code = char.codePointAt(0)!;
+    bytes += code < 0x80 ? 1 : code < 0x800 ? 2 : code < 0x10000 ? 3 : 4;
+  }
+  return bytes;
+}
+
+/** Validates an untrusted input message against its schema and the sender's sequence and the server clock. */
+export function validateInputMessage(message: unknown, context: InputContext): InputValidation {
+  const size = encodedSize(message);
+  if (size === undefined) return { ok: false, reason: "malformed" };
+  if (size > MAX_INPUT_MESSAGE_BYTES) return { ok: false, reason: "oversized" };
+  const parsed = inputMessageSchema.safeParse(message);
+  if (!parsed.success) return { ok: false, reason: "malformed" };
+  const input = parsed.data;
+  if (input.seq <= context.lastAcceptedSeq) return { ok: false, reason: "stale-sequence" };
+  if (input.frame > context.serverFrame + MAX_INPUT_LEAD_FRAMES) return { ok: false, reason: "future-frame" };
+  return { ok: true, input };
+}
diff --git a/packages/protocol/src/join.ts b/packages/protocol/src/join.ts
new file mode 100644
index 0000000..79dd297
--- /dev/null
+++ b/packages/protocol/src/join.ts
@@ -0,0 +1,47 @@
+import { z } from "zod";
+import { PROTOCOL_VERSION } from "./version.js";
+
+export const MATCH_CODE_LENGTH = 6;
+export const MATCH_CODE_ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
+
+/** A private match code: six uppercase letters or digits, for example `K7Q2MX`. */
+export const matchCodeSchema = z.string().regex(/^[A-Z0-9]{6}$/);
+
+/** Players type codes in any case; the wire carries the canonical uppercase form. */
+export function normalizeMatchCode(input: string): string {
+  return input.trim().toUpperCase();
+}
+
+/** Options for creating a private match. The server generates the code. */
+export const createMatchOptionsSchema = z.object({
+  protocolVersion: z.int(),
+});
+
+/** Options for joining a private match by code. */
+export const joinMatchOptionsSchema = z.object({
+  protocolVersion: z.int(),
+  code: matchCodeSchema,
+});
+
+export type CreateMatchOptions = z.infer<typeof createMatchOptionsSchema>;
+export type JoinMatchOptions = z.infer<typeof joinMatchOptionsSchema>;
+
+/** Why the server refused a create or join. Colyseus answers matchmaking over HTTP, so these are HTTP statuses. */
+export const JoinRefusal = {
+  BadRequest: 400,
+  NoSuchMatch: 404,
+  MatchFull: 409,
+  ProtocolMismatch: 426,
+} as const;
+
+export type JoinRefusalCode = (typeof JoinRefusal)[keyof typeof JoinRefusal];
+
+export function protocolMismatchMessage(clientVersion: unknown): string {
+  return `Protocol version mismatch: this client speaks v${String(clientVersion)}, the server speaks v${PROTOCOL_VERSION}. Reload the page to update.`;
+}
+
+export const NO_SUCH_MATCH_MESSAGE = "No match with that code";
+
+export function matchFullMessage(maxPlayers: number): string {
+  return `That match is full (${maxPlayers} players)`;
+}
diff --git a/packages/protocol/src/protocol.test.ts b/packages/protocol/src/protocol.test.ts
new file mode 100644
index 0000000..21818f3
--- /dev/null
+++ b/packages/protocol/src/protocol.test.ts
@@ -0,0 +1,73 @@
+import { describe, expect, it } from "vitest";
+import {
+  MAX_INPUT_LEAD_FRAMES,
+  MAX_INPUT_MESSAGE_BYTES,
+  PROTOCOL_VERSION,
+  joinMatchOptionsSchema,
+  normalizeMatchCode,
+  validateInputMessage,
+  type InputContext,
+} from "./index.js";
+
+const context: InputContext = { lastAcceptedSeq: 4, serverFrame: 300 };
+const valid = { seq: 5, frame: 301, buttons: 0, moveX: 1, moveY: -0.5 };
+
+describe("input validation", () => {
+  it("accepts a valid input", () => {
+    expect(validateInputMessage(valid, context)).toEqual({ ok: true, input: valid });
+  });
+
+  it.each([
+    ["undefined", undefined],
+    ["a string", "left"],
+    ["an array", [5, 301, 0, 1, 0]],
+    ["a missing field", { seq: 5, frame: 301, buttons: 0, moveX: 1 }],
+    ["an extra field", { ...valid, x: 100 }],
+    ["a fractional sequence", { ...valid, seq: 5.5 }],
+    ["a negative frame", { ...valid, frame: -1 }],
+    ["a string axis", { ...valid, moveX: "1" }],
+    ["a NaN axis", { ...valid, moveX: Number.NaN }],
+    ["buttons out of range", { ...valid, buttons: 0x10000 }],
+    ["a BigInt field", { ...valid, seq: 5n }],
+  ])("rejects a malformed input: %s", (_label, message) => {
+    expect(validateInputMessage(message, context)).toEqual({ ok: false, reason: "malformed" });
+  });
+
+  it("rejects an oversized input before parsing it", () => {
+    const padded = { ...valid, padding: "x".repeat(MAX_INPUT_MESSAGE_BYTES) };
+    expect(validateInputMessage(padded, context)).toEqual({ ok: false, reason: "oversized" });
+    expect(validateInputMessage({ ...valid, note: "é".repeat(70) }, context)).toEqual({ ok: false, reason: "oversized" });
+  });
+
+  it("rejects a future-frame input", () => {
+    const limit = context.serverFrame + MAX_INPUT_LEAD_FRAMES;
+    expect(validateInputMessage({ ...valid, frame: limit }, context).ok).toBe(true);
+    expect(validateInputMessage({ ...valid, frame: limit + 1 }, context)).toEqual({ ok: false, reason: "future-frame" });
+  });
+
+  it("rejects a repeated or older sequence number", () => {
+    expect(validateInputMessage({ ...valid, seq: 4 }, context)).toEqual({ ok: false, reason: "stale-sequence" });
+    expect(validateInputMessage({ ...valid, seq: 1 }, context)).toEqual({ ok: false, reason: "stale-sequence" });
+  });
+
+  it("rejects movement axes outside [-1, 1] rather than clamping them", () => {
+    for (const axis of [1.0001, -1.5, 2, Number.POSITIVE_INFINITY]) {
+      expect(validateInputMessage({ ...valid, moveX: axis }, context)).toEqual({ ok: false, reason: "malformed" });
+      expect(validateInputMessage({ ...valid, moveY: axis }, context)).toEqual({ ok: false, reason: "malformed" });
+    }
+    expect(validateInputMessage({ ...valid, moveX: -1, moveY: 1 }, context).ok).toBe(true);
+  });
+});
+
+describe("join options", () => {
+  it("normalises typed codes to the canonical form", () => {
+    expect(normalizeMatchCode("  k7q2mx ")).toBe("K7Q2MX");
+  });
+
+  it("accepts a canonical code and refuses anything else", () => {
+    expect(joinMatchOptionsSchema.safeParse({ protocolVersion: PROTOCOL_VERSION, code: "K7Q2MX" }).success).toBe(true);
+    for (const code of ["k7q2mx", "K7Q2M", "K7Q2MXX", "K7-2MX", ""]) {
+      expect(joinMatchOptionsSchema.safeParse({ protocolVersion: PROTOCOL_VERSION, code }).success).toBe(false);
+    }
+  });
+});
