+    <title>Pirate Sea Race</title>
+    <link rel="stylesheet" href="/src/style.css" />
+  </head>
+  <body>
+    <main>
+      <section id="landing" aria-labelledby="title">
+        <h1 id="title">Pirate Sea Race</h1>
+        <p class="tagline">Private test match</p>
+        <button id="create-match" type="button">Create match</button>
+        <form id="join-form">
+          <label for="join-code">Match code</label>
+          <input id="join-code" name="code" maxlength="6" autocomplete="off" spellcheck="false" placeholder="K7Q2MX" required />
+          <button id="join-match" type="submit">Join</button>
+        </form>
+        <p id="join-error" role="alert" data-testid="join-error"></p>
+        <p class="version">Protocol v<span data-testid="landing-protocol"></span></p>
+      </section>
+
+      <section id="match" hidden>
+        <div id="game" data-testid="game"></div>
+        <aside id="hud" aria-label="Match status">
+          <dl>
+            <dt>Match code</dt>
+            <dd data-testid="hud-code"></dd>
+            <dt>Protocol</dt>
+            <dd data-testid="hud-protocol"></dd>
+            <dt>Players</dt>
+            <dd data-testid="hud-players"></dd>
+            <dt>Status</dt>
+            <dd data-testid="hud-status"></dd>
+            <dt>Mode</dt>
