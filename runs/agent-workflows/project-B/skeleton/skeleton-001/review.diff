diff --git a/apps/web/src/connection.ts b/apps/web/src/connection.ts
new file mode 100644
index 0000000..5951a7c
--- /dev/null
+++ b/apps/web/src/connection.ts
@@ -0,0 +1,33 @@
+import { Client, ErrorCode, type Room } from "@colyseus/sdk";
+import { MATCH_ROOM, NO_SUCH_MATCH_MESSAGE, normalizeMatchCode, PROTOCOL_VERSION } from "@pirate-sea-race/protocol";
+import type { MatchStateSchema } from "@pirate-sea-race/server/schema";
+
+export type MatchRoom = Room<unknown, MatchStateSchema>;
+
+const SERVER_PORT = 2593;
+
+/** The match server: `VITE_SERVER_URL` when set, otherwise port 2593 on the host that served the page. */
+export function serverEndpoint(location: Location): string {
+  const configured: unknown = import.meta.env["VITE_SERVER_URL"];
+  return typeof configured === "string" && configured !== "" ? configured : `${location.protocol}//${location.hostname}:${SERVER_PORT}`;
+}
+
+export function createMatch(endpoint: string): Promise<MatchRoom> {
+  return new Client(endpoint).create<MatchStateSchema>(MATCH_ROOM, { protocolVersion: PROTOCOL_VERSION });
+}
+
+export function joinMatch(endpoint: string, code: string): Promise<MatchRoom> {
+  return new Client(endpoint).join<MatchStateSchema>(MATCH_ROOM, {
+    protocolVersion: PROTOCOL_VERSION,
+    code: normalizeMatchCode(code),
+  });
+}
+
+/** What to tell the player when the server refuses or cannot be reached. The server's own messages are readable. */
+export function refusalMessage(error: unknown): string {
+  const code = (error as { code?: unknown } | null)?.code;
+  if (code === ErrorCode.MATCHMAKE_INVALID_CRITERIA) return NO_SUCH_MATCH_MESSAGE;
+  if (error instanceof TypeError) return "Cannot reach the match server";
+  if (error instanceof Error && error.message !== "") return error.message;
+  return "Could not join the match";
+}
diff --git a/apps/web/src/hud.ts b/apps/web/src/hud.ts
new file mode 100644
index 0000000..aa5d728
--- /dev/null
+++ b/apps/web/src/hud.ts
@@ -0,0 +1,45 @@
+import { defaultSimulationConfig, toTilePosition } from "@pirate-sea-race/simulation";
+import { cssColor, slotColor, type ShipSnapshot } from "./matchView.js";
+
+export type ConnectionStatus = "connected" | "disconnected";
+
+export interface HudModel {
+  readonly code: string;
+  readonly protocolVersion: number;
+  readonly custom: boolean;
+  readonly status: ConnectionStatus;
+  readonly selfId: string;
+  readonly ships: readonly ShipSnapshot[];
+}
+
+function field(root: ParentNode, id: string): HTMLElement {
+  const element = root.querySelector<HTMLElement>(`[data-testid="${id}"]`);
+  if (element === null) throw new Error(`missing HUD field ${id}`);
+  return element;
+}
+
+/** Writes the match status and the latest authoritative (not interpolated) ship positions into the HUD. */
+export function renderHud(root: ParentNode, model: HudModel): void {
+  field(root, "hud-code").textContent = model.code;
+  field(root, "hud-protocol").textContent = `v${model.protocolVersion}`;
+  field(root, "hud-players").textContent = String(model.ships.length);
+  field(root, "hud-status").textContent = model.status;
+  field(root, "hud-mode").textContent = model.custom ? "custom" : "standard";
+  field(root, "hud-self").textContent = model.selfId;
+
+  const list = field(root, "positions");
+  const items = model.ships.map((ship) => {
+    const item = document.createElement("li");
+    item.dataset["shipId"] = ship.id;
+    item.dataset["x"] = String(ship.x);
+    item.dataset["y"] = String(ship.y);
+    const swatch = document.createElement("span");
+    swatch.className = "swatch";
+    swatch.style.background = cssColor(slotColor(ship.slot));
+    const tile = toTilePosition(defaultSimulationConfig, ship.x, ship.y);
+    const who = ship.id === model.selfId ? "you" : ship.id;
+    item.append(swatch, `${who}: x ${ship.x}, y ${ship.y} (tile ${tile.tileX},${tile.tileY})`);
+    return item;
+  });
+  list.replaceChildren(...items);
+}
diff --git a/apps/web/src/inputSender.ts b/apps/web/src/inputSender.ts
new file mode 100644
index 0000000..04fa6de
--- /dev/null
+++ b/apps/web/src/inputSender.ts
@@ -0,0 +1,51 @@
+import { MAX_INPUT_LEAD_FRAMES, MessageType, type InputMessage } from "@pirate-sea-race/protocol";
+import { STEPS_PER_SECOND } from "@pirate-sea-race/simulation";
+import type { Axes } from "./keyboard.js";
+
+/** Resend a held input this often, well inside the server's 250 ms hold window. */
+const REFRESH_MS = 100;
+/** Never tag an input further ahead than half the server's future-frame window. */
+const MAX_ESTIMATE_LEAD = Math.floor(MAX_INPUT_LEAD_FRAMES / 2);
+
+/** The client's estimate of the server's current frame: the last patched frame plus the time since it arrived. */
+export function estimateServerFrame(patchedFrame: number, patchedAt: number, now: number): number {
+  const elapsed = Math.max(0, Math.floor(((now - patchedAt) * STEPS_PER_SECOND) / 1000));
+  return patchedFrame + Math.min(elapsed, MAX_ESTIMATE_LEAD);
+}
+
+export interface InputChannel {
+  send(type: string, message: InputMessage): void;
+}
+
+/** Sends the player's intent: on every change, and repeated while a direction is held. */
+export class InputSender {
+  private seq = 0;
+  private last: Axes = { moveX: 0, moveY: 0 };
+  private lastSentAt = Number.NEGATIVE_INFINITY;
+  private patchedFrame = 0;
+  private patchedAt = 0;
+
+  constructor(private readonly channel: InputChannel) {}
+
+  observeFrame(frame: number, now: number): void {
+    if (frame !== this.patchedFrame) {
+      this.patchedFrame = frame;
+      this.patchedAt = now;
+    }
+  }
+
+  update(axes: Axes, now: number): void {
+    const changed = axes.moveX !== this.last.moveX || axes.moveY !== this.last.moveY;
+    const held = axes.moveX !== 0 || axes.moveY !== 0;
+    if (!changed && !(held && now - this.lastSentAt >= REFRESH_MS)) return;
+    this.channel.send(MessageType.Input, {
+      seq: ++this.seq,
+      frame: estimateServerFrame(this.patchedFrame, this.patchedAt, now),
+      buttons: 0,
+      moveX: axes.moveX,
+      moveY: axes.moveY,
+    });
+    this.last = axes;
+    this.lastSentAt = now;
+  }
+}
diff --git a/apps/web/src/interpolation.ts b/apps/web/src/interpolation.ts
new file mode 100644
index 0000000..ac63eb1
--- /dev/null
+++ b/apps/web/src/interpolation.ts
@@ -0,0 +1,44 @@
+/** Render remote state this far in the past, two 20 Hz patches, so there is almost always a later snapshot. */
+export const INTERPOLATION_DELAY_MS = 100;
+
+interface Snapshot {
+  readonly time: number;
+  readonly x: number;
+  readonly y: number;
+}
+
+/**
+ * The server's positions for one ship as they arrived, for drawing between patches. Sampling before the first
+ * snapshot returns the first; after the last, the last (no extrapolation).
+ */
+export class SnapshotBuffer {
+  private readonly snapshots: Snapshot[] = [];
+
+  constructor(private readonly capacity = 32) {}
+
+  push(time: number, x: number, y: number): void {
+    const last = this.snapshots.at(-1);
+    if (last !== undefined && time < last.time) return;
+    this.snapshots.push({ time, x, y });
+    if (this.snapshots.length > this.capacity) this.snapshots.shift();
+  }
+
+  get latest(): Snapshot | undefined {
+    return this.snapshots.at(-1);
+  }
+
+  sample(renderTime: number): { x: number; y: number } | undefined {
+    const first = this.snapshots[0];
+    if (first === undefined) return undefined;
+    if (renderTime <= first.time) return { x: first.x, y: first.y };
+    for (let index = this.snapshots.length - 1; index >= 0; index--) {
+      const before = this.snapshots[index]!;
+      if (before.time > renderTime) continue;
+      const after = this.snapshots[index + 1];
+      if (after === undefined) return { x: before.x, y: before.y };
+      const t = (renderTime - before.time) / (after.time - before.time);
+      return { x: before.x + (after.x - before.x) * t, y: before.y + (after.y - before.y) * t };
+    }
+    return { x: first.x, y: first.y };
+  }
+}
diff --git a/apps/web/src/keyboard.ts b/apps/web/src/keyboard.ts
new file mode 100644
index 0000000..7517cf5
--- /dev/null
+++ b/apps/web/src/keyboard.ts
@@ -0,0 +1,47 @@
+export interface Axes {
+  readonly moveX: number;
+  readonly moveY: number;
+}
+
+const KEYS = {
+  left: ["KeyA", "ArrowLeft"],
+  right: ["KeyD", "ArrowRight"],
+  up: ["KeyW", "ArrowUp"],
+  down: ["KeyS", "ArrowDown"],
+} as const;
+
+const MOVEMENT_CODES = new Set<string>(Object.values(KEYS).flat());
+
+/** Converts two opposing keys into one axis: both held is neutral, whatever order they were pressed in (§8). */
+export function axis(negative: boolean, positive: boolean): number {
+  return (positive ? 1 : 0) - (negative ? 1 : 0);
+}
+
+/**
+ * The keyboard input adapter (§8 defaults: WASD or arrow keys). It tracks held movement keys and releases them all
+ * when the window loses focus, so a ship never keeps sailing on a key-up the page missed.
+ */
+export class KeyboardAxes {
+  private readonly held = new Set<string>();
+
+  constructor(target: Window) {
+    target.addEventListener("keydown", (event) => {
+      if (!MOVEMENT_CODES.has(event.code) || isTyping(event.target)) return;
+      event.preventDefault();
+      this.held.add(event.code);
+    });
+    target.addEventListener("keyup", (event) => {
+      this.held.delete(event.code);
+    });
+    target.addEventListener("blur", () => this.held.clear());
+  }
+
+  axes(): Axes {
+    const any = (codes: readonly string[]) => codes.some((code) => this.held.has(code));
+    return { moveX: axis(any(KEYS.left), any(KEYS.right)), moveY: axis(any(KEYS.up), any(KEYS.down)) };
+  }
+}
+
+function isTyping(target: EventTarget | null): boolean {
+  return target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement;
+}
diff --git a/apps/web/src/main.ts b/apps/web/src/main.ts
new file mode 100644
index 0000000..309bf26
--- /dev/null
+++ b/apps/web/src/main.ts
@@ -0,0 +1,89 @@
+import { PROTOCOL_VERSION } from "@pirate-sea-race/protocol";
+import { createMatch, joinMatch, refusalMessage, serverEndpoint, type MatchRoom } from "./connection.js";
+import { renderHud, type ConnectionStatus } from "./hud.js";
+import { InputSender } from "./inputSender.js";
+import { KeyboardAxes } from "./keyboard.js";
+import { MatchView, type ShipSnapshot } from "./matchView.js";
+import { startGame } from "./seaScene.js";
+
+const INPUT_INTERVAL_MS = 1000 / 60;
+
+function element<T extends HTMLElement>(selector: string): T {
+  const found = document.querySelector<T>(selector);
+  if (found === null) throw new Error(`missing element ${selector}`);
+  return found;
+}
+
+const landing = element<HTMLElement>("#landing");
+const matchSection = element<HTMLElement>("#match");
+const createButton = element<HTMLButtonElement>("#create-match");
+const joinForm = element<HTMLFormElement>("#join-form");
+const joinButton = element<HTMLButtonElement>("#join-match");
+const codeInput = element<HTMLInputElement>("#join-code");
+const errorText = element<HTMLElement>("#join-error");
+const endpoint = serverEndpoint(window.location);
+
+element<HTMLElement>('[data-testid="landing-protocol"]').textContent = String(PROTOCOL_VERSION);
+
+createButton.addEventListener("click", () => void connect(() => createMatch(endpoint)));
+joinForm.addEventListener("submit", (event) => {
+  event.preventDefault();
+  void connect(() => joinMatch(endpoint, codeInput.value));
+});
+
+async function connect(open: () => Promise<MatchRoom>): Promise<void> {
+  setBusy(true);
+  errorText.textContent = "";
+  try {
+    enterMatch(await open());
+  } catch (error) {
+    errorText.textContent = refusalMessage(error);
+    setBusy(false);
+  }
+}
+
+function setBusy(busy: boolean): void {
+  createButton.disabled = busy;
+  joinButton.disabled = busy;
+}
+
+function enterMatch(room: MatchRoom): void {
+  landing.hidden = true;
+  matchSection.hidden = false;
+
+  const view = new MatchView(room.sessionId);
+  const sender = new InputSender({ send: (type, message) => room.send(type, message) });
+  const keyboard = new KeyboardAxes(window);
+  let status: ConnectionStatus = "connected";
+
+  const refresh = () => {
+    const state = room.state;
+    if (state?.ships === undefined) return;
+    const now = performance.now();
+    const ships: ShipSnapshot[] = [...state.ships.values()];
+    view.ingest(ships, now);
+    sender.observeFrame(state.frame, now);
+    renderHud(matchSection, {
+      code: state.code,
+      protocolVersion: state.protocolVersion,
+      custom: state.custom,
+      status,
+      selfId: room.sessionId,
+      ships,
+    });
+  };
+
+  room.onStateChange(refresh);
+  room.onLeave(() => {
+    status = "disconnected";
+    refresh();
+  });
+  refresh();
+
+  const inputTimer = window.setInterval(() => {
+    if (status === "connected") sender.update(keyboard.axes(), performance.now());
+    else window.clearInterval(inputTimer);
+  }, INPUT_INTERVAL_MS);
+
+  startGame(element<HTMLElement>("#game"), view);
+}
diff --git a/apps/web/src/matchView.ts b/apps/web/src/matchView.ts
new file mode 100644
index 0000000..e447e98
--- /dev/null
+++ b/apps/web/src/matchView.ts
@@ -0,0 +1,56 @@
+import { INTERPOLATION_DELAY_MS, SnapshotBuffer } from "./interpolation.js";
+
+export interface ShipSnapshot {
+  readonly id: string;
+  readonly slot: number;
+  readonly x: number;
+  readonly y: number;
+  readonly heading: number;
+}
+
+/** Placeholder ship colours by spawn slot. */
+const SLOT_COLORS = [0xf4b942, 0xe5484d, 0x46a758, 0xb66ee8, 0xf76b15, 0x3dd6d0, 0xf2f2f2, 0xd6409f] as const;
+
+export function slotColor(slot: number): number {
+  return SLOT_COLORS[slot % SLOT_COLORS.length]!;
+}
+
+export function cssColor(color: number): string {
+  return `#${color.toString(16).padStart(6, "0")}`;
+}
+
+/**
+ * The client's picture of the match: the latest decoded server positions (for the HUD) and a snapshot history per
+ * ship (for interpolated drawing).
+ */
+export class MatchView {
+  private readonly latest = new Map<string, ShipSnapshot>();
+  private readonly buffers = new Map<string, SnapshotBuffer>();
+
+  constructor(readonly selfId: string) {}
+
+  ingest(ships: Iterable<ShipSnapshot>, now: number): void {
+    const seen = new Set<string>();
+    for (const ship of ships) {
+      seen.add(ship.id);
+      this.latest.set(ship.id, { id: ship.id, slot: ship.slot, x: ship.x, y: ship.y, heading: ship.heading });
+      let buffer = this.buffers.get(ship.id);
+      if (buffer === undefined) this.buffers.set(ship.id, (buffer = new SnapshotBuffer()));
+      buffer.push(now, ship.x, ship.y);
+    }
+    for (const id of [...this.latest.keys()]) {
+      if (seen.has(id)) continue;
+      this.latest.delete(id);
+      this.buffers.delete(id);
+    }
+  }
+
+  ships(): ShipSnapshot[] {
+    return [...this.latest.values()];
+  }
+
+  /** Where to draw a ship at `now`, interpolated INTERPOLATION_DELAY_MS in the past. */
+  renderPosition(id: string, now: number): { x: number; y: number } | undefined {
+    return this.buffers.get(id)?.sample(now - INTERPOLATION_DELAY_MS);
+  }
+}
diff --git a/apps/web/src/seaScene.ts b/apps/web/src/seaScene.ts
new file mode 100644
index 0000000..6fb04dd
--- /dev/null
+++ b/apps/web/src/seaScene.ts
@@ -0,0 +1,102 @@
+import * as Phaser from "phaser";
+import { defaultSimulationConfig } from "@pirate-sea-race/simulation";
+import { slotColor, type MatchView } from "./matchView.js";
+
+const { map } = defaultSimulationConfig;
+export const TILE_PIXELS = 16;
+export const SCENE_WIDTH = map.widthTiles * TILE_PIXELS;
+export const SCENE_HEIGHT = map.heightTiles * TILE_PIXELS;
+const PIXELS_PER_SUB_UNIT = TILE_PIXELS / map.subUnitsPerTile;
+
+const SEA_COLOR = 0x0b3d5c;
+const GRID_COLOR = 0x145374;
+
+/** A ship as drawn this frame, in canvas pixels, for the DOM report tests read. */
+export interface DrawnShip {
+  readonly id: string;
+  readonly x: number;
+  readonly y: number;
+  readonly color: string;
+}
+
+/**
+ * Draws the sea and every ship as placeholder shapes at interpolated server positions. Each frame it records what
+ * it drew in `data-drawn-ships` on the report element.
+ */
+export class SeaScene extends Phaser.Scene {
+  private readonly shipGraphics = new Map<string, Phaser.GameObjects.Graphics>();
+  private lastReport = "";
+
+  constructor(
+    private readonly view: MatchView,
+    private readonly report: HTMLElement,
+  ) {
+    super("sea");
+  }
+
+  create(): void {
+    const sea = this.add.graphics();
+    sea.fillStyle(SEA_COLOR, 1);
+    sea.fillRect(0, 0, SCENE_WIDTH, SCENE_HEIGHT);
+    sea.lineStyle(1, GRID_COLOR, 1);
+    for (let tile = 0; tile <= map.widthTiles; tile += 4) sea.lineBetween(tile * TILE_PIXELS, 0, tile * TILE_PIXELS, SCENE_HEIGHT);
+    for (let tile = 0; tile <= map.heightTiles; tile += 4) sea.lineBetween(0, tile * TILE_PIXELS, SCENE_WIDTH, tile * TILE_PIXELS);
+  }
+
+  override update(): void {
+    const now = performance.now();
+    const drawn: DrawnShip[] = [];
+    const present = new Set<string>();
+    for (const ship of this.view.ships()) {
+      const position = this.view.renderPosition(ship.id, now);
+      if (position === undefined) continue;
+      present.add(ship.id);
+      let graphics = this.shipGraphics.get(ship.id);
+      if (graphics === undefined) {
+        graphics = this.drawShip(slotColor(ship.slot), ship.id === this.view.selfId);
+        this.shipGraphics.set(ship.id, graphics);
+      }
+      const x = position.x * PIXELS_PER_SUB_UNIT;
+      const y = position.y * PIXELS_PER_SUB_UNIT;
+      graphics.setPosition(x, y);
+      graphics.setRotation((ship.heading * Math.PI) / 4);
+      drawn.push({ id: ship.id, x: Math.round(x), y: Math.round(y), color: `#${slotColor(ship.slot).toString(16).padStart(6, "0")}` });
+    }
+    for (const [id, graphics] of this.shipGraphics) {
+      if (present.has(id)) continue;
+      graphics.destroy();
+      this.shipGraphics.delete(id);
+    }
+    const report = JSON.stringify(drawn);
+    if (report !== this.lastReport) {
+      this.report.dataset["drawnShips"] = report;
+      this.lastReport = report;
+    }
+  }
+
+  /** A round hull with a bow pointing along +x; the player's own ship gets a white ring. */
+  private drawShip(color: number, own: boolean): Phaser.GameObjects.Graphics {
+    const graphics = this.add.graphics();
+    graphics.fillStyle(color, 1);
+    graphics.fillCircle(0, 0, 9);
+    graphics.fillTriangle(7, -6, 17, 0, 7, 6);
+    if (own) {
+      graphics.lineStyle(2, 0xffffff, 1);
+      graphics.strokeCircle(0, 0, 13);
+    }
+    return graphics;
+  }
+}
+
+export function startGame(parent: HTMLElement, view: MatchView): Phaser.Game {
+  return new Phaser.Game({
+    type: Phaser.AUTO,
+    parent,
+    width: SCENE_WIDTH,
+    height: SCENE_HEIGHT,
+    backgroundColor: SEA_COLOR,
+    banner: false,
+    audio: { noAudio: true },
+    scene: new SeaScene(view, parent),
+  });
+}
