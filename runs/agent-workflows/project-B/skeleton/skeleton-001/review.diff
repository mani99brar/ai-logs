diff --git a/packages/content/src/content.test.ts b/packages/content/src/content.test.ts
new file mode 100644
index 0000000..d6dd7e7
--- /dev/null
+++ b/packages/content/src/content.test.ts
@@ -0,0 +1,88 @@
+import { describe, expect, it } from "vitest";
+import {
+  baselineFrameBudgets,
+  privateMatch,
+  rulesPresets,
+  seaMap,
+  spawnSlots,
+  validateFrameBudgets,
+  validateMoveTiming,
+  validateRulesPreset,
+} from "./index.js";
+
+describe("rules presets", () => {
+  it("keeps the slice and alpha differences from §18", () => {
+    expect(rulesPresets.slice).toMatchObject({ rubbingTypes: 2, rubbings: 8, islands: 4 });
+    expect(rulesPresets.alpha).toMatchObject({ rubbingTypes: 4, rubbings: 12, islands: 12 });
+  });
+
+  it("accepts both presets", () => {
+    expect(validateRulesPreset(rulesPresets.slice).ok).toBe(true);
+    expect(validateRulesPreset(rulesPresets.alpha).ok).toBe(true);
+  });
+
+  it("rejects a preset whose islands cannot supply its rubbings", () => {
+    const result = validateRulesPreset({ ...rulesPresets.slice, rubbings: 9 });
+    expect(result.ok).toBe(false);
+  });
+
+  it("rejects an unknown preset id and extra fields", () => {
+    expect(validateRulesPreset({ ...rulesPresets.alpha, id: "beta" }).ok).toBe(false);
+    expect(validateRulesPreset({ ...rulesPresets.alpha, cheat: true }).ok).toBe(false);
+  });
+});
+
+describe("baseline frame budgets", () => {
+  it("holds §8's table as typed data", () => {
+    const byId = Object.fromEntries(baselineFrameBudgets.map((move) => [move.id, move]));
+    expect(byId["jab"]).toMatchObject({ startup: 7, active: 3, recovery: 12, onBlock: { kind: "frames", advantage: -2 } });
+    expect(byId["heavy-mid"]).toMatchObject({ startup: 18, active: 4, recovery: 24, onBlock: { kind: "frames", advantage: -12 } });
+    expect(byId["low-sweep"]).toMatchObject({ startup: 20, active: 3, recovery: 26, onBlock: { kind: "frames", advantage: -15 } });
+    expect(byId["projectile-special"]).toMatchObject({ startup: 22, active: "projectile-life", recovery: 30, onBlock: { kind: "spacing-dependent" } });
+    expect(byId["throw"]).toMatchObject({ startup: 12, active: 2, recovery: 24, onBlock: { kind: "unguardable" } });
+    expect(baselineFrameBudgets).toHaveLength(5);
+  });
+
+  it("accepts the baseline table", () => {
+    expect(validateFrameBudgets(baselineFrameBudgets)).toEqual({ ok: true, value: baselineFrameBudgets });
+  });
+
+  const jab = baselineFrameBudgets[0];
+
+  it.each([
+    ["zero startup", { ...jab, startup: 0 }],
+    ["negative startup", { ...jab, startup: -3 }],
+    ["zero active frames", { ...jab, active: 0 }],
+    ["negative active frames", { ...jab, active: -1 }],
+    ["fractional startup", { ...jab, startup: 6.5 }],
+    ["negative recovery", { ...jab, recovery: -1 }],
+    ["more minus on block than active + recovery", { ...jab, onBlock: { kind: "frames", advantage: -16 } }],
+    ["an unknown on-block kind", { ...jab, onBlock: { kind: "sometimes" } }],
+  ])("rejects %s", (_label, move) => {
+    const result = validateMoveTiming(move);
+    expect(result.ok).toBe(false);
+    if (!result.ok) expect(result.issues.length).toBeGreaterThan(0);
+  });
+
+  it("rejects a table that uses an id twice", () => {
+    expect(validateFrameBudgets([jab, jab]).ok).toBe(false);
+  });
+});
+
+describe("sea content", () => {
+  it("has a distinct spawn slot inside the map for every player of a private match", () => {
+    expect(spawnSlots.length).toBeGreaterThanOrEqual(privateMatch.maxPlayers);
+    const keys = new Set(spawnSlots.map((slot) => `${slot.tileX},${slot.tileY}`));
+    expect(keys.size).toBe(spawnSlots.length);
+    for (const slot of spawnSlots) {
+      expect(slot.tileX).toBeGreaterThanOrEqual(0);
+      expect(slot.tileX).toBeLessThan(seaMap.widthTiles);
+      expect(slot.tileY).toBeGreaterThanOrEqual(0);
+      expect(slot.tileY).toBeLessThan(seaMap.heightTiles);
+    }
+  });
+
+  it("uses integer sizes", () => {
+    for (const value of Object.values(seaMap)) expect(Number.isInteger(value)).toBe(true);
+  });
+});
diff --git a/packages/content/src/frameBudgets.ts b/packages/content/src/frameBudgets.ts
new file mode 100644
index 0000000..68b6133
--- /dev/null
+++ b/packages/content/src/frameBudgets.ts
@@ -0,0 +1,63 @@
+import { z } from "zod";
+import { formatIssues, type ValidationResult } from "./rules.js";
+
+/** How the attacker stands after the defender blocks (§8): a frame advantage, or one of the table's special cases. */
+export const onBlockSchema = z.discriminatedUnion("kind", [
+  /** Negative is minus: "Minus 12" is `{ kind: "frames", advantage: -12 }`. */
+  z.strictObject({ kind: z.literal("frames"), advantage: z.int() }),
+  z.strictObject({ kind: z.literal("spacing-dependent") }),
+  z.strictObject({ kind: z.literal("unguardable") }),
+]);
+
+/**
+ * One row of the baseline frame budgets (§8), in 60 Hz frames. `active` is `"projectile-life"` when the hit lives on
+ * a projectile rather than the fighter.
+ */
+export const moveTimingSchema = z
+  .strictObject({
+    id: z.string().regex(/^[a-z][a-z0-9-]*$/),
+    name: z.string().min(1),
+    startup: z.int().positive(),
+    active: z.union([z.int().positive(), z.literal("projectile-life")]),
+    recovery: z.int().nonnegative(),
+    onBlock: onBlockSchema,
+  })
+  .superRefine((move, ctx) => {
+    // Advantage on block is blockstun minus the attacker's remaining active and recovery frames. Blockstun is never
+    // negative, so the attacker can never be more minus than active + recovery.
+    if (move.onBlock.kind === "frames" && typeof move.active === "number" && move.onBlock.advantage < -(move.active + move.recovery)) {
+      ctx.addIssue({
+        code: "custom",
+        path: ["onBlock", "advantage"],
+        message: `minus ${-move.onBlock.advantage} on block exceeds active + recovery (${move.active + move.recovery} frames)`,
+      });
+    }
+  });
+
+export type MoveTiming = z.infer<typeof moveTimingSchema>;
+
+export const baselineFrameBudgets = [
+  { id: "jab", name: "Jab", startup: 7, active: 3, recovery: 12, onBlock: { kind: "frames", advantage: -2 } },
+  { id: "heavy-mid", name: "Heavy mid", startup: 18, active: 4, recovery: 24, onBlock: { kind: "frames", advantage: -12 } },
+  { id: "low-sweep", name: "Low sweep", startup: 20, active: 3, recovery: 26, onBlock: { kind: "frames", advantage: -15 } },
+  { id: "projectile-special", name: "Projectile special", startup: 22, active: "projectile-life", recovery: 30, onBlock: { kind: "spacing-dependent" } },
+  { id: "throw", name: "Throw", startup: 12, active: 2, recovery: 24, onBlock: { kind: "unguardable" } },
+] as const satisfies readonly MoveTiming[];
+
+export function validateMoveTiming(candidate: unknown): ValidationResult<MoveTiming> {
+  const parsed = moveTimingSchema.safeParse(candidate);
+  return parsed.success ? { ok: true, value: parsed.data } : { ok: false, issues: formatIssues(parsed.error) };
+}
+
+/** Validates a whole table: every row, and no id used twice. */
+export function validateFrameBudgets(candidate: unknown): ValidationResult<MoveTiming[]> {
+  const parsed = z.array(moveTimingSchema).safeParse(candidate);
+  if (!parsed.success) return { ok: false, issues: formatIssues(parsed.error) };
+  const seen = new Set<string>();
+  const issues: string[] = [];
+  for (const move of parsed.data) {
+    if (seen.has(move.id)) issues.push(`${move.id}: duplicate move id`);
+    seen.add(move.id);
+  }
+  return issues.length > 0 ? { ok: false, issues } : { ok: true, value: parsed.data };
+}
