diff --git a/packages/test-tools/src/headlessClient.ts b/packages/test-tools/src/headlessClient.ts
new file mode 100644
index 0000000..bb020ab
--- /dev/null
+++ b/packages/test-tools/src/headlessClient.ts
@@ -0,0 +1,136 @@
+import { Client, type Room } from "@colyseus/sdk";
+import {
+  MATCH_ROOM,
+  MessageType,
+  normalizeMatchCode,
+  PROTOCOL_VERSION,
+  type InputMessage,
+} from "@pirate-sea-race/protocol";
+import type { MatchStateSchema } from "@pirate-sea-race/server/schema";
+
+export interface HeadlessClientOptions {
+  /** Override the protocol version sent on join, to exercise the version check. */
+  readonly protocolVersion?: number;
+}
+
+export interface ShipView {
+  readonly id: string;
+  readonly slot: number;
+  readonly x: number;
+  readonly y: number;
+}
+
+export interface Movement {
+  readonly moveX: number;
+  readonly moveY: number;
+  readonly buttons?: number;
+}
+
+/**
+ * A browserless player: joins a private match through the real Colyseus SDK, decodes the synced state, and sends
+ * frame-tagged inputs with increasing sequence numbers, exactly as the web client does.
+ */
+export class HeadlessClient {
+  private seq = 0;
+  private open = true;
+
+  private constructor(readonly room: Room<unknown, MatchStateSchema>) {
+    room.onLeave(() => {
+      this.open = false;
+    });
+  }
+
+  /** Creates a private match on the server at `endpoint` (for example `http://127.0.0.1:2593`). */
+  static async create(endpoint: string, options: HeadlessClientOptions = {}): Promise<HeadlessClient> {
+    const client = new Client(endpoint);
+    const room = await client.create<MatchStateSchema>(MATCH_ROOM, {
+      protocolVersion: options.protocolVersion ?? PROTOCOL_VERSION,
+    });
+    const headless = new HeadlessClient(room);
+    await headless.waitFor(() => headless.code !== "" && headless.ship() !== undefined);
+    return headless;
+  }
+
+  /** Joins the private match with `code` (any case). */
+  static async join(endpoint: string, code: string, options: HeadlessClientOptions = {}): Promise<HeadlessClient> {
+    const client = new Client(endpoint);
+    const room = await client.join<MatchStateSchema>(MATCH_ROOM, {
+      protocolVersion: options.protocolVersion ?? PROTOCOL_VERSION,
+      code: normalizeMatchCode(code),
+    });
+    const headless = new HeadlessClient(room);
+    await headless.waitFor(() => headless.ship() !== undefined);
+    return headless;
+  }
+
+  get sessionId(): string {
+    return this.room.sessionId;
+  }
+
+  get connected(): boolean {
+    return this.open;
+  }
+
+  get code(): string {
+    return this.room.state?.code ?? "";
+  }
+
+  get frame(): number {
+    return this.room.state?.frame ?? 0;
+  }
+
+  get playerCount(): number {
+    return this.room.state?.ships?.size ?? 0;
+  }
+
+  /** The authoritative position of a ship as last decoded, by default this client's own. */
+  ship(id: string = this.sessionId): ShipView | undefined {
+    const ship = this.room.state?.ships?.get(id);
+    return ship === undefined ? undefined : { id: ship.id, slot: ship.slot, x: ship.x, y: ship.y };
+  }
+
+  /** Sends one input tagged with the last decoded frame and the next sequence number. */
+  sendInput(movement: Movement): InputMessage {
+    const message: InputMessage = {
+      seq: ++this.seq,
+      frame: this.frame,
+      buttons: movement.buttons ?? 0,
+      moveX: movement.moveX,
+      moveY: movement.moveY,
+    };
+    this.room.send(MessageType.Input, message);
+    return message;
+  }
+
+  /** Sends anything at all, for tests of the server's validation. */
+  sendRaw(type: string, payload: unknown): void {
+    this.room.send(type, payload);
+  }
+
+  /** Holds a movement for `durationMs`, refreshing it faster than the server's hold window, then releases it. */
+  async hold(movement: Movement, durationMs: number): Promise<void> {
+    const until = Date.now() + durationMs;
+    while (Date.now() < until) {
+      this.sendInput(movement);
+      await sleep(100);
+    }
+    this.sendInput({ moveX: 0, moveY: 0 });
+  }
+
+  /** Resolves once `predicate` holds, polling the decoded state; rejects after `timeoutMs`. */
+  async waitFor(predicate: () => boolean, timeoutMs = 5000): Promise<void> {
+    const deadline = Date.now() + timeoutMs;
+    while (!predicate()) {
+      if (Date.now() > deadline) throw new Error(`condition not met within ${timeoutMs} ms`);
+      await sleep(20);
+    }
+  }
+
+  async leave(): Promise<void> {
+    if (this.open) await this.room.leave(true);
+  }
+}
+
+export function sleep(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
