+            <dt>You</dt>
+            <dd data-testid="hud-self"></dd>
+          </dl>
+          <h2>Authoritative positions</h2>
+          <ul data-testid="positions"></ul>
+          <p class="hint">Sail with WASD or the arrow keys.</p>
+        </aside>
+      </section>
+    </main>
+    <script type="module" src="/src/main.ts"></script>
+  </body>
+</html>
