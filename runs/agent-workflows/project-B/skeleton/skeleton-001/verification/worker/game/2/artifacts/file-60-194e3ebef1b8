import { mapBounds, type SimulationConfig } from "./config.js";
import { clampInt, divTrunc, isqrt } from "./fixed.js";
import { AXIS_SCALE, sanitizeInput, type PlayerInput } from "./input.js";
import { WORLD_STEP_INTERVAL, type MatchState, type ShipState } from "./state.js";

/** Held inputs by ship id; a ship without an entry is neutral. */
export type StepInputs = Readonly<Record<string, PlayerInput>>;

export function isWorldStep(frame: number): boolean {
  return frame % WORLD_STEP_INTERVAL === 0;
}

/**
 * Advances the match clock by one 60 Hz step and returns the new state. World logic (ship movement) runs only when
 * the new frame is a multiple of WORLD_STEP_INTERVAL. The input state is never mutated.
 */
export function step(config: SimulationConfig, state: MatchState, inputs: StepInputs): MatchState {
  const frame = state.frame + 1;
  if (!isWorldStep(frame)) return { ...state, frame };
  return {
    ...state,
    frame,
    worldTick: state.worldTick + 1,
    ships: state.ships.map((ship) => moveShip(config, ship, sanitizeInput(inputs[ship.id]))),
  };
}

function moveShip(config: SimulationConfig, ship: ShipState, input: PlayerInput): ShipState {
  const speed = config.ship.speedSubUnitsPerWorldStep;
  const { moveX, moveY } = input;
  // Diagonals are normalised with an integer square root so full throttle is the same speed in every direction.
  const length = isqrt(moveX * moveX + moveY * moveY);
  const divisor = Math.max(length, AXIS_SCALE);
  const vx = divTrunc(speed * moveX, divisor);
  const vy = divTrunc(speed * moveY, divisor);
  const { maxX, maxY } = mapBounds(config);
  return {
    ...ship,
    x: clampInt(ship.x + vx, 0, maxX),
    y: clampInt(ship.y + vy, 0, maxY),
    vx,
    vy,
    heading: vx === 0 && vy === 0 ? ship.heading : headingOf(vx, vy),
  };
}

/** Eight-way heading from the signs of the velocity (0 = east, clockwise with y down). */
function headingOf(vx: number, vy: number): number {
  const sx = Math.sign(vx);
  const sy = Math.sign(vy);
  const table: Record<string, number> = {
    "1,0": 0, "1,1": 1, "0,1": 2, "-1,1": 3, "-1,0": 4, "-1,-1": 5, "0,-1": 6, "1,-1": 7,
  };
  return table[`${sx},${sy}`] ?? 0;
}
