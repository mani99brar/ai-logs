import { MAX_INPUT_LEAD_FRAMES, MessageType, type InputMessage } from "@pirate-sea-race/protocol";
import { STEPS_PER_SECOND } from "@pirate-sea-race/simulation";
import type { Axes } from "./keyboard.js";

/** Resend a held input this often, well inside the server's 250 ms hold window. */
const REFRESH_MS = 100;
/** Never tag an input further ahead than half the server's future-frame window. */
const MAX_ESTIMATE_LEAD = Math.floor(MAX_INPUT_LEAD_FRAMES / 2);

/** The client's estimate of the server's current frame: the last patched frame plus the time since it arrived. */
export function estimateServerFrame(patchedFrame: number, patchedAt: number, now: number): number {
  const elapsed = Math.max(0, Math.floor(((now - patchedAt) * STEPS_PER_SECOND) / 1000));
  return patchedFrame + Math.min(elapsed, MAX_ESTIMATE_LEAD);
}

export interface InputChannel {
  send(type: string, message: InputMessage): void;
}

/** Sends the player's intent: on every change, and repeated while a direction is held. */
export class InputSender {
  private seq = 0;
  private last: Axes = { moveX: 0, moveY: 0 };
  private lastSentAt = Number.NEGATIVE_INFINITY;
  private patchedFrame = 0;
  private patchedAt = 0;

  constructor(private readonly channel: InputChannel) {}

  observeFrame(frame: number, now: number): void {
    if (frame !== this.patchedFrame) {
      this.patchedFrame = frame;
      this.patchedAt = now;
    }
  }

  update(axes: Axes, now: number): void {
    const changed = axes.moveX !== this.last.moveX || axes.moveY !== this.last.moveY;
    const held = axes.moveX !== 0 || axes.moveY !== 0;
    if (!changed && !(held && now - this.lastSentAt >= REFRESH_MS)) return;
    this.channel.send(MessageType.Input, {
      seq: ++this.seq,
      frame: estimateServerFrame(this.patchedFrame, this.patchedAt, now),
      buttons: 0,
      moveX: axes.moveX,
      moveY: axes.moveY,
    });
    this.last = axes;
    this.lastSentAt = now;
  }
}
