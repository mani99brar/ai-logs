import { Client, ErrorCode, type Room } from "@colyseus/sdk";
import { MATCH_ROOM, NO_SUCH_MATCH_MESSAGE, normalizeMatchCode, PROTOCOL_VERSION } from "@pirate-sea-race/protocol";
import type { MatchStateSchema } from "@pirate-sea-race/server/schema";

export type MatchRoom = Room<unknown, MatchStateSchema>;

const SERVER_PORT = 2593;

/** The match server: `VITE_SERVER_URL` when set, otherwise port 2593 on the host that served the page. */
export function serverEndpoint(location: Location): string {
  const configured: unknown = import.meta.env["VITE_SERVER_URL"];
  return typeof configured === "string" && configured !== "" ? configured : `${location.protocol}//${location.hostname}:${SERVER_PORT}`;
}

export function createMatch(endpoint: string): Promise<MatchRoom> {
  return new Client(endpoint).create<MatchStateSchema>(MATCH_ROOM, { protocolVersion: PROTOCOL_VERSION });
}

export function joinMatch(endpoint: string, code: string): Promise<MatchRoom> {
  return new Client(endpoint).join<MatchStateSchema>(MATCH_ROOM, {
    protocolVersion: PROTOCOL_VERSION,
    code: normalizeMatchCode(code),
  });
}

/** What to tell the player when the server refuses or cannot be reached. The server's own messages are readable. */
export function refusalMessage(error: unknown): string {
  const code = (error as { code?: unknown } | null)?.code;
  if (code === ErrorCode.MATCHMAKE_INVALID_CRITERIA) return NO_SUCH_MATCH_MESSAGE;
  if (error instanceof TypeError) return "Cannot reach the match server";
  if (error instanceof Error && error.message !== "") return error.message;
  return "Could not join the match";
}
