import { randomInt } from "node:crypto";
import { MATCH_CODE_ALPHABET, MATCH_CODE_LENGTH } from "@pirate-sea-race/protocol";

/** A random private match code such as `K7Q2MX`. Uniqueness is checked by the room against live listings. */
export function generateMatchCode(pick: (bound: number) => number = randomInt): string {
  let code = "";
  for (let index = 0; index < MATCH_CODE_LENGTH; index++) code += MATCH_CODE_ALPHABET[pick(MATCH_CODE_ALPHABET.length)];
  return code;
}
