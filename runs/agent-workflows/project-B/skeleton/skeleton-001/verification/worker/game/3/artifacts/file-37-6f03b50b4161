import { z } from "zod";
import { formatIssues, type ValidationResult } from "./rules.js";

/** How the attacker stands after the defender blocks (§8): a frame advantage, or one of the table's special cases. */
export const onBlockSchema = z.discriminatedUnion("kind", [
  /** Negative is minus: "Minus 12" is `{ kind: "frames", advantage: -12 }`. */
  z.strictObject({ kind: z.literal("frames"), advantage: z.int() }),
  z.strictObject({ kind: z.literal("spacing-dependent") }),
  z.strictObject({ kind: z.literal("unguardable") }),
]);

/**
 * One row of the baseline frame budgets (§8), in 60 Hz frames. `active` is `"projectile-life"` when the hit lives on
 * a projectile rather than the fighter.
 */
export const moveTimingSchema = z
  .strictObject({
    id: z.string().regex(/^[a-z][a-z0-9-]*$/),
    name: z.string().min(1),
    startup: z.int().positive(),
    active: z.union([z.int().positive(), z.literal("projectile-life")]),
    recovery: z.int().nonnegative(),
    onBlock: onBlockSchema,
  })
  .superRefine((move, ctx) => {
    // Advantage on block is blockstun minus the attacker's remaining active and recovery frames. Blockstun is never
    // negative, so the attacker can never be more minus than active + recovery.
    if (move.onBlock.kind === "frames" && typeof move.active === "number" && move.onBlock.advantage < -(move.active + move.recovery)) {
      ctx.addIssue({
        code: "custom",
        path: ["onBlock", "advantage"],
        message: `minus ${-move.onBlock.advantage} on block exceeds active + recovery (${move.active + move.recovery} frames)`,
      });
    }
  });

export type MoveTiming = z.infer<typeof moveTimingSchema>;

export const baselineFrameBudgets = [
  { id: "jab", name: "Jab", startup: 7, active: 3, recovery: 12, onBlock: { kind: "frames", advantage: -2 } },
  { id: "heavy-mid", name: "Heavy mid", startup: 18, active: 4, recovery: 24, onBlock: { kind: "frames", advantage: -12 } },
  { id: "low-sweep", name: "Low sweep", startup: 20, active: 3, recovery: 26, onBlock: { kind: "frames", advantage: -15 } },
  { id: "projectile-special", name: "Projectile special", startup: 22, active: "projectile-life", recovery: 30, onBlock: { kind: "spacing-dependent" } },
  { id: "throw", name: "Throw", startup: 12, active: 2, recovery: 24, onBlock: { kind: "unguardable" } },
] as const satisfies readonly MoveTiming[];

export function validateMoveTiming(candidate: unknown): ValidationResult<MoveTiming> {
  const parsed = moveTimingSchema.safeParse(candidate);
  return parsed.success ? { ok: true, value: parsed.data } : { ok: false, issues: formatIssues(parsed.error) };
}

/** Validates a whole table: every row, and no id used twice. */
export function validateFrameBudgets(candidate: unknown): ValidationResult<MoveTiming[]> {
  const parsed = z.array(moveTimingSchema).safeParse(candidate);
  if (!parsed.success) return { ok: false, issues: formatIssues(parsed.error) };
  const seen = new Set<string>();
  const issues: string[] = [];
  for (const move of parsed.data) {
    if (seen.has(move.id)) issues.push(`${move.id}: duplicate move id`);
    seen.add(move.id);
  }
  return issues.length > 0 ? { ok: false, issues } : { ok: true, value: parsed.data };
}
