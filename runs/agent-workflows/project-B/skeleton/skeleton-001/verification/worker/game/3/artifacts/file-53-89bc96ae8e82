/** Integer square root (floor) by Newton's method, so no floating-point transcendental ever enters the step. */
export function isqrt(value: number): number {
  if (!Number.isSafeInteger(value) || value < 0) throw new RangeError(`isqrt needs a non-negative safe integer, got ${value}`);
  if (value < 2) return value;
  let x = value;
  let y = Math.floor((x + 1) / 2);
  while (y < x) {
    x = y;
    y = Math.floor((x + Math.floor(value / x)) / 2);
  }
  return x;
}

/** Integer division rounding toward zero. */
export function divTrunc(numerator: number, denominator: number): number {
  return Math.trunc(numerator / denominator);
}

export function clampInt(value: number, min: number, max: number): number {
  return value < min ? min : value > max ? max : value;
}
