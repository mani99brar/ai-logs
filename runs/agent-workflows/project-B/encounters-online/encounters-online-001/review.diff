-import { cssColor, slotColor, type ShipSnapshot } from "./matchView.js";
+import { cssColor, slotColor, type GrappleSnapshot, type ShipSnapshot, type StatusSnapshot } from "./matchView.js";
 
 export type ConnectionStatus = "connected" | "disconnected";
 
@@ -14,6 +14,94 @@ export interface HudModel {
   readonly players: number;
   /** The ships the server sent: the player's own and those in sight. */
