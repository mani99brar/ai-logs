+/**
+ * Stops a ship where it is (§6: a grapple that lands reserves both ships). The match room then gives it neutral input
+ * until the duel is settled, so it stays put and ignores its player's helm.
+ */
+export function stopShip(state: MatchState, id: string): MatchState {
+  if (!state.ships.some((ship) => ship.id === id)) throw new Error(`no ship ${id}`);
+  return { ...state, ships: state.ships.map((ship) => (ship.id === id ? { ...ship, speed: 0, mooredThrottle: 0 } : ship)) };
+}
+
+export interface ShipReturn {
+  /** Sub-units: where the encounter rules return the ship. */
+  readonly x: number;
+  readonly y: number;
+  /** The dock it respawns moored at, or NOT_DOCKED. */
+  readonly dock: number;
+}
+
+/**
+ * Puts a ship at rest where the encounter rules return it after a duel (§6): the winner at its own position when the
+ * grapple landed, a draw's two ships on the centres of separate navigable tiles, a loser moored at its respawn dock.
+ * Keeps the heading. Refuses a position its hull would not fit, so a return never puts a ship in land.
+ */
+export function returnShip(config: SimulationConfig, state: MatchState, id: string, to: ShipReturn): MatchState {
+  const { x, y, dock } = to;
+  if (![x, y, dock].every(Number.isInteger)) throw new RangeError("a return needs integer coordinates and dock");
+  if (!state.ships.some((ship) => ship.id === id)) throw new Error(`no ship ${id}`);
+  if (!hullIsClear(config, x, y)) throw new RangeError(`a hull does not fit at ${x},${y}`);
+  if (dock !== NOT_DOCKED && !config.map.docks.some((each) => each.id === dock)) throw new RangeError(`no dock ${dock}`);
+  const returned = { x, y, speed: 0, dock, mooredThrottle: 0 };
+  return { ...state, ships: state.ships.map((ship) => (ship.id === id ? { ...ship, ...returned } : ship)) };
+}
