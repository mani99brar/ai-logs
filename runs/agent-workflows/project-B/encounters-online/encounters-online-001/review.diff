+    for (const page of [host, guest]) await expect(page.getByTestId("duel-phase")).toHaveAttribute("data-phase", "fighting", { timeout: 15_000 });
+
+    // The host wins: it keeps tapping its first special (U) at the guest, who stands still, until the KO.
+    const result = host.getByTestId("duel-result");
+    for (let press = 0; press < 60 && !(await result.isVisible()); press++) {
