+    const wait = Number(await guest.getByTestId("hud-respawn").getAttribute("data-seconds"));
+    expect(wait).toBeGreaterThan(5);
+    expect(wait).toBeLessThanOrEqual(15);
+    expect(await readout(guest, guestId)).toBeUndefined();
+    await expect.poll(async () => (await readout(host, guestId)) === undefined).toBe(true);
+
+    // Then its ship is back, moored at a dock, with the respawn's protection.
+    await expect(guest.getByTestId("hud-dock")).not.toHaveAttribute("data-dock", "-1", { timeout: 25_000 });
+    const docked = (await readout(guest, guestId))!;
+    expect(docked.dock).toBeGreaterThanOrEqual(0);
+    const dock = seaMap.docks.find((each) => each.id === docked.dock)!;
+    expect([docked.x, docked.y]).toEqual([dock.tileX * TILE + TILE / 2, dock.tileY * TILE + TILE / 2]);
+    await expect(guest.getByTestId("hud-respawn")).toHaveText("");
+    await expect(guest.getByTestId("hud-protection")).toHaveAttribute("data-state", "respawn");
+
+    await attachScreenshot(guest, testInfo, "sea-duel");
+  } finally {
+    await hostContext.close();
+    await guestContext.close();
+  }
+});
