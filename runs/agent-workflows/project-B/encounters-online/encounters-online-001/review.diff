+    }
+
+    // Both saw the telegraph: the host its own aim, the guest the warning from the west.
+    await expect.poll(async () => (await seen(host)).lines.some((line) => line.startsWith("Grappling, aimed east"))).toBe(true);
+    await expect.poll(async () => (await seen(guest)).lines.some((line) => line.startsWith("Incoming grapple from the west"))).toBe(true);
