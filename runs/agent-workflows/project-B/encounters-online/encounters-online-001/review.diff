+      parent,
+      width: VIEW_WIDTH,
+      height: VIEW_HEIGHT,
+      backgroundColor: SEA_COLOR,
+      banner: false,
+      audio: { noAudio: true },
+      // The sea starts; the arena is added asleep and started with each duel's source.
+      scene: [new SeaScene(view, parent), new ArenaScene(parent)],
+    });
+    parent.dataset["scene"] = "sea";
+  }
+
+  /** A duel at sea: the sea sleeps (it keeps its state) and the arena draws this duel. */
+  showArena(source: ArenaSource): void {
+    this.game.scene.sleep("sea");
+    this.game.scene.start("arena", { source });
+    this.parent.dataset["scene"] = "arena";
+  }
+
+  /** Back to the world: the arena stops and the sea wakes where it was. */
+  showSea(): void {
+    this.game.scene.stop("arena");
+    this.game.scene.wake("sea");
+    this.parent.dataset["scene"] = "sea";
+  }
 }
