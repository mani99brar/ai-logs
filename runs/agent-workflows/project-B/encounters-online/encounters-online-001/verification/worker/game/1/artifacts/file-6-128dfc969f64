import { schema, t, type SchemaType } from "@colyseus/schema";

/**
 * The synced mirror of the plain simulation state. The room copies the simulation into it after every world step;
 * Colyseus sends clients the deltas at the patch rate. Clients decode it by reflection and import these types only.
 */
export const ShipSchema = schema(
  {
    id: t.string(),
    slot: t.uint8(),
    x: t.int32(),
    y: t.int32(),
    heading: t.uint8(),
    speed: t.int16(),
    /** The dock the ship is moored at, or -1 at sea. */
    dock: t.int8(),
  },
  "Ship",
);
export type ShipSchema = SchemaType<typeof ShipSchema>;

/**
 * A telegraphed grapple (§6), from the press until it lands: the attacker, the target the rules chose, the aim locked
 * at the start (a heading of 64) and the world ticks it started and lands on. Keyed by the attacker's id.
 */
export const GrappleSchema = schema(
  {
    attackerId: t.string(),
    defenderId: t.string(),
    aim: t.uint8(),
    startTick: t.uint32(),
    landTick: t.uint32(),
  },
  "Grapple",
);
export type GrappleSchema = SchemaType<typeof GrappleSchema>;

/**
 * A duel marker (§6): where a duel runs and the world tick it was reserved on, so players in sight can show crossed
 * swords and the elapsed time. Keyed by an opaque id: nothing names the fighters.
 */
export const DuelMarkerSchema = schema(
  {
    x: t.int32(),
    y: t.int32(),
    startTick: t.uint32(),
  },
  "DuelMarker",
);
export type DuelMarkerSchema = SchemaType<typeof DuelMarkerSchema>;

/**
 * A player's own encounter status, for their HUD only: protection and its source until a world tick, the grapple's
 * miss cooldown, and the respawn tick while they wait out of the world after losing a duel (0 when none).
 */
export const PlayerStatusSchema = schema(
  {
    /** "sea", "duel" (reserved or fighting, until the duel is settled) or "respawning". */
    mode: t.string(),
    /** "spawn", "win", "draw", "respawn", or empty when unprotected. */
    protection: t.string(),
    protectedUntil: t.uint32(),
    cooldownUntil: t.uint32(),
    respawnAt: t.uint32(),
  },
  "PlayerStatus",
);
export type PlayerStatusSchema = SchemaType<typeof PlayerStatusSchema>;

/** One seat of a duel: its player index (slot 0 is player one, the creator), its session and whether it is connected. */
export const DuelSeatSchema = schema(
  {
    sessionId: t.string(),
    slot: t.uint8(),
    connected: t.boolean(),
    /** The latest round trip the server measured for this seat, in milliseconds. */
    rtt: t.uint16(),
  },
  "DuelSeat",
);
export type DuelSeatSchema = SchemaType<typeof DuelSeatSchema>;

/**
 * A duel room's lobby state, synced at the patch rate. The duel's frame data does not travel here: inputs, applied
 * inputs, hashes and snapshots are Colyseus messages (the duel protocol in docs/duel.md).
 */
export const DuelRoomStateSchema = schema(
  {
    code: t.string(),
    protocolVersion: t.uint16(),
    /** A practice room: one player against the server's dummy (player two). */
    practice: t.boolean(),
    /** The dummy's behaviour in a practice room ("idle" or "guard"), empty otherwise. */
    dummy: t.string(),
    /** "waiting", "countdown", "fighting" or "over". */
    phase: t.string(),
    /** Frames left in the countdown. */
    countdown: t.uint16(),
    /** The seed both sides create the duel's frame-0 state from. */
    seed: t.uint32(),
    /** The shared input delay in frames, once chosen (0 before). */
    inputDelay: t.uint8(),
    seats: t.array(DuelSeatSchema),
    /** Once over: the winner's slot, or -1 for a draw. */
    winner: t.int8(),
    /** Once over: "ko", "double-ko", "timeout", "overtime" or "forfeit". */
    reason: t.string(),
    /** Once over: the frame the duel ended on. */
    resultFrame: t.uint32(),
  },
  "DuelRoomState",
);
export type DuelRoomStateSchema = SchemaType<typeof DuelRoomStateSchema>;

/**
 * A duel at sea (§14: a simulation object inside the match room): the same lobby a standalone duel room syncs, for its
 * two fighters only. Slot 0 is the attacker, slot 1 the grappled ship. The duel's frames travel as messages, as in a
 * duel room.
 */
export const SeaDuelSchema = schema(
  {
    /** The match code, for the duel HUD. */
    code: t.string(),
    /** Always false: practice is a standalone duel room. */
    practice: t.boolean(),
    /** "countdown", "waiting" (a fighter still loading after the countdown), "fighting" or "over". */
    phase: t.string(),
    countdown: t.uint16(),
    seed: t.uint32(),
    inputDelay: t.uint8(),
    seats: t.array(DuelSeatSchema),
    winner: t.int8(),
    /** Once over: "ko", "double-ko", "timeout", "overtime", "forfeit" or "cancelled". */
    reason: t.string(),
    resultFrame: t.uint32(),
  },
  "SeaDuel",
);
export type SeaDuelSchema = SchemaType<typeof SeaDuelSchema>;

export const MatchStateSchema = schema(
  {
    code: t.string(),
    protocolVersion: t.uint16(),
    /** Private matches are custom matches (§2). */
    custom: t.boolean(),
    /** Players in the match, visible or not. */
    players: t.uint8(),
    /** The simulation frame at the last world step. */
    frame: t.uint32(),
    worldTick: t.uint32(),
    /**
     * Filtered per client (§16): each client's StateView holds its own ship and the ships inside its sight radius,
     * less those in a duel or waiting to respawn (§6), and Colyseus encodes no other entry of this map into that
     * client's messages.
     */
    ships: t.map(ShipSchema).view(),
    /** Telegraphed grapples, filtered like ships: each client's view holds those whose attacker it sees, or aimed at it. */
    grapples: t.map(GrappleSchema).view(),
    /** Duel markers, filtered like ships: each client's view holds those within its sight radius. */
    markers: t.map(DuelMarkerSchema).view(),
    /** Each client's view holds only its own entry. */
    status: t.map(PlayerStatusSchema).view(),
    /** Duels at sea: each client's view holds only the one it fights in. */
    duels: t.map(SeaDuelSchema).view(),
  },
  "MatchState",
);
export type MatchStateSchema = SchemaType<typeof MatchStateSchema>;

