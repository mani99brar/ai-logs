:root {
  color-scheme: dark;
  font-family: system-ui, sans-serif;
  background: #06202f;
  color: #e8f1f5;
}

body {
  margin: 0;
}

[hidden] {
  display: none !important;
}

main {
  padding: 1.5rem;
}

#landing:not([hidden]) {
  max-width: 24rem;
  margin: 4rem auto;
  display: grid;
  gap: 1rem;
}

h1 {
  margin: 0;
}

.tagline,
.version,
.hint {
  color: #9bb8c6;
  margin: 0;
}

button,
input {
  font: inherit;
  padding: 0.5rem 0.75rem;
}

#join-form {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}

#join-code {
  text-transform: uppercase;
  width: 7rem;
}

#join-error {
  color: #ff9b8a;
  min-height: 1.5em;
  margin: 0;
}

#match:not([hidden]) {
  display: flex;
  gap: 1.5rem;
  align-items: flex-start;
}

#game {
  flex: none;
}

#game canvas {
  display: block;
}

#hud {
  max-width: 22rem;
}

#hud dl {
  display: grid;
  grid-template-columns: auto auto;
  gap: 0.25rem 1rem;
  margin: 0;
}

#hud dt {
  color: #9bb8c6;
}

#hud dd {
  margin: 0;
  font-variant-numeric: tabular-nums;
}

#hud dd.warning {
  color: #ff8a80;
  font-weight: 600;
}

#hud ul {
  list-style: none;
  padding: 0;
  font-variant-numeric: tabular-nums;
}

.swatch {
  display: inline-block;
  width: 0.75em;
  height: 0.75em;
  border-radius: 50%;
  margin-right: 0.4em;
}

.duel-entry {
  display: grid;
  gap: 0.75rem;
  border-top: 1px solid #1f4d66;
  padding-top: 1rem;
}

.duel-entry h2 {
  margin: 0;
  font-size: 1.1rem;
}

.duel-buttons,
#join-duel-form {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}

#duel-code {
  text-transform: uppercase;
  width: 7rem;
}

#duel-error {
  color: #ff9b8a;
  min-height: 1.5em;
  margin: 0;
}

#duel:not([hidden]) {
  display: flex;
  gap: 1.5rem;
  align-items: flex-start;
}

#arena {
  flex: none;
}

#arena canvas {
  display: block;
}

#duel-hud {
  max-width: 24rem;
  display: grid;
  gap: 0.75rem;
}

#duel-hud dl {
  display: grid;
  grid-template-columns: auto auto;
  gap: 0.25rem 1rem;
  margin: 0;
}

#duel-hud dt {
  color: #9bb8c6;
}

#duel-hud dd {
  margin: 0;
  font-variant-numeric: tabular-nums;
}

.fighters {
  display: grid;
  gap: 0.75rem;
}

.fighter {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 0.2rem 0.5rem;
  font-variant-numeric: tabular-nums;
}

.fighter .bar {
  grid-column: 1 / -1;
  height: 0.8rem;
  background: linear-gradient(to right, var(--bar) var(--fill, 100%), #10242f var(--fill, 100%));
  border: 1px solid #2d5870;
}

.fighter .bar.stamina {
  height: 0.35rem;
  --bar: #9bd1e5;
}

.fighter.p1 .bar.health {
  --bar: #f4b942;
}

.fighter.p2 .bar.health {
  --bar: #3dd6d0;
}

.connection {
  margin: 0;
  font-variant-numeric: tabular-nums;
}

#duel-result h2 {
  margin: 0;
  color: #fff3b0;
}

.toggle {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}
