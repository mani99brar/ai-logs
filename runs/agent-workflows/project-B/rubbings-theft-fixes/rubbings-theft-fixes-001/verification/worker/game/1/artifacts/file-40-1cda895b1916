import { afterAll, beforeAll, describe, expect, it } from "vitest";
import { seaMap } from "@pirate-sea-race/content";
import { createMatchLedger, startGameServer, type RunningGameServer } from "@pirate-sea-race/server";
import { objectiveRules, type LedgerState } from "@pirate-sea-race/simulation/objectives";
import { HeadlessClient } from "@pirate-sea-race/test-tools";
import { roomOf, tracker } from "./seaDuelSetup.js";

/**
 * The ledger's seed is the room's own private randomness (§3, §16), never the public match code. The server's
 * test-only seam (`MatchTuning.random`) injects the room's randomness: here a constant the test sets before each match
 * is created. The test-only source layout is off, so the sources are dealt by the ledger's own shuffle.
 */
let server: RunningGameServer;
let endpoint: string;
/** What the injected source returns for every draw of the next match created. */
let draw = 0;

beforeAll(async () => {
  server = await startGameServer({
    port: 0,
    host: "127.0.0.1",
    handleSignals: false,
    matchTuning: { sourceLayout: undefined, random: () => draw },
  });
  endpoint = `http://127.0.0.1:${server.port}`;
});

afterAll(async () => {
  await server.close();
});

/** A deal: each source's type, in source order (8 sites over 2 types: one of 70 layouts). */
const dealOf = (ledger: LedgerState): string => ledger.sources.map((source) => `${source.id}=${source.type}`).join(" ");
const dealFor = (seed: number): string => dealOf(createMatchLedger({ map: seaMap, seed, rules: objectiveRules }));

describe("the ledger's deal (§3, §16)", () => {
  it("follows the room's randomness source, not the match code", async ({ onTestFinished }) => {
    const track = tracker(onTestFinished);
    // Two seeds the test first checks deal differently.
    const first = 1;
    let second = first + 1;
    while (dealFor(second) === dealFor(first) && second < first + 100) second++;
    expect(dealFor(second)).not.toBe(dealFor(first));

    const open = async (seed: number): Promise<{ code: string; deal: string }> => {
      draw = seed;
      const client = await HeadlessClient.create(endpoint);
      track(client);
      const room = roomOf(client);
      expect(room.ledgerState.sources.every((source) => source.unlocked)).toBe(true);
      return { code: client.code, deal: dealOf(room.ledgerState) };
    };

    // The same source: two matches, two different codes, the same deal, and it is the ledger's deal for that seed.
    const a = await open(first);
    const b = await open(first);
    expect(b.code).not.toBe(a.code);
    expect(a.deal).toBe(dealFor(first));
    expect(b.deal).toBe(a.deal);
    // Another source through the same room: the deal changes with it.
    const c = await open(second);
    expect(c.deal).toBe(dealFor(second));
    expect(c.deal).not.toBe(a.deal);
  });
});
