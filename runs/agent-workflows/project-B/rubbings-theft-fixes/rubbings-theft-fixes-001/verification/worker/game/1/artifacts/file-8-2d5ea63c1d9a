import { describe, expect, it, vi } from "vitest";

// The real `randomInt`, watched: the test sees every call the room's default randomness makes.
vi.mock("node:crypto", async (importOriginal) => {
  const crypto = await importOriginal<typeof import("node:crypto")>();
  return { ...crypto, randomInt: vi.fn((...args: Parameters<typeof crypto.randomInt>) => (crypto.randomInt as (...each: unknown[]) => number)(...args)) };
});

const { randomInt } = await import("node:crypto");
const { cryptoRandom, DEFAULT_MATCH_TUNING } = await import("./MatchRoom.js");

describe("the room's randomness in production (§3, §16)", () => {
  it("is node:crypto's randomInt, with the source layout off", () => {
    expect(DEFAULT_MATCH_TUNING.random).toBe(cryptoRandom);
    expect(DEFAULT_MATCH_TUNING.sourceLayout).toBeUndefined();
    const before = vi.mocked(randomInt).mock.calls.length;
    const seed = DEFAULT_MATCH_TUNING.random(0, 2 ** 32);
    expect(vi.mocked(randomInt).mock.calls.slice(before)).toEqual([[0, 2 ** 32]]);
    expect(vi.mocked(randomInt).mock.results.at(-1)).toEqual({ type: "return", value: seed });
    expect(Number.isInteger(seed) && seed >= 0 && seed < 2 ** 32).toBe(true);
  });
});
