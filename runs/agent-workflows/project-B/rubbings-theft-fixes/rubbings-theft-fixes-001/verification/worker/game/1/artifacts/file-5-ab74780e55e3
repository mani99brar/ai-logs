import { DEFAULT_PORT, startGameServer } from "./server.js";

const port = Number(process.env["PORT"] ?? DEFAULT_PORT);
// Production reads no test-only setting, and skips the per-tick invariant checks that development and tests run.
const running = await startGameServer({ port, checkInvariants: false });
console.log(`Pirate Sea Race server listening on ws://localhost:${running.port}`);
