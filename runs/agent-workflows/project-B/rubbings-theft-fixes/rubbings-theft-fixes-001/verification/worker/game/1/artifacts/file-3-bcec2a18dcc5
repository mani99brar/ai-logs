import { parseTestSourceLayout, TEST_PLACEMENT_ENV, TEST_SOURCES_ENV } from "@pirate-sea-race/protocol";
import { DEFAULT_PORT, startGameServer } from "./server.js";

/**
 * The development and test entry point (`npm run dev`, and `start:source` for the browser tests). Unlike the
 * production entry (`main.ts`), it reads the test-only settings, each off unless its variable is set:
 * PIRATE_SEA_RACE_TEST_PLACEMENT=1 turns on the route that puts ships on chosen tiles, and
 * PIRATE_SEA_RACE_TEST_SOURCES pins every match's source layout (for example `sun,sun|moon,moon|sun,sun|moon,moon`),
 * so a scenario can pick an island by its rubbing type.
 */
const port = Number(process.env["PORT"] ?? DEFAULT_PORT);
const testPlacement = process.env[TEST_PLACEMENT_ENV] === "1";
const layoutSetting = process.env[TEST_SOURCES_ENV];
const sourceLayout = layoutSetting === undefined || layoutSetting === "" ? undefined : parseTestSourceLayout(layoutSetting);
if (layoutSetting !== undefined && layoutSetting !== "" && sourceLayout === undefined) throw new Error(`${TEST_SOURCES_ENV} is malformed: ${layoutSetting}`);
const running = await startGameServer({ port, testPlacement, ...(sourceLayout !== undefined ? { matchTuning: { sourceLayout } } : {}) });
const settings = [testPlacement ? "test placement on" : "", sourceLayout !== undefined ? `test sources ${layoutSetting}` : ""].filter((each) => each !== "");
console.log(`Pirate Sea Race server listening on ws://localhost:${running.port}${settings.length > 0 ? ` (${settings.join(", ")})` : ""}`);
