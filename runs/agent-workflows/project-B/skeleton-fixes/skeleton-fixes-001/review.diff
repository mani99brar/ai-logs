+++ b/apps/web/src/connection.test.ts
@@ -0,0 +1,60 @@
+import { ErrorCode, MatchMakeError } from "@colyseus/sdk";
+import { describe, expect, it } from "vitest";
+import {
+  JoinRefusal,
+  MALFORMED_MATCH_REQUEST_MESSAGE,
+  MATCH_CODE_REQUIRED_MESSAGE,
+  MATCH_UNAVAILABLE_MESSAGE,
+  matchFullMessage,
+  NO_SUCH_MATCH_MESSAGE,
+  PROTOCOL_VERSION,
+  protocolMismatchMessage,
+} from "@pirate-sea-race/protocol";
+import { createMatch, joinMatch, refusalMessage } from "./connection.js";
+
+/** A localhost endpoint nothing listens on (TCP port 1 is a privileged service port no one runs). */
+const UNREACHABLE_ENDPOINT = "http://127.0.0.1:1";
+
+/** Refusals as the SDK surfaces them: the server's status or Colyseus error code, and its message. */
+describe("refusalMessage", () => {
+  it("shows the server's protocol-mismatch refusal as sent", () => {
+    const message = protocolMismatchMessage(PROTOCOL_VERSION - 1);
+    expect(refusalMessage(new MatchMakeError(message, JoinRefusal.ProtocolMismatch))).toBe(message);
+    expect(message).toMatch(/^Protocol version mismatch: client v\d+, server v\d+\./);
+  });
+
+  it("shows the server's unknown-code refusal as sent", () => {
+    expect(refusalMessage(new MatchMakeError(NO_SUCH_MATCH_MESSAGE, JoinRefusal.NoSuchMatch))).toBe("No match with that code");
+  });
+
+  it("shows the server's full-match refusal as sent", () => {
+    expect(refusalMessage(new MatchMakeError(matchFullMessage(8), JoinRefusal.MatchFull))).toBe("That match is full (8 players)");
+  });
+
+  it("shows the room's own refusals as sent", () => {
+    expect(refusalMessage(new MatchMakeError(MATCH_CODE_REQUIRED_MESSAGE, JoinRefusal.CodeRequired))).toBe(MATCH_CODE_REQUIRED_MESSAGE);
+    expect(refusalMessage(new MatchMakeError(MALFORMED_MATCH_REQUEST_MESSAGE, JoinRefusal.BadRequest))).toBe(MALFORMED_MATCH_REQUEST_MESSAGE);
+  });
+
+  it("does not claim the match is missing on the generic matchmaker failure", () => {
+    const generic = new MatchMakeError("no rooms found with provided criteria", ErrorCode.MATCHMAKE_INVALID_CRITERIA);
+    expect(refusalMessage(generic)).toBe(MATCH_UNAVAILABLE_MESSAGE);
+    expect(refusalMessage(generic)).toBe("That match is full or no longer exists");
+    expect(refusalMessage(generic)).not.toBe(NO_SUCH_MATCH_MESSAGE);
+  });
+
+  it("says the server cannot be reached when nothing listens at the endpoint", async () => {
+    const endpoint = UNREACHABLE_ENDPOINT;
+    const createError: unknown = await createMatch(endpoint).catch((error: unknown) => error);
+    expect(createError).toBeInstanceOf(Error);
+    expect(refusalMessage(createError)).toBe("Cannot reach the match server");
+    const joinError: unknown = await joinMatch(endpoint, "k7q2mx").catch((error: unknown) => error);
+    expect(refusalMessage(joinError)).toBe("Cannot reach the match server");
+    expect(refusalMessage(new TypeError("Failed to fetch"))).toBe("Cannot reach the match server");
+  });
+
+  it("falls back to a generic message for anything unreadable", () => {
+    expect(refusalMessage(undefined)).toBe("Could not join the match");
+    expect(refusalMessage(new Error(""))).toBe("Could not join the match");
+  });
+});
