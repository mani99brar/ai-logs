import { Client, ErrorCode, MatchMakeError, type Room } from "@colyseus/sdk";
import {
  CREATE_TOKEN_BYTES,
  formatCreateToken,
  MATCH_ROOM,
  MATCH_UNAVAILABLE_MESSAGE,
  normalizeMatchCode,
  PROTOCOL_VERSION,
} from "@pirate-sea-race/protocol";
import type { MatchStateSchema } from "@pirate-sea-race/server/schema";

export type MatchRoom = Room<unknown, MatchStateSchema>;

const SERVER_PORT = 2593;

/** The match server: `VITE_SERVER_URL` when set, otherwise port 2593 on the host that served the page. */
export function serverEndpoint(location: Location): string {
  const configured: unknown = import.meta.env["VITE_SERVER_URL"];
  return typeof configured === "string" && configured !== "" ? configured : `${location.protocol}//${location.hostname}:${SERVER_PORT}`;
}

/** Creates a private match, proving to the new room with a fresh one-time token that this client is its creator. */
export function createMatch(endpoint: string): Promise<MatchRoom> {
  const createToken = formatCreateToken(crypto.getRandomValues(new Uint8Array(CREATE_TOKEN_BYTES)));
  return new Client(endpoint).create<MatchStateSchema>(MATCH_ROOM, { protocolVersion: PROTOCOL_VERSION, createToken });
}

export function joinMatch(endpoint: string, code: string): Promise<MatchRoom> {
  return new Client(endpoint).join<MatchStateSchema>(MATCH_ROOM, {
    protocolVersion: PROTOCOL_VERSION,
    code: normalizeMatchCode(code),
  });
}

/**
 * What to tell the player when the server refuses or cannot be reached. The server's own refusals (400, 403, 404,
 * 409, 426) carry readable messages. Colyseus's generic "no rooms found" means the server admitted the request but
 * the match filled up or closed before a seat was reserved, so it must not claim the match is missing. A failed
 * request that never reached the server carries no numeric code (the SDK wraps fetch's error).
 */
export function refusalMessage(error: unknown): string {
  const code = (error as { code?: unknown } | null)?.code;
  if (code === ErrorCode.MATCHMAKE_INVALID_CRITERIA) return MATCH_UNAVAILABLE_MESSAGE;
  if (error instanceof TypeError || (error instanceof MatchMakeError && typeof code !== "number")) {
    return "Cannot reach the match server";
  }
  if (error instanceof Error && error.message !== "") return error.message;
  return "Could not join the match";
}
