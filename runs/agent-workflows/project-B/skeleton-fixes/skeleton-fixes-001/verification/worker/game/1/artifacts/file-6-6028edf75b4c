import { describe, expect, it } from "vitest";
import { INTERPOLATION_DELAY_MS, SnapshotBuffer } from "./interpolation.js";
import { axis } from "./keyboard.js";
import { estimateServerFrame } from "./inputSender.js";
import { MatchView } from "./matchView.js";

describe("SnapshotBuffer", () => {
  it("interpolates between the snapshots around the render time", () => {
    const buffer = new SnapshotBuffer();
    buffer.push(0, 0, 100);
    buffer.push(50, 100, 100);
    buffer.push(100, 100, 200);
    expect(buffer.sample(25)).toEqual({ x: 50, y: 100 });
    expect(buffer.sample(75)).toEqual({ x: 100, y: 150 });
  });

  it("holds the ends instead of extrapolating", () => {
    const buffer = new SnapshotBuffer();
    expect(buffer.sample(10)).toBeUndefined();
    buffer.push(10, 5, 5);
    buffer.push(20, 15, 5);
    expect(buffer.sample(0)).toEqual({ x: 5, y: 5 });
    expect(buffer.sample(500)).toEqual({ x: 15, y: 5 });
  });

  it("keeps a bounded history and ignores out-of-order snapshots", () => {
    const buffer = new SnapshotBuffer(3);
    for (let time = 0; time < 10; time++) buffer.push(time * 10, time, 0);
    buffer.push(5, 999, 999);
    expect(buffer.latest).toEqual({ time: 90, x: 9, y: 0 });
    expect(buffer.sample(0)).toEqual({ x: 7, y: 0 });
  });
});

describe("MatchView", () => {
  const ship = (x: number, y: number) => ({ id: "a", slot: 0, x, y, heading: 0 });

  it("draws ships between two snapshots INTERPOLATION_DELAY_MS behind now, not at the latest one", () => {
    const view = new MatchView("a");
    view.ingest([ship(0, 500)], 1000);
    view.ingest([ship(100, 500)], 1050);
    view.ingest([ship(200, 600)], 1100);
    expect(INTERPOLATION_DELAY_MS).toBe(100);
    // At 1175 the scene draws the ship as it was at 1075, halfway between the patches of 1050 and 1100.
    const drawn = view.renderPosition("a", 1175)!;
    expect(drawn).toEqual({ x: 150, y: 550 });
    expect(drawn.x).toBeGreaterThan(100);
    expect(drawn.x).toBeLessThan(200);
    // The HUD's readout is the latest decoded server position.
    expect(view.ships()).toEqual([ship(200, 600)]);
    // Once now is INTERPOLATION_DELAY_MS past the last patch, the drawing catches up with it.
    expect(view.renderPosition("a", 1100 + INTERPOLATION_DELAY_MS)).toEqual({ x: 200, y: 600 });
  });

  it("forgets a ship that leaves", () => {
    const view = new MatchView("a");
    view.ingest([ship(0, 0)], 0);
    view.ingest([], 50);
    expect(view.renderPosition("a", 200)).toBeUndefined();
    expect(view.ships()).toEqual([]);
  });
});

describe("keyboard axes", () => {
  it("makes opposing keys neutral", () => {
    expect(axis(true, true)).toBe(0);
    expect(axis(true, false)).toBe(-1);
    expect(axis(false, true)).toBe(1);
    expect(axis(false, false)).toBe(0);
  });
});

describe("frame estimate", () => {
  it("advances the last patched frame by elapsed match time, within the lead limit", () => {
    expect(estimateServerFrame(300, 1000, 1000)).toBe(300);
    expect(estimateServerFrame(300, 1000, 1050)).toBe(303);
    expect(estimateServerFrame(300, 1000, 60_000)).toBe(315);
  });
});
