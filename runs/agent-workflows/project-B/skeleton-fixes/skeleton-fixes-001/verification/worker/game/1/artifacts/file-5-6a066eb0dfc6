import * as Phaser from "phaser";
import { defaultSimulationConfig } from "@pirate-sea-race/simulation";
import { cssColor, slotColor, type MatchView } from "./matchView.js";

const { map } = defaultSimulationConfig;
export const TILE_PIXELS = 16;
export const SCENE_WIDTH = map.widthTiles * TILE_PIXELS;
export const SCENE_HEIGHT = map.heightTiles * TILE_PIXELS;
const PIXELS_PER_SUB_UNIT = TILE_PIXELS / map.subUnitsPerTile;

const SEA_COLOR = 0x0b3d5c;
const GRID_COLOR = 0x145374;

/** A ship as drawn this frame, in canvas pixels, for the DOM report tests read. */
export interface DrawnShip {
  readonly id: string;
  readonly x: number;
  readonly y: number;
  readonly color: string;
}

/**
 * Draws the sea and every ship as placeholder shapes at interpolated server positions. Each frame it records what
 * it drew in `data-drawn-ships` on the report element.
 */
export class SeaScene extends Phaser.Scene {
  private readonly shipGraphics = new Map<string, Phaser.GameObjects.Graphics>();
  private lastReport = "";

  constructor(
    private readonly view: MatchView,
    private readonly report: HTMLElement,
  ) {
    super("sea");
  }

  create(): void {
    const sea = this.add.graphics();
    sea.fillStyle(SEA_COLOR, 1);
    sea.fillRect(0, 0, SCENE_WIDTH, SCENE_HEIGHT);
    sea.lineStyle(1, GRID_COLOR, 1);
    for (let tile = 0; tile <= map.widthTiles; tile += 4) sea.lineBetween(tile * TILE_PIXELS, 0, tile * TILE_PIXELS, SCENE_HEIGHT);
    for (let tile = 0; tile <= map.heightTiles; tile += 4) sea.lineBetween(0, tile * TILE_PIXELS, SCENE_WIDTH, tile * TILE_PIXELS);
  }

  override update(): void {
    const now = performance.now();
    const drawn: DrawnShip[] = [];
    const present = new Set<string>();
    for (const ship of this.view.ships()) {
      const position = this.view.renderPosition(ship.id, now);
      if (position === undefined) continue;
      present.add(ship.id);
      let graphics = this.shipGraphics.get(ship.id);
      if (graphics === undefined) {
        graphics = this.drawShip(slotColor(ship.slot), ship.id === this.view.selfId);
        this.shipGraphics.set(ship.id, graphics);
      }
      const x = position.x * PIXELS_PER_SUB_UNIT;
      const y = position.y * PIXELS_PER_SUB_UNIT;
      graphics.setPosition(x, y);
      graphics.setRotation((ship.heading * Math.PI) / 4);
      drawn.push({ id: ship.id, x: Math.round(x), y: Math.round(y), color: cssColor(slotColor(ship.slot)) });
    }
    for (const [id, graphics] of this.shipGraphics) {
      if (present.has(id)) continue;
      graphics.destroy();
      this.shipGraphics.delete(id);
    }
    const report = JSON.stringify(drawn);
    if (report !== this.lastReport) {
      this.report.dataset["drawnShips"] = report;
      this.lastReport = report;
    }
  }

  /** A round hull with a bow pointing along +x; the player's own ship gets a white ring. */
  private drawShip(color: number, own: boolean): Phaser.GameObjects.Graphics {
    const graphics = this.add.graphics();
    graphics.fillStyle(color, 1);
    graphics.fillCircle(0, 0, 9);
    graphics.fillTriangle(7, -6, 17, 0, 7, 6);
    if (own) {
      graphics.lineStyle(2, 0xffffff, 1);
      graphics.strokeCircle(0, 0, 13);
    }
    return graphics;
  }
}

export function startGame(parent: HTMLElement, view: MatchView): Phaser.Game {
  return new Phaser.Game({
    type: Phaser.AUTO,
    parent,
    width: SCENE_WIDTH,
    height: SCENE_HEIGHT,
    backgroundColor: SEA_COLOR,
    banner: false,
    audio: { noAudio: true },
    scene: new SeaScene(view, parent),
  });
}
