{
  "version": "1.2.0",
  "feature": "Pirate Sea Race skeleton review fixes",
  "independent_review": true,
  "integration_approval": true,
  "max_verification_attempts": 3,
  "setup": [
    {
      "argv": [
        "npm",
        "ci"
      ],
      "timeout_seconds": 900
    }
  ],
  "workers": [
    {
      "node_id": "game",
      "role": "fullstack",
      "required_check_kinds": [
        "typecheck",
        "unit",
        "integration",
        "build",
        "browser"
      ],
      "owned_paths": [
        "package.json",
        "package-lock.json",
        "tsconfig.json",
        "tsconfig.base.json",
        "vitest.config.ts",
        ".gitignore",
        ".npmrc",
        "README.md",
        "CLAUDE.md",
        "docs/architecture.md",
        "apps",
        "packages",
        "tests",
        "assets",
        "infra",
        "scripts"
      ],
      "checks": [
        {
          "id": "typecheck",
          "kind": "typecheck",
          "argv": [
            "npm",
            "run",
            "typecheck"
          ],
          "timeout_seconds": 300,
          "scenarios": []
        },
        {
          "id": "unit",
          "kind": "unit",
          "argv": [
            "npm",
            "run",
            "test:unit"
          ],
          "timeout_seconds": 300,
          "scenarios": []
        },
        {
          "id": "integration",
          "kind": "integration",
          "argv": [
            "npm",
            "run",
            "test:integration"
          ],
          "timeout_seconds": 300,
          "scenarios": []
        },
        {
          "id": "build",
          "kind": "build",
          "argv": [
            "npm",
            "run",
            "build"
          ],
          "timeout_seconds": 600,
          "scenarios": []
        },
        {
          "id": "browser",
          "kind": "browser",
          "argv": [
            "npx",
            "--no-install",
            "playwright",
            "test",
            "--config=tests/e2e/playwright.config.ts"
          ],
          "timeout_seconds": 600,
          "scenarios": [
            {
              "id": "join-private-match",
              "description": "One browser opens the landing page, enters a private match code and joins; the HUD shows the code, the protocol version, one player and a connected status."
            },
            {
              "id": "two-ships-sync",
              "description": "Two browsers join the same private match; one moves its ship with the keyboard and the other browser's view shows that ship at the new server-authoritative position."
            }
          ]
        }
      ]
    }
  ]
}
