import { fileURLToPath } from "node:url";
import { defineConfig, devices } from "@playwright/test";

const root = fileURLToPath(new URL("../..", import.meta.url));
const SERVER_PORT = 2593;
const WEB_PORT = 5393;

/**
 * Browser scenarios against the real server and web client on their fixed ports. Both start from source: the server
 * through tsx (its dev and test entry, with test placement on), the client as a fresh Vite production build served by
 * `vite preview`, so no prior build is needed.
 */
export default defineConfig({
  testDir: ".",
  testMatch: "**/*.spec.ts",
  timeout: 60_000,
  expect: { timeout: 10_000 },
  fullyParallel: false,
  workers: 1,
  retries: 0,
  forbidOnly: !!process.env["CI"],
  reporter: "list",
  use: {
    baseURL: `http://localhost:${WEB_PORT}`,
    trace: "retain-on-failure",
  },
  projects: [{ name: "chromium", use: { ...devices["Desktop Chrome"] } }],
  webServer: [
    {
      command: "npm run start:source -w @pirate-sea-race/server",
      cwd: root,
      // The dev and test entry reads the test-only settings: the scenarios put ships where they need them, and every
      // match deals its rubbings in a fixed layout (Suns on Palm Key and Old Stones, Moons on Ember Rock and Mist Cay).
      env: { PORT: String(SERVER_PORT), PIRATE_SEA_RACE_TEST_PLACEMENT: "1", PIRATE_SEA_RACE_TEST_SOURCES: "sun,sun|moon,moon|sun,sun|moon,moon" },
      url: `http://localhost:${SERVER_PORT}/__healthcheck`,
      reuseExistingServer: false,
      timeout: 60_000,
    },
    {
      command: "npm run build -w @pirate-sea-race/web && npm run preview -w @pirate-sea-race/web",
      cwd: root,
      url: `http://localhost:${WEB_PORT}`,
      reuseExistingServer: false,
      timeout: 120_000,
    },
  ],
});
