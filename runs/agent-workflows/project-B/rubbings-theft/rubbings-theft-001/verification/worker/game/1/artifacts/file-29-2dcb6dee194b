import { z } from "zod";
import { matchCodeSchema } from "./join.js";

/**
 * Test-only ship placement. Browser and integration tests put ships where a scenario needs them (in sight of each
 * other, out of sight, behind a shoal) instead of relying on random spawn slots. The server offers the route only when
 * its entry point reads TEST_PLACEMENT_ENV as "1" (the dev and test entries; never the production `main`), and it is
 * off by default. It moves a ship and nothing else: admission and per-client visibility are unchanged.
 */
export const TEST_PLACEMENT_ENV = "PIRATE_SEA_RACE_TEST_PLACEMENT";
export const TEST_PLACEMENT_PATH = "/__test/place";

/**
 * The headings a placement may name: the simulation's HEADING_COUNT, which lives in the content package the protocol
 * does not depend on. A server unit test (`apps/server/src/testPlacement.test.ts`) keeps the two equal.
 */
export const PLACEMENT_HEADING_COUNT = 64;

/** The size of the map a placement lands on, in tiles: the server passes its sea map. */
export interface PlacementBounds {
  readonly widthTiles: number;
  readonly heightTiles: number;
}

/**
 * Puts a player's ship at rest on the centre of a navigable tile, with a heading in [0, PLACEMENT_HEADING_COUNT). The
 * tile must lie on the map: its bounds come from the map, which lives in the content package, so the server builds
 * the schema from its own map.
 */
export function createTestPlacementSchema(bounds: PlacementBounds) {
  return z.strictObject({
    code: matchCodeSchema,
    sessionId: z.string().min(1).max(64),
    tileX: z.int().min(0).max(bounds.widthTiles - 1),
    tileY: z.int().min(0).max(bounds.heightTiles - 1),
    heading: z.int().min(0).max(PLACEMENT_HEADING_COUNT - 1),
  });
}

export type TestPlacement = z.infer<ReturnType<typeof createTestPlacementSchema>>;

/**
 * Test-only source layout (§4 assignment, pinned for tests). The server deals the rubbings onto the island sources
 * with its own private randomness; a scenario that needs "a Sun island" and "a Moon island" cannot know which is
 * which. With this setting the dev and test entry (never the production `main`) deals them in a fixed layout instead:
 * one island per `|`-separated group, in island order, each group the types of that island's sources in source order,
 * for example `sun,sun|moon,moon|sun,sun|moon,moon`. It is off unless the variable is set, and the layout must still
 * pass the ledger's assignment validation (every rubbing sealed once).
 */
export const TEST_SOURCES_ENV = "PIRATE_SEA_RACE_TEST_SOURCES";

/** Parses a test source layout: island groups of rubbing type names, or undefined when it is malformed. */
export function parseTestSourceLayout(text: string): string[][] | undefined {
  const islands = text.split("|").map((group) => group.split(",").map((type) => type.trim()));
  if (islands.some((group) => group.some((type) => !/^[a-z]+$/.test(type)))) return undefined;
  return islands;
}
