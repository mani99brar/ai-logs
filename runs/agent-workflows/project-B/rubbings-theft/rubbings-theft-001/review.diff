@@ -0,0 +1,55 @@
+import { encounterRules } from "@pirate-sea-race/content/encounters";
+import type { MatchTuning } from "@pirate-sea-race/server";
+import { findPlayer, heldTypes, type LedgerState } from "@pirate-sea-race/simulation/objectives";
+import type { HeadlessClient, HeadlessClientOptions } from "@pirate-sea-race/test-tools";
+import { EAST, HUB_X, OPEN_ROW, playersAt, roomOf, TEST_SOURCE_LAYOUT, WEST, type Seat } from "./seaDuelSetup.js";
+
+/**
+ * What the rubbing tests share (`rubbings*.test.ts`). Colyseus has one matchmaker per process, so a test file's server
+ * gives every match in that file the same timings: each file picks its own `MatchTuning`, all with the test source
+ * layout, and asserts in world ticks.
+ */
+
+export const layout = TEST_SOURCE_LAYOUT.map((types) => [...types]);
+
+/**
+ * Encounter timings that keep a theft test to seconds: a 4 s ready check (so a fighter who never readies loses by
+ * forfeit quickly), a 2 s respawn wait, and 5 s of protection after a win or a respawn. The ready check still ends
+ * after the 3 s countdown.
+ */
+export const quickEncounters = { ...encounterRules, readyTimeoutTicks: 80, respawnDelayTicks: 40, winProtectionTicks: 100, respawnProtectionTicks: 100 };
+
+/** A fighter away from a duel forfeits after 3 s instead of 10 s. */
+export const QUICK_ABSENCE_TICKS = 60;
+
+export function tuned(tuning: Partial<MatchTuning>): Partial<MatchTuning> {
+  return { sourceLayout: layout, encounters: quickEncounters, duelAbsenceTicks: QUICK_ABSENCE_TICKS, ...tuning };
+}
+
+/** The host west and the guest east on the open row, in grapple range, the host facing the guest. */
+export const HOST_SEAT: Seat = { tileX: HUB_X - 3, tileY: OPEN_ROW, heading: EAST };
+export const GUEST_SEAT: Seat = { tileX: HUB_X + 3, tileY: OPEN_ROW, heading: WEST };
+
+export async function placePair(endpoint: string, host: HeadlessClient, guest: HeadlessClient): Promise<void> {
+  await host.placeShip(endpoint, HOST_SEAT);
+  await guest.placeShip(endpoint, GUEST_SEAT);
+  await host.waitFor(() => host.ship(guest.sessionId) !== undefined);
+}
+
+export const ledgerOf = (client: HeadlessClient): LedgerState => roomOf(client).ledgerState;
+export const ledgerPlayer = (client: HeadlessClient, id = client.sessionId) => findPlayer(ledgerOf(client), id);
+export const lastDuel = (client: HeadlessClient) => ledgerOf(client).duels.at(-1);
+/** The types a player holds in the ledger, reserved ones included. */
+export const holds = (client: HeadlessClient, id: string) => heldTypes(ledgerOf(client), id);
+export const shipOf = (client: HeadlessClient, id: string) => roomOf(client).matchState.ships.find((ship) => ship.id === id);
+
+/** Two players in one match on their seats, the guest's client with its own options (never ready: it loses by forfeit). */
+export async function pair(
+  endpoint: string,
+  track: (client: HeadlessClient) => void,
+  guest: HeadlessClientOptions = {},
+  endpoints?: readonly string[],
+): Promise<{ host: HeadlessClient; guest: HeadlessClient }> {
+  const [host, other] = (await playersAt(endpoint, [HOST_SEAT, GUEST_SEAT], track, { clients: [{}, guest], ...(endpoints ? { endpoints } : {}) })) as [HeadlessClient, HeadlessClient];
+  return { host, guest: other };
+}
