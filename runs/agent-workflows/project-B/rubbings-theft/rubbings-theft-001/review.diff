@@ -0,0 +1,68 @@
+import { defaultSimulationConfig } from "@pirate-sea-race/simulation";
+import { TILE_PIXELS } from "./camera.js";
+import { elapsedText } from "./hud.js";
+import type { CacheSnapshot, MarkerSnapshot } from "./matchView.js";
+
+const PIXELS_PER_SUB_UNIT = TILE_PIXELS / defaultSimulationConfig.map.subUnitsPerTile;
+/** The placeholder art was drawn for 16 px tiles; its details scale with the tile. */
+const ART_SCALE = TILE_PIXELS / 16;
+/** Half the length of a duel marker's crossed swords, in pixels. */
+export const SWORD_HALF = 7 * ART_SCALE;
+/** Half the side of a cache's chest, in pixels. */
+export const CHEST_HALF = 5 * ART_SCALE;
+
+/**
+ * What the sea scene draws markers with, in world pixels; Phaser's graphics in the scene, a recording fake in the
+ * unit tests, so what is drawn where can be checked without a canvas.
+ */
+export interface MarkerPen {
+  /** Crossed swords centred on a point, blades `half` pixels each way. */
+  swords(x: number, y: number, half: number): void;
+  /** The `index`th marker label: its text, centred horizontally, top at `y`. */
+  label(index: number, x: number, y: number, text: string): void;
+  /** A chest centred on a point. */
+  chest(x: number, y: number, half: number): void;
+}
+
+/** A duel marker as drawn this frame, in canvas pixels, with the elapsed time it shows. */
+export interface DrawnMarker {
+  readonly x: number;
+  readonly y: number;
+  readonly elapsed: string;
+}
+
+/** A cache marker as drawn this frame, in canvas pixels, and its dock. */
+export interface DrawnCache {
+  readonly x: number;
+  readonly y: number;
+  readonly dock: number;
+}
+
+/** A position in sub-units, in world pixels. */
+export function worldPixels(position: { readonly x: number; readonly y: number }): { x: number; y: number } {
+  return { x: position.x * PIXELS_PER_SUB_UNIT, y: position.y * PIXELS_PER_SUB_UNIT };
+}
+
+/**
+ * §6: each duel marker in sight as crossed swords at the duel's position, with its elapsed time since the reservation
+ * (minutes and seconds of world ticks) just below. Returns what it drew, in canvas pixels (the camera's scroll taken
+ * off), for the scene's report.
+ */
+export function drawDuelMarkers(pen: MarkerPen, markers: readonly MarkerSnapshot[], worldTick: number, scroll: { x: number; y: number }): DrawnMarker[] {
+  return markers.map((marker, index) => {
+    const { x, y } = worldPixels(marker);
+    const elapsed = elapsedText(marker.startTick, worldTick);
+    pen.swords(x, y, SWORD_HALF);
+    pen.label(index, x, y + SWORD_HALF + 4, elapsed);
+    return { x: Math.round(x - scroll.x), y: Math.round(y - scroll.y), elapsed };
+  });
+}
+
+/** §12: each recovery cache in sight as a chest on its dock; its contents are never drawn (only a moored player reads them). */
+export function drawCaches(pen: MarkerPen, caches: readonly CacheSnapshot[], scroll: { x: number; y: number }): DrawnCache[] {
+  return caches.map((cache) => {
+    const { x, y } = worldPixels(cache);
+    pen.chest(x, y, CHEST_HALF);
+    return { x: Math.round(x - scroll.x), y: Math.round(y - scroll.y), dock: cache.dock };
+  });
+}
