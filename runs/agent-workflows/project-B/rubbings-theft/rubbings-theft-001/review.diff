@@ -0,0 +1,167 @@
+import { describe, expect, it } from "vitest";
+import { Buttons, INPUT_HOLD_FRAMES, MessageType, type InputMessage } from "@pirate-sea-race/protocol";
+import { defaultSimulationConfig, NOT_DOCKED, STEPS_PER_SECOND, tileCentre } from "@pirate-sea-race/simulation";
+import { cacheLine, holdLine, holdProgress, islandLine, resultLine, rubbingsText, settlementLine, theftChoice, typeName } from "./hud.js";
+import { InputSender } from "./inputSender.js";
+import { KeyboardHelm } from "./keyboard.js";
+import { drawCaches, drawDuelMarkers, SWORD_HALF, type MarkerPen } from "./markers.js";
+import { MatchView, objectivesOf, type ObjectivesSnapshot, type ObjectivesStatusFields } from "./matchView.js";
+import { TILE_PIXELS } from "./camera.js";
+
+const fields: ObjectivesStatusFields = {
+  gold: 50,
+  rubbings: "",
+  islandTypes: "",
+  cacheTypes: "",
+  target: "",
+  channel: "",
+  channelType: "",
+  channelHeld: 0,
+  channelTotal: 0,
+  channelResult: "",
+  channelResultAt: 0,
+  theftDuel: "",
+  theftOptions: "",
+  theftDeadline: 0,
+  settledRole: "",
+  stolen: "",
+  goldChange: 0,
+  settledAt: 0,
+};
+const base: ObjectivesSnapshot = objectivesOf(fields);
+const { map } = defaultSimulationConfig;
+const palmWest = map.docks[0]!;
+const moored = { id: "me", slot: 0, ...tileCentre(defaultSimulationConfig, palmWest.tileX, palmWest.tileY), heading: 0, speed: 0, dock: palmWest.id };
+const atSea = { ...moored, dock: NOT_DOCKED };
+
+describe("the private status the HUD reads (§4, §16)", () => {
+  it("splits the comma-separated lists the server sends, and keeps the cache markers without contents", () => {
+    const view = new MatchView("me");
+    expect(view.objectives()).toBeUndefined();
+    view.ingestObjectives({ ...fields, rubbings: "sun,moon", islandTypes: "sun", theftOptions: "moon" }, [{ x: 1, y: 2, dock: 3 }]);
+    expect(view.objectives()).toMatchObject({ gold: 50, rubbings: ["sun", "moon"], islandTypes: ["sun"], cacheTypes: [], theftOptions: ["moon"] });
+    expect(view.caches()).toEqual([{ x: 1, y: 2, dock: 3 }]);
+  });
+
+  it("names rubbings and what the player holds", () => {
+    expect(typeName("moon")).toBe("Moon");
+    expect(rubbingsText([])).toBe("none yet");
+    expect(rubbingsText(["sun", "moon"])).toBe("Sun, Moon");
+  });
+});
+
+describe("the harbour lines (§4, §12)", () => {
+  it("shows the island's sealed types only while moored at it", () => {
+    const objectives = { ...base, islandTypes: ["sun", "sun"] };
+    expect(islandLine({ selfId: "me", ships: [moored], objectives })).toEqual({ text: "Palm Key holds: Sun, Sun", state: "sun,sun" });
+    // At sea the island's types are not shown, even if a stale status still carried them.
+    expect(islandLine({ selfId: "me", ships: [atSea], objectives })).toEqual({ text: "", state: "none" });
+    expect(islandLine({ selfId: "me", ships: [moored], objectives: base })).toEqual({ text: "Palm Key holds no more rubbings", state: "empty" });
+    expect(islandLine({ selfId: "me", ships: [moored], objectives: undefined }).state).toBe("none");
+  });
+
+  it("shows a recovery cache's contents at its dock", () => {
+    expect(cacheLine({ objectives: { ...base, cacheTypes: ["moon"] } })).toEqual({ text: "Recovery cache here: Moon", state: "moon" });
+    expect(cacheLine({ objectives: base })).toEqual({ text: "", state: "none" });
+  });
+
+  it("tells what E does here, then the hold's seconds left and progress, then the result", () => {
+    expect(holdLine({ objectives: { ...base, target: "collect:sun" } })).toEqual({ text: "Hold E to collect the Sun rubbing", state: "ready:collect:sun" });
+    expect(holdLine({ objectives: { ...base, target: "claim:moon" } })).toEqual({ text: "Hold E to claim the Moon rubbing from the cache", state: "ready:claim:moon" });
+    expect(holdLine({ objectives: base })).toEqual({ text: "", state: "none" });
+    const holding = { ...base, target: "collect:sun", channel: "collect", channelType: "sun", channelHeld: 30, channelTotal: 120 };
+    expect(holdLine({ objectives: holding })).toEqual({ text: "Collecting the Sun rubbing: keep holding E, 5 s left", state: "collect:sun", seconds: 5 });
+    expect(holdProgress(holding)).toBe(0.25);
+    expect(holdProgress(base)).toBe(0);
+    expect(holdLine({ objectives: { ...holding, channel: "claim", channelType: "moon", channelHeld: 119 } }).text).toBe("Claiming the Moon rubbing from the cache: keep holding E, 1 s left");
+    expect(resultLine({ objectives: { ...base, channelResult: "collected:sun" } })).toEqual({ text: "Collected the Sun rubbing", state: "collected:sun" });
+    expect(resultLine({ objectives: { ...base, channelResult: "claimed:moon" } }).text).toBe("Claimed the Moon rubbing from the cache");
+    expect(resultLine({ objectives: { ...base, channelResult: "failed:source-empty" } }).text).toBe("Someone else took that rubbing first");
+  });
+});
+
+describe("the theft choice and the settlement (§4, §11)", () => {
+  it("offers the winner the eligible types on keys 1 and 2 with the seconds left, and nothing to anyone else", () => {
+    const choosing = { ...base, theftDuel: "d4", theftOptions: ["sun", "moon"], theftDeadline: 200 };
+    expect(theftChoice({ objectives: choosing, worldTick: 130 })).toEqual({
+      duel: "d4",
+      seconds: 4,
+      options: [
+        { key: "1", type: "sun", label: "1: Sun" },
+        { key: "2", type: "moon", label: "2: Moon" },
+      ],
+    });
+    expect(theftChoice({ objectives: base, worldTick: 130 })).toBeUndefined();
+    expect(theftChoice({ objectives: undefined, worldTick: 130 })).toBeUndefined();
+  });
+
+  it("tells the winner what they took, the loser what was taken, and both the gold", () => {
+    expect(settlementLine({ objectives: { ...base, settledRole: "winner", stolen: "moon", goldChange: 10 } }).text).toBe("Duel won: you took the Moon rubbing and 10 gold");
+    expect(settlementLine({ objectives: { ...base, settledRole: "loser", stolen: "moon", goldChange: -10 } }).text).toBe("Duel lost: they took your Moon rubbing and 10 gold");
+    expect(settlementLine({ objectives: { ...base, settledRole: "winner", goldChange: 10 } }).text).toBe("Duel won: +10 gold (they held nothing you lack)");
+    expect(settlementLine({ objectives: { ...base, settledRole: "loser", goldChange: -10 } }).text).toBe("Duel lost: -10 gold");
+    expect(settlementLine({ objectives: { ...base, settledRole: "winner", stolen: "sun", goldChange: 0 } }).text).toBe("Duel won: you took the Sun rubbing");
+    expect(settlementLine({ objectives: { ...base, settledRole: "draw" } })).toEqual({ text: "Duel drawn: nothing changed hands", state: "draw" });
+    expect(settlementLine({ objectives: base })).toEqual({ text: "", state: "none" });
+  });
+});
+
+describe("holding E (one gesture: dock, then collect)", () => {
+  it("keeps the interact bit in every read while E is held, and the sender repeats it inside the server's hold window", () => {
+    const page = new EventTarget();
+    const keyboard = new KeyboardHelm(page as unknown as Window);
+    page.dispatchEvent(Object.assign(new Event("keydown", { cancelable: true }), { code: "KeyE" }));
+    const sent: InputMessage[] = [];
+    const sender = new InputSender({ send: (type, message) => type === MessageType.Input && sent.push(message) });
+    for (let now = 0; now <= 1000; now += 1000 / 60) sender.update(keyboard.helm(), now);
+    expect(sent.every((message) => message.buttons === Buttons.Interact)).toBe(true);
+    // A fresh message at least every 250 ms (the server's hold window), so the hold never lapses.
+    const gaps = sent.slice(1).map((message, index) => message.seq - sent[index]!.seq);
+    expect(gaps.every((gap) => gap === 1)).toBe(true);
+    expect(sent.length).toBeGreaterThanOrEqual(1000 / ((INPUT_HOLD_FRAMES * 1000) / STEPS_PER_SECOND));
+  });
+});
+
+describe("the sea scene's duel markers and caches (§6, §12)", () => {
+  /** A pen that records what it draws. */
+  function recordingPen() {
+    const drawn: { kind: string; x: number; y: number; text?: string; half?: number; index?: number }[] = [];
+    const pen: MarkerPen = {
+      swords: (x, y, half) => drawn.push({ kind: "swords", x, y, half }),
+      label: (index, x, y, text) => drawn.push({ kind: "label", x, y, text, index }),
+      chest: (x, y, half) => drawn.push({ kind: "chest", x, y, half }),
+    };
+    return { pen, drawn };
+  }
+
+  it("draws each duel marker's crossed swords at its position, with its elapsed time just below", () => {
+    const { pen, drawn } = recordingPen();
+    const tile = map.subUnitsPerTile;
+    // A duel reserved at tick 100 on tile (55, 58); now is tick 100 + 20 × 75 (1:15 later).
+    const marker = { x: 55 * tile + tile / 2, y: 58 * tile + tile / 2, startTick: 100 };
+    const scroll = { x: 1000, y: 1100 };
+    const reported = drawDuelMarkers(pen, [marker], 100 + 20 * 75, scroll);
+    const x = 55.5 * TILE_PIXELS;
+    const y = 58.5 * TILE_PIXELS;
+    expect(drawn).toEqual([
+      { kind: "swords", x, y, half: SWORD_HALF },
+      { kind: "label", x, y: y + SWORD_HALF + 4, text: "1:15", index: 0 },
+    ]);
+    expect(reported).toEqual([{ x: x - scroll.x, y: y - scroll.y, elapsed: "1:15" }]);
+    // Each marker gets its own label, with its own time.
+    const second = recordingPen();
+    drawDuelMarkers(second.pen, [marker, { ...marker, startTick: 1400 }], 1500, { x: 0, y: 0 });
+    expect(second.drawn.filter((each) => each.kind === "label").map((each) => [each.index, each.text])).toEqual([
+      [0, "1:10"],
+      [1, "0:05"],
+    ]);
+  });
+
+  it("draws a chest on each cache's dock, and reports the dock, never contents", () => {
+    const { pen, drawn } = recordingPen();
+    const centre = tileCentre(defaultSimulationConfig, palmWest.tileX, palmWest.tileY);
+    const reported = drawCaches(pen, [{ ...centre, dock: palmWest.id }], { x: 0, y: 0 });
+    expect(drawn).toEqual([{ kind: "chest", x: (palmWest.tileX + 0.5) * TILE_PIXELS, y: (palmWest.tileY + 0.5) * TILE_PIXELS, half: expect.any(Number) }]);
+    expect(reported).toEqual([{ x: (palmWest.tileX + 0.5) * TILE_PIXELS, y: (palmWest.tileY + 0.5) * TILE_PIXELS, dock: palmWest.id }]);
+  });
+});
