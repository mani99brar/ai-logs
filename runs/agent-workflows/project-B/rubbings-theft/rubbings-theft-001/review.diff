+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { seaMap } from "@pirate-sea-race/content";
+import { RubbingMessageType } from "@pirate-sea-race/protocol";
+import { dockCentre, nearestDockBySea, startGameServer, type RunningGameServer } from "@pirate-sea-race/server";
+import { createEncounterConfig } from "@pirate-sea-race/simulation/encounters";
+import { cacheRubbings, objectiveRules } from "@pirate-sea-race/simulation/objectives";
+import { AHEAD, HeadlessClient, ImpairmentProxy, sleep } from "@pirate-sea-race/test-tools";
+import { GUEST_SEAT, holds, HOST_SEAT, lastDuel, ledgerOf, ledgerPlayer, pair, placePair, quickEncounters, tuned } from "./rubbingsSetup.js";
+import { brawler, collectAt, containsText, dockFor, EAST, grapple, HOLD_E, HUB_X, OPEN_ROW, playersAt, roomOf, tracker, until, WEST } from "./seaDuelSetup.js";
+
+/**
+ * Rubbings in the match room (§4, §11, §12, §16): collecting at an island's dock, stealing after a won duel at sea,
+ * disconnects and quits through the ledger, claiming from a recovery cache, and what each client may see. Every test's
+ * rooms check `checkLedger` and "no ship removed while the ledger counts its player" after every world tick
+ * (`tracker`). The ledger keeps the rules' own timings here (six-second holds, the five-second theft window, the 60 s
+ * seat); the encounter timings are shortened (`quickEncounters`). Expiries are in `rubbingsExpiry.test.ts`, Colyseus'
+ * outer bound in `rubbingsOuterBound.test.ts`: one matchmaker per process means one set of timings per file.
+ */
+let server: RunningGameServer;
+let endpoint: string;
+const encounters = createEncounterConfig({ rules: quickEncounters });
+
+beforeAll(async () => {
+  server = await startGameServer({ port: 0, host: "127.0.0.1", handleSignals: false, testPlacement: true, matchTuning: tuned({}) });
+  endpoint = `http://127.0.0.1:${server.port}`;
+});
+
+afterAll(async () => {
+  await server.close();
+});
+
+describe.concurrent("collecting at an island's dock (§4)", () => {
+  it("collects the island's rubbing after six seconds of holding E, never a second of a type, and shows the island's types only while moored", async ({ onTestFinished }) => {
