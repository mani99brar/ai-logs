import type { DuelEvent, DuelResult, DuelState } from "../duel/state.js";

/** A duel event with the frame it happened on and an id that is the same whenever that frame is simulated again. */
export interface DuelFeedEvent {
  readonly id: string;
  readonly frame: number;
  readonly event: DuelEvent | null;
  /** Set on the frame the duel ended (KO, double KO or the clock). */
  readonly result: DuelResult | null;
}

/**
 * The stable id of an event (§15: "replayed events use stable IDs"): the frame, the kind, the attacker and the move.
 * A frame never holds two events with all four equal, and a correction that re-simulates the frame produces the
 * same id, so a view that remembers ids shows each hit, block, throw or KO once.
 */
export function duelEventId(frame: number, event: DuelEvent): string {
  return `${frame}:${event.kind}:${event.attacker}:${event.moveId}`;
}

export function duelResultId(result: DuelResult): string {
  return `${result.frame}:result:${result.reason}`;
}

/**
 * Remembers the ids already handed out, so each event of a simulated frame is reported once however often rollback
 * re-simulates the frame. Ids older than the pruned frame are forgotten.
 */
export class DuelEventFeed {
  private readonly seen = new Map<string, number>();
  private readonly fresh: DuelFeedEvent[] = [];

  /** Records the events of a state just simulated (predicted, replayed or confirmed). */
  observe(state: DuelState): void {
    for (const event of state.events) this.add({ id: duelEventId(state.frame, event), frame: state.frame, event, result: null });
    if (state.result !== null && state.result.frame === state.frame) {
      this.add({ id: duelResultId(state.result), frame: state.frame, event: null, result: state.result });
    }
  }

  /** The events not handed out before, oldest first. */
  drain(): DuelFeedEvent[] {
    return this.fresh.splice(0);
  }

  /** Forgets ids from before `frame`. */
  prune(frame: number): void {
    for (const [id, at] of this.seen) if (at < frame) this.seen.delete(id);
  }

  private add(event: DuelFeedEvent): void {
    if (this.seen.has(event.id)) return;
    this.seen.set(event.id, event.frame);
    this.fresh.push(event);
  }
}
