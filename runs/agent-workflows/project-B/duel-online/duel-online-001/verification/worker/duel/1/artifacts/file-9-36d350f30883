<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pirate Sea Race</title>
    <link rel="stylesheet" href="/src/style.css" />
  </head>
  <body>
    <main>
      <section id="landing" aria-labelledby="title">
        <h1 id="title">Pirate Sea Race</h1>
        <p class="tagline">Private test match</p>
        <button id="create-match" type="button">Create match</button>
        <form id="join-form">
          <label for="join-code">Match code</label>
          <input id="join-code" name="code" maxlength="6" autocomplete="off" spellcheck="false" placeholder="K7Q2MX" required />
          <button id="join-match" type="submit">Join</button>
        </form>
        <p id="join-error" role="alert" data-testid="join-error"></p>
        <section class="duel-entry" aria-labelledby="duel-title">
          <h2 id="duel-title">Duel (combat spike)</h2>
          <div class="duel-buttons">
            <button id="create-duel" type="button">Create duel</button>
            <button id="practice-duel" type="button">Practice</button>
          </div>
          <form id="join-duel-form">
            <label for="duel-code">Duel code</label>
            <input id="duel-code" name="duel-code" maxlength="6" autocomplete="off" spellcheck="false" placeholder="K7Q2MX" required />
            <button id="join-duel" type="submit">Join duel</button>
          </form>
          <p id="duel-error" role="alert" data-testid="duel-error"></p>
        </section>
        <p class="version">Protocol v<span data-testid="landing-protocol"></span></p>
      </section>

      <section id="match" hidden>
        <div id="game" data-testid="game"></div>
        <aside id="hud" aria-label="Match status">
          <dl>
            <dt>Match code</dt>
            <dd data-testid="hud-code"></dd>
            <dt>Protocol</dt>
            <dd data-testid="hud-protocol"></dd>
            <dt>Players</dt>
            <dd data-testid="hud-players"></dd>
            <dt>Status</dt>
            <dd data-testid="hud-status"></dd>
            <dt>Mode</dt>
            <dd data-testid="hud-mode"></dd>
            <dt>You</dt>
            <dd data-testid="hud-self"></dd>
            <dt>Ship</dt>
            <dd data-testid="hud-dock"></dd>
            <dt>Harbour</dt>
            <dd data-testid="hud-dock-hint" aria-live="polite"></dd>
          </dl>
          <h2>Ships in sight</h2>
          <ul data-testid="positions"></ul>
          <p class="hint">Up or W: sail ahead. Down or S: brake, then reverse. Left and right (A, D): turn. E: dock when slow beside a dock (the Harbour line says when).</p>
        </aside>
      </section>

      <section id="duel" hidden>
        <div id="arena" data-testid="arena"></div>
        <aside id="duel-hud" aria-label="Duel status">
          <dl>
            <dt>Duel code</dt>
            <dd data-testid="duel-code"></dd>
            <dt>Status</dt>
            <dd data-testid="duel-status"></dd>
            <dt>Phase</dt>
            <dd data-testid="duel-phase"></dd>
            <dt>Round clock</dt>
            <dd data-testid="duel-clock"></dd>
          </dl>
          <div class="fighters">
            <div class="fighter p1">
              <span class="name" data-testid="duel-name-0"></span>
              <div class="bar health" data-testid="duel-health-0" role="img" aria-label="Player 1 health"></div>
              <span class="value" data-testid="duel-health-text-0"></span>
              <div class="bar stamina" data-testid="duel-stamina-0" role="img" aria-label="Player 1 stamina"></div>
            </div>
            <div class="fighter p2">
              <span class="name" data-testid="duel-name-1"></span>
              <div class="bar health" data-testid="duel-health-1" role="img" aria-label="Player 2 health"></div>
              <span class="value" data-testid="duel-health-text-1"></span>
              <div class="bar stamina" data-testid="duel-stamina-1" role="img" aria-label="Player 2 stamina"></div>
            </div>
          </div>
          <p class="connection" data-testid="duel-connection">
            Round trip <span data-testid="duel-rtt"></span> · input delay <span data-testid="duel-delay"></span> · corrections
            <span data-testid="duel-corrections"></span>
          </p>
          <div id="duel-result" data-testid="duel-result" hidden>
            <h2 data-testid="duel-result-text"></h2>
          </div>
          <label class="toggle"><input id="show-boxes" type="checkbox" data-testid="hitbox-toggle" /> Show hitboxes (developer)</label>
          <label id="dummy-control" class="toggle" hidden>
            Dummy
            <select id="dummy-select" data-testid="dummy-select">
              <option value="idle">idle</option>
              <option value="guard">guard</option>
            </select>
          </label>
          <p class="hint">
            Move: WASD or the arrow keys (hold back to guard, down-back for lows). J light, K heavy, U and I specials, Shift dash, J and K
            together to throw (or to escape a throw). Down + K sweeps low, forward + K launches, down + J is the anti-air.
          </p>
        </aside>
      </section>
    </main>
    <script type="module" src="/src/main.ts"></script>
  </body>
</html>
