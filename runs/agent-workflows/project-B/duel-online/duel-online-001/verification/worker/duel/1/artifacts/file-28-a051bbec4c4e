{
  "name": "@pirate-sea-race/simulation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The pure fixed-step match simulation shared by client and server (§15)",
  "exports": {
    ".": {
      "@pirate-sea-race/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./duel": {
      "@pirate-sea-race/source": "./src/duel/index.ts",
      "types": "./dist/duel/index.d.ts",
      "default": "./dist/duel/index.js"
    },
    "./netcode": {
      "@pirate-sea-race/source": "./src/netcode/index.ts",
      "types": "./dist/netcode/index.d.ts",
      "default": "./dist/netcode/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node --input-type=module -e \"for(const [s,main] of [['@pirate-sea-race/simulation/duel','stepDuel'],['@pirate-sea-race/simulation/netcode','DuelRollback']]){const sub=s.split('/').pop();const p=new URL(import.meta.resolve(s)).pathname;if(!p.endsWith('/dist/'+sub+'/index.js'))throw new Error(s+' resolves to '+p+', not to its dist/');const m=await import(s);if(Object.keys(m).length===0||!(main in m))throw new Error(s+' ('+p+') exports nothing or misses its main export');console.log(s+' loads from '+p)}\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@pirate-sea-race/content": "0.0.0"
  }
}
