import { describe, expect, it } from "vitest";
import { createDuelState, defaultDuelConfig as config, duelInput as I, hashState, replayDuel, stepDuel, type DuelState, type PlayerIndex } from "../duel/index.js";
import {
  BUNDLE_FRAMES,
  CATCH_UP_FRAMES,
  chooseInputDelay,
  DuelAuthority,
  DuelClientSession,
  DuelClock,
  DuelEventFeed,
  DuelRollback,
  duelEventId,
  FRAME_MS,
  HELD_INPUT_FRAMES,
  HISTORY_FRAMES,
  INPUTS_PER_MESSAGE,
  linkStats,
  MAX_INPUT_DELAY,
