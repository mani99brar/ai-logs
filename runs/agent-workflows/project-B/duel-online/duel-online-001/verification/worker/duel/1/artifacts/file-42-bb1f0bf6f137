import { readFile } from "node:fs/promises";
import {
  createDuelInputLog,
  createDuelState,
  defaultDuelConfig,
  replayDuel,
  type DuelConfig,
  type DuelInputLog,
  type DuelInputs,
  type DuelReplay,
} from "@pirate-sea-race/simulation/duel";

/**
 * Replays a recorded duel input log (§19 "Combat determinism") from the frame-0 state of the duel's seed, and returns
 * its final state and hash. `log` is the parsed JSON (or a path to it); `replayDuel` validates it and refuses a log
 * recorded on other move data.
 */
export async function replayRecordedDuel(log: unknown, options: { readonly seed: number; readonly config?: DuelConfig }): Promise<DuelReplay> {
  const parsed: unknown = typeof log === "string" ? JSON.parse(await readFile(log, "utf8")) : log;
  const config = options.config ?? defaultDuelConfig;
  return replayDuel(config, createDuelState(config, { seed: options.seed }), parsed);
}

/**
 * The input log a client can rebuild from the frame bundles it received: the pairs the server applied, from frame 1
 * up to the last frame received without a gap. Replaying it must reproduce the server's state.
 */
export function logFromBundles(bundles: readonly { readonly frame: number; readonly inputs: readonly (readonly [number, number])[] }[], config: DuelConfig = defaultDuelConfig): DuelInputLog {
  const pairs: DuelInputs[] = [];
  for (const bundle of bundles) {
    const first = bundle.frame - bundle.inputs.length + 1;
    bundle.inputs.forEach((pair, index) => {
      const frame = first + index;
      if (frame === pairs.length + 1) pairs.push([pair[0], pair[1]]);
    });
  }
  return createDuelInputLog(config, 0, pairs);
}
