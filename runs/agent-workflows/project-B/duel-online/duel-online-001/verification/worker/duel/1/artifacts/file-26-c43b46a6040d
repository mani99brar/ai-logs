import { describe, expect, it } from "vitest";
import {
  CREATE_TOKEN_BYTES,
  createMatchOptionsSchema,
  createTokenSchema,
  encodedSize,
  formatCreateToken,
  MALFORMED_MATCH_REQUEST_MESSAGE,
  MATCH_CODE_REQUIRED_MESSAGE,
  MATCH_UNAVAILABLE_MESSAGE,
  matchFullMessage,
  NO_SUCH_MATCH_MESSAGE,
  protocolMismatchMessage,
  MAX_INPUT_LEAD_FRAMES,
  MAX_INPUT_MESSAGE_BYTES,
  PROTOCOL_VERSION,
  joinMatchOptionsSchema,
  normalizeMatchCode,
  PLACEMENT_HEADING_COUNT,
  testPlacementSchema,
  validateInputMessage,
  Buttons,
  type InputContext,
} from "./index.js";

const context: InputContext = { lastAcceptedSeq: 4, serverFrame: 300 };
const valid = { seq: 5, frame: 301, buttons: 0, moveX: 1, moveY: -0.5 };

describe("input validation", () => {
  it("accepts a valid input", () => {
    expect(validateInputMessage(valid, context)).toEqual({ ok: true, input: valid });
  });

  it.each([
    ["undefined", undefined],
    ["a string", "left"],
    ["an array", [5, 301, 0, 1, 0]],
    ["a missing field", { seq: 5, frame: 301, buttons: 0, moveX: 1 }],
    ["an extra field", { ...valid, x: 100 }],
    ["a fractional sequence", { ...valid, seq: 5.5 }],
    ["a negative frame", { ...valid, frame: -1 }],
    ["a string axis", { ...valid, moveX: "1" }],
    ["a NaN axis", { ...valid, moveX: Number.NaN }],
    ["buttons out of range", { ...valid, buttons: 0x10000 }],
    ["a BigInt field", { ...valid, seq: 5n }],
  ])("rejects a malformed input: %s", (_label, message) => {
    expect(validateInputMessage(message, context)).toEqual({ ok: false, reason: "malformed" });
  });

  it("rejects an oversized input before parsing it", () => {
    const padded = { ...valid, padding: "x".repeat(MAX_INPUT_MESSAGE_BYTES) };
    expect(validateInputMessage(padded, context)).toEqual({ ok: false, reason: "oversized" });
    expect(validateInputMessage({ ...valid, note: "é".repeat(70) }, context)).toEqual({ ok: false, reason: "oversized" });
  });

  it("rejects a future-frame input", () => {
    const limit = context.serverFrame + MAX_INPUT_LEAD_FRAMES;
    expect(validateInputMessage({ ...valid, frame: limit }, context).ok).toBe(true);
    expect(validateInputMessage({ ...valid, frame: limit + 1 }, context)).toEqual({ ok: false, reason: "future-frame" });
  });

  it("rejects a repeated or older sequence number", () => {
    expect(validateInputMessage({ ...valid, seq: 4 }, context)).toEqual({ ok: false, reason: "stale-sequence" });
    expect(validateInputMessage({ ...valid, seq: 1 }, context)).toEqual({ ok: false, reason: "stale-sequence" });
  });

  it("rejects movement axes outside [-1, 1] rather than clamping them", () => {
    for (const axis of [1.0001, -1.5, 2, Number.POSITIVE_INFINITY]) {
      expect(validateInputMessage({ ...valid, moveX: axis }, context)).toEqual({ ok: false, reason: "malformed" });
      expect(validateInputMessage({ ...valid, moveY: axis }, context)).toEqual({ ok: false, reason: "malformed" });
    }
    expect(validateInputMessage({ ...valid, moveX: -1, moveY: 1 }, context).ok).toBe(true);
  });
});

describe("join options", () => {
  it("normalises typed codes to the canonical form", () => {
    expect(normalizeMatchCode("  k7q2mx ")).toBe("K7Q2MX");
  });

  it("accepts a canonical code and refuses anything else", () => {
    expect(joinMatchOptionsSchema.safeParse({ protocolVersion: PROTOCOL_VERSION, code: "K7Q2MX" }).success).toBe(true);
    for (const code of ["k7q2mx", "K7Q2M", "K7Q2MXX", "K7-2MX", ""]) {
      expect(joinMatchOptionsSchema.safeParse({ protocolVersion: PROTOCOL_VERSION, code }).success).toBe(false);
    }
  });
});

describe("create tokens", () => {
  it("formats 128 random bits as 32 lowercase hex digits", () => {
    expect(CREATE_TOKEN_BYTES * 8).toBeGreaterThanOrEqual(128);
    const token = formatCreateToken(Uint8Array.from({ length: CREATE_TOKEN_BYTES }, (_, index) => index * 17));
    expect(token).toBe("00112233445566778899aabbccddeeff");
    expect(createTokenSchema.safeParse(token).success).toBe(true);
  });

  it("refuses anything but a well-formed token in a create request", () => {
    const token = "0123456789abcdef0123456789abcdef";
    expect(createMatchOptionsSchema.safeParse({ protocolVersion: PROTOCOL_VERSION, createToken: token }).success).toBe(true);
    for (const createToken of [undefined, "", token.toUpperCase(), token.slice(1), `${token}0`, 42]) {
      expect(createMatchOptionsSchema.safeParse({ protocolVersion: PROTOCOL_VERSION, createToken }).success).toBe(false);
    }
  });
});

describe("refusal messages", () => {
  it("stay under 100 bytes, whatever version the client claims", () => {
    const messages = [
      MALFORMED_MATCH_REQUEST_MESSAGE,
      NO_SUCH_MATCH_MESSAGE,
      MATCH_CODE_REQUIRED_MESSAGE,
      MATCH_UNAVAILABLE_MESSAGE,
      matchFullMessage(8),
      ...[PROTOCOL_VERSION - 1, Number.MAX_SAFE_INTEGER, -Number.MAX_SAFE_INTEGER, "x".repeat(500), undefined, 1.5].map(
        protocolMismatchMessage,
      ),
    ];
    for (const message of messages) expect(encodedSize(message)! - 2).toBeLessThan(100);
  });

  it("names both protocol versions", () => {
    expect(protocolMismatchMessage(1)).toBe(
      `Protocol version mismatch: client v1, server v${PROTOCOL_VERSION}. Reload the page to update.`,
    );
    expect(protocolMismatchMessage("1; drop")).toContain("client v?,");
  });
});

describe("protocol v4 (sailing, and the duel messages)", () => {
  it("is version 4: v3's axes still steer a ship and interact docks it, and the duel messages are new", () => {
    expect(PROTOCOL_VERSION).toBe(4);
    expect(validateInputMessage({ ...valid, moveX: 0, moveY: 0, buttons: Buttons.Interact }, context).ok).toBe(true);
  });
});

describe("test placement requests", () => {
  const placement = { code: "K7Q2MX", sessionId: "abc123", tileX: 100, tileY: 76, heading: 0 };

  it("accepts a placement on a tile with a heading", () => {
    expect(testPlacementSchema.safeParse(placement).success).toBe(true);
    expect(testPlacementSchema.safeParse({ ...placement, heading: PLACEMENT_HEADING_COUNT - 1 }).success).toBe(true);
  });

  it.each([
    ["a fractional tile", { ...placement, tileX: 1.5 }],
    ["a negative tile", { ...placement, tileY: -1 }],
    ["a heading beyond the circle", { ...placement, heading: PLACEMENT_HEADING_COUNT }],
    ["a negative heading", { ...placement, heading: -1 }],
    ["a malformed code", { ...placement, code: "nope" }],
    ["an extra field", { ...placement, speed: 64 }],
  ])("refuses %s", (_label, candidate) => {
    expect(testPlacementSchema.safeParse(candidate).success).toBe(false);
  });
});
