import { matchMaker } from "colyseus";
import { afterAll, beforeAll, describe, expect, it } from "vitest";
import { DuelRoom, startGameServer, type RunningGameServer } from "@pirate-sea-race/server";
import { duelInput as I } from "@pirate-sea-race/simulation/duel";
import { HeadlessDuelClient, ImpairmentProxy, logFromBundles, replayRecordedDuel, type DuelScript, type Impairment } from "@pirate-sea-race/test-tools";

/**
 * The impairment harness (§19 "Network and performance targets"): two headless duel clients, running the same
 * rollback core as the browser, fight a scripted duel through a proxy that delays, jitters and loses messages the
 * way a WebSocket over TCP suffers them. Each scenario must show:
 *
 * - zero desyncs: at every bundle's frame (a snapshot or a hash every 50 ms) each client hashes its own simulated
 *   state, before restoring anything, and compares it with the server's;
 * - zero input messages dropped by the server's rate cap;
 * - corrections within the threshold: at most one per change of the opponent's input the server applied, plus one
 *   per own input the server had to substitute, and never more than CORRECTIONS_PER_SECOND on average.
 *
 * The counts are printed and attached to the test as annotations.
 */
const CORRECTIONS_PER_SECOND = 8;
/** Frames of scripted play (eight seconds); both clients must then confirm SETTLE_FRAMES more. */
const PLAY_FRAMES = 480;
const SETTLE_FRAMES = 60;

const R = I("right");
const L = I("left");
const D = I("down");
const U = I("up");
const J = I("light");
const K = I("heavy");

/**
 * Player one walks in, then cycles through a tapped jab, a held heavy, a throw pressed with rollover (K a frame after
 * J), backing off, a low sweep, and a jab timed to trade with player two's.
 */
const attacker: DuelScript = (frame) => {
  if (frame < 40) return R;
  const beat = (frame - 40) % 180;
  if (beat === 10) return J;
  if (beat >= 30 && beat < 34) return K;
  if (beat === 60) return J;
  if (beat > 60 && beat < 65) return J | K;
  if (beat >= 100 && beat < 120) return L;
  if (beat >= 120 && beat < 126) return R;
  if (beat >= 126 && beat < 128) return D | K;
  if (beat >= 150 && beat < 153) return J;
  if (beat >= 153) return R;
  return 0;
};

/** Player two guards standing and crouching, punishes with a jab, throws, jumps, and jabs into player one's jab. */
const defender: DuelScript = (frame) => {
  if (frame < 40) return 0;
  const beat = (frame - 40) % 180;
  if (beat < 30) return R;
  if (beat === 41) return J;
  if (beat >= 60 && beat < 63) return R;
  if (beat === 80) return J;
  if (beat > 80 && beat < 85) return J | K;
  if (beat === 90) return U;
  if (beat >= 100 && beat < 130) return D | R;
  if (beat === 130 || beat === 150) return J;
  return 0;
};

interface ScenarioReport {
  readonly scenario: string;
  readonly inputDelay: number;
  readonly corrections: [number, number];
  readonly correctionBound: [number, number];
  readonly substituted: [number, number];
  readonly hashChecks: [number, number];
  readonly desyncs: [number, number];
  readonly deepestReplay: [number, number];
  readonly rateLimited: [number, number];
  readonly lostMessages: number;
}

let server: RunningGameServer;

beforeAll(async () => {
  server = await startGameServer({ port: 0, host: "127.0.0.1", handleSignals: false });
});

afterAll(async () => {
  await server.close();
});

/** How often the input a player's opponent actually had applied changed, from the frames the server confirmed. */
function opponentChanges(client: HeadlessDuelClient, through: number): number {
  const log = logFromBundles(client.bundles).inputs.slice(0, through);
  const opponent = client.slot === 0 ? 1 : 0;
  return log.filter((pair, index) => index > 0 && pair[opponent] !== log[index - 1]![opponent]).length;
}

async function runScenario(scenario: string, impairment: Impairment, seed: number): Promise<ScenarioReport> {
  const proxies = await Promise.all([ImpairmentProxy.start(server.port, impairment, seed), ImpairmentProxy.start(server.port, impairment, seed + 1)]);
  const host = await HeadlessDuelClient.create(proxies[0].endpoint);
  const guest = await HeadlessDuelClient.join(proxies[1].endpoint, host.code);
  const players = [host, guest] as const;
  try {
    host.play((frame) => (frame <= PLAY_FRAMES ? attacker(frame, host.duel!) : 0));
    guest.play((frame) => (frame <= PLAY_FRAMES ? defender(frame, guest.duel!) : 0));
    await host.waitFor(() => host.phase === "fighting", 8000);
    for (const player of players) await player.waitForConfirmed(PLAY_FRAMES + SETTLE_FRAMES, 30_000);
    const room = matchMaker.getLocalRoomById(host.room.roomId) as unknown as DuelRoom;
    const diagnostics = room.diagnostics();

    // Determinism on top of the live hash checks: the pairs each client received replay to the server's state.
    for (const player of players) {
      const log = logFromBundles(player.bundles);
      const serverLog = room.inputLog();
      const replayed = await replayRecordedDuel(log, { seed: room.state.seed });
      const fromServer = await replayRecordedDuel({ ...serverLog, inputs: serverLog.inputs.slice(0, log.inputs.length) }, { seed: room.state.seed });
      expect(log.inputs.length).toBeGreaterThanOrEqual(PLAY_FRAMES + SETTLE_FRAMES);
      expect(replayed.hash).toBe(fromServer.hash);
    }
    const through = PLAY_FRAMES + SETTLE_FRAMES;
    const pair = <T>(pick: (player: HeadlessDuelClient, index: 0 | 1) => T): [T, T] => [pick(host, 0), pick(guest, 1)];
    return {
      scenario,
      inputDelay: diagnostics.inputDelay,
      corrections: pair((player) => player.stats!.corrections),
      correctionBound: pair((player, index) => opponentChanges(player, through) + player.stats!.substitutedFrames[index]),
      substituted: [diagnostics.authority.repeated[0] + diagnostics.authority.neutral[0], diagnostics.authority.repeated[1] + diagnostics.authority.neutral[1]],
      hashChecks: pair((player) => player.stats!.hashChecks),
      desyncs: pair((player) => player.stats!.desyncs),
      deepestReplay: pair((player) => player.stats!.deepestReplay),
      rateLimited: [diagnostics.dropped["0"]!["rate-limited"], diagnostics.dropped["1"]!["rate-limited"]],
      lostMessages: proxies[0].stats.lost[0] + proxies[0].stats.lost[1] + proxies[1].stats.lost[0] + proxies[1].stats.lost[1],
    };
  } finally {
    await Promise.all(players.map((player) => player.leave()));
    await Promise.all(proxies.map((proxy) => proxy.close()));
  }
}

function expectWithinBudget(report: ScenarioReport): void {
  expect(report.desyncs).toEqual([0, 0]);
  expect(report.rateLimited).toEqual([0, 0]);
  const settled = PLAY_FRAMES + SETTLE_FRAMES;
  for (const index of [0, 1] as const) {
    // A bundle every 3 frames, each checked once its frame is confirmed.
    expect(report.hashChecks[index]).toBeGreaterThanOrEqual(Math.floor(settled / 3) - 5);
    expect(report.corrections[index]).toBeLessThanOrEqual(report.correctionBound[index]);
    expect(report.corrections[index]).toBeLessThanOrEqual((CORRECTIONS_PER_SECOND * settled) / 60);
  }
}

describe("duel netcode through the impairment harness", () => {
  const scenarios: readonly [string, Impairment, number][] = [
    ["no impairment", { rttMs: 0, jitterMs: 0, loss: 0 }, 11],
    ["80 ms round trip, 20 ms jitter, 1% loss", { rttMs: 80, jitterMs: 20, loss: 0.01 }, 21],
  ];
  for (const [scenario, impairment, seed] of scenarios) it(`keeps both clients on the server's state with ${scenario}`, async ({ annotate }) => {
    const report = await runScenario(scenario, impairment, seed);
    console.log(`duel harness: ${JSON.stringify(report)}`);
    await annotate(
      `${scenario}: input delay ${report.inputDelay}; corrections ${report.corrections.join("/")} (bound ${report.correctionBound.join("/")}); ` +
        `server substitutions ${report.substituted.join("/")}; hash checks ${report.hashChecks.join("/")}, desyncs ${report.desyncs.join("/")}; ` +
        `deepest replay ${report.deepestReplay.join("/")} frames; rate-limited drops ${report.rateLimited.join("/")}; lost messages ${report.lostMessages}`,
    );
    expectWithinBudget(report);
    if (impairment.loss > 0) expect(report.lostMessages).toBeGreaterThan(0);
  }, 60_000);
});
