import type { Room } from "@colyseus/sdk";

/**
 * Development only (`npm run dev`; main.ts imports this module only when `import.meta.env.DEV`, so the production
 * build does not contain it): delays everything a room's socket sends and receives, the server's round-trip probes
 * and Colyseus's own pings included, by half of `rttMs` each way plus a uniform ±jitter/2, never reordering. It lets
 * the operator playtest §19's latencies on one machine: `?rtt=80&jitter=20`.
 */
export const DEV_LATENCY_MARKER = "pirate-sea-race dev latency";

export interface DevLatency {
  readonly rttMs: number;
  readonly jitterMs: number;
}

/** The setting from the page's query string, or undefined when it asks for none. */
export function devLatencyFromQuery(search: string): DevLatency | undefined {
  const query = new URLSearchParams(search);
  const rttMs = Number(query.get("rtt") ?? 0);
  const jitterMs = Number(query.get("jitter") ?? 0);
  if (!(rttMs > 0 || jitterMs > 0) || !Number.isFinite(rttMs) || !Number.isFinite(jitterMs)) return undefined;
  return { rttMs: Math.max(0, rttMs), jitterMs: Math.max(0, jitterMs) };
}

/** An ordered delay line: each item leaves at the later of its own time and the previous item's. */
class DelayLine {
  private last = 0;

  constructor(private readonly latency: DevLatency) {}

  push(deliver: () => void): void {
    const delay = Math.max(0, this.latency.rttMs / 2 + (Math.random() - 0.5) * this.latency.jitterMs);
    const at = Math.max(this.last, performance.now() + delay);
    this.last = at;
    setTimeout(deliver, at - performance.now());
  }
}

/** Wraps a joined room's connection in both directions. It survives the SDK's reconnection, which reuses both hooks. */
export function applyDevLatency(room: Room, latency: DevLatency): void {
  console.info(`${DEV_LATENCY_MARKER}: ${latency.rttMs} ms round trip, ${latency.jitterMs} ms jitter`);
  const connection = room.connection as unknown as {
    transport: { send(data: Uint8Array): void };
    events: { onmessage?: (event: unknown) => void };
  };
  const outgoing = new DelayLine(latency);
  const send = connection.transport.send.bind(connection.transport);
  connection.transport.send = (data: Uint8Array) => {
    const copy = new Uint8Array(data);
    outgoing.push(() => {
      try {
        send(copy);
      } catch {
        // The socket closed meanwhile; a real network would have lost it too.
      }
    });
  };
  const incoming = new DelayLine(latency);
  const receive = connection.events.onmessage;
  connection.events.onmessage = (event: unknown) => incoming.push(() => receive?.call(connection.events, event));
}
