import { fileURLToPath } from "node:url";
import { defineConfig, devices } from "@playwright/test";

const root = fileURLToPath(new URL("../..", import.meta.url));
const SERVER_PORT = 2593;
const WEB_PORT = 5393;

/**
 * Browser scenarios against the real server and web client on their fixed ports. Both start from source: the server
 * through tsx (its dev and test entry, with test placement on), the client as a fresh Vite production build served by
 * `vite preview`, so no prior build is needed.
 */
export default defineConfig({
  testDir: ".",
  testMatch: "**/*.spec.ts",
  timeout: 60_000,
  expect: { timeout: 10_000 },
  fullyParallel: false,
  workers: 1,
  retries: 0,
  forbidOnly: !!process.env["CI"],
  reporter: "list",
  use: {
    baseURL: `http://localhost:${WEB_PORT}`,
    trace: "retain-on-failure",
  },
  projects: [{ name: "chromium", use: { ...devices["Desktop Chrome"] } }],
  webServer: [
    {
      command: "npm run start:source -w @pirate-sea-race/server",
      cwd: root,
      // The dev and test entry reads the test-only settings: the scenarios put ships where they need them, every match
      // deals its rubbings in a fixed layout (Suns on Palm Key and Old Stones, Moons on Ember Rock and Mist Cay), its
      // final island is the one the pinned secret picks (`FINAL_SECRET` in helpers.ts), and it runs short: a 3 s ready
      // countdown, 1 s of departure protection and a 10-minute match. Every island is open from the start (test-only
      // ruins), so the scenarios about the loop (`theft-loop`, `full-match`) collect without solving ruins; `ruin-solve`
      // gives its match locked ruins of a pinned kind through the next-match route (`nextMatchRuins` in helpers.ts).
      env: {
        PORT: String(SERVER_PORT),
        PIRATE_SEA_RACE_TEST_PLACEMENT: "1",
        PIRATE_SEA_RACE_TEST_SOURCES: "sun,sun|moon,moon|sun,sun|moon,moon",
        PIRATE_SEA_RACE_TEST_TIMINGS: "ready=60,protection=20,match=12000",
        PIRATE_SEA_RACE_TEST_FINAL_SECRET: "3",
        PIRATE_SEA_RACE_TEST_RUINS: "*=open",
      },
      url: `http://localhost:${SERVER_PORT}/__healthcheck`,
      reuseExistingServer: false,
      timeout: 60_000,
    },
    {
      command: "npm run build -w @pirate-sea-race/web && npm run preview -w @pirate-sea-race/web",
      cwd: root,
      url: `http://localhost:${WEB_PORT}`,
      reuseExistingServer: false,
      timeout: 120_000,
    },
  ],
});
