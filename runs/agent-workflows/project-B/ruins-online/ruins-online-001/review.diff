+import { describe, expect, it } from "vitest";
+import type { MatchResults } from "@pirate-sea-race/simulation/match";
+import { MAX_RECORDED_OUTCOMES, recordedOutcomes, recordOutcome } from "./outcomes.js";
+
+const results = (tick: number): MatchResults => ({ tick, reason: "deadline", winner: null, custom: true, elapsedTicks: tick, players: [] });
+
+describe("the recorded outcomes", () => {
+  it("keep only the latest MAX_RECORDED_OUTCOMES, oldest first, however many matches end", () => {
+    const before = recordedOutcomes().length;
+    const total = MAX_RECORDED_OUTCOMES * 3 + 7;
+    for (let index = 0; index < total; index++) recordOutcome({ code: `M${index}`, results: results(index) });
+    expect(before).toBe(0);
+    expect(recordedOutcomes()).toHaveLength(MAX_RECORDED_OUTCOMES);
+    expect(recordedOutcomes()[0]!.code).toBe(`M${total - MAX_RECORDED_OUTCOMES}`);
+    expect(recordedOutcomes().at(-1)!.code).toBe(`M${total - 1}`);
+  });
+});
