+++ b/packages/test-tools/src/ruinReader.ts
@@ -0,0 +1,116 @@
+/**
+ * A reader of ruin clues (§3), for tests: it works an answer out from what the site shows, as a player would, and
+ * never from the server's puzzle. A sequence clue is read tablet by tablet (each hint rules sequences out); a grid is
+ * walked breadth-first from the start to the goal round the blocked cells. No import beyond the protocol's names, so
+ * browser tests can use it on a clue they read off the page.
+ */
+
+export type Symbol = "sun" | "moon" | "tide" | "storm" | "anchor" | "skull";
+export type Move = "N" | "E" | "S" | "W";
+
+export interface ReadHint {
+  readonly relation: string;
+  readonly other: string | null;
+  readonly position: number | null;
+}
+
+export interface ReadTablet {
+  readonly symbol: string;
+  readonly hint: ReadHint;
+}
+
+export interface ReadCell {
+  readonly x: number;
+  readonly y: number;
+}
+
+export type ReadClue =
+  | { readonly kind: "sequence"; readonly length: number; readonly tablets: readonly ReadTablet[] }
+  | { readonly kind: "navigation"; readonly size: number; readonly start: ReadCell; readonly goal: ReadCell; readonly blocked: readonly ReadCell[] };
+
+function holds(tablet: ReadTablet, order: readonly string[]): boolean {
+  const index = order.indexOf(tablet.symbol);
+  const other = tablet.hint.other === null ? -1 : order.indexOf(tablet.hint.other);
+  const both = index >= 0 && other >= 0;
+  switch (tablet.hint.relation) {
+    case "absent":
+      return index < 0;
+    case "present":
+      return index >= 0;
+    case "at":
+      return index >= 0 && index === tablet.hint.position;
+    case "not-at":
+      return index !== tablet.hint.position;
+    case "right-after":
+      return both && index === other + 1;
+    case "right-before":
+      return both && index + 1 === other;
+    case "after":
+      return both && index > other;
+    case "before":
+      return both && index < other;
+    default:
+      throw new Error(`unknown hint ${tablet.hint.relation}`);
+  }
+}
+
+function orders(symbols: readonly string[], length: number): string[][] {
+  if (length === 0) return [[]];
+  return symbols.flatMap((symbol) => orders(symbols.filter((other) => other !== symbol), length - 1).map((rest) => [symbol, ...rest]));
+}
+
+/** Every sequence the tablets admit (a well-made ruin admits exactly one). */
+export function readSequence(length: number, tablets: readonly ReadTablet[]): Symbol[][] {
+  const symbols = tablets.map((tablet) => tablet.symbol);
+  return orders(symbols, length).filter((order) => tablets.every((tablet) => holds(tablet, order))) as Symbol[][];
+}
+
+const STEPS: Readonly<Record<Move, ReadCell>> = { N: { x: 0, y: -1 }, E: { x: 1, y: 0 }, S: { x: 0, y: 1 }, W: { x: -1, y: 0 } };
+
+/** A shortest walk from the start to the goal round the blocked cells, as compass moves; undefined when there is none. */
+export function readGrid(size: number, start: ReadCell, goal: ReadCell, blocked: readonly ReadCell[]): Move[] | undefined {
+  const key = (cell: ReadCell) => cell.y * size + cell.x;
+  const closed = new Set(blocked.map(key));
+  const came = new Map<number, { from: number; move: Move }>([[key(start), { from: -1, move: "N" }]]);
+  const queue: ReadCell[] = [start];
+  for (let head = 0; head < queue.length; head++) {
+    const cell = queue[head]!;
+    if (cell.x === goal.x && cell.y === goal.y) {
+      const moves: Move[] = [];
+      for (let at = key(cell); at !== key(start); at = came.get(at)!.from) moves.unshift(came.get(at)!.move);
+      return moves;
+    }
+    for (const move of Object.keys(STEPS) as Move[]) {
+      const next = { x: cell.x + STEPS[move].x, y: cell.y + STEPS[move].y };
+      if (next.x < 0 || next.y < 0 || next.x >= size || next.y >= size || closed.has(key(next)) || came.has(key(next))) continue;
+      came.set(key(next), { from: key(cell), move });
+      queue.push(next);
+    }
+  }
+  return undefined;
+}
+
+/** The answer a reader gives to a clue: the one sequence its tablets admit, or a shortest walk across the grid. */
+export function readClue(clue: ReadClue): { kind: "sequence"; symbols: Symbol[] } | { kind: "navigation"; moves: Move[] } {
+  if (clue.kind === "sequence") {
+    const [only, ...rest] = readSequence(clue.length, clue.tablets);
+    if (only === undefined || rest.length > 0) throw new Error(`the tablets admit ${rest.length + (only ? 1 : 0)} sequences`);
+    return { kind: "sequence", symbols: only };
+  }
+  const moves = readGrid(clue.size, clue.start, clue.goal, clue.blocked);
+  if (moves === undefined) throw new Error("the grid has no walk to the goal");
+  return { kind: "navigation", moves };
+}
+
+/** A well-formed answer the clue rules out, for tests of a wrong answer. */
+export function wrongAnswer(clue: ReadClue): { kind: "sequence"; symbols: Symbol[] } | { kind: "navigation"; moves: Move[] } {
+  if (clue.kind === "sequence") {
+    const right = readSequence(clue.length, clue.tablets)[0]!;
+    return { kind: "sequence", symbols: [right[1]!, right[0]!, ...right.slice(2)] };
+  }
+  // The walk of the right length that steps off the grid first: never a solution.
+  const length = readGrid(clue.size, clue.start, clue.goal, clue.blocked)!.length;
+  const off: Move = clue.start.y === 0 ? "N" : clue.start.x === 0 ? "W" : clue.start.y === clue.size - 1 ? "S" : "E";
+  const toEdge = off === "N" ? clue.start.y : off === "W" ? clue.start.x : off === "S" ? clue.size - 1 - clue.start.y : clue.size - 1 - clue.start.x;
+  return { kind: "navigation", moves: Array.from({ length: Math.max(length, toEdge + 1) }, () => off) };
+}
