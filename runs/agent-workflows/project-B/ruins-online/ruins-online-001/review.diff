+describe("protocol v8 (the ruins)", () => {
+  const sequence = { requestId: "r1", attempt: { kind: "sequence", symbols: ["tide", "sun", "skull"] } };
+  const navigation = { requestId: "r-2_x", attempt: { kind: "navigation", moves: ["N", "E", "E", "S"] } };
+
+  it("is version 8, with an empty open request and an answer carrying a request id and an attempt", () => {
+    expect(PROTOCOL_VERSION).toBe(8);
+    expect(RuinMessageType).toEqual({ Open: "open-ruin", Answer: "answer-ruin", Clue: "ruin-clue", Result: "ruin-result" });
+    expect(validateOpenRuinMessage({})).toEqual({});
+    for (const candidate of [{ island: 0 }, null, "open", { pad: "x".repeat(20) }]) expect(validateOpenRuinMessage(candidate)).toBeUndefined();
+    expect(validateAnswerRuinMessage(sequence)).toEqual(sequence);
+    expect(validateAnswerRuinMessage(navigation)).toEqual(navigation);
+    const longest = { requestId: "x".repeat(32), attempt: { kind: "navigation", moves: Array.from({ length: MAX_RUIN_MOVES }, () => "N") } };
+    expect(validateAnswerRuinMessage(longest)).toEqual(longest);
+    expect(JSON.stringify(longest).length).toBeLessThan(MAX_ANSWER_RUIN_BYTES);
+  });
+
+  it.each([
+    ["an unknown symbol", { ...sequence, attempt: { kind: "sequence", symbols: ["gold"] } }],
+    ["no symbols", { ...sequence, attempt: { kind: "sequence", symbols: [] } }],
+    ["an unknown move", { ...navigation, attempt: { kind: "navigation", moves: ["NE"] } }],
+    ["too many moves", { ...navigation, attempt: { kind: "navigation", moves: Array.from({ length: MAX_RUIN_MOVES + 1 }, () => "N") } }],
+    ["moves under the sequence kind", { ...sequence, attempt: { kind: "sequence", moves: ["N"] } }],
+    ["an unknown kind", { ...sequence, attempt: { kind: "riddle", symbols: ["sun"] } }],
+    ["no request id", { attempt: sequence.attempt }],
+    ["a request id with spaces", { ...sequence, requestId: "a b" }],
+    ["a long request id", { ...sequence, requestId: "x".repeat(33) }],
+    ["an extra field", { ...sequence, island: 0 }],
+    ["an extra attempt field", { ...sequence, attempt: { ...sequence.attempt, answer: true } }],
+    ["an oversized message", { ...sequence, attempt: { ...sequence.attempt, symbols: Array.from({ length: 40 }, () => "sun") } }],
+    ["a string", "tide,sun,skull"],
+  ])("refuses an answer with %s", (_label, candidate) => {
+    expect(validateAnswerRuinMessage(candidate)).toBeUndefined();
+  });
+
+  it("parses the clue and the verdict the server sends, and refuses anything more", () => {
+    const clue = {
+      island: 1,
+      clue: { kind: "sequence", length: 3, tablets: [{ symbol: "sun", hint: { relation: "right-after", other: "moon", position: null } }] },
+      lockedUntil: 0,
+      solved: false,
+    };
+    expect(parseRuinClueMessage(clue)).toEqual(clue);
+    const grid = { island: 2, clue: { kind: "navigation", size: 4, start: { x: 0, y: 0 }, goal: { x: 3, y: 3 }, blocked: [{ x: 1, y: 1 }] }, lockedUntil: 90, solved: true };
+    expect(parseRuinClueMessage(grid)).toEqual(grid);
+    // A clue never carries an answer or a path length.
+    expect(parseRuinClueMessage({ ...clue, clue: { ...clue.clue, answer: ["sun", "moon", "tide"] } })).toBeUndefined();
+    expect(parseRuinClueMessage({ ...grid, clue: { ...grid.clue, minMoves: 6 } })).toBeUndefined();
+    const result = { requestId: "r1", island: 1, outcome: "solved", reason: null, lockedUntil: 0, gold: 40, unlocked: true };
