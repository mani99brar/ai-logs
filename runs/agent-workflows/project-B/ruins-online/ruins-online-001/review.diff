+import type { MatchResults } from "@pirate-sea-race/simulation/match";
+
+/** A finished match as the process recorded it (§16's result: the match, its end reason, winner and summaries). */
+export interface MatchOutcome {
+  readonly code: string;
+  readonly results: MatchResults;
+}
+
+/**
+ * The outcomes a process keeps, newest last: the first release stores final outcomes only (§12) and has no store yet,
+ * so the process keeps just the latest ones for tests and diagnostics, and a long-running server does not grow.
+ */
+export const MAX_RECORDED_OUTCOMES = 64;
+
+const outcomes: MatchOutcome[] = [];
+
+/** Records a finished match, dropping the oldest once `MAX_RECORDED_OUTCOMES` are kept. */
+export function recordOutcome(outcome: MatchOutcome): void {
+  outcomes.push(outcome);
+  if (outcomes.length > MAX_RECORDED_OUTCOMES) outcomes.splice(0, outcomes.length - MAX_RECORDED_OUTCOMES);
+}
+
+/** The outcomes this process recorded most recently, oldest first, for tests and diagnostics. */
+export function recordedOutcomes(): readonly MatchOutcome[] {
+  return outcomes;
+}
