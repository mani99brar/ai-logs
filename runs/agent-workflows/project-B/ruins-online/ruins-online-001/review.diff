+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { seaMap } from "@pirate-sea-race/content";
+import { objectiveRules } from "@pirate-sea-race/simulation/objectives";
+import { clueFor, findRuin, sessionOf } from "@pirate-sea-race/simulation/ruins";
+import { checkLedger } from "@pirate-sea-race/simulation/objectives";
+import { MAX_RUIN_MESSAGES_PER_SECOND, parseRuinResultMessage, RuinMessageType, TEST_NEXT_MATCH_RUINS_PATH } from "@pirate-sea-race/protocol";
+import { startGameServer, type RunningGameServer } from "@pirate-sea-race/server";
+import { HeadlessClient, ImpairmentProxy, readClue, sleep, wrongAnswer, type ReadClue } from "@pirate-sea-race/test-tools";
+import { containsText, EAST, HOLD_E, openWater, playersAt, quickStart, roomOf, startThroughLobby, tracker, until, type Seat } from "./seaDuelSetup.js";
+import { layout, quickEncounters } from "./rubbingsSetup.js";
+
+/**
+ * The ruins in the match room (§3, §11, §16): every island's sources start locked behind its ruin; a player moored
+ * there opens it, reads the clue and answers; the first solve unlocks the island for everyone, and every solver earns
+ * 40 gold once. The server pins Palm Key's ruin to a sequence and Ember Rock's to a grid (test-only), leaves Old Stones
+ * dealt from the ruins' own seed, locked, and opens Mist Cay from the start. Answers are worked out from the clue the client
+ * received, as a reader would (`readClue`). Every test's rooms check `checkLedger` and the room's invariant after
+ * every world tick, and that the ledger refused nothing the room asked (`tracker`).
+ */
+let server: RunningGameServer;
+let endpoint: string;
+
+beforeAll(async () => {
+  const matchTuning = quickStart({
+    sourceLayout: layout,
+    objectives: { ...objectiveRules, collectTicks: 20 },
+    encounters: quickEncounters,
+    testRuins: { "0": "sequence", "1": "navigation", "3": "open" },
+    // The room's test-only fault, to end a match.
+    testHooks: true,
+  });
+  server = await startGameServer({ port: 0, host: "127.0.0.1", handleSignals: false, testPlacement: true, matchTuning });
+  endpoint = `http://127.0.0.1:${server.port}`;
+});
+
+afterAll(async () => {
+  await server.close();
+});
+
+const docksOf = (island: number) => seaMap.docks.filter((dock) => dock.island === island);
+const PALM = docksOf(0);
+const EMBER = docksOf(1);
+const LOCKOUT_TICKS = 60;
+/** Somewhere at sea off Palm Key's west dock, in sight of it. */
+const OFF_PALM: Seat = { tileX: PALM[0]!.tileX - 4, tileY: PALM[0]!.tileY, heading: EAST };
+
+/** Moors a player at a dock: placed on it, then E held until the ship is moored (a locked island gives E nothing more). */
+async function moor(client: HeadlessClient, dock: { id: number; tileX: number; tileY: number }): Promise<void> {
+  await client.placeShip(endpoint, { tileX: dock.tileX, tileY: dock.tileY, heading: 0 });
+  await client.holdUntil(HOLD_E, () => client.ship()?.dock === dock.id, 5000);
+}
+
+/** Opens the ruin where the player is moored and resolves with the clue it received. */
+async function open(client: HeadlessClient): Promise<ReadClue> {
+  const before = client.clues.length;
+  client.openRuin();
+  await client.waitFor(() => client.clues.length > before && client.ruinView()?.ruinOpen === true, 3000);
+  return client.clues.at(-1)!.clue;
+}
+
+/** Answers and resolves with the verdict. */
+async function answer(client: HeadlessClient, attempt: Parameters<HeadlessClient["answerRuin"]>[0], requestId?: string) {
+  const after = client.ruinResults.length;
+  const id = client.answerRuin(attempt, requestId);
+  return client.ruinResult(id, 3000, after);
+}
