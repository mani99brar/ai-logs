/**
 * One player's duel input for one frame: a bit field of held directions and buttons (§8). Directions are absolute
 * (left is towards x = 0), not relative to facing, and are kept as separate bits so that the step itself resolves
 * left + right (and up + down) to neutral. Throw is light and heavy together; there is no separate throw bit.
 */
export const DUEL_INPUT = {
  left: 1 << 0,
  right: 1 << 1,
  up: 1 << 2,
  down: 1 << 3,
  light: 1 << 4,
  heavy: 1 << 5,
  special1: 1 << 6,
  special2: 1 << 7,
  dash: 1 << 8,
} as const;

/** Every defined bit; a duel input is an integer in [0, DUEL_INPUT_MASK]. */
export const DUEL_INPUT_MASK = 0x1ff;

/** The buttons the input buffer remembers, in the order the step checks them. */
export const DUEL_BUTTONS = ["light", "heavy", "special1", "special2", "dash"] as const;

export type DuelButton = (typeof DUEL_BUTTONS)[number];
