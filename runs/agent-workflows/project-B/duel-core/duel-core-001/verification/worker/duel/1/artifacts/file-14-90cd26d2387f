import { DUEL_INPUT_LOG_FORMAT, validateDuelInputLog, type DuelInputLog } from "@pirate-sea-race/content/moves";
import { hashState } from "../hash.js";
import type { DuelInputs } from "./input.js";
import type { DuelConfig, DuelState } from "./state.js";
import { stepDuel } from "./step.js";

export interface DuelReplay {
  readonly state: DuelState;
  readonly hash: string;
}

/** Wraps recorded per-frame inputs, starting from a state at `startFrame`, in the input log format. */
export function createDuelInputLog(config: DuelConfig, startFrame: number, inputs: readonly DuelInputs[]): DuelInputLog {
  return {
    format: DUEL_INPUT_LOG_FORMAT,
    version: 1,
    movesetVersion: config.moveset.version,
    startFrame,
    inputs: inputs.map(([a, b]) => [a, b]),
  };
}

/** The part of a log that replays from a state at `frame` (for a restored snapshot). */
export function sliceDuelInputLog(log: DuelInputLog, frame: number): DuelInputLog {
  if (!Number.isSafeInteger(frame) || frame < log.startFrame || frame > log.startFrame + log.inputs.length) {
    throw new RangeError(`frame ${frame} is outside the log (${log.startFrame} to ${log.startFrame + log.inputs.length})`);
  }
  return { ...log, startFrame: frame, inputs: log.inputs.slice(frame - log.startFrame) };
}

/** Steps through per-frame inputs and returns every state, the initial one first (for scripted tests and tools). */
export function traceDuel(config: DuelConfig, initial: DuelState, inputs: readonly DuelInputs[]): DuelState[] {
  const states = [initial];
  for (const frameInputs of inputs) states.push(stepDuel(config, states[states.length - 1]!, frameInputs));
  return states;
}

/**
 * Runs an input log through the step from `initial` and returns the final state and its hash. Refused when the log
 * is malformed, was recorded on other move data, or does not start at the initial state's frame.
 */
export function replayDuel(config: DuelConfig, initial: DuelState, log: unknown): DuelReplay {
  const parsed = validateDuelInputLog(log);
  if (!parsed.ok) throw new TypeError(`invalid duel input log: ${parsed.issues.join("; ")}`);
  const { movesetVersion, startFrame, inputs } = parsed.value;
  const version = config.moveset.version;
  if (movesetVersion !== version) throw new Error(`the log was recorded on moveset ${movesetVersion}, not ${version}`);
  if (initial.movesetVersion !== version) throw new Error(`the initial state runs on moveset ${initial.movesetVersion}, not ${version}`);
  if (initial.frame !== startFrame) throw new Error(`the log starts at frame ${startFrame}, the state is at frame ${initial.frame}`);
  let state = initial;
  for (const frameInputs of inputs) state = stepDuel(config, state, frameInputs);
  return { state, hash: hashState(state) };
}
