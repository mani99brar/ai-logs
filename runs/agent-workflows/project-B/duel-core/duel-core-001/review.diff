+import { DUEL_INPUT, DUEL_INPUT_MASK } from "@pirate-sea-race/content/moves";
+
+/** Player one's and player two's input bits (`DUEL_INPUT`) for one frame. */
+export type DuelInputs = readonly [number, number];
+
+/** Anything that is not a non-negative safe integer becomes neutral; undefined bits are dropped. */
+export function sanitizeDuelInput(bits: number): number {
+  return Number.isSafeInteger(bits) && bits >= 0 ? bits & DUEL_INPUT_MASK : 0;
+}
+
+/**
+ * Held directions as axes: `h` is -1 (left), 0 or 1 (right); `v` is -1 (down), 0 or 1 (up). Both directions of an
+ * axis held together are neutral (§8), whatever order the keys went down in.
+ */
+export function directions(bits: number): { h: -1 | 0 | 1; v: -1 | 0 | 1 } {
+  const left = (bits & DUEL_INPUT.left) !== 0;
+  const right = (bits & DUEL_INPUT.right) !== 0;
+  const up = (bits & DUEL_INPUT.up) !== 0;
+  const down = (bits & DUEL_INPUT.down) !== 0;
+  return { h: left === right ? 0 : right ? 1 : -1, v: up === down ? 0 : up ? 1 : -1 };
+}
+
+/** The same input for a fighter on the mirrored side of the arena: left and right swap. */
+export function mirrorDuelInput(bits: number): number {
+  const clean = sanitizeDuelInput(bits);
+  const left = clean & DUEL_INPUT.left;
+  const right = clean & DUEL_INPUT.right;
+  return (clean & ~(DUEL_INPUT.left | DUEL_INPUT.right)) | (left !== 0 ? DUEL_INPUT.right : 0) | (right !== 0 ? DUEL_INPUT.left : 0);
+}
+
+/** Input bits from button and direction names, for scripts and tests: `duelInput("down", "heavy")`. */
+export function duelInput(...names: readonly (keyof typeof DUEL_INPUT)[]): number {
+  return names.reduce((bits, name) => bits | DUEL_INPUT[name], 0);
+}
