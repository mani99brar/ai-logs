+import { baselineFrameBudgets } from "../frameBudgets.js";
+import type { DuelArena, DuelFighter, DuelMove, DuelMoveset, DuelRules } from "./schema.js";
+
+/**
+ * Identifies everything in this file. A duel state records it, and restoring or replaying a duel against other data
+ * is refused, so bump it on every change here (a simulation test pins the data's hash to it).
+ */
+export const MOVESET_VERSION = "duelist-1";
+
+/** 16 sub-pixels per arena pixel; `px(4)` is 4 pixels. */
+const SUB_PIXELS_PER_PIXEL = 16;
+const px = (pixels: number) => pixels * SUB_PIXELS_PER_PIXEL;
+
+/** A §8 baseline row by id: the four baseline moves take their timing from the table itself, never a copy. */
+function baseline<Id extends (typeof baselineFrameBudgets)[number]["id"]>(id: Id) {
+  const row = baselineFrameBudgets.find((candidate) => candidate.id === id);
+  if (row === undefined) throw new Error(`no baseline frame budget "${id}"`);
+  return row as Extract<(typeof baselineFrameBudgets)[number], { id: Id }>;
+}
+
+export const duelRules: DuelRules = {
+  roundFrames: 3600,
+  overtimeFrames: 600,
+  maxHealth: 1000,
+  maxStamina: 100,
+  dashStaminaCost: 20,
+  guardStaminaCost: { light: 10, heavy: 25, special: 20 },
+  staminaRegenDelayFrames: 60,
+  staminaRegenIntervalFrames: 3,
+  guardBreakStaggerFrames: 30,
+  guardBreakStaminaRestore: 30,
+  comboScaling: [100, 80, 65, 50, 40],
+  comboCap: 5,
+  forcedRecoveryFrames: 40,
+  throwEscapeFrames: 10,
+  inputBufferFrames: 4,
+};
+
+/** 640 × 16 px wide; the fighters start 192 px apart, beyond every move's reach. */
+export const duelArena: DuelArena = {
+  subPixelsPerPixel: SUB_PIXELS_PER_PIXEL,
+  width: px(640),
+  startGap: px(192),
+};
+
+export const duelistFighter: DuelFighter = {
+  hurtboxes: {
+    standing: { x: px(-20), y: 0, w: px(40), h: px(96) },
+    crouching: { x: px(-22), y: 0, w: px(44), h: px(56) },
+    airborne: { x: px(-18), y: 0, w: px(36), h: px(80) },
+  },
+  pushbox: { halfWidth: px(16), height: px(80) },
+  walkForwardSpeed: 48,
+  walkBackSpeed: 40,
+  // 160 up, 8 gravity: 40 frames in the air, apex about 105 px, high enough to pass over a standing pushbox.
+  jumpVelocity: 160,
+  jumpSpeedX: 40,
+  gravity: 8,
+  dashFrames: 16,
+  dashSpeed: 64,
+  backdashFrames: 18,
+  backdashSpeed: 56,
+  throwBreakFrames: 20,
+  throwBreakPushback: px(16),
+};
+
+const G = duelRules.guardStaminaCost;
+
+/**
+ * Hitboxes face right, relative to the fighter's origin. Blockstun always equals active + recovery + the on-block
+ * advantage (contact on the first active frame).
+ *
+ * The heavy mid and the jab are tuned together so the heavy is punishable by a jab at every spacing it can leave:
+ * the heavy reaches a standing hurtbox up to 80 px away (hitbox to 60 px, hurtbox 20 px wide either side) and pushes
+ * the blocker back 4 px, so it leaves at most 84 px minus one sub-pixel; the jab reaches 64 + 20 = 84 px.
+ */
