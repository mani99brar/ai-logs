+import { duelistMoveset, validateDuelInputLog } from "@pirate-sea-race/content/moves";
+import { describe, expect, it } from "vitest";
+import { canonicalize } from "../hash.js";
+import { nextInt } from "../random.js";
+import {
+  createDuelInputLog,
+  createDuelState,
+  defaultDuelConfig as config,
+  duelInput as I,
+  hashState,
+  mirrorDuelInput,
+  MOVESET_VERSION,
+  replayDuel,
+  restoreDuel,
+  sliceDuelInputLog,
+  snapshotDuel,
+  stepDuel,
+  traceDuel,
