+];
+
+export const duelistMoveset: DuelMoveset = {
+  version: MOVESET_VERSION,
+  rules: duelRules,
+  arena: duelArena,
+  fighter: duelistFighter,
+  moves: duelistMoves,
+  commands: {
+    light: "jab",
+    downLight: "anti-air",
