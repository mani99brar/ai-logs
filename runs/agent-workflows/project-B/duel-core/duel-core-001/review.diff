+    ...hold(30, 0, R),
+    ...hold(1, I("heavy"), R),
+    ...hold(34, 0, R),
+    ...hold(1, 0, I("light")),
+    ...hold(40, R, 0),
+    ...hold(1, THROW, THROW),
+    ...hold(40),
+    ...hold(1, I("dash"), I("up", "left")),
+    ...hold(50, R, L),
+    ...hold(40, R, R),
+    ...hold(1, R, THROW),
+    ...hold(13, R, 0),
+    ...hold(1, THROW, 0),
+    ...hold(30),
+    ...hold(40, R, R),
+    ...hold(1, R, THROW),
+    ...hold(40),
+    ...hold(30, R, R),
+    ...hold(1, I("down", "right"), I("down", "heavy")),
+    ...hold(40, I("down", "right"), 0),
+    ...hold(1, I("special2"), I("special1")),
+    ...hold(60),
+    ...randomInputs(7, 600),
+  ];
+
+  it("gives the mirrored outcome, frame by frame, when the two players swap sides and slots", () => {
+    const start = createDuelState(config, { x: [8000, 9200] });
+    const mirrored = createDuelState(config, { x: [width - 9200, width - 8000] });
