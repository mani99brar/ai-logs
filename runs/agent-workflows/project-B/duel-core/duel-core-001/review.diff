+    // unsafe on block or whiff.
+    timing: { id: "counter-slash", name: "Counter slash", startup: 8, active: 3, recovery: 30, onBlock: { kind: "frames", advantage: -22 } },
+    kind: "strike",
+    category: "special",
+    stance: "standing",
+    guard: "high",
+    hitbox: { x: px(12), y: px(48), w: px(36), h: px(48) },
