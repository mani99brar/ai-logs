import { describe, expect, it } from "vitest";
import { seaMap } from "@pirate-sea-race/content";
import { RUBBING_TYPE_NAMES } from "@pirate-sea-race/protocol";
import {
  addPlayer,
  cancelChannel,
  checkLedger,
  progressChannel,
  quitPlayer,
  RUBBING_TYPES,
  startCollect,
  objectiveRules,
  type LedgerState,
} from "@pirate-sea-race/simulation/objectives";
import { cachedTypesAt, cacheDock, createMatchLedger, dockCentre, interactTarget, layoutAssignment, nearestDockBySea, sealedTypesAt, sourceSites } from "./objectives.js";

const LAYOUT = [
  ["sun", "sun"],
  ["moon", "moon"],
  ["sun", "moon"],
  ["moon", "sun"],
];

/** Holds E for a whole collection at a source, in the ledger. */
function collect(ledger: LedgerState, playerId: string, sourceId: string, from: number): { ledger: LedgerState; tick: number } {
  let state = startCollect(ledger, { playerId, sourceId, tick: from }).state;
  let tick = from;
  for (let held = 0; held < objectiveRules.collectTicks; held++) state = progressChannel(state, { playerId, tick: ++tick }).state;
  return { ledger: state, tick };
}

describe("the ledger's place on the sea", () => {
  it("keeps the protocol's rubbing type names equal to the content's", () => {
    expect([...RUBBING_TYPE_NAMES]).toEqual([...RUBBING_TYPES]);
  });

  it("puts each island's two sources at its docks in id order, and a cache is found at its dock", () => {
    const sites = sourceSites(seaMap);
    expect(sites).toHaveLength(8);
    for (let island = 0; island < 4; island++) {
      const docks = seaMap.docks.filter((dock) => dock.island === island).map((dock) => dock.id);
      expect(sites.filter((site) => site.island === island)).toEqual(docks.slice(0, 2).map((dock) => ({ island, ...dockCentre(seaMap, dock) })));
    }
    for (const dock of seaMap.docks) expect(cacheDock(seaMap, dockCentre(seaMap, dock.id))).toBe(dock.id);
    expect(cacheDock(seaMap, { x: 1, y: 1 })).toBe(-1);
  });

  it("reuses an island's dock for its second source when the island has only one dock, and refuses an island with none", () => {
    // The slice sea with only the first dock of each island left, renumbered so each dock's id is its index again.
    const firstDocks = seaMap.docks.filter((dock, index) => seaMap.docks.findIndex((each) => each.island === dock.island) === index);
    const oneDock = { ...seaMap, docks: firstDocks.map((dock, id) => ({ ...dock, id })) };
    expect(oneDock.docks).toHaveLength(4);
    const sites = sourceSites(oneDock);
    expect(sites).toHaveLength(8);
    for (const dock of oneDock.docks) {
      const centre = dockCentre(oneDock, dock.id);
      // Both of the island's sources stand at its one dock: site 1 wraps round to dock 0.
      expect(sites.filter((site) => site.island === dock.island)).toEqual([
        { island: dock.island, ...centre },
        { island: dock.island, ...centre },
      ]);
    }
    // The ledger takes those sites: two sources at one dock, both collectable there.
    const ledger = createMatchLedger({ map: oneDock, seed: 3, rules: objectiveRules, layout: LAYOUT });
    expect(checkLedger(ledger)).toEqual([]);
    expect(ledger.sources.filter((source) => source.island === 2).map((source) => [source.x, source.y])).toEqual([
      [dockCentre(oneDock, 2).x, dockCentre(oneDock, 2).y],
      [dockCentre(oneDock, 2).x, dockCentre(oneDock, 2).y],
    ]);
    const noDock = { ...oneDock, docks: oneDock.docks.filter((dock) => dock.island !== 3) };
    expect(() => sourceSites(noDock)).toThrow(/island 3 has no dock/);
  });

  it("deals a match's rubbings from its private seed, every source unlocked until the ruins are wired", () => {
    const one = createMatchLedger({ map: seaMap, seed: 7, rules: objectiveRules });
    const two = createMatchLedger({ map: seaMap, seed: 8, rules: objectiveRules });
    expect(checkLedger(one)).toEqual([]);
    expect(one.sources.every((source) => source.unlocked)).toBe(true);
    expect(one.sources.map((source) => source.rubbingId)).not.toEqual(two.sources.map((source) => source.rubbingId));
    expect(createMatchLedger({ map: seaMap, seed: 7, rules: objectiveRules }).sources).toEqual(one.sources);
  });

  it("deals the test-only layout exactly, and refuses one that does not seal every rubbing once", () => {
    const ledger = createMatchLedger({ map: seaMap, seed: 1, rules: objectiveRules, layout: LAYOUT });
    expect(ledger.sources.map((source) => `${source.id}:${source.rubbingId}`)).toEqual([
      "source-0-0:sun-1",
      "source-0-1:sun-2",
      "source-1-0:moon-1",
      "source-1-1:moon-2",
      "source-2-0:sun-3",
      "source-2-1:moon-3",
      "source-3-0:moon-4",
      "source-3-1:sun-4",
    ]);
    expect(checkLedger(ledger)).toEqual([]);
    expect(() => createMatchLedger({ map: seaMap, seed: 1, rules: objectiveRules, layout: [["sun", "sun"], ["sun", "sun"], ["sun", "sun"], ["moon", "moon"]] })).toThrow();
    expect(() => layoutAssignment(sourceSites(seaMap), [["gold"]])).toThrow();
  });
});

describe("what E targets at a dock", () => {
  const ledger = addPlayer(addPlayer(createMatchLedger({ map: seaMap, seed: 1, rules: objectiveRules, layout: LAYOUT }), { playerId: "a", tick: 0 }).state, {
    playerId: "b",
    tick: 0,
  }).state;
  const dockOf = (island: number, which = 0) => seaMap.docks.filter((dock) => dock.island === island)[which]!.id;

  it("targets the island's first sealed source of a type the player lacks, in type order, at either of its docks", () => {
    expect(interactTarget(ledger, seaMap, "a", dockOf(2))).toEqual({ kind: "collect", sourceId: "source-2-0", type: "sun" });
    expect(interactTarget(ledger, seaMap, "a", dockOf(2, 1))).toEqual({ kind: "collect", sourceId: "source-2-0", type: "sun" });
    // Island 3 seals a Moon then a Sun: the Sun comes first in type order.
    expect(interactTarget(ledger, seaMap, "a", dockOf(3))).toEqual({ kind: "collect", sourceId: "source-3-1", type: "sun" });
    expect(sealedTypesAt(ledger, 3)).toEqual(["sun", "moon"]);
  });

  it("skips types the player holds, then offers a cache rubbing it lacks, and nothing once it lacks nothing there", () => {
    const { ledger: collected, tick } = collect(ledger, "a", "source-2-0", 1);
    expect(interactTarget(collected, seaMap, "a", dockOf(2))).toEqual({ kind: "collect", sourceId: "source-2-1", type: "moon" });
    expect(sealedTypesAt(collected, 2)).toEqual(["moon"]);
    // b collects Palm Key's Sun and quits next to Palm Key's west dock: its cache holds that Sun.
    const b = collect(collected, "b", "source-0-0", tick + 1);
    const west = dockOf(0);
    const quit = quitPlayer(b.ledger, { playerId: "b", tick: b.tick + 1, position: dockCentre(seaMap, west) }).state;
    expect(cachedTypesAt(quit, seaMap, west)).toEqual(["sun"]);
    // a holds a Sun: Palm Key's other Sun and the cached one are nothing to it.
    expect(interactTarget(quit, seaMap, "a", west)).toBeUndefined();
    // A newcomer lacking the Sun collects the island's before the cache's.
    const c = addPlayer(quit, { playerId: "c", tick: b.tick + 1 }).state;
    expect(interactTarget(c, seaMap, "c", west)).toEqual({ kind: "collect", sourceId: "source-0-1", type: "sun" });
    const drained = collect(c, "c", "source-0-1", b.tick + 2).ledger;
    const d = addPlayer(drained, { playerId: "d", tick: b.tick + 200 }).state;
    expect(interactTarget(d, seaMap, "d", west)).toMatchObject({ kind: "claim", type: "sun" });
    expect(checkLedger(cancelChannel(d, { playerId: "d", tick: b.tick + 200 }).state)).toEqual([]);
  });
});

describe("the dock nearest by sea (§12's quit)", () => {
  it("measures by sea path, not in a straight line", () => {
    const tile = seaMap.subUnitsPerTile;
    const at = (tileX: number, tileY: number) => [tileX * tile + tile / 2, tileY * tile + tile / 2] as const;
    // East of Ember Rock: its east dock.
    expect(nearestDockBySea(seaMap, ...at(97, 21))).toBe(1);
    // North of Palm Key, one row above its land, the west dock is nearer in a straight line (the south dock is behind
    // the island), and by sea too.
    const north = at(24, 15);
    const west = dockCentre(seaMap, 0);
    const south = dockCentre(seaMap, 2);
    const straight = (dock: { x: number; y: number }) => Math.hypot(dock.x - north[0], dock.y - north[1]);
    expect(straight(west)).toBeLessThan(straight(south));
    expect(nearestDockBySea(seaMap, ...north)).toBe(0);
    // Just east of Palm Key, the south dock is nearer by sea than the west one round the island's north.
    expect(nearestDockBySea(seaMap, ...at(32, 21))).toBe(2);
  });
});
