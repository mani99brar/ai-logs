import {
  parseTestFinalSecret,
  parseTestSourceLayout,
  parseTestTimings,
  TEST_FINAL_SECRET_ENV,
  TEST_PLACEMENT_ENV,
  TEST_SOURCES_ENV,
  TEST_TIMINGS_ENV,
} from "@pirate-sea-race/protocol";
import type { MatchTuning } from "./MatchRoom.js";
import { DEFAULT_PORT, startGameServer, testTimingsTuning } from "./server.js";

/**
 * The development and test entry point (`npm run dev`, and `start:source` for the browser tests). Unlike the
 * production entry (`main.ts`), it reads the test-only settings, each off unless its variable is set:
 * PIRATE_SEA_RACE_TEST_PLACEMENT=1 turns on the route that puts ships on chosen tiles;
 * PIRATE_SEA_RACE_TEST_SOURCES pins every match's source layout (for example `sun,sun|moon,moon|sun,sun|moon,moon`),
 * so a scenario can pick an island by its rubbing type; PIRATE_SEA_RACE_TEST_TIMINGS shortens the ready countdown,
 * the departure's protection, the match and its reveals (for example `ready=60,protection=20,match=12000`); and
 * PIRATE_SEA_RACE_TEST_FINAL_SECRET pins the secret the final island's socket is picked with.
 */
const port = Number(process.env["PORT"] ?? DEFAULT_PORT);
const testPlacement = process.env[TEST_PLACEMENT_ENV] === "1";

/** A set variable's parsed value, undefined when unset or empty; a malformed one stops the server. */
function setting<T>(name: string, parse: (text: string) => T | undefined): T | undefined {
  const text = process.env[name];
  if (text === undefined || text === "") return undefined;
  const parsed = parse(text);
  if (parsed === undefined) throw new Error(`${name} is malformed: ${text}`);
  return parsed;
}

const sourceLayout = setting(TEST_SOURCES_ENV, parseTestSourceLayout);
const timings = setting(TEST_TIMINGS_ENV, parseTestTimings);
const finalSocketSecret = setting(TEST_FINAL_SECRET_ENV, parseTestFinalSecret);
const matchTuning: Partial<MatchTuning> = {
  ...(sourceLayout !== undefined ? { sourceLayout } : {}),
  ...(timings !== undefined ? testTimingsTuning(timings) : {}),
  ...(finalSocketSecret !== undefined ? { finalSocketSecret } : {}),
};
const running = await startGameServer({ port, testPlacement, matchTuning });
const settings = [
  testPlacement ? "test placement on" : "",
  sourceLayout !== undefined ? `test sources ${process.env[TEST_SOURCES_ENV]}` : "",
  timings !== undefined ? `test timings ${process.env[TEST_TIMINGS_ENV]}` : "",
  finalSocketSecret !== undefined ? "pinned final-socket secret" : "",
].filter((each) => each !== "");
console.log(`Pirate Sea Race server listening on ws://localhost:${running.port}${settings.length > 0 ? ` (${settings.join(", ")})` : ""}`);
