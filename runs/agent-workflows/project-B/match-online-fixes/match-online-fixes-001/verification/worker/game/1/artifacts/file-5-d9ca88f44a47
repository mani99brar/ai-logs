import { describe, expect, it } from "vitest";
import { seaMap } from "@pirate-sea-race/content";
import { claimRules, TREASURE_CIRCLE_RADIUS_TILES } from "@pirate-sea-race/content/claim";
import { encounterRules } from "@pirate-sea-race/content/encounters";
import { privateMatch } from "@pirate-sea-race/content";
import { PRIVATE_MIN_PLAYERS } from "@pirate-sea-race/content/match";
import { intelRules } from "@pirate-sea-race/content/intel";
import { chooseFinalSocket } from "@pirate-sea-race/content";
import { claimConfigFor, finalIslandOf, intelConfigFor, matchConfigFor } from "./matchFlow.js";
import { DEFAULT_MATCH_TUNING, type MatchTuning } from "./MatchRoom.js";

/** A test-only tuning of the kind the browser checks use: a short countdown, protection and match. */
const SHORT: MatchTuning = {
  ...DEFAULT_MATCH_TUNING,
  match: { ...DEFAULT_MATCH_TUNING.match, readyTicks: 60 },
  encounters: { ...encounterRules, spawnProtectionTicks: 20 },
  claim: { ...claimRules, deadlineTicks: 1200 },
  intel: { ...intelRules, sectorRevealTicks: 200, carrierRevealTicks: 600 },
};

describe("the match flow's configs (§2, §5)", () => {
  it("run the timer for exactly the claim deadline, from one set of rules, in production and in tests", () => {
    for (const tuning of [DEFAULT_MATCH_TUNING, SHORT]) {
      const flow = matchConfigFor(tuning);
      for (const controlStart of [0, 401, 12_345]) {
        const claim = claimConfigFor(tuning, { x: 0, y: 0 }, controlStart, seaMap);
        expect(claim.deadlineTick - controlStart).toBe(flow.durationTicks);
      }
      expect(flow.durationTicks).toBe(tuning.claim.deadlineTicks);
      // The departure is the encounter rules' spawn protection, not a copy of it.
      expect(flow.departureTicks).toBe(tuning.encounters.spawnProtectionTicks);
      expect(flow.startingGold).toBe(tuning.objectives.startingGold);
    }
    // Production: 35:00, a 20 s countdown and 45 s of departure protection.
    const production = matchConfigFor(DEFAULT_MATCH_TUNING);
    expect(production.durationTicks).toBe(35 * 60 * 20);
    expect(production.readyTicks).toBe(20 * 20);
    expect(production.departureTicks).toBe(45 * 20);
  });

  it("start a private match with the match module's minimum of two (the content's privateMatch.minPlayers is stale)", () => {
    const flow = matchConfigFor(DEFAULT_MATCH_TUNING);
    expect(flow.minPlayers).toBe(PRIVATE_MIN_PLAYERS);
    expect(flow.minPlayers).toBe(2);
    expect(flow.custom).toBe(true);
    expect(flow.seats).toBe(privateMatch.maxPlayers);
    // Reported for a later content cleanup: the older constant still says one.
    expect(privateMatch.minPlayers).toBe(1);
  });

  it("count the reveals from control start, around the final island's claim point", () => {
    const point = finalIslandOf(seaMap, 7).claimPoint;
    const intel = intelConfigFor(SHORT, point, 500, seaMap);
    expect(intel.finalIsland).toEqual(point);
    expect(intel.sectorRevealTick).toBe(700);
    expect(intel.carrierRevealTick).toBe(1100);
    expect(intelConfigFor(DEFAULT_MATCH_TUNING, point, 500, seaMap).sectorRevealTick).toBe(500 + 20 * 60 * 20);
  });

  it("put the final island at the centre of the claim tile of the socket the secret picks", () => {
    const seen = new Set<number>();
    for (let secret = 0; secret < 64; secret++) {
      const { socket, claimPoint } = finalIslandOf(seaMap, secret);
      expect(socket).toBe(chooseFinalSocket(seaMap, secret));
      const tile = seaMap.finalSockets[socket]!.claimTile;
      expect(claimPoint).toEqual({ x: tile.tileX * 256 + 128, y: tile.tileY * 256 + 128 });
      seen.add(socket);
    }
    expect(seen.size).toBe(seaMap.finalSockets.length);
    const claim = claimConfigFor(DEFAULT_MATCH_TUNING, finalIslandOf(seaMap, 1).claimPoint, 0, seaMap);
    expect(claim.circleRadius).toBe(TREASURE_CIRCLE_RADIUS_TILES * seaMap.subUnitsPerTile);
    expect(claim.channelTicks).toBe(200);
  });
});

describe("the test-only timings (PIRATE_SEA_RACE_TEST_TIMINGS)", () => {
  it("shorten the countdown, the departure, the match (timer and claim deadline at once) and the reveals, each only when given", async () => {
    const { testTimingsTuning } = await import("./server.js");
    const tuning = { ...DEFAULT_MATCH_TUNING, ...testTimingsTuning({ ready: 60, protection: 20, match: 12_000, sectors: 200, carriers: 600 }) };
    const flow = matchConfigFor(tuning);
    expect([flow.readyTicks, flow.departureTicks, flow.durationTicks]).toEqual([60, 20, 12_000]);
    expect(claimConfigFor(tuning, { x: 0, y: 0 }, 100, seaMap).deadlineTick).toBe(12_100);
    expect(intelConfigFor(tuning, { x: 0, y: 0 }, 100, seaMap)).toMatchObject({ sectorRevealTick: 300, carrierRevealTick: 700 });
    // Unset ones keep the rules' own.
    const onlyReady = matchConfigFor({ ...DEFAULT_MATCH_TUNING, ...testTimingsTuning({ ready: 60 }) });
    expect([onlyReady.readyTicks, onlyReady.departureTicks, onlyReady.durationTicks]).toEqual([60, 900, 42_000]);
  });
});
