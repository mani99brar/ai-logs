+/**
+ * The sketch the slice sea is drawn from: one quarter of the map as ASCII, mirrored into all four quarters, so every
+ * island, spawn slot and route has a twin in each corner (§2's spawn fairness). It writes `slice-sea.tmj` in the
+ * Tiled subset `packages/content/src/tiledMap.ts` documents; that file stays the committed source `npm run map:build`
+ * reads. Regenerate after editing this sketch, from the repository root:
+ *
+ *   node assets/source/maps/sketch.ts && npm run map:build
+ *
+ * Node runs it directly (type stripping), so it uses only erasable TypeScript and imports nothing from the workspace.
+ */
+import { writeFileSync } from "node:fs";
+
+/** Tiled's tile size for sea maps: `TILE_PIXELS` in `packages/content/src/tiledMap.ts`. */
+const TILE_PIXELS = 24;
+
+/**
+ * The north-west quarter, 56 × 56 tiles: `.` sea, `#` land, `%` shoal, `D` dock. Its last column and row are the map's
+ * midlines, shared with the mirrored quarters: shoal walls that stop five tiles short of the centre, so the only way
+ * from one quarter to another is through the open crossing around the hub (the map's centre tile). Row 52 here, and
+ * so the row three tiles south of the hub too, is kept clear from 20 tiles west of the hub to 20 east of it: the
+ * browser and integration tests put ships on it.
+ */
+const QUARTER = [
+  ".......................................................%", // 0
+  ".......................................................%", // 1
+  ".......................................................%", // 2
+  ".......................................................%", // 3
+  ".......................................................%", // 4
+  ".....%%...............%%...............................%", // 5
+  "....%%%%.............%%%%...............%%.............%", // 6
