/**
 * The sea is a bounded rectangle of tiles laid out like screen coordinates: origin (0,0) at the top-left, x grows
 * right and y grows down. Every tile is split into a fixed integer number of sub-units, and all positions and speeds
 * in the simulation are integer sub-units.
 */
export const SUB_UNITS_PER_TILE = 256;

/** What a tile is. Sea and docks are navigable; land and shoals stop ships. */
export const Terrain = {
  Sea: 0,
  Land: 1,
  Shoal: 2,
  Dock: 3,
} as const;
export type Terrain = (typeof Terrain)[keyof typeof Terrain];

/** One character per tile in a map's rows. */
export const TERRAIN_CHARS: Readonly<Record<string, Terrain>> = {
  ".": Terrain.Sea,
  "#": Terrain.Land,
  "%": Terrain.Shoal,
  D: Terrain.Dock,
};

export const ISLAND_THEMES = ["tropical", "volcanic", "ruin", "mist"] as const;
export type IslandTheme = (typeof ISLAND_THEMES)[number];

/** Eight compass directions, as authored on spawn objects. */
export const COMPASS = ["E", "SE", "S", "SW", "W", "NW", "N", "NE"] as const;
export type Compass = (typeof COMPASS)[number];

/** Ship headings are integers in [0, HEADING_COUNT): 0 is east, counting clockwise because y grows down. */
export const HEADING_COUNT = 64;

export function compassHeading(direction: Compass): number {
  return COMPASS.indexOf(direction) * (HEADING_COUNT / COMPASS.length);
}

/** An island as authored: a name, a theme and the tile rectangle holding its land and docks. */
export interface IslandSource {
  readonly name: string;
  readonly theme: IslandTheme;
  readonly tileX: number;
  readonly tileY: number;
  readonly widthTiles: number;
  readonly heightTiles: number;
}

/** A prevalidated outer-sea spawn position (§2): the tile whose centre the ship starts on, and its heading. */
export interface SpawnSlot {
  readonly tileX: number;
  readonly tileY: number;
  readonly facing: Compass;
}

/** A tile, as a point object names it. */
export interface TilePoint {
  readonly tileX: number;
  readonly tileY: number;
}

/** A map as the converter writes it (`scripts/build-map.ts`): rows of terrain characters plus the named objects. */
export interface SeaMapSource {
  readonly name: string;
  readonly widthTiles: number;
  readonly heightTiles: number;
  readonly rows: readonly string[];
  readonly islands: readonly IslandSource[];
  /** In slot order. */
  readonly spawnSlots: readonly SpawnSlot[];
  /** The shared crossing near the centre that every route between islands passes (§3: ships meet). */
  readonly hub: TilePoint;
}

/** A dock tile, owned by the island whose rectangle holds it. `side` (N, E, S or W) says where it lies on the island. */
export interface Dock {
  readonly id: number;
  readonly tileX: number;
  readonly tileY: number;
  readonly island: number;
  readonly side: Compass;
}

/** A decoded map, as the simulation and the client read it. */
export interface SeaMapDefinition {
  readonly name: string;
  readonly widthTiles: number;
  readonly heightTiles: number;
  readonly subUnitsPerTile: number;
  /** Row-major terrain, `widthTiles * heightTiles` entries. */
  readonly terrain: readonly Terrain[];
  readonly islands: readonly IslandSource[];
  /** Row-major order of their tiles. */
  readonly docks: readonly Dock[];
  readonly spawnSlots: readonly SpawnSlot[];
  readonly hub: TilePoint;
}

/** Decodes a map source. Throws on a structural error (a row of the wrong length, an unknown character). */
export function createSeaMap(source: SeaMapSource): SeaMapDefinition {
  if (source.rows.length !== source.heightTiles) {
    throw new Error(`${source.name}: ${source.rows.length} rows for a height of ${source.heightTiles}`);
  }
  const terrain: Terrain[] = [];
  source.rows.forEach((row, tileY) => {
    if (row.length !== source.widthTiles) throw new Error(`${source.name}: row ${tileY} has ${row.length} tiles, not ${source.widthTiles}`);
    for (const char of row) {
      const kind = TERRAIN_CHARS[char];
      if (kind === undefined) throw new Error(`${source.name}: unknown terrain "${char}" in row ${tileY}`);
      terrain.push(kind);
    }
  });
  const docks: Dock[] = [];
  terrain.forEach((kind, index) => {
    if (kind !== Terrain.Dock) return;
    const tileX = index % source.widthTiles;
    const tileY = Math.floor(index / source.widthTiles);
    const island = source.islands.findIndex((candidate) => insideIsland(candidate, tileX, tileY));
    const side = island < 0 ? "N" : sideOf(source.islands[island]!, tileX, tileY);
    docks.push({ id: docks.length, tileX, tileY, island, side });
  });
  return {
    name: source.name,
    widthTiles: source.widthTiles,
    heightTiles: source.heightTiles,
    subUnitsPerTile: SUB_UNITS_PER_TILE,
    terrain,
    islands: source.islands,
    docks,
    spawnSlots: source.spawnSlots,
    hub: source.hub,
  };
}

export function insideIsland(island: IslandSource, tileX: number, tileY: number): boolean {
  return (
    tileX >= island.tileX && tileX < island.tileX + island.widthTiles && tileY >= island.tileY && tileY < island.tileY + island.heightTiles
  );
}

/** The side of an island a tile lies on (N, E, S or W), from its offset to the island rectangle's centre. */
function sideOf(island: IslandSource, tileX: number, tileY: number): Compass {
  // Doubled offsets keep the rectangle's centre on an integer; scaling by the other side's length makes a long thin
  // island still read its ends as its ends.
  const dx = (2 * tileX + 1 - (2 * island.tileX + island.widthTiles)) * island.heightTiles;
  const dy = (2 * tileY + 1 - (2 * island.tileY + island.heightTiles)) * island.widthTiles;
  if (Math.abs(dx) >= Math.abs(dy)) return dx > 0 ? "E" : "W";
  return dy > 0 ? "S" : "N";
}

export function terrainAt(map: SeaMapDefinition, tileX: number, tileY: number): Terrain | undefined {
  if (tileX < 0 || tileY < 0 || tileX >= map.widthTiles || tileY >= map.heightTiles) return undefined;
  return map.terrain[tileY * map.widthTiles + tileX];
}

/** Ships sail on sea and docks. Anything outside the map counts as blocked. */
export function isNavigable(map: SeaMapDefinition, tileX: number, tileY: number): boolean {
  const kind = terrainAt(map, tileX, tileY);
  return kind === Terrain.Sea || kind === Terrain.Dock;
}

/** A readable name for a dock, for the HUD: "Palm Key, south dock". */
export function dockLabel(map: SeaMapDefinition, dockId: number): string {
  const dock = map.docks[dockId];
  if (dock === undefined) return "";
  const names: Record<Compass, string> = { E: "east", SE: "south-east", S: "south", SW: "south-west", W: "west", NW: "north-west", N: "north", NE: "north-east" };
  return `${map.islands[dock.island]?.name ?? "?"}, ${names[dock.side]} dock`;
}
