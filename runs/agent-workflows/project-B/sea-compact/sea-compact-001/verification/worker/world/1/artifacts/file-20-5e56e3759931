/**
 * Converts the Tiled sea map (`assets/source/maps/slice-sea.tmj`, the subset documented in
 * `packages/content/src/tiledMap.ts`) into the typed module `packages/content/src/maps/sliceSea.ts`, after checking
 * it against the map validators. `--check` writes nothing and fails when the module is out of date.
 *
 *   npm run map:build      convert and write
 *   npm run map:check      compare only
 */
import { readFileSync, writeFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { shipTuning } from "../packages/content/src/sailing.js";
import { createSeaMap } from "../packages/content/src/seaMap.js";
import { validateSeaMap } from "../packages/content/src/seaValidation.js";
import { convertTiledMap, formatSeaMapModule } from "../packages/content/src/tiledMap.js";

const SLICE_SEA = {
  name: "slice-sea",
  source: "assets/source/maps/slice-sea.tmj",
  module: "packages/content/src/maps/sliceSea.ts",
  exportName: "sliceSeaSource",
} as const;

const root = fileURLToPath(new URL("..", import.meta.url));

function fail(lines: readonly string[]): never {
  for (const line of lines) console.error(`  ${line}`);
  process.exit(1);
}

const converted = convertTiledMap(SLICE_SEA.name, JSON.parse(readFileSync(`${root}${SLICE_SEA.source}`, "utf8")));
if (!converted.ok) {
  console.error(`${SLICE_SEA.source} is outside the supported Tiled subset:`);
  fail(converted.issues);
}
const validated = validateSeaMap(createSeaMap(converted.value), shipTuning);
if (!validated.ok) {
  console.error(`${SLICE_SEA.source} fails the map validators:`);
  fail(validated.issues);
}

const text = formatSeaMapModule(converted.value, SLICE_SEA.exportName, SLICE_SEA.source);
const target = `${root}${SLICE_SEA.module}`;
let current: string | undefined;
try {
  current = readFileSync(target, "utf8");
} catch {
  current = undefined;
}

const report = validated.value;
console.log(`${SLICE_SEA.source}: ${converted.value.widthTiles} × ${converted.value.heightTiles} tiles`);
for (const entry of report.nearestIsland) console.log(`  ${entry.island} → ${entry.nearest}: ${entry.seconds} s`);
console.log(`  longest crossing: ${report.longestCrossing.from} → ${report.longestCrossing.to}: ${report.longestCrossing.seconds} s`);
console.log(`  first dock from a spawn slot: ${Math.max(...report.firstDock.map((entry) => entry.seconds))} s at most`);
const tiles = (squared: number) => Math.sqrt(squared).toFixed(1);
console.log(`  largest distance from open water to land, a shoal or a dock: ${tiles(report.largestObstacleDistanceSquared)} tiles`);
console.log(`  open sea: ${(report.openSeaShare * 100).toFixed(1)} % of the map`);
for (const entry of report.hubApproach) console.log(`  ${entry.from} → ${entry.to}: passes ${tiles(entry.squaredTiles)} tiles from the hub`);

if (process.argv.includes("--check")) {
  if (current !== text) fail([`${SLICE_SEA.module} is out of date: run npm run map:build`]);
  console.log(`${SLICE_SEA.module} is up to date`);
} else if (current === text) {
  console.log(`${SLICE_SEA.module} is already up to date`);
} else {
  writeFileSync(target, text);
  console.log(`wrote ${SLICE_SEA.module}`);
}
