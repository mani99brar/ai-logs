import { describe, expect, it } from "vitest";
import { HEADING_COUNT, seaMap } from "@pirate-sea-race/content";
import { createTestPlacementSchema, PLACEMENT_HEADING_COUNT } from "@pirate-sea-race/protocol";

// The protocol cannot import content, so the server, which reads both, checks that they agree on the headings and
// builds the tile bounds from its map.
describe("test placement headings and tiles", () => {
  const testPlacementSchema = createTestPlacementSchema(seaMap);
  const placement = { code: "K7Q2MX", sessionId: "abc123", ...seaMap.hub };
  const accepts = (heading: number) => testPlacementSchema.safeParse({ ...placement, heading }).success;

  it("accepts exactly the simulation's headings, [0, HEADING_COUNT)", () => {
    expect(PLACEMENT_HEADING_COUNT).toBe(HEADING_COUNT);
    expect(accepts(0)).toBe(true);
    expect(accepts(HEADING_COUNT - 1)).toBe(true);
    expect(accepts(HEADING_COUNT)).toBe(false);
    expect(accepts(-1)).toBe(false);
  });

  it("accepts exactly the map's tiles", () => {
    const at = (tileX: number, tileY: number) => testPlacementSchema.safeParse({ ...placement, tileX, tileY, heading: 0 }).success;
    expect(at(0, 0)).toBe(true);
    expect(at(seaMap.widthTiles - 1, seaMap.heightTiles - 1)).toBe(true);
    expect(at(seaMap.widthTiles, 0)).toBe(false);
    expect(at(0, seaMap.heightTiles)).toBe(false);
  });
});
