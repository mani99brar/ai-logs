import { Buttons } from "@pirate-sea-race/protocol";

/** What the player asks of their ship: protocol axes (moveX turns, moveY is the throttle, up ahead) and buttons. */
export interface Helm {
  readonly moveX: number;
  readonly moveY: number;
  readonly buttons: number;
}

export const NEUTRAL_HELM: Helm = { moveX: 0, moveY: 0, buttons: 0 };

const KEYS = {
  left: ["KeyA", "ArrowLeft"],
  right: ["KeyD", "ArrowRight"],
  up: ["KeyW", "ArrowUp"],
  down: ["KeyS", "ArrowDown"],
  interact: ["KeyE"],
} as const;

const HELM_CODES = new Set<string>(Object.values(KEYS).flat());

/** Converts two opposing keys into one axis: both held is neutral, whatever order they were pressed in (§8). */
export function axis(negative: boolean, positive: boolean): number {
  return (positive ? 1 : 0) - (negative ? 1 : 0);
}

/**
 * The keyboard input adapter (§8 defaults): up is throttle, down brakes (and reverses slowly from a stop), left and
 * right turn, E interacts (docks). It tracks held keys and releases them all when the window loses focus, so a ship
 * never keeps sailing on a key-up the page missed. The page reads it on a timer, so a tap of E that goes down and up
 * between two reads is kept until the next read, as the duel keyboard keeps its taps: it counts once.
 */
export class KeyboardHelm {
  private readonly held = new Set<string>();
  private tapped = 0;

  constructor(target: Window) {
    target.addEventListener("keydown", (event) => {
      if (!HELM_CODES.has(event.code) || isTyping(event.target)) return;
      event.preventDefault();
      this.press(event.code);
    });
    target.addEventListener("keyup", (event) => this.release(event.code));
    target.addEventListener("blur", () => this.held.clear());
  }

  press(code: string): void {
    if (!HELM_CODES.has(code)) return;
    this.held.add(code);
    if ((KEYS.interact as readonly string[]).includes(code)) this.tapped |= Buttons.Interact;
  }

  release(code: string): void {
    this.held.delete(code);
  }

  /** What is held now, plus a button tapped since the last read. Reading it clears the tap. */
  helm(): Helm {
    const any = (codes: readonly string[]) => codes.some((code) => this.held.has(code));
    const buttons = (any(KEYS.interact) ? Buttons.Interact : 0) | this.tapped;
    this.tapped = 0;
    return {
      moveX: axis(any(KEYS.left), any(KEYS.right)),
      moveY: axis(any(KEYS.up), any(KEYS.down)),
      buttons,
    };
  }
}

function isTyping(target: EventTarget | null): boolean {
  return target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement;
}
