+test("holds E through a 400 ms pause of the page's own sends mid-collection, and the six-second collection completes without starting over; then the shop sells the journal's rumor with a click", async ({ browser, page, request }) => {
+  test.setTimeout(90_000);
+  // The page's own sends: while paused (`__pauseSends(ms)`), every WebSocket message waits, then all go in order before
+  // the next one, as a stalled connection delivers them.
+  await page.addInitScript(() => {
+    const send = WebSocket.prototype.send;
+    const held: [WebSocket, Parameters<WebSocket["send"]>[0]][] = [];
+    const flush = () => {
+      for (const [socket, data] of held.splice(0)) send.call(socket, data);
+    };
+    const pause = window as unknown as { __pausedUntil: number; __pauseSends: (ms: number) => void };
+    pause.__pausedUntil = 0;
+    pause.__pauseSends = (ms) => {
+      pause.__pausedUntil = Date.now() + ms;
+      setTimeout(flush, ms + 10);
+    };
+    WebSocket.prototype.send = function (data) {
+      if (Date.now() < pause.__pausedUntil) {
+        held.push([this, data]);
+        return;
+      }
+      flush();
+      send.call(this, data);
+    };
+  });
+  const code = await createMatch(page);
+  const companion = await startWithCompanion(browser, page, code);
+  try {
+    await place(request, page, code, PALM_WEST.tileX, PALM_WEST.tileY, WEST);
+    await page.keyboard.press("e");
+    await expect(page.getByTestId("hud-dock")).toHaveAttribute("data-dock", String(PALM_WEST.id));
+    // Every hold progress the page shows from now on.
+    await page.evaluate(() => {
+      const bar = document.querySelector<HTMLElement>('[data-testid="hud-hold-progress"]')!;
+      const seen: number[] = [];
+      (window as unknown as { __held: number[] }).__held = seen;
+      new MutationObserver(() => seen.push(Number(bar.dataset["held"]))).observe(bar, { attributes: true, attributeFilter: ["data-held"] });
+    });
+    await page.keyboard.down("e");
+    try {
+      await expect(page.getByTestId("hud-hold")).toHaveAttribute("data-state", "collect:sun");
+      await expect.poll(async () => Number(await page.getByTestId("hud-hold-progress").getAttribute("data-held"))).toBeGreaterThanOrEqual(40);
+      // Two seconds in, the page's sends stop for 400 ms (E still down), then go on.
+      await page.evaluate(() => (window as unknown as { __pauseSends: (ms: number) => void }).__pauseSends(400));
+      await expect(page.getByTestId("purse-rubbings")).toHaveAttribute("data-types", "sun", { timeout: 12_000 });
+    } finally {
+      await page.keyboard.up("e");
+    }
+    // The shop (B) sells the journal's targeted rumor: a click on the missing type's button buys it (−25 gold), and the
+    // journal records it; Close closes the shop.
+    await page.keyboard.press("b");
+    await expect(page.getByTestId("shop")).toBeVisible();
+    const offer = page.getByTestId("shop-rumors").locator('button[data-state="available"]').first();
+    await expect(offer).toBeEnabled();
+    const type = (await offer.getAttribute("data-type"))!;
+    await offer.click();
+    await expect(page.getByTestId("shop-message")).toHaveText(/^Bought a rumor about (Sun|Moon) \(−25 gold\)$/);
+    await expect(page.getByTestId("purse-gold")).toHaveAttribute("data-gold", "25");
+    await page.getByTestId("shop-close").click();
+    await expect(page.getByTestId("shop")).toBeHidden();
+    await page.keyboard.press("m");
+    await expect(page.getByTestId("journal-rumors").locator(`li[data-reason="targeted"][data-type="${type}"]`)).toHaveCount(1);
+    // The progress never went back, through the pause: one hold from its start to the collection.
+    const progress = await page.evaluate(() => (window as unknown as { __held: number[] }).__held);
+    const first = progress.findIndex((value) => value > 0);
+    const last = progress.length - 1 - [...progress].reverse().findIndex((value) => value > 0);
+    const during = progress.slice(first, last + 1);
+    expect(during.length).toBeGreaterThan(10);
+    expect(during.every((value, index) => index === 0 || value >= during[index - 1]!)).toBe(true);
+    expect(Math.max(...during)).toBeGreaterThanOrEqual(110);
+  } finally {
+    await companion.close();
+  }
+});
