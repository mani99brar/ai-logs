+  carriedText,
+  purchaseLine,
+  ShopPanel,
+  shopStatusOf,
+  shopView,
+  TONIC_CARRY_LIMIT,
+  TONIC_PRICE,
+  tonicButton,
+  tonicHud,
+  TonicKey,
+  useLine,
+  type ShopStatus,
+  type ShopView,
+} from "./shop.js";
+
+const status = (patch: Partial<ShopStatus> = {}): ShopStatus => ({ gold: 50, tonics: 0, tonicUntil: 0, maxSpeed: 39, moored: true, ...patch });
+const journalStatus = (patch: Partial<JournalStatus> = {}): JournalStatus => ({
+  journal: [],
+  knownIslands: [],
+  offers: [
+    { type: "sun", offer: "available" },
+    { type: "moon", offer: "none" },
+  ],
+  rubbings: [],
+  gold: 50,
+  kit: "duelist",
+  moored: true,
+  ...patch,
+});
+
+describe("the shop's model", () => {
+  it("prices the tonic as the server's rules do: 30 gold, at most 2 carried", () => {
+    expect(TONIC_PRICE).toBe(objectiveRules.tonicPrice);
+    expect(TONIC_CARRY_LIMIT).toBe(objectiveRules.tonicCarryLimit);
+  });
+
+  it("reads the shop's status from the private status: moored only at a dock and at sea (not in a duel or waiting)", () => {
+    const fields = { gold: 20, tonics: 1, tonicUntil: 300, maxSpeed: 43, mode: "sea" };
+    expect(shopStatusOf(fields, 4)).toEqual({ gold: 20, tonics: 1, tonicUntil: 300, maxSpeed: 43, moored: true });
+    expect(shopStatusOf(fields, -1)!.moored).toBe(false);
+    expect(shopStatusOf(fields, undefined)!.moored).toBe(false);
+    expect(shopStatusOf({ ...fields, mode: "duel" }, 4)!.moored).toBe(false);
+    expect(shopStatusOf(undefined, 4)).toBeUndefined();
+  });
+
+  it("gives the tonic's button a state and label: available, pending, at the carry limit, short of gold, not at a dock", () => {
+    expect(tonicButton(status(), false)).toEqual({ state: "available", label: "Buy a sail tonic (30 gold)", disabled: false });
+    expect(tonicButton(status(), true)).toMatchObject({ state: "pending", disabled: true });
+    expect(tonicButton(status({ tonics: 2, gold: 500 }), false)).toMatchObject({ state: "limit", label: "Sail tonic: you carry 2, the most you can", disabled: true });
+    expect(tonicButton(status({ gold: 29 }), false)).toMatchObject({ state: "gold", label: "Sail tonic: not enough gold (30)", disabled: true });
+    expect(tonicButton(status({ gold: 30 }), false).disabled).toBe(false);
+    expect(tonicButton(status({ moored: false }), false)).toMatchObject({ state: "not-at-dock", disabled: true });
+    expect(tonicButton(undefined, false)).toMatchObject({ state: "not-at-dock", disabled: true });
+    expect(carriedText(status({ tonics: 1 }))).toBe("You carry 1 of 2");
+    expect(carriedText(undefined)).toBe("You carry 0 of 2");
+  });
+
+  it("words every purchase answer: bought with the gold and the count, and each refusal with nothing charged", () => {
+    const bought: TonicPurchaseMessage = { requestId: "b1", outcome: "bought", price: 30, tonics: 1, replayed: false };
+    expect(purchaseLine(bought)).toEqual({ text: "Bought a sail tonic (−30 gold): you carry 1 of 2", state: "bought" });
+    expect(purchaseLine(undefined)).toEqual({ text: "", state: "none" });
+    const refusals = {
+      busy: "Two requests are already waiting",
+      "not-in-play": "The shop is open only during the match",
+      "not-at-dock": "Moor at a dock to buy",
+      "player-in-duel": "Not during a duel",
+      "player-disconnected": "Not while disconnected",
+      "tonic-limit": "You already carry 2 tonics",
+      "insufficient-gold": "Not enough gold",
+    } as const;
+    for (const [reason, text] of Object.entries(refusals)) {
+      expect(purchaseLine({ requestId: "b", outcome: "refused", reason: reason as keyof typeof refusals, replayed: false })).toEqual({ text: `Sail tonic: ${text}, nothing charged`, state: reason });
+    }
+  });
+
+  it("words a drink's refusal for the HUD, and nothing once it works", () => {
+    expect(useLine(undefined)).toEqual({ text: "", state: "none" });
+    expect(useLine({ requestId: "t1", outcome: "active", endTick: 300, replayed: false })).toEqual({ text: "", state: "active" });
+    const refusals = {
+      busy: "Two requests are already waiting",
+      "not-in-play": "Only during the match",
+      "tonic-active": "One is already working",
+      "no-tonic": "You carry none: buy one at a dock (B)",
+      "not-at-sea": "Only at sea",
+      grappled: "Not while being grappled",
+      "player-in-duel": "Not during a duel",
+      "player-disconnected": "Not while disconnected",
+    } as const;
+    for (const [reason, text] of Object.entries(refusals)) {
+      expect(useLine({ requestId: "t", outcome: "refused", reason: reason as keyof typeof refusals, replayed: true })).toEqual({ text: `Tonic: ${text}`, state: reason });
+    }
+  });
+
+  it("lists the tonic and the journal's rumor buttons, and shows whichever answer came last", () => {
+    const rumors = [{ type: "sun", label: "Sun: Buy a rumor (25 gold)", state: "available", disabled: false }];
+    const tonic: TonicPurchaseMessage = { requestId: "b1", outcome: "refused", reason: "tonic-limit", replayed: false };
+    const rumor: RumorResultMessage = { requestId: "j1", type: "sun", outcome: "bought", price: 25, replayed: false };
+    const view = shopView(true, status({ tonics: 1, gold: 70 }), false, rumors, { kind: "tonic", result: tonic });
+    expect(view).toEqual({
+      hidden: false,
+      gold: "70 gold",
+      tonic: { state: "available", label: "Buy a sail tonic (30 gold)", disabled: false },
+      carried: "You carry 1 of 2",
+      rumors,
+      message: { text: "Sail tonic: You already carry 2 tonics, nothing charged", state: "tonic-limit" },
+    });
+    expect(shopView(true, status(), false, rumors, { kind: "rumor", result: rumor }).message).toEqual({ text: "Bought a rumor about Sun (−25 gold)", state: "bought" });
+    expect(shopView(false, undefined, false, [], undefined)).toMatchObject({ hidden: true, gold: "0 gold", message: { text: "", state: "none" } });
+  });
+});
+
+describe("the tonic's HUD", () => {
+  it("shows the count carried, and while a tonic works its seconds left (rounded up) and +10% speed, with the server's top speed", () => {
+    expect(tonicHud(status({ tonics: 1 }), 100)).toEqual({ carried: "1 of 2", timer: "", active: false, maxSpeed: 39 });
+    expect(tonicHud(status({ tonics: 0, tonicUntil: 340, maxSpeed: 43 }), 100)).toEqual({ carried: "0 of 2", timer: "Sail tonic: 12 s left · +10% speed", active: true, maxSpeed: 43 });
+    expect(tonicHud(status({ tonicUntil: 340, maxSpeed: 43 }), 319).timer).toBe("Sail tonic: 2 s left · +10% speed");
+    expect(tonicHud(status({ tonicUntil: 340, maxSpeed: 43 }), 339).timer).toBe("Sail tonic: 1 s left · +10% speed");
+    // On its last boosted tick the server already reports the next step's plain top speed: the timer is over.
+    expect(tonicHud(status({ tonicUntil: 340, maxSpeed: 39 }), 340)).toMatchObject({ timer: "", active: false, maxSpeed: 39 });
+    expect(tonicHud(undefined, 5)).toEqual({ carried: "0 of 2", timer: "", active: false, maxSpeed: 0 });
+  });
+});
+
+describe("the shop's behaviour (ShopPanel)", () => {
+  const panel = (rumorStatus: JournalStatus | undefined = journalStatus()) => {
+    const sent: [string, unknown][] = [];
+    const views: ShopView[] = [];
+    const focus: boolean[] = [];
+    // The journal the page runs: the shop's rumor buttons are its buttons, and its Buy is theirs.
+    const journal = new JournalPanel(
+      (type, message) => sent.push([type, message]),
+      () => undefined,
+      () => undefined,
+      () => undefined,
+      (island) => `Island ${island}`,
+    );
+    journal.update(rumorStatus, 10);
+    const shop = new ShopPanel(
+      (type, message) => sent.push([type, message]),
+      (view) => views.push(view),
+      (backwards) => focus.push(backwards),
+      {
+        get status() {
+          return journal.currentStatus;
+        },
+        get pendingType() {
+          return journal.pendingType;
+        },
+        buy: (type) => journal.buy(type),
+      },
+    );
+    return { shop, journal, sent, focus, last: () => views.at(-1)! };
+  };
+  const key = (code: string, repeat = false, shiftKey = false) => ({ code, repeat, shiftKey });
+
+  it("opens on B only where the ship is moored, closes on B or Escape, moves focus on Tab, and ignores B's auto-repeat", () => {
+    const { shop, focus, last } = panel();
+    shop.update(status({ moored: false }), 10);
+    expect(shop.keydown(key("KeyB"))).toBe(false);
+    expect(shop.isOpen).toBe(false);
+    shop.update(status(), 11);
+    expect(shop.keydown(key("KeyB"))).toBe(true);
+    expect(shop.isOpen).toBe(true);
+    expect(last().hidden).toBe(false);
+    expect(focus).toEqual([false]);
+    expect(shop.keydown(key("KeyB", true))).toBe(true);
+    expect(shop.isOpen).toBe(true);
+    expect(shop.keydown(key("Tab", false, true))).toBe(true);
+    expect(focus).toEqual([false, true]);
+    expect(shop.keydown(key("KeyW"))).toBe(false);
+    expect(shop.keydown(key("Escape"))).toBe(true);
+    expect(shop.isOpen).toBe(false);
+    // Closed, Escape and Tab are not its keys.
+    expect(shop.keydown(key("Escape"))).toBe(false);
+    expect(shop.keydown(key("Tab"))).toBe(false);
+    shop.keydown(key("KeyB"));
+    shop.keydown(key("KeyB"));
+    expect(shop.isOpen).toBe(false);
+  });
+
+  it("is no safe zone: casting off or a grapple (the status leaves the dock) closes it", () => {
+    const { shop, last } = panel();
+    shop.update(status(), 10);
+    shop.toggle();
