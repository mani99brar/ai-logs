+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { isNavigable, seaMap } from "@pirate-sea-race/content";
+import { ShopMessageType } from "@pirate-sea-race/protocol";
+import { startGameServer, type MatchRoom, type RunningGameServer } from "@pirate-sea-race/server";
+import { defaultSimulationConfig, drinkTonic, hashState, step, type MatchState } from "@pirate-sea-race/simulation";
+import { checkLedger, findPlayer, objectiveRules } from "@pirate-sea-race/simulation/objectives";
+import { AHEAD, HeadlessClient, sleep } from "@pirate-sea-race/test-tools";
+import { placePair, tuned } from "./rubbingsSetup.js";
+import { dockFor, EAST, HOLD_E, HUB_X, NORTH, OPEN_ROW, openWater, playersAt, roomOf, startThroughLobby, tracker, until, WEST, type Seat } from "./seaDuelSetup.js";
+
+/**
+ * §11's economy through the real room: the supply crates at sea, the dockside shop's sail tonic (and its rumor, the
+ * journal's purchase), and the tonic's speed. Players drive it as a browser does: they sail with the helm, moor with E,
+ * send `buy-tonic` and `use-tonic` with their request ids. Every player starts with the rules' 50 gold; a tonic costs 30,
+ * a crate pays 25. The rooms check `checkLedger` (the gold identity among it) and their own invariant after every world
+ * tick, and that the ledger refused nothing the room asked (`tracker`). Cases that need one exact tick hold the clock
+ * with the room's test hooks (`pauseAfterTick`, `stepWorldTicks`).
+ */
+let server: RunningGameServer;
+let endpoint: string;
+
+beforeAll(async () => {
+  server = await startGameServer({
+    port: 0,
+    host: "127.0.0.1",
+    handleSignals: false,
+    testPlacement: true,
+    matchTuning: tuned({ objectives: { ...objectiveRules, collectTicks: 20, cacheClaimTicks: 20 }, testHooks: true }),
+  });
+  endpoint = `http://127.0.0.1:${server.port}`;
+});
+
+afterAll(async () => {
+  await server.close();
+});
+
+const PRICE = objectiveRules.tonicPrice;
+const CRATE_GOLD = objectiveRules.supplyCacheGold;
+const TONIC_TICKS = objectiveRules.tonicTicks;
+const START = objectiveRules.startingGold;
+/** Somewhere on the open row south of the hub, out of every crate's sight. */
+const ROW: Seat = { tileX: HUB_X - 6, tileY: OPEN_ROW, heading: EAST };
+
+const goldOf = (room: MatchRoom, id: string) => findPlayer(room.ledgerState, id)!.gold;
+const tonicsOf = (room: MatchRoom, id: string) => findPlayer(room.ledgerState, id)!.tonics;
+const supplyGrants = (room: MatchRoom) => room.ledgerState.grants.filter((grant) => grant.reason === "supply-cache");
+
+/** A crate's site and a seat three tiles west of it, facing it along clear water. */
+function crateSeat(room: MatchRoom, index: number): { crate: { id: string; x: number; y: number; tileX: number; tileY: number }; seat: Seat } {
+  const crate = room.crateSites[index]!;
+  const seat = { tileX: crate.tileX - 3, tileY: crate.tileY, heading: EAST };
+  expect(openWater(seat, { ...crate, heading: EAST })).toBe(true);
+  return { crate, seat };
+}
+
+/** Sails a ship over a crate from three tiles west of it until it has the crate's gold. */
+async function takeCrate(client: HeadlessClient, index: number): Promise<void> {
+  const room = roomOf(client);
+  const before = goldOf(room, client.sessionId);
+  await client.placeShip(endpoint, crateSeat(room, index).seat);
+  await client.holdUntil(AHEAD, () => goldOf(room, client.sessionId) === before + CRATE_GOLD, 5000);
+}
