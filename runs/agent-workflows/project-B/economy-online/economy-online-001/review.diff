+ * claimed one out of every view, so it is drawn no more. Returns what it drew, in canvas pixels, for the scene's report.
+ */
+export function drawCrates(pen: CratePen, crates: readonly CrateSnapshot[], scroll: { x: number; y: number }): DrawnCrate[] {
+  return crates.map((crate) => {
+    const { x, y } = worldPixels(crate);
+    pen.crate(x, y, CRATE_HALF);
+    return { id: crate.id, x: Math.round(x - scroll.x), y: Math.round(y - scroll.y) };
+  });
+}
