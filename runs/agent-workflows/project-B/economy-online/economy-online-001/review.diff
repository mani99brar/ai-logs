+import { describe, expect, it } from "vitest";
+import { isNavigable, keepClearZones, seaMap, seaPathCosts } from "@pirate-sea-race/content";
+import { defaultSimulationConfig, hullIsClear } from "@pirate-sea-race/simulation";
+import { addPlayer, checkLedger, grantGold, objectiveRules } from "@pirate-sea-race/simulation/objectives";
+import { createMatchLedger } from "./objectives.js";
+import { CRATE_HALF_SIZE, CRATE_KEEP_CLEAR_TILES, CRATE_SPACING_TILES, crateClaims, SUPPLY_CRATE_COUNT, supplySites, touchesCrate } from "./supply.js";
+
+const HULL = defaultSimulationConfig.ship.hullHalfSize;
+const distance = (a: { tileX: number; tileY: number }, b: { tileX: number; tileY: number }) => Math.hypot(a.tileX - b.tileX, a.tileY - b.tileY);
+
+describe("the supply crates' sites (supplySites)", () => {
+  const sites = supplySites(seaMap);
+
+  it("puts 4 crates on navigable sea, a hull fitting at each, reachable by sea from the hub, with fixed ids", () => {
+    expect(sites).toHaveLength(SUPPLY_CRATE_COUNT);
+    expect(sites.map((site) => site.id)).toEqual(["crate-0", "crate-1", "crate-2", "crate-3"]);
+    const fromHub = seaPathCosts(seaMap, seaMap.hub.tileX, seaMap.hub.tileY);
+    for (const site of sites) {
+      expect(isNavigable(seaMap, site.tileX, site.tileY)).toBe(true);
+      expect(hullIsClear(defaultSimulationConfig, site.x, site.y)).toBe(true);
+      expect(fromHub[site.tileY * seaMap.widthTiles + site.tileX]!).toBeLessThan(Number.MAX_SAFE_INTEGER);
+      expect(site.x).toBe(site.tileX * seaMap.subUnitsPerTile + seaMap.subUnitsPerTile / 2);
+      expect(site.y).toBe(site.tileY * seaMap.subUnitsPerTile + seaMap.subUnitsPerTile / 2);
+    }
+  });
+
+  it("spaces them well: at least 20 tiles apart, and 5 from every dock, spawn slot, the hub and the tests' lanes", () => {
+    for (const [index, site] of sites.entries()) {
+      for (const other of sites.slice(index + 1)) expect(distance(site, other)).toBeGreaterThanOrEqual(CRATE_SPACING_TILES);
+      for (const zone of keepClearZones(seaMap)) for (const tile of zone.tiles) expect(distance(site, tile), zone.label).toBeGreaterThanOrEqual(CRATE_KEEP_CLEAR_TILES);
+      for (const dock of seaMap.docks) expect(distance(site, dock)).toBeGreaterThanOrEqual(CRATE_KEEP_CLEAR_TILES);
+      for (const slot of seaMap.spawnSlots) expect(distance(site, slot)).toBeGreaterThanOrEqual(CRATE_KEEP_CLEAR_TILES);
+    }
+  });
+
+  it("puts one on each island's route to the hub (every crossing runs through it), near halfway, mirrored like the sea", () => {
+    const fromHub = seaPathCosts(seaMap, seaMap.hub.tileX, seaMap.hub.tileY);
+    for (const [island, site] of sites.entries()) {
+      expect(site.island).toBe(island);
+      const docks = seaMap.docks.filter((dock) => dock.island === island);
+      const route = Math.min(...docks.map((dock) => fromHub[dock.tileY * seaMap.widthTiles + dock.tileX]!));
+      const fromDock = Math.min(...docks.map((dock) => seaPathCosts(seaMap, dock.tileX, dock.tileY)[site.tileY * seaMap.widthTiles + site.tileX]!));
+      const toHub = fromHub[site.tileY * seaMap.widthTiles + site.tileX]!;
+      expect(fromDock + toHub).toBeLessThanOrEqual(route * 1.15);
+      expect(Math.abs(fromDock - toHub)).toBeLessThan(route / 3);
+    }
+    // The browser scenario `shop-and-tonic` sails over the first one here (tests/e2e/shop.spec.ts).
+    expect([sites[0]!.id, sites[0]!.tileX, sites[0]!.tileY]).toEqual(["crate-0", 39, 41]);
+    const last = seaMap.widthTiles - 1;
+    expect(sites.map((site) => [site.tileX, site.tileY])).toEqual([
+      [sites[0]!.tileX, sites[0]!.tileY],
+      [last - sites[0]!.tileX, sites[0]!.tileY],
+      [sites[0]!.tileX, last - sites[0]!.tileY],
+      [last - sites[0]!.tileX, last - sites[0]!.tileY],
+    ]);
+  });
+
+  it("is the same every call (cached per map), and throws when an island's route has no room", () => {
+    expect(supplySites(seaMap)).toEqual(sites);
+    expect(supplySites(seaMap)).not.toBe(supplySites(seaMap));
+    expect(supplySites(seaMap, 2)).toEqual(sites.slice(0, 2));
+    expect(() => supplySites(seaMap, 5)).toThrow(/no island 4/);
+    // The spacing binds: 32 tiles apart suits 30, but with 60 the second route has no tile far enough from the first.
+    expect(supplySites(seaMap, 2, 30).map((site) => [site.tileX, site.tileY])).toEqual(sites.slice(0, 2).map((site) => [site.tileX, site.tileY]));
+    expect(() => supplySites(seaMap, 2, 60)).toThrow(/no room for a supply crate on island 1/);
+    const cramped = { ...seaMap, docks: seaMap.docks.map((dock) => ({ ...dock })) };
+    // A crate must keep 20 tiles from the others, which a single tile of sea cannot give twice.
+    expect(() => supplySites({ ...cramped, spawnSlots: [...cramped.spawnSlots, ...Array.from({ length: 111 }, (_, row) => Array.from({ length: 111 }, (_, column) => ({ tileX: column, tileY: row, facing: "E" as const }))).flat()] })).toThrow(/no room/);
+  });
+});
+
+describe("touching a crate (touchesCrate, crateClaims)", () => {
+  const site = { id: "crate-0", island: 0, tileX: 10, tileY: 10, x: 2688, y: 2688 };
+  const reach = HULL + CRATE_HALF_SIZE;
+
+  it("counts a hull overlapping the crate's square, edge included", () => {
+    expect(touchesCrate(site, { x: site.x + reach, y: site.y - reach }, HULL)).toBe(true);
+    expect(touchesCrate(site, { x: site.x + reach + 1, y: site.y }, HULL)).toBe(false);
+    expect(touchesCrate(site, { x: site.x, y: site.y - reach - 1 }, HULL)).toBe(false);
+  });
+
+  it("gives each unclaimed crate to the lowest player id touching it, whatever the ships' order, and none to a claimed one", () => {
+    const other = { ...site, id: "crate-1", x: site.x + 5000 };
+    const ships = [
+      { id: "zed", x: site.x, y: site.y },
+      { id: "amy", x: site.x + 10, y: site.y },
+      { id: "bob", x: other.x, y: other.y },
+      { id: "cat", x: 0, y: 0 },
+    ];
+    expect(crateClaims([site, other], new Set(), ships, HULL)).toEqual([
+      { crateId: "crate-0", playerId: "amy" },
+      { crateId: "crate-1", playerId: "bob" },
+    ]);
+    expect(crateClaims([site, other], new Set(["crate-0"]), ships, HULL)).toEqual([{ crateId: "crate-1", playerId: "bob" }]);
+    expect(crateClaims([site], new Set(), [ships[3]!], HULL)).toEqual([]);
+    // One ship touching two crates takes both.
+    expect(crateClaims([site, { ...other, x: site.x + 100 }], new Set(), [ships[0]!], HULL)).toEqual([
+      { crateId: "crate-0", playerId: "zed" },
+      { crateId: "crate-1", playerId: "zed" },
+    ]);
+  });
+
+  it("is a supply cache the match's ledger knows: 25 gold once, for the first claimer only, and no other key mints", () => {
+    const ids = supplySites(seaMap).map((each) => each.id);
+    let ledger = createMatchLedger({ map: seaMap, seed: 1, rules: objectiveRules, supplyCaches: ids });
+    for (const playerId of ["a", "b"]) ledger = addPlayer(ledger, { playerId, tick: 0 }).state;
+    const first = grantGold(ledger, { playerId: "a", reason: "supply-cache", sourceKey: "crate-2", tick: 1 });
+    expect(first.result).toMatchObject({ ok: true, grant: { amount: 25 } });
+    expect(grantGold(first.state, { playerId: "b", reason: "supply-cache", sourceKey: "crate-2", tick: 1 }).result.rejection).toBe("already-claimed");
+    expect(grantGold(first.state, { playerId: "b", reason: "supply-cache", sourceKey: "crate-9", tick: 1 }).result.rejection).toBe("unknown-source");
+    expect(checkLedger(first.state)).toEqual([]);
+    expect(createMatchLedger({ map: seaMap, seed: 1, rules: objectiveRules }).supplyCaches).toEqual([]);
+    expect(createMatchLedger({ map: seaMap, seed: 1, rules: objectiveRules, layout: [["sun", "sun"], ["moon", "moon"], ["sun", "sun"], ["moon", "moon"]], supplyCaches: ids }).supplyCaches).toEqual(ids);
