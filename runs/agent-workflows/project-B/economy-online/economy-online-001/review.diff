+import { describe, expect, it } from "vitest";
+import { objectiveRules } from "@pirate-sea-race/content/objectives";
+import { JournalMessageType, ShopMessageType, type RumorResultMessage, type TonicPurchaseMessage } from "@pirate-sea-race/protocol";
