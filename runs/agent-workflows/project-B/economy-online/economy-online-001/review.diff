+import { describe, expect, it } from "vitest";
+import {
+  MAX_SHOP_MESSAGE_BYTES,
+  parseTonicPurchaseMessage,
+  parseTonicUsedMessage,
+  PROTOCOL_VERSION,
+  ShopMessageType,
+  validateBuyTonicMessage,
+  validateUseTonicMessage,
+  WORLD_HOLD_BUTTONS,
+  WORLD_HOLD_GRACE_FRAMES,
+  Buttons,
+  INPUT_HOLD_FRAMES,
+} from "./index.js";
+
+describe("protocol v11 (the shop and the sail tonic)", () => {
+  it("is version 11, with the shop's message names and the world hold grace", () => {
+    expect(PROTOCOL_VERSION).toBe(11);
+    expect(ShopMessageType).toEqual({ BuyTonic: "buy-tonic", TonicPurchase: "tonic-purchase", UseTonic: "use-tonic", TonicUsed: "tonic-used" });
+    expect(WORLD_HOLD_GRACE_FRAMES).toBe(45);
+    expect(WORLD_HOLD_GRACE_FRAMES).toBeGreaterThan(INPUT_HOLD_FRAMES);
+    expect(WORLD_HOLD_BUTTONS).toBe(Buttons.Interact | Buttons.Fruit);
+  });
+
+  it("accepts a request id of 1–32 letters, digits, - or _, and nothing else", () => {
+    for (const validate of [validateBuyTonicMessage, validateUseTonicMessage]) {
+      expect(validate({ requestId: "b1" })).toEqual({ requestId: "b1" });
+      expect(validate({ requestId: "a".repeat(32) })).toEqual({ requestId: "a".repeat(32) });
+      for (const bad of [{ requestId: "" }, { requestId: "a".repeat(33) }, { requestId: "bad id" }, { requestId: "b1", item: "tonic" }, { requestId: 5 }, {}, "b1", null, undefined]) {
+        expect(validate(bad)).toBeUndefined();
+      }
+      // Too large to read at all (and every accepted one is well under the cap).
+      expect(validate({ requestId: "b1", pad: "x".repeat(MAX_SHOP_MESSAGE_BYTES) })).toBeUndefined();
+      expect(JSON.stringify({ requestId: "a".repeat(32) }).length).toBeLessThan(MAX_SHOP_MESSAGE_BYTES);
+      const cyclic: Record<string, unknown> = { requestId: "c" };
+      cyclic["self"] = cyclic;
+      expect(validate(cyclic)).toBeUndefined();
+    }
+  });
+
+  it("parses the answers strictly: a purchase bought or refused, a drink active or refused, with known reasons", () => {
+    expect(parseTonicPurchaseMessage({ requestId: "b1", outcome: "bought", price: 30, tonics: 1, replayed: false })).toBeDefined();
+    expect(parseTonicPurchaseMessage({ requestId: "b1", outcome: "refused", reason: "tonic-limit", replayed: true })).toBeDefined();
+    expect(parseTonicPurchaseMessage({ requestId: "b1", outcome: "refused", reason: "grappled", replayed: true })).toBeUndefined();
+    expect(parseTonicPurchaseMessage({ requestId: "b1", outcome: "bought", price: 30, tonics: 1, replayed: false, gold: 20 })).toBeUndefined();
+    expect(parseTonicUsedMessage({ requestId: "t1", outcome: "active", endTick: 250, replayed: false })).toBeDefined();
+    expect(parseTonicUsedMessage({ requestId: "t1", outcome: "refused", reason: "grappled", replayed: false })).toBeDefined();
+    expect(parseTonicUsedMessage({ requestId: "t1", outcome: "refused", reason: "tonic-limit", replayed: false })).toBeUndefined();
+    expect(parseTonicUsedMessage({ requestId: "t1", outcome: "active", endTick: 250, replayed: false, x: 5 })).toBeUndefined();
+  });
+});
