+    shop.update(status({ moored: false }), 11);
+    expect(shop.isOpen).toBe(false);
+    expect(last().hidden).toBe(true);
+    shop.update(status(), 12);
+    shop.toggle();
+    shop.update(undefined, 13);
+    expect(shop.isOpen).toBe(false);
+  });
+
+  it("sends buy-tonic with a fresh id from an available button only, holds it until the answer, and shows the answer", () => {
