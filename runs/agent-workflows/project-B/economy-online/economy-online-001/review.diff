+/** Places a ship on a dock's tile and holds E until it is moored there. */
+async function moor(client: HeadlessClient, dock: { id: number; tileX: number; tileY: number } = dockFor("sun")): Promise<void> {
+  await client.placeShip(endpoint, { tileX: dock.tileX, tileY: dock.tileY, heading: 0 });
+  await client.holdUntil(HOLD_E, () => client.ship()?.dock === dock.id, 5000);
+}
+
+/** Sends a tonic purchase (a fresh id unless given) and resolves with its answer (the latest, for a retried id). */
+async function buy(client: HeadlessClient, requestId?: string) {
+  const id = client.buyTonic(requestId);
+  const before = client.tonicPurchaseAnswers(id).length;
+  await client.waitFor(() => client.tonicPurchaseAnswers(id).length > before, 3000);
+  return client.tonicPurchaseAnswers(id).at(-1)!;
+}
+
+/** Sends a drink request (a fresh id unless given) and resolves with its answer. */
+async function drink(client: HeadlessClient, requestId?: string) {
+  const id = client.useTonic(requestId);
+  const before = client.tonicUseAnswers(id).length;
+  await client.waitFor(() => client.tonicUseAnswers(id).length > before, 3000);
+  return client.tonicUseAnswers(id).at(-1)!;
+}
+
+/** Holds the room's clock after the current world tick. */
+async function pause(room: MatchRoom): Promise<void> {
+  room.pauseAfterTick(room.matchState.worldTick);
+  await until(() => room.worldPaused, 2000, "the pause");
+}
