import { z } from "zod";
import { encodedSize } from "./input.js";

/**
 * The dockside shop and the sail tonic (protocol v11, §11 and §16). Moored at a dock a player buys a sail tonic (30
 * gold, at most two carried); the targeted rumor on the same shelf is the journal's `buy-rumor`. At sea, T drinks one
 * (`use-tonic`): +10 % top speed for 12 s. Each request carries the client's request id, and the server answers every
 * id once: a retry of an id it already decided gets the same answer again (`replayed`), never a second charge or a
 * second drink. Ids are per player. Answers go to the sender only; a player's gold and tonics travel in their own
 * private status.
 */
export const ShopMessageType = {
  /** Client → server: buy one sail tonic (`BuyTonicMessage`). */
  BuyTonic: "buy-tonic",
  /** Server → client: the answer to one tonic purchase, to its sender only (`TonicPurchaseMessage`). */
  TonicPurchase: "tonic-purchase",
  /** Client → server: drink one carried tonic now, one message per key press (`UseTonicMessage`). */
  UseTonic: "use-tonic",
  /** Server → client: the answer to one drink request, to its sender only (`TonicUsedMessage`). */
  TonicUsed: "tonic-used",
} as const;

/** The largest shop request accepted, measured as its JSON encoding. A valid one is under 50 bytes. */
export const MAX_SHOP_MESSAGE_BYTES = 64;
/** Shop requests (purchases and drinks together) a client may send per second before the server drops the rest. */
export const MAX_SHOP_MESSAGES_PER_SECOND = 8;

const requestIdSchema = z.string().regex(/^[A-Za-z0-9_-]{1,32}$/);

/** §11: buy one sail tonic. The server checks the mooring, the gold and the carry limit on the tick it decides it. */
export const buyTonicMessageSchema = z.strictObject({ requestId: requestIdSchema });
export type BuyTonicMessage = z.infer<typeof buyTonicMessageSchema>;

/** §11: drink one sail tonic now. It is a message, not a held button: one per key press. */
export const useTonicMessageSchema = z.strictObject({ requestId: requestIdSchema });
export type UseTonicMessage = z.infer<typeof useTonicMessageSchema>;

function validate<T>(schema: z.ZodType<T>, message: unknown): T | undefined {
  const size = encodedSize(message);
  if (size === undefined || size > MAX_SHOP_MESSAGE_BYTES) return undefined;
  const parsed = schema.safeParse(message);
  return parsed.success ? parsed.data : undefined;
}

/** Validates an untrusted tonic purchase: its size, then its schema. */
export function validateBuyTonicMessage(message: unknown): BuyTonicMessage | undefined {
  return validate(buyTonicMessageSchema, message);
}

/** Validates an untrusted drink request: its size, then its schema. */
export function validateUseTonicMessage(message: unknown): UseTonicMessage | undefined {
  return validate(useTonicMessageSchema, message);
}

/**
 * Why a tonic purchase was refused, charging nothing: `busy` (two requests already wait), `not-in-play`, `not-at-dock`
 * (the ship was not moored at a dock on the tick it was decided), and the ledger's `player-in-duel`,
 * `player-disconnected`, `tonic-limit` (two already carried) and `insufficient-gold`.
 */
export const TONIC_PURCHASE_REFUSAL_NAMES = ["busy", "not-in-play", "not-at-dock", "player-in-duel", "player-disconnected", "tonic-limit", "insufficient-gold"] as const;
export type TonicPurchaseRefusalName = (typeof TONIC_PURCHASE_REFUSAL_NAMES)[number];

/** The answer to one tonic purchase: `bought` with its price and the tonics now carried, or `refused` with the reason. */
export const tonicPurchaseMessageSchema = z.discriminatedUnion("outcome", [
  z.strictObject({ requestId: z.string().min(1).max(32), outcome: z.literal("bought"), price: z.int().min(0), tonics: z.int().min(0), replayed: z.boolean() }),
  z.strictObject({ requestId: z.string().min(1).max(32), outcome: z.literal("refused"), reason: z.enum(TONIC_PURCHASE_REFUSAL_NAMES), replayed: z.boolean() }),
]);
export type TonicPurchaseMessage = z.infer<typeof tonicPurchaseMessageSchema>;

export function parseTonicPurchaseMessage(message: unknown): TonicPurchaseMessage | undefined {
  const parsed = tonicPurchaseMessageSchema.safeParse(message);
  return parsed.success ? parsed.data : undefined;
}

/**
 * Why a drink was refused (nothing spent): `busy`, `not-in-play`, and the ledger's `tonic-active` (one works already),
 * `no-tonic`, `not-at-sea` (moored, or waiting to respawn), `grappled` (the defender of a grapple in its windup),
 * `player-in-duel` (reserved, fighting or in the choice window) and `player-disconnected`.
 */
export const TONIC_USE_REFUSAL_NAMES = ["busy", "not-in-play", "tonic-active", "no-tonic", "not-at-sea", "grappled", "player-in-duel", "player-disconnected"] as const;
export type TonicUseRefusalName = (typeof TONIC_USE_REFUSAL_NAMES)[number];

/**
 * The answer to one drink request: `active` with the world tick of the effect's last boosted sailing step (drunk on
 * tick t, the steps of ticks t + 1 to t + 240 sail faster), or `refused` with the reason.
 */
export const tonicUsedMessageSchema = z.discriminatedUnion("outcome", [
  z.strictObject({ requestId: z.string().min(1).max(32), outcome: z.literal("active"), endTick: z.int().min(0), replayed: z.boolean() }),
  z.strictObject({ requestId: z.string().min(1).max(32), outcome: z.literal("refused"), reason: z.enum(TONIC_USE_REFUSAL_NAMES), replayed: z.boolean() }),
]);
export type TonicUsedMessage = z.infer<typeof tonicUsedMessageSchema>;

export function parseTonicUsedMessage(message: unknown): TonicUsedMessage | undefined {
  const parsed = tonicUsedMessageSchema.safeParse(message);
  return parsed.success ? parsed.data : undefined;
}
