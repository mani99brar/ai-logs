describe("the fruit panel's behaviour (FruitPanel)", () => {
  const panel = () => {
    const sent: [string, unknown][] = [];
    const views: FruitPanelView[] = [];
    const fruit = new FruitPanel(
      (type, message) => sent.push([type, message]),
      (view) => views.push(view),
    );
    return { fruit, sent, views, last: () => views.at(-1)! };
  };
  const key = (code: string, repeat = false) => ({ code, repeat });

  it("sends an inspection on F where the HUD offers one, and opens on the answer", () => {
    const { fruit, sent, last } = panel();
    // Nothing at sea.
    fruit.update(status({ pedestal: "" }), 10);
    expect(fruit.keydown(key("KeyF"))).toBe(false);
    expect(sent).toEqual([]);
    fruit.update(status(), 11);
    expect(fruit.keydown(key("KeyF", true))).toBe(false);
    expect(fruit.keydown(key("KeyR"))).toBe(false);
    expect(fruit.keydown(key("KeyF"))).toBe(true);
    expect(sent).toEqual([[FruitMessageType.Inspect, {}]]);
    expect(fruit.isOpen).toBe(false);
    // A reply that is not one is ignored; the real one opens the panel.
    fruit.inspected({ island: 0, full: true, kit: "duelist" });
    expect(fruit.isOpen).toBe(false);
    fruit.inspected(ember);
    expect(fruit.isOpen).toBe(true);
    expect(last()).toMatchObject({ hidden: false, name: "Ember" });
    // A malformed reply while open changes nothing.
    fruit.inspected({ island: 0 });
    expect(fruit.isOpen).toBe(true);
    expect(last()).toMatchObject({ hidden: false, name: "Ember" });
  });

  it("holds the input's fruit button while F is held with the panel open, until F is released or the window blurs", () => {
    const { fruit } = panel();
    fruit.update(status(), 1);
    expect(fruit.buttons()).toBe(0);
    fruit.keydown(key("KeyF"));
    expect(fruit.buttons()).toBe(0);
    fruit.inspected(ember);
    // The press that inspected does not eat; the next one, held, does.
    expect(fruit.buttons()).toBe(0);
    expect(fruit.keydown(key("KeyF"))).toBe(true);
    expect(fruit.buttons()).toBe(Buttons.Fruit);
    expect(fruit.keydown(key("KeyF", true))).toBe(true);
    fruit.keyup("KeyE");
    expect(fruit.buttons()).toBe(Buttons.Fruit);
    fruit.keyup("KeyF");
    expect(fruit.buttons()).toBe(0);
    fruit.keydown(key("KeyF"));
    fruit.blur();
    expect(fruit.buttons()).toBe(0);
  });

  it("closes on Escape, and when the player is no longer at a pedestal (casting off, a duel)", () => {
    const { fruit, last } = panel();
    fruit.update(status(), 1);
    fruit.inspected(ember);
    fruit.keydown(key("KeyF"));
    expect(fruit.keydown(key("Escape"))).toBe(true);
    expect(fruit.isOpen).toBe(false);
    expect(fruit.buttons()).toBe(0);
    expect(last().hidden).toBe(true);
    expect(fruit.keydown(key("Escape"))).toBe(false);
    fruit.inspected(ember);
    fruit.update(status({ pedestal: "empty" }), 2);
    expect(fruit.isOpen).toBe(true);
    fruit.update(status({ pedestal: "" }), 3);
    expect(fruit.isOpen).toBe(false);
  });

  it("never starts eating on the auto-repeat of the F press that opened it; a fresh press does, and a repeat then keeps it held", () => {
    const { fruit } = panel();
    fruit.update(status(), 10);
    fruit.keydown(key("KeyF"));
    fruit.inspected(ember);
    // F still down: the browser repeats it. The panel takes the key, but holds nothing.
    expect(fruit.keydown(key("KeyF", true))).toBe(true);
    expect(fruit.keydown(key("KeyF", true))).toBe(true);
    expect(fruit.buttons()).toBe(0);
    fruit.keyup("KeyF");
    // A fresh press holds it; its own repeats keep it held.
    fruit.keydown(key("KeyF"));
    expect(fruit.buttons()).toBe(Buttons.Fruit);
    fruit.keydown(key("KeyF", true));
    expect(fruit.buttons()).toBe(Buttons.Fruit);
  });

  it("stays open long enough to say why eating stopped when a duel or casting off took the player from the pedestal, then closes", () => {
    for (const [result, text] of [
      ["interrupted:reserved", "A duel interrupted your meal"],
      ["interrupted:released", "You cast off: eating stopped"],
    ] as const) {
      const { fruit, last } = panel();
      fruit.update(status(), 10);
      fruit.inspected(ember);
      fruit.keydown(key("KeyF"));
      fruit.update(status({ fruitHeld: 20 }), 30);
      // The reason and the pedestal's absence arrive together (the room writes both on one tick).
      fruit.update(status({ pedestal: "", fruitResult: result, fruitResultAt: 31 }), 31);
      expect(fruit.isOpen).toBe(true);
      expect(last()).toMatchObject({ hidden: false, message: { text } });
      // Holding F is over, and F away from the pedestal holds nothing.
      expect(fruit.buttons()).toBe(0);
      fruit.keydown(key("KeyF"));
      expect(fruit.buttons()).toBe(0);
      fruit.update(status({ pedestal: "", fruitResult: result, fruitResultAt: 31 }), 31 + FRUIT_LINGER_TICKS - 1);
      expect(fruit.isOpen).toBe(true);
      fruit.update(status({ pedestal: "", fruitResult: result, fruitResultAt: 31 }), 31 + FRUIT_LINGER_TICKS);
      expect(fruit.isOpen).toBe(false);
      expect(last().hidden).toBe(true);
    }
    // An old interruption, from before the panel opened, does not keep it up.
    const { fruit } = panel();
    fruit.update(status({ fruitResult: "interrupted:released", fruitResultAt: 5 }), 10);
    fruit.inspected(ember);
    fruit.update(status({ pedestal: "", fruitResult: "interrupted:released", fruitResultAt: 5 }), 11);
    expect(fruit.isOpen).toBe(false);
    expect(lingers(status({ fruitResult: "refused:empty", fruitResultAt: 11 }), 10, 11)).toBe(false);
  });

  it("shows only results from after it opened, and keeps its opening tick across a second inspection", () => {
    const { fruit, last } = panel();
    fruit.update(status({ fruitResult: "interrupted:released", fruitResultAt: 5 }), 10);
    fruit.inspected(ember);
    expect(last().message.state).toBe("none");
    fruit.update(status({ fruitResult: "interrupted:taken", fruitResultAt: 11 }), 12);
    fruit.inspected({ island: 0, full: false });
    expect(last()).toMatchObject({ full: false, message: { state: "interrupted:taken" } });
  });
});

describe("the match page's panel keys", () => {
  const recording = (open: boolean, takes: boolean) => {
    const seen: string[] = [];
    const keyPanel: KeyPanel = {
      isOpen: open,
      keydown: (event) => {
        seen.push(event.code);
        return takes;
      },
    };
    return { keyPanel, seen };
  };
  const event = (code: string, target: unknown = {}) => ({ code, repeat: false, target: target as EventTarget });
  /** The journal, closed and taking none of these keys (its own routing is `journal.test.ts`'s). */
  const journal = recording(false, false).keyPanel;
  /** The shop, closed and taking none of these keys (its own routing is `shop.test.ts`'s). */
  const shop = recording(false, false).keyPanel;

  it("skips a key typed into a text field, for the ruin panel as for the fruit panel", () => {
    for (const tagName of ["INPUT", "TEXTAREA"]) {
      const ruins = recording(false, true);
      const fruit = recording(false, true);
      expect(panelKeydown(event("KeyR", { tagName }), { ruins: ruins.keyPanel, fruit: fruit.keyPanel, journal, shop })).toBe(false);
      expect(panelKeydown(event("KeyF", { tagName }), { ruins: ruins.keyPanel, fruit: fruit.keyPanel, journal, shop })).toBe(false);
      expect([ruins.seen, fruit.seen]).toEqual([[], []]);
    }
    // The same keys aimed at the page (a button, the body) reach the panels.
    const ruins = recording(false, true);
    expect(panelKeydown(event("KeyR", { tagName: "BUTTON" }), { ruins: ruins.keyPanel, fruit: recording(false, false).keyPanel, journal, shop })).toBe(true);
    expect(ruins.seen).toEqual(["KeyR"]);
  });

  it("gives a key to one panel at a time: the ruin panel first, the fruit panel when the ruin's did not take it", () => {
    const panels = (ruinsOpen: boolean, ruinsTakes: boolean, fruitOpen: boolean, fruitTakes: boolean) => {
      const ruins = recording(ruinsOpen, ruinsTakes);
      const fruit = recording(fruitOpen, fruitTakes);
      return { ruins, fruit, taken: panelKeydown(event("KeyF"), { ruins: ruins.keyPanel, fruit: fruit.keyPanel, journal, shop }) };
    };
    // Both closed: the ruin panel does not take F, the fruit panel does.
    const closed = panels(false, false, false, true);
    expect([closed.taken, closed.ruins.seen, closed.fruit.seen]).toEqual([true, ["KeyF"], ["KeyF"]]);
    // The ruin panel took the key: the fruit panel never hears it.
    const ruinTook = panels(false, true, false, true);
    expect([ruinTook.taken, ruinTook.fruit.seen]).toEqual([true, []]);
    // The fruit panel open: the ruin panel never hears the key (R opens no ruin over it).
    const fruitOpen = panels(false, true, true, true);
    expect([fruitOpen.taken, fruitOpen.ruins.seen, fruitOpen.fruit.seen]).toEqual([true, [], ["KeyF"]]);
    // The ruin panel open and not taking the key: the fruit panel does not hear it either.
    const ruinOpen = panels(true, false, false, true);
    expect([ruinOpen.taken, ruinOpen.fruit.seen]).toEqual([false, []]);
  });
});

describe("the pedestals on the sea (§9, §16)", () => {
  it("draws each pedestal in sight beside its dock, with its fruit while full, and reports it", () => {
    const view = new MatchView("me");
    view.ingestPedestals([
      { island: 3, x: 3000, y: 4000, full: false },
      { island: 0, x: 1000, y: 2000, full: true },
    ]);
    expect(view.pedestals().map((pedestal) => pedestal.island)).toEqual([0, 3]);
    const drawn: string[] = [];
    const reported = drawPedestals(
      { stone: (x, y, half) => drawn.push(`stone ${x},${y} ${half}`), fruit: (x, y, radius) => drawn.push(`fruit ${x},${y} ${radius}`) },
      view.pedestals(),
      { x: 10, y: 20 },
    );
    const at = worldPixels({ x: 1000, y: 2000 });
    const empty = worldPixels({ x: 3000, y: 4000 });
    // The full one gets its fruit on top of its stone; the empty one only its stone.
    expect(drawn).toEqual([
      `stone ${at.x + PEDESTAL_OFFSET},${at.y - PEDESTAL_OFFSET} ${PEDESTAL_HALF}`,
      `fruit ${at.x + PEDESTAL_OFFSET},${at.y - PEDESTAL_OFFSET - PEDESTAL_HALF} ${PEDESTAL_HALF * 0.8}`,
      `stone ${empty.x + PEDESTAL_OFFSET},${empty.y - PEDESTAL_OFFSET} ${PEDESTAL_HALF}`,
    ]);
    expect(reported[0]).toEqual({ x: Math.round(at.x + PEDESTAL_OFFSET - 10), y: Math.round(at.y - PEDESTAL_OFFSET - 20), island: 0, full: true });
  });
});

/** Runs a duel from the kits' frame-0 state with `[frame, p1, p2]` presses (frames from 1). */
function trace(kits: readonly [KitId, KitId], frames: number, ...presses: readonly (readonly [number, number, number])[]): DuelState[] {
  const inputs: DuelInputs[] = Array.from({ length: frames }, () => [0, 0] as const);
  for (const [frame, p1, p2] of presses) inputs[frame - 1] = [p1, p2];
  return traceDuel(config, createDuelState(config, { kits }), inputs);
}

describe("the arena's drawing (§9: what the renderer must show)", () => {
  it("draws the flame bolt as a moving sprite from its release, never the cast's box as a threat", () => {
    const cast = findMove(config.moveset, "flame-bolt-cast");
    expect(strikesWithHitbox(cast)).toBe(false);
    const states = trace(["ember", "duelist"], 60, [1, I("special1"), 0]);
    const released = states.findIndex((state) => state.fighters[0].bolt !== null);
    expect(released).toBe(cast.timing.startup + 1);
    const first = arenaDrawing(config, states[released]!);
    const later = arenaDrawing(config, states[released + 5]!);
    expect(first.bolts).toHaveLength(1);
    expect(first.bolts[0]!.owner).toBe(0);
    expect(first.bolts[0]!.box).toEqual(toCanvas(config, fighterTells(config, states[released]!.fighters[0]).bolt!));
    // It moves toward the opponent (player one starts on the left).
    expect(later.bolts[0]!.box.x).toBeGreaterThan(first.bolts[0]!.box.x);
    // The cast's active frames draw no threat.
    for (const state of states) expect(arenaDrawing(config, state).fighters[0].threat).toBeNull();
    expect(arenaDrawing(config, states[0]!).bolts).toEqual([]);
  });

  it("draws a striking move's active hitbox as a threat", () => {
    const jab = findMove(config.moveset, config.moveset.commands.light);
    expect(strikesWithHitbox(jab)).toBe(true);
    const states = trace(["duelist", "duelist"], 20, [1, I("light"), 0]);
    const threats = states.map((state) => arenaDrawing(config, state).fighters[0].threat !== null);
    expect(threats.filter(Boolean)).toHaveLength(jab.timing.active);
    const active = states.findIndex((state) => arenaDrawing(config, state).fighters[0].threat !== null);
    expect(arenaDrawing(config, states[active]!).fighters[0].threat).toEqual(toCanvas(config, fighterTells(config, states[active]!.fighters[0]).activeHitbox!));
  });

  it("draws the smoke screen as a zone, and an obscured fighter's startup as a generic flash with its move hidden", () => {
    const screen = findMove(config.moveset, "smoke-screen");
    const states = trace(["smoke", "duelist"], 60, [1, I("special2"), 0], [40, I("light"), 0]);
    const laid = states.findIndex((state) => state.fighters[0].zone !== null);
    expect(laid).toBe(screen.timing.startup + 1);
    const drawing = arenaDrawing(config, states[laid]!);
    expect(drawing.zones).toHaveLength(1);
    expect(drawing.zones[0]!.owner).toBe(0);
    expect(drawing.fighters[0].obscured).toBe(true);
    // The screen's own box never strikes.
    expect(states.every((state) => arenaDrawing(config, state).fighters[0].threat === null || state.frame > 40)).toBe(true);
    // The jab started inside the screen: a generic flash, its name hidden; the body and facing still drawn.
    const starting = states.findIndex((state, frame) => frame >= 40 && fighterTells(config, state.fighters[0]).startingUp);
    const obscured = arenaDrawing(config, states[starting]!).fighters[0];
    expect(obscured).toMatchObject({ obscured: true, startupFlash: true, startingUp: false, label: "…" });
    expect(obscured.body).toEqual(toCanvas(config, fighterTells(config, states[starting]!.fighters[0]).hurtbox));
    // Out of the smoke, the same startup shows the move.
    const clear = arenaDrawing(config, trace(["duelist", "duelist"], 2, [1, I("light"), 0])[1]!).fighters[0];
    expect(clear).toMatchObject({ obscured: false, startupFlash: false, startingUp: true });
    expect(clear.label).toMatch(/^Jab 1$/i);
  });

  it("draws the feint's readable reappearance", () => {
    const states = trace(["smoke", "duelist"], 40, [1, I("special1"), 0]);
    const reappearing = states.flatMap((state, frame) => (arenaDrawing(config, state).fighters[0].reappearing ? [frame] : []));
    expect(reappearing.length).toBeGreaterThan(0);
    expect(reappearing).toEqual(states.flatMap((state, frame) => (fighterTells(config, state.fighters[0]).reappearing ? [frame] : [])));
  });

  it("places boxes on the canvas with y down from the floor, and labels a crouching block as low", () => {
    expect(toCanvas(config, { x0: 0, x1: 32, y0: 0, y1: 32 })).toEqual({ x: 0, y: FLOOR - 32 / config.moveset.arena.subPixelsPerPixel, w: 2, h: 2 });
    const state = createDuelState(config);
    const crouching = { ...state, fighters: [{ ...state.fighters[0], action: "blockstun" as const, crouching: true }, state.fighters[1]] as const };
    expect(arenaDrawing(config, crouching as DuelState).fighters[0].label).toBe("blockstun (low)");
    const crouch = { ...state, fighters: [{ ...state.fighters[0], action: "crouch" as const, crouching: true }, state.fighters[1]] as const };
    expect(arenaDrawing(config, crouch as DuelState).fighters[0].label).toBe("crouch");
  });
});

describe("the arena's pen (§9's tells) and outlines", () => {
  const recordingPen = () => {
    const drawn: string[] = [];
    const at = (box: Rect) => `${Math.round(box.x)},${Math.round(box.y)}`;
    const pen: ArenaPen = {
      zone: (box) => drawn.push(`zone ${at(box)}`),
      bolt: (box) => drawn.push(`bolt ${at(box)}`),
      startupFlash: (body) => drawn.push(`flash ${at(body)}`),
      reappearance: (body) => drawn.push(`reappear ${at(body)}`),
    };
    return { pen, drawn };
  };

  it("draws a bolt, a smoke screen, an obscured startup's flash and a reappearance, and nothing for a plain fighter", () => {
    const quiet = recordingPen();
    drawTells(quiet.pen, arenaDrawing(config, createDuelState(config)));
    expect(quiet.drawn).toEqual([]);

    const bolt = trace(["ember", "duelist"], 30, [1, I("special1"), 0]).at(-1)!;
    const flying = recordingPen();
    drawTells(flying.pen, arenaDrawing(config, bolt));
    const box = arenaDrawing(config, bolt).bolts[0]!.box;
    expect(flying.drawn).toEqual([`bolt ${Math.round(box.x)},${Math.round(box.y)}`]);

    const smoky = trace(["smoke", "duelist"], 60, [1, I("special2"), 0], [40, I("light"), 0]);
    const starting = smoky.findIndex((state, frame) => frame >= 40 && fighterTells(config, state.fighters[0]).startingUp);
    const screened = recordingPen();
    drawTells(screened.pen, arenaDrawing(config, smoky[starting]!));
    expect(screened.drawn.map((line) => line.split(" ")[0])).toEqual(["zone", "flash"]);

    const feint = trace(["smoke", "duelist"], 40, [1, I("special1"), 0]);
    const back = feint.findIndex((state) => fighterTells(config, state.fighters[0]).reappearing);
    const reappearing = recordingPen();
    drawTells(reappearing.pen, arenaDrawing(config, feint[back]!));
    expect(reappearing.drawn.map((line) => line.split(" ")[0])).toEqual(["reappear"]);
  });

  it("outlines a striking move's active frames as a threat, a cast's as a startup, and an obscured startup as the flash's white", () => {
    const outline = (state: DuelState) => outlineColor(state.fighters[0], arenaDrawing(config, state).fighters[0]);
    const jab = trace(["duelist", "duelist"], 20, [1, I("light"), 0]);
    expect(outline(jab[1]!)).toBe(OUTLINE.startup);
    expect(jab.some((state) => outline(state) === OUTLINE.threat)).toBe(true);
    const cast = trace(["ember", "duelist"], 40, [1, I("special1"), 0]);
    expect(cast.slice(1, 30).every((state) => outline(state) === OUTLINE.startup)).toBe(true);
    const smoky = trace(["smoke", "duelist"], 60, [1, I("special2"), 0], [40, I("light"), 0]);
    const starting = smoky.findIndex((state, frame) => frame >= 40 && fighterTells(config, state.fighters[0]).startingUp);
    expect(outline(smoky[starting]!)).toBe(OUTLINE.hidden);
    const base = createDuelState(config);
    const as = (action: DuelState["fighters"][0]["action"]) => {
      const state = { ...base, fighters: [{ ...base.fighters[0], action }, base.fighters[1]] as const } as DuelState;
      return outline(state);
    };
    expect([as("hitstun"), as("knockdown"), as("blockstun"), as("stagger"), as("thrown"), as("throw-break"), as("idle")]).toEqual([
      OUTLINE.hit,
      OUTLINE.hit,
      OUTLINE.block,
      OUTLINE.stagger,
      OUTLINE.thrown,
      OUTLINE.thrown,
      OUTLINE.free,
    ]);
  });
});

