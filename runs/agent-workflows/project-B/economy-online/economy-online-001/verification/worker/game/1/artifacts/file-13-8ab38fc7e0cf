/** The page's fields without a DOM: each `[data-testid]` lookup gets a recording stand-in. */
function fakePage() {
  interface FakeField {
    textContent: string;
    hidden: boolean;
    readonly dataset: Record<string, string>;
    readonly style: { setProperty(name: string, value: string): void; getPropertyValue(name: string): string };
  }
  const fields = new Map<string, FakeField>();
  const field = (id: string): FakeField => {
    let found = fields.get(id);
    if (found === undefined) {
      const properties = new Map<string, string>();
      found = { textContent: "", hidden: false, dataset: {}, style: { setProperty: (name, value) => properties.set(name, value), getPropertyValue: (name) => properties.get(name) ?? "" } };
      fields.set(id, found);
    }
    return found;
  };
  const root = { querySelector: (selector: string) => field(/data-testid="([^"]+)"/.exec(selector)![1]!) } as unknown as ParentNode;
  return { root, field };
}

describe("the HUD's fruit lines (§9)", () => {
  it("names the player's kit and its specials on U and I, the Duelist's until they eat", () => {
    expect(kitLine(status({ kit: "ember" }))).toEqual({ text: "Ember: U flame bolt, I rising flare", state: "ember" });
    expect(kitLine(status({ kit: "smoke" }))).toEqual({ text: "Smoke: U short feint dash, I smoke screen", state: "smoke" });
    expect(kitLine(status())).toEqual({ text: "Duelist: U advancing thrust, I counter slash", state: "duelist" });
    expect(kitLine(undefined)).toEqual({ text: "", state: "none" });
    // A kit the page does not know shows nothing rather than a broken line.
    expect(kitLine(status({ kit: "spring" }))).toEqual({ text: "", state: "none" });
