:root {
  color-scheme: dark;
  font-family: system-ui, sans-serif;
  background: #06202f;
  color: #e8f1f5;
}

body {
  margin: 0;
}

[hidden] {
  display: none !important;
}

main {
  padding: 1.5rem;
}

#landing:not([hidden]) {
  max-width: 24rem;
  margin: 4rem auto;
  display: grid;
  gap: 1rem;
}

h1 {
  margin: 0;
}

.tagline,
.version,
.hint {
  color: #9bb8c6;
  margin: 0;
}

button,
input {
  font: inherit;
  padding: 0.5rem 0.75rem;
}

#join-form {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}

#join-code {
  text-transform: uppercase;
  width: 7rem;
}

#join-error {
  color: #ff9b8a;
  min-height: 1.5em;
  margin: 0;
}

#match:not([hidden]) {
  display: flex;
  gap: 1.5rem;
  align-items: flex-start;
}

#game {
  flex: none;
}

/* The match's stage: the clock bar above the sea, and the banners, compass, claim and results over it. */
#stage {
  flex: none;
  position: relative;
}

#flow-bar {
  display: flex;
  align-items: baseline;
  gap: 1rem;
  padding: 0.25rem 0.5rem;
  background: #0b2d40;
  border-bottom: 2px solid #1f4d66;
}

#flow-bar .phase {
  color: #9bb8c6;
  min-width: 11rem;
}

#flow-bar .timer {
  font-size: 1.6rem;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.05em;
}

#flow-bar .timer[data-state="urgent"] {
  color: #ff8a80;
}

#flow-bar .timer[data-state="waiting"] {
  color: #9bb8c6;
}

#flow-bar .sector {
  margin-left: auto;
  color: #ffd98a;
  font-weight: 600;
}

#banner:not([hidden]) {
  position: absolute;
  top: 3.25rem;
  left: 50%;
  transform: translateX(-50%);
  width: 34rem;
  display: grid;
  gap: 0.25rem;
  text-align: center;
  padding: 0.6rem 1rem;
  border-radius: 0.5rem;
  background: rgb(6 32 47 / 88%);
  border: 2px solid #9bb8c6;
  animation: banner-in 0.4s ease-out;
}

#banner[data-tone="treasure"] {
  border-color: #ffd98a;
  box-shadow: 0 0 24px rgb(255 217 138 / 45%);
}

#banner[data-tone="treasure"] strong {
  color: #ffd98a;
  font-size: 1.3rem;
}

#banner[data-tone="warning"] {
  border-color: #ff8a80;
}

@keyframes banner-in {
  from {
    opacity: 0;
    transform: translate(-50%, -0.75rem);
  }
}

#compass:not([hidden]) {
  position: absolute;
  left: 0.75rem;
  bottom: 0.75rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.35rem 0.75rem;
  border-radius: 1rem;
  background: rgb(6 32 47 / 85%);
  border: 2px solid #ffd98a;
  color: #ffd98a;
  font-weight: 600;
}

#compass .arrow {
  display: inline-block;
  font-size: 1.4rem;
  transform: rotate(var(--bearing, 0rad));
}

#compass[data-active="false"] {
  border-color: #6b7f8a;
  color: #9bb8c6;
}

/* No route known yet: the compass shows, but has nothing to point at. */
#compass[data-state="none"] .arrow {
  visibility: hidden;
}

#claim-panel:not([hidden]) {
  position: absolute;
  left: 50%;
  bottom: 0.75rem;
  transform: translateX(-50%);
  width: 26rem;
  padding: 0.5rem 0.75rem;
  border-radius: 0.5rem;
  background: rgb(6 32 47 / 88%);
  border: 2px solid #ffd98a;
  text-align: center;
}

#claim-panel p {
  margin: 0;
}

#claim-panel .risk {
  color: #ff8a80;
  font-weight: 600;
  min-height: 1.2em;
}

.progress.claim {
  height: 0.8rem;
  margin: 0.35rem 0;
  background: linear-gradient(to right, #ffd98a calc(var(--progress, 0) * 100%), #1f4d66 0);
}

#results:not([hidden]) {
  position: absolute;
  inset: 3rem 0.75rem 0.75rem;
  font-size: 0.9rem;
  display: grid;
  align-content: start;
  gap: 0.75rem;
  padding: 1rem 1.25rem;
  border-radius: 0.75rem;
  background: rgb(6 32 47 / 94%);
  border: 2px solid #ffd98a;
  overflow: auto;
}

#results h2 {
  margin: 0;
  color: #ffd98a;
  font-size: 1.6rem;
}

#results p {
  margin: 0;
}

#results table {
  border-collapse: collapse;
  font-variant-numeric: tabular-nums;
}

#results th,
#results td {
  padding: 0.25rem 0.5rem;
  text-align: right;
  border-bottom: 1px solid #1f4d66;
}

#results th:first-child,
#results td:first-child {
  text-align: left;
  white-space: nowrap;
}

#results tr[data-winner="true"] td {
  color: #ffd98a;
  font-weight: 700;
}

#results button {
  justify-self: start;
}

#lobby {
  width: 13rem;
  flex: none;
  display: grid;
  gap: 0.5rem;
  align-content: start;
}

#lobby h2 {
  margin: 0;
  font-size: 1.2rem;
}

#lobby .code-line strong {
  font-size: 1.4rem;
  letter-spacing: 0.1em;
}

#lobby ul {
  margin: 0;
  padding-left: 1.2rem;
}

#lobby .error {
  color: #ff9b8a;
  margin: 0;
  min-height: 1.2em;
}

.reveal-log {
  padding-left: 1.2rem;
  color: #ffd98a;
}

#game canvas {
  display: block;
}

#hud {
  max-width: 22rem;
}

#purse {
  width: 13rem;
  flex: none;
}

#purse dl {
  display: grid;
  grid-template-columns: auto auto;
  gap: 0.25rem 1rem;
  margin: 0;
}

#purse dt {
  color: #9bb8c6;
}

#purse dd {
  margin: 0;
  font-variant-numeric: tabular-nums;
}

#purse .settlement {
  color: #ffd98a;
  min-height: 1.5em;
}

#theft-choice {
  border: 2px solid #ffd98a;
  border-radius: 0.5rem;
  padding: 0.5rem 0.75rem;
  background: #0d3147;
}

#theft-choice h2 {
  font-size: 1rem;
  margin: 0 0 0.5rem;
}

.theft-options {
  display: flex;
  gap: 0.5rem;
}

.progress {
  display: block;
  height: 0.5rem;
  margin-top: 0.25rem;
  border-radius: 0.25rem;
  background: linear-gradient(to right, #c9e36b calc(var(--progress, 0) * 100%), #1f4d66 0);
}

#hud dl {
  display: grid;
  grid-template-columns: auto auto;
  gap: 0.25rem 1rem;
  margin: 0;
}

#hud dt {
  color: #9bb8c6;
}

#hud dd {
  margin: 0;
  font-variant-numeric: tabular-nums;
}

#hud dd.warning {
  color: #ff8a80;
  font-weight: 600;
}

#hud ul {
  list-style: none;
  padding: 0;
  font-variant-numeric: tabular-nums;
}

.swatch {
  display: inline-block;
  width: 0.75em;
  height: 0.75em;
  border-radius: 50%;
  margin-right: 0.4em;
}

.duel-entry {
  display: grid;
  gap: 0.75rem;
  border-top: 1px solid #1f4d66;
  padding-top: 1rem;
}

.duel-entry h2 {
  margin: 0;
  font-size: 1.1rem;
}

.duel-buttons,
#join-duel-form {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}

#duel-code {
  text-transform: uppercase;
  width: 7rem;
}

#duel-error {
  color: #ff9b8a;
  min-height: 1.5em;
  margin: 0;
}

#duel:not([hidden]) {
  display: flex;
  gap: 1.5rem;
  align-items: flex-start;
}

#arena {
  flex: none;
}

#arena canvas {
  display: block;
}

#duel-hud {
  max-width: 24rem;
  display: grid;
  gap: 0.75rem;
}

#duel-hud dl {
  display: grid;
  grid-template-columns: auto auto;
  gap: 0.25rem 1rem;
  margin: 0;
}

#duel-hud dt {
  color: #9bb8c6;
}

#duel-hud dd {
  margin: 0;
  font-variant-numeric: tabular-nums;
}

.fighters {
  display: grid;
  gap: 0.75rem;
}

.fighter {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 0.2rem 0.5rem;
  font-variant-numeric: tabular-nums;
}

.fighter .bar {
  grid-column: 1 / -1;
  height: 0.8rem;
  background: linear-gradient(to right, var(--bar) var(--fill, 100%), #10242f var(--fill, 100%));
  border: 1px solid #2d5870;
}

.fighter .bar.stamina {
  height: 0.35rem;
  --bar: #9bd1e5;
}

.fighter.p1 .bar.health {
  --bar: #f4b942;
}

.fighter.p2 .bar.health {
  --bar: #3dd6d0;
}

.connection {
  margin: 0;
  font-variant-numeric: tabular-nums;
}

#duel-result h2 {
  margin: 0;
  color: #fff3b0;
}

.toggle {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}

/* §3: the ruin panel, over the sea while a ruin is open. */
#ruin-panel:not([hidden]) {
  position: absolute;
  top: 3rem;
  left: 50%;
  transform: translateX(-50%);
  width: min(34rem, calc(100% - 1.5rem));
  max-height: calc(100% - 4rem);
  overflow-y: auto;
  padding: 0.75rem 1rem;
  border-radius: 0.5rem;
  background: rgb(6 32 47 / 94%);
  border: 2px solid #c9a86a;
}

#ruin-panel h2 {
  margin: 0 0 0.25rem;
  font-size: 1.1rem;
}

#ruin-panel p {
  margin: 0.35rem 0;
}

.ruin-tablets {
  list-style: none;
  margin: 0.5rem 0;
  padding: 0;
  display: grid;
  gap: 0.35rem;
}

.ruin-tablets li {
  display: grid;
  grid-template-columns: 7.5rem 1fr;
  align-items: center;
  gap: 0.75rem;
  padding: 0.3rem 0.5rem;
  border-radius: 0.35rem;
  background: #3b3325;
  border: 1px solid #6b5a3a;
}

.ruin-tablets li[data-chosen]:not([data-chosen=""]) {
  border-color: #ffd98a;
  background: #5a4a2a;
}

.ruin-tablets button {
  font-size: 1rem;
  text-align: left;
}

.ruin-tablets .inscription {
  font-size: 1.05rem;
  color: #f4e8cc;
}

.ruin-grid:not([hidden]) {
  display: grid;
  grid-template-columns: repeat(var(--size, 4), 3rem);
  gap: 0.25rem;
  justify-content: center;
  margin: 0.5rem 0;
}

.ruin-grid .cell {
  width: 3rem;
  height: 3rem;
  display: grid;
  place-items: center;
  font-weight: 700;
  font-size: 1.2rem;
  border-radius: 0.3rem;
  background: #2a5670;
}

.ruin-grid .cell[data-kind="blocked"] {
  background: #4a3f36;
  color: #a08b73;
}

.ruin-grid .cell[data-kind="start"] {
  background: #3f7d4f;
}

.ruin-grid .cell[data-kind="goal"] {
  background: #9c7a2c;
}

.ruin-grid .cell[data-path="true"] {
  outline: 3px solid #ffd98a;
  outline-offset: -3px;
}

.ruin-buttons {
  display: flex;
  gap: 0.5rem;
}

.ruin-verdict {
  display: block;
  color: #ffd98a;
}

/* §9: the fruit panel, over the sea while a pedestal is inspected, with the eating ring. */
#fruit-panel:not([hidden]) {
  position: absolute;
  top: 3rem;
  left: 50%;
  transform: translateX(-50%);
  width: min(28rem, calc(100% - 1.5rem));
  padding: 0.75rem 1rem;
  border-radius: 0.5rem;
  background: rgb(6 32 47 / 94%);
  border: 2px solid #ff7a1a;
}

#fruit-panel h2 {
  margin: 0 0 0.25rem;
  font-size: 1.1rem;
}

#fruit-panel p {
  margin: 0.35rem 0;
}

.fruit-specials {
  margin: 0.35rem 0;
  padding-left: 1.2rem;
}

.fruit-eat {
  display: flex;
  gap: 0.6rem;
  align-items: center;
}

.fruit-ring {
  --progress: 0%;
  width: 1.6rem;
  height: 1.6rem;
  border-radius: 50%;
  background: conic-gradient(#ff7a1a var(--progress), rgb(255 255 255 / 15%) 0);
}

.fruit-ring[hidden] {
  display: none;
}

.fighter .kit {
  display: block;
  font-size: 0.8rem;
  opacity: 0.85;
}

/* §11: the dockside shop (B), where the journal would be: one panel at a time. */
#shop:not([hidden]),
#journal:not([hidden]) {
  position: absolute;
  top: 3rem;
  left: 0.75rem;
  width: min(24rem, calc(100% - 1.5rem));
  max-height: calc(100% - 4rem);
  overflow-y: auto;
  padding: 0.6rem 0.9rem;
  border-radius: 0.5rem;
  background: rgb(6 32 47 / 94%);
  border: 2px solid #c9b27c;
  font-size: 0.9rem;
}

#journal h2 {
  margin: 0 0 0.2rem;
  font-size: 1.1rem;
}

#journal h3 {
  margin: 0.6rem 0 0.2rem;
  font-size: 0.95rem;
  color: #ffd98a;
}

#journal p,
#journal ul,
#journal ol {
  margin: 0.2rem 0;
}

.journal-rumors {
  padding-left: 0;
  list-style: none;
}

.journal-rumors li {
  margin: 0.15rem 0;
}

.journal-rumors .reason {
  font-style: normal;
  font-size: 0.8rem;
  padding: 0 0.3rem;
  border-radius: 0.25rem;
  background: rgb(255 255 255 / 12%);
}

.journal-rumors li[data-state="stale"],
.journal-rumors li[data-state="resolved"] {
  opacity: 0.55;
}

.journal-rumors li[data-state="stale"] > span:first-child {
  text-decoration: line-through;
}

.journal-rumors small {
  display: block;
  padding-left: 1rem;
}

.journal-buys {
  display: grid;
  gap: 0.3rem;
}

.journal-buys button:focus-visible,
#journal button:focus-visible {
  outline: 2px solid #ffd98a;
  outline-offset: 2px;
}

#toast:not([hidden]) {
  position: absolute;
  bottom: 1rem;
  left: 50%;
  transform: translateX(-50%);
  display: grid;
  gap: 0.15rem;
  text-align: center;
  padding: 0.45rem 0.9rem;
  border-radius: 0.5rem;
  background: rgb(6 32 47 / 90%);
  border: 2px solid #c9b27c;
}

#shop h2 {
  margin: 0 0 0.2rem;
  font-size: 1.1rem;
}

#shop h3 {
  margin: 0.6rem 0 0.2rem;
  font-size: 0.95rem;
  color: #ffd98a;
}

#shop p {
  margin: 0.2rem 0;
}

#purse .tonic-timer:not(:empty) {
  margin: 0.2rem 0;
  color: #7fdbff;
  font-weight: 600;
}
