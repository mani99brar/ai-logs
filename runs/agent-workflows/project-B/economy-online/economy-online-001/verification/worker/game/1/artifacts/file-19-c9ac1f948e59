import { isTyping } from "./keyboard.js";

/** A panel of the match page that reads keys: §3's ruin panel, §9's fruit panel, §13's journal, §11's shop. */
export interface KeyPanel {
  readonly isOpen: boolean;
  /** True when the key was the panel's. */
  keydown(event: Pick<KeyboardEvent, "code" | "repeat"> & { readonly shiftKey?: boolean }): boolean;
}

/**
 * A keydown in the match page, for its panels: never a key typed into a text field (as the helm's rule, `isTyping`),
 * and one panel at a time: while the fruit panel is open R opens no ruin, while the ruin panel is open F inspects no
 * fruit, neither opens the journal (M) or the shop (B), while the journal is open only its own keys count (M, Escape,
 * Tab), and while the shop is open only its own (B, Escape, Tab). The helm reads its own keys regardless. True when a
 * panel took the key, so the page prevents its default.
 */
export function panelKeydown(
  event: Pick<KeyboardEvent, "code" | "repeat" | "target"> & { readonly shiftKey?: boolean },
  panels: { readonly ruins: KeyPanel; readonly fruit: KeyPanel; readonly journal: KeyPanel; readonly shop: KeyPanel },
): boolean {
  if (isTyping(event.target)) return false;
  if (panels.journal.isOpen) return panels.journal.keydown(event);
  if (panels.shop.isOpen) return panels.shop.keydown(event);
  if (!panels.fruit.isOpen && panels.ruins.keydown(event)) return true;
  if (!panels.ruins.isOpen && panels.fruit.keydown(event)) return true;
  if (panels.ruins.isOpen || panels.fruit.isOpen) return false;
  return panels.journal.keydown(event) || panels.shop.keydown(event);
}
