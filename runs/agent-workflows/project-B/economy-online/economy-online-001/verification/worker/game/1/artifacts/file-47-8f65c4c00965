import { isNavigable, seaMap } from "@pirate-sea-race/content";
import { defaultSimulationConfig, pointInSight } from "@pirate-sea-race/simulation";
import { JournalMessageType, journalMessageSchema, MAX_BUY_RUMOR_PER_SECOND, type JournalMessage } from "@pirate-sea-race/protocol";
import { startGameServer, type MatchRoom, type RunningGameServer } from "@pirate-sea-race/server";
import { objectiveRules } from "@pirate-sea-race/simulation/objectives";
import { HeadlessClient, ImpairmentProxy, sleep, type Movement } from "@pirate-sea-race/test-tools";
import { GUEST_SEAT, HOST_SEAT, placePair, tuned } from "./rubbingsSetup.js";
