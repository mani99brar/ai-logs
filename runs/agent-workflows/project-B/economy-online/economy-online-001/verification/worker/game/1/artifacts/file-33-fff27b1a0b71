import { describe, expect, it } from "vitest";
import {
  JournalMessageType,
  MAX_BUY_RUMOR_BYTES,
  parseJournal,
  parseJournalMessage,
  parseKnownIslands,
  parseRumorOffers,
  parseRumorResultMessage,
  parseTestTimings,
  PROTOCOL_VERSION,
  testTimingsSchema,
  validateBuyRumorMessage,
  type JournalEntry,
} from "./index.js";

describe("protocol v10 (the journal and targeted rumors)", () => {
  it("is version 10, with the journal's message names", () => {
    expect(PROTOCOL_VERSION).toBeGreaterThanOrEqual(10);
    expect(JournalMessageType).toEqual({ Lead: "journal", BuyRumor: "buy-rumor", RumorResult: "rumor-result" });
  });

  it("parses every lead kind the room sends, and refuses a player id, a position or an unknown kind", () => {
    const leads = [
      { kind: "rumor", tick: 40, entry: 1, type: "sun", reason: "start", target: { kind: "island", island: 2, name: "Old Stones" } },
      { kind: "rumor", tick: 90, entry: 2, type: "moon", reason: "targeted", target: { kind: "sector", sector: 4, name: "Central Waters" } },
      { kind: "carrier-sighting", tick: 600, seenTick: 0, sightings: [{ type: "sun", reason: "fresh", sector: 4, name: "Central Waters" }] },
      { kind: "no-lead", tick: 40, type: "moon", reason: "start" },
      { kind: "rumor-stale", tick: 50, entry: 1, type: "sun" },
      { kind: "rumor-resolved", tick: 60, entry: 2, type: "moon" },
    ];
    for (const lead of leads) expect(parseJournalMessage(lead)).toEqual(lead);
    for (const bad of [
      { ...leads[0], playerId: "abc" },
      { ...leads[0], target: { kind: "island", island: 2, name: "Old Stones", x: 5, y: 6 } },
      { kind: "carrier-sighting", tick: 600, seenTick: 0, sightings: [{ type: "sun", reason: "start", sector: 4, name: "Central Waters" }] },
      { kind: "carrier-sighting", tick: 600, seenTick: 0, sightings: [] },
      { kind: "final-route", tick: 1, x: 1, y: 1, restored: false },
      null,
    ]) {
      expect(parseJournalMessage(bad)).toBeUndefined();
    }
  });

  it("validates a purchase request by size and schema", () => {
    expect(validateBuyRumorMessage({ requestId: "b1", type: "moon" })).toEqual({ requestId: "b1", type: "moon" });
    for (const bad of [
      { requestId: "", type: "moon" },
      { requestId: "has space", type: "moon" },
      { requestId: "x".repeat(33), type: "moon" },
      { requestId: "b1", type: "gold" },
      { requestId: "b1", type: "moon", price: 0 },
      { requestId: "b1".padEnd(MAX_BUY_RUMOR_BYTES, "x"), type: "moon" },
      "buy",
      { toJSON: () => 1n },
    ]) {
      expect(validateBuyRumorMessage(bad)).toBeUndefined();
    }
  });

  it("parses the answer to a purchase: bought with its price, or refused with a known reason", () => {
    expect(parseRumorResultMessage({ requestId: "b1", type: "sun", outcome: "bought", price: 25, replayed: false })).toBeDefined();
    expect(parseRumorResultMessage({ requestId: "b1", type: "sun", outcome: "refused", reason: "not-at-dock", replayed: true })).toBeDefined();
    expect(parseRumorResultMessage({ requestId: "b1", type: "sun", outcome: "refused", reason: "why-not", replayed: false })).toBeUndefined();
    expect(parseRumorResultMessage({ requestId: "b1", type: "sun", outcome: "bought", reason: "busy", replayed: false })).toBeUndefined();
  });

  it("reads the journal, the known islands and the offers from a status, and nothing from a malformed one", () => {
    const entry: JournalEntry = { n: 1, kind: "island", type: "sun", target: "Old Stones", island: 2, sector: -1, reason: "start", tick: 3, seenTick: 0, status: "stale", replacedBy: 2 };
    expect(parseJournal(JSON.stringify([entry]))).toEqual([entry]);
    for (const bad of ["", "{", "[1]", JSON.stringify([{ ...entry, x: 1 }])]) expect(parseJournal(bad)).toEqual([]);
    expect(parseKnownIslands('[{"island":0,"unlocked":true,"solved":false}]')).toEqual([{ island: 0, unlocked: true, solved: false }]);
    for (const bad of ["", "nope", '[{"island":-1,"unlocked":true,"solved":false}]']) expect(parseKnownIslands(bad)).toEqual([]);
    expect(parseRumorOffers("sun:available,moon:covered")).toEqual([
      { type: "sun", offer: "available" },
      { type: "moon", offer: "covered" },
    ]);
    for (const bad of ["", "sun", "sun:free", "gold:none"]) expect(parseRumorOffers(bad)).toEqual([]);
  });

  it("takes the test-only carrier interval among the timings", () => {
    expect(parseTestTimings("carriers=240,carrierInterval=80")).toEqual({ carriers: 240, carrierInterval: 80 });
    expect(parseTestTimings("carrierinterval=80")).toBeUndefined();
    expect(testTimingsSchema.safeParse({ carrierInterval: 80 }).success).toBe(true);
    expect(testTimingsSchema.safeParse({ carrierInterval: 0 }).success).toBe(false);
  });
});
