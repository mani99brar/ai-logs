  it("moors from any lateral offset when driven into the corner of the shore beside a dock, tilted toward the land", () => {
    // A south dock with land beside it to the west in its row, open sea to the east, and the coast running on east of it
    // one row further north: an inside corner of the shore.
    const map = config.map;
    const corner = map.docks.find(
      (each) => each.side === "S" && terrainAt(map, each.tileX - 1, each.tileY) === Terrain.Land && terrainAt(map, each.tileX + 1, each.tileY) === Terrain.Sea,
    )!;
    const berth = tileCentre(config, corner.tileX, corner.tileY);
    for (let column = corner.tileX; column <= corner.tileX + 4; column++) expect(terrainAt(map, column, corner.tileY - 1)).toBe(Terrain.Land);
    for (let row = corner.tileY; row <= corner.tileY + 3; row++) {
      for (let column = corner.tileX + 1; column <= corner.tileX + 3; column++) expect(terrainAt(map, column, row)).toBe(Terrain.Sea);
    }
    // The approach the browser test sails: from 1–3 tiles east and 2–4 tiles south of the dock, at a heading one or two
    // units west of north, ahead and interact held together from a slow start. Every lateral offset across those tiles,
    // 16 sub-units apart, moors on the first step it starts within the dock's reach with a clear run to the berth,
    // never touching the shore.
    const north = compassHeading("N");
    let approaches = 0;
    for (const heading of [north - 1, north - 2]) {
      for (let x = (corner.tileX + 1) * tile; x < (corner.tileX + 4) * tile; x += 16) {
        for (const [rowsOut, speed] of [[2, config.ship.dockMaxSpeed], [3, 0], [3, config.ship.dockMaxSpeed], [4, 0]] as const) {
          const start = { ...shipAt(corner.tileX + 2, corner.tileY + rowsOut, heading), x, speed };
          const course = sailFor(start, helm(0, 1, INTERACT_BUTTON), 30 * WORLD_STEPS_PER_SECOND);
          const moored = course.findIndex((ship) => ship.dock !== NOT_DOCKED);
          expect(moored, `heading ${heading}, x ${x}, speed ${speed}`).toBeGreaterThan(0);
          expect(course[moored]).toMatchObject({ ...berth, speed: 0, dock: corner.id, mooredThrottle: 1 });
          const before = [start, ...course.slice(0, moored)];
          expect(dockInReach(config, before.at(-1)!.x, before.at(-1)!.y)).toBe(corner);
          for (const ship of before.slice(0, -1)) expect(dockInReach(config, ship.x, ship.y)).toBeUndefined();
          for (const ship of before.slice(1)) expect(ship.speed).toBeGreaterThan(0);
          for (const ship of course) expect(hullIsClear(config, ship.x, ship.y)).toBe(true);
          approaches++;
        }
      }
    }
    expect(approaches).toBe(2 * 3 * (tile / 16) * 4);
  }, 30_000);

  it("moors every approach into a berth's open sides on the first step the terrain allows, at every dock", async ({ annotate }) => {
    // The oracle: from terrain lookups alone, the nearest dock a ship at (x, y) may moor at. A tile the hull overlaps is
    // the berth tile or an orthogonal neighbour, or a diagonal neighbour with one of its two shared tiles navigable; or
    // the berth centre is within reach and the hull stays on navigable tiles along the straight run to it.
    const hullOnSea = (sea: SimulationConfig, x: number, y: number) => {
      const half = sea.ship.hullHalfSize;
      for (let row = Math.floor((y - half) / tile); row <= Math.floor((y + half) / tile); row++) {
        for (let column = Math.floor((x - half) / tile); column <= Math.floor((x + half) / tile); column++) {
          if (!isNavigable(sea.map, column, row)) return false;
        }
      }
      return true;
    };
    const oracle = (sea: SimulationConfig, x: number, y: number) => {
      const half = sea.ship.hullHalfSize;
      let best: (typeof sea.map.docks)[number] | undefined;
      let bestDistance = Infinity;
      for (const each of sea.map.docks) {
        const centre = tileCentre(sea, each.tileX, each.tileY);
        const distance = (centre.x - x) ** 2 + (centre.y - y) ** 2;
        if (distance >= bestDistance) continue;
        let beside = false;
        for (let row = Math.floor((y - half) / tile); row <= Math.floor((y + half) / tile); row++) {
          for (let column = Math.floor((x - half) / tile); column <= Math.floor((x + half) / tile); column++) {
            const dx = column - each.tileX;
            const dy = row - each.tileY;
            if (Math.abs(dx) > 1 || Math.abs(dy) > 1) continue;
            if (dx === 0 || dy === 0 || isNavigable(sea.map, each.tileX + dx, each.tileY) || isNavigable(sea.map, each.tileX, each.tileY + dy)) beside = true;
          }
        }
        let clearRun = false;
        if (!beside && distance <= sea.ship.dockRadius ** 2) {
          const steps = Math.max(Math.abs(centre.x - x), Math.abs(centre.y - y));
          clearRun = true;
          for (let index = 0; index <= steps && clearRun; index++) {
            const along = (delta: number) => (steps === 0 ? 0 : Math.trunc((delta * index) / steps));
            clearRun = hullOnSea(sea, x + along(centre.x - x), y + along(centre.y - y));
          }
        }
        if (beside || clearRun) {
          best = each;
          bestDistance = distance;
        }
      }
      return best;
    };

    // Where a lane may come to rest near a berth without mooring (holding ahead, aground, within the 5 × 5 tiles around
    // the berth), by dock and tile: each is a coast the lane's heading drives into, out of reach of the berth.
    const allowedRests: Record<string, string> = {
      "synthetic island (10, 5)": "the island's east coast, two tiles north of the berth",
      "synthetic island (7, 8)": "the island's south coast, two tiles west of the berth and a row south",
      "Palm Key, west dock (17, 19)": "the island's west coast, two tiles north of the berth",
      "Palm Key, west dock (17, 23)": "the island's west coast, two tiles south of the berth",
      "Palm Key, south dock (25, 27)": "the island's south coast in the berth's row, two tiles east of it",
      "Palm Key, south dock (21, 28)": "the island's south coast, two tiles west of the berth and a row south",
      "Ember Rock, east dock (93, 19)": "the island's east coast, two tiles north of the berth",
      "Ember Rock, east dock (93, 23)": "the island's east coast, two tiles south of the berth",
      "Ember Rock, south dock (85, 27)": "the island's south coast in the berth's row, two tiles west of it",
      "Ember Rock, south dock (89, 28)": "the island's south coast, two tiles east of the berth and a row south",
      "Old Stones, west dock (17, 87)": "the island's west coast, two tiles north of the berth",
      "Old Stones, west dock (17, 91)": "the island's west coast, two tiles south of the berth",
      "Old Stones, north dock (25, 83)": "the island's north coast in the berth's row, two tiles east of it",
      "Old Stones, north dock (21, 82)": "the island's north coast, two tiles west of the berth and a row north",
      "Mist Cay, east dock (93, 87)": "the island's east coast, two tiles north of the berth",
      "Mist Cay, east dock (93, 91)": "the island's east coast, two tiles south of the berth",
      "Mist Cay, north dock (85, 83)": "the island's north coast in the berth's row, two tiles west of it",
      "Mist Cay, north dock (89, 82)": "the island's north coast, two tiles east of the berth and a row north",
    };

    const docks = [
      { name: "synthetic island", sea: cornerIsland, dock: cornerIsland.map.docks[0]! },
      ...config.map.docks.map((each) => ({ name: dockLabel(config.map, each.id), sea: config, dock: each })),
    ];
    const failures: string[] = [];
    const rests = new Set<string>();
    let lanes = 0;
    let moorings = 0;
    let restsNear = 0;
    let sailedPast = 0;
    for (const { name, sea, dock: berthDock } of docks) {
      const centre = tileCentre(sea, berthDock.tileX, berthDock.tileY);
      const openSides = [{ dx: 1, dy: 0 }, { dx: 0, dy: 1 }, { dx: -1, dy: 0 }, { dx: 0, dy: -1 }].filter(({ dx, dy }) =>
        isNavigable(sea.map, berthDock.tileX + dx, berthDock.tileY + dy),
      );
      const headings: number[] = [];
      for (let heading = 0; heading < HEADING_COUNT; heading += 8) {
        // Pointing into an open side: sailing against that side's outward direction.
        if (openSides.some(({ dx, dy }) => dx * HEADING_DX[heading]! + dy * HEADING_DY[heading]! < 0)) headings.push(heading);
      }
      if (headings.length === 0) failures.push(`${name}: no open side`);
      // Every sea position on a 64-sub-unit grid whose tile is 2 to 4 tiles (Chebyshev) from the berth tile.
      const starts: { x: number; y: number }[] = [];
      for (let y = (berthDock.tileY - 4) * tile; y < (berthDock.tileY + 5) * tile; y += 64) {
        for (let x = (berthDock.tileX - 4) * tile; x < (berthDock.tileX + 5) * tile; x += 64) {
          const ring = Math.max(Math.abs(Math.floor(x / tile) - berthDock.tileX), Math.abs(Math.floor(y / tile) - berthDock.tileY));
          if (ring >= 2 && hullIsClear(sea, x, y)) starts.push({ x, y });
        }
      }
      for (const { x, y } of starts) {
        for (const heading of headings) {
          for (const speed of [0, divTrunc(sea.ship.maxSpeed, 2), sea.ship.maxSpeed]) {
            const label = `${name}, from (${x}, ${y}), heading ${heading}, speed ${speed}`;
            lanes++;
            let ship: ShipState = { ...shipAt(0, 0, heading, sea), x, y, speed };
            let outcome: "moored" | "rest" | "away" | "sailing" = "sailing";
            for (let index = 0; index < 400 && outcome === "sailing"; index++) {
              const expected = oracle(sea, ship.x, ship.y);
              const next = sail(sea, ship, helm(0, 1, INTERACT_BUTTON));
              if (expected !== undefined) {
                const target = tileCentre(sea, expected.tileX, expected.tileY);
                if (next.dock !== expected.id || next.x !== target.x || next.y !== target.y || next.speed !== 0) {
                  failures.push(`${label}: step ${index} from (${ship.x}, ${ship.y}) may moor at dock ${expected.id} but gave dock ${next.dock}`);
                }
                outcome = "moored";
                moorings++;
              } else if (next.dock !== NOT_DOCKED) {
                failures.push(`${label}: step ${index} from (${ship.x}, ${ship.y}) moored at dock ${next.dock}, which the oracle refuses`);
                outcome = "moored";
              } else if (next.speed === 0) {
                // At rest with ahead held: aground, and it stays there.
                outcome = "rest";
                const rest = toTilePosition(sea, next.x, next.y);
                if (Math.abs(rest.tileX - berthDock.tileX) <= 2 && Math.abs(rest.tileY - berthDock.tileY) <= 2) {
                  restsNear++;
                  const key = `${name} (${rest.tileX}, ${rest.tileY})`;
                  rests.add(key);
                  if (!(key in allowedRests)) failures.push(`${label}: came to rest unmoored on ${key}, at (${next.x}, ${next.y})`);
                } else sailedPast++;
              } else {
                // With its heading fixed, a ship moves one way along each axis, so once it is more than six tiles from
                // the berth it never comes back.
                const at = toTilePosition(sea, next.x, next.y);
                if (Math.max(Math.abs(at.tileX - berthDock.tileX), Math.abs(at.tileY - berthDock.tileY)) > 6) {
                  outcome = "away";
                  sailedPast++;
                }
              }
              ship = next;
            }
            if (outcome === "sailing") failures.push(`${label}: still under way near the berth after 400 steps`);
          }
        }
      }
    }
    for (const key of Object.keys(allowedRests)) if (!rests.has(key)) failures.push(`${key}: listed, but no lane comes to rest there`);
    // Every lane is accounted for: moored, at rest near the berth on a listed tile, or past the berth.
    await annotate(`${lanes} lanes over ${docks.length} docks: ${moorings} moored, ${restsNear} came to rest on a listed tile, ${sailedPast} sailed past or grounded away from the berth`);
    if (moorings + restsNear + sailedPast !== lanes) failures.push(`${lanes} lanes, but ${moorings + restsNear + sailedPast} outcomes`);
    expect(failures.length === 0 ? [] : [`${failures.length} failures`, ...failures.slice(0, 40)]).toEqual([]);
  }, 30_000);

  it("docks on the real map at every dock", () => {
    for (const each of config.map.docks) {
      const centre = tileCentre(config, each.tileX, each.tileY);
      expect(sail(config, { ...shipAt(each.tileX, each.tileY, 0), x: centre.x + 1, y: centre.y }, INTERACT).dock).toBe(each.id);
      expect(terrainAt(config.map, each.tileX, each.tileY)).toBe(Terrain.Dock);
    }
  });
});

describe("visibility", () => {
  const sight = config.sightRadius;

  it("sees ships within the sight radius and not beyond it", () => {
    const viewer = shipAt(50, 100, 0);
    expect(sight).toBe(10 * tile);
    expect(canSee(config, viewer, { ...viewer, id: "b", x: viewer.x + sight })).toBe(true);
    expect(canSee(config, viewer, { ...viewer, id: "b", x: viewer.x + sight + 1 })).toBe(false);
    // Diagonals compare true distance: 6-8-10 is on the circle, 6-9 is outside it.
    expect(canSee(config, viewer, { ...viewer, id: "b", x: viewer.x + 6 * tile, y: viewer.y + 8 * tile })).toBe(true);
    expect(canSee(config, viewer, { ...viewer, id: "b", x: viewer.x + 6 * tile, y: viewer.y + 9 * tile })).toBe(false);
  });

  it("always includes the viewer's own ship", () => {
    // On the open row three tiles south of the hub: b is in sight of a and c, a and c are out of each other's sight.
    const row = seaMap.hub.tileY + 3;
    const [a, b, c] = [seaMap.hub.tileX - 10, seaMap.hub.tileX - 5, seaMap.hub.tileX + 10];
    let state = matchWithShips(8, ["a", "b", "c"]);
    state = placeShip(config, state, "a", { tileX: a, tileY: row, heading: 0 });
    state = placeShip(config, state, "b", { tileX: b, tileY: row, heading: 0 });
    state = placeShip(config, state, "c", { tileX: c, tileY: row, heading: 0 });
    expect([...visibleShipIds(config, state, "a")].sort()).toEqual(["a", "b"]);
    expect([...visibleShipIds(config, state, "c")]).toEqual(["c"]);
    expect(visibleShipIds(config, state, "nobody").size).toBe(0);
  });
});

describe("placement", () => {
  it("puts a ship at rest on a navigable tile and refuses land", () => {
    const moving = run(matchWithShips(3, ["a"]), [{ frame: 1, shipId: "a", input: FULL_AHEAD }], 30);
    const land = config.map.islands[0]!;
    const { hub } = config.map;
    expect(terrainAt(seaMap, hub.tileX, hub.tileY)).toBe(Terrain.Sea);
    const placed = placeShip(config, moving, "a", { ...hub, heading: HEADING_COUNT + 2 });
    expect(placed.ships[0]).toMatchObject({ ...tileCentre(config, hub.tileX, hub.tileY), heading: 2, speed: 0, dock: NOT_DOCKED });
    const centreOfLand = { tileX: land.tileX + Math.floor(land.widthTiles / 2), tileY: land.tileY + Math.floor(land.heightTiles / 2) };
    expect(terrainAt(seaMap, centreOfLand.tileX, centreOfLand.tileY)).toBe(Terrain.Land);
    expect(() => placeShip(config, moving, "a", { ...centreOfLand, heading: 0 })).toThrow(/not navigable/);
    expect(() => placeShip(config, moving, "zz", { ...hub, heading: 0 })).toThrow();
    expect(() => placeShip(config, moving, "a", { tileX: config.map.widthTiles, tileY: hub.tileY, heading: 0 })).toThrow(/not navigable/);
  });
});

describe("spawning", () => {
  it("gives eight ships eight different slots, chosen by the seeded generator, at rest facing the slot's heading", () => {
    const ids = ["a", "b", "c", "d", "e", "f", "g", "h"];
    const state = matchWithShips(2024, ids);
    expect(new Set(state.ships.map((ship) => ship.slot)).size).toBe(8);
    for (const ship of state.ships) {
      const slot = config.spawnSlots[ship.slot]!;
      expect(ship).toMatchObject({ ...tileCentre(config, slot.tileX, slot.tileY), heading: compassHeading(slot.facing), speed: 0, dock: NOT_DOCKED });
    }
    expect(() => addShip(config, state, "i")).toThrow(/no free spawn slot/);
    const other = matchWithShips(2025, ids);
    expect(other.ships.map((ship) => ship.slot)).not.toEqual(state.ships.map((ship) => ship.slot));
  });

  it("frees a slot when a ship leaves", () => {
    const state = removeShip(matchWithShips(1, ["a", "b"]), "a");
    expect(state.ships.map((ship) => ship.id)).toEqual(["b"]);
  });

  it("refuses a duplicate ship id", () => {
    expect(() => addShip(config, matchWithShips(1, ["a"]), "a")).toThrow();
  });
});
