    // Unchanged ahead held on resuming does not cast off; neutral input releases the latch, and ahead then casts off.
    const resumed = run(stalled, [{ frame: stalled.frame + 1, shipId: moored.id, input: FULL_AHEAD }], 10 * WORLD_STEP_INTERVAL);
    expect(resumed.ships[0]).toEqual(moored);
    const neutral = run(stalled, [{ frame: stalled.frame + 1, shipId: moored.id, input: helm(0, 0) }], WORLD_STEP_INTERVAL);
    expect(neutral.ships[0]).toMatchObject({ dock: realDock.id, mooredThrottle: 0 });
    // A ship at sea with no entry still sails as neutral: it coasts.
