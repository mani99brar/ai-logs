:root {
  color-scheme: dark;
  font-family: system-ui, sans-serif;
  background: #06202f;
  color: #e8f1f5;
}

body {
  margin: 0;
}

[hidden] {
  display: none !important;
}

main {
  padding: 1.5rem;
}

#landing:not([hidden]) {
  max-width: 24rem;
  margin: 4rem auto;
  display: grid;
  gap: 1rem;
}

h1 {
  margin: 0;
}

.tagline,
.version,
.hint {
  color: #9bb8c6;
  margin: 0;
}

button,
input {
  font: inherit;
  padding: 0.5rem 0.75rem;
}

#join-form {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}

#join-code {
  text-transform: uppercase;
  width: 7rem;
}

#join-error {
  color: #ff9b8a;
  min-height: 1.5em;
  margin: 0;
}

#match:not([hidden]) {
  display: flex;
  gap: 1.5rem;
  align-items: flex-start;
}

#game {
  flex: none;
}

/* The match's stage: the clock bar above the sea, and the banners, compass, claim and results over it. */
#stage {
  flex: none;
  position: relative;
}

#flow-bar {
  display: flex;
  align-items: baseline;
  gap: 1rem;
  padding: 0.25rem 0.5rem;
  background: #0b2d40;
  border-bottom: 2px solid #1f4d66;
}

#flow-bar .phase {
  color: #9bb8c6;
  min-width: 11rem;
}

#flow-bar .timer {
  font-size: 1.6rem;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.05em;
}

#flow-bar .timer[data-state="urgent"] {
  color: #ff8a80;
}

#flow-bar .timer[data-state="waiting"] {
  color: #9bb8c6;
}

#flow-bar .sector {
  margin-left: auto;
  color: #ffd98a;
  font-weight: 600;
}

#banner:not([hidden]) {
  position: absolute;
  top: 3.25rem;
  left: 50%;
  transform: translateX(-50%);
  width: 34rem;
  display: grid;
  gap: 0.25rem;
  text-align: center;
  padding: 0.6rem 1rem;
  border-radius: 0.5rem;
  background: rgb(6 32 47 / 88%);
  border: 2px solid #9bb8c6;
  animation: banner-in 0.4s ease-out;
}

#banner[data-tone="treasure"] {
  border-color: #ffd98a;
  box-shadow: 0 0 24px rgb(255 217 138 / 45%);
}

#banner[data-tone="treasure"] strong {
  color: #ffd98a;
  font-size: 1.3rem;
}

#banner[data-tone="warning"] {
  border-color: #ff8a80;
}

@keyframes banner-in {
  from {
    opacity: 0;
    transform: translate(-50%, -0.75rem);
  }
}

#compass:not([hidden]) {
  position: absolute;
  left: 0.75rem;
  bottom: 0.75rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.35rem 0.75rem;
  border-radius: 1rem;
  background: rgb(6 32 47 / 85%);
  border: 2px solid #ffd98a;
  color: #ffd98a;
  font-weight: 600;
}

#compass .arrow {
  display: inline-block;
  font-size: 1.4rem;
  transform: rotate(var(--bearing, 0rad));
}

#compass[data-active="false"] {
  border-color: #6b7f8a;
  color: #9bb8c6;
}

/* No route known yet: the compass shows, but has nothing to point at. */
#compass[data-state="none"] .arrow {
  visibility: hidden;
}

#claim-panel:not([hidden]) {
  position: absolute;
  left: 50%;
  bottom: 0.75rem;
  transform: translateX(-50%);
  width: 26rem;
  padding: 0.5rem 0.75rem;
  border-radius: 0.5rem;
  background: rgb(6 32 47 / 88%);
  border: 2px solid #ffd98a;
  text-align: center;
}

#claim-panel p {
  margin: 0;
}

#claim-panel .risk {
  color: #ff8a80;
  font-weight: 600;
  min-height: 1.2em;
}

.progress.claim {
  height: 0.8rem;
  margin: 0.35rem 0;
  background: linear-gradient(to right, #ffd98a calc(var(--progress, 0) * 100%), #1f4d66 0);
}

#results:not([hidden]) {
  position: absolute;
  inset: 3rem 0.75rem 0.75rem;
  font-size: 0.9rem;
  display: grid;
  align-content: start;
  gap: 0.75rem;
  padding: 1rem 1.25rem;
  border-radius: 0.75rem;
  background: rgb(6 32 47 / 94%);
  border: 2px solid #ffd98a;
  overflow: auto;
}

#results h2 {
  margin: 0;
  color: #ffd98a;
  font-size: 1.6rem;
}

#results p {
  margin: 0;
}

#results table {
  border-collapse: collapse;
  font-variant-numeric: tabular-nums;
}

#results th,
#results td {
  padding: 0.25rem 0.5rem;
  text-align: right;
  border-bottom: 1px solid #1f4d66;
}

#results th:first-child,
#results td:first-child {
  text-align: left;
  white-space: nowrap;
}

#results tr[data-winner="true"] td {
  color: #ffd98a;
  font-weight: 700;
}

#results button {
  justify-self: start;
}

#lobby {
  width: 13rem;
  flex: none;
  display: grid;
  gap: 0.5rem;
  align-content: start;
}

#lobby h2 {
  margin: 0;
  font-size: 1.2rem;
}

#lobby .code-line strong {
  font-size: 1.4rem;
  letter-spacing: 0.1em;
}

#lobby ul {
  margin: 0;
  padding-left: 1.2rem;
}

#lobby .error {
  color: #ff9b8a;
  margin: 0;
  min-height: 1.2em;
}

.reveal-log {
  padding-left: 1.2rem;
  color: #ffd98a;
}

#game canvas {
  display: block;
}

#hud {
  max-width: 22rem;
}

#purse {
  width: 13rem;
  flex: none;
}

#purse dl {
  display: grid;
  grid-template-columns: auto auto;
  gap: 0.25rem 1rem;
  margin: 0;
}

#purse dt {
  color: #9bb8c6;
}

#purse dd {
  margin: 0;
  font-variant-numeric: tabular-nums;
}

#purse .settlement {
  color: #ffd98a;
  min-height: 1.5em;
}

#theft-choice {
  border: 2px solid #ffd98a;
  border-radius: 0.5rem;
  padding: 0.5rem 0.75rem;
  background: #0d3147;
}

#theft-choice h2 {
  font-size: 1rem;
  margin: 0 0 0.5rem;
}

.theft-options {
  display: flex;
  gap: 0.5rem;
}

.progress {
  display: block;
  height: 0.5rem;
  margin-top: 0.25rem;
  border-radius: 0.25rem;
  background: linear-gradient(to right, #c9e36b calc(var(--progress, 0) * 100%), #1f4d66 0);
}

#hud dl {
  display: grid;
  grid-template-columns: auto auto;
  gap: 0.25rem 1rem;
  margin: 0;
}

#hud dt {
  color: #9bb8c6;
}

#hud dd {
  margin: 0;
  font-variant-numeric: tabular-nums;
}

#hud dd.warning {
  color: #ff8a80;
  font-weight: 600;
}

#hud ul {
  list-style: none;
  padding: 0;
  font-variant-numeric: tabular-nums;
}

.swatch {
  display: inline-block;
  width: 0.75em;
  height: 0.75em;
  border-radius: 50%;
  margin-right: 0.4em;
}

.duel-entry {
  display: grid;
  gap: 0.75rem;
  border-top: 1px solid #1f4d66;
  padding-top: 1rem;
}

.duel-entry h2 {
  margin: 0;
  font-size: 1.1rem;
}

.duel-buttons,
#join-duel-form {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}

#duel-code {
  text-transform: uppercase;
  width: 7rem;
}

#duel-error {
  color: #ff9b8a;
  min-height: 1.5em;
  margin: 0;
}

#duel:not([hidden]) {
  display: flex;
  gap: 1.5rem;
  align-items: flex-start;
}

#arena {
  flex: none;
}

#arena canvas {
  display: block;
}

#duel-hud {
  max-width: 24rem;
  display: grid;
  gap: 0.75rem;
}

#duel-hud dl {
  display: grid;
  grid-template-columns: auto auto;
  gap: 0.25rem 1rem;
  margin: 0;
}

#duel-hud dt {
  color: #9bb8c6;
}

#duel-hud dd {
  margin: 0;
  font-variant-numeric: tabular-nums;
}

.fighters {
  display: grid;
  gap: 0.75rem;
}

.fighter {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 0.2rem 0.5rem;
  font-variant-numeric: tabular-nums;
}

.fighter .bar {
  grid-column: 1 / -1;
  height: 0.8rem;
  background: linear-gradient(to right, var(--bar) var(--fill, 100%), #10242f var(--fill, 100%));
  border: 1px solid #2d5870;
}

.fighter .bar.stamina {
  height: 0.35rem;
  --bar: #9bd1e5;
}

.fighter.p1 .bar.health {
  --bar: #f4b942;
}

.fighter.p2 .bar.health {
  --bar: #3dd6d0;
}

.connection {
  margin: 0;
  font-variant-numeric: tabular-nums;
}

#duel-result h2 {
  margin: 0;
  color: #fff3b0;
}

.toggle {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}
