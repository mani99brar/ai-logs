import { describe, expect, it } from "vitest";
import { matchRules } from "@pirate-sea-race/content/match";
import { createMatchConfig, createMatchState, stepMatch, type MatchReport } from "@pirate-sea-race/simulation/match";
import { knownFlowReports } from "./flowReports.js";

const players = [{ id: "a" }, { id: "b" }];

describe("the room's reports before the match flow's step (knownFlowReports)", () => {
  it("drops a duel's end naming an unknown fighter, whoever won", () => {
    const ghost: MatchReport = { kind: "duel-ended", playerIds: ["a", "ghost"], winner: "a" };
    const drawn: MatchReport = { kind: "duel-ended", playerIds: ["ghost", "b"], winner: null };
    const known: MatchReport = { kind: "duel-ended", playerIds: ["a", "b"], winner: "b" };
    expect(knownFlowReports(players, [ghost, drawn, known])).toEqual({ reports: [known], dropped: [ghost, drawn] });
  });

  it("drops a claim's end naming an unknown winner, and keeps a deadline's (no winner) and a known winner's", () => {
    const ghost: MatchReport = { kind: "match-ended", tick: 9, reason: "claim", winner: "ghost" };
    const deadline: MatchReport = { kind: "match-ended", tick: 9, reason: "deadline", winner: null };
    const won: MatchReport = { kind: "match-ended", tick: 9, reason: "claim", winner: "a" };
    expect(knownFlowReports(players, [ghost, deadline, won])).toEqual({ reports: [deadline, won], dropped: [ghost] });
  });

  it("drops each accomplishment naming an unknown player", () => {
    const ghosts: MatchReport[] = [
      { kind: "collected", playerId: "ghost" },
      { kind: "stole", playerId: "ghost" },
      { kind: "lost", playerId: "ghost" },
      { kind: "cache-claimed", playerId: "ghost" },
      { kind: "gold", playerId: "ghost", gold: 70 },
      { kind: "island-visited", playerId: "ghost", island: "2" },
    ];
    const known: MatchReport[] = ghosts.map((report) => ({ ...report, playerId: "b" }));
    expect(knownFlowReports(players, [...ghosts, ...known])).toEqual({ reports: known, dropped: ghosts });
  });

  it("makes a join's player known to the reports after it, not before", () => {
    const before: MatchReport = { kind: "collected", playerId: "c" };
    const join: MatchReport = { kind: "join", playerId: "c" };
    const after: MatchReport = { kind: "collected", playerId: "c" };
    const duel: MatchReport = { kind: "duel-ended", playerIds: ["c", "a"], winner: "c" };
    expect(knownFlowReports(players, [before, join, after, duel])).toEqual({ reports: [join, after, duel], dropped: [before] });
  });

  it("keeps an unknown player's leave and start (the match module ignores one and refuses the other) and a fault", () => {
    const kept: MatchReport[] = [{ kind: "leave", playerId: "ghost" }, { kind: "start", playerId: "ghost" }, { kind: "fault" }];
    expect(knownFlowReports([], kept)).toEqual({ reports: kept, dropped: [] });
  });

  it("gives the match module only reports it takes: with a ghost's, a step throws; filtered, it counts the known players'", () => {
    const config = createMatchConfig({ kind: "private", rules: { ...matchRules, readyTicks: 1, departureTicks: 1 } });
    let state = createMatchState(config);
    state = stepMatch(config, state, { tick: 1, reports: [{ kind: "join", playerId: "a" }, { kind: "join", playerId: "b" }, { kind: "start", playerId: "a" }] }).state;
    state = stepMatch(config, state, { tick: 2, reports: [] }).state;
    expect(state.controlStartTick).toBe(2);
    const reports: MatchReport[] = [
      { kind: "collected", playerId: "ghost" },
      { kind: "collected", playerId: "a" },
      { kind: "duel-ended", playerIds: ["ghost", "b"], winner: "ghost" },
      { kind: "duel-ended", playerIds: ["a", "b"], winner: "a" },
      { kind: "match-ended", tick: 3, reason: "claim", winner: "ghost" },
    ];
    expect(() => stepMatch(config, state, { tick: 3, reports })).toThrow(/unknown player ghost/);
    const known = knownFlowReports(state.players, reports);
    expect(known.dropped).toHaveLength(3);
    const stepped = stepMatch(config, state, { tick: 3, reports: known.reports });
    expect(stepped.state.end).toBeNull();
    const stats = Object.fromEntries(stepped.state.players.map((player) => [player.id, player.stats]));
    expect(stats["a"]).toMatchObject({ collected: 1, duelsWon: 1, duelsLost: 0 });
    expect(stats["b"]).toMatchObject({ collected: 0, duelsWon: 0, duelsLost: 1 });
  });
});
