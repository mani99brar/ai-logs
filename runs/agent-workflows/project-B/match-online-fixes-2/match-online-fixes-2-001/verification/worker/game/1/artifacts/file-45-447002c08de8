import { expect, test } from "@playwright/test";
import { PROTOCOL_VERSION } from "../../packages/protocol/src/version.js";
import { compassHeading, seaMap } from "../../packages/content/src/index.js";
import { attachScreenshot, clearCourse, createMatch, joinMatch, listedIds, place, readout, selfId, shipsOnCanvas, startMatch, TILE } from "./helpers.js";

/** An open stretch of sea: the row three tiles south of the hub, which the map keeps clear for 20 tiles either side. */
const OPEN_ROW = seaMap.hub.tileY + 3;
const centre = (tileX: number, tileY: number) => ({ x: tileX * TILE + TILE / 2, y: tileY * TILE + TILE / 2 });

test("create a private match from the landing page and see it in the HUD [scenario:join-private-match]", async ({ page }, testInfo) => {
  await page.goto("/");
  await expect(page.getByRole("heading", { name: "Pirate Sea Race" })).toBeVisible();

  // An unknown code is refused on the landing page.
  await page.getByLabel("Match code").fill("zzzzz9");
  await page.getByRole("button", { name: "Join", exact: true }).click();
  await expect(page.getByTestId("join-error")).toHaveText("No match with that code");

  await page.getByRole("button", { name: "Create match" }).click();
  await expect(page.getByTestId("hud-status")).toHaveText("connected");
  await expect(page.getByTestId("hud-code")).toHaveText(/^[A-Z0-9]{6}$/);
  await expect(page.getByTestId("hud-protocol")).toHaveText(`v${PROTOCOL_VERSION}`);
  await expect(page.getByTestId("hud-players")).toHaveText("1");
  await expect(page.getByTestId("hud-mode")).toHaveText("custom");
  await expect(page.getByTestId("hud-dock")).toHaveText("at sea");
  await expect(page.getByRole("button", { name: "Create match" })).toBeHidden();
  // The lobby (§2): the code, the one player (the host), and a Start button that waits for a second player.
  await expect(page.getByTestId("lobby")).toBeVisible();
  await expect(page.getByTestId("lobby-code")).toHaveText((await page.getByTestId("hud-code").textContent())!);
  await expect(page.getByTestId("lobby-players").getByRole("listitem")).toHaveText(["Player 1 (you, host)"]);
  await expect(page.getByRole("button", { name: "Start match" })).toBeDisabled();
  await expect(page.getByTestId("lobby-hint")).toContainText("2 or more start a match");
  await expect(page.getByTestId("match-timer")).toHaveText("10:00");

  // The player's ship is drawn on the map, and the minimap's fog has cleared around it.
  const self = await selfId(page);
  await expect.poll(() => shipsOnCanvas(page)).toEqual([self]);
  expect(Number(await page.getByTestId("game").getAttribute("data-fog-revealed"))).toBeGreaterThan(100);

  await attachScreenshot(page, testInfo, "join-private-match");
});

test("a ship sailed in one browser moves in the other, in sight of it [scenario:two-ships-sync]", async ({ browser, request }, testInfo) => {
  const hostContext = await browser.newContext();
  const guestContext = await browser.newContext();
  try {
    const host = await hostContext.newPage();
    const guest = await guestContext.newPage();

    const code = await createMatch(host);
    await joinMatch(guest, code.toLowerCase());
    await expect(guest.getByTestId("hud-code")).toHaveText(code);
    await expect(host.getByTestId("hud-players")).toHaveText("2");
    await expect(guest.getByTestId("hud-players")).toHaveText("2");
    await startMatch(host, guest);

    // On open sea, both heading east, the guest a little ahead: the host sails past it and stays well in sight. The
    // host's row is clear for a hull well beyond where it coasts to a stop.
    const [hostX, guestX] = [seaMap.hub.tileX - 6, seaMap.hub.tileX - 2];
    expect(clearCourse(centre(hostX, OPEN_ROW), centre(hostX + 16, OPEN_ROW))).toBe(true);
    await place(request, host, code, hostX, OPEN_ROW, compassHeading("E"));
    await place(request, guest, code, guestX, OPEN_ROW + 2, compassHeading("E"));
    const hostId = await selfId(host);
    const guestId = await selfId(guest);
    await expect.poll(() => listedIds(guest)).toEqual([hostId, guestId].sort());
    const start = (await readout(guest, hostId))!;
    const guestStart = (await readout(guest, guestId))!;

    // The host sails ahead with the keyboard; the guest's readout follows the server.
    await host.keyboard.down("ArrowUp");
    await expect.poll(async () => ((await readout(guest, hostId))?.x ?? start.x) - start.x, { timeout: 10_000 }).toBeGreaterThan(2 * TILE);
    await host.keyboard.up("ArrowUp");

    // Once the ship has coasted to a stop, both browsers show the same authoritative position.
    await expect.poll(async () => (await readout(host, hostId))?.speed, { timeout: 10_000 }).toBe(0);
    await expect
      .poll(async () => {
        const [inHost, inGuest] = await Promise.all([readout(host, hostId), readout(guest, hostId)]);
        return inHost !== undefined && inGuest !== undefined && inHost.x === inGuest.x && inHost.y === inGuest.y;
      })
      .toBe(true);
    const settled = (await readout(guest, hostId))!;
    expect(settled.x - start.x).toBeGreaterThan(2 * TILE);
    expect(settled.y).toBe(start.y);
    expect(settled.speed).toBe(0);
    expect(await readout(host, hostId)).toEqual(settled);
    expect(await readout(guest, guestId)).toEqual(guestStart);

    // Both ships are drawn on the guest's canvas.
    await expect.poll(() => shipsOnCanvas(guest)).toEqual([hostId, guestId].sort());

    await attachScreenshot(guest, testInfo, "two-ships-sync");
  } finally {
    await hostContext.close();
    await guestContext.close();
  }
});
