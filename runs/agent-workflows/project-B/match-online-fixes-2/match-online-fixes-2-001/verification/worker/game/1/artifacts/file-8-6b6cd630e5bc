import { chooseFinalSocket, type SeaMapDefinition } from "@pirate-sea-race/content";
import { createClaimConfig, type ClaimConfig, type ClaimPoint, type ClaimRules } from "@pirate-sea-race/simulation/claim";
import type { EncounterRules } from "@pirate-sea-race/simulation/encounters";
import { createIntelConfig, type IntelConfig, type IntelRecipients, type IntelRules } from "@pirate-sea-race/simulation/intel";
import { createMatchConfig, type MatchConfig, type MatchRules } from "@pirate-sea-race/simulation/match";
import type { ObjectiveRules } from "@pirate-sea-race/simulation/objectives";
import { MATCH_PRESET } from "./objectives.js";

/**
 * The match flow's configs (§2, §5), built from one set of rules so they cannot disagree: the match module's timer
 * runs for exactly the claim rules' `deadlineTicks` (the claim deadline and the 35:00 timer are one number), its
 * departure lasts exactly the encounter rules' spawn protection, and its starting gold is the ledger's.
 */
export interface FlowRules {
  /** §2's lobby and ready check. `departureTicks` is ignored: the departure is the encounter rules' spawn protection. */
  readonly match: MatchRules;
  /** §5's channel, circle and §2's deadline. */
  readonly claim: ClaimRules;
  /** §2's minute-20 and minute-28 reveals. */
  readonly intel: IntelRules;
  readonly encounters: EncounterRules;
  readonly objectives: ObjectiveRules;
}

/**
 * The lobby-to-results config of a private match. The private minimum is the match module's (`PRIVATE_MIN_PLAYERS`,
 * 2): the content's older `privateMatch.minPlayers` (1) is stale and not read.
 */
export function matchConfigFor(rules: FlowRules): MatchConfig {
  return createMatchConfig({
    kind: "private",
    rules: { ...rules.match, departureTicks: rules.encounters.spawnProtectionTicks },
    durationTicks: rules.claim.deadlineTicks,
    startingGold: rules.objectives.startingGold,
  });
}

/** The claim config once player control starts on `controlStartTick`: its deadline is the timer's end. */
export function claimConfigFor(rules: FlowRules, claimPoint: ClaimPoint, controlStartTick: number, map: SeaMapDefinition): ClaimConfig {
  return createClaimConfig({ claimPoint, controlStartTick, rules: rules.claim, subUnitsPerTile: map.subUnitsPerTile });
}

/** The intel config once player control starts: the reveals count from `controlStartTick`. */
export function intelConfigFor(rules: FlowRules, claimPoint: ClaimPoint, controlStartTick: number, map: SeaMapDefinition): IntelConfig {
  return createIntelConfig({ preset: MATCH_PRESET, finalIsland: claimPoint, controlStartTick, map, rules: rules.intel });
}

/** The final island (§3, §5): the socket a secret picks, and its claim point, the centre of its claim tile. */
export function finalIslandOf(map: SeaMapDefinition, secret: number): { readonly socket: number; readonly claimPoint: ClaimPoint } {
  const socket = chooseFinalSocket(map, secret);
  const tile = map.finalSockets[socket]!.claimTile;
  const half = Math.floor(map.subUnitsPerTile / 2);
  return { socket, claimPoint: { x: tile.tileX * map.subUnitsPerTile + half, y: tile.tileY * map.subUnitsPerTile + half } };
}

/** Who an intel message goes to (§16): every connected client, one player, or a set of players. */
export function revealRecipients(to: IntelRecipients, connected: readonly string[]): readonly string[] {
  switch (to.kind) {
    case "everyone":
      return connected;
    case "player":
      return [to.playerId];
    default:
      return [...to.playerIds];
  }
}
