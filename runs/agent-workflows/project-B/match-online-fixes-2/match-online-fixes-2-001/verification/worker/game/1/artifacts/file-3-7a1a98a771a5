import { DEFAULT_PORT, startGameServer } from "./server.js";
import { testSettingsFrom } from "./testSettings.js";

/**
 * The development and test entry point (`npm run dev`, and `start:source` for the browser tests). Unlike the
 * production entry (`main.ts`), it reads the test-only settings (`testSettingsFrom`), each off unless its variable is
 * set: PIRATE_SEA_RACE_TEST_PLACEMENT=1 turns on the routes that put ships on chosen tiles and give the next match its
 * own timings; PIRATE_SEA_RACE_TEST_SOURCES pins every match's source layout (for example
 * `sun,sun|moon,moon|sun,sun|moon,moon`), so a scenario can pick an island by its rubbing type;
 * PIRATE_SEA_RACE_TEST_TIMINGS shortens the ready countdown, the departure's protection, the match and its reveals (for
 * example `ready=60,protection=20,match=12000`); and PIRATE_SEA_RACE_TEST_FINAL_SECRET pins the secret the final
 * island's socket is picked with.
 */
const port = Number(process.env["PORT"] ?? DEFAULT_PORT);
const { testPlacement, matchTuning, described } = testSettingsFrom(process.env);
const running = await startGameServer({ port, testPlacement, matchTuning });
console.log(`Pirate Sea Race server listening on ws://localhost:${running.port}${described.length > 0 ? ` (${described.join(", ")})` : ""}`);
