});

describe("the route and the claim (§5)", () => {
  it("points the compass at the final island for the holder, and says when the route is inactive", () => {
    expect(routeLine(undefined, undefined, TILE)).toEqual({ text: "", state: "none" });
    expect(routeLine(noClaim, { x: 0, y: 0 }, TILE)).toEqual({ text: "", state: "none" });
    expect(routeLine({ ...holder, routeActive: false }, { x: 0, y: 0 }, TILE)).toEqual({ text: "Route inactive: win back the rubbing you lost", state: "inactive" });
    // Ten tiles west and ten north of the island: it lies south-east.
    const own = { x: holder.routeX - 10 * TILE, y: holder.routeY - 10 * TILE };
    const line = routeLine(holder, own, TILE);
    expect(line).toMatchObject({ text: "Treasure: 14 tiles south-east", state: "active", distanceTiles: 14 });
    expect(line.bearing).toBeCloseTo(Math.PI / 4);
    expect(routeLine(holder, { x: holder.routeX, y: holder.routeY }, TILE).text).toBe("Treasure: right here");
  });

  it("guides the holder into the circle, shows the channel with its risk, and says why a channel reset", () => {
    const radius = 4 * TILE;
    expect(insideCircle(holder, { x: holder.routeX + radius, y: holder.routeY }, radius)).toBe(true);
    expect(insideCircle(holder, { x: holder.routeX + radius + 1, y: holder.routeY }, radius)).toBe(false);
    // Without a known route there is no circle to be in.
    expect(insideCircle({ ...holder, routeKnown: false }, { x: holder.routeX, y: holder.routeY }, radius)).toBe(false);
    expect(claimLines(noClaim, context).claim.state).toBe("none");
    expect(claimLines(holder, context).claim).toEqual({ text: "Sail into the treasure circle to claim", state: "route" });
    expect(claimLines(holder, { ...context, inCircle: true, speed: 12 }).claim.state).toBe("slow");
    const ready = claimLines(holder, { ...context, inCircle: true });
    expect(ready.claim).toEqual({ text: "Hold E to claim the treasure (ten seconds)", state: "ready" });
    expect(ready.risk).toEqual({ text: "Any rival in range can interrupt you with a grapple", state: "risk" });
    const channel = claimLines({ ...holder, claim: "channel", claimHeld: 50 }, { ...context, inCircle: true });
    expect(channel.claim).toEqual({ text: "Claiming the treasure: keep holding E, 8 s left", state: "channel", seconds: 8 });
    expect(channel.progress).toBe(0.25);
    expect(channel.risk.state).toBe("risk");
    // A reset names its reason for five seconds.
    const moved = { ...holder, claimInterrupt: "moved", claimInterruptAt: 950 };
    expect(claimLines(moved, { ...context, inCircle: true }).claim).toEqual({ text: "Claim interrupted: you moved. Progress lost.", state: "interrupted:moved" });
    expect(claimLines({ ...moved, claimInterrupt: "duel" }, context).claim.text).toBe("Claim interrupted: a rival grappled you. Progress lost.");
    expect(claimLines(moved, { ...context, inCircle: true, worldTick: 1051 }).claim.state).toBe("ready");
    expect(claimLines({ ...holder, claim: "waiting" }, context).claim.state).toBe("waiting");
    // Nothing once the match is over.
    expect(claimLines({ ...holder, claim: "channel" }, { ...context, phase: "ended" }).claim.state).toBe("none");
  });

  it("names every reset reason of the claim module in the claim line, with no risk line", () => {
    const reasons: Record<string, string> = {
      moved: "you moved",
      released: "you let go of E",
      duel: "a rival grappled you",
      disconnected: "you disconnected",
      // A lost type: the claim module's own reset (the room's duel reservation resets a channel first, docs/architecture.md).
      ineligible: "you no longer hold every rubbing",
      deadline: "time ran out",
    };
    for (const [reason, text] of Object.entries(reasons)) {
      const lines = claimLines({ ...holder, claimInterrupt: reason, claimInterruptAt: 950 }, { ...context, inCircle: true });
      expect(lines.claim).toEqual({ text: `Claim interrupted: ${text}. Progress lost.`, state: `interrupted:${reason}` });
      expect(lines.risk.state).toBe("none");
      expect(lines.progress).toBe(0);
    }
    // A lost type after the reset still shows why for five seconds, before the route goes inactive.
    const lost = { ...holder, fullSet: false, routeActive: false, claimInterrupt: "ineligible", claimInterruptAt: 950 };
    expect(claimLines(lost, context).claim.state).toBe("interrupted:ineligible");
    expect(claimLines(lost, { ...context, worldTick: 1051 }).claim.state).toBe("none");
  });
});

describe("the results screen (§2)", () => {
  const lines = [
    { seat: 1, winner: true, left: false, collected: 2, thefts: 1, lost: 0, duelsWon: 1, duelsLost: 0, duelsDrawn: 0, gold: 60, cachesClaimed: 0, islandsVisited: 2 },
    { seat: 2, winner: false, left: true, collected: 1, thefts: 0, lost: 1, duelsWon: 0, duelsLost: 1, duelsDrawn: 2, gold: 40, cachesClaimed: 1, islandsVisited: 1 },
  ];

  it("names the winner, or says there is none and why, and lists every player's accomplishments", () => {
    expect(resultsModel({ endReason: "", winnerSeat: 0, seat: 1, hostSeat: 1, lines: [] })).toBeUndefined();
    const won = resultsModel({ endReason: "claim", winnerSeat: 1, seat: 1, hostSeat: 1, lines })!;
    expect(won.headline).toBe("You claimed the treasure!");
    expect(won.rows).toEqual([
      { seat: 1, label: "Player 1 (you)", winner: true, left: false, cells: [2, 1, 0, 1, 0, 0, 60, 0, 2] },
      { seat: 2, label: "Player 2 (left)", winner: false, left: true, cells: [1, 0, 1, 0, 1, 2, 40, 1, 1] },
    ]);
    expect(resultsModel({ endReason: "claim", winnerSeat: 1, seat: 2, hostSeat: 1, lines })!.headline).toBe("Player 1 claimed the treasure");
    const timeout = resultsModel({ endReason: "deadline", winnerSeat: 0, seat: 2, hostSeat: 1, lines: lines.map((line) => ({ ...line, winner: false })) })!;
    expect(timeout.headline).toBe("No winner (time ran out)");
    expect(timeout.rows).toHaveLength(2);
    expect(resultsModel({ endReason: "abandoned", winnerSeat: 0, seat: 1, hostSeat: 1, lines })!.headline).toBe("No winner (everyone left)");
    expect(resultsModel({ endReason: "aborted", winnerSeat: 0, seat: 1, hostSeat: 1, lines })!.headline).toBe("No winner (match aborted)");
  });
});

describe("a rival's claim in sight (§5)", () => {
  it("warns a player who sees another ship channelling the claim, whatever they hold", () => {
    const warned = claimLines(noClaim, { ...context, rivalClaiming: true });
    expect(warned.claim).toEqual({ text: "A rival is claiming the treasure! Grapple them before the channel completes", state: "rival" });
    // The claimer's own channel comes first, and nothing shows once the match is over.
    expect(claimLines({ ...holder, claim: "channel", claimHeld: 20 }, { ...context, inCircle: true, rivalClaiming: true }).claim.state).toBe("channel");
    expect(claimLines(noClaim, { ...context, rivalClaiming: true, phase: "ended" }).claim.state).toBe("none");
  });
});

describe("the flow's view of the page (flowView: what renderFlow writes, element by element)", () => {
  const noResults = { endReason: "", winnerSeat: 0, seat: 1, hostSeat: 1, lines: [] };
  const playing: FlowModel = {
    code: "ABC123",
    rivalClaiming: false,
    lobby: { ...lobby, seats: [1, 2], phase: "exploration", worldTick: 1000 },
    remainingTicks: 9000,
    finalSector: "",
    claim: noClaim,
    own: { x: 0, y: 0, speed: 0 },
    treasureRadius: 4 * TILE,
    subUnitsPerTile: TILE,
    results: noResults,
  };
  const at = (phase: string): FlowModel => ({ ...playing, lobby: { ...playing.lobby, phase } });

  it("shows the compass only in play: inactive with no route known (no status yet, or none revealed), or with a lost type", () => {
    for (const phase of ["lobby", "ready", "ended"]) expect(flowView(at(phase)).compass.hidden).toBe(true);
    const unknown = { hidden: false, state: "none", active: false, bearing: 0, distance: undefined, text: NO_ROUTE_TEXT };
    // Absent: this player's status has not arrived.
    expect(flowView({ ...playing, claim: undefined }).compass).toEqual(unknown);
    expect(flowView(playing).compass).toEqual(unknown);
    expect(flowView(at("departure")).compass).toEqual(unknown);
    expect(flowView(playing).route).toEqual({ text: "", state: "none" });
    expect(flowView({ ...playing, claim: { ...holder, routeActive: false } }).compass).toEqual({
      hidden: false,
      state: "inactive",
      active: false,
      bearing: 0,
      distance: undefined,
      text: "Route inactive: win back the rubbing you lost",
    });
  });

  it("points the compass along an active route, with the distance when the ship's position is known", () => {
    const own = { x: holder.routeX - 10 * TILE, y: holder.routeY - 10 * TILE, speed: 0 };
    const compass = flowView({ ...playing, claim: holder, own }).compass;
    expect(compass).toMatchObject({ hidden: false, state: "active", active: true, distance: "14", text: "Treasure: 14 tiles south-east" });
    expect(compass.bearing).toBeCloseTo(Math.PI / 4);
    expect(flowView({ ...playing, claim: holder, own: undefined }).compass).toEqual({
      hidden: false,
      state: "active",
      active: true,
      bearing: 0,
      distance: undefined,
      text: "Treasure route active",
    });
  });

  it("heads the results with the winner or with each no-winner ending, and shows them only once the match has ended", () => {
    const lines = [
      { seat: 1, winner: true, left: false, collected: 2, thefts: 1, lost: 0, duelsWon: 1, duelsLost: 0, duelsDrawn: 0, gold: 60, cachesClaimed: 0, islandsVisited: 2 },
      { seat: 2, winner: false, left: true, collected: 1, thefts: 0, lost: 1, duelsWon: 0, duelsLost: 1, duelsDrawn: 2, gold: 40, cachesClaimed: 1, islandsVisited: 1 },
    ];
    const ended = (endReason: string, winnerSeat: number, seat: number) => flowView({ ...at("ended"), results: { endReason, winnerSeat, seat, hostSeat: 1, lines } }).results;
    expect(flowView(playing).results).toEqual({ hidden: true, reason: "", winnerSeat: "0", headline: "", detail: "", rows: [] });
    expect(ended("claim", 1, 1)).toMatchObject({ hidden: false, reason: "claim", winnerSeat: "1", headline: "You claimed the treasure!", detail: "The One Piece is yours. Victory." });
    expect(ended("claim", 1, 2)).toMatchObject({ headline: "Player 1 claimed the treasure", detail: "The race is over." });
    expect(ended("deadline", 0, 2)).toMatchObject({ hidden: false, reason: "deadline", winnerSeat: "0", headline: "No winner (time ran out)", detail: "Nobody claimed the treasure before the deadline." });
    expect(ended("abandoned", 0, 1)).toMatchObject({ reason: "abandoned", headline: "No winner (everyone left)", detail: "The match was abandoned." });
    expect(ended("aborted", 0, 1)).toMatchObject({
      reason: "aborted",
      headline: "No winner (match aborted)",
      detail: "A server fault stopped the match. No result counts against anyone.",
    });
    // Each row as shown: the winner's trophy, then the nine columns.
    expect(ended("claim", 1, 2).rows).toEqual([
      { seat: "1", winner: "true", cells: ["Player 1 🏆", "2", "1", "0", "1", "0", "0", "60", "0", "2"] },
      { seat: "2", winner: "false", cells: ["Player 2 (you) (left)", "1", "0", "1", "0", "1", "2", "40", "1", "1"] },
    ]);
  });

  it("shows the lobby (in place of the purse) until control starts, with the host's Start and the ready check's seconds", () => {
    const host = flowView({ ...at("lobby"), lobby: { ...playing.lobby, phase: "lobby" } }).lobby;
    expect(host).toEqual({
      hidden: false,
      purseHidden: true,
      code: "ABC123",
      players: [
        { seat: 1, label: "Player 1 (you, host)" },
        { seat: 2, label: "Player 2" },
      ],
      startHidden: false,
      startDisabled: false,
      hint: { text: "Everyone aboard? Start the match.", state: "lobby" },
    });
    const guest = flowView({ ...playing, lobby: { ...playing.lobby, phase: "lobby", seat: 2 } }).lobby;
    expect(guest).toMatchObject({ startHidden: true, startDisabled: true, hint: { text: "Waiting for the host to start the match.", state: "lobby" } });
    const alone = flowView({ ...playing, lobby: { ...playing.lobby, phase: "lobby", seats: [1] } }).lobby;
    expect(alone).toMatchObject({ startHidden: false, startDisabled: true });
    const ready = flowView({ ...playing, lobby: { ...playing.lobby, phase: "ready", readyEndsAt: 1060 } }).lobby;
    expect(ready).toMatchObject({ hidden: false, purseHidden: true, startHidden: true, startDisabled: true, hint: { state: "ready", seconds: 3 } });
    for (const phase of ["departure", "exploration", "ended"]) expect(flowView(at(phase)).lobby).toMatchObject({ hidden: true, purseHidden: false });
  });

  it("writes the clock bar: the phase, the timer and its remaining ticks, and the sector once announced", () => {
    const view = flowView(playing);
    expect(view.phase).toEqual({ text: "Exploration", state: "exploration" });
    expect(view.timer).toEqual({ text: "7:30", state: "running" });
    expect(view.remaining).toBe("9000");
    expect(view.sector).toBe("");
    expect(flowView({ ...playing, finalSector: "Northern Waters" }).sector).toBe("Treasure sector: Northern Waters");
    expect(flowView({ ...at("ended"), remainingTicks: 0 }).timer).toEqual({ text: "0:00", state: "ended" });
  });

  it("shows the claim panel only with something to say, and the progress bar only while channelling", () => {
    expect(flowView(playing).claim).toEqual({
      panelHidden: true,
      text: { text: "", state: "none" },
      risk: { text: "", state: "none" },
      progressHidden: true,
      progress: 0,
      held: "0",
      total: "200",
    });
    expect(flowView({ ...playing, claim: undefined }).claim).toMatchObject({ panelHidden: true, held: "0", total: "0" });
    const inCircle = { x: holder.routeX, y: holder.routeY, speed: 0 };
    expect(flowView({ ...playing, claim: holder, own: inCircle }).claim).toMatchObject({ panelHidden: false, progressHidden: true, text: { state: "ready" } });
    const channel = flowView({ ...playing, claim: { ...holder, claim: "channel", claimHeld: 100 }, own: inCircle }).claim;
    expect(channel).toMatchObject({ panelHidden: false, progressHidden: false, progress: 0.5, held: "100", total: "200", risk: { state: "risk" } });
    // A rival's claim in sight, and the speed of a ship that has not stopped.
    expect(flowView({ ...playing, rivalClaiming: true }).claim.text.state).toBe("rival");
    expect(flowView({ ...playing, claim: holder, own: { ...inCircle, speed: 3 } }).claim.text.state).toBe("slow");
  });
});

describe("the flow's model from the synced state (flowModelOf, what main.ts renders)", () => {
  const ship = (id: string, claiming = false, claimHeld = 0) => ({ id, x: 100, y: 200, speed: 3, claiming, claimHeld });
  const full = {
    code: "ABC123",
    worldTick: 500,
    phase: "exploration",
    hostSeat: 1,
    minPlayers: 2,
    readyEndsAt: 0,
    remainingTicks: 4000,
    finalSector: "Northern Waters",
    treasureRadius: 1024,
    endReason: "",
    winnerSeat: 0,
    roster: new Map([["2", { seat: 2 }], ["1", { seat: 1 }]]),
    results: [],
    status: new Map([["me", { seat: 2, fullSet: true, routeKnown: true, routeActive: true, routeX: 7, routeY: 8, claim: "channel", claimHeld: 20, claimTotal: 200, claimInterrupt: "moved", claimInterruptAt: 9 }]]),
    ships: new Map([["me", ship("me")], ["rival", ship("rival")]]),
  };

  it("reads the public state and this player's own status and ship", () => {
    const model = flowModelOf(full, "me", TILE);
    expect(model).toEqual({
      code: "ABC123",
      rivalClaiming: false,
      lobby: { phase: "exploration", seats: [2, 1], hostSeat: 1, seat: 2, minPlayers: 2, readyEndsAt: 0, worldTick: 500 },
      remainingTicks: 4000,
      finalSector: "Northern Waters",
      claim: { fullSet: true, routeKnown: true, routeActive: true, routeX: 7, routeY: 8, claim: "channel", claimHeld: 20, claimTotal: 200, claimInterrupt: "moved", claimInterruptAt: 9 },
      own: { x: 100, y: 200, speed: 3 },
      treasureRadius: 1024,
      subUnitsPerTile: TILE,
      results: { endReason: "", winnerSeat: 0, seat: 2, hostSeat: 1, lines: [] },
    });
  });

  it("falls back to empty values before the first patch: no status, no ship, no roster or results yet", () => {
    expect(flowModelOf({ code: "", worldTick: 0 }, "me", TILE)).toEqual({
      code: "",
      rivalClaiming: false,
      lobby: { phase: "", seats: [], hostSeat: 0, seat: 0, minPlayers: 2, readyEndsAt: 0, worldTick: 0 },
      remainingTicks: 0,
      finalSector: "",
      claim: undefined,
      own: undefined,
      treasureRadius: 0,
      subUnitsPerTile: TILE,
      results: { endReason: "", winnerSeat: 0, seat: 0, hostSeat: 0, lines: [] },
    });
    // A status whose fields have not arrived reads as no route and no claim.
    expect(flowModelOf({ code: "", worldTick: 0, status: new Map([["me", {}]]) }, "me", TILE).claim).toEqual({ ...noClaim, claimTotal: 0 });
  });

  it("warns of a rival's claim only when another ship in view is channelling it, and lists the claiming ships", () => {
    const rival = { ...full, ships: new Map([["me", ship("me")], ["rival", ship("rival", true, 50)]]) };
    expect(flowModelOf(rival, "me", TILE).rivalClaiming).toBe(true);
    expect(claimingShipsOf(rival)).toEqual(new Map([["rival", 50]]));
    const mine = { ...full, ships: new Map([["me", ship("me", true, 30)], ["rival", ship("rival")]]) };
    expect(flowModelOf(mine, "me", TILE).rivalClaiming).toBe(false);
    expect(claimingShipsOf(mine)).toEqual(new Map([["me", 30]]));
    expect(claimingShipsOf({ code: "", worldTick: 0 })).toEqual(new Map());
    expect(claimingShipsOf({ code: "", worldTick: 0, ships: new Map([["x", { id: "x", x: 0, y: 0, speed: 0, claiming: true }]]) })).toEqual(new Map([["x", 0]]));
  });

  it("shows only a real start refusal and a real reveal from the server", () => {
    const lines: string[] = [];
    showStartRefusal({ reason: "not-host" }, (line) => lines.push(line));
    showStartRefusal({ reason: "bogus" }, (line) => lines.push(line));
    showStartRefusal(undefined, (line) => lines.push(line));
    expect(lines).toEqual(["Only the host can start the match."]);
    const banners: string[] = [];
    showReveal({ kind: "final-sector", tick: 5, sector: 1, name: "Northern Waters" }, (banner) => banners.push(banner.title));
    showReveal({ kind: "rumor", tick: 5 }, (banner) => banners.push(banner.title));
    showReveal("final-sector", (banner) => banners.push(banner.title));
    expect(banners).toEqual(["A full set of rubbings exists!"]);
  });
});

describe("the flow's edge cases before the state is complete", () => {
  it("offers no Start to a player whose seat has not arrived, even while the match has no host", () => {
    expect(lobbyModel({ ...lobby, seats: [1, 2], seat: 0, hostSeat: 0 })).toMatchObject({ showStart: false, canStart: false });
    expect(lobbyModel({ ...lobby, seats: [1, 2], seat: 0, hostSeat: 0 }).hint).toBe("Waiting for the host to start the match.");
  });

  it("shows no progress for a channel whose length has not arrived", () => {
    expect(claimLines({ ...holder, claim: "channel", claimHeld: 0, claimTotal: 0 }, { ...context, inCircle: true }).progress).toBe(0);
  });

  it("finds this player's own ship among the ships in view, whatever their order", () => {
    const ships = new Map([
      ["rival", { id: "rival", x: 1, y: 2, speed: 5 }],
      ["me", { id: "me", x: 3, y: 4, speed: 0 }],
    ]);
    expect(flowModelOf({ code: "", worldTick: 0, ships }, "me", TILE).own).toEqual({ x: 3, y: 4, speed: 0 });
    expect(flowModelOf({ code: "", worldTick: 0, ships }, "gone", TILE).own).toBeUndefined();
  });
});
