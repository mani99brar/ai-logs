const TILE = seaMap.subUnitsPerTile;
const lobby: LobbyState = { phase: "lobby", seats: [1], hostSeat: 1, seat: 1, minPlayers: 2, readyEndsAt: 0, worldTick: 100 };
const noClaim: ClaimStatus = {
  fullSet: false,
  routeKnown: false,
  routeActive: false,
  routeX: 0,
  routeY: 0,
  claim: "",
  claimHeld: 0,
  claimTotal: 200,
  claimInterrupt: "",
  claimInterruptAt: 0,
};
const holder: ClaimStatus = { ...noClaim, fullSet: true, routeKnown: true, routeActive: true, routeX: 50 * TILE + 128, routeY: 20 * TILE + 128 };
const context = { inCircle: false, speed: 0, worldTick: 1000, phase: "exploration" };

describe("the lobby (§2)", () => {
  it("lists the players by seat, marks the host and the player, and lets only the host start with two or more", () => {
    expect(seatLabel(1, 1, 1)).toBe("Player 1 (you, host)");
    expect(seatLabel(2, 1, 1)).toBe("Player 2");
    expect(seatLabel(2, 2, 1)).toBe("Player 2 (you)");
    // The host alone: the button shows, disabled, and the lobby says why.
    expect(lobbyModel(lobby)).toEqual({
      players: [{ seat: 1, label: "Player 1 (you, host)" }],
      showStart: true,
      canStart: false,
      hint: "Waiting for players: 2 or more start a match. Share the code.",
    });
    // Two players: the host may start; the guest sees no button.
    const two = { ...lobby, seats: [2, 1] };
    expect(lobbyModel(two)).toMatchObject({ showStart: true, canStart: true, hint: "Everyone aboard? Start the match." });
    expect(lobbyModel(two).players.map((player) => player.seat)).toEqual([1, 2]);
    expect(lobbyModel({ ...two, seat: 2 })).toMatchObject({ showStart: false, canStart: false, hint: "Waiting for the host to start the match." });
    expect(startRefusalText("too-few")).toBe("A private match needs at least two players to start.");
    expect(startRefusalText("not-host")).toBe("Only the host can start the match.");
    // What main.ts shows for the server's refusal message: only a valid one.
    expect(startRefusalLine({ reason: "too-few" })).toBe("A private match needs at least two players to start.");
    expect(startRefusalLine({ reason: "public" })).toBe("This match starts when its seats fill.");
    expect(startRefusalLine({ reason: "bogus" })).toBeUndefined();
    expect(startRefusalLine("too-few")).toBeUndefined();
  });

  it("counts the ready check down to control start while the arena loads", () => {
    const ready = { ...lobby, seats: [1, 2], phase: "ready", readyEndsAt: 500, worldTick: 381 };
    expect(lobbyModel(ready)).toMatchObject({ showStart: false, canStart: false, hint: "Setting sail in 6 s: the arena loads meanwhile" });
    expect(phaseText("ready")).toBe("Ready check");
    expect(phaseText("departure")).toBe("Departure (protected)");
  });

  it("names every phase of the match in the clock bar", () => {
    expect(["lobby", "ready", "departure", "exploration", "ended", "unknown"].map(phaseText)).toEqual(["Lobby", "Ready check", "Departure (protected)", "Exploration", "Match over", ""]);
  });
});

describe("the match timer (§2)", () => {
  it("shows minutes and seconds, rounded up, and flags the last minute", () => {
    expect(clockText(42_000)).toBe("35:00");
    expect(clockText(41_999)).toBe("35:00");
    expect(clockText(41_980)).toBe("34:59");
    expect(clockText(1200)).toBe("1:00");
    expect(clockText(0)).toBe("0:00");
    expect(timerLine({ phase: "lobby", remainingTicks: 42_000 })).toEqual({ text: "35:00", state: "waiting" });
    expect(timerLine({ phase: "exploration", remainingTicks: 1201 })).toEqual({ text: "1:01", state: "running" });
    expect(timerLine({ phase: "exploration", remainingTicks: 1200 })).toEqual({ text: "1:00", state: "urgent" });
    expect(timerLine({ phase: "ended", remainingTicks: 0 })).toEqual({ text: "0:00", state: "ended" });
  });

  it("reads 35:00 at control start from the match module's remaining time, and 0:00 exactly at the claim deadline", () => {
    const config = createMatchConfig({ kind: "private" });
    let state = createMatchState(config);
    state = stepMatch(config, state, { tick: 1, reports: [{ kind: "join", playerId: "a" }, { kind: "join", playerId: "b" }] }).state;
    state = stepMatch(config, state, { tick: 2, reports: [{ kind: "start", playerId: "a" }] }).state;
    const controlStart = 2 + config.readyTicks;
    state = stepMatch(config, state, { tick: controlStart, reports: [] }).state;
    expect(state.controlStartTick).toBe(controlStart);
    const claim = createClaimConfig({ claimPoint: { x: 0, y: 0 }, controlStartTick: controlStart });
    expect(clockText(remaining(state, controlStart))).toBe("35:00");
    expect(clockText(remaining(state, controlStart + 20))).toBe("34:59");
    expect(clockText(remaining(state, claim.deadlineTick - 1))).toBe("0:01");
    expect(remaining(state, claim.deadlineTick)).toBe(0);
    expect(timerLine({ phase: "exploration", remainingTicks: remaining(state, claim.deadlineTick) }).text).toBe("0:00");
  });
});

describe("the reveals' banners (§2, §5)", () => {
  it("announce the sector to everyone, the route to the holder, a lost route, and the minute-20 and minute-28 broadcasts", () => {
    expect(revealBanner({ kind: "final-sector", tick: 5, sector: 1, name: "Northern Waters" })).toEqual({
      kind: "final-sector",
      title: "A full set of rubbings exists!",
      detail: "The treasure lies in Northern Waters. Every ship is heading there.",
      tone: "treasure",
    });
    expect(revealBanner({ kind: "final-route", tick: 5, x: 1, y: 2, restored: false })).toMatchObject({ title: "You hold every rubbing!", tone: "treasure" });
    expect(revealBanner({ kind: "final-route", tick: 5, x: 1, y: 2, restored: true }).title).toBe("Your set is whole again");
    expect(revealBanner({ kind: "final-route-inactive", tick: 5 })).toMatchObject({ title: "You lost a rubbing", tone: "warning" });
    expect(
      revealBanner({ kind: "sector-reveal", tick: 5, sources: [{ sector: 0, name: "North-West Reach" }], caches: [{ sector: 4, name: "Central Waters" }] }).detail,
