import type { MatchReport as FlowReport } from "@pirate-sea-race/simulation/match";

/** The reports for the flow's next step, and those dropped for naming a player the flow does not know. */
export interface KnownFlowReports {
  readonly reports: readonly FlowReport[];
  readonly dropped: readonly FlowReport[];
}

/**
 * The room's reports as the match module may take them (`stepMatch` throws on an unknown player id): a join makes its
 * player known for the reports after it; a duel's end naming a fighter, a claim's end naming a winner, or an
 * accomplishment naming a player the flow does not know is dropped. A leave or a start of an unknown player is kept
 * (the match module ignores the one and refuses the other), and so is a fault. The order of the kept reports is theirs.
 */
export function knownFlowReports(players: readonly { readonly id: string }[], reports: readonly FlowReport[]): KnownFlowReports {
  const known = new Set(players.map((player) => player.id));
  const kept: FlowReport[] = [];
  const dropped: FlowReport[] = [];
  for (const report of reports) {
    if (report.kind === "join") known.add(report.playerId);
    else if (!namesKnownPlayers(report, known)) {
      dropped.push(report);
      continue;
    }
    kept.push(report);
  }
  return { reports: kept, dropped };
}

function namesKnownPlayers(report: FlowReport, known: ReadonlySet<string>): boolean {
  switch (report.kind) {
    case "duel-ended":
      return report.playerIds.every((id) => known.has(id));
    case "match-ended":
      return report.winner === null || known.has(report.winner);
    case "leave":
    case "start":
    case "fault":
      return true;
    default:
      return known.has(report.playerId);
  }
}
