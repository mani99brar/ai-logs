import type { ClaimStatus } from "./flowHud.js";

/**
 * The final island on the sea (§5), as this player knows it, as plain shapes: the sea scene's `drawTreasure` draws
 * them without deciding anything. Pure, so tests call it without Phaser.
 */

interface Point {
  readonly x: number;
  readonly y: number;
}

/** The sea scene's scales: canvas pixels per sub-unit and per tile, the minimap's, and the art's. */
export interface TreasureGeometry {
  readonly pixelsPerSubUnit: number;
  readonly tilePixels: number;
  readonly minimapScale: number;
  readonly minimapMargin: number;
  readonly artScale: number;
}

export interface TreasureInput {
  /** This player's route and claim, from their private status. */
  readonly claim: ClaimStatus | undefined;
  /** This player's ship where it is drawn, in sub-units, if it is drawn. */
  readonly own: Point | undefined;
  /** The ships in sight channelling a claim, with the ticks held and where each is drawn (if it is). */
  readonly claiming: readonly { readonly id: string; readonly held: number; readonly at: Point | undefined }[];
  /** The treasure circle's radius in sub-units. */
  readonly treasureRadius: number;
  /** Milliseconds, for the active circle's pulse. */
  readonly now: number;
  /** The minimap's left edge on the canvas. */
  readonly minimapLeft: number;
}

export interface TreasureView {
  /** The treasure circle at the route's point: bright and pulsing while the route is active, faint while it is not. */
  readonly circles: readonly { readonly x: number; readonly y: number; readonly radius: number; readonly fillAlpha: number; readonly lineAlpha: number }[];
  /** An X on the spot, on the sea and on the minimap. */
  readonly crosses: readonly { readonly x: number; readonly y: number; readonly half: number; readonly alpha: number }[];
  readonly minimapCrosses: readonly { readonly x: number; readonly y: number; readonly half: number; readonly alpha: number }[];
  /** An arrow off the player's own ship toward the island: an active route, the ship outside the circle. */
  readonly arrows: readonly { readonly points: readonly [number, number, number, number, number, number] }[];
  /** A ring on each drawn ship channelling a claim, filled by the channel's progress (0 to 1). */
  readonly rings: readonly { readonly x: number; readonly y: number; readonly radius: number; readonly fraction: number }[];
  /** `data-route` for the browser tests: "x,y,active", empty without a route. */
  readonly route: string;
  /** `data-claiming`: the ids of the drawn claiming ships, sorted. */
  readonly claiming: string;
}

/** The channel length a claiming ring counts against when this player's status has none yet (the rules' 10 s). */
const DEFAULT_CHANNEL_TICKS = 200;

export function treasureView(input: TreasureInput, geometry: TreasureGeometry): TreasureView {
  const { pixelsPerSubUnit, tilePixels, minimapScale, minimapMargin, artScale } = geometry;
  const claim = input.claim;
  const route = claim !== undefined && claim.routeKnown ? claim : undefined;
  const circles: TreasureView["circles"][number][] = [];
  const crosses: TreasureView["crosses"][number][] = [];
  const minimapCrosses: TreasureView["minimapCrosses"][number][] = [];
  const arrows: TreasureView["arrows"][number][] = [];
  if (route !== undefined) {
    const x = route.routeX * pixelsPerSubUnit;
    const y = route.routeY * pixelsPerSubUnit;
    const radius = input.treasureRadius * pixelsPerSubUnit;
    const alpha = route.routeActive ? 0.55 + 0.3 * Math.abs(Math.sin(input.now / 400)) : 0.25;
    circles.push({ x, y, radius, fillAlpha: route.routeActive ? 0.12 : 0.05, lineAlpha: alpha });
    crosses.push({ x, y, half: 6 * artScale, alpha });
    minimapCrosses.push({ x: input.minimapLeft + (x / tilePixels) * minimapScale, y: minimapMargin + (y / tilePixels) * minimapScale, half: 3, alpha: route.routeActive ? 1 : 0.4 });
    const own = input.own;
    if (own !== undefined && route.routeActive) {
      const ox = own.x * pixelsPerSubUnit;
      const oy = own.y * pixelsPerSubUnit;
      if (Math.hypot(x - ox, y - oy) > radius) {
        const angle = Math.atan2(y - oy, x - ox);
        const near = 16 * artScale;
        const far = 26 * artScale;
        arrows.push({
          points: [
            ox + Math.cos(angle) * far,
            oy + Math.sin(angle) * far,
            ox + Math.cos(angle + 0.3) * near,
            oy + Math.sin(angle + 0.3) * near,
            ox + Math.cos(angle - 0.3) * near,
            oy + Math.sin(angle - 0.3) * near,
          ],
        });
      }
    }
  }
  const total = claim !== undefined && claim.claimTotal > 0 ? claim.claimTotal : DEFAULT_CHANNEL_TICKS;
  const drawn = input.claiming.flatMap(({ id, held, at }) => (at === undefined ? [] : [{ id, held, at }]));
  const rings = drawn.map(({ held, at }) => ({ x: at.x * pixelsPerSubUnit, y: at.y * pixelsPerSubUnit, radius: 16 * artScale, fraction: Math.min(1, held / total) }));
  return {
    circles,
    crosses,
    minimapCrosses,
    arrows,
    rings,
    route: route === undefined ? "" : `${route.routeX},${route.routeY},${route.routeActive}`,
    claiming: drawn
      .map(({ id }) => id)
      .sort()
      .join(","),
  };
}
