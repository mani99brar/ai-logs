import { expect, test } from "@playwright/test";
import { attachScreenshot, createMatch, joinMatch, nextMatchTimings } from "./helpers.js";

/**
 * A match nobody wins (§2): two browsers start a private match from its lobby, nobody claims, and the timer runs out.
 * The match is this scenario's own 20 s one (test-only timings for the next match created, on top of the browser
 * server's 3 s ready countdown), so it never waits out a real clock.
 */
const MATCH_TICKS = 400;

test("two browsers start a short match from the lobby, nobody claims and the timer runs out: both show the no-winner deadline results, and the compass shows inactive while no route is known [scenario:match-deadline]", async ({
  browser,
  request,
}, testInfo) => {
  test.setTimeout(90_000);
  await nextMatchTimings(request, { match: MATCH_TICKS });
  const hostContext = await browser.newContext();
  const guestContext = await browser.newContext();
  try {
    const host = await hostContext.newPage();
    const guest = await guestContext.newPage();
    const pages = [host, guest];

    const code = await createMatch(host);
    await joinMatch(guest, code);
    for (const page of pages) await expect(page.getByTestId("lobby-players").getByRole("listitem")).toHaveCount(2);
    await host.getByRole("button", { name: "Start match" }).click();

    // The ready check: this match's 20 s on the timer, and no compass before control starts.
    for (const page of pages) {
      await expect(page.getByTestId("flow-phase")).toHaveText("Ready check");
      await expect(page.getByTestId("match-timer")).toHaveText("0:20");
      await expect(page.getByTestId("compass")).toBeHidden();
    }

    // In play, nobody holds every type: the compass shows, inactive, with nothing to point at.
    for (const page of pages) {
      await expect(page.getByTestId("match-timer")).toHaveAttribute("data-state", /^(running|urgent)$/, { timeout: 10_000 });
      const compass = page.getByTestId("compass");
      await expect(compass).toBeVisible();
      await expect(compass).toHaveAttribute("data-state", "none");
      await expect(compass).toHaveAttribute("data-active", "false");
      expect(await compass.getAttribute("data-distance")).toBeNull();
      await expect(page.getByTestId("compass-text")).toHaveText("No treasure route yet: hold every rubbing type to learn it");
      await expect(page.getByTestId("compass-arrow")).toBeHidden();
      await expect(page.getByTestId("hud-route")).toHaveAttribute("data-state", "none");
      await expect(page.getByTestId("claim-panel")).toBeHidden();
      expect(await page.getByTestId("game").getAttribute("data-route")).toBeFalsy();
    }

    // The timer runs out: both browsers show the results with the deadline's no-winner headline.
    for (const page of pages) {
      const results = page.getByTestId("results");
      await expect(results).toBeVisible({ timeout: 30_000 });
      await expect(results).toHaveAttribute("data-reason", "deadline");
      await expect(results).toHaveAttribute("data-winner-seat", "0");
      await expect(page.getByTestId("results-headline")).toHaveText("No winner (time ran out)");
      await expect(page.getByTestId("results-detail")).toHaveText("Nobody claimed the treasure before the deadline.");
      const rows = page.getByTestId("results-table").locator("tbody tr");
      await expect(rows).toHaveCount(2);
      for (const row of await rows.all()) {
        await expect(row).toHaveAttribute("data-winner", "false");
        // Nobody collected, stole, lost or fought, and the purse is the starting gold.
        await expect(row.locator("td")).toHaveText([/^Player [12]( \(you\))?$/, "0", "0", "0", "0", "0", "0", "50", "0", /^\d$/]);
      }
      await expect(page.getByTestId("match-timer")).toHaveText("0:00");
      await expect(page.getByTestId("match-timer")).toHaveAttribute("data-state", "ended");
      await expect(page.getByTestId("flow-phase")).toHaveText("Match over");
      await expect(page.getByTestId("compass")).toBeHidden();
    }
    await attachScreenshot(guest, testInfo, "match-deadline");
  } finally {
    await hostContext.close();
    await guestContext.close();
  }
});
