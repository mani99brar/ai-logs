import { describe, expect, it } from "vitest";
import { DEFAULT_MATCH_TUNING } from "./MatchRoom.js";
import { testTimingsTuning } from "./server.js";
import { testSettingsFrom } from "./testSettings.js";

describe("the development and test entry's test-only settings (testSettingsFrom)", () => {
  it("turns nothing on in an environment without them, or with them empty", () => {
    for (const env of [{}, { PIRATE_SEA_RACE_TEST_SOURCES: "", PIRATE_SEA_RACE_TEST_TIMINGS: "", PIRATE_SEA_RACE_TEST_FINAL_SECRET: "", PIRATE_SEA_RACE_TEST_PLACEMENT: "0" }]) {
      expect(testSettingsFrom(env)).toEqual({ testPlacement: false, matchTuning: {}, described: [] });
    }
  });

  it("reads each setting the browser tests set", () => {
    const settings = testSettingsFrom({
      PIRATE_SEA_RACE_TEST_PLACEMENT: "1",
      PIRATE_SEA_RACE_TEST_SOURCES: "sun,sun|moon,moon",
      PIRATE_SEA_RACE_TEST_TIMINGS: "ready=60,match=12000",
      PIRATE_SEA_RACE_TEST_FINAL_SECRET: "3",
    });
    expect(settings.testPlacement).toBe(true);
    expect(settings.matchTuning).toEqual({
      sourceLayout: [
        ["sun", "sun"],
        ["moon", "moon"],
      ],
      ...testTimingsTuning({ ready: 60, match: 12_000 }),
      finalSocketSecret: 3,
    });
    expect(settings.matchTuning.claim?.deadlineTicks).toBe(12_000);
    expect(settings.matchTuning.match?.readyTicks).toBe(60);
    expect(settings.matchTuning.encounters).toEqual(DEFAULT_MATCH_TUNING.encounters);
    expect(settings.described).toEqual(["test placement on", "test sources sun,sun|moon,moon", "test timings ready=60,match=12000", "pinned final-socket secret"]);
    // Each on its own.
    expect(testSettingsFrom({ PIRATE_SEA_RACE_TEST_FINAL_SECRET: "0" }).matchTuning).toEqual({ finalSocketSecret: 0 });
    expect(testSettingsFrom({ PIRATE_SEA_RACE_TEST_SOURCES: "moon" }).matchTuning).toEqual({ sourceLayout: [["moon"]] });
  });

  it("stops the server on a malformed setting rather than running without it", () => {
    expect(() => testSettingsFrom({ PIRATE_SEA_RACE_TEST_TIMINGS: "not timings" })).toThrow("PIRATE_SEA_RACE_TEST_TIMINGS is malformed: not timings");
    expect(() => testSettingsFrom({ PIRATE_SEA_RACE_TEST_FINAL_SECRET: "-1" })).toThrow(/FINAL_SECRET is malformed/);
    expect(() => testSettingsFrom({ PIRATE_SEA_RACE_TEST_SOURCES: "Sun" })).toThrow(/SOURCES is malformed/);
  });
});
