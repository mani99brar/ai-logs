+import { z } from "zod";
+import { encodedSize } from "./input.js";
+import { RUBBING_TYPE_NAMES } from "./rubbings.js";
+
+/**
+ * The match flow messages (protocol v7, §2 and §5): the lobby's start request, the server's answer when it refuses
+ * one, and the reveals of the final island. Claiming needs no message: the player holds interact (E), stopped inside
+ * the treasure circle, and the server decides.
+ */
+export const MatchMessageType = {
+  /** Client → server: the private host asks to start the ready countdown (`StartMatchMessage`). */
+  Start: "start-match",
+  /** Server → client: why a start request was refused (`StartRefusedMessage`). */
+  StartRefused: "start-refused",
+  /** Server → client: one of §2's and §5's reveals (`RevealMessage`), to exactly the players entitled to it (§16). */
+  Reveal: "reveal",
+} as const;
+
+/** The largest start request accepted, measured as its JSON encoding. A valid one is `{}`. */
+export const MAX_START_MATCH_BYTES = 16;
+/** Start requests a client may send per second before the server drops the rest. */
+export const MAX_START_MATCH_PER_SECOND = 4;
+
+/** A start request carries nothing: the server knows who sent it and whether they host. */
+export const startMatchMessageSchema = z.strictObject({});
+export type StartMatchMessage = z.infer<typeof startMatchMessageSchema>;
+
+/** Validates an untrusted start request: its size, then its schema. */
+export function validateStartMatchMessage(message: unknown): StartMatchMessage | undefined {
+  const size = encodedSize(message);
+  if (size === undefined || size > MAX_START_MATCH_BYTES) return undefined;
+  const parsed = startMatchMessageSchema.safeParse(message);
+  return parsed.success ? parsed.data : undefined;
+}
+
+/**
+ * Why the host's start was refused: `too-few` (a private match starts with two or more players), `not-host` (only
+ * the host starts) or `public` (a public match starts when its seats fill). The match module's `StartRefusal`.
+ */
+export const START_REFUSALS = ["too-few", "not-host", "public"] as const;
+export const startRefusedMessageSchema = z.strictObject({ reason: z.enum(START_REFUSALS) });
+export type StartRefusedMessage = z.infer<typeof startRefusedMessageSchema>;
+
+/** A sea sector as reveals name it: its index in the grid (row by row from the north-west) and its name. */
+const sectorSchema = z.strictObject({ sector: z.int().min(0), name: z.string().min(1).max(64) });
+
+/**
+ * The reveals the room delivers (§2, §5), as the intel module words them. Only `final-route` carries a position: the
+ * final island's claim point, and only to a player holding every type (§16). The others carry sectors, types and
+ * ticks; none names a player or a rubbing.
+ */
+export const revealMessageSchema = z.discriminatedUnion("kind", [
+  /** To everyone, once: a first full set exists, and the final island lies in this sector. */
+  z.strictObject({ kind: z.literal("final-sector"), tick: z.int().min(0), sector: z.int().min(0), name: z.string().min(1).max(64) }),
+  /** To a full-set holder only: the exact claim point, in sub-units; `restored` after a broken set is whole again. */
+  z.strictObject({ kind: z.literal("final-route"), tick: z.int().min(0), x: z.int(), y: z.int(), restored: z.boolean() }),
+  /** To a holder who lost a type: their route is inactive until the set is whole again. */
+  z.strictObject({ kind: z.literal("final-route-inactive"), tick: z.int().min(0) }),
+  /** To everyone at minute 20: the sectors holding sealed sources, and those holding recovery caches. */
+  z.strictObject({ kind: z.literal("sector-reveal"), tick: z.int().min(0), sources: z.array(sectorSchema).max(16), caches: z.array(sectorSchema).max(16) }),
+  /** To everyone from minute 28, every 30 s: the carriers' sectors and types at the latest snapshot. */
+  z.strictObject({
+    kind: z.literal("carrier-report"),
+    tick: z.int().min(0),
+    seenTick: z.int().min(0),
+    carriers: z.array(sectorSchema.extend({ type: z.enum(RUBBING_TYPE_NAMES) })).max(64),
+  }),
+]);
+export type RevealMessage = z.infer<typeof revealMessageSchema>;
+export type RevealKind = RevealMessage["kind"];
+export const REVEAL_KINDS = ["final-sector", "final-route", "final-route-inactive", "sector-reveal", "carrier-report"] as const satisfies readonly RevealKind[];
+
+/** Parses a reveal the server sent, or undefined when it is not one. */
+export function parseRevealMessage(message: unknown): RevealMessage | undefined {
+  const parsed = revealMessageSchema.safeParse(message);
+  return parsed.success ? parsed.data : undefined;
+}
+
+/** What the client shows when a join is refused because the match has left its lobby (§2: no late arrivals). */
+export const MATCH_STARTED_MESSAGE = "That match has already started";
+
+/** The match's phases as the synced state names them (§2). */
+export const MATCH_PHASE_NAMES = ["lobby", "ready", "departure", "exploration", "ended"] as const;
+export type MatchPhaseName = (typeof MATCH_PHASE_NAMES)[number];
+
+/** How a match ended (§2, §12): the results screen's headline. */
+export const MATCH_END_REASON_NAMES = ["claim", "deadline", "abandoned", "aborted"] as const;
+export type MatchEndReasonName = (typeof MATCH_END_REASON_NAMES)[number];
