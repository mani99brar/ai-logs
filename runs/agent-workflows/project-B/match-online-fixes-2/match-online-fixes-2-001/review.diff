+import { describe, expect, it, vi } from "vitest";
+
+// The real `randomBytes`, watched: the test sees every call the room's default master secret makes.
+vi.mock("node:crypto", async (importOriginal) => {
+  const crypto = await importOriginal<typeof import("node:crypto")>();
+  return { ...crypto, randomBytes: vi.fn((size: number) => crypto.randomBytes(size)) };
+});
+
+const { createHmac, randomBytes } = await import("node:crypto");
+const { deriveSeed, drawMasterSecret, MASTER_SECRET_BYTES, SEED_LABEL } = await import("./matchSeeds.js");
+const { DEFAULT_MATCH_TUNING } = await import("./MatchRoom.js");
+
+const SYSTEMS = ["world", "ledger", "final-socket", "intel", "ruins", "fruit", "duel:1", "duel:2"] as const;
+
+describe("the match's seeds (§3, §16)", () => {
+  it("come from one master secret drawn from node:crypto in production, with every test-only setting off", () => {
+    expect(DEFAULT_MATCH_TUNING.masterSecret).toBe(drawMasterSecret);
+    expect(DEFAULT_MATCH_TUNING.sourceLayout).toBeUndefined();
+    expect(DEFAULT_MATCH_TUNING.finalSocketSecret).toBeUndefined();
+    expect(DEFAULT_MATCH_TUNING.testHooks).toBe(false);
+    const before = vi.mocked(randomBytes).mock.calls.length;
+    const secret = DEFAULT_MATCH_TUNING.masterSecret();
+    expect(vi.mocked(randomBytes).mock.calls.slice(before)).toEqual([[MASTER_SECRET_BYTES]]);
+    expect(secret).toHaveLength(MASTER_SECRET_BYTES);
+    expect(DEFAULT_MATCH_TUNING.masterSecret()).not.toEqual(secret);
+  });
+
+  it("are an HMAC-SHA-256 of the system's name keyed by the secret: its first four bytes, big-endian", () => {
+    const secret = new Uint8Array(MASTER_SECRET_BYTES).map((_, index) => index * 7 + 1);
+    for (const system of SYSTEMS) {
+      const expected = createHmac("sha256", secret).update(`${SEED_LABEL}${system}`).digest().readUInt32BE(0);
+      expect(deriveSeed(secret, system)).toBe(expected);
+    }
+  });
+
+  it("differ per system and per secret, and read nothing but the secret and the system (never a match code)", () => {
+    const secret = new Uint8Array(MASTER_SECRET_BYTES).fill(42);
+    const seeds = SYSTEMS.map((system) => deriveSeed(secret, system));
+    expect(new Set(seeds).size).toBe(SYSTEMS.length);
+    // The same secret gives the same seeds; any other secret gives others.
+    expect(SYSTEMS.map((system) => deriveSeed(new Uint8Array(secret), system))).toEqual(seeds);
+    const other = new Uint8Array(secret);
+    other[0] = 43;
+    for (const system of SYSTEMS) expect(deriveSeed(other, system)).not.toBe(deriveSeed(secret, system));
+    // The derivation takes exactly the secret and the system: there is no argument a match code could reach it by.
+    expect(deriveSeed.length).toBe(2);
+    expect(() => deriveSeed(new Uint8Array(8), "ledger")).toThrow(RangeError);
+  });
+});
diff --git a/apps/server/src/matchSeeds.ts b/apps/server/src/matchSeeds.ts
new file mode 100644
index 0000000..4e86c0d
--- /dev/null
+++ b/apps/server/src/matchSeeds.ts
@@ -0,0 +1,33 @@
+import { createHmac, randomBytes } from "node:crypto";
+
+/**
+ * A match's seeds (§3, §16). The room draws one private master secret per match from `node:crypto` and derives an
+ * independent 32-bit seed for each system from it with a keyed hash: HMAC-SHA-256 keyed by the secret over
+ * `SEED_LABEL` and the system's name, of which the first four bytes (big-endian) are the seed. So no system's seed
+ * says anything about another's, none is ever passed raw to two systems, and none depends on the public match code,
+ * which the derivation never reads.
+ */
+
+/** Bytes in a master secret: 256 bits. */
+export const MASTER_SECRET_BYTES = 32;
+
+/** The versioned label every derivation hashes before the system's name. */
+export const SEED_LABEL = "pirate-sea-race/seed/v1/";
+
+/**
+ * The systems that draw a seed. `world` seeds the simulation state, `ledger` the rubbings' deal onto the sources,
+ * `final-socket` the final island's socket, `intel` the intel module's draws; `ruins` and `fruit` are reserved for the
+ * ruins' puzzles and the fruit deal. Each duel at sea draws `duel:<n>`, its n-th duel.
+ */
+export type SeedSystem = "world" | "ledger" | "final-socket" | "intel" | "ruins" | "fruit" | `duel:${number}`;
+
+/** A fresh master secret from `node:crypto`: the production source. */
+export function drawMasterSecret(): Uint8Array {
+  return new Uint8Array(randomBytes(MASTER_SECRET_BYTES));
+}
+
+/** The seed of one system: HMAC-SHA-256(secret, SEED_LABEL + system), its first four bytes as an unsigned integer. */
+export function deriveSeed(secret: Uint8Array, system: SeedSystem): number {
+  if (secret.length < 16) throw new RangeError(`a master secret needs at least 16 bytes, got ${secret.length}`);
+  return createHmac("sha256", secret).update(SEED_LABEL + system, "utf8").digest().readUInt32BE(0);
+}
