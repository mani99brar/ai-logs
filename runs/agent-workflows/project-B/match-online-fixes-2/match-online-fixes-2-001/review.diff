+import { describe, expect, it } from "vitest";
+import { seaMap } from "@pirate-sea-race/content";
+import { createClaimConfig } from "@pirate-sea-race/simulation/claim";
+import { createMatchConfig, createMatchState, remaining, stepMatch } from "@pirate-sea-race/simulation/match";
+import {
+  claimingShipsOf,
+  claimLines,
+  clockText,
+  flowModelOf,
+  flowView,
+  insideCircle,
+  lobbyModel,
+  phaseText,
+  resultsModel,
+  revealBanner,
+  routeLine,
+  seatLabel,
+  showReveal,
+  showStartRefusal,
+  startRefusalLine,
+  startRefusalText,
+  timerLine,
+  NO_ROUTE_TEXT,
+  type ClaimStatus,
+  type FlowModel,
+  type LobbyState,
+} from "./flowHud.js";
+
+const TILE = seaMap.subUnitsPerTile;
+const lobby: LobbyState = { phase: "lobby", seats: [1], hostSeat: 1, seat: 1, minPlayers: 2, readyEndsAt: 0, worldTick: 100 };
+const noClaim: ClaimStatus = {
+  fullSet: false,
+  routeKnown: false,
+  routeActive: false,
+  routeX: 0,
+  routeY: 0,
+  claim: "",
+  claimHeld: 0,
+  claimTotal: 200,
+  claimInterrupt: "",
+  claimInterruptAt: 0,
+};
+const holder: ClaimStatus = { ...noClaim, fullSet: true, routeKnown: true, routeActive: true, routeX: 50 * TILE + 128, routeY: 20 * TILE + 128 };
+const context = { inCircle: false, speed: 0, worldTick: 1000, phase: "exploration" };
+
+describe("the lobby (§2)", () => {
+  it("lists the players by seat, marks the host and the player, and lets only the host start with two or more", () => {
+    expect(seatLabel(1, 1, 1)).toBe("Player 1 (you, host)");
+    expect(seatLabel(2, 1, 1)).toBe("Player 2");
+    expect(seatLabel(2, 2, 1)).toBe("Player 2 (you)");
+    // The host alone: the button shows, disabled, and the lobby says why.
+    expect(lobbyModel(lobby)).toEqual({
+      players: [{ seat: 1, label: "Player 1 (you, host)" }],
+      showStart: true,
+      canStart: false,
+      hint: "Waiting for players: 2 or more start a match. Share the code.",
+    });
+    // Two players: the host may start; the guest sees no button.
+    const two = { ...lobby, seats: [2, 1] };
+    expect(lobbyModel(two)).toMatchObject({ showStart: true, canStart: true, hint: "Everyone aboard? Start the match." });
+    expect(lobbyModel(two).players.map((player) => player.seat)).toEqual([1, 2]);
+    expect(lobbyModel({ ...two, seat: 2 })).toMatchObject({ showStart: false, canStart: false, hint: "Waiting for the host to start the match." });
+    expect(startRefusalText("too-few")).toBe("A private match needs at least two players to start.");
+    expect(startRefusalText("not-host")).toBe("Only the host can start the match.");
+    // What main.ts shows for the server's refusal message: only a valid one.
+    expect(startRefusalLine({ reason: "too-few" })).toBe("A private match needs at least two players to start.");
+    expect(startRefusalLine({ reason: "public" })).toBe("This match starts when its seats fill.");
+    expect(startRefusalLine({ reason: "bogus" })).toBeUndefined();
+    expect(startRefusalLine("too-few")).toBeUndefined();
+  });
+
+  it("counts the ready check down to control start while the arena loads", () => {
+    const ready = { ...lobby, seats: [1, 2], phase: "ready", readyEndsAt: 500, worldTick: 381 };
+    expect(lobbyModel(ready)).toMatchObject({ showStart: false, canStart: false, hint: "Setting sail in 6 s: the arena loads meanwhile" });
+    expect(phaseText("ready")).toBe("Ready check");
+    expect(phaseText("departure")).toBe("Departure (protected)");
+  });
+
+  it("names every phase of the match in the clock bar", () => {
+    expect(["lobby", "ready", "departure", "exploration", "ended", "unknown"].map(phaseText)).toEqual(["Lobby", "Ready check", "Departure (protected)", "Exploration", "Match over", ""]);
+  });
+});
+
+describe("the match timer (§2)", () => {
+  it("shows minutes and seconds, rounded up, and flags the last minute", () => {
+    expect(clockText(42_000)).toBe("35:00");
+    expect(clockText(41_999)).toBe("35:00");
+    expect(clockText(41_980)).toBe("34:59");
+    expect(clockText(1200)).toBe("1:00");
+    expect(clockText(0)).toBe("0:00");
+    expect(timerLine({ phase: "lobby", remainingTicks: 42_000 })).toEqual({ text: "35:00", state: "waiting" });
+    expect(timerLine({ phase: "exploration", remainingTicks: 1201 })).toEqual({ text: "1:01", state: "running" });
+    expect(timerLine({ phase: "exploration", remainingTicks: 1200 })).toEqual({ text: "1:00", state: "urgent" });
+    expect(timerLine({ phase: "ended", remainingTicks: 0 })).toEqual({ text: "0:00", state: "ended" });
+  });
+
+  it("reads 35:00 at control start from the match module's remaining time, and 0:00 exactly at the claim deadline", () => {
+    const config = createMatchConfig({ kind: "private" });
+    let state = createMatchState(config);
+    state = stepMatch(config, state, { tick: 1, reports: [{ kind: "join", playerId: "a" }, { kind: "join", playerId: "b" }] }).state;
+    state = stepMatch(config, state, { tick: 2, reports: [{ kind: "start", playerId: "a" }] }).state;
+    const controlStart = 2 + config.readyTicks;
+    state = stepMatch(config, state, { tick: controlStart, reports: [] }).state;
+    expect(state.controlStartTick).toBe(controlStart);
+    const claim = createClaimConfig({ claimPoint: { x: 0, y: 0 }, controlStartTick: controlStart });
+    expect(clockText(remaining(state, controlStart))).toBe("35:00");
+    expect(clockText(remaining(state, controlStart + 20))).toBe("34:59");
+    expect(clockText(remaining(state, claim.deadlineTick - 1))).toBe("0:01");
+    expect(remaining(state, claim.deadlineTick)).toBe(0);
+    expect(timerLine({ phase: "exploration", remainingTicks: remaining(state, claim.deadlineTick) }).text).toBe("0:00");
+  });
+});
+
+describe("the reveals' banners (§2, §5)", () => {
+  it("announce the sector to everyone, the route to the holder, a lost route, and the minute-20 and minute-28 broadcasts", () => {
+    expect(revealBanner({ kind: "final-sector", tick: 5, sector: 1, name: "Northern Waters" })).toEqual({
+      kind: "final-sector",
+      title: "A full set of rubbings exists!",
+      detail: "The treasure lies in Northern Waters. Every ship is heading there.",
+      tone: "treasure",
+    });
+    expect(revealBanner({ kind: "final-route", tick: 5, x: 1, y: 2, restored: false })).toMatchObject({ title: "You hold every rubbing!", tone: "treasure" });
+    expect(revealBanner({ kind: "final-route", tick: 5, x: 1, y: 2, restored: true }).title).toBe("Your set is whole again");
+    expect(revealBanner({ kind: "final-route-inactive", tick: 5 })).toMatchObject({ title: "You lost a rubbing", tone: "warning" });
+    expect(
+      revealBanner({ kind: "sector-reveal", tick: 5, sources: [{ sector: 0, name: "North-West Reach" }], caches: [{ sector: 4, name: "Central Waters" }] }).detail,
+    ).toBe("Unclaimed rubbings in North-West Reach; recovery caches in Central Waters.");
+    expect(revealBanner({ kind: "sector-reveal", tick: 5, sources: [], caches: [] }).detail).toBe("No unclaimed rubbing left.");
+    expect(
+      revealBanner({ kind: "carrier-report", tick: 5, seenTick: 5, carriers: [{ sector: 7, name: "Southern Waters", type: "moon" }] }).detail,
+    ).toBe("Moon in Southern Waters.");
+    expect(revealBanner({ kind: "carrier-report", tick: 5, seenTick: 5, carriers: [] }).detail).toBe("No rubbing is being carried.");
+  });
+});
+
+describe("the route and the claim (§5)", () => {
+  it("points the compass at the final island for the holder, and says when the route is inactive", () => {
+    expect(routeLine(undefined, undefined, TILE)).toEqual({ text: "", state: "none" });
+    expect(routeLine(noClaim, { x: 0, y: 0 }, TILE)).toEqual({ text: "", state: "none" });
+    expect(routeLine({ ...holder, routeActive: false }, { x: 0, y: 0 }, TILE)).toEqual({ text: "Route inactive: win back the rubbing you lost", state: "inactive" });
+    // Ten tiles west and ten north of the island: it lies south-east.
+    const own = { x: holder.routeX - 10 * TILE, y: holder.routeY - 10 * TILE };
+    const line = routeLine(holder, own, TILE);
+    expect(line).toMatchObject({ text: "Treasure: 14 tiles south-east", state: "active", distanceTiles: 14 });
+    expect(line.bearing).toBeCloseTo(Math.PI / 4);
+    expect(routeLine(holder, { x: holder.routeX, y: holder.routeY }, TILE).text).toBe("Treasure: right here");
+  });
+
+  it("guides the holder into the circle, shows the channel with its risk, and says why a channel reset", () => {
+    const radius = 4 * TILE;
+    expect(insideCircle(holder, { x: holder.routeX + radius, y: holder.routeY }, radius)).toBe(true);
+    expect(insideCircle(holder, { x: holder.routeX + radius + 1, y: holder.routeY }, radius)).toBe(false);
+    // Without a known route there is no circle to be in.
+    expect(insideCircle({ ...holder, routeKnown: false }, { x: holder.routeX, y: holder.routeY }, radius)).toBe(false);
+    expect(claimLines(noClaim, context).claim.state).toBe("none");
+    expect(claimLines(holder, context).claim).toEqual({ text: "Sail into the treasure circle to claim", state: "route" });
+    expect(claimLines(holder, { ...context, inCircle: true, speed: 12 }).claim.state).toBe("slow");
+    const ready = claimLines(holder, { ...context, inCircle: true });
+    expect(ready.claim).toEqual({ text: "Hold E to claim the treasure (ten seconds)", state: "ready" });
+    expect(ready.risk).toEqual({ text: "Any rival in range can interrupt you with a grapple", state: "risk" });
+    const channel = claimLines({ ...holder, claim: "channel", claimHeld: 50 }, { ...context, inCircle: true });
+    expect(channel.claim).toEqual({ text: "Claiming the treasure: keep holding E, 8 s left", state: "channel", seconds: 8 });
+    expect(channel.progress).toBe(0.25);
+    expect(channel.risk.state).toBe("risk");
+    // A reset names its reason for five seconds.
+    const moved = { ...holder, claimInterrupt: "moved", claimInterruptAt: 950 };
+    expect(claimLines(moved, { ...context, inCircle: true }).claim).toEqual({ text: "Claim interrupted: you moved. Progress lost.", state: "interrupted:moved" });
+    expect(claimLines({ ...moved, claimInterrupt: "duel" }, context).claim.text).toBe("Claim interrupted: a rival grappled you. Progress lost.");
+    expect(claimLines(moved, { ...context, inCircle: true, worldTick: 1051 }).claim.state).toBe("ready");
+    expect(claimLines({ ...holder, claim: "waiting" }, context).claim.state).toBe("waiting");
+    // Nothing once the match is over.
+    expect(claimLines({ ...holder, claim: "channel" }, { ...context, phase: "ended" }).claim.state).toBe("none");
+  });
+
+  it("names every reset reason of the claim module in the claim line, with no risk line", () => {
+    const reasons: Record<string, string> = {
+      moved: "you moved",
+      released: "you let go of E",
+      duel: "a rival grappled you",
+      disconnected: "you disconnected",
+      // A lost type: the claim module's own reset (the room's duel reservation resets a channel first, docs/architecture.md).
+      ineligible: "you no longer hold every rubbing",
+      deadline: "time ran out",
+    };
+    for (const [reason, text] of Object.entries(reasons)) {
+      const lines = claimLines({ ...holder, claimInterrupt: reason, claimInterruptAt: 950 }, { ...context, inCircle: true });
+      expect(lines.claim).toEqual({ text: `Claim interrupted: ${text}. Progress lost.`, state: `interrupted:${reason}` });
+      expect(lines.risk.state).toBe("none");
+      expect(lines.progress).toBe(0);
+    }
+    // A lost type after the reset still shows why for five seconds, before the route goes inactive.
+    const lost = { ...holder, fullSet: false, routeActive: false, claimInterrupt: "ineligible", claimInterruptAt: 950 };
+    expect(claimLines(lost, context).claim.state).toBe("interrupted:ineligible");
+    expect(claimLines(lost, { ...context, worldTick: 1051 }).claim.state).toBe("none");
+  });
+});
+
+describe("the results screen (§2)", () => {
+  const lines = [
+    { seat: 1, winner: true, left: false, collected: 2, thefts: 1, lost: 0, duelsWon: 1, duelsLost: 0, duelsDrawn: 0, gold: 60, cachesClaimed: 0, islandsVisited: 2 },
+    { seat: 2, winner: false, left: true, collected: 1, thefts: 0, lost: 1, duelsWon: 0, duelsLost: 1, duelsDrawn: 2, gold: 40, cachesClaimed: 1, islandsVisited: 1 },
+  ];
+
+  it("names the winner, or says there is none and why, and lists every player's accomplishments", () => {
+    expect(resultsModel({ endReason: "", winnerSeat: 0, seat: 1, hostSeat: 1, lines: [] })).toBeUndefined();
+    const won = resultsModel({ endReason: "claim", winnerSeat: 1, seat: 1, hostSeat: 1, lines })!;
+    expect(won.headline).toBe("You claimed the treasure!");
+    expect(won.rows).toEqual([
+      { seat: 1, label: "Player 1 (you)", winner: true, left: false, cells: [2, 1, 0, 1, 0, 0, 60, 0, 2] },
+      { seat: 2, label: "Player 2 (left)", winner: false, left: true, cells: [1, 0, 1, 0, 1, 2, 40, 1, 1] },
+    ]);
+    expect(resultsModel({ endReason: "claim", winnerSeat: 1, seat: 2, hostSeat: 1, lines })!.headline).toBe("Player 1 claimed the treasure");
+    const timeout = resultsModel({ endReason: "deadline", winnerSeat: 0, seat: 2, hostSeat: 1, lines: lines.map((line) => ({ ...line, winner: false })) })!;
+    expect(timeout.headline).toBe("No winner (time ran out)");
+    expect(timeout.rows).toHaveLength(2);
+    expect(resultsModel({ endReason: "abandoned", winnerSeat: 0, seat: 1, hostSeat: 1, lines })!.headline).toBe("No winner (everyone left)");
+    expect(resultsModel({ endReason: "aborted", winnerSeat: 0, seat: 1, hostSeat: 1, lines })!.headline).toBe("No winner (match aborted)");
+  });
+});
+
+describe("a rival's claim in sight (§5)", () => {
+  it("warns a player who sees another ship channelling the claim, whatever they hold", () => {
+    const warned = claimLines(noClaim, { ...context, rivalClaiming: true });
+    expect(warned.claim).toEqual({ text: "A rival is claiming the treasure! Grapple them before the channel completes", state: "rival" });
+    // The claimer's own channel comes first, and nothing shows once the match is over.
+    expect(claimLines({ ...holder, claim: "channel", claimHeld: 20 }, { ...context, inCircle: true, rivalClaiming: true }).claim.state).toBe("channel");
+    expect(claimLines(noClaim, { ...context, rivalClaiming: true, phase: "ended" }).claim.state).toBe("none");
+  });
+});
+
+describe("the flow's view of the page (flowView: what renderFlow writes, element by element)", () => {
+  const noResults = { endReason: "", winnerSeat: 0, seat: 1, hostSeat: 1, lines: [] };
+  const playing: FlowModel = {
+    code: "ABC123",
+    rivalClaiming: false,
+    lobby: { ...lobby, seats: [1, 2], phase: "exploration", worldTick: 1000 },
+    remainingTicks: 9000,
+    finalSector: "",
+    claim: noClaim,
+    own: { x: 0, y: 0, speed: 0 },
