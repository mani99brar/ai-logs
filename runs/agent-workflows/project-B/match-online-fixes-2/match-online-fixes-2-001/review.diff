+++ b/apps/web/src/treasureView.test.ts
@@ -0,0 +1,79 @@
+import { describe, expect, it } from "vitest";
+import type { ClaimStatus } from "./flowHud.js";
+import { treasureView, type TreasureGeometry, type TreasureInput } from "./treasureView.js";
+
+/** Round numbers: 1 px per sub-unit, 100 px tiles, a minimap at scale 1 with a 10 px margin, art at scale 1. */
+const GEOMETRY: TreasureGeometry = { pixelsPerSubUnit: 1, tilePixels: 100, minimapScale: 1, minimapMargin: 10, artScale: 1 };
+const noRoute: ClaimStatus = {
+  fullSet: false,
+  routeKnown: false,
+  routeActive: false,
+  routeX: 0,
+  routeY: 0,
+  claim: "",
+  claimHeld: 0,
+  claimTotal: 200,
+  claimInterrupt: "",
+  claimInterruptAt: 0,
+};
+const holder: ClaimStatus = { ...noRoute, fullSet: true, routeKnown: true, routeActive: true, routeX: 1000, routeY: 500 };
+const input: TreasureInput = { claim: holder, own: { x: 1000, y: 1500 }, claiming: [], treasureRadius: 400, now: 0, minimapLeft: 600 };
+
+describe("the final island on the sea (treasureView, what drawTreasure draws)", () => {
+  it("draws nothing of the island without a route: no status yet, or no route revealed", () => {
+    for (const claim of [undefined, noRoute]) {
+      expect(treasureView({ ...input, claim }, GEOMETRY)).toEqual({ circles: [], crosses: [], minimapCrosses: [], arrows: [], rings: [], route: "", claiming: "" });
+    }
+  });
+
+  it("draws an active route's circle bright and pulsing, its X on the sea and the minimap, and an arrow off a ship outside it", () => {
+    const view = treasureView(input, GEOMETRY);
+    expect(view.circles).toEqual([{ x: 1000, y: 500, radius: 400, fillAlpha: 0.12, lineAlpha: 0.55 }]);
+    expect(treasureView({ ...input, now: 200 * Math.PI }, GEOMETRY).circles[0]!.lineAlpha).toBeCloseTo(0.85);
+    expect(view.crosses).toEqual([{ x: 1000, y: 500, half: 6, alpha: 0.55 }]);
+    expect(view.minimapCrosses).toEqual([{ x: 610, y: 15, half: 3, alpha: 1 }]);
+    // The ship lies due south of the island: the arrow points north, its tip 26 px off the ship.
+    expect(view.arrows).toHaveLength(1);
+    const [tipX, tipY] = view.arrows[0]!.points;
+    expect(tipX).toBeCloseTo(1000);
+    expect(tipY).toBeCloseTo(1500 - 26);
+    expect(view.route).toBe("1000,500,true");
+  });
+
+  it("draws no arrow for a ship inside the circle (its edge counts) or not drawn", () => {
+    expect(treasureView({ ...input, own: { x: 1000, y: 900 } }, GEOMETRY).arrows).toEqual([]);
+    expect(treasureView({ ...input, own: { x: 1000, y: 901 } }, GEOMETRY).arrows).toHaveLength(1);
+    const undrawn = treasureView({ ...input, own: undefined }, GEOMETRY);
+    expect(undrawn.arrows).toEqual([]);
+    expect(undrawn.circles).toHaveLength(1);
+  });
+
+  it("draws an inactive route faint, with a dim minimap mark and no arrow", () => {
+    const view = treasureView({ ...input, claim: { ...holder, routeActive: false } }, GEOMETRY);
+    expect(view.circles).toEqual([{ x: 1000, y: 500, radius: 400, fillAlpha: 0.05, lineAlpha: 0.25 }]);
+    expect(view.crosses).toEqual([{ x: 1000, y: 500, half: 6, alpha: 0.25 }]);
+    expect(view.minimapCrosses).toEqual([{ x: 610, y: 15, half: 3, alpha: 0.4 }]);
+    expect(view.arrows).toEqual([]);
+    expect(view.route).toBe("1000,500,false");
+  });
+
+  it("rings each drawn ship channelling a claim by its progress, whatever this player knows", () => {
+    const claiming = [
+      { id: "b", held: 50, at: { x: 10, y: 20 } },
+      { id: "a", held: 400, at: { x: 30, y: 40 } },
+      { id: "hidden", held: 10, at: undefined },
+    ];
+    const view = treasureView({ ...input, claim: noRoute, claiming }, GEOMETRY);
+    expect(view.rings).toEqual([
+      { x: 10, y: 20, radius: 16, fraction: 0.25 },
+      { x: 30, y: 40, radius: 16, fraction: 1 },
+    ]);
+    expect(view.claiming).toBe("a,b");
+    expect(view.circles).toEqual([]);
+    // Without this player's own channel length (no status yet, or none synced), the rules' ten seconds.
+    for (const claim of [undefined, { ...noRoute, claimTotal: 0 }]) {
+      expect(treasureView({ ...input, claim, claiming: [claiming[0]!] }, GEOMETRY).rings[0]!.fraction).toBe(0.25);
+    }
+    expect(treasureView({ ...input, claim: { ...noRoute, claimTotal: 100 }, claiming: [claiming[0]!] }, GEOMETRY).rings[0]!.fraction).toBe(0.5);
+  });
+});
