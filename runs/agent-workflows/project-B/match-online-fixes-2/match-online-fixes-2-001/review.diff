@@ -0,0 +1,55 @@
+import {
+  parseTestFinalSecret,
+  parseTestSourceLayout,
+  parseTestTimings,
+  TEST_FINAL_SECRET_ENV,
+  TEST_PLACEMENT_ENV,
+  TEST_SOURCES_ENV,
+  TEST_TIMINGS_ENV,
+} from "@pirate-sea-race/protocol";
+import type { MatchTuning } from "./MatchRoom.js";
+import { testTimingsTuning } from "./server.js";
+
+/** The test-only settings the development and test entry (`dev.ts`) reads from its environment. */
+export interface TestSettings {
+  readonly testPlacement: boolean;
+  readonly matchTuning: Partial<MatchTuning>;
+  /** What is on, for the start-up line. */
+  readonly described: readonly string[];
+}
+
+/** A set variable's parsed value, undefined when unset or empty; a malformed one stops the server. */
+function setting<T>(env: Readonly<Record<string, string | undefined>>, name: string, parse: (text: string) => T | undefined): T | undefined {
+  const text = env[name];
+  if (text === undefined || text === "") return undefined;
+  const parsed = parse(text);
+  if (parsed === undefined) throw new Error(`${name} is malformed: ${text}`);
+  return parsed;
+}
+
+/**
+ * The test-only settings in an environment, each off unless its variable is set: PIRATE_SEA_RACE_TEST_PLACEMENT=1
+ * turns on the test routes; PIRATE_SEA_RACE_TEST_SOURCES pins every match's source layout; PIRATE_SEA_RACE_TEST_TIMINGS
+ * shortens the ready countdown, the departure, the match and its reveals; PIRATE_SEA_RACE_TEST_FINAL_SECRET pins the
+ * final island's secret. The production entry (`main.ts`) never calls this.
+ */
+export function testSettingsFrom(env: Readonly<Record<string, string | undefined>>): TestSettings {
+  const testPlacement = env[TEST_PLACEMENT_ENV] === "1";
+  const sourceLayout = setting(env, TEST_SOURCES_ENV, parseTestSourceLayout);
+  const timings = setting(env, TEST_TIMINGS_ENV, parseTestTimings);
+  const finalSocketSecret = setting(env, TEST_FINAL_SECRET_ENV, parseTestFinalSecret);
+  return {
+    testPlacement,
+    matchTuning: {
+      ...(sourceLayout !== undefined ? { sourceLayout } : {}),
+      ...(timings !== undefined ? testTimingsTuning(timings) : {}),
+      ...(finalSocketSecret !== undefined ? { finalSocketSecret } : {}),
+    },
+    described: [
+      testPlacement ? "test placement on" : "",
+      sourceLayout !== undefined ? `test sources ${env[TEST_SOURCES_ENV]}` : "",
+      timings !== undefined ? `test timings ${env[TEST_TIMINGS_ENV]}` : "",
+      finalSocketSecret !== undefined ? "pinned final-socket secret" : "",
+    ].filter((each) => each !== ""),
+  };
+}
