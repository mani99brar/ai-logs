+    expect(host.remainingTicks).toBe(0);
+    expect(host.results()).toMatchObject({ reason: "deadline", winnerSeat: 0, tick: controlStart + MATCH_TICKS, elapsedTicks: MATCH_TICKS });
+    expect(host.phase).toBe("ended");
+    expect(recordedOutcomes().find((outcome) => outcome.code === host.code)?.results).toMatchObject({ reason: "deadline", winner: null });
+  }, 25_000);
+});
