@@ -0,0 +1,130 @@
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { seaMap } from "@pirate-sea-race/content";
+import { claimRules } from "@pirate-sea-race/content/claim";
+import { intelRules } from "@pirate-sea-race/content/intel";
+import { startGameServer, type RunningGameServer } from "@pirate-sea-race/server";
+import { createIntelConfig, sectorName, sectorOf } from "@pirate-sea-race/simulation/intel";
+import { sleep, type HeadlessClient } from "@pirate-sea-race/test-tools";
+import { GUEST_SEAT, HOST_SEAT, placePair } from "./rubbingsSetup.js";
+import { collectFullSet, controlStartOf, FINAL, flowTuning } from "./matchFlowSetup.js";
+import { collectAt, containsText, dockFor, grapple, playersAt, roomOf, tracker } from "./seaDuelSetup.js";
+
+/**
+ * §2 and §5's reveals through the real room, on raw frames: the first full set sends the final island's sector to
+ * everyone and its exact claim point only to the holder; losing a type makes the holder's route inactive; the minute-20
+ * and minute-28 broadcasts arrive for everyone. Test-only timings: the sector reveal 10 s after control start and the
+ * carrier reveal 14 s after it (every 2 s from then), instead of minutes 20 and 28.
+ */
+const SECTOR_REVEAL_TICKS = 200;
+const CARRIER_INTERVAL_TICKS = 40;
+const CARRIER_REVEAL_TICKS = 280;
+let server: RunningGameServer;
+let endpoint: string;
+
+beforeAll(async () => {
+  const matchTuning = flowTuning({
+    intel: {
+      ...intelRules,
+      sectorRevealTicks: SECTOR_REVEAL_TICKS,
+      carrierIntervalTicks: CARRIER_INTERVAL_TICKS,
+      sightingDelayTicks: CARRIER_INTERVAL_TICKS,
+      carrierRevealTicks: CARRIER_REVEAL_TICKS,
+    },
+    claim: { ...claimRules, deadlineTicks: 2400 },
+  });
+  server = await startGameServer({ port: 0, host: "127.0.0.1", handleSignals: false, testPlacement: true, matchTuning });
+  endpoint = `http://127.0.0.1:${server.port}`;
+});
+
+afterAll(async () => {
+  await server.close();
+});
+
+const intel = createIntelConfig({ preset: "slice", finalIsland: FINAL.claimPoint, map: seaMap });
+const finalSector = sectorOf(intel, FINAL.claimPoint);
+
+describe.concurrent("the reveals (§2, §5, §16)", () => {
+  it("sends the final island's sector to everyone at the first full set and its exact point only to the holder, then the minute-20 and minute-28 broadcasts to all", async ({ onTestFinished }) => {
+    const track = tracker(onTestFinished);
+    const [host, guest] = (await playersAt(endpoint, [HOST_SEAT, GUEST_SEAT], track)) as [HeadlessClient, HeadlessClient];
+    const marks = { host: host.frameCount, guest: guest.frameCount };
+    // Nothing is revealed before a full set.
+    await collectAt(host, endpoint, dockFor("sun"), "sun");
+    await sleep(200);
+    expect(host.reveals).toEqual([]);
+    expect(guest.room.state.finalSector).toBe("");
+    await collectAt(host, endpoint, dockFor("moon"), "moon");
+
