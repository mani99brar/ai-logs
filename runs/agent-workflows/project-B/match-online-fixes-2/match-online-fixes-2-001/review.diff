+    const room = roomOf(host);
+    const controlStart = room.flowState.controlStartTick!;
+    // The claim config's deadline is the timer's end: one number, from one set of rules.
+    expect(room.claimConfiguration!.deadlineTick).toBe(controlStart + MATCH_TICKS);
