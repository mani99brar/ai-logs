@@ -0,0 +1,69 @@
+import { expect } from "vitest";
+import { seaMap } from "@pirate-sea-race/content";
+import { claimRules } from "@pirate-sea-race/content/claim";
+import { intelRules } from "@pirate-sea-race/content/intel";
+import { finalIslandOf, type MatchTuning } from "@pirate-sea-race/server";
+import { defaultSimulationConfig, hullPathIsClear, tileCentre } from "@pirate-sea-race/simulation";
+import { objectiveRules } from "@pirate-sea-race/simulation/objectives";
+import type { HeadlessClient } from "@pirate-sea-race/test-tools";
+import { quickEncounters } from "./rubbingsSetup.js";
+import { collectAt, dockFor, NORTH, openWater, quickStart, roomOf, SOUTH, TEST_SOURCE_LAYOUT, type Seat } from "./seaDuelSetup.js";
+
+/**
+ * What the match-flow tests share (`lobby`, `reveals`, `claim` and `endings`): the pinned final island, the seats
+ * around its claim tile, and the test-only tunings each file starts its server with (one per file: Colyseus has one
+ * matchmaker per process). Every tuning deals the test source layout (Suns on Palm Key and Old Stones, Moons on Ember
+ * Rock and Mist Cay) and pins the final-socket secret, so a test knows where the treasure is.
+ */
+
+/** The pinned final-socket secret (test-only), and the island it picks. */
+export const PINNED_FINAL_SECRET = 3;
+export const FINAL = finalIslandOf(seaMap, PINNED_FINAL_SECRET);
+const socket = seaMap.finalSockets[FINAL.socket]!;
+/** The claim tile: its centre is the claim point, the treasure circle's centre. */
+export const CLAIM_TILE = socket.claimTile;
+/** Which way the claim tile lies from its islet: a challenger comes from further out on that side. */
+const outward = CLAIM_TILE.tileY >= socket.rect.tileY + socket.rect.heightTiles ? 1 : -1;
+/** A ship stopped on the claim tile, facing out to sea. */
+export const CLAIM_SEAT: Seat = { tileX: CLAIM_TILE.tileX, tileY: CLAIM_TILE.tileY, heading: outward > 0 ? SOUTH : NORTH };
+/** A challenger four tiles further out, facing the claim tile: in grapple range and in the aim. */
+export const CHALLENGER_SEAT: Seat = { tileX: CLAIM_TILE.tileX, tileY: CLAIM_TILE.tileY + 4 * outward, heading: outward > 0 ? NORTH : SOUTH };
+
+/** Checks the seats: open water, and a clear line from the challenger to the claim tile. */
+export function expectClaimSeats(): void {
+  expect(openWater(CLAIM_SEAT, CLAIM_SEAT)).toBe(true);
+  expect(openWater(CHALLENGER_SEAT, CHALLENGER_SEAT)).toBe(true);
+  const [from, to] = [tileCentre(defaultSimulationConfig, CHALLENGER_SEAT.tileX, CHALLENGER_SEAT.tileY), tileCentre(defaultSimulationConfig, CLAIM_SEAT.tileX, CLAIM_SEAT.tileY)];
+  expect(hullPathIsClear(defaultSimulationConfig, from.x, from.y, to.x, to.y)).toBe(true);
+  expect(tileCentre(defaultSimulationConfig, CLAIM_TILE.tileX, CLAIM_TILE.tileY)).toEqual(FINAL.claimPoint);
+}
+
+/**
+ * A tuning for the match-flow tests: the test source layout, the pinned final socket, one-second holds, quick duels
+ * (a 4 s ready check, a 2 s respawn), matches that start at once through the lobby, and the room's test hooks. The
+ * claim, intel and other settings are the file's own.
+ */
+export function flowTuning(tuning: Partial<MatchTuning> = {}): Partial<MatchTuning> {
+  const base = quickStart(
+    {
+      sourceLayout: TEST_SOURCE_LAYOUT.map((types) => [...types]),
+      finalSocketSecret: PINNED_FINAL_SECRET,
+      objectives: { ...objectiveRules, collectTicks: 20, cacheClaimTicks: 20 },
+      claim: claimRules,
+      intel: intelRules,
+      testHooks: true,
+    },
+    quickEncounters,
+  );
+  return { ...base, ...tuning };
+}
+
+/** Collects a Sun at Palm Key and a Moon at Ember Rock: every type of the slice, a full set. */
+export async function collectFullSet(client: HeadlessClient, endpoint: string): Promise<void> {
+  await collectAt(client, endpoint, dockFor("sun"), "sun");
+  await collectAt(client, endpoint, dockFor("moon"), "moon");
+  expect(client.rubbings()).toEqual(["sun", "moon"]);
+}
+
+/** The flow's control start tick of a client's match. */
+export const controlStartOf = (client: HeadlessClient): number => roomOf(client).flowState.controlStartTick!;
