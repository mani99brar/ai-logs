{
  "version": "1.2.0",
  "feature": "Veashi SDK Vea testnet addresses",
  "independent_review": true,
  "integration_approval": true,
  "max_verification_attempts": 3,
  "setup": [
    {
      "argv": [
        "bash",
        "features/_shared/setup.sh",
        "install"
      ],
      "timeout_seconds": 1500
    },
    {
      "argv": [
        "bash",
        "features/_shared/setup.sh",
        "sdk"
      ],
      "timeout_seconds": 600
    }
  ],
  "workers": [
    {
      "node_id": "main",
      "role": "sdk",
      "required_check_kinds": [
        "typecheck",
        "unit"
      ],
      "owned_paths": [
        "veashi-sdk"
      ],
      "checks": [
        {
          "id": "typecheck",
          "kind": "typecheck",
          "argv": [
            "yarn",
            "workspace",
            "@kleros/veashi-sdk",
            "build:ts"
          ],
          "timeout_seconds": 600,
          "scenarios": []
        },
        {
          "id": "unit",
          "kind": "unit",
          "argv": [
            "yarn",
            "workspace",
            "@kleros/veashi-sdk",
            "test"
          ],
          "timeout_seconds": 600,
          "scenarios": []
        }
      ]
    }
  ]
}
