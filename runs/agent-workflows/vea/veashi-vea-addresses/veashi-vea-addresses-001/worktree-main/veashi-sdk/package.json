{
  "name": "@kleros/veashi-sdk",
  "version": "0.1.0",
  "description": "SDK and selected smart contracts for Veashi",
  "packageManager": "yarn@4.6.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "contracts",
    "vea"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./contracts/*.sol": "./contracts/*.sol",
    "./vea/testnet.json": "./vea/testnet.json"
  },
  "scripts": {
    "clean": "rm -rf dist contracts typechain-types",
    "extract": "bash ../veashi-contracts/script/generate-types.sh && yarn extract:vea",
    "extract:vea": "node scripts/extract-vea.js",
    "build:ts": "tsc -p tsconfig.json",
    "build": "yarn clean && yarn extract && yarn build:ts",
    "test": "yarn build:ts && node --test \"test/*.test.js\"",
    "prepack": "yarn build"
  },
  "devDependencies": {
    "typescript": "~5.8.0"
  }
}
