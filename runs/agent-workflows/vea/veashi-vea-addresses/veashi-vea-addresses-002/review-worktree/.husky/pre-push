#!/bin/sh
# Local-only guard (lives on workflow/base, never pushed): refuses to push any commit that
# carries the workflow setup (CLAUDE.md or features/). A copy lives in .git/hooks/pre-push
# for when core.hooksPath is unset. Bypass deliberately with `git push --no-verify`.
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if git cat-file -e "$local_sha:features" 2>/dev/null || git cat-file -e "$local_sha:CLAUDE.md" 2>/dev/null; then
    echo "pre-push: refusing to push $local_ref -> $remote_ref: it contains the local workflow setup (CLAUDE.md or features/)." >&2
    echo "pre-push: cherry-pick the fix commits onto a branch cut from dev and push that instead." >&2
    status=1
  fi
done
exit $status
