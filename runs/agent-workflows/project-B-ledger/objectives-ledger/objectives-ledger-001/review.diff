diff --git a/packages/simulation/src/objectives/internal.ts b/packages/simulation/src/objectives/internal.ts
new file mode 100644
index 0000000..5b0e75a
--- /dev/null
+++ b/packages/simulation/src/objectives/internal.ts
@@ -0,0 +1,182 @@
+import {
+  findPlayer,
+  type LedgerCache,
+  type LedgerPlayer,
+  type LedgerRubbing,
+  type LedgerState,
+  type Position,
+  type RubbingLocation,
+} from "./state.js";
+
+/**
+ * Why a request changed nothing (§16: duplicate, stale, unauthorised or already-resolved requests return the current
+ * result without mutating state). A rejected request always returns the very state object it was given.
+ */
+export type LedgerRejection =
+  | "invalid-request"
+  | "stale-tick"
+  | "duplicate"
+  | "unknown-player"
+  | "player-left"
+  | "player-disconnected"
+  | "player-in-duel"
+  | "same-player"
+  | "unknown-source"
+  | "source-locked"
+  | "source-empty"
+  | "type-held"
+  | "unknown-cache"
+  | "not-in-cache"
+  | "no-channel"
+  | "unknown-duel"
+  | "not-a-participant"
+  | "already-resolved"
+  | "not-choosing"
+  | "not-winner"
+  | "choice-window-closed"
+  | "ineligible-type"
+  | "not-disconnected"
+  | "reservation-active"
+  | "reservation-expired";
+
+/** One rubbing move, for §16's transfer record. `revisionAfter` is always `revisionBefore + 1`. */
+export interface Transfer {
+  readonly rubbingId: string;
+  readonly from: RubbingLocation;
+  readonly to: RubbingLocation;
+  readonly revisionBefore: number;
+  readonly revisionAfter: number;
+}
+
+/** What every operation returns: the next state (the same object when nothing changed) and its result. */
+export interface LedgerStep<R> {
+  readonly state: LedgerState;
+  readonly result: R;
+}
+
+/** Moves made so far by one operation, and the caches it opened. */
+export interface Effects {
+  readonly transfers: Transfer[];
+  readonly cacheIds: string[];
+}
+
+export function noEffects(): Effects {
+  return { transfers: [], cacheIds: [] };
+}
+
+function isSafeInteger(value: unknown): value is number {
+  return typeof value === "number" && Number.isSafeInteger(value);
+}
+
+export function isPlayerId(value: unknown): value is string {
+  return typeof value === "string" && value.length > 0;
+}
+
+export function isPosition(value: unknown): value is Position {
+  if (typeof value !== "object" || value === null) return false;
+  const { x, y } = value as Record<string, unknown>;
+  return isSafeInteger(x) && isSafeInteger(y);
+}
+
+/** A request's tick must be a non-negative integer no earlier than the ledger's latest. */
+export function tickRejection(state: LedgerState, tick: unknown): LedgerRejection | null {
+  if (!isSafeInteger(tick) || tick < 0) return "invalid-request";
+  return tick < state.tick ? "stale-tick" : null;
+}
+
+export function atTick(state: LedgerState, tick: number): LedgerState {
+  return tick === state.tick ? state : { ...state, tick };
+}
+
+/** Why a player cannot act in the world right now, if they cannot. */
+export function playerRejection(state: LedgerState, playerId: unknown): LedgerRejection | null {
+  if (!isPlayerId(playerId)) return "invalid-request";
+  const player = findPlayer(state, playerId);
+  if (!player) return "unknown-player";
+  return player.status === "left" ? "player-left" : null;
+}
+
+export function updatePlayer(
+  state: LedgerState,
+  playerId: string,
+  update: (player: LedgerPlayer) => LedgerPlayer,
+): LedgerState {
+  return { ...state, players: state.players.map((player) => (player.id === playerId ? update(player) : player)) };
+}
+
+/** Moves each listed rubbing to its target, bumping its revision, and drops any cache the moves emptied. */
+export function moveRubbings(
+  state: LedgerState,
+  moves: readonly { readonly rubbingId: string; readonly to: RubbingLocation }[],
+  effects: Effects,
+): LedgerState {
+  if (moves.length === 0) return state;
+  const targets = new Map(moves.map((move) => [move.rubbingId, move.to]));
+  if (targets.size !== moves.length) throw new Error("a rubbing cannot move twice in one step");
+  const rubbings = state.rubbings.map((rubbing): LedgerRubbing => {
+    const to = targets.get(rubbing.id);
+    if (to === undefined) return rubbing;
+    targets.delete(rubbing.id);
+    effects.transfers.push({
+      rubbingId: rubbing.id,
+      from: rubbing.location,
+      to,
+      revisionBefore: rubbing.revision,
+      revisionAfter: rubbing.revision + 1,
+    });
+    return { ...rubbing, location: to, revision: rubbing.revision + 1 };
+  });
+  if (targets.size > 0) throw new Error(`unknown rubbings ${[...targets.keys()].join(", ")}`);
+  return dropEmptyCaches({ ...state, rubbings });
+}
+
+function dropEmptyCaches(state: LedgerState): LedgerState {
+  const used = new Set(
+    state.rubbings.flatMap((rubbing) => (rubbing.location.kind === "cache" ? [rubbing.location.cacheId] : [])),
+  );
+  const caches = state.caches.filter((cache) => used.has(cache.id));
+  return caches.length === state.caches.length ? state : { ...state, caches };
+}
+
+/** Opens a recovery cache holding the listed rubbings at a position; with none, no cache appears. */
+export function openCache(
+  state: LedgerState,
+  position: { readonly x: number; readonly y: number },
+  rubbingIds: readonly string[],
+  tick: number,
+  effects: Effects,
+): LedgerState {
+  if (rubbingIds.length === 0) return state;
+  const cache: LedgerCache = { id: `cache-${state.nextCacheNumber}`, x: position.x, y: position.y, createdTick: tick };
+  effects.cacheIds.push(cache.id);
+  const opened = { ...state, caches: [...state.caches, cache], nextCacheNumber: state.nextCacheNumber + 1 };
+  return moveRubbings(
+    opened,
+    rubbingIds.map((rubbingId) => ({ rubbingId, to: { kind: "cache", cacheId: cache.id } as const })),
+    effects,
+  );
+}
+
+/**
+ * Returns rubbings to a player, or, when that player has left the match, into a recovery cache at the place they
+ * left from, so a rubbing never follows a player out of the match.
+ */
+export function releaseTo(
+  state: LedgerState,
+  playerId: string,
+  rubbingIds: readonly string[],
+  tick: number,
+  effects: Effects,
+): LedgerState {
+  const player = findPlayer(state, playerId);
+  if (!player) throw new Error(`unknown player ${playerId}`);
+  if (player.status === "left") {
+    if (player.exit === null) throw new Error(`player ${playerId} left without an exit position`);
+    return openCache(state, player.exit, rubbingIds, tick, effects);
+  }
+  return moveRubbings(
+    state,
+    rubbingIds.map((rubbingId) => ({ rubbingId, to: { kind: "player", playerId } as const })),
+    effects,
+  );
+}
diff --git a/packages/simulation/src/objectives/invariant.ts b/packages/simulation/src/objectives/invariant.ts
new file mode 100644
index 0000000..1d25004
--- /dev/null
+++ b/packages/simulation/src/objectives/invariant.ts
@@ -0,0 +1,189 @@
+import { rulesPresets, type RulesPresetId } from "@pirate-sea-race/content";
+import { presetRubbings, presetRubbingTypes, type RubbingDefinition, type RubbingType } from "@pirate-sea-race/content/objectives";
+import type { LedgerDuel, LedgerPlayer, LedgerState } from "./state.js";
+
+/**
+ * Deeply frozen objects already found to be plain integer data. They cannot change any more, so a later check skips
+ * them: successive states share most of their structure, and this keeps checking every step cheap.
+ */
+const verified = new WeakSet<object>();
+
+/**
+ * What `hashState` needs: plain objects, arrays, strings, booleans, null and safe integers only. Returns the path to
+ * the first offending value, or null.
+ */
+function nonIntegerData(value: unknown): string | null {
+  if (value === null || typeof value === "string" || typeof value === "boolean") return null;
+  if (typeof value === "number") return Number.isSafeInteger(value) ? null : ` = ${value}`;
+  if (typeof value !== "object") return ` is a ${typeof value}`;
+  if (verified.has(value)) return null;
+  let deeplyFrozen = Object.isFrozen(value);
+  const check = (child: unknown, label: string): string | null => {
+    const found = nonIntegerData(child);
+    if (found !== null) return `${label}${found}`;
+    if (typeof child === "object" && child !== null && !verified.has(child)) deeplyFrozen = false;
+    return null;
+  };
+  if (Array.isArray(value)) {
+    for (let index = 0; index < value.length; index++) {
+      const found = check(value[index], `[${index}]`);
+      if (found !== null) return found;
+    }
+  } else {
+    const prototype = Object.getPrototypeOf(value);
+    if (prototype !== Object.prototype && prototype !== null) return " is not a plain object";
+    for (const key in value) {
+      const found = check((value as Record<string, unknown>)[key], `.${key}`);
+      if (found !== null) return found;
+    }
+  }
+  if (deeplyFrozen) verified.add(value);
+  return null;
+}
+
+const facts = new Map<RulesPresetId, { expected: RubbingDefinition[]; types: RubbingType[]; expectedTypes: Map<string, RubbingType> }>();
+
+function presetFacts(presetId: RulesPresetId) {
+  let found = facts.get(presetId);
+  if (found === undefined) {
+    const preset = rulesPresets[presetId];
+    const expected = presetRubbings(preset);
+    found = { expected, types: presetRubbingTypes(preset), expectedTypes: new Map(expected.map((rubbing) => [rubbing.id, rubbing.type])) };
+    facts.set(presetId, found);
+  }
+  return found;
+}
+
+/**
+ * Every rule the ledger must keep between operations (§4, §12, §19 "Inventory correctness"), as a list of
+ * violations; empty when the state is sound:
+ *
+ * - every rubbing id of the preset is present exactly once, with its type, and no other rubbing exists;
+ * - each rubbing has one valid location: its own source, a player still in the match, an existing cache, or a
+ *   reservation for one of the two players of an unresolved duel;
+ * - no player holds (owns or has reserved) two rubbings of one type;
+ * - no cache is empty; a player in an unresolved duel owns nothing outside it, is in only one, and has no channel;
+ * - gold balances are non-negative integers that sum to the gold players brought in;
+ * - the state is plain integer data, so `hashState` covers it.
+ */
+export function checkLedger(state: LedgerState): string[] {
+  const problems: string[] = [];
+  const offending = nonIntegerData(state);
+  if (offending !== null) problems.push(`state is not plain integer data: state${offending}`);
+
+  const { expected, types, expectedTypes } = presetFacts(state.preset);
+  if (state.types.join(",") !== types.join(",")) problems.push(`types ${state.types.join(",")} are not the preset's ${types.join(",")}`);
+
+  const players = new Map<string, LedgerPlayer>();
+  for (const player of state.players) {
+    if (players.has(player.id)) problems.push(`duplicate player id ${player.id}`);
+    players.set(player.id, player);
+  }
+  const sources = new Map(state.sources.map((source) => [source.id, source]));
+  const caches = new Map<string, number>();
+  for (const cache of state.caches) {
+    if (caches.has(cache.id)) problems.push(`duplicate cache id ${cache.id}`);
+    caches.set(cache.id, 0);
+  }
+  const duels = new Map<string, LedgerDuel>();
+  const unresolved = new Map<string, number>();
+  for (const duel of state.duels) {
+    if (duels.has(duel.id)) problems.push(`duplicate duel id ${duel.id}`);
+    duels.set(duel.id, duel);
+    if (duel.phase !== "settled") for (const id of duel.players) unresolved.set(id, (unresolved.get(id) ?? 0) + 1);
+  }
+
+  const seen = new Map<string, number>();
+  const holdings = new Map<string, RubbingType[]>();
+  for (const rubbing of state.rubbings) {
+    seen.set(rubbing.id, (seen.get(rubbing.id) ?? 0) + 1);
+    const type = expectedTypes.get(rubbing.id);
+    if (type === undefined) problems.push(`rubbing ${rubbing.id} is not one of the preset's`);
+    else if (rubbing.type !== type) problems.push(`rubbing ${rubbing.id} has type ${rubbing.type}, not ${type}`);
+    if (rubbing.revision < 0) problems.push(`rubbing ${rubbing.id} has revision ${rubbing.revision}`);
+
+    const location = rubbing.location;
+    const where = `rubbing ${rubbing.id}`;
+    switch (location.kind) {
+      case "source": {
+        const source = sources.get(location.sourceId);
+        if (!source) problems.push(`${where} is at unknown source ${location.sourceId}`);
+        else if (source.rubbingId !== rubbing.id) problems.push(`${where} is at ${source.id}, which seals ${source.rubbingId}`);
+        break;
+      }
+      case "player": {
+        const player = players.get(location.playerId);
+        if (!player) problems.push(`${where} belongs to unknown player ${location.playerId}`);
+        else if (player.status === "left") problems.push(`${where} belongs to ${player.id}, who left`);
+        else if (unresolved.has(player.id)) problems.push(`${where} is owned by ${player.id} outside their duel`);
+        break;
+      }
+      case "cache":
+        if (!caches.has(location.cacheId)) problems.push(`${where} is in unknown cache ${location.cacheId}`);
+        else caches.set(location.cacheId, caches.get(location.cacheId)! + 1);
+        break;
+      case "duel": {
+        const duel = duels.get(location.duelId);
+        if (!duel) problems.push(`${where} is reserved in unknown duel ${location.duelId}`);
+        else if (duel.phase === "settled") problems.push(`${where} is reserved in settled duel ${duel.id}`);
+        else if (!duel.players.includes(location.playerId)) problems.push(`${where} is reserved for ${location.playerId}, not in ${duel.id}`);
+        break;
+      }
+      default:
+        problems.push(`${where} has no valid location`);
+    }
+    if (location.kind === "player" || location.kind === "duel") {
+      const held = holdings.get(location.playerId) ?? [];
+      if (held.includes(rubbing.type)) problems.push(`player ${location.playerId} holds two ${rubbing.type} rubbings`);
+      holdings.set(location.playerId, [...held, rubbing.type]);
+    }
+  }
+  for (const { id } of expected) {
+    const count = seen.get(id) ?? 0;
+    if (count !== 1) problems.push(`rubbing ${id} is present ${count} times`);
+  }
+  if (state.rubbings.length !== expected.length) problems.push(`${state.rubbings.length} rubbings instead of ${expected.length}`);
+  if (state.sources.length !== expected.length) problems.push(`${state.sources.length} sources instead of ${expected.length}`);
+  if (new Set(state.sources.map((source) => source.rubbingId)).size !== expected.length) problems.push("two sources seal the same rubbing");
+  for (const [cacheId, count] of caches) if (count === 0) problems.push(`cache ${cacheId} is empty`);
+
+  let gold = 0;
+  for (const player of state.players) {
+    if (player.gold < 0) problems.push(`player ${player.id} has ${player.gold} gold`);
+    gold += player.gold;
+    const inDuels = unresolved.get(player.id) ?? 0;
+    if (inDuels > 1) problems.push(`player ${player.id} is in ${inDuels} unresolved duels`);
+    if (player.channel !== null && (player.status !== "connected" || inDuels > 0)) {
+      problems.push(`player ${player.id} channels while ${inDuels > 0 ? "in a duel" : player.status}`);
+    }
+    if ((player.status === "disconnected") !== (player.reservationDeadline !== null)) {
+      problems.push(`player ${player.id} is ${player.status} with reservation deadline ${player.reservationDeadline}`);
+    }
+    if ((player.status === "left") !== (player.exit !== null)) problems.push(`player ${player.id} is ${player.status} with exit ${JSON.stringify(player.exit)}`);
+    if (player.freshRumors.some((type, index) => !types.includes(type) || player.freshRumors.indexOf(type) !== index)) {
+      problems.push(`player ${player.id} has fresh rumors ${player.freshRumors.join(",")}`);
+    }
+  }
+  if (gold !== state.goldIssued) problems.push(`balances sum to ${gold} gold, but ${state.goldIssued} was issued`);
+
+  for (const duel of state.duels) {
+    if (duel.phase === "fighting") {
+      if (duel.result !== null || duel.settlement !== null) problems.push(`duel ${duel.id} fights with a result`);
+      for (const playerId of duel.players) {
+        if (players.get(playerId)?.status === "left") problems.push(`duel ${duel.id} fights on without ${playerId}, who left`);
+      }
+    } else if (duel.phase === "choosing") {
+      if (duel.result?.outcome !== "win" || duel.choiceDeadline === null) problems.push(`duel ${duel.id} chooses without a win`);
+      else if (players.get(duel.result.winner ?? "")?.status === "left") problems.push(`duel ${duel.id} waits for a winner who left`);
+    } else if (duel.result === null || duel.settlement === null) {
+      problems.push(`duel ${duel.id} settled without a result`);
+    }
+  }
+  return problems;
+}
+
+/** Throws with every violation when the ledger breaks its invariant. */
+export function assertLedger(state: LedgerState): void {
+  const problems = checkLedger(state);
+  if (problems.length > 0) throw new Error(`ledger invariant broken:\n${problems.join("\n")}`);
+}
diff --git a/packages/simulation/src/objectives/ledger.test.ts b/packages/simulation/src/objectives/ledger.test.ts
new file mode 100644
index 0000000..a528f6f
--- /dev/null
+++ b/packages/simulation/src/objectives/ledger.test.ts
@@ -0,0 +1,545 @@
+import { rulesPresets, type RulesPresetId } from "@pirate-sea-race/content";
+import { describe, expect, it } from "vitest";
+import {
+  addPlayer,
+  advanceLedger,
+  assertLedger,
+  assignSources,
+  cacheRubbings,
+  cancelChannel,
+  checkLedger,
+  chooseTheft,
+  createLedger,
+  disconnectPlayer,
+  eligibleTheftTypes,
+  expireReservation,
+  findDuel,
+  findPlayer,
+  findRubbing,
+  hashState,
+  heldTypes,
+  holdsAllTypes,
+  progressChannel,
+  quitPlayer,
+  reconnectPlayer,
+  reportDuelResult,
+  reserveDuel,
+  startCacheClaim,
+  startCollect,
+  unlockSource,
+  type LedgerState,
+  type LedgerStep,
+  type RubbingLocation,
+  type SourceSite,
+} from "./index.js";
+
+function sites(preset: RulesPresetId): SourceSite[] {
+  const { islands, sourcesPerIsland } = rulesPresets[preset];
+  return Array.from({ length: islands * sourcesPerIsland }, (_, index) => ({
+    island: Math.floor(index / sourcesPerIsland),
+    x: 1000 * index,
+    y: 500,
+  }));
+}
+
+/** Freezes a state deeply, so any operation that writes into its input throws. */
+function deepFreeze<T>(value: T): T {
+  if (typeof value !== "object" || value === null || Object.isFrozen(value)) return value;
+  for (const child of Object.values(value)) deepFreeze(child);
+  return Object.freeze(value);
+}
+
+/**
+ * A ledger under test: every operation runs on a frozen state, the invariant is checked after it, and a rejected
+ * request must hand back the very state it was given.
+ */
+class Run {
+  state: LedgerState;
+  now = 1;
+
+  constructor(preset: RulesPresetId, players: readonly string[], seed = 11) {
+    let state = createLedger({ preset, seed, sites: sites(preset) });
+    for (const source of state.sources) state = unlockSource(state, { sourceId: source.id, tick: 0 }).state;
+    for (const playerId of players) state = addPlayer(state, { playerId, tick: 0 }).state;
+    assertLedger(state);
+    this.state = deepFreeze(state);
+  }
+
+  do<Q, R extends { readonly ok: boolean }>(op: (state: LedgerState, request: Q) => LedgerStep<R>, request: Q): R {
+    const before = this.state;
+    const { state, result } = op(before, request);
+    assertLedger(state);
+    if (!result.ok) expect(state).toBe(before);
+    this.state = deepFreeze(state);
+    return result;
+  }
+
+  where(rubbingId: string): RubbingLocation {
+    return findRubbing(this.state, rubbingId)!.location;
+  }
+
+  sourceOf(rubbingId: string): string {
+    return this.state.sources.find((source) => source.rubbingId === rubbingId)!.id;
+  }
+
+  gold(playerId: string): number {
+    return findPlayer(this.state, playerId)!.gold;
+  }
+
+  /** Holds interact for the full six seconds from the next tick. */
+  hold(playerId: string, ticks = this.state.rules.collectTicks) {
+    let last;
+    for (let index = 0; index < ticks; index++) last = this.do(progressChannel, { playerId, tick: ++this.now });
+    return last!;
+  }
+
+  collect(playerId: string, rubbingId: string): void {
+    expect(this.do(startCollect, { playerId, sourceId: this.sourceOf(rubbingId), tick: this.now }).status).toBe("started");
+    expect(this.hold(playerId).status).toBe("collected");
+    expect(this.where(rubbingId)).toEqual({ kind: "player", playerId });
+  }
+
+  duel(duelId: string, a: string, b: string, winner: string | null) {
+    expect(this.do(reserveDuel, { duelId, players: [a, b], tick: ++this.now }).ok).toBe(true);
+    return this.do(
+      reportDuelResult,
+      winner === null ? { duelId, tick: ++this.now, outcome: "draw" } : { duelId, tick: ++this.now, outcome: "win", winner },
+    );
+  }
+}
+
+const player = (playerId: string): RubbingLocation => ({ kind: "player", playerId });
+
+describe("ledger state and content", () => {
+  it("seals the slice's 8 and the alpha's 12 rubbings, one per source, all locked at first", () => {
+    for (const [preset, count] of [["slice", 8], ["alpha", 12]] as const) {
+      const state = createLedger({ preset, seed: 3, sites: sites(preset) });
+      assertLedger(state);
+      expect(state.rubbings).toHaveLength(count);
+      expect(state.sources.every((source) => !source.unlocked)).toBe(true);
+      for (const rubbing of state.rubbings) {
+        const source = state.sources.find((candidate) => candidate.rubbingId === rubbing.id)!;
+        expect(rubbing.location).toEqual({ kind: "source", sourceId: source.id });
+        expect(rubbing.type).toBe(source.type);
+      }
+    }
+  });
+
