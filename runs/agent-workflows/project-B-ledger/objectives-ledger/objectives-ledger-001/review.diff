@@ -0,0 +1,52 @@
+import { z } from "zod";
+import type { RulesPreset } from "../rules.js";
+
+/**
+ * The four rubbing types of §4, in the fixed type order that breaks ties when a theft defaults. A preset with fewer
+ * types (the slice's two) uses the first ones of this order.
+ */
+export const RUBBING_TYPES = ["sun", "moon", "tide", "storm"] as const;
+
+export const rubbingTypeSchema = z.enum(RUBBING_TYPES);
+export type RubbingType = z.infer<typeof rubbingTypeSchema>;
+
+/** A rubbing's stable id: its type and its copy number from 1, such as `tide-2`. It never changes (§4). */
+export const rubbingIdSchema = z.string().regex(/^(sun|moon|tide|storm)-[1-9][0-9]*$/, "a rubbing id is <type>-<copy>");
+
+/** The position of a type in the fixed type order. */
+export function rubbingTypeOrder(type: RubbingType): number {
+  return RUBBING_TYPES.indexOf(type);
+}
+
+export function rubbingId(type: RubbingType, copy: number): string {
+  if (!Number.isInteger(copy) || copy < 1) throw new RangeError(`a rubbing copy number starts at 1, got ${copy}`);
+  return `${type}-${copy}`;
+}
+
+/** The type a rubbing id names, or null for a malformed id. */
+export function rubbingTypeOf(id: string): RubbingType | null {
+  if (!rubbingIdSchema.safeParse(id).success) return null;
+  return id.slice(0, id.indexOf("-")) as RubbingType;
+}
+
+/** The types a preset plays with, in the fixed type order. */
+export function presetRubbingTypes(preset: RulesPreset): RubbingType[] {
+  if (preset.rubbingTypes > RUBBING_TYPES.length) {
+    throw new RangeError(`preset ${preset.id} asks for ${preset.rubbingTypes} rubbing types; there are ${RUBBING_TYPES.length}`);
+  }
+  return RUBBING_TYPES.slice(0, preset.rubbingTypes);
+}
+
+export interface RubbingDefinition {
+  readonly id: string;
+  readonly type: RubbingType;
+}
+
+/** Every rubbing of a preset, by type order then copy: `sun-1`, `sun-2`, … (slice: 2 × 4; alpha: 4 × 3). */
+export function presetRubbings(preset: RulesPreset): RubbingDefinition[] {
+  const copies = preset.rubbings / preset.rubbingTypes;
+  if (!Number.isInteger(copies)) throw new RangeError(`preset ${preset.id}: rubbings must split evenly across types`);
+  return presetRubbingTypes(preset).flatMap((type) =>
+    Array.from({ length: copies }, (_, index) => ({ id: rubbingId(type, index + 1), type })),
+  );
+}
