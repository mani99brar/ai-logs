} from "./index.js";

function sites(preset: RulesPresetId): SourceSite[] {
  const { islands, sourcesPerIsland } = rulesPresets[preset];
  return Array.from({ length: islands * sourcesPerIsland }, (_, index) => ({
    island: Math.floor(index / sourcesPerIsland),
    x: 1000 * index,
    y: 500,
  }));
}

/** Freezes a state deeply, so any operation that writes into its input throws. */
function deepFreeze<T>(value: T): T {
  if (typeof value !== "object" || value === null || Object.isFrozen(value)) return value;
  for (const child of Object.values(value)) deepFreeze(child);
  return Object.freeze(value);
}

/**
 * A ledger under test: every operation runs on a frozen state, the invariant is checked after it, and a rejected
 * request must hand back the very state it was given.
 */
class Run {
  state: LedgerState;
  now = 1;

  constructor(preset: RulesPresetId, players: readonly string[], seed = 11) {
    let state = createLedger({ preset, seed, sites: sites(preset) });
    for (const source of state.sources) state = unlockSource(state, { sourceId: source.id, tick: 0 }).state;
    for (const playerId of players) state = addPlayer(state, { playerId, tick: 0 }).state;
    assertLedger(state);
    this.state = deepFreeze(state);
  }

  do<Q, R extends { readonly ok: boolean }>(op: (state: LedgerState, request: Q) => LedgerStep<R>, request: Q): R {
    const before = this.state;
    const { state, result } = op(before, request);
    assertLedger(state);
    if (!result.ok) expect(state).toBe(before);
    this.state = deepFreeze(state);
    return result;
  }

  where(rubbingId: string): RubbingLocation {
    return findRubbing(this.state, rubbingId)!.location;
  }

  sourceOf(rubbingId: string): string {
    return this.state.sources.find((source) => source.rubbingId === rubbingId)!.id;
  }

  gold(playerId: string): number {
    return findPlayer(this.state, playerId)!.gold;
  }

  /** Holds interact for the full six seconds from the next tick. */
  hold(playerId: string, ticks = this.state.rules.collectTicks) {
    let last;
    for (let index = 0; index < ticks; index++) last = this.do(progressChannel, { playerId, tick: ++this.now });
    return last!;
  }

  collect(playerId: string, rubbingId: string): void {
    expect(this.do(startCollect, { playerId, sourceId: this.sourceOf(rubbingId), tick: this.now }).status).toBe("started");
    expect(this.hold(playerId).status).toBe("collected");
    expect(this.where(rubbingId)).toEqual({ kind: "player", playerId });
  }

  duel(duelId: string, a: string, b: string, winner: string | null) {
    expect(this.do(reserveDuel, { duelId, players: [a, b], tick: ++this.now }).ok).toBe(true);
    return this.do(
      reportDuelResult,
      winner === null ? { duelId, tick: ++this.now, outcome: "draw" } : { duelId, tick: ++this.now, outcome: "win", winner },
    );
  }
}

const player = (playerId: string): RubbingLocation => ({ kind: "player", playerId });

describe("ledger state and content", () => {
  it("seals the slice's 8 and the alpha's 12 rubbings, one per source, all locked at first", () => {
    for (const [preset, count] of [["slice", 8], ["alpha", 12]] as const) {
      const state = createLedger({ preset, seed: 3, sites: sites(preset) });
      assertLedger(state);
      expect(state.rubbings).toHaveLength(count);
      expect(state.sources.every((source) => !source.unlocked)).toBe(true);
      for (const rubbing of state.rubbings) {
        const source = state.sources.find((candidate) => candidate.rubbingId === rubbing.id)!;
        expect(rubbing.location).toEqual({ kind: "source", sourceId: source.id });
        expect(rubbing.type).toBe(source.type);
      }
    }
  });

  it("deals the rubbings onto islands from the seed alone", () => {
    const deal = (seed: number) => assignSources("alpha", sites("alpha"), seed).assignment.sources.map((source) => source.rubbingId);
    expect(deal(5)).toEqual(deal(5));
    const deals = new Set([1, 2, 3, 4, 5, 6].map((seed) => deal(seed).join(",")));
    expect(deals.size).toBeGreaterThan(1);
    expect(() => assignSources("slice", sites("alpha"), 1)).toThrow(/invalid source sites/);
  });

  it("finds every broken rule in a corrupted state", () => {
    const run = new Run("slice", ["a", "b"]);
    run.collect("a", "sun-1");
    const state = run.state;
    const duplicated = { ...state, rubbings: [...state.rubbings, state.rubbings[0]!] };
    expect(checkLedger(duplicated).join("\n")).toMatch(/present 2 times/);
    const lost = { ...state, rubbings: state.rubbings.slice(1) };
    expect(checkLedger(lost).join("\n")).toMatch(/present 0 times/);
    const twoSuns = {
      ...state,
      rubbings: state.rubbings.map((rubbing) => (rubbing.id === "sun-2" ? { ...rubbing, location: player("a") } : rubbing)),
    };
    expect(checkLedger(twoSuns).join("\n")).toMatch(/holds two sun/);
    const nowhere = {
      ...state,
      rubbings: state.rubbings.map((rubbing) => (rubbing.id === "moon-1" ? { ...rubbing, location: player("ghost") } : rubbing)),
    };
    expect(checkLedger(nowhere).join("\n")).toMatch(/unknown player ghost/);
    const minted = { ...state, players: state.players.map((entry) => ({ ...entry, gold: entry.gold + 1 })) };
    expect(checkLedger(minted).join("\n")).toMatch(/balances sum/);
    const emptyCache = { ...state, caches: [{ id: "cache-9", x: 0, y: 0, createdTick: 0 }] };
    expect(checkLedger(emptyCache).join("\n")).toMatch(/cache cache-9 is empty/);
  });
});

describe("collection (§4)", () => {
  it("takes six uninterrupted seconds at an unlocked source", () => {
    const run = new Run("slice", ["a"]);
    const sourceId = run.sourceOf("moon-2");
    expect(run.do(startCollect, { playerId: "a", sourceId, tick: run.now }).status).toBe("started");
    expect(run.hold("a", 119).status).toBe("held");
    expect(run.where("moon-2").kind).toBe("source");
    const done = run.do(progressChannel, { playerId: "a", tick: ++run.now });
    expect(done).toMatchObject({ status: "collected", rubbingId: "moon-2", channel: null });
    expect(done.transfers).toEqual([
      { rubbingId: "moon-2", from: { kind: "source", sourceId }, to: player("a"), revisionBefore: 0, revisionAfter: 1 },
    ]);
    expect(run.do(progressChannel, { playerId: "a", tick: ++run.now }).rejection).toBe("no-channel");
  });

  it("resets progress on an interruption and ends it on cancel", () => {
    const run = new Run("slice", ["a"]);
    const sourceId = run.sourceOf("sun-1");
    run.do(startCollect, { playerId: "a", sourceId, tick: run.now });
    run.hold("a", 100);
    run.now += 2;
    const reset = run.do(progressChannel, { playerId: "a", tick: run.now });
    expect(reset.status).toBe("reset");
    expect(reset.channel).toMatchObject({ heldTicks: 0, startTick: run.now });
    expect(run.hold("a", 119).status).toBe("held");
    expect(run.do(cancelChannel, { playerId: "a", tick: run.now }).status).toBe("cancelled");
    expect(run.do(progressChannel, { playerId: "a", tick: ++run.now }).rejection).toBe("no-channel");
    expect(run.where("sun-1").kind).toBe("source");
    expect(run.do(cancelChannel, { playerId: "a", tick: run.now }).rejection).toBe("no-channel");
  });

  it("ignores duplicate starts and stale progress", () => {
    const run = new Run("slice", ["a"]);
    const sourceId = run.sourceOf("sun-1");
    run.do(startCollect, { playerId: "a", sourceId, tick: run.now });
    run.hold("a", 10);
    expect(run.do(startCollect, { playerId: "a", sourceId, tick: run.now }).rejection).toBe("duplicate");
    expect(run.do(progressChannel, { playerId: "a", tick: run.now }).rejection).toBe("duplicate");
    expect(run.do(progressChannel, { playerId: "a", tick: run.now - 3 }).rejection).toBe("stale-tick");
    expect(findPlayer(run.state, "a")!.channel!.heldTicks).toBe(10);
  });

  it("refuses a locked source, an emptied one, and a type the player holds, which stays sealed", () => {
    const run = new Run("slice", ["a", "b"]);
    const locked = createLedger({ preset: "slice", seed: 11, sites: sites("slice") });
    const withPlayer = addPlayer(locked, { playerId: "a", tick: 0 }).state;
    expect(startCollect(withPlayer, { playerId: "a", sourceId: locked.sources[0]!.id, tick: 0 }).result.rejection).toBe("source-locked");

    run.collect("a", "sun-1");
    const refused = run.do(startCollect, { playerId: "a", sourceId: run.sourceOf("sun-2"), tick: run.now });
    expect(refused.rejection).toBe("type-held");
    expect(run.where("sun-2").kind).toBe("source");
    expect(run.do(startCollect, { playerId: "b", sourceId: run.sourceOf("sun-1"), tick: run.now }).rejection).toBe("source-empty");
    expect(run.do(startCollect, { playerId: "b", sourceId: "source-99-0", tick: run.now }).rejection).toBe("unknown-source");
    expect(run.do(startCollect, { playerId: "ghost", sourceId: run.sourceOf("sun-2"), tick: run.now }).rejection).toBe("unknown-player");
  });

  it("gives a contested source to the first player to finish only", () => {
    const run = new Run("slice", ["a", "b"]);
    const sourceId = run.sourceOf("moon-1");
    run.do(startCollect, { playerId: "a", sourceId, tick: run.now });
    run.do(startCollect, { playerId: "b", sourceId, tick: run.now });
    for (let tick = 1; tick <= 120; tick++) {
      run.now++;
      const first = run.do(progressChannel, { playerId: "b", tick: run.now });
      const second = run.do(progressChannel, { playerId: "a", tick: run.now });
      if (tick === 120) {
        expect(first.status).toBe("collected");
        expect(second).toMatchObject({ status: "failed", failure: "source-empty" });
      }
    }
    expect(run.where("moon-1")).toEqual(player("b"));
    expect(heldTypes(run.state, "a")).toEqual([]);
  });

  it("reports whether a player holds every type", () => {
    const run = new Run("slice", ["a"]);
    run.collect("a", "sun-3");
    expect(holdsAllTypes(run.state, "a")).toBe(false);
    run.collect("a", "moon-4");
    expect(holdsAllTypes(run.state, "a")).toBe(true);
  });
});

describe("duel settlement (§4, §11)", () => {
  it("reserves both inventories, cancels channels and blocks collection until settled", () => {
    const run = new Run("slice", ["a", "b"]);
    run.collect("a", "sun-1");
    run.do(startCollect, { playerId: "b", sourceId: run.sourceOf("moon-1"), tick: run.now });
    run.hold("b", 5);
    const reserved = run.do(reserveDuel, { duelId: "d1", players: ["a", "b"], tick: ++run.now });
    expect(reserved.duel).toMatchObject({ phase: "fighting", players: ["a", "b"] });
    expect(run.where("sun-1")).toEqual({ kind: "duel", duelId: "d1", playerId: "a" });
    expect(findPlayer(run.state, "b")!.channel).toBeNull();
    expect(run.do(startCollect, { playerId: "b", sourceId: run.sourceOf("moon-1"), tick: run.now }).rejection).toBe("player-in-duel");
    expect(run.do(reserveDuel, { duelId: "d1", players: ["a", "b"], tick: run.now }).rejection).toBe("duplicate");
    expect(run.do(reserveDuel, { duelId: "d2", players: ["b", "a"], tick: run.now }).rejection).toBe("player-in-duel");
    expect(run.do(reserveDuel, { duelId: "d3", players: ["a", "a"], tick: run.now }).rejection).toBe("same-player");
  });

  it("lets the winner choose an eligible type within the window, once", () => {
    const run = new Run("alpha", ["a", "b"]);
    run.collect("b", "sun-1");
    run.collect("b", "moon-1");
    run.collect("a", "moon-2");
    const decided = run.duel("d1", "a", "b", "a");
    expect(decided.duel).toMatchObject({ phase: "choosing", choiceDeadline: run.now + 100 });
    expect(eligibleTheftTypes(run.state, "d1")).toEqual(["sun"]);

    expect(run.do(chooseTheft, { duelId: "d1", playerId: "b", type: "sun", tick: run.now }).rejection).toBe("not-winner");
    expect(run.do(chooseTheft, { duelId: "d1", playerId: "a", type: "moon", tick: run.now }).rejection).toBe("ineligible-type");
    const chosen = run.do(chooseTheft, { duelId: "d1", playerId: "a", type: "sun", tick: run.now + 99 });
    expect(chosen.duel!.settlement).toMatchObject({ stolenRubbingId: "sun-1", choice: "winner", gold: 10, goldSuppressed: false });
    expect(run.where("sun-1")).toEqual(player("a"));
    expect(run.where("moon-1")).toEqual(player("b"));
    expect(run.where("moon-2")).toEqual(player("a"));
    expect([run.gold("a"), run.gold("b")]).toEqual([60, 40]);
    expect(findPlayer(run.state, "b")!.freshRumors).toEqual(["sun"]);

    const settled = run.state;
    for (const repeat of [
      () => run.do(chooseTheft, { duelId: "d1", playerId: "a", type: "sun", tick: run.now + 99 }),
      () => run.do(reportDuelResult, { duelId: "d1", tick: run.now + 99, outcome: "win", winner: "b" }),
      () => run.do(reportDuelResult, { duelId: "d1", tick: run.now + 99, outcome: "draw" }),
      () => run.do(advanceLedger, { tick: run.now + 500 }),
    ]) {
      const result = repeat();
      if ("duel" in result) expect(result).toMatchObject({ rejection: "already-resolved", duel: { phase: "settled" } });
    }
    expect(run.state.rubbings).toEqual(settled.rubbings);
    expect(run.state.players).toEqual(settled.players);
  });

  it("refuses a choice after the window and defaults to the type with the fewest free sources", () => {
    const run = new Run("alpha", ["a", "b", "c"]);
    run.collect("b", "sun-1");
    run.collect("b", "moon-1");
    run.collect("b", "tide-1");
    run.collect("c", "tide-2");
    run.duel("d1", "a", "b", "a");
    const deadline = findDuel(run.state, "d1")!.choiceDeadline!;
    expect(run.do(advanceLedger, { tick: deadline - 1 }).settled).toEqual([]);
    expect(run.do(chooseTheft, { duelId: "d1", playerId: "a", type: "sun", tick: deadline }).rejection).toBe("choice-window-closed");
    const expired = run.do(advanceLedger, { tick: deadline });
    expect(expired.settled.map((duel) => duel.settlement)).toMatchObject([{ stolenType: "tide", choice: "default" }]);
    expect(run.where("tide-1")).toEqual(player("a"));
  });

  it("breaks a default tie by the fixed type order", () => {
    const run = new Run("alpha", ["a", "b"]);
    run.collect("b", "tide-1");
    run.collect("b", "sun-1");
    run.collect("b", "moon-1");
    run.collect("a", "moon-2");
    run.duel("d1", "a", "b", "a");
    run.do(advanceLedger, { tick: run.now + 100 });
    expect(findDuel(run.state, "d1")!.settlement).toMatchObject({ stolenType: "sun", choice: "default" });
  });

  it("moves no rubbing but still gold when no type is eligible", () => {
    const run = new Run("slice", ["a", "b"]);
    run.collect("a", "sun-1");
    run.collect("b", "sun-2");
    const result = run.duel("d1", "a", "b", "a");
    expect(result.duel).toMatchObject({ phase: "settled", settlement: { stolenRubbingId: null, choice: "none", gold: 10 } });
    expect(run.where("sun-1")).toEqual(player("a"));
    expect(run.where("sun-2")).toEqual(player("b"));
    expect(findPlayer(run.state, "b")!.freshRumors).toEqual([]);
  });

  it("moves nothing on a draw or a same-tick double forfeit", () => {
    const run = new Run("slice", ["a", "b"]);
    run.collect("a", "sun-1");
    run.collect("b", "moon-1");
    const before = { rubbings: run.state.rubbings.map((rubbing) => [rubbing.id, rubbing.location]), gold: [run.gold("a"), run.gold("b")] };
    expect(run.duel("d1", "a", "b", null).duel).toMatchObject({ phase: "settled", settlement: { gold: 0, choice: "none" } });
    run.do(reserveDuel, { duelId: "d2", players: ["a", "b"], tick: ++run.now });
    run.do(reportDuelResult, { duelId: "d2", tick: ++run.now, outcome: "cancelled" });
    expect(run.state.rubbings.map((rubbing) => [rubbing.id, rubbing.location])).toEqual(before.rubbings);
    expect([run.gold("a"), run.gold("b")]).toEqual(before.gold);
    expect(run.do(reportDuelResult, { duelId: "nope", tick: run.now, outcome: "draw" }).rejection).toBe("unknown-duel");
    expect(run.do(reportDuelResult, { duelId: "d2", tick: run.now, outcome: "win", winner: "a" }).rejection).toBe("already-resolved");
  });

  it("rounds gold down, caps it at 50 and never takes more than the loser has", () => {
    const cases: [number, number][] = [[57, 11], [4, 0], [400, 50], [0, 0]];
    cases.forEach(([loserGold, taken], index) => {
      let state = createLedger({ preset: "slice", seed: index, sites: sites("slice") });
      state = addPlayer(state, { playerId: "w", tick: 0 }).state;
      state = addPlayer(state, { playerId: "l", tick: 0, gold: loserGold }).state;
      state = reserveDuel(state, { duelId: "d", players: ["w", "l"], tick: 1 }).state;
      state = reportDuelResult(state, { duelId: "d", tick: 2, outcome: "win", winner: "w" }).state;
      assertLedger(state);
      expect(findPlayer(state, "l")!.gold).toBe(loserGold - taken);
      expect(findPlayer(state, "w")!.gold).toBe(50 + taken);
    });
  });

  it("suppresses gold for a repeated win within three minutes, but theft still applies", () => {
    const run = new Run("slice", ["a", "b"]);
    run.collect("b", "sun-1");
    run.duel("d1", "a", "b", "a");
    run.do(chooseTheft, { duelId: "d1", playerId: "a", type: "sun", tick: run.now });
    expect(findDuel(run.state, "d1")!.settlement).toMatchObject({ gold: 10, goldSuppressed: false });
    run.collect("b", "moon-1");
    run.duel("d2", "b", "a", "a");
    run.do(chooseTheft, { duelId: "d2", playerId: "a", type: "moon", tick: run.now });
    expect(findDuel(run.state, "d2")!.settlement).toMatchObject({ stolenType: "moon", gold: 0, goldSuppressed: true });
    expect([run.gold("a"), run.gold("b")]).toEqual([60, 40]);

    // The window runs from the previous win, paid or not: 3599 ticks later is still inside it, 3600 is not.
    run.now = findDuel(run.state, "d2")!.result!.tick + 3597;
    run.duel("d3", "a", "b", "a");
    expect(findDuel(run.state, "d3")!.result!.tick - findDuel(run.state, "d2")!.result!.tick).toBe(3599);
    expect(findDuel(run.state, "d3")!.settlement).toMatchObject({ gold: 0, goldSuppressed: true });
    run.now += 3598;
    run.duel("d4", "a", "b", "a");
    expect(findDuel(run.state, "d4")!.result!.tick - findDuel(run.state, "d3")!.result!.tick).toBe(3600);
    expect(findDuel(run.state, "d4")!.settlement).toMatchObject({ gold: 8, goldSuppressed: false });
    expect([run.gold("a"), run.gold("b")]).toEqual([68, 32]);

    // Suppression is per ordered pair: b's first win over a pays.
    run.duel("d5", "b", "a", "b");
    run.do(advanceLedger, { tick: run.now + 100 });
    expect(findDuel(run.state, "d5")!.settlement).toMatchObject({ stolenType: "sun", choice: "default", gold: 13, goldSuppressed: false });
  });
});

describe("disconnects, quits and recovery caches (§12)", () => {
  it("drops a quitting player's rubbings into one cache at the given position", () => {
    const run = new Run("slice", ["a", "b"]);
    run.collect("a", "sun-1");
    run.collect("a", "moon-1");
    const quit = run.do(quitPlayer, { playerId: "a", tick: run.now, position: { x: 7, y: 9 } });
    expect(quit.cacheIds).toEqual(["cache-1"]);
    expect(run.state.caches).toEqual([{ id: "cache-1", x: 7, y: 9, createdTick: run.now }]);
    expect(cacheRubbings(run.state, "cache-1").map((rubbing) => rubbing.id)).toEqual(["moon-1", "sun-1"]);
    expect(run.do(quitPlayer, { playerId: "a", tick: run.now, position: { x: 0, y: 0 } }).rejection).toBe("player-left");
    expect(run.do(startCollect, { playerId: "a", sourceId: run.sourceOf("sun-2"), tick: run.now }).rejection).toBe("player-left");
    expect(run.do(addPlayer, { playerId: "a", tick: run.now }).rejection).toBe("duplicate");
  });

  it("opens no cache for a player who held nothing", () => {
    const run = new Run("slice", ["a"]);
    expect(run.do(quitPlayer, { playerId: "a", tick: run.now, position: { x: 0, y: 0 } }).cacheIds).toEqual([]);
    expect(run.state.caches).toEqual([]);
  });

  it("keeps a disconnected seat for 60 seconds, then caches what the player holds", () => {
    const run = new Run("slice", ["a"]);
    run.collect("a", "sun-1");
    run.do(startCollect, { playerId: "a", sourceId: run.sourceOf("moon-1"), tick: run.now });
    const gone = run.do(disconnectPlayer, { playerId: "a", tick: ++run.now });
    const deadline = run.now + 1200;
    expect(gone.player).toMatchObject({ status: "disconnected", reservationDeadline: deadline, channel: null });
    expect(run.do(disconnectPlayer, { playerId: "a", tick: run.now + 5 }).rejection).toBe("duplicate");
    expect(run.do(startCollect, { playerId: "a", sourceId: run.sourceOf("moon-1"), tick: run.now }).rejection).toBe("player-disconnected");
    expect(run.do(expireReservation, { playerId: "a", tick: deadline - 1, position: { x: 1, y: 1 } }).rejection).toBe("reservation-active");
    expect(run.do(reconnectPlayer, { playerId: "a", tick: deadline - 1 }).player!.status).toBe("connected");
    expect(run.do(reconnectPlayer, { playerId: "a", tick: deadline - 1 }).rejection).toBe("not-disconnected");

    run.do(disconnectPlayer, { playerId: "a", tick: deadline });
    expect(run.do(reconnectPlayer, { playerId: "a", tick: deadline + 1200 }).rejection).toBe("reservation-expired");
    const expired = run.do(expireReservation, { playerId: "a", tick: deadline + 1200, position: { x: 3, y: 4 } });
    expect(expired.player!.status).toBe("left");
    expect(run.where("sun-1")).toEqual({ kind: "cache", cacheId: expired.cacheIds[0] });
  });

  it("transfers a disconnected loser's rubbing first, keeps the deadline, and caches only the rest", () => {
    const run = new Run("alpha", ["a", "b"]);
    run.collect("b", "sun-1");
    run.collect("b", "moon-1");
    run.do(disconnectPlayer, { playerId: "b", tick: ++run.now });
    const deadline = findPlayer(run.state, "b")!.reservationDeadline!;
    run.duel("d1", "a", "b", "a");
    run.do(chooseTheft, { duelId: "d1", playerId: "a", type: "moon", tick: run.now });
    expect(findPlayer(run.state, "b")).toMatchObject({ status: "disconnected", reservationDeadline: deadline });
    const expired = run.do(expireReservation, { playerId: "b", tick: deadline, position: { x: 50, y: 60 } });
    expect(cacheRubbings(run.state, expired.cacheIds[0]!).map((rubbing) => rubbing.id)).toEqual(["sun-1"]);
    expect(run.where("moon-1")).toEqual(player("a"));
  });

  it("forfeits a fight on quit: the opponent steals, the rest goes into a cache", () => {
    const run = new Run("alpha", ["a", "b"]);
    run.collect("b", "sun-1");
    run.collect("b", "moon-1");
    run.do(reserveDuel, { duelId: "d1", players: ["a", "b"], tick: ++run.now });
    const quit = run.do(quitPlayer, { playerId: "b", tick: ++run.now, position: { x: 5, y: 5 } });
    expect(quit.duel).toMatchObject({ phase: "choosing", result: { winner: "a", loser: "b", forfeit: true } });
    expect(run.state.caches).toEqual([]);
    expect(run.do(reportDuelResult, { duelId: "d1", tick: run.now, outcome: "win", winner: "b" }).rejection).toBe("already-resolved");
    run.do(chooseTheft, { duelId: "d1", playerId: "a", type: "moon", tick: run.now });
    expect(run.where("moon-1")).toEqual(player("a"));
    expect(run.where("sun-1")).toMatchObject({ kind: "cache" });
    expect(run.state.caches[0]).toMatchObject({ x: 5, y: 5 });
  });

  it("settles at once, taking nothing, when the winner quits during the choice", () => {
    const run = new Run("alpha", ["a", "b"]);
    run.collect("a", "tide-1");
    run.collect("b", "sun-1");
    run.duel("d1", "a", "b", "a");
    const quit = run.do(quitPlayer, { playerId: "a", tick: ++run.now, position: { x: 8, y: 8 } });
    expect(quit.duel!.settlement).toMatchObject({ stolenRubbingId: null, gold: 0, choice: "none" });
    expect(run.where("sun-1")).toEqual(player("b"));
    expect(run.where("tide-1")).toMatchObject({ kind: "cache" });
    expect([run.gold("a"), run.gold("b")]).toEqual([50, 50]);
  });

  it("caches both inventories when both players leave a fight", () => {
    const run = new Run("alpha", ["a", "b"]);
    run.collect("a", "tide-1");
    run.collect("b", "sun-1");
    run.do(reserveDuel, { duelId: "d1", players: ["a", "b"], tick: ++run.now });
    run.do(quitPlayer, { playerId: "a", tick: ++run.now, position: { x: 1, y: 0 } });
    run.do(quitPlayer, { playerId: "b", tick: run.now, position: { x: 2, y: 0 } });
    expect(findDuel(run.state, "d1")!.settlement).toMatchObject({ stolenRubbingId: null, gold: 0 });
    expect(run.state.caches.map((cache) => [cache.x, cacheRubbings(run.state, cache.id).map((rubbing) => rubbing.id)])).toEqual([
      [2, ["sun-1"]],
      [1, ["tide-1"]],
    ]);
  });

  it("lets only a player missing the type claim a cached rubbing, one per interaction, until the cache is gone", () => {
    const run = new Run("slice", ["a", "b", "c"]);
    run.collect("a", "sun-1");
    run.collect("a", "moon-1");
    run.collect("b", "sun-2");
    const cacheId = run.do(quitPlayer, { playerId: "a", tick: run.now, position: { x: 0, y: 0 } }).cacheIds[0]!;
    expect(run.do(startCacheClaim, { playerId: "b", cacheId, rubbingId: "sun-1", tick: run.now }).rejection).toBe("type-held");
    expect(run.do(startCacheClaim, { playerId: "b", cacheId, rubbingId: "sun-3", tick: run.now }).rejection).toBe("not-in-cache");
    expect(run.do(startCacheClaim, { playerId: "b", cacheId: "cache-9", rubbingId: "moon-1", tick: run.now }).rejection).toBe("unknown-cache");
    run.do(startCacheClaim, { playerId: "b", cacheId, rubbingId: "moon-1", tick: run.now });
    expect(run.hold("b", 120)).toMatchObject({ status: "claimed", rubbingId: "moon-1" });
    expect(run.state.caches).toHaveLength(1);
    run.do(startCacheClaim, { playerId: "c", cacheId, rubbingId: "sun-1", tick: run.now });
    expect(run.hold("c", 120).status).toBe("claimed");
    expect(run.state.caches).toEqual([]);
    expect(run.where("sun-1")).toEqual(player("c"));
  });

  it("never gives one cached rubbing to two players claiming it at once, whatever the order", () => {
    for (const order of [["b", "c"], ["c", "b"]] as const) {
      const run = new Run("slice", ["a", "b", "c"]);
      run.collect("a", "moon-1");
      const cacheId = run.do(quitPlayer, { playerId: "a", tick: run.now, position: { x: 0, y: 0 } }).cacheIds[0]!;
      for (const playerId of order) run.do(startCacheClaim, { playerId, cacheId, rubbingId: "moon-1", tick: run.now });
      const outcomes: string[] = [];
      for (let tick = 1; tick <= 120; tick++) {
        run.now++;
        for (const playerId of order) outcomes.push(run.do(progressChannel, { playerId, tick: run.now }).status!);
      }
      expect(outcomes.slice(-2)).toEqual(["claimed", "failed"]);
      expect(run.where("moon-1")).toEqual(player(order[0]));
      expect(heldTypes(run.state, order[1])).toEqual([]);
    }
  });
});

describe("requests", () => {
  it("refuses stale and malformed requests without changing anything", () => {
    const run = new Run("slice", ["a", "b"]);
    run.do(advanceLedger, { tick: 50 });
    expect(run.do(addPlayer, { playerId: "c", tick: 49 }).rejection).toBe("stale-tick");
    expect(run.do(advanceLedger, { tick: 10 }).rejection).toBe("stale-tick");
    expect(run.do(addPlayer, { playerId: "c", tick: 50.5 }).rejection).toBe("invalid-request");
    expect(run.do(addPlayer, { playerId: "", tick: 50 }).rejection).toBe("invalid-request");
    expect(run.do(addPlayer, { playerId: "c", tick: 50, gold: -1 }).rejection).toBe("invalid-request");
    expect(run.do(quitPlayer, { playerId: "a", tick: 50, position: { x: 0.5, y: 0 } }).rejection).toBe("invalid-request");
    expect(run.do(unlockSource, { sourceId: run.state.sources[0]!.id, tick: 50 }).rejection).toBe("duplicate");
    expect(run.do(unlockSource, { sourceId: "nope", tick: 50 }).rejection).toBe("unknown-source");
  });

  it("never writes into its input and hashes equal states equally", () => {
    const a = new Run("alpha", ["a", "b"]);
    const b = new Run("alpha", ["a", "b"]);
    for (const run of [a, b]) {
      run.collect("a", "storm-2");
      run.duel("d1", "b", "a", "b");
      run.do(advanceLedger, { tick: run.now + 100 });
    }
    expect(hashState(a.state)).toBe(hashState(b.state));
    expect(Object.isFrozen(a.state.rubbings[0])).toBe(true);
  });
});
