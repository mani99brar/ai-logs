import { describe, expect, it } from "vitest";
import { rulesPresets } from "../rules.js";
import {
  objectiveRules,
  presetRubbings,
  presetRubbingTypes,
  pvpGoldTransfer,
  RUBBING_TYPES,
  rubbingTypeOf,
  sourceId,
  validateObjectiveRules,
  validateSourceAssignment,
  validateSourceSites,
  WORLD_TICKS_PER_SECOND,
  type SourceAssignment,
} from "./index.js";

function sliceAssignment(): SourceAssignment {
  const rubbings = presetRubbings(rulesPresets.slice);
  return {
    preset: "slice",
    seed: 7,
    sources: rubbings.map((rubbing, index) => {
      const island = Math.floor(index / 2);
      return { id: sourceId(island, index % 2), island, x: index * 256, y: 512, type: rubbing.type, rubbingId: rubbing.id };
    }),
  };
}

describe("rubbing types and ids (§4)", () => {
  it("has four types in a fixed order", () => {
    expect(RUBBING_TYPES).toEqual(["sun", "moon", "tide", "storm"]);
  });

  it("gives the slice 2 types and 8 rubbings, the alpha 4 types and 12 (3 of each)", () => {
    expect(presetRubbingTypes(rulesPresets.slice)).toEqual(["sun", "moon"]);
    expect(presetRubbings(rulesPresets.slice).map((rubbing) => rubbing.id)).toEqual([
      "sun-1", "sun-2", "sun-3", "sun-4", "moon-1", "moon-2", "moon-3", "moon-4",
    ]);
    const alpha = presetRubbings(rulesPresets.alpha);
    expect(presetRubbingTypes(rulesPresets.alpha)).toEqual(["sun", "moon", "tide", "storm"]);
    expect(alpha).toHaveLength(12);
    for (const type of RUBBING_TYPES) expect(alpha.filter((rubbing) => rubbing.type === type)).toHaveLength(3);
    expect(new Set(alpha.map((rubbing) => rubbing.id)).size).toBe(12);
  });

  it("reads a rubbing's type from its id and refuses malformed ids", () => {
    expect(rubbingTypeOf("storm-3")).toBe("storm");
    expect(rubbingTypeOf("storm-0")).toBeNull();
    expect(rubbingTypeOf("wind-1")).toBeNull();
    expect(rubbingTypeOf("sun")).toBeNull();
  });

  it("refuses a preset asking for more types than exist", () => {
    expect(() => presetRubbingTypes({ ...rulesPresets.alpha, rubbingTypes: 5 })).toThrow(RangeError);
  });
});

describe("objective rules (§4, §11, §12)", () => {
  it("states the timings in 20 Hz world ticks", () => {
    expect(WORLD_TICKS_PER_SECOND).toBe(20);
    expect(objectiveRules).toMatchObject({
      collectTicks: 120,
      cacheClaimTicks: 120,
      theftChoiceTicks: 100,
      repeatWinWindowTicks: 3600,
      seatReservationTicks: 1200,
      startingGold: 50,
      pvpGoldPercent: 20,
      pvpGoldCap: 50,
    });
    expect(validateObjectiveRules(objectiveRules).ok).toBe(true);
  });

  it("refuses malformed rules", () => {
    expect(validateObjectiveRules({ ...objectiveRules, collectTicks: 0 }).ok).toBe(false);
    expect(validateObjectiveRules({ ...objectiveRules, pvpGoldPercent: 101 }).ok).toBe(false);
    expect(validateObjectiveRules({ ...objectiveRules, startingGold: 1.5 }).ok).toBe(false);
    expect(validateObjectiveRules({ ...objectiveRules, extra: 1 }).ok).toBe(false);
  });

  it("takes 20 % of the loser's gold, rounded down, capped at 50, never more than they have", () => {
    expect(pvpGoldTransfer(objectiveRules, 50)).toBe(10);
    expect(pvpGoldTransfer(objectiveRules, 57)).toBe(11);
    expect(pvpGoldTransfer(objectiveRules, 4)).toBe(0);
    expect(pvpGoldTransfer(objectiveRules, 5)).toBe(1);
    expect(pvpGoldTransfer(objectiveRules, 250)).toBe(50);
    expect(pvpGoldTransfer(objectiveRules, 10_000)).toBe(50);
    expect(pvpGoldTransfer(objectiveRules, 0)).toBe(0);
    expect(pvpGoldTransfer(objectiveRules, -20)).toBe(0);
    expect(pvpGoldTransfer({ ...objectiveRules, pvpGoldPercent: 100, pvpGoldCap: 1000 }, 30)).toBe(30);
  });
});

describe("source sites and assignment", () => {
  it("accepts sourcesPerIsland sites on each island and nothing else", () => {
    const slice = Array.from({ length: 8 }, (_, index) => ({ island: Math.floor(index / 2), x: index, y: 0 }));
    expect(validateSourceSites(rulesPresets.slice, slice).ok).toBe(true);
    expect(validateSourceSites(rulesPresets.slice, slice.slice(1)).ok).toBe(false);
    expect(validateSourceSites(rulesPresets.slice, slice.map((site, index) => (index === 0 ? { ...site, island: 1 } : site))).ok).toBe(false);
    expect(validateSourceSites(rulesPresets.slice, slice.map((site, index) => (index === 0 ? { ...site, island: 9 } : site))).ok).toBe(false);
    expect(validateSourceSites(rulesPresets.slice, slice.map((site, index) => (index === 0 ? { ...site, x: 0.5 } : site))).ok).toBe(false);
    const alpha = Array.from({ length: 12 }, (_, island) => ({ island, x: 0, y: island }));
    expect(validateSourceSites(rulesPresets.alpha, alpha).ok).toBe(true);
    expect(validateSourceSites(rulesPresets.alpha, slice).ok).toBe(false);
  });

  it("accepts an assignment sealing each of the preset's rubbings once", () => {
    const result = validateSourceAssignment(sliceAssignment());
    expect(result).toEqual({ ok: true, value: sliceAssignment() });
  });

  it("refuses a duplicated, missing, mistyped or misplaced rubbing", () => {
    const base = sliceAssignment();
    const withSource = (index: number, change: Partial<SourceAssignment["sources"][number]>): SourceAssignment => ({
      ...base,
      sources: base.sources.map((source, at) => (at === index ? { ...source, ...change } : source)),
    });
    expect(validateSourceAssignment(withSource(1, { rubbingId: "sun-1" })).ok).toBe(false);
    expect(validateSourceAssignment(withSource(1, { type: "moon" })).ok).toBe(false);
    expect(validateSourceAssignment(withSource(1, { id: "source-0-0" })).ok).toBe(false);
    expect(validateSourceAssignment(withSource(1, { id: "source-3-1" })).ok).toBe(false);
    expect(validateSourceAssignment(withSource(1, { rubbingId: "tide-1", type: "tide" })).ok).toBe(false);
    expect(validateSourceAssignment({ ...base, sources: base.sources.slice(1) }).ok).toBe(false);
    expect(validateSourceAssignment({ ...base, preset: "alpha" }).ok).toBe(false);
    expect(validateSourceAssignment({ ...base, extra: true }).ok).toBe(false);
  });
});
