import { z } from "zod";
import { formatIssues, type ValidationResult } from "../rules.js";
import { WORLD_STEPS_PER_SECOND } from "../sailing.js";

/** §3: a wrong attempt at a ruin locks that player out of that ruin this long. */
export const RUIN_LOCKOUT_SECONDS = 3;
/** §11: a fresh ruin completion pays this much, once per player per ruin. */
export const RUIN_COMPLETION_GOLD = 40;
/** The six carved symbols of a sequence ruin, in their fixed display order. */
export const RUIN_SYMBOLS = ["sun", "moon", "tide", "storm", "anchor", "skull"] as const;
/** A sequence ruin's answer: this many distinct symbols in order. */
export const RUIN_SEQUENCE_LENGTH = 3;
/** A navigation ruin's grid is this many cells on a side. */
export const RUIN_GRID_SIZE = 4;
/** A navigation ruin's shortest path from start to goal is this many moves or more… */
export const RUIN_MIN_PATH_MOVES = 4;
/** …and this many or fewer. */
export const RUIN_MAX_PATH_MOVES = 6;
/** A navigation ruin blocks this many cells or more… */
export const RUIN_MIN_BLOCKED_CELLS = 3;
/** …and this many or fewer. */
export const RUIN_MAX_BLOCKED_CELLS = 5;

export const ruinSymbolSchema = z.enum(RUIN_SYMBOLS);
export type RuinSymbol = z.infer<typeof ruinSymbolSchema>;

/** The compass moves of a navigation answer. North is towards smaller y (y grows down, as on the sea). */
export const RUIN_MOVES = ["N", "E", "S", "W"] as const;
export const ruinMoveSchema = z.enum(RUIN_MOVES);
export type RuinMove = z.infer<typeof ruinMoveSchema>;

/** The ruin rules (§3, §11) in world ticks (20 a second), gold and cells. */
export const ruinRulesSchema = z
  .strictObject({
    /** World ticks a wrong attempt locks the player out of that ruin. */
    lockoutTicks: z.int().nonnegative(),
    /** Gold for each player's first solve of each ruin. */
    completionGold: z.int().nonnegative(),
    /** The symbols a sequence ruin shows, in display order. */
    symbols: z.array(ruinSymbolSchema).min(1),
    sequenceLength: z.int().positive(),
    gridSize: z.int().min(2),
    minPathMoves: z.int().positive(),
    maxPathMoves: z.int().positive(),
    minBlockedCells: z.int().nonnegative(),
    maxBlockedCells: z.int().nonnegative(),
  })
  .superRefine((rules, ctx) => {
    const issue = (path: string, message: string) => ctx.addIssue({ code: "custom", path: [path], message });
    if (new Set(rules.symbols).size !== rules.symbols.length) issue("symbols", "the symbols must be distinct");
    if (rules.sequenceLength >= rules.symbols.length) {
      issue("sequenceLength", `a sequence of ${rules.sequenceLength} needs more than ${rules.symbols.length} symbols, or every symbol is in it`);
    }
    if (rules.minPathMoves > rules.maxPathMoves) {
      issue("minPathMoves", `the path range ${rules.minPathMoves}–${rules.maxPathMoves} is empty`);
    }
    if (rules.minBlockedCells > rules.maxBlockedCells) {
      issue("minBlockedCells", `the blocked-cell range ${rules.minBlockedCells}–${rules.maxBlockedCells} is empty`);
    }
    const cells = rules.gridSize * rules.gridSize;
    // A shortest path visits distinct open cells, so it has at most (open cells - 1) moves.
    const longest = cells - rules.minBlockedCells - 1;
    if (rules.minPathMoves > longest) {
      issue("minPathMoves", `a ${rules.gridSize} × ${rules.gridSize} grid with ${rules.minBlockedCells} blocked cells holds no path of ${rules.minPathMoves} moves`);
    }
    if (rules.maxBlockedCells > cells - 2) {
      issue("maxBlockedCells", `a ${rules.gridSize} × ${rules.gridSize} grid needs an open start and goal`);
    }
  });

export type RuinRules = z.infer<typeof ruinRulesSchema>;

export const ruinRules: RuinRules = {
  lockoutTicks: RUIN_LOCKOUT_SECONDS * WORLD_STEPS_PER_SECOND,
  completionGold: RUIN_COMPLETION_GOLD,
  symbols: [...RUIN_SYMBOLS],
  sequenceLength: RUIN_SEQUENCE_LENGTH,
  gridSize: RUIN_GRID_SIZE,
  minPathMoves: RUIN_MIN_PATH_MOVES,
  maxPathMoves: RUIN_MAX_PATH_MOVES,
  minBlockedCells: RUIN_MIN_BLOCKED_CELLS,
  maxBlockedCells: RUIN_MAX_BLOCKED_CELLS,
};

export function validateRuinRules(candidate: unknown): ValidationResult<RuinRules> {
  const parsed = ruinRulesSchema.safeParse(candidate);
  return parsed.success ? { ok: true, value: parsed.data } : { ok: false, issues: formatIssues(parsed.error) };
}
