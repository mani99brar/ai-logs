{
  "name": "@pirate-sea-race/content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "zod": "4.6.5"
  },
  "description": "Game content and tuning as typed data (§17)",
  "exports": {
    ".": {
      "@pirate-sea-race/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./moves": {
      "@pirate-sea-race/source": "./src/moves/index.ts",
      "types": "./dist/moves/index.d.ts",
      "default": "./dist/moves/index.js"
    },
    "./claim": {
      "@pirate-sea-race/source": "./src/claim/index.ts",
      "types": "./dist/claim/index.d.ts",
      "default": "./dist/claim/index.js"
    },
    "./objectives": {
      "@pirate-sea-race/source": "./src/objectives/index.ts",
      "types": "./dist/objectives/index.d.ts",
      "default": "./dist/objectives/index.js"
    },
    "./ruins": {
      "@pirate-sea-race/source": "./src/ruins/index.ts",
      "types": "./dist/ruins/index.d.ts",
      "default": "./dist/ruins/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node --input-type=module -e \"const s='@pirate-sea-race/content/moves';const p=new URL(import.meta.resolve(s)).pathname;if(!p.endsWith('/dist/moves/index.js'))throw new Error(s+' resolves to '+p+', not to its dist/');const m=await import(s);if(Object.keys(m).length===0||!('MOVESET_VERSION' in m))throw new Error(s+' ('+p+') exports nothing or misses its main export');console.log(s+' loads from '+p)\"",
    "typecheck": "tsc -p tsconfig.json"
  }
}
