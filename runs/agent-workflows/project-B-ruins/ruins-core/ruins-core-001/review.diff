+import { describe, expect, it } from "vitest";
+import { WORLD_STEPS_PER_SECOND } from "../sailing.js";
+import {
+  RUIN_COMPLETION_GOLD,
+  RUIN_LOCKOUT_SECONDS,
+  RUIN_SYMBOLS,
+  ruinRules,
+  validateRuinRules,
+} from "./index.js";
+
+function issuesOf(candidate: unknown): string[] {
+  const result = validateRuinRules(candidate);
+  return result.ok ? [] : result.issues;
+}
+
+describe("ruin rules (§3, §11)", () => {
+  it("lock out for three seconds in world ticks, pay 40 gold, and keep six symbols and a 4 × 4 grid", () => {
+    expect(RUIN_LOCKOUT_SECONDS).toBe(3);
+    expect(ruinRules.lockoutTicks).toBe(RUIN_LOCKOUT_SECONDS * WORLD_STEPS_PER_SECOND);
+    expect(ruinRules.lockoutTicks).toBe(60);
+    expect(RUIN_COMPLETION_GOLD).toBe(40);
+    expect(ruinRules.completionGold).toBe(40);
+    expect(ruinRules.symbols).toEqual([...RUIN_SYMBOLS]);
+    expect(ruinRules.symbols).toHaveLength(6);
+    expect(ruinRules.sequenceLength).toBe(3);
+    expect(ruinRules.gridSize).toBe(4);
+    expect([ruinRules.minPathMoves, ruinRules.maxPathMoves]).toEqual([4, 6]);
+    expect([ruinRules.minBlockedCells, ruinRules.maxBlockedCells]).toEqual([3, 5]);
+    expect(validateRuinRules(ruinRules)).toEqual({ ok: true, value: ruinRules });
+  });
+
+  it("refuse a negative or fractional lockout, negative gold and unknown fields", () => {
+    expect(issuesOf({ ...ruinRules, lockoutTicks: -1 })[0]).toMatch(/^lockoutTicks:/);
+    expect(issuesOf({ ...ruinRules, lockoutTicks: 1.5 })[0]).toMatch(/^lockoutTicks:/);
+    expect(issuesOf({ ...ruinRules, completionGold: -40 })[0]).toMatch(/^completionGold:/);
+    expect(issuesOf({ ...ruinRules, extra: 1 })).toHaveLength(1);
+  });
+
+  it("refuse a path-length range the grid cannot hold, or an empty one", () => {
+    // 4 × 4 with 3 blocked cells leaves 13 open cells: no shortest path is longer than 12 moves.
+    expect(issuesOf({ ...ruinRules, minPathMoves: 13, maxPathMoves: 14 })).toEqual([
+      "minPathMoves: a 4 × 4 grid with 3 blocked cells holds no path of 13 moves",
+    ]);
+    expect(issuesOf({ ...ruinRules, minPathMoves: 12, maxPathMoves: 12 })).toEqual([]);
+    expect(issuesOf({ ...ruinRules, gridSize: 2 })).toEqual([
+      "minPathMoves: a 2 × 2 grid with 3 blocked cells holds no path of 4 moves",
+      "maxBlockedCells: a 2 × 2 grid needs an open start and goal",
+    ]);
+    expect(issuesOf({ ...ruinRules, minPathMoves: 7 })).toEqual(["minPathMoves: the path range 7–6 is empty"]);
+    expect(issuesOf({ ...ruinRules, minBlockedCells: 6 })).toEqual(["minBlockedCells: the blocked-cell range 6–5 is empty"]);
+  });
+
+  it("refuse repeated symbols, unknown symbols and a sequence that uses every symbol", () => {
+    expect(issuesOf({ ...ruinRules, symbols: ["sun", "sun", "moon", "tide"] })).toEqual(["symbols: the symbols must be distinct"]);
+    expect(issuesOf({ ...ruinRules, symbols: ["sun", "moon", "kraken", "tide"] })[0]).toMatch(/^symbols\.2:/);
+    expect(issuesOf({ ...ruinRules, symbols: ["sun", "moon", "tide"] })).toEqual([
+      "sequenceLength: a sequence of 3 needs more than 3 symbols, or every symbol is in it",
+    ]);
+  });
+});
