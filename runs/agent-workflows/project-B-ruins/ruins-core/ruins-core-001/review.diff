+
+describe("ruin clues do not leak the answer (§16)", () => {
+  const SEQUENCE_KEYS = ["hint", "kind", "length", "other", "position", "relation", "symbol", "tablets"];
+  const NAVIGATION_KEYS = ["blocked", "goal", "kind", "size", "start", "x", "y"];
+
+  function keysIn(value: unknown, into = new Set<string>()): Set<string> {
+    if (Array.isArray(value)) for (const item of value) keysIn(item, into);
+    else if (typeof value === "object" && value !== null) {
+      for (const [key, item] of Object.entries(value)) {
+        into.add(key);
+        keysIn(item, into);
