@@ -0,0 +1,227 @@
+import { ruinRules } from "@pirate-sea-race/content/ruins";
+import { describe, expect, it } from "vitest";
+import {
+  answerRuin,
+  createRuins,
+  openRuin,
+  reportPresence,
+  type Ruin,
+  type RuinAttempt,
+  type RuinsState,
+} from "./index.js";
+
+/** Scripted solving (§3, §11, §16). The server-side tests take the right answer from the secret puzzle. */
+
+const ISLANDS = [0, 1, 2, 3].map((island) => ({ island, sourceIds: [`source-${island}-0`, `source-${island}-1`] }));
+const LOCKOUT = ruinRules.lockoutTicks;
+
+/** Deep-freezes a state, so an operation that wrote into its input would throw. */
+function frozen<T>(value: T): T {
+  if (typeof value === "object" && value !== null && !Object.isFrozen(value)) {
+    Object.freeze(value);
+    for (const item of Object.values(value)) frozen(item);
+  }
+  return value;
+}
+
+/** The first seed whose island 0 has a ruin of this kind. */
+function stateWith(kind: Ruin["puzzle"]["kind"]): RuinsState {
+  for (let seed = 1; ; seed++) {
+    const state = createRuins({ seed, islands: ISLANDS });
+    if (state.ruins["0"]!.puzzle.kind === kind) return frozen(state);
+  }
+}
+
+function rightAnswer(ruin: Ruin): RuinAttempt {
+  if (ruin.puzzle.kind === "sequence") return { kind: "sequence", symbols: [...ruin.puzzle.answer] };
+  // A shortest route, found here by trying move strings of the minimum length.
+  const moves = ["N", "E", "S", "W"] as const;
+  const length = ruin.puzzle.minMoves;
+  for (let code = 0; code < 4 ** length; code++) {
+    const attempt: RuinAttempt = { kind: "navigation", moves: Array.from({ length }, (_, place) => moves[Math.floor(code / 4 ** place) % 4]!) };
+    const trial = createProbe(ruin, attempt);
+    if (trial) return attempt;
+  }
+  throw new Error("no route");
+}
+
+function createProbe(ruin: Ruin, attempt: RuinAttempt): boolean {
+  const state: RuinsState = { rules: ruinRules, tick: 0, ruins: { [String(ruin.island)]: { ...ruin, solvedBy: [], lockouts: [], sessions: [] } }, presence: [] };
+  const at = reportPresence(state, { playerId: "probe", island: ruin.island, inDuel: false, tick: 0 }).state;
+  const open = openRuin(at, { playerId: "probe", island: ruin.island, tick: 0 }).state;
+  return answerRuin(open, { playerId: "probe", island: ruin.island, tick: 0, attempt }).result.outcome === "solved";
+}
+
+function wrongAnswer(ruin: Ruin): RuinAttempt {
+  if (ruin.puzzle.kind === "sequence") {
+    const [a, b, c] = ruin.puzzle.answer;
+    return { kind: "sequence", symbols: [b!, a!, c!] };
+  }
+  // One move: every minimum route is at least four moves long.
+  return { kind: "navigation", moves: ["N"] };
+}
+
+/** Moors a player at an island and opens its ruin at `tick`. */
+function arrive(state: RuinsState, playerId: string, island: number, tick: number): RuinsState {
+  const present = reportPresence(state, { playerId, island, inDuel: false, tick });
+  expect(present.result.ok).toBe(true);
+  const opened = openRuin(present.state, { playerId, island, tick });
+  expect(opened.result.ok).toBe(true);
+  return frozen(opened.state);
+}
+
+for (const kind of ["sequence", "navigation"] as const) {
+  describe(`a ${kind} ruin`, () => {
+    const initial = stateWith(kind);
+    const ruin = initial.ruins["0"]!;
+    const right = rightAnswer(ruin);
+    const wrong = wrongAnswer(ruin);
+
+    it("is solved by the right answer: the first solve unlocks the island's sources once and pays 40 gold", () => {
+      const state = arrive(initial, "p1", 0, 5);
+      const solved = answerRuin(state, { playerId: "p1", island: 0, tick: 6, attempt: right });
+      expect(solved.result).toEqual({
+        ok: true,
+        rejection: null,
+        outcome: "solved",
+        lockedUntil: 0,
+        events: [
+          { kind: "sources-unlocked", island: 0, sourceIds: ["source-0-0", "source-0-1"], playerId: "p1", tick: 6 },
+          { kind: "gold-awarded", island: 0, playerId: "p1", amount: 40, tick: 6 },
+        ],
+      });
+      expect(solved.state.ruins["0"]).toMatchObject({ unlocked: true, solvedBy: [{ playerId: "p1", tick: 6 }] });
+      // Other ruins are untouched.
+      for (const island of ["1", "2", "3"]) expect(solved.state.ruins[island]).toBe(initial.ruins[island]);
+
+      // A second player solving later gets the gold but unlocks nothing again.
+      const second = answerRuin(arrive(solved.state, "p2", 0, 30), { playerId: "p2", island: 0, tick: 31, attempt: right });
+      expect(second.result.events).toEqual([{ kind: "gold-awarded", island: 0, playerId: "p2", amount: 40, tick: 31 }]);
+      expect(second.state.ruins["0"]!.solvedBy).toEqual([
+        { playerId: "p1", tick: 6 },
+        { playerId: "p2", tick: 31 },
+      ]);
+
+      // Solving again gives nothing, and changes nothing.
+      const again = answerRuin(frozen(second.state), { playerId: "p1", island: 0, tick: 40, attempt: right });
+      expect([again.result.rejection, again.result.events]).toEqual(["already-solved", []]);
+      expect(again.state).toBe(second.state);
+      // Nor does leaving and coming back.
+      const back = arrive(reportPresence(second.state, { playerId: "p1", island: null, inDuel: false, tick: 41 }).state, "p1", 0, 42);
+      const reopened = answerRuin(back, { playerId: "p1", island: 0, tick: 43, attempt: right });
+      expect(reopened.result.rejection).toBe("already-solved");
+      expect(reopened.state).toBe(back);
+    });
+
+    it("locks out a wrong answer for three seconds, for that player only", () => {
+      let state = arrive(arrive(initial, "p1", 0, 5), "p2", 0, 5);
+      const failed = answerRuin(state, { playerId: "p1", island: 0, tick: 10, attempt: wrong });
+      expect(failed.result).toEqual({ ok: true, rejection: null, outcome: "wrong", lockedUntil: 10 + LOCKOUT, events: [] });
+      state = frozen(failed.state);
+      expect(state.ruins["0"]!.lockouts).toEqual([{ playerId: "p1", until: 70 }]);
+
+      // Every attempt during the lockout is refused, right or wrong, without extending it.
+      for (const tick of [10, 11, 69]) {
+        for (const attempt of [right, wrong]) {
+          const refused = answerRuin(state, { playerId: "p1", island: 0, tick, attempt });
+          expect([refused.result.rejection, refused.result.lockedUntil]).toEqual(["locked-out", 70]);
+          expect(refused.state).toBe(state);
+        }
+      }
+      // The other player is not affected.
+      const other = answerRuin(state, { playerId: "p2", island: 0, tick: 11, attempt: right });
+      expect(other.result.outcome).toBe("solved");
+      // The lockout ends exactly three seconds on.
+      const later = answerRuin(other.state, { playerId: "p1", island: 0, tick: 70, attempt: right });
+      expect(later.result.outcome).toBe("solved");
+      expect(later.result.events).toEqual([{ kind: "gold-awarded", island: 0, playerId: "p1", amount: 40, tick: 70 }]);
+    });
+
+    it("refuses attempts without a session, away from the ruin, after leaving, and in a duel", () => {
+      // Moored but never opened.
+      const moored = frozen(reportPresence(initial, { playerId: "p1", island: 0, inDuel: false, tick: 5 }).state);
+      const unopened = answerRuin(moored, { playerId: "p1", island: 0, tick: 6, attempt: right });
+      expect(unopened.result.rejection).toBe("no-session");
+      expect(unopened.state).toBe(moored);
+      // Opening from elsewhere, or at an island without a ruin.
+      expect(openRuin(moored, { playerId: "p1", island: 1, tick: 6 }).result.rejection).toBe("not-at-ruin");
+      expect(openRuin(initial, { playerId: "p1", island: 0, tick: 6 }).result.rejection).toBe("not-at-ruin");
+      expect(openRuin(moored, { playerId: "p1", island: 9, tick: 6 }).result.rejection).toBe("unknown-ruin");
+
+      // After leaving: the session is closed.
+      const opened = arrive(initial, "p1", 0, 5);
+      const left = reportPresence(opened, { playerId: "p1", island: null, inDuel: false, tick: 6 });
+      expect(left.result).toEqual({ ok: true, rejection: null, closed: [0] });
+      expect(left.state.ruins["0"]!.sessions).toEqual([]);
+      const afterLeaving = answerRuin(frozen(left.state), { playerId: "p1", island: 0, tick: 7, attempt: right });
+      expect(afterLeaving.result.rejection).toBe("not-at-ruin");
+      // Coming back without reopening still has no session.
+      const returned = frozen(reportPresence(left.state, { playerId: "p1", island: 0, inDuel: false, tick: 8 }).state);
+      expect(answerRuin(returned, { playerId: "p1", island: 0, tick: 9, attempt: right }).result.rejection).toBe("no-session");
+      // Moving to another island's dock closes the session too.
+      const moved = reportPresence(opened, { playerId: "p1", island: 1, inDuel: false, tick: 6 });
+      expect(moved.result.closed).toEqual([0]);
+
+      // Entering a duel ends the session, even while moored at the ruin.
+      const duel = reportPresence(opened, { playerId: "p1", island: 0, inDuel: true, tick: 6 });
+      expect(duel.result.closed).toEqual([0]);
+      const inDuel = frozen(duel.state);
+      const duelAttempt = answerRuin(inDuel, { playerId: "p1", island: 0, tick: 7, attempt: right });
+      expect(duelAttempt.result.rejection).toBe("in-duel");
+      expect(duelAttempt.state).toBe(inDuel);
+      expect(openRuin(inDuel, { playerId: "p1", island: 0, tick: 7 }).result.rejection).toBe("in-duel");
+      // After the duel the player must open the ruin again.
+      const after = frozen(reportPresence(inDuel, { playerId: "p1", island: 0, inDuel: false, tick: 8 }).state);
+      expect(answerRuin(after, { playerId: "p1", island: 0, tick: 9, attempt: right }).result.rejection).toBe("no-session");
+      expect(openRuin(after, { playerId: "p1", island: 0, tick: 9 }).result.ok).toBe(true);
+    });
+
+    it("returns the very same state for repeated, stale and malformed requests", () => {
+      const state = arrive(initial, "p1", 0, 20);
+      // A repeated open keeps the original session and hands the clue again.
+      const repeated = openRuin(state, { playerId: "p1", island: 0, tick: 21 });
+      expect(repeated.result.rejection).toBe("duplicate");
+      expect(repeated.result.clue).not.toBeNull();
+      expect(repeated.state).toBe(state);
+      // A repeated presence report.
+      const same = reportPresence(state, { playerId: "p1", island: 0, inDuel: false, tick: 21 });
+      expect(same.result.rejection).toBe("duplicate");
+      expect(same.state).toBe(state);
+      // Stale ticks.
+      for (const step of [
+        answerRuin(state, { playerId: "p1", island: 0, tick: 19, attempt: right }),
+        openRuin(state, { playerId: "p2", island: 0, tick: 19 }),
+        reportPresence(state, { playerId: "p2", island: 0, inDuel: false, tick: 19 }),
+      ]) {
+        expect(step.result.rejection).toBe("stale-tick");
+        expect(step.state).toBe(state);
+      }
+      // Malformed attempts are refused for their shape, not treated as wrong answers: no lockout.
+      const malformed: unknown[] = [
+        null,
+        { kind: kind === "sequence" ? "navigation" : "sequence", moves: ["N"], symbols: ["sun", "moon", "tide"] },
+        kind === "sequence" ? { kind, symbols: ["sun", "sun", "moon"] } : { kind, moves: [] },
+        kind === "sequence" ? { kind, symbols: ["sun", "moon"] } : { kind, moves: ["N", "Q"] },
+        kind === "sequence" ? { kind, symbols: ["sun", "moon", "kraken"] } : { kind, moves: Array.from({ length: 17 }, () => "N") },
+      ];
+      for (const attempt of malformed) {
+        const refused = answerRuin(state, { playerId: "p1", island: 0, tick: 21, attempt: attempt as RuinAttempt });
+        expect(refused.result.rejection).toBe("invalid-request");
+        expect(refused.state).toBe(state);
+      }
+      for (const bad of [
+        { playerId: "", island: 0, tick: 21 },
+        { playerId: "p1", island: -1, tick: 21 },
+        { playerId: "p1", island: 0, tick: 1.5 },
+      ]) {
+        expect(answerRuin(state, { ...bad, attempt: right }).state).toBe(state);
+        expect(openRuin(state, bad).state).toBe(state);
+      }
+      // The same wrong answer twice on one tick: the second is refused by the lockout the first set.
+      const once = answerRuin(state, { playerId: "p1", island: 0, tick: 22, attempt: wrong });
+      const twice = answerRuin(frozen(once.state), { playerId: "p1", island: 0, tick: 22, attempt: wrong });
+      expect([twice.result.rejection, twice.result.lockedUntil]).toEqual(["locked-out", 22 + LOCKOUT]);
+      expect(twice.state).toBe(once.state);
+    });
+  });
+}
diff --git a/packages/simulation/src/ruins/operations.ts b/packages/simulation/src/ruins/operations.ts
new file mode 100644
index 0000000..36c40db
--- /dev/null
+++ b/packages/simulation/src/ruins/operations.ts
@@ -0,0 +1,250 @@
+import { RUIN_MOVES, type RuinSymbol } from "@pirate-sea-race/content/ruins";
+import { attemptSolves, type RuinAttempt, type RuinClue } from "./puzzles.js";
+import {
+  clueFor,
+  findRuin,
+  hasSolved,
+  lockedUntil,
+  presenceOf,
+  sessionOf,
+  type Ruin,
+  type RuinPresence,
+  type RuinsState,
+} from "./state.js";
+
+/**
+ * Why a request changed nothing (§16: duplicate, stale or refused requests return the current result without
+ * mutating state). A rejected request always returns the very state object it was given. No rejection depends on the
+ * answer: a malformed attempt is refused for its shape alone, and a well-formed wrong one is a wrong answer.
+ */
+export type RuinRejection =
+  | "invalid-request"
+  | "stale-tick"
+  | "duplicate"
+  | "unknown-ruin"
+  | "not-at-ruin"
+  | "in-duel"
+  | "no-session"
+  | "already-solved"
+  | "locked-out";
+
+/**
+ * What the caller applies to the ledger later:
+ * - `sources-unlocked`: the first solve of a ruin, once per ruin; `unlockSource` for each id.
+ * - `gold-awarded`: a player's first solve of a ruin, once per player and ruin; new gold (§11).
+ */
+export type RuinEvent =
+  | { readonly kind: "sources-unlocked"; readonly island: number; readonly sourceIds: readonly string[]; readonly playerId: string; readonly tick: number }
+  | { readonly kind: "gold-awarded"; readonly island: number; readonly playerId: string; readonly amount: number; readonly tick: number };
+
+/** What every operation returns: the next state (the same object when nothing changed) and its result. */
+export interface RuinStep<R> {
+  readonly state: RuinsState;
+  readonly result: R;
+}
+
+function isTick(value: unknown): value is number {
+  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
+}
+
+function isPlayerId(value: unknown): value is string {
+  return typeof value === "string" && value.length > 0;
+}
+
+function isIsland(value: unknown): value is number {
+  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
+}
+
+function tickRejection(state: RuinsState, tick: unknown): RuinRejection | null {
+  if (!isTick(tick)) return "invalid-request";
+  return tick < state.tick ? "stale-tick" : null;
+}
+
+function byPlayer<T extends { readonly playerId: string }>(a: T, b: T): number {
+  return a.playerId < b.playerId ? -1 : a.playerId > b.playerId ? 1 : 0;
+}
+
+/** Puts (or with null, removes) a player's entry in a list sorted by player id. */
+function upsert<T extends { readonly playerId: string }>(list: readonly T[], playerId: string, entry: T | null): T[] {
+  const rest = list.filter((item) => item.playerId !== playerId);
+  return entry === null ? rest : [...rest, entry].sort(byPlayer);
+}
+
+function withRuin(state: RuinsState, ruin: Ruin): RuinsState {
+  return { ...state, ruins: { ...state.ruins, [String(ruin.island)]: ruin } };
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// Presence
+
+export interface ReportPresenceRequest {
+  readonly playerId: string;
+  /** The island whose dock the player is moored at, or null when at sea (or anywhere without a ruin). */
+  readonly island: number | null;
+  readonly inDuel: boolean;
+  readonly tick: number;
+}
+
+export interface PresenceResult {
+  readonly ok: boolean;
+  readonly rejection: RuinRejection | null;
+  /** The islands whose ruin session this report closed. */
+  readonly closed: readonly number[];
+}
+
+/**
+ * The caller reports where a player is whenever it changes (it may report every tick; an unchanged report is a
+ * duplicate). Being elsewhere than a ruin's island, or in a duel, closes the player's session there. Lockouts stay.
+ */
+export function reportPresence(state: RuinsState, request: ReportPresenceRequest): RuinStep<PresenceResult> {
+  const { playerId, island, inDuel, tick } = request;
+  const reject = (rejection: RuinRejection): RuinStep<PresenceResult> => ({ state, result: { ok: false, rejection, closed: [] } });
+  const bad = tickRejection(state, tick);
+  if (bad) return reject(bad);
+  if (!isPlayerId(playerId) || (island !== null && !isIsland(island)) || typeof inDuel !== "boolean") return reject("invalid-request");
+  const current = presenceOf(state, playerId);
+  if (current.island === island && current.inDuel === inDuel) return reject("duplicate");
+  const closed: number[] = [];
+  const ruins: Record<string, Ruin> = { ...state.ruins };
+  for (const [key, ruin] of Object.entries(state.ruins)) {
+    if (!sessionOf(ruin, playerId) || (!inDuel && ruin.island === island)) continue;
+    ruins[key] = { ...ruin, sessions: upsert(ruin.sessions, playerId, null) };
+    closed.push(ruin.island);
+  }
+  const entry: RuinPresence | null = island === null && !inDuel ? null : { playerId, island, inDuel };
+  const next: RuinsState = { ...state, tick, ruins, presence: upsert(state.presence, playerId, entry) };
+  return { state: next, result: { ok: true, rejection: null, closed: closed.sort((a, b) => a - b) } };
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// Opening a ruin
+
+export interface OpenRuinRequest {
+  readonly playerId: string;
+  readonly island: number;
+  readonly tick: number;
+}
+
+export interface OpenResult {
+  readonly ok: boolean;
+  readonly rejection: RuinRejection | null;
+  /** The clue, for a player with a session at this ruin (a repeated open gets it again); otherwise null. */
+  readonly clue: RuinClue | null;
+  /** The tick before which this player's attempts here are refused; 0 when never locked out. */
+  readonly lockedUntil: number;
+  /** Whether this player has already solved this ruin. */
+  readonly solved: boolean;
+}
+
+/** Starts a player's session at the ruin of the island they are moored at and hands them its clue. */
+export function openRuin(state: RuinsState, request: OpenRuinRequest): RuinStep<OpenResult> {
+  const { playerId, island, tick } = request;
+  const ruin = isIsland(island) ? findRuin(state, island) : undefined;
+  const reject = (rejection: RuinRejection): RuinStep<OpenResult> => {
+    const session = ruin && isPlayerId(playerId) ? sessionOf(ruin, playerId) : undefined;
+    return {
+      state,
+      result: {
+        ok: false,
+        rejection,
+        clue: session ? clueFor(ruin!) : null,
+        lockedUntil: ruin && isPlayerId(playerId) ? lockedUntil(ruin, playerId) : 0,
+        solved: ruin !== undefined && isPlayerId(playerId) && hasSolved(ruin, playerId),
+      },
+    };
+  };
+  const bad = tickRejection(state, tick);
+  if (bad) return reject(bad);
+  if (!isPlayerId(playerId) || !isIsland(island)) return reject("invalid-request");
+  if (!ruin) return reject("unknown-ruin");
+  const presence = presenceOf(state, playerId);
+  if (presence.inDuel) return reject("in-duel");
+  if (presence.island !== island) return reject("not-at-ruin");
+  if (sessionOf(ruin, playerId)) return reject("duplicate");
+  const opened: Ruin = { ...ruin, sessions: upsert(ruin.sessions, playerId, { playerId, openedTick: tick }) };
+  return {
+    state: withRuin({ ...state, tick }, opened),
+    result: { ok: true, rejection: null, clue: clueFor(opened), lockedUntil: lockedUntil(ruin, playerId), solved: hasSolved(ruin, playerId) },
+  };
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// Answering
+
+export interface AnswerRuinRequest {
+  readonly playerId: string;
+  readonly island: number;
+  readonly tick: number;
+  readonly attempt: RuinAttempt;
+}
+
+export type AnswerOutcome = "solved" | "wrong";
+
+export interface AnswerResult {
+  readonly ok: boolean;
+  readonly rejection: RuinRejection | null;
+  readonly outcome: AnswerOutcome | null;
+  /** The tick before which this player's attempts here are refused; 0 when never locked out. */
+  readonly lockedUntil: number;
+  /** For the caller to apply to the ledger, in order. */
+  readonly events: readonly RuinEvent[];
+}
+
+/**
+ * Whether an attempt has a well-formed shape for the ruin's kind, which the clue already tells: a sequence of the
+ * right length of distinct known symbols, or one to `size²` compass moves. The check never looks at the answer.
+ */
+function attemptShapeOk(state: RuinsState, ruin: Ruin, attempt: unknown): attempt is RuinAttempt {
+  if (typeof attempt !== "object" || attempt === null) return false;
+  const candidate = attempt as Record<string, unknown>;
+  if (candidate.kind !== ruin.puzzle.kind) return false;
+  if (ruin.puzzle.kind === "sequence") {
+    const symbols = candidate.symbols;
+    if (!Array.isArray(symbols) || symbols.length !== ruin.puzzle.answer.length) return false;
+    const known: readonly string[] = state.rules.symbols;
+    return symbols.every((symbol) => typeof symbol === "string" && known.includes(symbol)) && new Set(symbols as RuinSymbol[]).size === symbols.length;
+  }
+  const moves = candidate.moves;
+  const longest = ruin.puzzle.size * ruin.puzzle.size;
+  const compass: readonly string[] = RUIN_MOVES;
+  return Array.isArray(moves) && moves.length > 0 && moves.length <= longest && moves.every((move) => typeof move === "string" && compass.includes(move));
+}
+
+/**
+ * Checks a player's attempt at the ruin they have open. A right answer solves the ruin for that player: the first
+ * solve unlocks the island's sources for everyone, and every player's first solve pays the completion gold. A wrong
+ * answer locks that player out of that ruin for `lockoutTicks`.
+ */
+export function answerRuin(state: RuinsState, request: AnswerRuinRequest): RuinStep<AnswerResult> {
+  const { playerId, island, tick, attempt } = request;
+  const ruin = isIsland(island) ? findRuin(state, island) : undefined;
+  const reject = (rejection: RuinRejection): RuinStep<AnswerResult> => ({
+    state,
+    result: { ok: false, rejection, outcome: null, lockedUntil: ruin && isPlayerId(playerId) ? lockedUntil(ruin, playerId) : 0, events: [] },
+  });
+  const bad = tickRejection(state, tick);
+  if (bad) return reject(bad);
+  if (!isPlayerId(playerId) || !isIsland(island)) return reject("invalid-request");
+  if (!ruin) return reject("unknown-ruin");
+  const presence = presenceOf(state, playerId);
+  if (presence.inDuel) return reject("in-duel");
+  if (presence.island !== island) return reject("not-at-ruin");
+  if (!sessionOf(ruin, playerId)) return reject("no-session");
+  if (hasSolved(ruin, playerId)) return reject("already-solved");
+  if (tick < lockedUntil(ruin, playerId)) return reject("locked-out");
+  if (!attemptShapeOk(state, ruin, attempt)) return reject("invalid-request");
+
+  if (!attemptSolves(ruin.puzzle, attempt)) {
+    const until = tick + state.rules.lockoutTicks;
+    const locked: Ruin = { ...ruin, lockouts: upsert(ruin.lockouts, playerId, { playerId, until }) };
+    return { state: withRuin({ ...state, tick }, locked), result: { ok: true, rejection: null, outcome: "wrong", lockedUntil: until, events: [] } };
+  }
+  const events: RuinEvent[] = [];
+  if (!ruin.unlocked) events.push({ kind: "sources-unlocked", island: ruin.island, sourceIds: [...ruin.sourceIds], playerId, tick });
+  events.push({ kind: "gold-awarded", island: ruin.island, playerId, amount: state.rules.completionGold, tick });
+  const solved: Ruin = { ...ruin, unlocked: true, solvedBy: [...ruin.solvedBy, { playerId, tick }] };
+  return {
+    state: withRuin({ ...state, tick }, solved),
+    result: { ok: true, rejection: null, outcome: "solved", lockedUntil: lockedUntil(ruin, playerId), events },
+  };
+}
