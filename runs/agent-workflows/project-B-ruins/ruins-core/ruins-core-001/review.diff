+      }),
+    );
+    expect([...layouts]).toEqual([JSON.stringify([3, [...RUIN_SYMBOLS]])]);
+  });
+
+  it("lay the tablets out in the answer's order no more often than chance allows", () => {
+    const n = SEQUENCE_RUINS.length;
+    // A binomial count: at most its mean plus four standard deviations (integer arithmetic on squares).
+    const withinChance = (count: number, p: number, q: number) => {
+      const excess = count * q - n * p;
+      return excess <= 0 || excess * excess <= 16 * n * p * (q - p);
+    };
+    let inDisplayOrder = 0;
+    const firstTablet = new Map<number, number>();
+    for (const { ruin } of SEQUENCE_RUINS) {
+      if (ruin.puzzle.kind !== "sequence") continue;
+      const places = ruin.puzzle.answer.map((symbol) => RUIN_SYMBOLS.indexOf(symbol));
+      if (places[0]! < places[1]! && places[1]! < places[2]!) inDisplayOrder += 1;
+      firstTablet.set(places[0]!, (firstTablet.get(places[0]!) ?? 0) + 1);
+    }
+    // Chance: 1 in 6 for the three answer tablets appearing in answer order, 1 in 6 for any tablet leading the answer.
+    expect(withinChance(inDisplayOrder, 1, 6)).toBe(true);
+    for (let place = 0; place < RUIN_SYMBOLS.length; place++) expect(withinChance(firstTablet.get(place) ?? 0, 1, 6)).toBe(true);
+  });
+});
