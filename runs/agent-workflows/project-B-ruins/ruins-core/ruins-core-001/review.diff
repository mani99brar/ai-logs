+describe("ruin timing (§3: a fresh ruin in 20–40 s, rubbing included)", () => {
+  it(`lets a reading player solve each kind within two ticks of opening, over ${SEEDS} seeds`, () => {
+    const solvedKinds = new Set<string>();
+    for (const { ruin } of [...SEQUENCE_RUINS, ...NAVIGATION_RUINS]) {
