+  }, 60_000);
+
+  /** Every move string of 1, 2, 3, … moves, in N E S W order: a guesser that ignores the grid. */
+  function* shortestFirst(): Generator<RuinMove[]> {
+    for (let length = 1; ; length++) {
+      const counter = Array.from({ length }, () => 0);
+      for (;;) {
+        yield counter.map((digit) => RUIN_MOVES[digit]!);
+        let place = length - 1;
+        while (place >= 0 && counter[place] === RUIN_MOVES.length - 1) counter[place--] = 0;
+        if (place < 0) break;
+        counter[place]! += 1;
+      }
+    }
+  }
+
+  function* navigationGuesses(): Generator<RuinAttempt> {
+    for (const moves of shortestFirst()) yield { kind: "navigation", moves };
+  }
+
+  it(`makes a guesser enumerating move strings shortest-first average 100 s or more, and 20 s or more at the 10th percentile, over ${SEEDS} seeds`, () => {
+    const seconds = NAVIGATION_RUINS.map(({ ruin }, index) => {
+      const clue = clueFor(ruin);
+      if (clue.kind !== "navigation" || ruin.puzzle.kind !== "navigation") throw new Error("kind");
+      // Wrong guesses before the first minimum-length route, counted with the independent evaluator…
+      const grid = openGrid(clue);
+      let wrong = 0;
+      for (const moves of shortestFirst()) {
+        if (moves.length === ruin.puzzle.minMoves && routeReachesGoal(clue, moves, grid)) break;
+        wrong += 1;
+      }
+      // …and, for the first ruins, played through the real operations, where each costs one lockout.
+      if (index < 40) {
+        const played = playUntilSolved(ruin, navigationGuesses());
+        expect(played.wrong).toBe(wrong);
+        expect(played.ticks).toBe(wrong * ruinRules.lockoutTicks);
+      }
+      return (wrong * ruinRules.lockoutTicks) / WORLD_STEPS_PER_SECOND;
+    });
+    expect(mean(seconds)).toBeGreaterThanOrEqual(100);
+    expect(percentile(seconds, 0.1)).toBeGreaterThanOrEqual(20);
+  }, 60_000);
+
+  it("keeps a lockout when the player leaves and reopens the ruin", () => {
+    const { ruin } = SEQUENCE_RUINS[0]!;
+    let { state, clue } = openedAlone(ruin, "p1", 10);
+    const right = readersAttempt(clue);
+    const wrong: RuinAttempt = { kind: "sequence", symbols: right.kind === "sequence" ? [right.symbols[1]!, right.symbols[0]!, right.symbols[2]!] : [] };
+    const failed = answerRuin(state, { playerId: "p1", island: ruin.island, tick: 11, attempt: wrong });
+    expect([failed.result.outcome, failed.result.lockedUntil]).toEqual(["wrong", 11 + LOCKOUT_TICKS]);
+    state = reportPresence(failed.state, { playerId: "p1", island: null, inDuel: false, tick: 12 }).state;
+    state = reportPresence(state, { playerId: "p1", island: ruin.island, inDuel: false, tick: 13 }).state;
+    const reopened = openRuin(state, { playerId: "p1", island: ruin.island, tick: 14 });
+    expect([reopened.result.ok, reopened.result.lockedUntil]).toEqual([true, 11 + LOCKOUT_TICKS]);
+    const early = answerRuin(reopened.state, { playerId: "p1", island: ruin.island, tick: 10 + LOCKOUT_TICKS, attempt: right });
+    expect(early.result.rejection).toBe("locked-out");
+    expect(early.state).toBe(reopened.state);
+    const onTime = answerRuin(reopened.state, { playerId: "p1", island: ruin.island, tick: 11 + LOCKOUT_TICKS, attempt: right });
+    expect(onTime.result.outcome).toBe("solved");
+  });
+});
