@@ -0,0 +1,148 @@
+import { ruinRules, validateRuinRules, type RuinRules } from "@pirate-sea-race/content/ruins";
+import { drawInt, generateNavigation, generateSequence, puzzleClue, type Draw, type RuinClue, type RuinPuzzle } from "./puzzles.js";
+
+/** A player reading a ruin's clue, since `openedTick`. */
+export interface RuinSession {
+  readonly playerId: string;
+  readonly openedTick: number;
+}
+
+/** A player's lockout at one ruin: no attempt before `until`. It outlives sessions, so leaving does not clear it. */
+export interface RuinLockout {
+  readonly playerId: string;
+  readonly until: number;
+}
+
+export interface RuinSolve {
+  readonly playerId: string;
+  readonly tick: number;
+}
+
+/** One regular island's ruin, guarding all of that island's sources. */
+export interface Ruin {
+  readonly island: number;
+  /** The ledger's ids of the island's sources (`source-<island>-<slot>`), as the caller supplied them. */
+  readonly sourceIds: readonly string[];
+  /** Secret: holds the answer. Only `clueFor` may leave the server. */
+  readonly puzzle: RuinPuzzle;
+  /** Set by the first solve, for everyone. */
+  readonly unlocked: boolean;
+  /** In solve order; each player at most once. */
+  readonly solvedBy: readonly RuinSolve[];
+  /** Sorted by player id. */
+  readonly lockouts: readonly RuinLockout[];
+  /** Sorted by player id. */
+  readonly sessions: readonly RuinSession[];
+}
+
+/** Where the caller last reported a player: moored at an island's dock (`island`), and whether in a duel. */
+export interface RuinPresence {
+  readonly playerId: string;
+  readonly island: number | null;
+  readonly inDuel: boolean;
+}
+
+/** All the ruins of a match: plain integer data that `hashState` covers entirely. */
+export interface RuinsState {
+  readonly rules: RuinRules;
+  /** The latest world tick an applied request carried. Requests from earlier ticks are stale. */
+  readonly tick: number;
+  /** By island number. */
+  readonly ruins: Readonly<Record<string, Ruin>>;
+  /** Players away from every ruin and out of any duel have no entry. Sorted by player id. */
+  readonly presence: readonly RuinPresence[];
+}
+
+export interface RuinIsland {
+  readonly island: number;
+  readonly sourceIds: readonly string[];
+}
+
+export interface CreateRuinsOptions {
+  /** The match's private seed. */
+  readonly seed: number;
+  /** Every regular island (not the final one) with its ledger source ids. */
+  readonly islands: readonly RuinIsland[];
+  readonly rules?: RuinRules;
+}
+
+/** Mixed into the match seed so the ruins draw from their own stream, apart from the ledger's source deal. */
+const RUINS_STREAM = 0x5255494e;
+
+function islandIssues(islands: readonly RuinIsland[]): string[] {
+  const issues: string[] = [];
+  const seen = new Set<number>();
+  islands.forEach((entry, index) => {
+    const island = entry?.island;
+    if (!Number.isSafeInteger(island) || island < 0) {
+      issues.push(`islands.${index}: an island is a non-negative integer`);
+      return;
+    }
+    if (seen.has(island)) issues.push(`islands.${index}: island ${island} appears twice`);
+    seen.add(island);
+    const ids = entry.sourceIds;
+    if (!Array.isArray(ids) || ids.length === 0) {
+      issues.push(`islands.${index}: island ${island} needs its source ids`);
+      return;
+    }
+    const pattern = new RegExp(`^source-${island}-[0-9]+$`);
+    ids.forEach((id, slot) => {
+      if (typeof id !== "string" || !pattern.test(id)) issues.push(`islands.${index}.sourceIds.${slot}: ${String(id)} is not a source of island ${island}`);
+    });
+    if (new Set(ids).size !== ids.length) issues.push(`islands.${index}: island ${island} repeats a source id`);
+  });
+  return issues;
+}
+
+/**
+ * A match's ruins, dealt once at match creation: in island order, each ruin draws its kind (sequence or navigation)
+ * and then its puzzle from the seeded generator. The same seed and islands always give the same ruins, in whatever
+ * order the islands are listed.
+ */
+export function createRuins(options: CreateRuinsOptions): RuinsState {
+  if (!Number.isSafeInteger(options.seed)) throw new RangeError(`seed must be an integer, got ${options.seed}`);
+  const rules = validateRuinRules(options.rules ?? ruinRules);
+  if (!rules.ok) throw new Error(`invalid ruin rules: ${rules.issues.join("; ")}`);
+  const issues = islandIssues(options.islands);
+  if (issues.length > 0) throw new Error(`invalid ruin islands: ${issues.join("; ")}`);
+  const source: Draw = { rng: (options.seed ^ RUINS_STREAM) >>> 0 };
+  const ruins: Record<string, Ruin> = {};
+  for (const { island, sourceIds } of [...options.islands].sort((a, b) => a.island - b.island)) {
+    const puzzle = drawInt(source, 2) === 0 ? generateSequence(rules.value, source) : generateNavigation(rules.value, source);
+    ruins[String(island)] = { island, sourceIds: [...sourceIds], puzzle, unlocked: false, solvedBy: [], lockouts: [], sessions: [] };
+  }
+  return { rules: rules.value, tick: 0, ruins, presence: [] };
+}
+
+/** The ruin on an island, if it has one. */
+export function findRuin(state: RuinsState, island: number): Ruin | undefined {
+  return Object.hasOwn(state.ruins, String(island)) ? state.ruins[String(island)] : undefined;
+}
+
+/** The islands with ruins, in ascending order. */
+export function ruinIslands(state: RuinsState): number[] {
+  return Object.values(state.ruins)
+    .map((ruin) => ruin.island)
+    .sort((a, b) => a - b);
+}
+
+/** The only view of a ruin a client may receive (§16): the site's clue, never the answer. */
+export function clueFor(ruin: Ruin): RuinClue {
+  return puzzleClue(ruin.puzzle);
+}
+
+export function presenceOf(state: RuinsState, playerId: string): RuinPresence {
+  return state.presence.find((entry) => entry.playerId === playerId) ?? { playerId, island: null, inDuel: false };
+}
+
+export function lockedUntil(ruin: Ruin, playerId: string): number {
+  return ruin.lockouts.find((lockout) => lockout.playerId === playerId)?.until ?? 0;
+}
+
+export function sessionOf(ruin: Ruin, playerId: string): RuinSession | undefined {
+  return ruin.sessions.find((session) => session.playerId === playerId);
+}
+
+export function hasSolved(ruin: Ruin, playerId: string): boolean {
+  return ruin.solvedBy.some((solve) => solve.playerId === playerId);
+}
