+      expect(createRuins({ seed, islands: ISLANDS })).toEqual(once);
+      expect(hashState(createRuins({ seed, islands: [...ISLANDS].reverse() }))).toBe(hashState(once));
+    }
+    const hashes = new Set(ALL.map(({ state }) => hashState(state)));
+    expect(hashes.size).toBe(SEEDS);
+  });
