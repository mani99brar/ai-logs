+import { WORLD_STEPS_PER_SECOND } from "@pirate-sea-race/content";
+import { RUIN_LOCKOUT_SECONDS, RUIN_MOVES, RUIN_SYMBOLS, ruinRules, type RuinMove, type RuinSymbol } from "@pirate-sea-race/content/ruins";
+import { describe, expect, it } from "vitest";
+import {
+  answerRuin,
+  clueFor,
+  createRuins,
+  hashState,
+  openRuin,
+  reportPresence,
+  ruinIslands,
+  tabletText,
+  type Ruin,
+  type RuinAttempt,
+  type RuinClue,
+  type RuinsState,
+  type SequenceTablet,
+} from "./index.js";
+
+/**
+ * Generation, clues and timing (§3, §16), checked with evaluators written here, independent of the generator's own
+ * helpers, so that one bug in the generator's semantics cannot pass both sides.
+ */
+
+const SEEDS = 500;
+const ISLANDS = [0, 1, 2, 3].map((island) => ({ island, sourceIds: [`source-${island}-0`, `source-${island}-1`] }));
+const LOCKOUT_TICKS = RUIN_LOCKOUT_SECONDS * WORLD_STEPS_PER_SECOND;
+
+function ruinsOf(state: RuinsState): Ruin[] {
+  return ruinIslands(state).map((island) => state.ruins[String(island)]!);
+}
+
+const ALL = Array.from({ length: SEEDS }, (_, seed) => ({ seed, state: createRuins({ seed, islands: ISLANDS }) }));
+const SEQUENCE_RUINS = ALL.flatMap(({ seed, state }) => ruinsOf(state).filter((ruin) => ruin.puzzle.kind === "sequence").map((ruin) => ({ seed, ruin })));
+const NAVIGATION_RUINS = ALL.flatMap(({ seed, state }) => ruinsOf(state).filter((ruin) => ruin.puzzle.kind === "navigation").map((ruin) => ({ seed, ruin })));
+
+// ---------------------------------------------------------------------------------------------------------------
+// Independent evaluators
+
+type Triple = readonly [RuinSymbol, RuinSymbol, RuinSymbol];
+
+/** All 120 ordered triples of distinct symbols, by three plain loops. */
+function everyTriple(): Triple[] {
+  const triples: Triple[] = [];
+  for (const a of RUIN_SYMBOLS) for (const b of RUIN_SYMBOLS) for (const c of RUIN_SYMBOLS) if (a !== b && b !== c && a !== c) triples.push([a, b, c]);
+  return triples;
+}
+
+/** Reads one tablet literally against a triple: the documented meaning of each relation, from first principles. */
+function tabletTrue(tablet: SequenceTablet, triple: Triple): boolean {
+  const place: Partial<Record<RuinSymbol, number>> = {};
+  triple.forEach((symbol, index) => (place[symbol] = index + 1));
+  const mine = place[tablet.symbol] ?? 0;
+  const theirs = tablet.hint.other === null ? 0 : (place[tablet.hint.other] ?? 0);
+  const both = mine > 0 && theirs > 0;
+  switch (tablet.hint.relation) {
+    case "absent":
+      return mine === 0;
+    case "present":
+      return mine > 0;
+    case "at":
+      return mine === tablet.hint.position! + 1;
+    case "not-at":
+      return mine !== tablet.hint.position! + 1;
+    case "right-after":
+      return both && mine - theirs === 1;
+    case "right-before":
+      return both && theirs - mine === 1;
+    case "after":
+      return both && mine > theirs;
+    case "before":
+      return both && mine < theirs;
+    default:
+      throw new Error(`unknown relation ${String(tablet.hint.relation)}`);
+  }
+}
+
+function triplesFitting(clue: Extract<RuinClue, { kind: "sequence" }>): Triple[] {
+  return everyTriple().filter((triple) => clue.tablets.every((tablet) => tabletTrue(tablet, triple)));
+}
+
+const DELTA: Record<RuinMove, readonly [number, number]> = { N: [0, -1], S: [0, 1], E: [1, 0], W: [-1, 0] };
+
+/** A grid of booleans (true = open) from a navigation clue. */
+function openGrid(clue: Extract<RuinClue, { kind: "navigation" }>): boolean[][] {
+  const grid = Array.from({ length: clue.size }, () => Array.from({ length: clue.size }, () => true));
+  for (const { x, y } of clue.blocked) grid[y]![x] = false;
+  return grid;
+}
+
+/** Breadth-first search over the clue's grid: the shortest move list from start to goal, or null. */
+function shortestRoute(clue: Extract<RuinClue, { kind: "navigation" }>): RuinMove[] | null {
+  const grid = openGrid(clue);
+  const key = (x: number, y: number) => `${x},${y}`;
+  const came = new Map<string, { from: string; move: RuinMove } | null>([[key(clue.start.x, clue.start.y), null]]);
+  let frontier: [number, number][] = [[clue.start.x, clue.start.y]];
+  while (frontier.length > 0) {
+    const next: [number, number][] = [];
+    for (const [x, y] of frontier) {
+      if (x === clue.goal.x && y === clue.goal.y) {
+        const moves: RuinMove[] = [];
+        for (let at = came.get(key(x, y)); at; at = came.get(at.from)) moves.unshift(at.move);
+        return moves;
+      }
+      for (const move of ["W", "S", "E", "N"] as const) {
+        const [nx, ny] = [x + DELTA[move][0], y + DELTA[move][1]];
+        if (grid[ny]?.[nx] !== true || came.has(key(nx, ny))) continue;
+        came.set(key(nx, ny), { from: key(x, y), move });
+        next.push([nx, ny]);
+      }
+    }
+    frontier = next;
+  }
+  return null;
+}
+
+/** Whether a move list walks from start to goal over open cells of the clue's grid. */
+function routeReachesGoal(clue: Extract<RuinClue, { kind: "navigation" }>, moves: readonly RuinMove[], grid = openGrid(clue)): boolean {
+  let [x, y] = [clue.start.x, clue.start.y];
+  for (const move of moves) {
+    [x, y] = [x + DELTA[move][0], y + DELTA[move][1]];
+    if (grid[y]?.[x] !== true) return false;
+  }
+  return x === clue.goal.x && y === clue.goal.y;
+}
+
+/** What a player who reads the site answers. */
+function readersAttempt(clue: RuinClue): RuinAttempt {
+  if (clue.kind === "sequence") {
+    const fits = triplesFitting(clue);
+    if (fits.length !== 1) throw new Error(`the clue admits ${fits.length} sequences`);
+    return { kind: "sequence", symbols: [...fits[0]!] };
+  }
+  const route = shortestRoute(clue);
+  if (!route) throw new Error("no route");
+  return { kind: "navigation", moves: route };
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+
+function percentile(values: readonly number[], fraction: number): number {
+  const sorted = [...values].sort((a, b) => a - b);
+  return sorted[Math.floor(fraction * (sorted.length - 1))]!;
+}
+
+function mean(values: readonly number[]): number {
+  return values.reduce((sum, value) => sum + value, 0) / values.length;
+}
+
+/** A state with just this ruin, the player moored at its island with the clue open at `tick`. */
+function openedAlone(ruin: Ruin, playerId: string, tick: number): { state: RuinsState; clue: RuinClue } {
+  const alone: RuinsState = { rules: ruinRules, tick: 0, ruins: { [String(ruin.island)]: ruin }, presence: [] };
+  const present = reportPresence(alone, { playerId, island: ruin.island, inDuel: false, tick });
+  const opened = openRuin(present.state, { playerId, island: ruin.island, tick });
+  expect(opened.result.ok).toBe(true);
+  return { state: opened.state, clue: opened.result.clue! };
+}
+
+/** Plays attempts in order, each as soon as the lockout allows, until one solves; the ticks from opening to solving. */
+function playUntilSolved(ruin: Ruin, attempts: Iterable<RuinAttempt>): { ticks: number; wrong: number } {
+  const openTick = 100;
+  let { state } = openedAlone(ruin, "guesser", openTick);
+  let tick = openTick;
+  let wrong = 0;
+  for (const attempt of attempts) {
+    const step = answerRuin(state, { playerId: "guesser", island: ruin.island, tick, attempt });
+    expect(step.result.ok).toBe(true);
+    if (step.result.outcome === "solved") return { ticks: tick - openTick, wrong };
+    wrong += 1;
+    state = step.state;
+    tick = step.result.lockedUntil;
+  }
+  throw new Error("the attempts ran out before solving");
+}
+
+describe("ruin generation (§3)", () => {
+  it("gives the same puzzles for the same seed and islands, in whatever order the islands come", () => {
+    for (const seed of [0, 1, 7, 123_456, 2 ** 31]) {
