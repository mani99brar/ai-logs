{
  "version": "1.2.0",
  "feature": "Pirate Sea Race final-island sockets",
  "independent_review": true,
  "integration_approval": true,
  "max_verification_attempts": 3,
  "setup": [
    {
      "argv": [
        "npm",
        "ci"
      ],
      "timeout_seconds": 900
    }
  ],
  "workers": [
    {
      "node_id": "world",
      "role": "fullstack",
      "required_check_kinds": [
        "typecheck",
        "unit",
        "integration",
        "build"
      ],
      "owned_paths": [
        "docs/architecture.md",
        "assets/source/maps",
        "scripts/build-map.ts",
        "packages/content/src/maps",
        "packages/content/src/maps.test.ts",
        "packages/content/src/seaMap.ts",
        "packages/content/src/seaValidation.ts",
        "packages/content/src/tiledMap.ts",
        "packages/content/src/content.test.ts"
      ],
      "checks": [
        {
          "id": "typecheck",
          "kind": "typecheck",
          "argv": [
            "npm",
            "run",
            "typecheck"
          ],
          "timeout_seconds": 300,
          "scenarios": []
        },
        {
          "id": "unit",
          "kind": "unit",
          "argv": [
            "npm",
            "run",
            "test:unit"
          ],
          "timeout_seconds": 300,
          "scenarios": []
        },
        {
          "id": "integration",
          "kind": "integration",
          "argv": [
            "npm",
            "run",
            "test:integration"
          ],
          "timeout_seconds": 300,
          "scenarios": []
        },
        {
          "id": "build",
          "kind": "build",
          "argv": [
            "npm",
            "run",
            "build"
          ],
          "timeout_seconds": 600,
          "scenarios": []
        }
      ]
    }
  ]
}
