+import { describe, expect, it } from "vitest";
+import { KIT_IDS } from "../moves/index.js";
+import { WORLD_STEPS_PER_SECOND } from "../sailing.js";
+import { FRUIT_KIT_IDS, fruitRules, kitDescriptions, PEDESTALS_PER_FRUIT_KIT, validateFruitRules, validateKitDescriptions } from "./index.js";
+
+function issuesOf(candidate: unknown): string[] {
+  const result = validateFruitRules(candidate);
+  return result.ok ? [] : result.issues;
+}
+
+describe("fruit rules (§9)", () => {
+  it("eat for three seconds of world ticks, two pedestals per fruit kit", () => {
+    expect(fruitRules.eatTicks).toBe(3 * WORLD_STEPS_PER_SECOND);
+    expect(fruitRules.eatTicks).toBe(60);
+    expect(fruitRules.pedestalsPerKit).toBe(PEDESTALS_PER_FRUIT_KIT);
+    expect(PEDESTALS_PER_FRUIT_KIT).toBe(2);
+    expect(validateFruitRules(fruitRules)).toEqual({ ok: true, value: fruitRules });
+  });
+
+  it("refuse an eating time of 0, fractional or negative values, no pedestals and unknown fields", () => {
+    expect(issuesOf({ ...fruitRules, eatTicks: 0 })[0]).toMatch(/^eatTicks:/);
+    expect(issuesOf({ ...fruitRules, eatTicks: 1.5 })[0]).toMatch(/^eatTicks:/);
+    expect(issuesOf({ ...fruitRules, eatTicks: -60 })[0]).toMatch(/^eatTicks:/);
+    expect(issuesOf({ ...fruitRules, pedestalsPerKit: 0 })[0]).toMatch(/^pedestalsPerKit:/);
+    expect(issuesOf({ eatTicks: 60 })[0]).toMatch(/^pedestalsPerKit:/);
+    expect(issuesOf({ ...fruitRules, extra: 1 })).toHaveLength(1);
+  });
+
+  it("deal every kit but the Duelist", () => {
+    expect(FRUIT_KIT_IDS).toEqual(KIT_IDS.filter((kit) => kit !== "duelist"));
+    expect(FRUIT_KIT_IDS).toEqual(["ember", "smoke"]);
+  });
+});
+
+describe("kit descriptions (§9's table)", () => {
+  it("describe every kit, under its own id, with two specials, an advantage and a vulnerability", () => {
+    expect(Object.keys(kitDescriptions).sort()).toEqual([...KIT_IDS].sort());
+    expect(validateKitDescriptions(kitDescriptions)).toEqual({ ok: true, value: kitDescriptions });
+    expect(kitDescriptions.ember.specials).toEqual(["Flame bolt", "Rising flare"]);
+    expect(kitDescriptions.smoke.vulnerability).toMatch(/readable reappearance/);
+  });
+
+  it("refuse a missing kit, a description under another id and an empty text", () => {
+    const { smoke: _, ...missing } = kitDescriptions;
+    expect(validateKitDescriptions(missing).ok).toBe(false);
+    expect(validateKitDescriptions({ ...kitDescriptions, smoke: { ...kitDescriptions.ember } })).toEqual({ ok: false, issues: ["smoke.kit: must be smoke, got ember"] });
+    expect(validateKitDescriptions({ ...kitDescriptions, ember: { ...kitDescriptions.ember, advantage: "" } }).ok).toBe(false);
+  });
+});
