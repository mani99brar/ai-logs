+export * from "./state.js";
+export * from "./step.js";
+export {
+  FRUIT_EAT_SECONDS,
+  FRUIT_KIT_IDS,
+  fruitRules,
+  kitDescriptions,
+  PEDESTALS_PER_FRUIT_KIT,
+  validateFruitRules,
+  type FruitKitId,
+  type FruitRules,
+  type KitDescription,
+} from "@pirate-sea-race/content/fruits";
+export { hashState } from "../hash.js";
diff --git a/packages/simulation/src/fruits/property.test.ts b/packages/simulation/src/fruits/property.test.ts
new file mode 100644
index 0000000..46e8c4e
--- /dev/null
+++ b/packages/simulation/src/fruits/property.test.ts
@@ -0,0 +1,175 @@
+import { rulesPresets } from "@pirate-sea-race/content";
+import { describe, expect, it } from "vitest";
+import { nextInt } from "../random.js";
+import {
+  checkFruitState,
+  createFruitConfig,
+  createFruitState,
+  fruitRules,
+  hashState,
+  kitOf,
+  replayFruits,
+  stepFruits,
+  type FruitPlayer,
+  type FruitResult,
+  type FruitSite,
+  type FruitState,
+  type FruitTickInput,
+} from "./index.js";
+
+/** A short meal, so random scripts finish plenty of them. */
+const config = createFruitConfig({ ...fruitRules, eatTicks: 8 });
+const SITES: FruitSite[] = ["dock-a", "dock-b", "dock-c", "dock-d"].map((id, index) => ({ id, x: index * 512, y: 0 }));
+/** Ids whose code-unit order differs from numeric and case-insensitive order. */
+const IDS = ["p1", "p10", "p2", "P3", "a", "B"];
+
+type Draw = (bound: number) => number;
+
+function generator(seed: number): Draw {
+  let rng = seed;
+  return (bound) => {
+    const drawn = nextInt(rng, bound);
+    rng = drawn.state;
+    return drawn.value;
+  };
+}
+
+function shuffled<T>(items: readonly T[], draw: Draw): T[] {
+  const copy = [...items];
+  for (let index = copy.length - 1; index > 0; index--) {
+    const other = draw(index + 1);
+    [copy[index], copy[other]] = [copy[other]!, copy[index]!];
+  }
+  return copy;
+}
+
+/**
+ * A seeded script: players crowd the pedestals, hold and release, get reserved, disconnect, leave for good and drop
+ * out of the facts; world ticks are now and then skipped or repeated. `calm` (per mille) scales how rarely anything
+ * changes, so some meals run to completion and some players finish together.
+ */
+function randomScript(seed: number, calm: number): FruitTickInput[] {
+  const draw = generator(seed);
+  const chance = (perMille: number) => draw(1000) < Math.floor((perMille * (1000 - calm)) / 1000);
+  const ids = shuffled(IDS, draw).slice(0, 2 + draw(5));
+  const pedestalOf = () => (draw(6) === 0 ? null : SITES[draw(2)]!.id); // two busy pedestals, crowded
+  const players = new Map<string, FruitPlayer>(
+    ids.map((playerId) => [playerId, { playerId, pedestalId: pedestalOf(), holding: true, reserved: false, disconnected: false, left: false }]),
+  );
+  const script: FruitTickInput[] = [];
+  let tick = 0;
+  for (let count = 0; count < 160; count++) {
+    tick += chance(15) ? 2 : 1;
+    for (const id of ids) {
+      let next = players.get(id)!;
+      if (chance(30)) next = { ...next, pedestalId: draw(3) === 0 ? SITES[draw(SITES.length)]!.id : pedestalOf() };
+      if (chance(60)) next = { ...next, holding: !next.holding };
+      if (chance(20)) next = { ...next, reserved: !next.reserved };
+      if (chance(15)) next = { ...next, disconnected: !next.disconnected };
+      if (chance(3)) next = { ...next, left: true };
+      players.set(id, next);
+    }
+    script.push({ tick, players: ids.filter(() => !chance(10)).map((id) => players.get(id)!) });
+    // A repeated or stale tick, which must change nothing.
+    if (chance(15)) script.push({ tick: tick - draw(3), players: shuffled([...players.values()], draw) });
+  }
+  return script;
+}
+
+interface Run {
+  readonly states: readonly FruitState[];
+  readonly hashes: readonly string[];
+  readonly results: readonly (readonly FruitResult[])[];
+}
+
+function run(script: readonly FruitTickInput[], seed: number): Run {
+  let state = createFruitState(SITES, seed, rulesPresets.slice);
+  const states: FruitState[] = [];
+  const results: FruitResult[][] = [];
+  for (const input of script) {
+    const stepped = stepFruits(config, state, input);
+    if (input.tick <= state.tick) expect(stepped.state).toBe(state);
+    state = stepped.state;
+    states.push(state);
+    results.push([...stepped.results]);
+  }
+  return { states, hashes: states.map(hashState), results };
+}
+
+const resultKey = (result: FruitResult) => ("reason" in result ? `${result.kind}:${result.reason}` : result.kind);
+
+/** Every result the step can give; the seeds together must produce each one. */
+const EXERCISED = [
+  "eat-started",
+  "eat-completed",
+  "tick-rejected",
+  ...["released", "moved", "gap", "taken", "left", "disconnected", "reserved"].map((reason) => `eat-interrupted:${reason}`),
+  ...["left", "disconnected", "reserved", "already-eaten", "empty"].map((reason) => `eat-refused:${reason}`),
+];
+
+const SEEDS = Array.from({ length: 80 }, (_, index) => index + 1);
+const scriptFor = (seed: number) => randomScript(seed, [0, 500, 850][seed % 3]!);
+
+describe("seeded random ticks", () => {
+  it.each(SEEDS)("seed %i keeps every invariant", (seed) => {
+    const script = scriptFor(seed);
+    const { states, results } = run(script, seed);
+    const all = results.flat();
+    const completed = all.filter((result) => result.kind === "eat-completed");
+    // Each pedestal is eaten at most once, and each player eats at most once.
+    expect(new Set(completed.map((result) => result.pedestalId)).size).toBe(completed.length);
+    expect(new Set(completed.map((result) => result.playerId)).size).toBe(completed.length);
+    const kits = new Map<string, string>();
+    for (const state of states) {
+      expect(checkFruitState(state)).toEqual([]);
+      const full = state.pedestals.filter((pedestal) => pedestal.eatenBy === null).length;
+      expect(state.meals.length + full).toBe(SITES.length);
+      // A kit, once eaten, never changes.
+      for (const id of IDS) {
+        const kit = kitOf(state, id);
+        if (kits.has(id)) expect(kit).toBe(kits.get(id));
+        else if (kit !== "duelist") kits.set(id, kit);
+      }
+    }
+    expect(states.at(-1)!.meals).toHaveLength(completed.length);
+    // A tick's results are in player id order, completions and their takings last.
+    for (const tick of results) {
+      const early = tick.filter((result) => result.kind !== "eat-completed" && !(result.kind === "eat-interrupted" && result.reason === "taken"));
+      const ids = early.map((result) => ("playerId" in result ? result.playerId : ""));
+      expect(ids).toEqual([...ids].sort((a, b) => (a < b ? -1 : a > b ? 1 : 0)));
+    }
+  });
+
+  it("exercises every result across the seeds", () => {
+    const seen = new Set<string>();
+    let contested = 0;
+    for (const seed of SEEDS) {
+      for (const tick of run(scriptFor(seed), seed).results) {
+        for (const result of tick) seen.add(resultKey(result));
+        // Two completers on one tick: one eats and the other finds it taken with a full channel.
+        if (tick.some((result) => result.kind === "eat-interrupted" && result.reason === "taken" && result.held >= config.eatTicks)) contested++;
+      }
+    }
+    expect([...seen].sort()).toEqual([...EXERCISED].sort());
+    expect(contested).toBeGreaterThan(0);
+  });
+
+  it.each(SEEDS.slice(0, 20))("seed %i replays to the same hash, tick by tick", (seed) => {
+    const script = scriptFor(seed);
+    const first = run(script, seed);
+    const again = run(JSON.parse(JSON.stringify(script)) as FruitTickInput[], seed);
+    expect(again.hashes).toEqual(first.hashes);
+    expect(again.results).toEqual(first.results);
+    expect(replayFruits(config, createFruitState(SITES, seed, rulesPresets.slice), script).hash).toBe(first.hashes.at(-1));
+  });
+
+  it.each(SEEDS.slice(0, 20))("seed %i: the order of players in each tick never matters", (seed) => {
+    const script = scriptFor(seed);
+    const draw = generator(seed * 7919);
+    const reordered = script.map((input) => ({ ...input, players: shuffled(input.players, draw) }));
+    const first = run(script, seed);
+    const again = run(reordered, seed);
+    expect(again.hashes).toEqual(first.hashes);
+    expect(again.results).toEqual(first.results);
+  });
+});
diff --git a/packages/simulation/src/fruits/state.ts b/packages/simulation/src/fruits/state.ts
new file mode 100644
index 0000000..c1fb42e
--- /dev/null
+++ b/packages/simulation/src/fruits/state.ts
@@ -0,0 +1,158 @@
+import { validateRulesPreset, type RulesPreset } from "@pirate-sea-race/content";
+import {
+  FRUIT_KIT_IDS,
+  fruitRules as defaultFruitRules,
+  kitDescriptions,
+  validateFruitRules,
+  type FruitKitId,
+  type FruitRules,
+  type KitDescription,
+} from "@pirate-sea-race/content/fruits";
+import type { KitId } from "@pirate-sea-race/content/moves";
+import { nextInt } from "../random.js";
+
+/** Static fruit data for one match; the step reads it and it never changes. */
+export interface FruitConfig {
+  /** World ticks of held interact that eat a fruit; the last of them eats it. */
+  readonly eatTicks: number;
+}
+
+/** Builds a match's fruit config from the content rules, refusing invalid rules. */
+export function createFruitConfig(rules: FruitRules = defaultFruitRules): FruitConfig {
+  const checked = validateFruitRules(rules);
+  if (!checked.ok) throw new RangeError(`invalid fruit rules: ${checked.issues.join("; ")}`);
+  return { eatTicks: checked.value.eatTicks };
+}
+
+/** Where the room places a pedestal. The rules never read positions: the caller decides who stands at a pedestal. */
+export interface FruitSite {
+  /** The pedestal's stable id, as the caller names it in each tick's facts. */
+  readonly id: string;
+  /** Position in sub-units, for the caller's own use. */
+  readonly x: number;
+  readonly y: number;
+}
+
+export interface FruitPedestal {
+  readonly id: string;
+  readonly x: number;
+  readonly y: number;
+  /** The fruit dealt here; it stays recorded after the fruit is eaten. */
+  readonly kit: FruitKitId;
+  /** The player who ate it, or null while the fruit is still there. Nothing respawns. */
+  readonly eatenBy: string | null;
+}
+
+/** A player holding interact at a pedestal. */
+export interface FruitChannel {
+  readonly playerId: string;
+  readonly pedestalId: string;
+  readonly startTick: number;
+  /** The last tick it was held on; the channel continues only on the very next tick. */
+  readonly lastTick: number;
+  /** Held ticks so far, the start tick included; the fruit is eaten when this reaches `eatTicks`. */
+  readonly held: number;
+}
+
+/** A fruit eaten: the player's kit for the rest of the match. */
+export interface FruitMeal {
+  readonly playerId: string;
+  readonly pedestalId: string;
+  readonly kit: FruitKitId;
+  readonly tick: number;
+}
+
+/** The fruit state: plain integer data that `hashState` covers entirely. */
+export interface FruitState {
+  /** The last world tick processed. */
+  readonly tick: number;
+  /** In site order. */
+  readonly pedestals: readonly FruitPedestal[];
+  /** Sorted by player id. */
+  readonly channels: readonly FruitChannel[];
+  /** Sorted by player id; a player appears at most once and is never removed. */
+  readonly meals: readonly FruitMeal[];
+}
+
+function requireInteger(value: unknown, name: string): void {
+  if (typeof value !== "number" || !Number.isSafeInteger(value)) throw new RangeError(`${name} must be a safe integer, got ${String(value)}`);
+}
+
+/**
+ * The fruit kits a match deals: `KIT_IDS` without the Duelist. A preset asking for another number of fruit kits is
+ * refused until its kits exist (the alpha asks for six; two exist).
+ */
+export function fruitDeck(preset: RulesPreset, pedestalsPerKit: number): FruitKitId[] {
+  if (preset.fruitKits !== FRUIT_KIT_IDS.length) {
+    throw new RangeError(
+      `the ${preset.id} preset deals ${preset.fruitKits} fruit kits, but only ${FRUIT_KIT_IDS.length} exist (${FRUIT_KIT_IDS.join(", ")})`,
+    );
+  }
+  return FRUIT_KIT_IDS.flatMap((kit) => Array.from({ length: pedestalsPerKit }, () => kit));
+}
+
+export interface CreateFruitStateOptions {
+  /** The world tick before the first step (default 0). */
+  readonly tick?: number;
+  readonly rules?: FruitRules;
+}
+
+/**
+ * Deals the preset's fruit onto the caller's sites with the seeded generator (a Fisher–Yates shuffle of two of each
+ * fruit kit), so the same seed and sites always give the same deal. Pass the room's private seed, never the public
+ * match code (§3, §16): the deal is hidden information. Refuses a preset whose fruit count differs from the kits that
+ * exist, and a site list whose length differs from the deck.
+ */
+export function createFruitState(sites: readonly FruitSite[], seed: number, preset: RulesPreset, options: CreateFruitStateOptions = {}): FruitState {
+  requireInteger(seed, "seed");
+  const tick = options.tick ?? 0;
+  requireInteger(tick, "tick");
+  const checkedPreset = validateRulesPreset(preset);
+  if (!checkedPreset.ok) throw new RangeError(`invalid rules preset: ${checkedPreset.issues.join("; ")}`);
+  const rules = validateFruitRules(options.rules ?? defaultFruitRules);
+  if (!rules.ok) throw new RangeError(`invalid fruit rules: ${rules.issues.join("; ")}`);
+  const deck = fruitDeck(checkedPreset.value, rules.value.pedestalsPerKit);
+  if (sites.length !== deck.length) {
+    throw new RangeError(`the ${preset.id} preset needs ${deck.length} pedestal sites (${rules.value.pedestalsPerKit} per fruit kit), got ${sites.length}`);
+  }
+  const ids = new Set<string>();
+  for (const site of sites) {
+    if (typeof site.id !== "string" || site.id.length === 0) throw new RangeError("pedestal ids must be non-empty strings");
+    if (ids.has(site.id)) throw new RangeError(`pedestal ${site.id} appears twice`);
+    ids.add(site.id);
+    requireInteger(site.x, `${site.id}.x`);
+    requireInteger(site.y, `${site.id}.y`);
+  }
+  let rng = seed >>> 0;
+  for (let index = deck.length - 1; index > 0; index--) {
+    const drawn = nextInt(rng, index + 1);
+    rng = drawn.state;
+    [deck[index], deck[drawn.value]] = [deck[drawn.value]!, deck[index]!];
+  }
+  const pedestals = sites.map((site, index) => ({ id: site.id, x: site.x, y: site.y, kit: deck[index]!, eatenBy: null }));
+  return { tick, pedestals, channels: [], meals: [] };
+}
+
+/**
+ * A player's kit (§9): the fruit they ate, or the Duelist for a player who has not eaten, and for an id the state has
+ * never seen. Nothing in this module clears a meal, so a defeat or leaving keeps it.
+ */
+export function kitOf(state: FruitState, playerId: string): KitId {
+  return state.meals.find((meal) => meal.playerId === playerId)?.kit ?? "duelist";
+}
+
+/** What a pedestal shows: its fruit's kit and description, or that it is empty. */
+export type PedestalInspection =
+  | { readonly pedestalId: string; readonly full: true; readonly kit: FruitKitId; readonly description: KitDescription }
+  | { readonly pedestalId: string; readonly full: false };
+
+/**
+ * The kit description a player may read before committing (§9), or null for an unknown pedestal. The deal is hidden
+ * information: the caller shows a pedestal's kit only to players at that pedestal.
+ */
+export function inspectPedestal(state: FruitState, pedestalId: string): PedestalInspection | null {
+  const pedestal = state.pedestals.find((candidate) => candidate.id === pedestalId);
+  if (pedestal === undefined) return null;
+  if (pedestal.eatenBy !== null) return { pedestalId, full: false };
+  return { pedestalId, full: true, kit: pedestal.kit, description: kitDescriptions[pedestal.kit] };
+}
diff --git a/packages/simulation/src/fruits/step.ts b/packages/simulation/src/fruits/step.ts
new file mode 100644
index 0000000..727c5bf
--- /dev/null
+++ b/packages/simulation/src/fruits/step.ts
@@ -0,0 +1,225 @@
+import { hashState } from "../hash.js";
+import type { FruitKitId } from "@pirate-sea-race/content/fruits";
+import type { FruitChannel, FruitConfig, FruitMeal, FruitPedestal, FruitState } from "./state.js";
+
+/** What the caller knows about one player on this tick. */
+export interface FruitPlayer {
+  readonly playerId: string;
+  /** The pedestal the player stands at (the caller decides reach), or null. */
+  readonly pedestalId: string | null;
+  /** Holding interact on this tick. */
+  readonly holding: boolean;
+  /** Reserved for, or fighting, a duel (§6). */
+  readonly reserved: boolean;
+  /** Disconnected (§12): channels are cancelled. */
+  readonly disconnected: boolean;
+  /** Left the match: they keep their kit, and cannot eat. */
+  readonly left: boolean;
+}
+
+/** One world tick's facts; the order of `players` never matters. A player absent from the list is not holding. */
+export interface FruitTickInput {
+  /** Must be later than the state's tick; a skipped tick is a gap that resets every channel. */
+  readonly tick: number;
+  readonly players: readonly FruitPlayer[];
+}
+
+/** Why a held request cannot eat: the player is gone, busy or fed, or the pedestal is empty. */
+export type FruitRefusalReason = "left" | "disconnected" | "reserved" | "already-eaten" | "empty";
+
+/** Why a channel reset to zero. `taken`: another player ate the fruit first (on an earlier completion, or this tick). */
+export type FruitInterruptReason = "released" | "moved" | "gap" | "taken" | "left" | "disconnected" | "reserved";
+
+/** Something that happened on a tick, for the caller to apply or announce; listed in player id order. */
+export type FruitResult =
+  | { readonly kind: "eat-started"; readonly tick: number; readonly playerId: string; readonly pedestalId: string }
+  /** The channel was lost; `held` is the ticks it had. */
+  | { readonly kind: "eat-interrupted"; readonly tick: number; readonly playerId: string; readonly pedestalId: string; readonly reason: FruitInterruptReason; readonly held: number }
+  /** A request held at a pedestal that cannot start; reported on every tick it is held. */
+  | { readonly kind: "eat-refused"; readonly tick: number; readonly playerId: string; readonly pedestalId: string; readonly reason: FruitRefusalReason }
+  /** The fruit is eaten: `kit` is the player's kit for the rest of the match. */
+  | { readonly kind: "eat-completed"; readonly tick: number; readonly playerId: string; readonly pedestalId: string; readonly kit: FruitKitId }
+  /** A tick not later than the state's: nothing is applied and the very same state comes back. */
+  | { readonly kind: "tick-rejected"; readonly tick: number; readonly lastTick: number };
+
+export interface FruitStepResult {
+  readonly state: FruitState;
+  readonly results: readonly FruitResult[];
+}
+
+/** Lowest id by UTF-16 code units, independent of locale. */
+export function compareIds(a: string, b: string): number {
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+function requireBoolean(value: unknown, name: string): void {
+  if (typeof value !== "boolean") throw new RangeError(`${name} must be a boolean, got ${String(value)}`);
+}
+
+/** Refuses malformed facts (a caller bug): duplicate or empty ids, unknown pedestals, non-boolean flags. */
+function readPlayers(state: FruitState, input: FruitTickInput): FruitPlayer[] {
+  const pedestalIds = new Set(state.pedestals.map((pedestal) => pedestal.id));
+  const seen = new Set<string>();
+  for (const player of input.players) {
+    if (typeof player.playerId !== "string" || player.playerId.length === 0) throw new RangeError("player ids must be non-empty strings");
+    if (seen.has(player.playerId)) throw new RangeError(`player ${player.playerId} appears twice`);
+    seen.add(player.playerId);
+    if (player.pedestalId !== null && !pedestalIds.has(player.pedestalId)) throw new RangeError(`unknown pedestal ${String(player.pedestalId)}`);
+    for (const flag of ["holding", "reserved", "disconnected", "left"] as const) requireBoolean(player[flag], `${player.playerId}.${flag}`);
+  }
+  return [...input.players].sort((a, b) => compareIds(a.playerId, b.playerId));
+}
+
+/**
+ * One world tick of §9's acquisition rules. A tick not later than the state's is rejected with the very same state.
+ * Otherwise, in a fixed order: (1) a skipped tick resets every channel (`gap`); (2) players, sorted by id, advance,
+ * start, reset or are refused, and channels of players absent from the facts are released; (3) channels that reach
+ * `eatTicks` complete in id order: the first eats the fruit, and every later completer, and every other channel at
+ * that pedestal, is interrupted as `taken`. The input and the state are never mutated.
+ */
+export function stepFruits(config: FruitConfig, state: FruitState, input: FruitTickInput): FruitStepResult {
+  if (typeof input.tick !== "number" || !Number.isSafeInteger(input.tick)) throw new RangeError(`tick must be a safe integer, got ${String(input.tick)}`);
+  if (input.tick <= state.tick) return { state, results: [{ kind: "tick-rejected", tick: input.tick, lastTick: state.tick }] };
+  const players = readPlayers(state, input);
+  const tick = input.tick;
+  const results: FruitResult[] = [];
+  const interrupted = (channel: FruitChannel, reason: FruitInterruptReason): FruitResult => ({
+    kind: "eat-interrupted",
+    tick,
+    playerId: channel.playerId,
+    pedestalId: channel.pedestalId,
+    reason,
+    held: channel.held,
+  });
+
+  const pedestals = new Map(state.pedestals.map((pedestal) => [pedestal.id, pedestal]));
+  const fed = new Set(state.meals.map((meal) => meal.playerId));
+  const previous = new Map(state.channels.map((channel) => [channel.playerId, channel]));
+  const present = new Set(players.map((player) => player.playerId));
+  const gap = tick !== state.tick + 1;
+
+  // Each player's step, and the released channels of absent players, merged in id order.
+  const steps: { playerId: string; results: FruitResult[]; channel: FruitChannel | null }[] = [];
+  for (const channel of state.channels) {
+    if (!present.has(channel.playerId)) steps.push({ playerId: channel.playerId, results: [interrupted(channel, gap ? "gap" : "released")], channel: null });
+  }
+  for (const player of players) {
+    const own: FruitResult[] = [];
+    let channel = previous.get(player.playerId) ?? null;
+    // 1. A skipped tick breaks every channel.
+    if (channel !== null && gap) {
+      own.push(interrupted(channel, "gap"));
+      channel = null;
+    }
+    const target = player.holding ? player.pedestalId : null;
+    if (target === null) {
+      if (channel !== null) own.push(interrupted(channel, "released"));
+      steps.push({ playerId: player.playerId, results: own, channel: null });
+      continue;
+    }
+    if (channel !== null && channel.pedestalId !== target) {
+      own.push(interrupted(channel, "moved"));
+      channel = null;
+    }
+    const pedestal = pedestals.get(target)!;
+    const refusal: FruitRefusalReason | null = player.left
+      ? "left"
+      : player.disconnected
+        ? "disconnected"
+        : player.reserved
+          ? "reserved"
+          : fed.has(player.playerId)
+            ? "already-eaten"
+            : pedestal.eatenBy !== null
+              ? "empty"
+              : null;
+    if (refusal !== null) {
+      // A live channel can only meet the player's own state here: a fed player or an empty pedestal has none.
+      if (channel !== null) own.push(interrupted(channel, refusal as FruitInterruptReason));
+      else own.push({ kind: "eat-refused", tick, playerId: player.playerId, pedestalId: target, reason: refusal });
+      steps.push({ playerId: player.playerId, results: own, channel: null });
+      continue;
+    }
+    if (channel !== null) {
+      channel = { ...channel, lastTick: tick, held: channel.held + 1 };
+    } else {
+      channel = { playerId: player.playerId, pedestalId: target, startTick: tick, lastTick: tick, held: 1 };
+      own.push({ kind: "eat-started", tick, playerId: player.playerId, pedestalId: target });
+    }
+    steps.push({ playerId: player.playerId, results: own, channel });
+  }
+  steps.sort((a, b) => compareIds(a.playerId, b.playerId));
+  for (const step of steps) results.push(...step.results);
+
+  // 2. Completions in id order: the lowest id eats; the rest at that pedestal find it taken.
+  const meals: FruitMeal[] = [...state.meals];
+  let channels = steps.flatMap((step) => (step.channel === null ? [] : [step.channel]));
+  for (const channel of channels) {
+    if (channel.held < config.eatTicks) continue;
+    const pedestal = pedestals.get(channel.pedestalId)!;
+    if (pedestal.eatenBy !== null) continue;
+    pedestals.set(pedestal.id, { ...pedestal, eatenBy: channel.playerId });
+    meals.push({ playerId: channel.playerId, pedestalId: pedestal.id, kit: pedestal.kit, tick });
+    results.push({ kind: "eat-completed", tick, playerId: channel.playerId, pedestalId: pedestal.id, kit: pedestal.kit });
+  }
+  const eatenNow = new Set(meals.slice(state.meals.length).map((meal) => meal.pedestalId));
+  const eaters = new Set(meals.slice(state.meals.length).map((meal) => meal.playerId));
+  channels = channels.filter((channel) => {
+    if (eaters.has(channel.playerId)) return false;
+    if (!eatenNow.has(channel.pedestalId)) return true;
+    results.push(interrupted(channel, "taken"));
+    return false;
+  });
+
+  meals.sort((a, b) => compareIds(a.playerId, b.playerId));
+  const next: FruitState = {
+    tick,
+    pedestals: state.pedestals.map((pedestal) => pedestals.get(pedestal.id)!),
+    channels,
+    meals,
+  };
+  return { state: next, results };
+}
+
+export interface FruitReplay {
+  readonly state: FruitState;
+  readonly results: readonly FruitResult[];
+  readonly hash: string;
+}
+
+/** Steps a sequence of ticks from a state, collecting every result; `hash` is the final state's `hashState`. */
+export function replayFruits(config: FruitConfig, state: FruitState, inputs: readonly FruitTickInput[]): FruitReplay {
+  let current = state;
+  const results: FruitResult[] = [];
+  for (const input of inputs) {
+    const stepped = stepFruits(config, current, input);
+    current = stepped.state;
+    results.push(...stepped.results);
+  }
+  return { state: current, results, hash: hashState(current) };
+}
+
+/** Invariant violations of a fruit state, empty when it is consistent. */
+export function checkFruitState(state: FruitState): string[] {
+  const issues: string[] = [];
+  const pedestals = new Map<string, FruitPedestal>(state.pedestals.map((pedestal) => [pedestal.id, pedestal]));
+  const eatenPedestals = new Set<string>();
+  const fedPlayers = new Set<string>();
+  for (const meal of state.meals) {
+    if (fedPlayers.has(meal.playerId)) issues.push(`player ${meal.playerId} ate twice`);
+    fedPlayers.add(meal.playerId);
+    if (eatenPedestals.has(meal.pedestalId)) issues.push(`pedestal ${meal.pedestalId} was eaten twice`);
+    eatenPedestals.add(meal.pedestalId);
+    const pedestal = pedestals.get(meal.pedestalId);
+    if (pedestal === undefined) issues.push(`meal at unknown pedestal ${meal.pedestalId}`);
+    else if (pedestal.eatenBy !== meal.playerId || pedestal.kit !== meal.kit) issues.push(`pedestal ${meal.pedestalId} disagrees with ${meal.playerId}'s meal`);
+  }
+  const full = state.pedestals.filter((pedestal) => pedestal.eatenBy === null).length;
+  if (state.meals.length + full !== state.pedestals.length) issues.push(`${state.meals.length} meals + ${full} full pedestals != ${state.pedestals.length} pedestals`);
+  for (const channel of state.channels) {
+    if (fedPlayers.has(channel.playerId)) issues.push(`fed player ${channel.playerId} is still eating`);
+    if (pedestals.get(channel.pedestalId)?.eatenBy !== null) issues.push(`channel at empty or unknown pedestal ${channel.pedestalId}`);
+    if (channel.held !== channel.lastTick - channel.startTick + 1) issues.push(`channel of ${channel.playerId} skipped a tick`);
+  }
+  return issues;
+}
