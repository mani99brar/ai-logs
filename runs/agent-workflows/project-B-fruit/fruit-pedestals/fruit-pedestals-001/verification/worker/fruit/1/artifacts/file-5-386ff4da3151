import { z } from "zod";
import { KIT_IDS, type KitId } from "../moves/index.js";
import { formatIssues, type ValidationResult } from "../rules.js";
import { WORLD_STEPS_PER_SECOND } from "../sailing.js";

/** §9: eating a fruit takes three seconds of held interact, and can be interrupted. */
export const FRUIT_EAT_SECONDS = 3;
/** §9: "two of each type". Each pedestal holds one fruit, feeds one player once, and never refills. */
export const PEDESTALS_PER_FRUIT_KIT = 2;

/** The kits a pedestal can hold: every kit but the Duelist, which every player starts with (§9). */
export type FruitKitId = Exclude<KitId, "duelist">;
export const FRUIT_KIT_IDS: readonly FruitKitId[] = KIT_IDS.filter((kit): kit is FruitKitId => kit !== "duelist");

/** The fruit rules (§9) in world ticks (20 a second). */
export const fruitRulesSchema = z.strictObject({
  /** World ticks of held interact that eat a fruit; the last of them eats it. */
  eatTicks: z.int().positive(),
  /** Pedestals dealt for each fruit kit. */
  pedestalsPerKit: z.int().positive(),
});

export type FruitRules = z.infer<typeof fruitRulesSchema>;

export const fruitRules: FruitRules = {
  eatTicks: FRUIT_EAT_SECONDS * WORLD_STEPS_PER_SECOND,
  pedestalsPerKit: PEDESTALS_PER_FRUIT_KIT,
};

export function validateFruitRules(candidate: unknown): ValidationResult<FruitRules> {
  const parsed = fruitRulesSchema.safeParse(candidate);
  return parsed.success ? { ok: true, value: parsed.data } : { ok: false, issues: formatIssues(parsed.error) };
}
