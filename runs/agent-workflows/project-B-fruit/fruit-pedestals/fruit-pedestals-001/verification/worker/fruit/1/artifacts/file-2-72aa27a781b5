import { z } from "zod";
import { KIT_IDS, type KitId } from "../moves/index.js";
import { formatIssues, type ValidationResult } from "../rules.js";

/** What a player may read about a kit before committing to it (§9's kit table). */
export interface KitDescription {
  readonly kit: KitId;
  readonly name: string;
  /** The two signature specials, U then I. */
  readonly specials: readonly [string, string];
  readonly advantage: string;
  readonly vulnerability: string;
}

const text = z.string().min(1).max(120);

export const kitDescriptionSchema = z.strictObject({
  kit: z.enum(KIT_IDS),
  name: text,
  specials: z.tuple([text, text]),
  advantage: text,
  vulnerability: text,
});

/** §9's table, one entry per kit of `KIT_IDS`. */
export const kitDescriptions: Readonly<Record<KitId, KitDescription>> = {
  duelist: {
    kit: "duelist",
    name: "Duelist",
    specials: ["Advancing thrust", "Counter slash"],
    advantage: "Reliable close combat and meter use",
    vulnerability: "Limited long-range pressure",
  },
  ember: {
    kit: "ember",
    name: "Ember",
    specials: ["Flame bolt", "Rising flare"],
    advantage: "Controls space and punishes jumps",
    vulnerability: "Long recovery if attacks miss",
  },
  smoke: {
    kit: "smoke",
    name: "Smoke",
    specials: ["Short feint dash", "Smoke screen"],
    advantage: "Changes spacing and obscures intent",
    vulnerability: "Low direct damage; readable reappearance",
  },
};

/** Checks every description against the schema and that each one sits under its own kit id. */
export function validateKitDescriptions(candidate: unknown): ValidationResult<Record<KitId, KitDescription>> {
  const parsed = z.record(z.enum(KIT_IDS), kitDescriptionSchema).safeParse(candidate);
  if (!parsed.success) return { ok: false, issues: formatIssues(parsed.error) };
  const issues = KIT_IDS.flatMap((kit) => {
    const entry = parsed.data[kit];
    if (entry === undefined) return [`${kit}: missing`];
    return entry.kit === kit ? [] : [`${kit}.kit: must be ${kit}, got ${entry.kit}`];
  });
  return issues.length === 0 ? { ok: true, value: parsed.data as Record<KitId, KitDescription> } : { ok: false, issues };
}
