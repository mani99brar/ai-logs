{
  "version": "1.2.0",
  "feature": "Pirate Sea Race world sea",
  "independent_review": true,
  "integration_approval": true,
  "max_verification_attempts": 3,
  "setup": [
    {
      "argv": [
        "npm",
        "ci"
      ],
      "timeout_seconds": 900
    }
  ],
  "workers": [
    {
      "node_id": "world",
      "role": "fullstack",
      "required_check_kinds": [
        "typecheck",
        "unit",
        "integration",
        "build",
        "browser"
      ],
      "owned_paths": [
        "package.json",
        "package-lock.json",
        "README.md",
        "docs/architecture.md",
        "packages/simulation/src",
        "packages/content/src",
        "packages/protocol",
        "packages/test-tools/src/headlessClient.ts",
        "packages/test-tools/src/index.ts",
        "apps",
        "tests/integration",
        "tests/e2e",
        "scripts",
        "assets/source/maps"
      ],
      "checks": [
        {
          "id": "typecheck",
          "kind": "typecheck",
          "argv": [
            "npm",
            "run",
            "typecheck"
          ],
          "timeout_seconds": 300,
          "scenarios": []
        },
        {
          "id": "unit",
          "kind": "unit",
          "argv": [
            "npm",
            "run",
            "test:unit"
          ],
          "timeout_seconds": 300,
          "scenarios": []
        },
        {
          "id": "integration",
          "kind": "integration",
          "argv": [
            "npm",
            "run",
            "test:integration"
          ],
          "timeout_seconds": 300,
          "scenarios": []
        },
        {
          "id": "build",
          "kind": "build",
          "argv": [
            "npm",
            "run",
            "build"
          ],
          "timeout_seconds": 600,
          "scenarios": []
        },
        {
          "id": "browser",
          "kind": "browser",
          "argv": [
            "npx",
            "--no-install",
            "playwright",
            "test",
            "--config=tests/e2e/playwright.config.ts"
          ],
          "timeout_seconds": 600,
          "scenarios": [
            {
              "id": "join-private-match",
              "description": "One browser creates a private match from the landing page; the HUD shows the code, the protocol version, one player and a connected status."
            },
            {
              "id": "two-ships-sync",
              "description": "Two browsers join the same private match with their ships in sight of each other; one sails with the keyboard and the other browser's view shows that ship at the new server-authoritative position."
            },
            {
              "id": "sail-and-dock",
              "description": "A browser sails its ship around a shoal to an island dock with the keyboard and docks there; the HUD shows the dock and the ship stops at it."
            },
            {
              "id": "out-of-sight",
              "description": "Two browsers in one match with their ships out of sight of each other: neither view lists or draws the other ship until one sails within the sight radius, and it disappears again when it sails away."
            }
          ]
        }
      ]
    }
  ]
}
