+/**
+ * The minimap's fog (§3): every tile starts hidden, and tiles within the sight radius of the player's ship are
+ * revealed for good as it sails. Terrain is public content, so this is presentation only, not a security boundary
+ * (§16); ships are filtered by the server.
+ */
+export class FogOfWar {
+  private readonly revealed: Uint8Array;
+  private count = 0;
+  private lastTile = -1;
+
+  constructor(
+    readonly widthTiles: number,
+    readonly heightTiles: number,
+    readonly radiusTiles: number,
+  ) {
+    this.revealed = new Uint8Array(widthTiles * heightTiles);
+  }
+
+  get revealedCount(): number {
+    return this.count;
+  }
+
+  isRevealed(tileX: number, tileY: number): boolean {
+    return this.revealed[tileY * this.widthTiles + tileX] === 1;
+  }
+
+  /** Reveals the disc around a tile and returns the tiles it newly revealed, as `[tileX, tileY]` pairs. */
+  revealAround(tileX: number, tileY: number): [number, number][] {
+    const centre = tileY * this.widthTiles + tileX;
+    if (centre === this.lastTile) return [];
+    this.lastTile = centre;
+    const fresh: [number, number][] = [];
+    const radius = this.radiusTiles;
+    for (let dy = -radius; dy <= radius; dy++) {
+      for (let dx = -radius; dx <= radius; dx++) {
+        if (dx * dx + dy * dy > radius * radius) continue;
+        const x = tileX + dx;
+        const y = tileY + dy;
+        if (x < 0 || y < 0 || x >= this.widthTiles || y >= this.heightTiles) continue;
+        const index = y * this.widthTiles + x;
+        if (this.revealed[index] === 1) continue;
+        this.revealed[index] = 1;
+        this.count++;
+        fresh.push([x, y]);
+      }
+    }
+    return fresh;
+  }
+}
