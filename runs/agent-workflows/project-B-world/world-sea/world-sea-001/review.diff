--- /dev/null
+++ b/packages/simulation/src/heading.ts
@@ -0,0 +1,29 @@
+import { HEADING_COUNT } from "@pirate-sea-race/content";
+
+/** Unit vectors are scaled by this: a heading's x and y components are integers in [-1024, 1024]. */
+export const HEADING_SCALE = 1024;
+
+/**
+ * cos(2π·i/64)·1024 rounded, for the first quarter turn (i = 0…16). Written out as data so that no floating-point
+ * transcendental function runs in the simulation; the other three quarters follow by symmetry.
+ */
+const QUARTER_COSINES: readonly number[] = [1024, 1019, 1004, 980, 946, 903, 851, 792, 724, 650, 569, 483, 392, 297, 200, 100, 0];
+
+const QUARTER = HEADING_COUNT / 4;
+
+function cosine(heading: number): number {
+  const turn = normalizeHeading(heading);
+  if (turn <= QUARTER) return QUARTER_COSINES[turn]!;
+  // Subtracting from 0 rather than negating keeps the table free of -0.
+  if (turn <= 2 * QUARTER) return 0 - QUARTER_COSINES[2 * QUARTER - turn]!;
+  if (turn <= 3 * QUARTER) return 0 - QUARTER_COSINES[turn - 2 * QUARTER]!;
+  return QUARTER_COSINES[HEADING_COUNT - turn]!;
+}
+
+/** Heading components: DX[h], DY[h]. Heading 0 is east; y grows down, so headings count clockwise on screen. */
+export const HEADING_DX: readonly number[] = Array.from({ length: HEADING_COUNT }, (_, heading) => cosine(heading));
+export const HEADING_DY: readonly number[] = Array.from({ length: HEADING_COUNT }, (_, heading) => cosine(heading - QUARTER));
+
+export function normalizeHeading(heading: number): number {
+  return ((heading % HEADING_COUNT) + HEADING_COUNT) % HEADING_COUNT;
+}
