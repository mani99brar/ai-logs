+++ b/apps/web/src/camera.ts
@@ -0,0 +1,16 @@
+import { defaultSimulationConfig } from "@pirate-sea-race/simulation";
+
+const { map } = defaultSimulationConfig;
+export const TILE_PIXELS = 16;
+/** The canvas; the map is larger, so the camera follows the player's ship. */
+export const VIEW_WIDTH = 800;
+export const VIEW_HEIGHT = 560;
+
+/** The camera's top-left corner, in whole pixels, that centres a point, kept inside the map. */
+export function followScroll(centreX: number, centreY: number): { x: number; y: number } {
+  const clamp = (value: number, max: number) => Math.max(0, Math.min(max, Math.round(value)));
+  return {
+    x: clamp(centreX - VIEW_WIDTH / 2, map.widthTiles * TILE_PIXELS - VIEW_WIDTH),
+    y: clamp(centreY - VIEW_HEIGHT / 2, map.heightTiles * TILE_PIXELS - VIEW_HEIGHT),
+  };
+}
