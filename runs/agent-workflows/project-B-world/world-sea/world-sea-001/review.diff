diff --git a/packages/content/src/seaMap.ts b/packages/content/src/seaMap.ts
new file mode 100644
index 0000000..49273e2
--- /dev/null
+++ b/packages/content/src/seaMap.ts
@@ -0,0 +1,158 @@
+/**
+ * The sea is a bounded rectangle of tiles laid out like screen coordinates: origin (0,0) at the top-left, x grows
+ * right and y grows down. Every tile is split into a fixed integer number of sub-units, and all positions and speeds
+ * in the simulation are integer sub-units.
+ */
+export const SUB_UNITS_PER_TILE = 256;
+
+/** What a tile is. Sea and docks are navigable; land and shoals stop ships. */
+export const Terrain = {
+  Sea: 0,
+  Land: 1,
+  Shoal: 2,
+  Dock: 3,
+} as const;
+export type Terrain = (typeof Terrain)[keyof typeof Terrain];
+
+/** One character per tile in a map's rows. */
+export const TERRAIN_CHARS: Readonly<Record<string, Terrain>> = {
+  ".": Terrain.Sea,
+  "#": Terrain.Land,
+  "%": Terrain.Shoal,
+  D: Terrain.Dock,
+};
+
+export const ISLAND_THEMES = ["tropical", "volcanic", "ruin", "mist"] as const;
+export type IslandTheme = (typeof ISLAND_THEMES)[number];
+
+/** Eight compass directions, as authored on spawn objects. */
+export const COMPASS = ["E", "SE", "S", "SW", "W", "NW", "N", "NE"] as const;
+export type Compass = (typeof COMPASS)[number];
+
+/** Ship headings are integers in [0, HEADING_COUNT): 0 is east, counting clockwise because y grows down. */
+export const HEADING_COUNT = 64;
+
+export function compassHeading(direction: Compass): number {
+  return COMPASS.indexOf(direction) * (HEADING_COUNT / COMPASS.length);
+}
+
+/** An island as authored: a name, a theme and the tile rectangle holding its land and docks. */
+export interface IslandSource {
+  readonly name: string;
+  readonly theme: IslandTheme;
+  readonly tileX: number;
+  readonly tileY: number;
+  readonly widthTiles: number;
+  readonly heightTiles: number;
+}
+
+/** A prevalidated outer-sea spawn position (§2): the tile whose centre the ship starts on, and its heading. */
+export interface SpawnSlot {
+  readonly tileX: number;
+  readonly tileY: number;
+  readonly facing: Compass;
+}
+
+/** A map as the converter writes it (`scripts/build-map.ts`): rows of terrain characters plus the named objects. */
+export interface SeaMapSource {
+  readonly name: string;
+  readonly widthTiles: number;
+  readonly heightTiles: number;
+  readonly rows: readonly string[];
+  readonly islands: readonly IslandSource[];
+  /** In slot order. */
+  readonly spawnSlots: readonly SpawnSlot[];
+}
+
+/** A dock tile, owned by the island whose rectangle holds it. `side` (N, E, S or W) says where it lies on the island. */
+export interface Dock {
+  readonly id: number;
+  readonly tileX: number;
+  readonly tileY: number;
+  readonly island: number;
+  readonly side: Compass;
+}
+
+/** A decoded map, as the simulation and the client read it. */
+export interface SeaMapDefinition {
+  readonly name: string;
+  readonly widthTiles: number;
+  readonly heightTiles: number;
+  readonly subUnitsPerTile: number;
+  /** Row-major terrain, `widthTiles * heightTiles` entries. */
+  readonly terrain: readonly Terrain[];
+  readonly islands: readonly IslandSource[];
+  /** Row-major order of their tiles. */
+  readonly docks: readonly Dock[];
+  readonly spawnSlots: readonly SpawnSlot[];
+}
+
+/** Decodes a map source. Throws on a structural error (a row of the wrong length, an unknown character). */
+export function createSeaMap(source: SeaMapSource): SeaMapDefinition {
+  if (source.rows.length !== source.heightTiles) {
+    throw new Error(`${source.name}: ${source.rows.length} rows for a height of ${source.heightTiles}`);
+  }
+  const terrain: Terrain[] = [];
+  source.rows.forEach((row, tileY) => {
+    if (row.length !== source.widthTiles) throw new Error(`${source.name}: row ${tileY} has ${row.length} tiles, not ${source.widthTiles}`);
+    for (const char of row) {
+      const kind = TERRAIN_CHARS[char];
+      if (kind === undefined) throw new Error(`${source.name}: unknown terrain "${char}" in row ${tileY}`);
+      terrain.push(kind);
+    }
+  });
+  const docks: Dock[] = [];
+  terrain.forEach((kind, index) => {
+    if (kind !== Terrain.Dock) return;
+    const tileX = index % source.widthTiles;
+    const tileY = Math.floor(index / source.widthTiles);
+    const island = source.islands.findIndex((candidate) => insideIsland(candidate, tileX, tileY));
+    const side = island < 0 ? "N" : sideOf(source.islands[island]!, tileX, tileY);
+    docks.push({ id: docks.length, tileX, tileY, island, side });
+  });
+  return {
+    name: source.name,
+    widthTiles: source.widthTiles,
+    heightTiles: source.heightTiles,
+    subUnitsPerTile: SUB_UNITS_PER_TILE,
+    terrain,
+    islands: source.islands,
+    docks,
+    spawnSlots: source.spawnSlots,
+  };
+}
+
+export function insideIsland(island: IslandSource, tileX: number, tileY: number): boolean {
+  return (
+    tileX >= island.tileX && tileX < island.tileX + island.widthTiles && tileY >= island.tileY && tileY < island.tileY + island.heightTiles
+  );
+}
+
+/** The side of an island a tile lies on (N, E, S or W), from its offset to the island rectangle's centre. */
+function sideOf(island: IslandSource, tileX: number, tileY: number): Compass {
+  // Doubled offsets keep the rectangle's centre on an integer; scaling by the other side's length makes a long thin
+  // island still read its ends as its ends.
+  const dx = (2 * tileX + 1 - (2 * island.tileX + island.widthTiles)) * island.heightTiles;
+  const dy = (2 * tileY + 1 - (2 * island.tileY + island.heightTiles)) * island.widthTiles;
+  if (Math.abs(dx) >= Math.abs(dy)) return dx > 0 ? "E" : "W";
+  return dy > 0 ? "S" : "N";
+}
+
+export function terrainAt(map: SeaMapDefinition, tileX: number, tileY: number): Terrain | undefined {
+  if (tileX < 0 || tileY < 0 || tileX >= map.widthTiles || tileY >= map.heightTiles) return undefined;
+  return map.terrain[tileY * map.widthTiles + tileX];
+}
+
+/** Ships sail on sea and docks. Anything outside the map counts as blocked. */
+export function isNavigable(map: SeaMapDefinition, tileX: number, tileY: number): boolean {
+  const kind = terrainAt(map, tileX, tileY);
+  return kind === Terrain.Sea || kind === Terrain.Dock;
+}
+
+/** A readable name for a dock, for the HUD: "Palm Key, south dock". */
+export function dockLabel(map: SeaMapDefinition, dockId: number): string {
+  const dock = map.docks[dockId];
+  if (dock === undefined) return "";
+  const names: Record<Compass, string> = { E: "east", SE: "south-east", S: "south", SW: "south-west", W: "west", NW: "north-west", N: "north", NE: "north-east" };
+  return `${map.islands[dock.island]?.name ?? "?"}, ${names[dock.side]} dock`;
+}
diff --git a/packages/content/src/seaValidation.ts b/packages/content/src/seaValidation.ts
new file mode 100644
index 0000000..0dd82ff
--- /dev/null
+++ b/packages/content/src/seaValidation.ts
@@ -0,0 +1,293 @@
+import { privateMatch, rulesPresets, type ValidationResult } from "./rules.js";
+import {
+  ENGAGEMENT_RANGE_TILES,
+  SIGHT_RADIUS_TILES,
+  travelTargets,
+  WORLD_STEPS_PER_SECOND,
+  type ShipTuning,
+} from "./sailing.js";
+import { insideIsland, isNavigable, Terrain, terrainAt, type SeaMapDefinition } from "./seaMap.js";
+
+/** Octile path costs in sub-units per tile: straight 256, diagonal 256·√2 rounded. */
+const STRAIGHT_COST = 256;
+const DIAGONAL_COST = 362;
+const UNREACHABLE = Number.MAX_SAFE_INTEGER;
+
+/** No island rectangle may be larger than this many tiles on a side: the slice's islands are small (§18). */
+export const MAX_ISLAND_SIDE_TILES = 16;
+
+/**
+ * Shortest sea-path cost in sub-units from one tile to every tile, over navigable tiles, moving in eight directions.
+ * A diagonal step needs both tiles beside it free, since a hull cannot squeeze between two blocked corners.
+ */
+export function seaPathCosts(map: SeaMapDefinition, fromX: number, fromY: number): Float64Array {
+  const width = map.widthTiles;
+  const costs = new Float64Array(width * map.heightTiles).fill(UNREACHABLE);
+  if (!isNavigable(map, fromX, fromY)) return costs;
+  const heap = new MinHeap();
+  const start = fromY * width + fromX;
+  costs[start] = 0;
+  heap.push(0, start);
+  while (heap.size > 0) {
+    const [cost, index] = heap.pop();
+    if (cost > costs[index]!) continue;
+    const x = index % width;
+    const y = (index - x) / width;
+    for (let dy = -1; dy <= 1; dy++) {
+      for (let dx = -1; dx <= 1; dx++) {
+        if (dx === 0 && dy === 0) continue;
+        const nx = x + dx;
+        const ny = y + dy;
+        if (!isNavigable(map, nx, ny)) continue;
+        const diagonal = dx !== 0 && dy !== 0;
+        if (diagonal && (!isNavigable(map, x + dx, y) || !isNavigable(map, x, y + dy))) continue;
+        const next = cost + (diagonal ? DIAGONAL_COST : STRAIGHT_COST);
+        const target = ny * width + nx;
+        if (next < costs[target]!) {
+          costs[target] = next;
+          heap.push(next, target);
+        }
+      }
+    }
+  }
+  return costs;
+}
+
+/** Seconds at full speed for a path cost, rounded down to milliseconds. */
+export function travelSeconds(cost: number, tuning: ShipTuning): number {
+  return Math.floor((cost * 1000) / (tuning.maxSpeed * WORLD_STEPS_PER_SECOND)) / 1000;
+}
+
+export interface PointOfInterest {
+  readonly label: string;
+  readonly tileX: number;
+  readonly tileY: number;
+}
+
+export interface SeaMapReport {
+  /** Each island's nearest other island by sea, dock to dock. */
+  readonly nearestIsland: readonly { island: string; nearest: string; seconds: number }[];
+  /** The longest shortest trip between any two docks or spawn slots. */
+  readonly longestCrossing: { from: string; to: string; seconds: number };
+  /** Each spawn slot's nearest dock. */
+  readonly firstDock: readonly { slot: number; dock: string; seconds: number }[];
+}
+
+export interface SeaMapRules {
+  readonly islands: number;
+  readonly spawnSlots: number;
+}
+
+export const sliceSeaRules: SeaMapRules = { islands: rulesPresets.slice.islands, spawnSlots: privateMatch.maxPlayers };
+
+/**
+ * Checks a map against §2 and §3: four small islands, each with a dock; shoals; eight outer-sea spawn slots out of
+ * each other's engagement range; every dock and slot reachable by sea; neighbouring islands 20–40 s apart and no
+ * useful crossing over 90 s at full speed; and a dock within 40 s of every slot.
+ */
+export function validateSeaMap(map: SeaMapDefinition, tuning: ShipTuning, rules: SeaMapRules = sliceSeaRules): ValidationResult<SeaMapReport> {
+  const issues: string[] = [];
+  const { islands, docks, spawnSlots } = map;
+  const tileCentre = Math.floor(map.subUnitsPerTile / 2);
+
+  if (tuning.hullHalfSize >= tileCentre) issues.push(`ship hull half-size ${tuning.hullHalfSize} does not fit inside one tile`);
+  if (SIGHT_RADIUS_TILES <= ENGAGEMENT_RANGE_TILES) issues.push("the sight radius must be larger than the engagement range");
+
+  if (islands.length !== rules.islands) issues.push(`${islands.length} islands, not ${rules.islands}`);
+  islands.forEach((island, index) => {
+    if (island.widthTiles > MAX_ISLAND_SIDE_TILES || island.heightTiles > MAX_ISLAND_SIDE_TILES) {
+      issues.push(`${island.name}: ${island.widthTiles} × ${island.heightTiles} tiles is not a small island`);
+    }
+    if (island.tileX < 0 || island.tileY < 0 || island.tileX + island.widthTiles > map.widthTiles || island.tileY + island.heightTiles > map.heightTiles) {
+      issues.push(`${island.name}: outside the map`);
+    }
+    for (const other of islands.slice(index + 1)) {
+      const apart =
+        island.tileX + island.widthTiles <= other.tileX ||
+        other.tileX + other.widthTiles <= island.tileX ||
+        island.tileY + island.heightTiles <= other.tileY ||
+        other.tileY + other.heightTiles <= island.tileY;
+      if (!apart) issues.push(`${island.name} and ${other.name} overlap`);
+    }
+    if (!docks.some((dock) => dock.island === index)) issues.push(`${island.name}: no dock`);
+  });
+
+  let landTiles = 0;
+  let shoalTiles = 0;
+  for (let tileY = 0; tileY < map.heightTiles; tileY++) {
+    for (let tileX = 0; tileX < map.widthTiles; tileX++) {
+      const kind = terrainAt(map, tileX, tileY);
+      if (kind === Terrain.Shoal) shoalTiles++;
+      if (kind !== Terrain.Land) continue;
+      landTiles++;
+      const owners = islands.filter((island) => insideIsland(island, tileX, tileY)).length;
+      if (owners !== 1) issues.push(`land at ${tileX},${tileY} lies in ${owners} island rectangles, not one`);
+    }
+  }
+  if (landTiles === 0) issues.push("no land");
+  if (shoalTiles === 0) issues.push("no shoals");
+
+  const neighbours = (tileX: number, tileY: number) => [
+    [tileX + 1, tileY],
+    [tileX - 1, tileY],
+    [tileX, tileY + 1],
+    [tileX, tileY - 1],
+  ] as const;
+  for (const dock of docks) {
+    const where = `dock at ${dock.tileX},${dock.tileY}`;
+    const island = islands[dock.island];
+    if (island === undefined) {
+      issues.push(`${where}: outside every island rectangle`);
+      continue;
+    }
+    const touches = (kind: Terrain) =>
+      neighbours(dock.tileX, dock.tileY).some(([x, y]) => terrainAt(map, x, y) === kind && (kind !== Terrain.Land || insideIsland(island, x, y)));
+    if (!touches(Terrain.Land)) issues.push(`${where}: not beside ${island.name}'s land`);
+    if (!touches(Terrain.Sea)) issues.push(`${where}: no open sea beside it`);
+  }
+
+  if (spawnSlots.length !== rules.spawnSlots) issues.push(`${spawnSlots.length} spawn slots, not ${rules.spawnSlots}`);
+  const archipelago = boundsOf(islands);
+  spawnSlots.forEach((slot, index) => {
+    const where = `spawn slot ${index} at ${slot.tileX},${slot.tileY}`;
+    if (terrainAt(map, slot.tileX, slot.tileY) !== Terrain.Sea) issues.push(`${where}: not on open sea`);
+    if (
+      archipelago !== undefined &&
+      slot.tileX >= archipelago.minX &&
+      slot.tileX <= archipelago.maxX &&
+      slot.tileY >= archipelago.minY &&
+      slot.tileY <= archipelago.maxY
+    ) {
+      issues.push(`${where}: inside the archipelago, not on the outer sea`);
+    }
+    spawnSlots.slice(index + 1).forEach((other, offset) => {
+      const dx = other.tileX - slot.tileX;
+      const dy = other.tileY - slot.tileY;
+      if (dx * dx + dy * dy <= ENGAGEMENT_RANGE_TILES * ENGAGEMENT_RANGE_TILES) {
+        issues.push(`${where}: within engagement range of slot ${index + 1 + offset}`);
+      }
+    });
+  });
+  if (issues.length > 0) return { ok: false, issues };
+
+  // Travel: one shortest-path search from every dock and spawn slot.
+  const points: PointOfInterest[] = [
+    ...docks.map((dock) => ({ label: `${islands[dock.island]!.name} ${dock.side} dock`, tileX: dock.tileX, tileY: dock.tileY })),
+    ...spawnSlots.map((slot, index) => ({ label: `spawn slot ${index}`, tileX: slot.tileX, tileY: slot.tileY })),
+  ];
+  const costs = points.map((point) => seaPathCosts(map, point.tileX, point.tileY));
+  const between = (from: number, to: number) => costs[from]![points[to]!.tileY * map.widthTiles + points[to]!.tileX]!;
+
+  const origin = docks.length;
+  points.forEach((point, index) => {
+    if (between(origin, index) === UNREACHABLE) issues.push(`${point.label} at ${point.tileX},${point.tileY}: not reachable by sea from spawn slot 0`);
+  });
+  if (issues.length > 0) return { ok: false, issues };
+
+  const nearestIsland = islands.map((island, index) => {
+    let best = { nearest: "", cost: UNREACHABLE };
+    docks.forEach((from, fromIndex) => {
+      if (from.island !== index) return;
+      docks.forEach((to, toIndex) => {
+        if (to.island === index) return;
+        const cost = between(fromIndex, toIndex);
+        if (cost < best.cost) best = { nearest: islands[to.island]!.name, cost };
+      });
+    });
+    return { island: island.name, nearest: best.nearest, seconds: travelSeconds(best.cost, tuning) };
+  });
+  for (const entry of nearestIsland) {
+    if (entry.seconds < travelTargets.neighbourIslandMinSeconds || entry.seconds > travelTargets.neighbourIslandMaxSeconds) {
+      issues.push(
+        `${entry.island}: its nearest island, ${entry.nearest}, is ${entry.seconds} s away, outside ${travelTargets.neighbourIslandMinSeconds}–${travelTargets.neighbourIslandMaxSeconds} s`,
+      );
+    }
+  }
+
+  let longest = { from: "", to: "", cost: 0 };
+  points.forEach((from, fromIndex) => {
+    points.forEach((to, toIndex) => {
+      const cost = between(fromIndex, toIndex);
+      if (cost > longest.cost) longest = { from: from.label, to: to.label, cost };
+    });
+  });
+  const longestCrossing = { from: longest.from, to: longest.to, seconds: travelSeconds(longest.cost, tuning) };
+  if (longestCrossing.seconds > travelTargets.longestCrossingMaxSeconds) {
+    issues.push(`the crossing from ${longest.from} to ${longest.to} takes ${longestCrossing.seconds} s, over ${travelTargets.longestCrossingMaxSeconds} s`);
+  }
+
+  const firstDock = spawnSlots.map((_, slot) => {
+    let best = { dock: "", cost: UNREACHABLE };
+    docks.forEach((_, dockIndex) => {
+      const cost = between(origin + slot, dockIndex);
+      if (cost < best.cost) best = { dock: points[dockIndex]!.label, cost };
+    });
+    return { slot, dock: best.dock, seconds: travelSeconds(best.cost, tuning) };
+  });
+  for (const entry of firstDock) {
+    if (entry.seconds > travelTargets.firstDockMaxSeconds) {
+      issues.push(`spawn slot ${entry.slot}: the nearest dock is ${entry.seconds} s away, over ${travelTargets.firstDockMaxSeconds} s`);
+    }
+  }
+
+  return issues.length > 0 ? { ok: false, issues } : { ok: true, value: { nearestIsland, longestCrossing, firstDock } };
+}
+
+function boundsOf(islands: SeaMapDefinition["islands"]) {
+  if (islands.length === 0) return undefined;
+  return {
+    minX: Math.min(...islands.map((island) => island.tileX)),
+    minY: Math.min(...islands.map((island) => island.tileY)),
+    maxX: Math.max(...islands.map((island) => island.tileX + island.widthTiles - 1)),
+    maxY: Math.max(...islands.map((island) => island.tileY + island.heightTiles - 1)),
+  };
+}
+
+/** A binary min-heap of (cost, index) pairs for the path search. */
+class MinHeap {
+  private readonly costs: number[] = [];
+  private readonly indexes: number[] = [];
+
+  get size(): number {
+    return this.costs.length;
+  }
+
+  push(cost: number, index: number): void {
+    this.costs.push(cost);
+    this.indexes.push(index);
+    let child = this.costs.length - 1;
+    while (child > 0) {
+      const parent = (child - 1) >> 1;
+      if (this.costs[parent]! <= cost) break;
+      this.swap(child, parent);
+      child = parent;
+    }
+  }
+
+  pop(): [number, number] {
+    const top: [number, number] = [this.costs[0]!, this.indexes[0]!];
+    const lastCost = this.costs.pop()!;
+    const lastIndex = this.indexes.pop()!;
+    if (this.costs.length > 0) {
+      this.costs[0] = lastCost;
+      this.indexes[0] = lastIndex;
+      let parent = 0;
+      for (;;) {
+        const left = 2 * parent + 1;
+        const right = left + 1;
+        let smallest = parent;
+        if (left < this.costs.length && this.costs[left]! < this.costs[smallest]!) smallest = left;
+        if (right < this.costs.length && this.costs[right]! < this.costs[smallest]!) smallest = right;
+        if (smallest === parent) break;
+        this.swap(parent, smallest);
+        parent = smallest;
+      }
+    }
+    return top;
+  }
+
+  private swap(a: number, b: number): void {
+    [this.costs[a], this.costs[b]] = [this.costs[b]!, this.costs[a]!];
+    [this.indexes[a], this.indexes[b]] = [this.indexes[b]!, this.indexes[a]!];
+  }
+}
diff --git a/packages/content/src/tiledMap.ts b/packages/content/src/tiledMap.ts
new file mode 100644
index 0000000..6ec39b2
--- /dev/null
+++ b/packages/content/src/tiledMap.ts
@@ -0,0 +1,219 @@
+import { z } from "zod";
+import { formatIssues, type ValidationResult } from "./rules.js";
+import {
+  COMPASS,
+  ISLAND_THEMES,
+  Terrain,
+  TERRAIN_CHARS,
+  type IslandSource,
+  type SeaMapSource,
+  type SpawnSlot,
+} from "./seaMap.js";
+
+/**
+ * The subset of Tiled's JSON map format (`.tmj`) that sea maps use. Anything outside it is refused, so a map that
+ * relies on a feature the converter ignores cannot slip through.
+ *
+ * - An orthogonal, finite map of 16 × 16 pixel tiles.
+ * - One embedded tileset with `firstgid` 1 whose tiles each carry a `type` naming their terrain: `sea`, `land`,
+ *   `shoal` or `dock`.
+ * - A tile layer named `terrain` with its data as a plain array of global tile ids (Tiled's CSV encoding), no empty
+ *   cells and no flip flags.
+ * - An object layer named `objects` holding:
+ *   - one rectangle of type `island` per island, named, with a string property `theme` (`tropical`, `volcanic`,
+ *     `ruin` or `mist`), on tile boundaries, covering the island's land and docks;
+ *   - one point of type `spawn` per spawn slot, with an int property `slot` (0 upwards, no gaps) and a string
+ *     property `facing` (a compass direction such as `NE`).
+ *
+ * Other layers, properties and object types are errors. Tiled keeps extra editor fields (`version`, `nextobjectid`,
+ * `editorsettings` and so on); the schema ignores those.
+ */
+export const TILE_PIXELS = 16;
+
+const TERRAIN_TYPES = { sea: Terrain.Sea, land: Terrain.Land, shoal: Terrain.Shoal, dock: Terrain.Dock } as const;
+
+const propertySchema = z.discriminatedUnion("type", [
+  z.object({ name: z.string(), type: z.literal("string"), value: z.string() }),
+  z.object({ name: z.string(), type: z.literal("int"), value: z.int() }),
+]);
+
+const tilesetSchema = z.object({
+  firstgid: z.literal(1),
+  name: z.string(),
+  tilewidth: z.literal(TILE_PIXELS),
+  tileheight: z.literal(TILE_PIXELS),
+  tilecount: z.int().positive(),
+  tiles: z.array(z.object({ id: z.int().nonnegative(), type: z.enum(["sea", "land", "shoal", "dock"]) })),
+});
+
+const tileLayerSchema = z.object({
+  type: z.literal("tilelayer"),
+  name: z.literal("terrain"),
+  width: z.int().positive(),
+  height: z.int().positive(),
+  x: z.literal(0),
+  y: z.literal(0),
+  encoding: z.literal("csv").optional(),
+  compression: z.undefined().optional(),
+  data: z.array(z.int().positive()),
+});
+
+const objectSchema = z.object({
+  id: z.int(),
+  name: z.string(),
+  type: z.enum(["island", "spawn"]),
+  x: z.number(),
+  y: z.number(),
+  width: z.number().nonnegative(),
+  height: z.number().nonnegative(),
+  rotation: z.literal(0).optional(),
+  point: z.boolean().optional(),
+  properties: z.array(propertySchema).optional(),
+});
+
+const objectLayerSchema = z.object({
+  type: z.literal("objectgroup"),
+  name: z.literal("objects"),
+  objects: z.array(objectSchema),
+});
+
+export const tiledMapSchema = z.object({
+  type: z.literal("map"),
+  orientation: z.literal("orthogonal"),
+  infinite: z.literal(false),
+  width: z.int().positive(),
+  height: z.int().positive(),
+  tilewidth: z.literal(TILE_PIXELS),
+  tileheight: z.literal(TILE_PIXELS),
+  tilesets: z.tuple([tilesetSchema]),
+  layers: z.tuple([tileLayerSchema, objectLayerSchema]),
+});
+
+export type TiledMap = z.infer<typeof tiledMapSchema>;
+type TiledObject = z.infer<typeof objectSchema>;
+
+const CHAR_BY_TERRAIN: Readonly<Record<Terrain, string>> = Object.fromEntries(
+  Object.entries(TERRAIN_CHARS).map(([char, kind]) => [kind, char]),
+) as Record<Terrain, string>;
+
+const OBJECT_PROPERTIES: Readonly<Record<TiledObject["type"], readonly string[]>> = { island: ["theme"], spawn: ["slot", "facing"] };
+
+function property(object: TiledObject, name: string): string | number | undefined {
+  return object.properties?.find((entry) => entry.name === name)?.value;
+}
+
+/** Converts a parsed `.tmj` into the map source the content module holds. Refuses anything outside the subset. */
+export function convertTiledMap(name: string, candidate: unknown): ValidationResult<SeaMapSource> {
+  const parsed = tiledMapSchema.safeParse(candidate);
+  if (!parsed.success) return { ok: false, issues: formatIssues(parsed.error) };
+  const map = parsed.data;
+  const [tileset] = map.tilesets;
+  const [terrainLayer, objectLayer] = map.layers;
+  const issues: string[] = [];
+
+  const terrainByGid = new Map<number, Terrain>();
+  for (const tile of tileset.tiles) {
+    if (tile.id >= tileset.tilecount) issues.push(`tileset: tile ${tile.id} is beyond its ${tileset.tilecount} tiles`);
+    terrainByGid.set(tileset.firstgid + tile.id, TERRAIN_TYPES[tile.type]);
+  }
+  if (terrainLayer.width !== map.width || terrainLayer.height !== map.height) {
+    issues.push(`terrain: layer is ${terrainLayer.width} × ${terrainLayer.height}, map is ${map.width} × ${map.height}`);
+  }
+  if (terrainLayer.data.length !== map.width * map.height) {
+    issues.push(`terrain: ${terrainLayer.data.length} tiles for a ${map.width} × ${map.height} map`);
+  }
+  const rows: string[] = [];
+  for (let tileY = 0; tileY < map.height && issues.length === 0; tileY++) {
+    let row = "";
+    for (let tileX = 0; tileX < map.width; tileX++) {
+      const gid = terrainLayer.data[tileY * map.width + tileX]!;
+      const kind = terrainByGid.get(gid);
+      if (kind === undefined) {
+        issues.push(`terrain: tile ${tileX},${tileY} has gid ${gid}, which has no terrain type`);
+        break;
+      }
+      row += CHAR_BY_TERRAIN[kind];
+    }
+    rows.push(row);
+  }
+
+  const islands: IslandSource[] = [];
+  const spawns: { slot: number; spawn: SpawnSlot }[] = [];
+  for (const object of objectLayer.objects) {
+    const where = `object ${object.id} (${object.type} "${object.name}")`;
+    const allowed = OBJECT_PROPERTIES[object.type];
+    for (const entry of object.properties ?? []) {
+      if (!allowed.includes(entry.name)) issues.push(`${where}: unknown property "${entry.name}"`);
+    }
+    if (object.type === "island") {
+      const theme = property(object, "theme");
+      const onGrid = [object.x, object.y, object.width, object.height].every((value) => Number.isInteger(value / TILE_PIXELS));
+      if (object.point === true || !onGrid || object.width === 0 || object.height === 0) {
+        issues.push(`${where}: an island is a rectangle on tile boundaries`);
+      } else if (object.name === "") {
+        issues.push(`${where}: an island needs a name`);
+      } else if (!ISLAND_THEMES.includes(theme as never)) {
+        issues.push(`${where}: theme must be one of ${ISLAND_THEMES.join(", ")}`);
+      } else {
+        islands.push({
+          name: object.name,
+          theme: theme as IslandSource["theme"],
+          tileX: object.x / TILE_PIXELS,
+          tileY: object.y / TILE_PIXELS,
+          widthTiles: object.width / TILE_PIXELS,
+          heightTiles: object.height / TILE_PIXELS,
+        });
+      }
+      continue;
+    }
+    const slot = property(object, "slot");
+    const facing = property(object, "facing");
+    if (object.point !== true) issues.push(`${where}: a spawn is a point`);
+    else if (typeof slot !== "number" || slot < 0) issues.push(`${where}: slot must be a non-negative int`);
+    else if (!COMPASS.includes(facing as never)) issues.push(`${where}: facing must be one of ${COMPASS.join(", ")}`);
+    else {
+      spawns.push({
+        slot,
+        spawn: { tileX: Math.floor(object.x / TILE_PIXELS), tileY: Math.floor(object.y / TILE_PIXELS), facing: facing as SpawnSlot["facing"] },
+      });
+    }
+  }
+  spawns.sort((a, b) => a.slot - b.slot);
+  // Checked only when every spawn object was readable, so one bad object reports once.
+  if (issues.length === 0 && spawns.some((entry, index) => entry.slot !== index)) {
+    issues.push(`spawns: slots must run 0, 1, 2… without gaps or repeats (found ${spawns.map((entry) => entry.slot).join(", ")})`);
+  }
+  if (issues.length > 0) return { ok: false, issues };
+  return {
+    ok: true,
+    value: { name, widthTiles: map.width, heightTiles: map.height, rows, islands, spawnSlots: spawns.map((entry) => entry.spawn) },
+  };
+}
+
+/** The TypeScript module `scripts/build-map.ts` writes for a converted map. Deterministic, so a drift test can compare. */
+export function formatSeaMapModule(source: SeaMapSource, exportName: string, sourcePath: string): string {
+  const island = (entry: IslandSource) =>
+    `    { name: ${JSON.stringify(entry.name)}, theme: ${JSON.stringify(entry.theme)}, tileX: ${entry.tileX}, tileY: ${entry.tileY}, widthTiles: ${entry.widthTiles}, heightTiles: ${entry.heightTiles} },`;
+  const spawn = (entry: SpawnSlot) => `    { tileX: ${entry.tileX}, tileY: ${entry.tileY}, facing: ${JSON.stringify(entry.facing)} },`;
+  return [
+    `// Generated by scripts/build-map.ts from ${sourcePath}. Do not edit: change the map in Tiled, then run`,
+    "// `npm run map:build`. A unit test fails when this file is out of date with the map.",
+    'import type { SeaMapSource } from "../seaMap.js";',
+    "",
+    `export const ${exportName}: SeaMapSource = {`,
+    `  name: ${JSON.stringify(source.name)},`,
+    `  widthTiles: ${source.widthTiles},`,
+    `  heightTiles: ${source.heightTiles},`,
+    "  rows: [",
+    ...source.rows.map((row) => `    ${JSON.stringify(row)},`),
+    "  ],",
+    "  islands: [",
+    ...source.islands.map(island),
+    "  ],",
+    "  spawnSlots: [",
+    ...source.spawnSlots.map(spawn),
+    "  ],",
+    "};",
+    "",
+  ].join("\n");
+}
