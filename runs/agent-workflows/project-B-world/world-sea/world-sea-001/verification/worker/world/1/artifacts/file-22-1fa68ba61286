import { describe, expect, it } from "vitest";
import {
  baselineFrameBudgets,
  rulesPresets,
  validateFrameBudgets,
  validateMoveTiming,
  validateRulesPreset,
} from "./index.js";

describe("rules presets", () => {
  it("keeps the slice and alpha differences from §18", () => {
    expect(rulesPresets.slice).toMatchObject({ rubbingTypes: 2, rubbings: 8, islands: 4 });
    expect(rulesPresets.alpha).toMatchObject({ rubbingTypes: 4, rubbings: 12, islands: 12 });
  });

  it("accepts both presets", () => {
    expect(validateRulesPreset(rulesPresets.slice).ok).toBe(true);
    expect(validateRulesPreset(rulesPresets.alpha).ok).toBe(true);
  });

  it("rejects a preset whose islands cannot supply its rubbings", () => {
    const result = validateRulesPreset({ ...rulesPresets.slice, rubbings: 9 });
    expect(result.ok).toBe(false);
  });

  it("rejects an unknown preset id and extra fields", () => {
    expect(validateRulesPreset({ ...rulesPresets.alpha, id: "beta" }).ok).toBe(false);
    expect(validateRulesPreset({ ...rulesPresets.alpha, cheat: true }).ok).toBe(false);
  });
});

describe("baseline frame budgets", () => {
  it("holds §8's table as typed data", () => {
    const byId = Object.fromEntries(baselineFrameBudgets.map((move) => [move.id, move]));
    expect(byId["jab"]).toMatchObject({ startup: 7, active: 3, recovery: 12, onBlock: { kind: "frames", advantage: -2 } });
    expect(byId["heavy-mid"]).toMatchObject({ startup: 18, active: 4, recovery: 24, onBlock: { kind: "frames", advantage: -12 } });
    expect(byId["low-sweep"]).toMatchObject({ startup: 20, active: 3, recovery: 26, onBlock: { kind: "frames", advantage: -15 } });
    expect(byId["projectile-special"]).toMatchObject({ startup: 22, active: "projectile-life", recovery: 30, onBlock: { kind: "spacing-dependent" } });
    expect(byId["throw"]).toMatchObject({ startup: 12, active: 2, recovery: 24, onBlock: { kind: "unguardable" } });
    expect(baselineFrameBudgets).toHaveLength(5);
  });

  it("accepts the baseline table", () => {
    expect(validateFrameBudgets(baselineFrameBudgets)).toEqual({ ok: true, value: baselineFrameBudgets });
  });

  const jab = baselineFrameBudgets[0];

  it.each([
    ["zero startup", { ...jab, startup: 0 }],
    ["negative startup", { ...jab, startup: -3 }],
    ["zero active frames", { ...jab, active: 0 }],
    ["negative active frames", { ...jab, active: -1 }],
    ["fractional startup", { ...jab, startup: 6.5 }],
    ["negative recovery", { ...jab, recovery: -1 }],
    ["more minus on block than active + recovery", { ...jab, onBlock: { kind: "frames", advantage: -16 } }],
    ["an unknown on-block kind", { ...jab, onBlock: { kind: "sometimes" } }],
  ])("rejects %s", (_label, move) => {
    const result = validateMoveTiming(move);
    expect(result.ok).toBe(false);
    if (!result.ok) expect(result.issues.length).toBeGreaterThan(0);
  });

  it("rejects a table that uses an id twice", () => {
    expect(validateFrameBudgets([jab, jab]).ok).toBe(false);
  });
});
