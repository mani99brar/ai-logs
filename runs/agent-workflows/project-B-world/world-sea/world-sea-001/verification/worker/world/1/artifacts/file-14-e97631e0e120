import { INTERPOLATION_DELAY_MS, SnapshotBuffer } from "./interpolation.js";

/** A ship as the server last sent it: only the client's own ship and ships in its sight ever arrive (§16). */
export interface ShipSnapshot {
  readonly id: string;
  readonly slot: number;
  readonly x: number;
  readonly y: number;
  readonly heading: number;
  readonly speed: number;
  /** The dock it is moored at, or -1 at sea. */
  readonly dock: number;
}

/** Placeholder ship colours by spawn slot. */
const SLOT_COLORS = [0xf4b942, 0xe5484d, 0x46a758, 0xb66ee8, 0xf76b15, 0x3dd6d0, 0xf2f2f2, 0xd6409f] as const;

export function slotColor(slot: number): number {
  return SLOT_COLORS[slot % SLOT_COLORS.length]!;
}

export function cssColor(color: number): string {
  return `#${color.toString(16).padStart(6, "0")}`;
}

/**
 * The client's picture of the match: the latest decoded server state of each visible ship (for the HUD) and a
 * snapshot history per ship (for interpolated drawing). A ship that leaves the decoded state is forgotten at once.
 */
export class MatchView {
  private readonly latest = new Map<string, ShipSnapshot>();
  private readonly buffers = new Map<string, SnapshotBuffer>();

  constructor(readonly selfId: string) {}

  ingest(ships: Iterable<ShipSnapshot>, now: number): void {
    const seen = new Set<string>();
    for (const ship of ships) {
      seen.add(ship.id);
      const { id, slot, x, y, heading, speed, dock } = ship;
      this.latest.set(id, { id, slot, x, y, heading, speed, dock });
      let buffer = this.buffers.get(id);
      if (buffer === undefined) this.buffers.set(id, (buffer = new SnapshotBuffer()));
      buffer.push(now, x, y);
    }
    for (const id of [...this.latest.keys()]) {
      if (seen.has(id)) continue;
      this.latest.delete(id);
      this.buffers.delete(id);
    }
  }

  ships(): ShipSnapshot[] {
    return [...this.latest.values()];
  }

  ship(id: string): ShipSnapshot | undefined {
    return this.latest.get(id);
  }

  /** Where to draw a ship at `now`, interpolated INTERPOLATION_DELAY_MS in the past. */
  renderPosition(id: string, now: number): { x: number; y: number } | undefined {
    return this.buffers.get(id)?.sample(now - INTERPOLATION_DELAY_MS);
  }
}
