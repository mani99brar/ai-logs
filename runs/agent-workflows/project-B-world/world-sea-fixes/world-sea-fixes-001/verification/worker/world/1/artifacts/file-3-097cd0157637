import { TEST_PLACEMENT_ENV } from "@pirate-sea-race/protocol";
import { DEFAULT_PORT, startGameServer } from "./server.js";

/**
 * The development and test entry point (`npm run dev`, and `start:source` for the browser tests). Unlike the
 * production entry (`main.ts`), it reads the test-placement setting: PIRATE_SEA_RACE_TEST_PLACEMENT=1 turns on the
 * route that puts ships on chosen tiles. It is off unless that variable is set.
 */
const port = Number(process.env["PORT"] ?? DEFAULT_PORT);
const testPlacement = process.env[TEST_PLACEMENT_ENV] === "1";
const running = await startGameServer({ port, testPlacement });
console.log(`Pirate Sea Race server listening on ws://localhost:${running.port}${testPlacement ? " (test placement on)" : ""}`);
