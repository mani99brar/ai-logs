import { describe, expect, it } from "vitest";
import { HEADING_COUNT } from "@pirate-sea-race/content";
import { PLACEMENT_HEADING_COUNT, testPlacementSchema } from "@pirate-sea-race/protocol";

// The protocol cannot import content, so the server, which reads both, checks that they agree on the headings.
describe("test placement headings", () => {
  const placement = { code: "K7Q2MX", sessionId: "abc123", tileX: 100, tileY: 76 };
  const accepts = (heading: number) => testPlacementSchema.safeParse({ ...placement, heading }).success;

  it("accepts exactly the simulation's headings, [0, HEADING_COUNT)", () => {
    expect(PLACEMENT_HEADING_COUNT).toBe(HEADING_COUNT);
    expect(accepts(0)).toBe(true);
    expect(accepts(HEADING_COUNT - 1)).toBe(true);
    expect(accepts(HEADING_COUNT)).toBe(false);
    expect(accepts(-1)).toBe(false);
  });
});
