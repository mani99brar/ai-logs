{
  "name": "@pirate-sea-race/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@colyseus/schema": "5.0.34",
    "@pirate-sea-race/content": "0.0.0",
    "@pirate-sea-race/protocol": "0.0.0",
    "@pirate-sea-race/simulation": "0.0.0",
    "colyseus": "0.18.8"
  },
  "description": "The authoritative Colyseus match server (§14)",
  "exports": {
    ".": {
      "@pirate-sea-race/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "@pirate-sea-race/source": "./src/schema.ts",
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=@pirate-sea-race/source src/dev.ts",
    "start:source": "tsx --conditions=@pirate-sea-race/source src/dev.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  }
}
