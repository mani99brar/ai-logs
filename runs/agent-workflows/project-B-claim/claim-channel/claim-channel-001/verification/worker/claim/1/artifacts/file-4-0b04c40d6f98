import { z } from "zod";
import { formatIssues, type ValidationResult } from "../rules.js";
import { WORLD_STEPS_PER_SECOND } from "../sailing.js";

/** §5: a claim completes after holding interact this long. 0 would model §5's alternative, victory on arrival. */
export const CLAIM_CHANNEL_SECONDS = 10;
/** §2: the match stops 35 minutes after player control starts. */
export const MATCH_DURATION_MINUTES = 35;
/**
 * §5's treasure circle around the final island's claim point, centre to centre. A placeholder until playtests: wider
 * than a docking run (1.5 tiles), narrower than the engagement range (6 tiles), so a challenger can reach a claimer.
 */
export const TREASURE_CIRCLE_RADIUS_TILES = 4;

/** The claim rules (§2, §5) in world ticks (20 a second) and tiles; the simulation converts tiles to sub-units. */
export const claimRulesSchema = z
  .strictObject({
    /** World ticks of held interact that complete a claim; 0 completes it on the tick it starts. */
    channelTicks: z.int().nonnegative(),
    /** World ticks from player control to the match deadline. */
    deadlineTicks: z.int().positive(),
    circleRadiusTiles: z.int().positive(),
  })
  .superRefine((rules, ctx) => {
    if (rules.channelTicks >= rules.deadlineTicks) {
      ctx.addIssue({
        code: "custom",
        path: ["channelTicks"],
        message: `a channel of ${rules.channelTicks} ticks cannot complete before the deadline (${rules.deadlineTicks} ticks)`,
      });
    }
  });

export type ClaimRules = z.infer<typeof claimRulesSchema>;

export const claimRules: ClaimRules = {
  channelTicks: CLAIM_CHANNEL_SECONDS * WORLD_STEPS_PER_SECOND,
  deadlineTicks: MATCH_DURATION_MINUTES * 60 * WORLD_STEPS_PER_SECOND,
  circleRadiusTiles: TREASURE_CIRCLE_RADIUS_TILES,
};

export function validateClaimRules(candidate: unknown): ValidationResult<ClaimRules> {
  const parsed = claimRulesSchema.safeParse(candidate);
  return parsed.success ? { ok: true, value: parsed.data } : { ok: false, issues: formatIssues(parsed.error) };
}
