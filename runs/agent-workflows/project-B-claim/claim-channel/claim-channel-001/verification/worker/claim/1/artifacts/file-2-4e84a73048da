import { describe, expect, it } from "vitest";
import { ENGAGEMENT_RANGE_TILES, WORLD_STEPS_PER_SECOND } from "../sailing.js";
import { claimRules, TREASURE_CIRCLE_RADIUS_TILES, validateClaimRules } from "./index.js";

function issuesOf(candidate: unknown): string[] {
  const result = validateClaimRules(candidate);
  return result.ok ? [] : result.issues;
}

describe("claim rules (§2, §5)", () => {
  it("channel for ten seconds and stop the match at minute 35, in world ticks", () => {
    expect(WORLD_STEPS_PER_SECOND).toBe(20);
    expect(claimRules.channelTicks).toBe(200);
    expect(claimRules.deadlineTicks).toBe(42_000);
    expect(claimRules.circleRadiusTiles).toBe(TREASURE_CIRCLE_RADIUS_TILES);
    expect(TREASURE_CIRCLE_RADIUS_TILES).toBeLessThan(ENGAGEMENT_RANGE_TILES);
    expect(validateClaimRules(claimRules)).toEqual({ ok: true, value: claimRules });
  });

  it("allow a zero-tick channel, §5's instant victory on arrival", () => {
    expect(issuesOf({ ...claimRules, channelTicks: 0 })).toEqual([]);
  });

  it("refuse fractional, negative or missing durations, a bad radius and unknown fields", () => {
    expect(issuesOf({ ...claimRules, channelTicks: 1.5 })[0]).toMatch(/^channelTicks:/);
    expect(issuesOf({ ...claimRules, channelTicks: -1 })[0]).toMatch(/^channelTicks:/);
    expect(issuesOf({ ...claimRules, deadlineTicks: 0 })[0]).toMatch(/^deadlineTicks:/);
    expect(issuesOf({ ...claimRules, circleRadiusTiles: 0 })[0]).toMatch(/^circleRadiusTiles:/);
    expect(issuesOf({ channelTicks: 200, deadlineTicks: 42_000 })[0]).toMatch(/^circleRadiusTiles:/);
    expect(issuesOf({ ...claimRules, extra: 1 })).toHaveLength(1);
  });

  it("refuse a channel that could never complete before the deadline", () => {
    expect(issuesOf({ ...claimRules, channelTicks: 42_000 })).toEqual([
      "channelTicks: a channel of 42000 ticks cannot complete before the deadline (42000 ticks)",
    ]);
  });
});
