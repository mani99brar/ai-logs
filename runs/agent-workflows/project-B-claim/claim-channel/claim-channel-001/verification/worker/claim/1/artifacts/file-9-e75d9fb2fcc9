import { claimRules as defaultClaimRules, validateClaimRules, type ClaimRules } from "@pirate-sea-race/content/claim";
import { seaMap } from "@pirate-sea-race/content";

/** A point in integer sub-units. */
export interface ClaimPoint {
  readonly x: number;
  readonly y: number;
}

/** Static claim data for one match; the step reads it and it never changes. */
export interface ClaimConfig {
  /** The centre of the treasure circle on the final island. */
  readonly claimPoint: ClaimPoint;
  /** The treasure circle's radius in sub-units; a point exactly on it is inside. */
  readonly circleRadius: number;
  /** World ticks of held interact that complete a claim (0: the claim completes on the tick it starts). */
  readonly channelTicks: number;
  /** The world tick on which the match stops (§2). */
  readonly deadlineTick: number;
}

export interface ClaimConfigOptions {
  readonly claimPoint: ClaimPoint;
  /** The world tick on which player control starts; the deadline counts from it. */
  readonly controlStartTick?: number;
  readonly rules?: ClaimRules;
  readonly subUnitsPerTile?: number;
}

function requireInteger(value: number, name: string): void {
  if (!Number.isSafeInteger(value)) throw new RangeError(`${name} must be a safe integer, got ${value}`);
}

/** Builds a match's claim config from the content rules, refusing invalid rules. */
export function createClaimConfig(options: ClaimConfigOptions): ClaimConfig {
  const rules = validateClaimRules(options.rules ?? defaultClaimRules);
  if (!rules.ok) throw new RangeError(`invalid claim rules: ${rules.issues.join("; ")}`);
  const start = options.controlStartTick ?? 0;
  const subUnitsPerTile = options.subUnitsPerTile ?? seaMap.subUnitsPerTile;
  requireInteger(options.claimPoint.x, "claimPoint.x");
  requireInteger(options.claimPoint.y, "claimPoint.y");
  requireInteger(start, "controlStartTick");
  requireInteger(subUnitsPerTile, "subUnitsPerTile");
  if (start < 0) throw new RangeError(`controlStartTick must not be negative, got ${start}`);
  return {
    claimPoint: { x: options.claimPoint.x, y: options.claimPoint.y },
    circleRadius: rules.value.circleRadiusTiles * subUnitsPerTile,
    channelTicks: rules.value.channelTicks,
    deadlineTick: start + rules.value.deadlineTicks,
  };
}

/** The one active claim channel (§5). */
export interface ClaimChannel {
  readonly playerId: string;
  /** The tick the channel started on. */
  readonly startTick: number;
  /** Where the channeller stopped; any change of position is movement. */
  readonly x: number;
  readonly y: number;
  /** Ticks held since the start tick; the claim completes when this reaches `channelTicks`. */
  readonly progress: number;
}

export type ClaimResult =
  | { readonly reason: "claim"; readonly winner: string; readonly tick: number }
  | { readonly reason: "deadline"; readonly winner: null; readonly tick: number };

/** The claim state: plain integer data that `hashState` covers entirely. */
export interface ClaimState {
  /** The last world tick processed. */
  readonly tick: number;
  readonly channel: ClaimChannel | null;
  /** Set once, by a completed claim or the deadline; the state never changes afterwards. */
  readonly result: ClaimResult | null;
}

/** A state before any tick: the first step processes `tick + 1`. */
export function createClaimState(config: ClaimConfig, tick = 0): ClaimState {
  requireInteger(tick, "tick");
  if (tick >= config.deadlineTick) throw new RangeError(`the claim state must start before the deadline tick ${config.deadlineTick}`);
  return { tick, channel: null, result: null };
}

/** What the caller knows about one player on this tick. */
export interface ClaimPlayer {
  /** The stable player id; ties break on the lowest by UTF-16 code units. */
  readonly id: string;
  /** Position in sub-units. */
  readonly x: number;
  readonly y: number;
  /** Speed in sub-units per world tick; the player is stopped only at 0. */
  readonly speed: number;
  /** Holds all four rubbing types (from the ledger). */
  readonly holdsAllTypes: boolean;
  /** Holding interact on this tick. */
  readonly interact: boolean;
  readonly connected: boolean;
  /** Under spawn or return protection (§2, §6). Starting a claim ends it. */
  readonly protected: boolean;
}

/** An accepted encounter reservation: two players reserved for, or fighting, a duel (§6). */
export interface ClaimEncounter {
  readonly id: string;
  readonly playerIds: readonly [string, string];
}

/** One world tick's snapshot of the players that matter to the claim; order within the lists never matters. */
export interface ClaimTickInput {
  /** Must be the state's tick plus one. */
  readonly tick: number;
  /** A player absent from the list counts as disconnected. */
  readonly players: readonly ClaimPlayer[];
  /** Every encounter holding a reservation on this tick, newly accepted or still running. */
  readonly encounters: readonly ClaimEncounter[];
}

export type ClaimInterruptReason = "duel" | "disconnected" | "ineligible" | "moved" | "released" | "deadline";

/** Something that happened on a tick, for the caller to apply or announce. */
export type ClaimEvent =
  /** The channel reset to zero; `progress` is what was lost. */
  | { readonly kind: "claim-interrupted"; readonly tick: number; readonly playerId: string; readonly reason: ClaimInterruptReason; readonly progress: number }
  /** The player started a claim while protected: the caller must end their protection (§6). */
  | { readonly kind: "protection-ended"; readonly tick: number; readonly playerId: string }
  | { readonly kind: "claim-started"; readonly tick: number; readonly playerId: string }
  | { readonly kind: "claim-completed"; readonly tick: number; readonly playerId: string }
  /** The match ended with this encounter unresolved: the duel ends and no rubbing changes hands (§2). */
  | { readonly kind: "duel-ended-without-theft"; readonly tick: number; readonly encounterId: string; readonly playerIds: readonly [string, string] }
  /** The match is over; `winner` is null after a timeout (§2). */
  | { readonly kind: "match-ended"; readonly tick: number; readonly reason: "claim" | "deadline"; readonly winner: string | null };

export interface ClaimStepResult {
  readonly state: ClaimState;
  readonly events: readonly ClaimEvent[];
}
