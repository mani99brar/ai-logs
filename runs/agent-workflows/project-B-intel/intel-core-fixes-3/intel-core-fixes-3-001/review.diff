+  /** Control start and the first boundary: two snapshots, and no one's sighting spent. */
+  function ready(seed: number): IntelState {
+    const run = new Run(quickAlpha, seed);
+    run.step(START, world);
+    run.step(START + 100, world);
+    return run.state;
+  }
+  const fresh = (playerId: string, type: RubbingType): LeadTrigger => ({ playerId, type, free: { type, reason: "fresh", tick: T0 } });
+  const replacement = (playerId: string, type: RubbingType): LeadTrigger => ({ playerId, type, free: { type, reason: "replacement", tick: T0 } });
+  const paid = (requestId: string, playerId: string, type: RubbingType): LeadTrigger => ({ playerId, type, requestId });
+  /** The three phases on one ordering of the triggers. */
+  function phases(state: IntelState, triggers: readonly LeadTrigger[]) {
+    const decided = decideLeads(quickAlpha, state, view, gatherLeads(triggers));
+    return { decided, answers: Object.fromEntries([...answerRequests(decided.deliveries)].sort(([a], [b]) => (a < b ? -1 : 1))) };
+  }
