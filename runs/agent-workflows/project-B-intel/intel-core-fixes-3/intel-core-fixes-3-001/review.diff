+  const ids = [...rubbings.keys()];
+  for (let index = ids.length - 1; index > 0; index--) {
+    const other = draw(index + 1);
+    const a = rubbings.get(ids[index]!)!;
+    const b = rubbings.get(ids[other]!)!;
+    rubbings.set(a.id, { ...a, place: b.place });
+    rubbings.set(b.id, { ...b, place: a.place });
+  }
