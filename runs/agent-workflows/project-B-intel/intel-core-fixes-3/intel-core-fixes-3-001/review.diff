+  const script: IntelReplayTick[] = [];
+  let tick = 0;
+  while (tick < scenario.endTick) {
+    const dt = chance(scenario.skipPerMille) ? 2 + draw(39) : 1;
+    tick += dt;
+    for (const player of players.values()) {
+      if (chance(15)) player.heading = draw(8);
+      const [dx, dy] = DIRECTIONS[player.heading]!;
