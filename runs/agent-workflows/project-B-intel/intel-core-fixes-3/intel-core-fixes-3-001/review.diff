+
+const START = 60;
+const QUICK_RULES = { ...intelRules, carrierIntervalTicks: 100, sightingDelayTicks: 100, sectorRevealTicks: 1_200, carrierRevealTicks: 2_400 };
+
+const SCENARIOS: readonly Scenario[] = [
+  // The real constants past minute 28 and five more carrier intervals: 36,660 ticks after control start.
+  { name: "real times, slice", seed: 20260924, preset: "slice", realTimes: true, endTick: START + 36_660, skipPerMille: 0 },
+  { name: "quick, slice, seed 1", seed: 1, preset: "slice", realTimes: false, endTick: 3_400, skipPerMille: 0 },
+  { name: "quick, slice, seed 2", seed: 2, preset: "slice", realTimes: false, endTick: 3_400, skipPerMille: 0 },
+  { name: "quick, alpha, seed 3", seed: 3, preset: "alpha", realTimes: false, endTick: 3_400, skipPerMille: 0 },
+  // Reaches a sighting message with several types (a start trigger never asks for one, so fewer runs do).
+  { name: "quick, alpha, seed 27", seed: 27, preset: "alpha", realTimes: false, endTick: 3_400, skipPerMille: 0 },
+  { name: "quick, slice, skipping, seed 4", seed: 4, preset: "slice", realTimes: false, endTick: 3_400, skipPerMille: 300 },
+  { name: "quick, alpha, skipping, seed 5", seed: 5, preset: "alpha", realTimes: false, endTick: 3_400, skipPerMille: 300 },
