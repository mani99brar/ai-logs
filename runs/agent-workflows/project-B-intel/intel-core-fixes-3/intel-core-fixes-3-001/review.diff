+    // Leaving drops everything into a cache where the ship was; someone new may join.
+    if (chance(2) && players.size > 2) {
+      const id = pick(free);
+      if (id !== undefined) {
+        const player = players.get(id)!;
+        for (const rubbing of rubbings.values()) {
+          if (rubbing.place.kind === "carried" && rubbing.place.playerId === id) rubbings.set(rubbing.id, { ...rubbing, place: { kind: "cache", x: player.x, y: player.y } });
+        }
+        players.delete(id);
+      }
+    }
+    if (chance(2) && players.size < preset.maxPlayers) join();
+
+    const requests: TargetedRumorRequest[] = [];
+    if (tick > config.controlStartTick - 20 && chance(15)) {
+      const playerId = pick([...players.keys(), "nobody"])!;
+      const reuse = requestIds.length > 0 && chance(250);
+      const requestId = reuse ? requestIds[draw(requestIds.length)]! : `req-${requestIds.length}`;
+      if (!reuse) requestIds.push(requestId);
+      requests.push({ requestId, playerId, type: config.types[draw(config.types.length)]! });
+    }
+    const view: IntelWorldView = {
+      tick,
+      players: [...players].map(([id, player]) => ({ id, x: player.x, y: player.y })),
+      rubbings: [...rubbings.values()],
+    };
+    script.push(deepFreeze({ view, requests }));
+  }
+  return script;
+}
+
+/** What a view says, for checking messages against it. */
+interface Facts {
+  readonly players: ReadonlySet<string>;
+  readonly held: ReadonlyMap<string, readonly RubbingType[]>;
+  readonly sourceIslands: readonly { type: RubbingType; island: number }[];
+  readonly cacheSectors: readonly { type: RubbingType; sector: number }[];
+  readonly carriers: readonly { type: RubbingType; sector: number; holder: string }[];
+}
+
+function factsOf(config: IntelConfig, view: IntelWorldView): Facts {
+  const positions = new Map(view.players.map((player) => [player.id, player]));
+  const held = new Map<string, RubbingType[]>(view.players.map((player) => [player.id, []]));
+  const sourceIslands: { type: RubbingType; island: number }[] = [];
+  const cacheSectors: { type: RubbingType; sector: number }[] = [];
+  const carriers: { type: RubbingType; sector: number; holder: string }[] = [];
+  for (const rubbing of view.rubbings) {
+    const place = rubbing.place;
+    if (place.kind === "source") sourceIslands.push({ type: rubbing.type, island: place.island });
+    else if (place.kind === "cache") cacheSectors.push({ type: rubbing.type, sector: sectorOf(config, place) });
+    else {
+      held.get(place.playerId)!.push(rubbing.type);
+      carriers.push({ type: rubbing.type, sector: sectorOf(config, positions.get(place.playerId)!), holder: place.playerId });
+    }
+  }
+  return { players: new Set(positions.keys()), held, sourceIslands, cacheSectors, carriers };
+}
+
+/** The keys each message kind may carry: none is an id, and only `final-route` has a position. */
+const BODY_KEYS: Record<IntelMessageKind, readonly string[]> = {
+  rumor: ["entry", "kind", "reason", "target", "tick", "type"],
+  "carrier-sighting": ["kind", "seenTick", "sightings", "tick"],
+  "no-lead": ["kind", "reason", "tick", "type"],
+  "rumor-stale": ["entry", "kind", "tick", "type"],
+  "rumor-resolved": ["entry", "kind", "tick", "type"],
+  "final-sector": ["kind", "name", "sector", "tick"],
+  "final-route": ["kind", "restored", "tick", "x", "y"],
+  "final-route-inactive": ["kind", "tick"],
+  "sector-reveal": ["caches", "kind", "sources", "tick"],
+  "carrier-report": ["carriers", "kind", "seenTick", "tick"],
+};
+const BROADCASTS: ReadonlySet<IntelMessageKind> = new Set(["final-sector", "sector-reveal", "carrier-report"]);
+const NESTED_KEYS = new Set(["kind", "island", "sector", "name", "type", "reason"]);
+/** A start never asks for a sighting. */
+const SIGHTING_REASONS: ReadonlySet<string> = new Set(["fresh", "targeted", "replacement"]);
+
+/** Every kind, outcome and path the property runs must reach, filled as they run. */
+const EXERCISED = new Set<string>();
+const MUST_EXERCISE = [
+  ...Object.keys(BODY_KEYS).map((kind) => `message:${kind}`),
+  ...(["rumor", "sighting", "covered", "capped", "none", "duplicate"] satisfies TargetedRumorResult[]).map((result) => `outcome:${result}`),
+  ...["start", "fresh", "targeted", "replacement"].map((reason) => `rumor:${reason}`),
+  ...["fresh", "targeted", "replacement"].map((reason) => `sighting:${reason}`),
+  "rumor:island",
+  "rumor:sector",
+  "route:restored",
+  "sighting:deferred",
+  "sighting:deferred-delivered",
+  "sighting:several-types",
+  "sighting:free-deferred",
+  "sighting:free-same-step",
+  "skipped-ticks",
+];
+
+function allStrings(value: unknown, out: string[] = []): string[] {
+  if (typeof value === "string") out.push(value);
+  else if (Array.isArray(value)) for (const item of value) allStrings(item, out);
+  else if (typeof value === "object" && value !== null) for (const item of Object.values(value)) allStrings(item, out);
+  return out;
+}
+
+/**
+ * Checks every message of a run against the design's rules (§3, §5, §11, §16), with the views that produced them. It
+ * returns nothing and throws on the first violation, with the tick and message.
+ */
+class Checker {
+  private readonly rumors = new Map<string, { type: RubbingType; closed: boolean; target: unknown }>();
+  private readonly sightings = new Map<string, number>();
+  private readonly carriersAt = new Map<number, Facts["carriers"]>();
+  private readonly ids = new Set<string>();
+  private previousTick = -Infinity;
+  private previousState: IntelState | undefined;
+
+  constructor(
+    private readonly config: IntelConfig,
+    private readonly skipping: boolean,
+  ) {}
+
+  check(
+    view: IntelWorldView,
+    messages: readonly IntelMessage[],
+    state: IntelState,
+    requests: readonly TargetedRumorRequest[] = [],
+    outcomes: readonly TargetedRumorOutcome[] = [],
+  ): void {
+    const config = this.config;
+    const tick = view.tick;
+    if (tick - this.previousTick > 1 && this.previousTick >= config.controlStartTick) EXERCISED.add("skipped-ticks");
+    this.previousTick = tick;
+    const facts = factsOf(config, view);
+    this.carriersAt.set(tick, facts.carriers);
+    for (const player of view.players) this.ids.add(player.id);
+    for (const rubbing of view.rubbings) this.ids.add(rubbing.id);
+    if (state.players.some((player) => player.pending !== null)) EXERCISED.add("sighting:deferred");
+    const fail = (message: IntelMessage, why: string): never => {
+      throw new Error(`tick ${tick}: ${why}: ${JSON.stringify(message)}`);
+    };
+    if (tick < config.controlStartTick && messages.length > 0) fail(messages[0]!, "a message before control start");
+    // Who had already spent this snapshot's sighting before this step.
+    const snapshotIndex = Math.floor((tick - config.controlStartTick) / config.carrierIntervalTicks);
+    const cappedBefore = new Set(
+      tick >= config.controlStartTick && tick < config.carrierRevealTick ? [...facts.players].filter((id) => this.sightings.has(`${id}@${snapshotIndex}`)) : [],
+    );
+    const sightedThisStep = new Set<string>();
+    for (const message of messages) {
+      const body = message.body;
+      EXERCISED.add(`message:${body.kind}`);
+      if (body.tick !== tick) fail(message, "wrong tick");
+      // Keys: exactly the allowed ones, nested ones from the small sector/target vocabulary.
+      expect(Object.keys(body).sort()).toEqual([...BODY_KEYS[body.kind]]);
+      for (const nested of ["target", "sources", "caches", "carriers", "sightings"] as const) {
+        const value = (body as Record<string, unknown>)[nested];
+        if (value === undefined) continue;
+        for (const item of Array.isArray(value) ? value : [value]) {
+          for (const key of Object.keys(item as object)) if (!NESTED_KEYS.has(key)) fail(message, `nested key ${key}`);
+        }
+      }
+      // No id anywhere in a body.
+      for (const text of allStrings(body)) if (this.ids.has(text)) fail(message, `the id ${text} leaks`);
+      // Addressing: broadcasts to everyone, everything else to one player present now.
+      if (BROADCASTS.has(body.kind)) {
+        if (message.to.kind !== "everyone") fail(message, "a broadcast addressed to someone");
+        continue;
+      }
+      if (message.to.kind !== "player" || !facts.players.has(message.to.playerId)) fail(message, "not addressed to one present player");
+      const recipient = (message.to as { playerId: string }).playerId;
+      const held = facts.held.get(recipient)!;
+      const complete = config.types.every((type) => held.includes(type));
+      const key = (entry: number) => `${recipient}#${entry}`;
+      switch (body.kind) {
+        case "final-route":
+          // The only exact position ever sent, and only to a full-set holder.
+          if (!complete || body.x !== config.finalIsland.x || body.y !== config.finalIsland.y) fail(message, "a route to a player without a full set");
+          if (body.restored) EXERCISED.add("route:restored");
+          break;
+        case "final-route-inactive":
+          if (complete) fail(message, "a route suspended for a full set");
+          break;
+        case "rumor": {
+          EXERCISED.add(`rumor:${body.reason}`);
+          EXERCISED.add(`rumor:${body.target.kind}`);
+          if (held.includes(body.type)) fail(message, "a rumor for a held type");
+          const target = body.target;
+          const there =
+            target.kind === "island"
+              ? facts.sourceIslands.some((source) => source.type === body.type && source.island === target.island)
+              : facts.cacheSectors.some((cache) => cache.type === body.type && cache.sector === target.sector);
+          if (!there) fail(message, "a rumor pointing at nothing");
+          // Sources before caches: a cache lead only when no sealed source of the type is left outside the journal.
+          if (target.kind === "sector") {
+            const journaled = this.activeIslands(recipient, body.type);
+            if (facts.sourceIslands.some((source) => source.type === body.type && !journaled.has(source.island))) {
+              fail(message, "a cache rumor while an eligible sealed source existed");
+            }
+          }
+          if (this.rumors.has(key(body.entry))) fail(message, "a journal entry reused");
+          this.rumors.set(key(body.entry), { type: body.type, closed: false, target });
+          break;
+        }
+        case "rumor-stale":
+        case "rumor-resolved": {
+          // Only journal rumors close; a carrier sighting has no entry, so it can never go stale.
+          const rumor = this.rumors.get(key(body.entry));
+          if (rumor === undefined || rumor.closed || rumor.type !== body.type) fail(message, "closing no open journal rumor");
+          rumor!.closed = true;
+          if (body.kind === "rumor-resolved" && !held.includes(body.type)) fail(message, "resolved without the type");
+          if (body.kind === "rumor-stale") {
+            if (held.includes(body.type)) fail(message, "stale although the holder has the type");
+            const target = rumor!.target as { kind: "island"; island: number } | { kind: "sector"; sector: number };
+            const there =
+              target.kind === "island"
+                ? facts.sourceIslands.some((source) => source.type === body.type && source.island === target.island)
+                : facts.cacheSectors.some((cache) => cache.type === body.type && cache.sector === target.sector);
+            if (there) fail(message, "stale while the target still holds the type");
+          }
+          break;
+        }
+        case "carrier-sighting": {
+          if (body.sightings.length === 0) fail(message, "a sighting message with no sighting");
+          if (sightedThisStep.has(recipient)) fail(message, "a second sighting message in one step");
+          sightedThisStep.add(recipient);
+          if (new Set(body.sightings.map((sighting) => sighting.type)).size !== body.sightings.length) fail(message, "a type sighted twice in one message");
+          if (body.sightings.length > 1) EXERCISED.add("sighting:several-types");
+          if (body.seenTick >= tick) fail(message, "a sighting of the present");
+          const age = tick - body.seenTick;
+          const interval = config.carrierIntervalTicks;
+          if (!this.skipping && (age < interval || age >= 2 * interval)) fail(message, `a sighting ${age} ticks old`);
+          const then = this.carriersAt.get(body.seenTick);
+          if (then === undefined) fail(message, "a sighting of a tick never seen");
+          for (const sighting of body.sightings) {
+            if (!SIGHTING_REASONS.has(sighting.reason)) fail(message, `a sighting for the reason ${sighting.reason}`);
+            EXERCISED.add(`sighting:${sighting.reason}`);
+            if (held.includes(sighting.type)) fail(message, "a sighting for a held type");
+            if (!then!.some((carrier) => carrier.type === sighting.type && carrier.sector === sighting.sector && carrier.holder !== recipient)) {
+              fail(message, "a sighting of no other carrier");
+            }
+            // Carriers last: a sighting only when no source or cache of the type exists at all.
+            if (facts.sourceIslands.some((source) => source.type === sighting.type) || facts.cacheSectors.some((cache) => cache.type === sighting.type)) {
+              fail(message, "a carrier sighting while a source or cache existed");
+            }
+          }
+          if (tick < config.carrierRevealTick) {
+            const snapshot = `${recipient}@${Math.floor((tick - config.controlStartTick) / interval)}`;
+            const count = (this.sightings.get(snapshot) ?? 0) + 1;
+            if (count > 1) fail(message, "a second sighting message in one snapshot");
+            this.sightings.set(snapshot, count);
+          }
+          break;
+        }
+        case "no-lead":
+          if (held.includes(body.type)) fail(message, "a no-lead for a held type");
+          break;
+      }
+    }
+    this.checkCharges(tick, messages, requests, outcomes);
+    this.checkPending(tick, facts, messages, state);
+    this.checkFreeTriggers(tick, facts, messages, state, cappedBefore);
+    this.previousState = state;
+  }
+
+  /**
+   * Every free trigger of this step (a type lost, or a journal rumor gone stale) whose type needs a carrier sighting
+   * is in this step's sighting message or in the pending set, never in neither; and it waits only when the player's
+   * sighting was already spent in this snapshot or the previous snapshot shows no other carrier of it. The pending set
+   * then goes out at the next boundary (`checkPending`).
+   */
+  private checkFreeTriggers(tick: number, facts: Facts, messages: readonly IntelMessage[], state: IntelState, cappedBefore: ReadonlySet<string>): void {
+    const previous = this.previousState;
+    if (previous === undefined || !previous.started) return;
+    const older = state.snapshots.length === 2 ? state.snapshots[0]! : undefined;
+    const olderCarriers = older === undefined ? [] : this.carriersAt.get(older.tick)!;
+    for (const now of state.players) {
+      const before = previous.players.find((player) => player.id === now.id);
+      if (before === undefined) continue;
+      const held = facts.held.get(now.id)!;
+      const mine = messages.filter((message) => message.to.kind === "player" && message.to.playerId === now.id).map((message) => message.body);
+      const triggered = new Set([
+        ...before.held.filter((type) => !held.includes(type)),
+        ...mine.flatMap((body) => (body.kind === "rumor-stale" ? [body.type] : [])),
+      ]);
+      const sighted = new Set(mine.flatMap((body) => (body.kind === "carrier-sighting" ? body.sightings.map((sighting) => sighting.type) : [])));
+      for (const type of triggered) {
+        const needsSighting =
+          !held.includes(type) &&
+          !facts.sourceIslands.some((source) => source.type === type) &&
+          !facts.cacheSectors.some((cache) => cache.type === type) &&
+          facts.carriers.some((carrier) => carrier.type === type && carrier.holder !== now.id);
+        if (!needsSighting || sighted.has(type)) continue;
+        if (!(now.pending?.types.some((pending) => pending.type === type) ?? false)) throw new Error(`tick ${tick}: ${now.id}'s free ${type} trigger was neither sighted nor queued`);
+        const readable = olderCarriers.some((carrier) => carrier.type === type && carrier.holder !== now.id);
+        if (readable && !cappedBefore.has(now.id)) throw new Error(`tick ${tick}: ${now.id}'s free ${type} trigger waits although the sighting was not spent`);
+        EXERCISED.add("sighting:free-deferred");
+      }
+      if (sighted.size > 0 && [...triggered].some((type) => sighted.has(type))) EXERCISED.add("sighting:free-same-step");
+    }
+  }
+
+  /**
+   * Charging (§11): per (player, type), at most one request is charged (`rumor` or `sighting`), and only for a lead of
+   * that type sent in this step with the reason `targeted`. A request is `covered` only when this step sends that
+   * player a lead of that type, and never charged when that lead is free.
+   */
+  private checkCharges(tick: number, messages: readonly IntelMessage[], requests: readonly TargetedRumorRequest[], outcomes: readonly TargetedRumorOutcome[]): void {
+    const leads = new Map<string, string>();
+    for (const message of messages) {
+      if (message.to.kind !== "player") continue;
+      const body = message.body;
+      const found = body.kind === "rumor" ? [{ type: body.type, reason: body.reason, kind: "rumor" }] : body.kind === "carrier-sighting" ? body.sightings.map((sighting) => ({ ...sighting, kind: "sighting" })) : [];
+      for (const { type, reason, kind } of found) leads.set(`${message.to.playerId}/${type}`, `${kind}:${reason}`);
+    }
+    const charged = new Map<string, number>();
+    requests.forEach((request, index) => {
+      const result = outcomes[index]!.result;
+      const key = `${request.playerId}/${request.type}`;
+      const lead = leads.get(key);
+      const fail = (why: string): never => {
+        throw new Error(`tick ${tick}: request ${request.requestId} (${key}) ${result}: ${why}`);
+      };
+      if (result === "rumor" || result === "sighting") {
+        charged.set(key, (charged.get(key) ?? 0) + 1);
+        if (charged.get(key)! > 1) fail("charged twice for one (player, type)");
+        if (lead !== `${result}:targeted`) fail(`charged although the lead sent is ${lead ?? "nothing"}`);
+      } else if (result === "covered") {
+        if (lead === undefined) fail("covered by nothing");
+      }
+    });
+  }
+
+  /** The islands of the player's journal rumors for the type that are still open. */
+  private activeIslands(playerId: string, type: RubbingType): Set<number> {
+    const islands = new Set<number>();
+    for (const [key, rumor] of this.rumors) {
+      if (!key.startsWith(`${playerId}#`) || rumor.closed || rumor.type !== type) continue;
+      const target = rumor.target as { kind: string; island?: number };
+      if (target.kind === "island") islands.add(target.island!);
+    }
+    return islands;
+  }
+
+  /**
+   * After every step, each player has at most one pending sighting message holding a set of types. At the first
+   * boundary after a type was deferred, it goes out in a sighting, unless the checker finds it ineligible (held, a
+   * source or cache exists, or no one else carries it), or finds no other carrier of it in the previous snapshot to
+   * read, in which case it must still be pending.
+   */
+  private checkPending(tick: number, facts: Facts, messages: readonly IntelMessage[], state: IntelState): void {
+    const fail = (why: string): never => {
+      throw new Error(`tick ${tick}: ${why}`);
+    };
+    for (const player of state.players) {
+      if (player.pending === null) continue;
+      const types = player.pending.types.map((pending) => pending.type);
+      if (types.length === 0) fail(`${player.id} has an empty pending message`);
+      if (new Set(types).size !== types.length) fail(`${player.id} has a type pending twice`);
+    }
+    const previous = this.previousState;
+    const newest = state.snapshots.at(-1);
+    if (previous === undefined || newest === undefined || newest.boundary <= (previous.snapshots.at(-1)?.boundary ?? -1)) return;
+    const older = state.snapshots.length === 2 ? state.snapshots[0]! : undefined;
+    const olderCarriers = older === undefined ? [] : this.carriersAt.get(older.tick)!;
+    for (const before of previous.players) {
+      const now = state.players.find((player) => player.id === before.id);
+      if (before.pending === null || now === undefined) continue;
+      const sighted = new Set(
+        messages.flatMap((message) =>
+          message.to.kind === "player" && message.to.playerId === before.id && message.body.kind === "carrier-sighting"
+            ? message.body.sightings.map((sighting) => sighting.type)
+            : [],
+        ),
+      );
+      for (const { type } of before.pending.types) {
+        const stillPending = now.pending?.types.some((pending) => pending.type === type) ?? false;
+        const eligible =
+          !facts.held.get(before.id)!.includes(type) &&
+          !facts.sourceIslands.some((source) => source.type === type) &&
+          !facts.cacheSectors.some((cache) => cache.type === type) &&
+          facts.carriers.some((carrier) => carrier.type === type && carrier.holder !== before.id);
+        const readable = olderCarriers.some((carrier) => carrier.type === type && carrier.holder !== before.id);
+        if (sighted.has(type)) EXERCISED.add("sighting:deferred-delivered");
+        else if (eligible && readable) fail(`${before.id}'s deferred ${type} sighting was not delivered at the boundary`);
+        else if (eligible && !stillPending) fail(`${before.id}'s deferred ${type} sighting was dropped while eligible`);
+        else if (!eligible && stillPending) fail(`${before.id}'s deferred ${type} sighting is still pending although ineligible`);
+      }
+    }
+  }
+}
+
+/** A seeded shuffle, leaving the input as it is. */
+function shuffled<T>(items: readonly T[], draw: Draw): T[] {
+  const out = [...items];
+  for (let index = out.length - 1; index > 0; index--) {
+    const other = draw(index + 1);
+    [out[index], out[other]] = [out[other]!, out[index]!];
+  }
+  return out;
+}
+
+/**
+ * Adds purchases to a script so steps often carry several: one player buying one type twice, two players buying one
+ * type, and purchases on the same tick as losses and replacements. Ids stay unique within a step.
+ */
+function withPurchases(script: readonly IntelReplayTick[], config: IntelConfig, seed: number): IntelReplayTick[] {
+  const draw = generator(seed ^ 0x5eed);
+  let next = 0;
+  return script.map(({ view, requests }) => {
+    const extra: TargetedRumorRequest[] = [];
+    if (view.tick >= config.controlStartTick && view.players.length > 0 && draw(1000) < 120) {
+      const count = 2 + draw(4);
+      for (let index = 0; index < count; index++) {
+        const repeat = extra.length > 0 && draw(3) === 0 ? extra[draw(extra.length)]! : undefined;
+        const playerId = repeat !== undefined && draw(2) === 0 ? repeat.playerId : view.players[draw(view.players.length)]!.id;
+        const type = repeat?.type ?? config.types[draw(config.types.length)]!;
+        extra.push({ requestId: `buy-${next++}`, playerId, type });
+      }
+    }
+    return deepFreeze({ view, requests: [...(requests ?? []), ...extra] });
+  });
+}
+
+function setup(scenario: Scenario) {
+  const map = scenario.preset === "slice" ? SLICE_MAP : ALPHA_MAP;
+  const config = createIntelConfig({
+    preset: scenario.preset,
+    finalIsland: { x: (map.widthTiles * T) >> 1, y: ((map.heightTiles * T) >> 1) + 77 },
+    controlStartTick: START,
+    map,
+    ...(scenario.realTimes ? {} : { rules: QUICK_RULES }),
+  });
+  return { config, script: randomScript(scenario, config, map) };
+}
+
+describe("intel property runs (§3, §5, §11, §16)", () => {
+  for (const scenario of SCENARIOS) {
+    it(`keep every message within the rules: ${scenario.name}`, { timeout: 120_000 }, () => {
+      const { config, script } = setup(scenario);
+      if (scenario.realTimes && scenario.skipPerMille === 0) {
+        expect(config.carrierIntervalTicks).toBe(600);
+        expect(script.at(-1)!.view.tick - config.controlStartTick).toBeGreaterThanOrEqual(36_000);
+        expect(script.at(-1)!.view.tick).toBeGreaterThan(config.carrierRevealTick + 4 * config.carrierIntervalTicks);
+      }
+      const checker = new Checker(config, scenario.skipPerMille > 0);
+      let state = createIntelState(config, scenario.seed);
+      const kinds = new Set<string>();
+      const messages: IntelMessage[] = [];
+      for (const { view, requests } of script) {
+        // Frozen (views are frozen too), so a step that wrote into its input would throw.
+        const stepped = stepIntel(config, deepFreeze(state), view, requests ?? []);
+        messages.push(...stepped.messages);
+        expect(stepped.outcomes.map((outcome) => outcome.requestId)).toEqual((requests ?? []).map((request) => request.requestId));
+        for (const outcome of stepped.outcomes) EXERCISED.add(`outcome:${outcome.result}`);
+        checker.check(view, stepped.messages, stepped.state, requests ?? [], stepped.outcomes);
+        for (const message of stepped.messages) kinds.add(message.body.kind);
+        state = stepped.state;
+      }
+      // The run reached the reveals it spans.
+      expect(kinds.has("sector-reveal") && kinds.has("carrier-report")).toBe(true);
+      // Replaying the same script from the same seed reaches the same state.
+      const replayed = replayIntel(config, createIntelState(config, scenario.seed), script);
+      expect(replayed.hash).toBe(hashState(state));
+      expect(replayed.messages).toEqual(messages);
+    });
+  }
+
+  it("use compressed configs that the content validator accepts", () => {
+    expect(validateIntelRules(QUICK_RULES)).toEqual({ ok: true, value: QUICK_RULES });
+    expect(QUICK_RULES.carrierRevealTicks % QUICK_RULES.carrierIntervalTicks).toBe(0);
+  });
+
+  for (const scenario of SCENARIOS.filter((candidate) => !candidate.realTimes)) {
+    it(`give the same messages, outcomes and state for any order of a step's requests and view arrays: ${scenario.name}`, { timeout: 120_000 }, () => {
+      const { config, script: plain } = setup(scenario);
+      const script = withPurchases(plain, config, scenario.seed);
+      const draw = generator(scenario.seed ^ 0xa11ce);
+      const checker = new Checker(config, scenario.skipPerMille > 0);
+      const byRequestId = (outcomes: readonly TargetedRumorOutcome[]) => [...outcomes].sort((a, b) => (a.requestId < b.requestId ? -1 : a.requestId > b.requestId ? 1 : 0));
+      let listed = createIntelState(config, scenario.seed);
+      let permuted = listed;
+      let several = 0;
+      for (const { view, requests } of script) {
+        const asked = requests ?? [];
+        const shuffledView: IntelWorldView = { tick: view.tick, players: shuffled(view.players, draw), rubbings: shuffled(view.rubbings, draw) };
+        const a = stepIntel(config, listed, view, asked);
+        const b = stepIntel(config, permuted, shuffledView, shuffled(asked, draw));
+        expect(b.messages).toEqual(a.messages);
+        expect(byRequestId(b.outcomes)).toEqual(byRequestId(a.outcomes));
+        // The state hash on every step that asked or said something (hashing every quiet step too is slow), and at the end.
+        if (asked.length > 0 || a.messages.length > 0) expect(hashState(b.state)).toBe(hashState(a.state));
+        checker.check(view, a.messages, a.state, asked, a.outcomes);
+        for (const outcome of a.outcomes) EXERCISED.add(`outcome:${outcome.result}`);
+        if (asked.length > 1) several++;
+        listed = a.state;
+        permuted = b.state;
+      }
+      expect(hashState(permuted)).toBe(hashState(listed));
+      expect(several).toBeGreaterThan(20);
+    });
+  }
+
+  it("exercise every message kind, outcome and lead path (EXERCISED)", () => {
+    expect(MUST_EXERCISE.filter((path) => !EXERCISED.has(path))).toEqual([]);
+  });
+});
diff --git a/packages/simulation/src/intel/sectors.test.ts b/packages/simulation/src/intel/sectors.test.ts
new file mode 100644
index 0000000..4cb36c1
--- /dev/null
+++ b/packages/simulation/src/intel/sectors.test.ts
@@ -0,0 +1,82 @@
+import { seaMap } from "@pirate-sea-race/content";
+import { describe, expect, it } from "vitest";
+import { createIntelConfig, intelRules, SECTOR_NAMES, sectorName, sectorOf, sectorOfTile, type IntelConfig, type IntelMapShape } from "./index.js";
+
+function configFor(map: IntelMapShape): IntelConfig {
+  return createIntelConfig({ preset: "slice", finalIsland: { x: 0, y: 0 }, map });
+}
+
+/** The slice sea, a 12-island-sized sea and a small odd one: widths that 3 divides and ones it does not. */
+const MAPS: readonly IntelMapShape[] = [
+  seaMap,
+  { widthTiles: 300, heightTiles: 240, subUnitsPerTile: 256, islands: [] },
+  { widthTiles: 10, heightTiles: 7, subUnitsPerTile: 16, islands: [] },
+];
+
+describe("sectors", () => {
+  for (const map of MAPS) {
+    it(`put every tile of a ${map.widthTiles} × ${map.heightTiles} map, whole, into exactly one of nine sectors`, () => {
+      const config = configFor(map);
+      const counts = new Array<number>(9).fill(0);
+      const last = map.subUnitsPerTile - 1;
+      for (let tileY = 0; tileY < map.heightTiles; tileY++) {
+        for (let tileX = 0; tileX < map.widthTiles; tileX++) {
+          const sector = sectorOfTile(config, tileX, tileY);
+          expect(Number.isInteger(sector) && sector >= 0 && sector < 9).toBe(true);
+          counts[sector]!++;
+          // Every sub-unit corner of the tile falls in the tile's sector.
+          const x = tileX * map.subUnitsPerTile;
+          const y = tileY * map.subUnitsPerTile;
+          for (const [dx, dy] of [[0, 0], [last, 0], [0, last], [last, last]] as const) {
+            if (sectorOf(config, { x: x + dx, y: y + dy }) !== sector) throw new Error(`tile (${tileX}, ${tileY}) straddles two sectors`);
+          }
+        }
+      }
+      expect(counts.every((count) => count > 0)).toBe(true);
+      expect(counts.reduce((sum, count) => sum + count, 0)).toBe(map.widthTiles * map.heightTiles);
+      // Bands differ by at most one tile.
+      const widths = [0, 0, 0];
+      for (let tileX = 0; tileX < map.widthTiles; tileX++) widths[sectorOfTile(config, tileX, 0)]!++;
+      const heights = [0, 0, 0];
+      for (let tileY = 0; tileY < map.heightTiles; tileY++) heights[sectorOfTile(config, 0, tileY) / 3]!++;
+      expect(Math.max(...widths) - Math.min(...widths)).toBeLessThanOrEqual(1);
+      expect(Math.max(...heights) - Math.min(...heights)).toBeLessThanOrEqual(1);
+    });
+  }
+
+  it("cut the slice sea (224 × 208) at fixed tiles, row by row from the north-west", () => {
+    const config = configFor(seaMap);
+    expect([seaMap.widthTiles, seaMap.heightTiles]).toEqual([224, 208]);
+    // Column c starts at the first tile x with 3x ≥ 224c: 0, 75, 150. Row r at 3y ≥ 208r: 0, 70, 139.
+    expect([74, 75, 149, 150, 223].map((x) => sectorOfTile(config, x, 0))).toEqual([0, 1, 1, 2, 2]);
+    expect([69, 70, 138, 139, 207].map((y) => sectorOfTile(config, 0, y))).toEqual([0, 3, 3, 6, 6]);
+    expect(sectorOfTile(config, 100, 100)).toBe(4);
+    expect(sectorOf(config, { x: 75 * 256, y: 70 * 256 })).toBe(4);
+    expect(sectorOf(config, { x: 75 * 256 - 1, y: 70 * 256 - 1 })).toBe(0);
+  });
+
+  it("count a position off the map in the nearest edge sector, the same every time", () => {
+    const config = configFor(seaMap);
+    expect(sectorOf(config, { x: -1, y: -1 })).toBe(0);
+    expect(sectorOf(config, { x: -1_000_000, y: 1_000_000_000 })).toBe(6);
+    expect(sectorOf(config, { x: 1_000_000_000, y: 50 * 256 })).toBe(2);
+    expect(sectorOf(config, { x: 224 * 256, y: 208 * 256 })).toBe(8);
+  });
+
+  it("have nine unique names from the content", () => {
+    const config = configFor(seaMap);
+    const names = Array.from({ length: 9 }, (_, sector) => sectorName(config, sector));
+    expect(names).toEqual([...SECTOR_NAMES]);
+    expect(new Set(names).size).toBe(9);
+    expect(names[0]).toBe("North-West Reach");
+    expect(names[4]).toBe("Central Waters");
+    expect(() => sectorName(config, 9)).toThrow(RangeError);
+  });
+
+  it("refuse a map smaller than the grid, bad rules and a fractional control start", () => {
+    expect(() => configFor({ widthTiles: 2, heightTiles: 9, subUnitsPerTile: 256, islands: [] })).toThrow(RangeError);
+    expect(() => createIntelConfig({ preset: "slice", finalIsland: { x: 0, y: 0 }, rules: { ...intelRules, carrierIntervalTicks: 0 } })).toThrow(/invalid intel rules/);
+    expect(() => createIntelConfig({ preset: "slice", finalIsland: { x: 0, y: 0 }, controlStartTick: 1.5 })).toThrow(RangeError);
+    expect(() => createIntelConfig({ preset: "slice", finalIsland: { x: 0.5, y: 0 } })).toThrow(RangeError);
+  });
+});
diff --git a/packages/simulation/src/intel/state.ts b/packages/simulation/src/intel/state.ts
new file mode 100644
index 0000000..8369262
--- /dev/null
+++ b/packages/simulation/src/intel/state.ts
@@ -0,0 +1,340 @@
+import { rulesPresets, seaMap, type RulesPresetId } from "@pirate-sea-race/content";
+import { intelRules as defaultIntelRules, validateIntelRules, type IntelRules } from "@pirate-sea-race/content/intel";
+import { presetRubbingTypes, type RubbingType } from "@pirate-sea-race/content/objectives";
+
+/** A point in integer sub-units. */
+export interface IntelPoint {
+  readonly x: number;
+  readonly y: number;
+}
+
+/** Static information data for one match; the step reads it and it never changes. */
+export interface IntelConfig {
+  /** The preset's rubbing types, in the fixed type order. */
+  readonly types: readonly RubbingType[];
+  readonly widthTiles: number;
+  readonly heightTiles: number;
+  readonly subUnitsPerTile: number;
+  readonly sectorColumns: number;
+  readonly sectorRows: number;
+  /** Row by row from the north-west. */
+  readonly sectorNames: readonly string[];
+  /** Island names by island index, as rumors name them. */
+  readonly islandNames: readonly string[];
+  /** The world tick on which player control starts (§2); every reveal counts from it. */
+  readonly controlStartTick: number;
+  /** The final island's claim point: its sector goes to everyone, the point itself only to a full-set holder (§5). */
+  readonly finalIsland: IntelPoint;
+  /** The carrier snapshot beat, which is also the sighting delay and, from the carrier reveal, the broadcast beat. */
+  readonly carrierIntervalTicks: number;
+  /** Absolute world ticks of §2's minute-20 and minute-28 reveals. */
+  readonly sectorRevealTick: number;
+  readonly carrierRevealTick: number;
+}
+
+/** The map facts the sectors and rumors need; the content's `SeaMapDefinition` fits. */
+export interface IntelMapShape {
+  readonly widthTiles: number;
+  readonly heightTiles: number;
+  readonly subUnitsPerTile: number;
+  readonly islands: readonly { readonly name: string }[];
+}
+
+export interface IntelConfigOptions {
+  readonly preset: RulesPresetId;
+  readonly finalIsland: IntelPoint;
+  readonly controlStartTick?: number;
+  /** Defaults to the slice sea. */
+  readonly map?: IntelMapShape;
+  readonly rules?: IntelRules;
+}
+
+export function requireInteger(value: unknown, name: string): void {
+  if (typeof value !== "number" || !Number.isSafeInteger(value)) throw new RangeError(`${name} must be a safe integer, got ${String(value)}`);
+}
+
+export function requireId(value: unknown, name: string): void {
+  if (typeof value !== "string" || value.length === 0) throw new RangeError(`${name} must be a non-empty string`);
+}
+
+/** Builds a match's information config from the content rules and the map, refusing invalid rules or maps. */
+export function createIntelConfig(options: IntelConfigOptions): IntelConfig {
+  const rules = validateIntelRules(options.rules ?? defaultIntelRules);
+  if (!rules.ok) throw new RangeError(`invalid intel rules: ${rules.issues.join("; ")}`);
+  const map = options.map ?? seaMap;
+  const start = options.controlStartTick ?? 0;
+  requireInteger(start, "controlStartTick");
+  if (start < 0) throw new RangeError(`controlStartTick must not be negative, got ${start}`);
+  for (const [value, name] of [
+    [map.widthTiles, "widthTiles"],
+    [map.heightTiles, "heightTiles"],
+    [map.subUnitsPerTile, "subUnitsPerTile"],
+  ] as const) {
+    requireInteger(value, name);
+    if (value <= 0) throw new RangeError(`${name} must be positive, got ${value}`);
+  }
+  if (map.widthTiles < rules.value.sectorColumns || map.heightTiles < rules.value.sectorRows) {
+    throw new RangeError(`a ${map.widthTiles} × ${map.heightTiles} map cannot hold ${rules.value.sectorColumns} × ${rules.value.sectorRows} sectors`);
+  }
+  requireInteger(options.finalIsland.x, "finalIsland.x");
+  requireInteger(options.finalIsland.y, "finalIsland.y");
+  return {
+    types: presetRubbingTypes(rulesPresets[options.preset]),
+    widthTiles: map.widthTiles,
+    heightTiles: map.heightTiles,
+    subUnitsPerTile: map.subUnitsPerTile,
+    sectorColumns: rules.value.sectorColumns,
+    sectorRows: rules.value.sectorRows,
+    sectorNames: [...rules.value.sectorNames],
+    islandNames: map.islands.map((island) => island.name),
+    controlStartTick: start,
+    finalIsland: { x: options.finalIsland.x, y: options.finalIsland.y },
+    carrierIntervalTicks: rules.value.carrierIntervalTicks,
+    sectorRevealTick: start + rules.value.sectorRevealTicks,
+    carrierRevealTick: start + rules.value.carrierRevealTicks,
+  };
+}
+
+/**
+ * The sector of a tile: the map's columns and rows are cut into `sectorColumns` × `sectorRows` bands by integer
+ * division, so every tile lies in exactly one sector and the bands differ in width by at most one tile.
+ */
+export function sectorOfTile(config: IntelConfig, tileX: number, tileY: number): number {
+  const x = Math.min(Math.max(tileX, 0), config.widthTiles - 1);
+  const y = Math.min(Math.max(tileY, 0), config.heightTiles - 1);
+  const column = Math.floor((x * config.sectorColumns) / config.widthTiles);
+  const row = Math.floor((y * config.sectorRows) / config.heightTiles);
+  return row * config.sectorColumns + column;
+}
+
+/** The sector of a sub-unit position: that of its tile. A position off the map counts in the nearest edge sector. */
+export function sectorOf(config: IntelConfig, position: IntelPoint): number {
+  return sectorOfTile(config, Math.floor(position.x / config.subUnitsPerTile), Math.floor(position.y / config.subUnitsPerTile));
+}
+
+export function sectorName(config: IntelConfig, sector: number): string {
+  const name = config.sectorNames[sector];
+  if (name === undefined) throw new RangeError(`there is no sector ${sector}`);
+  return name;
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// The world view: what the caller (the match room, from the ledger) tells the step on each tick.
+
+/**
+ * Where a rubbing is, as the ledger's `location` reads once resolved: sealed at a source (its island and position),
+ * in a recovery cache (its position), owned by a player, or reserved for a player in an unresolved duel.
+ */
+export type IntelRubbingPlace =
+  | { readonly kind: "source"; readonly island: number; readonly x: number; readonly y: number }
+  | { readonly kind: "cache"; readonly x: number; readonly y: number }
+  | { readonly kind: "carried"; readonly playerId: string }
+  | { readonly kind: "duel"; readonly playerId: string };
+
+export interface IntelRubbing {
+  readonly id: string;
+  readonly type: RubbingType;
+  readonly place: IntelRubbingPlace;
+}
+
+/** A player still in the match and their ship's position; a carried rubbing is where its carrier is. */
+export interface IntelPlayerView {
+  readonly id: string;
+  readonly x: number;
+  readonly y: number;
+}
+
+/**
+ * One world tick as the information rules see it. A player's held types are the types of the rubbings carried by or
+ * reserved for them, so they cannot disagree with the rubbings; an island is claimed out when no source on it is sealed.
+ */
+export interface IntelWorldView {
+  /** Later than the state's tick; ticks may be skipped. */
+  readonly tick: number;
+  readonly players: readonly IntelPlayerView[];
+  readonly rubbings: readonly IntelRubbing[];
+}
+
+/** A request to buy a targeted rumor (§11). The caller charges the gold only for a `rumor` or `sighting` outcome. */
+export interface TargetedRumorRequest {
+  readonly requestId: string;
+  readonly playerId: string;
+  readonly type: RubbingType;
+}
+
+/**
+ * `rumor` and `sighting` deliver something and are charged. `covered` is not charged: this step already gives the
+ * player that type for free (a free trigger's rumor or sighting), or another request of the same player and type, lower
+ * by request id, bought it. `capped`, `none` and `duplicate` deliver nothing.
+ */
+export type TargetedRumorResult = "rumor" | "sighting" | "covered" | "capped" | "none" | "duplicate";
+
+export interface TargetedRumorOutcome {
+  readonly requestId: string;
+  readonly result: TargetedRumorResult;
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// The state.
+
+/** A journal rumor points at an island (a sealed source) or at a sector (a recovery cache), never at a carrier. */
+export type IntelLeadTarget = { readonly kind: "island"; readonly island: number } | { readonly kind: "sector"; readonly sector: number };
+
+export type IntelLeadReason = "start" | "fresh" | "targeted" | "replacement";
+
+/** The three triggers that may ask for a carrier sighting; a start never does. */
+export type CarrierSightingReason = Exclude<IntelLeadReason, "start">;
+
+/** One journal entry. `entry` numbers a player's rumors from 1. */
+export interface JournalRumor {
+  readonly entry: number;
+  readonly type: RubbingType;
+  readonly target: IntelLeadTarget;
+  readonly reason: IntelLeadReason;
+  readonly tick: number;
+  /** `stale` once the target no longer holds that type; `resolved` once the holder has the type. */
+  readonly status: "active" | "stale" | "resolved";
+  readonly closedTick: number | null;
+}
+
+/** One type of a deferred sighting: the free trigger (a loss or a journal replacement) that asked for it and when. */
+export interface PendingSightingType {
+  readonly type: RubbingType;
+  readonly reason: "fresh" | "replacement";
+  readonly tick: number;
+}
+
+/**
+ * The one deferred carrier-sighting message a player may have: the types whose free trigger met the cap, or found no
+ * snapshot entry to read, waiting for the next snapshot boundary. A step's capped free triggers add their types to the set.
+ */
+export interface PendingSighting {
+  /** In type order, each type once, never empty. */
+  readonly types: readonly PendingSightingType[];
+}
+
+export interface IntelPlayerState {
+  readonly id: string;
+  /** The held types as of the last processed tick, in type order; losses and completions are diffs of these. */
+  readonly held: readonly RubbingType[];
+  readonly journal: readonly JournalRumor[];
+  /** Whether the player's final-island route is active (they hold a full set) and whether they ever had one. */
+  readonly routeActive: boolean;
+  readonly routeEver: boolean;
+  /** The boundary of the snapshot current when the player last got a carrier sighting, or -1. */
+  readonly lastSightingBoundary: number;
+  /** The deferred sighting message, or null. */
+  readonly pending: PendingSighting | null;
+}
+
+/** One carried copy at a snapshot. The holder is kept only so a player is never shown their own copy. */
+export interface CarrierSnapshotEntry {
+  readonly sector: number;
+  readonly type: RubbingType;
+  readonly holder: string;
+}
+
+export interface CarrierSnapshot {
+  /** k for the boundary `controlStartTick + k × carrierIntervalTicks`. */
+  readonly boundary: number;
+  /** The tick whose world view it records (the boundary tick unless ticks were skipped). */
+  readonly tick: number;
+  readonly entries: readonly CarrierSnapshotEntry[];
+}
+
+/** The information state: plain integer data that `hashState` covers entirely. */
+export interface IntelState {
+  /** The last world tick processed. */
+  readonly tick: number;
+  /** The seed of every draw: each (player, type) decision draws from a generator keyed by it, the tick, the player and the type. */
+  readonly rng: number;
+  /** Whether control start has been processed. */
+  readonly started: boolean;
+  /** Players seen in the last view, by id. */
+  readonly players: readonly IntelPlayerState[];
+  /** The latest two snapshots, older first. */
+  readonly snapshots: readonly CarrierSnapshot[];
+  readonly finalSectorAnnounced: boolean;
+  readonly sectorRevealed: boolean;
+  /** The index j of the last carrier broadcast (`carrierRevealTick + j × carrierIntervalTicks`), or -1. */
+  readonly lastCarrierBroadcast: number;
+  /** Every targeted request id answered so far, sorted. */
+  readonly requestIds: readonly string[];
+}
+
+/** A state before any tick. `tick` must come before control start, so control start is always crossed. */
+export function createIntelState(config: IntelConfig, seed: number, tick = -1): IntelState {
+  requireInteger(seed, "seed");
+  requireInteger(tick, "tick");
+  if (tick >= config.controlStartTick) throw new RangeError(`the intel state must start before control start (tick ${config.controlStartTick})`);
+  return {
+    tick,
+    rng: seed >>> 0,
+    started: false,
+    players: [],
+    snapshots: [],
+    finalSectorAnnounced: false,
+    sectorRevealed: false,
+    lastCarrierBroadcast: -1,
+    requestIds: [],
+  };
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Messages: every one names its recipients. Bodies never carry a player id, a rubbing id or an exact position, except
+// the final island's point in a `final-route` to a player holding a full set.
+
+export type IntelRecipients =
+  | { readonly kind: "player"; readonly playerId: string }
+  | { readonly kind: "players"; readonly playerIds: readonly string[] }
+  | { readonly kind: "everyone" };
+
+export interface SectorRef {
+  readonly sector: number;
+  readonly name: string;
+}
+
+export type IntelRumorTarget =
+  | { readonly kind: "island"; readonly island: number; readonly name: string }
+  | { readonly kind: "sector"; readonly sector: number; readonly name: string };
+
+/** One type of a carrier-sighting message, with the trigger that asked for it. */
+export interface CarrierSighting {
+  readonly type: RubbingType;
+  readonly reason: CarrierSightingReason;
+  readonly sector: number;
+  readonly name: string;
+}
+
+export type IntelMessageBody =
+  /** A journal lead toward a missing type. */
+  | { readonly kind: "rumor"; readonly tick: number; readonly entry: number; readonly type: RubbingType; readonly reason: IntelLeadReason; readonly target: IntelRumorTarget }
+  /** One-shot: per type, the sector where a carrier of it was at `seenTick` (the previous snapshot). Never tracked. */
+  | { readonly kind: "carrier-sighting"; readonly tick: number; readonly seenTick: number; readonly sightings: readonly CarrierSighting[] }
+  /** A free trigger found nothing to point at. */
+  | { readonly kind: "no-lead"; readonly tick: number; readonly type: RubbingType; readonly reason: IntelLeadReason }
+  | { readonly kind: "rumor-stale"; readonly tick: number; readonly entry: number; readonly type: RubbingType }
+  | { readonly kind: "rumor-resolved"; readonly tick: number; readonly entry: number; readonly type: RubbingType }
+  /** A first full set exists: the final island's broad sector (§5). */
+  | { readonly kind: "final-sector"; readonly tick: number; readonly sector: number; readonly name: string }
+  /** The exact route, to a full-set holder only; `restored` after a lost set is whole again. */
+  | { readonly kind: "final-route"; readonly tick: number; readonly x: number; readonly y: number; readonly restored: boolean }
+  | { readonly kind: "final-route-inactive"; readonly tick: number }
+  /** Minute 20: sectors holding sealed sources and recovery caches. */
+  | { readonly kind: "sector-reveal"; readonly tick: number; readonly sources: readonly SectorRef[]; readonly caches: readonly SectorRef[] }
+  /** Minute 28 on: the carriers' sectors and types at the latest snapshot. */
+  | { readonly kind: "carrier-report"; readonly tick: number; readonly seenTick: number; readonly carriers: readonly (SectorRef & { readonly type: RubbingType })[] };
+
+export type IntelMessageKind = IntelMessageBody["kind"];
+
+export interface IntelMessage {
+  readonly to: IntelRecipients;
+  readonly body: IntelMessageBody;
+}
+
+export interface IntelStepResult {
+  readonly state: IntelState;
+  readonly messages: readonly IntelMessage[];
+  /** One per request, in the order given. */
+  readonly outcomes: readonly TargetedRumorOutcome[];
+}
diff --git a/packages/simulation/src/intel/step.ts b/packages/simulation/src/intel/step.ts
new file mode 100644
index 0000000..ab60896
--- /dev/null
+++ b/packages/simulation/src/intel/step.ts
@@ -0,0 +1,686 @@
+import { rubbingTypeOrder, type RubbingType } from "@pirate-sea-race/content/objectives";
+import { fnv1a64, hashState } from "../hash.js";
+import { nextInt } from "../random.js";
+import {
+  requireId,
+  requireInteger,
+  sectorName,
+  sectorOf,
+  type CarrierSighting,
+  type CarrierSnapshot,
+  type CarrierSnapshotEntry,
+  type IntelConfig,
+  type IntelLeadReason,
+  type IntelLeadTarget,
+  type IntelMessage,
+  type IntelMessageBody,
+  type IntelPlayerState,
+  type IntelPlayerView,
+  type IntelState,
+  type IntelStepResult,
+  type IntelWorldView,
+  type JournalRumor,
+  type PendingSighting,
+  type PendingSightingType,
+  type SectorRef,
+  type TargetedRumorOutcome,
+  type TargetedRumorRequest,
+  type TargetedRumorResult,
+} from "./state.js";
+
+/** Lowest id by UTF-16 code units, independent of locale. */
+function compareIds(a: string, b: string): number {
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+function byTypeOrder(a: RubbingType, b: RubbingType): number {
+  return rubbingTypeOrder(a) - rubbingTypeOrder(b);
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Reading the world view.
+
+interface WorldIndex {
+  readonly tick: number;
+  readonly players: ReadonlyMap<string, IntelPlayerView>;
+  /** Each player's held types (carried or reserved in a duel), in type order. */
+  readonly held: ReadonlyMap<string, readonly RubbingType[]>;
+  readonly sources: readonly { readonly type: RubbingType; readonly island: number; readonly sector: number }[];
+  readonly caches: readonly { readonly type: RubbingType; readonly sector: number }[];
+  readonly carriers: readonly CarrierSnapshotEntry[];
+}
+
+/** Refuses a malformed view: a tick not after `after`, duplicate ids, unknown types, islands or carriers, a doubled type. */
+function readView(config: IntelConfig, view: IntelWorldView, after: number): WorldIndex {
+  requireInteger(view.tick, "tick");
+  if (view.tick <= after) throw new RangeError(`expected a tick after ${after}, got ${view.tick}`);
+  const players = new Map<string, IntelPlayerView>();
+  for (const player of view.players) {
+    requireId(player.id, "player id");
+    if (players.has(player.id)) throw new RangeError(`player ${player.id} appears twice`);
+    requireInteger(player.x, `${player.id}.x`);
+    requireInteger(player.y, `${player.id}.y`);
+    players.set(player.id, player);
+  }
+  const ids = new Set<string>();
+  const held = new Map<string, RubbingType[]>([...players.keys()].map((id) => [id, []]));
+  const sources: { type: RubbingType; island: number; sector: number }[] = [];
+  const caches: { type: RubbingType; sector: number }[] = [];
+  const carriers: CarrierSnapshotEntry[] = [];
+  for (const rubbing of view.rubbings) {
+    requireId(rubbing.id, "rubbing id");
+    if (ids.has(rubbing.id)) throw new RangeError(`rubbing ${rubbing.id} appears twice`);
+    ids.add(rubbing.id);
+    if (!config.types.includes(rubbing.type)) throw new RangeError(`rubbing ${rubbing.id} has a type outside the preset: ${String(rubbing.type)}`);
+    const place = rubbing.place;
+    switch (place.kind) {
+      case "source":
+        requireInteger(place.island, `${rubbing.id} island`);
+        if (place.island < 0 || place.island >= config.islandNames.length) throw new RangeError(`rubbing ${rubbing.id} names an unknown island ${place.island}`);
+        requireInteger(place.x, `${rubbing.id}.x`);
+        requireInteger(place.y, `${rubbing.id}.y`);
+        sources.push({ type: rubbing.type, island: place.island, sector: sectorOf(config, place) });
+        break;
+      case "cache":
+        requireInteger(place.x, `${rubbing.id}.x`);
+        requireInteger(place.y, `${rubbing.id}.y`);
+        caches.push({ type: rubbing.type, sector: sectorOf(config, place) });
+        break;
+      case "carried":
+      case "duel": {
+        const holder = players.get(place.playerId);
+        if (holder === undefined) throw new RangeError(`rubbing ${rubbing.id} is with ${String(place.playerId)}, who is not in the view`);
+        const types = held.get(holder.id)!;
+        if (types.includes(rubbing.type)) throw new RangeError(`player ${holder.id} holds two ${rubbing.type} rubbings`);
+        types.push(rubbing.type);
+        carriers.push({ sector: sectorOf(config, holder), type: rubbing.type, holder: holder.id });
+        break;
+      }
+      default:
+        throw new RangeError(`rubbing ${rubbing.id} has an unknown place`);
+    }
+  }
+  for (const types of held.values()) types.sort(byTypeOrder);
+  carriers.sort((a, b) => a.sector - b.sector || byTypeOrder(a.type, b.type) || compareIds(a.holder, b.holder));
+  return { tick: view.tick, players, held, sources, caches, carriers };
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Planning a lead: sealed sources first, then caches, then a carrier sighting when every other copy is carried.
+
+type LeadPlan =
+  | { readonly kind: "journal"; readonly options: readonly { readonly type: RubbingType; readonly target: IntelLeadTarget }[] }
+  | {
+      readonly kind: "carrier";
+      /** The wanted types whose every copy is carried by someone else. */
+      readonly types: readonly RubbingType[];
+      /** Before the carrier reveal, one sighting message per player per snapshot. */
+      readonly capped: boolean;
+      /** Distinct (type, sector) pairs from the previous snapshot, the player's own entries left out. */
+      readonly options: readonly { readonly type: RubbingType; readonly sector: number }[];
+      readonly seenTick: number;
+    }
+  | { readonly kind: "none" };
+
+interface LeadHolder {
+  readonly id: string;
+  readonly journal: readonly JournalRumor[];
+  readonly lastSightingBoundary: number;
+}
+
+function sameTarget(a: IntelLeadTarget, b: IntelLeadTarget): boolean {
+  return a.kind === "island" ? b.kind === "island" && a.island === b.island : b.kind === "sector" && a.sector === b.sector;
+}
+
+function uniqueSorted(values: readonly number[]): number[] {
+  return [...new Set(values)].sort((a, b) => a - b);
+}
+
+function planLead(
+  config: IntelConfig,
+  world: WorldIndex,
+  snapshots: readonly CarrierSnapshot[],
+  player: LeadHolder,
+  types: readonly RubbingType[],
+): LeadPlan {
+  const held = world.held.get(player.id) ?? [];
+  const wanted = config.types.filter((type) => types.includes(type) && !held.includes(type));
+  const active = player.journal.filter((rumor) => rumor.status === "active");
+  const fresh = (type: RubbingType, target: IntelLeadTarget) => !active.some((rumor) => rumor.type === type && sameTarget(rumor.target, target));
+
+  const islands = wanted.flatMap((type) =>
+    uniqueSorted(world.sources.filter((source) => source.type === type).map((source) => source.island))
+      .map((island) => ({ type, target: { kind: "island", island } as const }))
+      .filter((option) => fresh(option.type, option.target)),
+  );
+  if (islands.length > 0) return { kind: "journal", options: islands };
+  const sectors = wanted.flatMap((type) =>
+    uniqueSorted(world.caches.filter((cache) => cache.type === type).map((cache) => cache.sector))
+      .map((sector) => ({ type, target: { kind: "sector", sector } as const }))
+      .filter((option) => fresh(option.type, option.target)),
+  );
+  if (sectors.length > 0) return { kind: "journal", options: sectors };
+
+  const carried = wanted.filter(
+    (type) =>
+      !world.sources.some((source) => source.type === type) &&
+      !world.caches.some((cache) => cache.type === type) &&
+      world.carriers.some((carrier) => carrier.type === type && carrier.holder !== player.id),
+  );
+  if (carried.length === 0) return { kind: "none" };
+  const newest = snapshots.at(-1);
+  const older = snapshots.length === 2 ? snapshots[0]! : undefined;
+  const capped = world.tick < config.carrierRevealTick && newest !== undefined && player.lastSightingBoundary === newest.boundary;
+  const options: { type: RubbingType; sector: number }[] = [];
+  for (const entry of older?.entries ?? []) {
+    if (entry.holder === player.id || !carried.includes(entry.type)) continue;
+    if (!options.some((option) => option.type === entry.type && option.sector === entry.sector)) options.push({ type: entry.type, sector: entry.sector });
+  }
+  options.sort((a, b) => byTypeOrder(a.type, b.type) || a.sector - b.sector);
+  return { kind: "carrier", types: carried, capped, options, seenTick: older?.tick ?? -1 };
+}
+
+/**
+ * What buying a targeted rumor for `type` would yield for `playerId` now, from the state after its last step and the
+ * world view of that tick or a later one, without drawing. A step on a later tick can differ only if it first crosses a
+ * snapshot boundary. A free trigger of the same player and type in that step makes the purchase `covered` instead.
+ */
+export function targetedRumorAvailability(
+  config: IntelConfig,
+  state: IntelState,
+  view: IntelWorldView,
+  playerId: string,
+  type: RubbingType,
+): Exclude<TargetedRumorResult, "duplicate" | "covered"> {
+  const world = readView(config, view, state.tick - 1);
+  if (!state.started || !world.players.has(playerId) || !config.types.includes(type)) return "none";
+  const player = state.players.find((candidate) => candidate.id === playerId) ?? { id: playerId, journal: [], lastSightingBoundary: -1 };
+  return targetedResult(planLead(config, world, state.snapshots, player, [type]));
+}
+
+function targetedResult(plan: LeadPlan): Exclude<TargetedRumorResult, "duplicate" | "covered"> {
+  if (plan.kind === "journal") return "rumor";
+  if (plan.kind === "none") return "none";
+  if (plan.capped) return "capped";
+  return plan.options.length > 0 ? "sighting" : "none";
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// The three lead phases of a step: gather every trigger by (player, type), decide each entry, answer the requests.
+
+/** A trigger for a lead: a free one (a loss, a journal replacement, a pending type at a boundary) or a paid request. */
+export type LeadTrigger =
+  | { readonly playerId: string; readonly type: RubbingType; readonly free: PendingSightingType }
+  | { readonly playerId: string; readonly type: RubbingType; readonly requestId: string };
+
+/** One (player, type) of a step: the free trigger it keeps, if any, and the ids of its requests, sorted. */
+export interface LeadEntry {
+  readonly playerId: string;
+  readonly type: RubbingType;
+  readonly free: PendingSightingType | null;
+  readonly requestIds: readonly string[];
+}
+
+/** The earliest free trigger wins, then `fresh` before `replacement`, so the arrival order never picks the reason. */
+function compareFree(a: PendingSightingType, b: PendingSightingType): number {
+  return a.tick - b.tick || (a.reason === b.reason ? 0 : a.reason === "fresh" ? -1 : 1);
+}
+
+function compareEntries(a: { playerId: string; type: RubbingType }, b: { playerId: string; type: RubbingType }): number {
+  return compareIds(a.playerId, b.playerId) || byTypeOrder(a.type, b.type);
+}
+
+/** Phase 1: the step's triggers as a set keyed by (player, type), sorted by player id then type order. */
+export function gatherLeads(triggers: readonly LeadTrigger[]): LeadEntry[] {
+  const entries = new Map<string, { playerId: string; type: RubbingType; free: PendingSightingType | null; requestIds: Set<string> }>();
+  for (const trigger of triggers) {
+    const key = `${trigger.playerId}\u0000${trigger.type}`;
+    let entry = entries.get(key);
+    if (entry === undefined) entries.set(key, (entry = { playerId: trigger.playerId, type: trigger.type, free: null, requestIds: new Set() }));
+    if ("free" in trigger) {
+      if (entry.free === null || compareFree(trigger.free, entry.free) < 0) entry.free = trigger.free;
+    } else entry.requestIds.add(trigger.requestId);
+  }
+  return [...entries.values()]
+    .map(({ playerId, type, free, requestIds }) => ({ playerId, type, free, requestIds: [...requestIds].sort(compareIds) }))
+    .sort(compareEntries);
+}
+
+/**
+ * What one (player, type) entry got: `free` when a free trigger's (or the start's) rumor or sighting gave the player
+ * that type, `rumor` or `sighting` when only its requests asked, otherwise `capped` or `none`.
+ */
+export type LeadDelivery = "free" | "rumor" | "sighting" | "capped" | "none";
+
+/** One decided lead message, in decision order: per player by id, the start first, then its entries in type order. */
+export type DecidedLead =
+  | { readonly kind: "rumor"; readonly playerId: string; readonly type: RubbingType; readonly target: IntelLeadTarget; readonly reason: IntelLeadReason }
+  | { readonly kind: "no-lead"; readonly playerId: string; readonly type: RubbingType; readonly reason: IntelLeadReason };
+
+export interface LeadDecisions {
+  readonly leads: readonly DecidedLead[];
+  /** At most one sighting message per player, by player id, its types in type order. */
+  readonly sightings: readonly { readonly playerId: string; readonly seenTick: number; readonly sightings: readonly CarrierSighting[] }[];
+  readonly deliveries: readonly (LeadEntry & { readonly delivery: LeadDelivery })[];
+  /** The pending sighting of each player with an entry, after the step. */
+  readonly pending: ReadonlyMap<string, PendingSighting | null>;
+}
+
+interface DecisionHolder extends LeadHolder {
+  readonly pending: PendingSighting | null;
+}
+
+/** An integer in [0, bound) from a generator keyed by the seed and a decision's key, not by any other decision. */
+function keyedDraw(seed: number, key: string, bound: number): number {
+  return nextInt(Number.parseInt(fnv1a64(`${seed >>> 0}\u0000${key}`).slice(8), 16) >>> 0, bound).value;
+}
+
+/**
+ * Phase 2: decides each entry from the world view and the older snapshot. A starting player's start rumor comes first.
+ * Each draw is keyed by (seed, tick, player, type), or by the older snapshot's tick for a sighting's sector among the
+ * sorted candidates, so neither the order of the entries nor any other player's entries change a decision.
+ */
+function decide(
+  config: IntelConfig,
+  world: WorldIndex,
+  snapshots: readonly CarrierSnapshot[],
+  seed: number,
+  holders: ReadonlyMap<string, DecisionHolder>,
+  entries: readonly LeadEntry[],
+  starting: ReadonlySet<string>,
+): LeadDecisions {
+  const tick = world.tick;
+  const leads: DecidedLead[] = [];
+  const sightings: { playerId: string; seenTick: number; sightings: CarrierSighting[] }[] = [];
+  const deliveries: (LeadEntry & { delivery: LeadDelivery })[] = [];
+  const pending = new Map<string, PendingSighting | null>();
+  const sorted = [...entries].sort(compareEntries);
+  const playerIds = [...new Set([...starting, ...sorted.map((entry) => entry.playerId)])].sort(compareIds);
+  for (const playerId of playerIds) {
+    const known = holders.get(playerId);
+    const journal: JournalRumor[] = [...(known?.journal ?? [])];
+    const holder: LeadHolder = { id: playerId, journal, lastSightingBoundary: known?.lastSightingBoundary ?? -1 };
+    const held = world.held.get(playerId) ?? [];
+    const rumor = (plan: Extract<LeadPlan, { kind: "journal" }>, key: string, reason: IntelLeadReason): RubbingType => {
+      const { type, target } = plan.options[keyedDraw(seed, `${tick}\u0000${playerId}\u0000${key}`, plan.options.length)]!;
+      journal.push({ entry: journal.length + 1, type, target, reason, tick, status: "active", closedTick: null });
+      leads.push({ kind: "rumor", playerId, type, target, reason });
+      return type;
+    };
+    // A starting rumor points at a source or a cache of any missing type, never at a carrier; otherwise a no-lead.
+    let startType: RubbingType | null = null;
+    if (starting.has(playerId)) {
+      const plan = planLead(config, world, snapshots, holder, config.types);
+      if (plan.kind === "journal") startType = rumor(plan, "start", "start");
+      else {
+        const lacking = config.types.filter((type) => !held.includes(type));
+        if (lacking.length > 0) leads.push({ kind: "no-lead", playerId, type: lacking[0]!, reason: "start" });
+      }
+    }
+    const mine = sorted.filter((entry) => entry.playerId === playerId);
+    const carried: LeadEntry[] = [];
+    for (const entry of mine) {
+      if (entry.type === startType) {
+        deliveries.push({ ...entry, delivery: "free" });
+        continue;
+      }
+      const plan = planLead(config, world, snapshots, holder, [entry.type]);
+      if (plan.kind === "journal") {
+        rumor(plan, entry.type, entry.free?.reason ?? "targeted");
+        deliveries.push({ ...entry, delivery: entry.free !== null ? "free" : "rumor" });
+      } else if (plan.kind === "carrier") carried.push(entry);
+      else {
+        if (entry.free !== null && !held.includes(entry.type)) leads.push({ kind: "no-lead", playerId, type: entry.type, reason: entry.free.reason });
+        deliveries.push({ ...entry, delivery: "none" });
+      }
+    }
+    if (mine.length === 0) continue;
+    // One sighting decision for the player: uncapped, one message lists every type the older snapshot can answer.
+    let sent: RubbingType[] = [];
+    let capped = false;
+    if (carried.length > 0) {
+      const plan = planLead(config, world, snapshots, holder, carried.map((entry) => entry.type));
+      if (plan.kind !== "carrier") throw new Error(`the sighting types of ${playerId} no longer need a sighting`);
+      capped = plan.capped;
+      if (!capped) sent = carried.map((entry) => entry.type).filter((type) => plan.options.some((option) => option.type === type));
+      if (sent.length > 0) {
+        sightings.push({
+          playerId,
+          seenTick: plan.seenTick,
+          sightings: sent.map((type) => {
+            const entry = carried.find((candidate) => candidate.type === type)!;
+            const sectors = plan.options.filter((option) => option.type === type).map((option) => option.sector);
+            const sector = sectors[keyedDraw(seed, `${plan.seenTick}\u0000${playerId}\u0000${type}`, sectors.length)]!;
+            return { type, reason: entry.free?.reason ?? "targeted", sector, name: sectorName(config, sector) };
+          }),
+        });
+      }
+    }
+    for (const entry of carried) {
+      deliveries.push({ ...entry, delivery: sent.includes(entry.type) ? (entry.free !== null ? "free" : "sighting") : capped ? "capped" : "none" });
+    }
+    // The free types not sent keep waiting in the one pending set; a paid type is never queued.
+    const kept = (known?.pending?.types ?? []).filter((waiting) => !sent.includes(waiting.type));
+    for (const entry of carried) {
+      if (entry.free !== null && !sent.includes(entry.type) && !kept.some((waiting) => waiting.type === entry.type)) kept.push(entry.free);
+    }
+    kept.sort((a, b) => byTypeOrder(a.type, b.type));
+    pending.set(playerId, kept.length > 0 ? { types: kept } : null);
+  }
+  deliveries.sort(compareEntries);
+  return { leads, sightings, deliveries, pending };
+}
+
+/**
+ * Phase 2 from outside a step: decides `entries` against a state whose snapshots are current (as after a step) and the
+ * world view of that tick or a later one. `starting` lists the players whose start rumor is decided too.
+ */
+export function decideLeads(
+  config: IntelConfig,
+  state: IntelState,
+  view: IntelWorldView,
+  entries: readonly LeadEntry[],
+  starting: readonly string[] = [],
+): LeadDecisions {
+  const world = readView(config, view, state.tick - 1);
+  return decide(config, world, state.snapshots, state.rng, new Map(state.players.map((player) => [player.id, player])), entries, new Set(starting));
+}
+
+/**
+ * Phase 3: the requests of each (player, type), by request id. A free delivery covers them all; a paid one goes to the
+ * first and covers the rest; with nothing delivered, all get the same `capped` or `none`. Only `rumor` and `sighting`
+ * are charged, and one player's requests never change another's.
+ */
+export function answerRequests(deliveries: readonly { readonly requestIds: readonly string[]; readonly delivery: LeadDelivery }[]): Map<string, TargetedRumorResult> {
+  const results = new Map<string, TargetedRumorResult>();
+  for (const { requestIds, delivery } of deliveries) {
+    [...requestIds].sort(compareIds).forEach((requestId, index) => {
+      results.set(requestId, delivery === "free" ? "covered" : delivery === "rumor" || delivery === "sighting" ? (index === 0 ? delivery : "covered") : delivery);
+    });
+  }
+  return results;
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// The step.
+
+interface WorkingPlayer {
+  id: string;
+  held: readonly RubbingType[];
+  journal: JournalRumor[];
+  routeActive: boolean;
+  routeEver: boolean;
+  lastSightingBoundary: number;
+  pending: PendingSighting | null;
+}
+
+function working(player: IntelPlayerState): WorkingPlayer {
+  return { ...player, journal: [...player.journal] };
+}
+
+function frozen(player: WorkingPlayer): IntelPlayerState {
+  return {
+    id: player.id,
+    held: [...player.held],
+    journal: player.journal,
+    routeActive: player.routeActive,
+    routeEver: player.routeEver,
+    lastSightingBoundary: player.lastSightingBoundary,
+    pending: player.pending,
+  };
+}
+
+function sectorRef(config: IntelConfig, sector: number): SectorRef {
+  return { sector, name: sectorName(config, sector) };
+}
+
+/** The latest boundary `origin + k × interval` at or before `tick`, or -1 before `origin`. */
+function boundaryIndex(tick: number, origin: number, interval: number): number {
+  return tick < origin ? -1 : Math.floor((tick - origin) / interval);
+}
+
+/**
+ * One world tick of the information rules, in a fixed order:
+ *
+ * 1. Crossing a carrier boundary (every interval from control start) takes a snapshot of the carried copies; the
+ *    latest two are kept.
+ * 2. Per player, by id: the diff of held types resolves rumors for types gained; rumors whose target was emptied go
+ *    stale; a completed or broken full set announces the final sector and sends or suspends the route.
+ * 3. The leads, in three phases. Gather: every trigger joins a set keyed by (player, type): a type lost, a stale
+ *    rumor's replacement, a pending type at a boundary, a targeted request. Decide: per player by id, a starting
+ *    rumor first (never a sighting), then each entry in type order: a journal rumor, a no-lead, or its type joins the
+ *    player's one sighting decision (one message listing every type the older snapshot can answer, or, capped, the free
+ *    types wait as the one pending set). Answer: each (player, type)'s requests by request id (`answerRequests`).
+ * 4. The minute-20 sector reveal and the minute-28 carrier broadcasts, when their boundary was crossed.
+ *
+ * Every draw is keyed by (seed, tick, player, type), so no decision depends on the order of the triggers, requests or
+ * view arrays. Boundaries fire when crossed since the last processed tick, so a skipped tick never loses one. Before
+ * control start only the held types are tracked, and no message is sent. The input state is never mutated.
+ */
+export function stepIntel(
+  config: IntelConfig,
+  state: IntelState,
+  view: IntelWorldView,
+  requests: readonly TargetedRumorRequest[] = [],
+): IntelStepResult {
+  const world = readView(config, view, state.tick);
+  for (const request of requests) {
+    requireId(request.requestId, "request id");
+    requireId(request.playerId, "request player id");
+    if (typeof request.type !== "string") throw new RangeError(`request ${request.requestId} has no type`);
+  }
+  const tick = world.tick;
+  const messages: IntelMessage[] = [];
+  const toPlayer = (playerId: string, body: IntelMessageBody) => messages.push({ to: { kind: "player", playerId }, body });
+  const toEveryone = (body: IntelMessageBody) => messages.push({ to: { kind: "everyone" }, body });
+
+  const previous = new Map(state.players.map((player) => [player.id, player]));
+  const players: WorkingPlayer[] = [...world.players.keys()].sort(compareIds).map((id) => {
+    const known = previous.get(id);
+    return known
+      ? working(known)
+      : { id, held: [], journal: [], routeActive: false, routeEver: false, lastSightingBoundary: -1, pending: null };
+  });
+
+  // Requests: an id seen before is a duplicate and touches nothing. A new id listed twice in one batch is recorded
+  // once, for its lowest (player, type), so the listing order never picks it; the others are duplicates.
+  const seen = new Set(state.requestIds);
+  const chosen = new Map<string, number>();
+  requests.forEach((request, index) => {
+    if (seen.has(request.requestId)) return;
+    const other = chosen.get(request.requestId);
+    if (other === undefined || compareEntries(request, requests[other]!) < 0) chosen.set(request.requestId, index);
+  });
+  const outcomes = new Map<number, TargetedRumorResult>();
+  const accepted: { index: number; request: TargetedRumorRequest }[] = [];
+  requests.forEach((request, index) => {
+    if (chosen.get(request.requestId) === index) accepted.push({ index, request });
+    else outcomes.set(index, "duplicate");
+  });
+  const requestIds = chosen.size === 0 ? state.requestIds : [...state.requestIds, ...chosen.keys()].sort(compareIds);
+  const answer = (): TargetedRumorOutcome[] => requests.map((request, index) => ({ requestId: request.requestId, result: outcomes.get(index)! }));
+
+  if (tick < config.controlStartTick) {
+    for (const { index } of accepted) outcomes.set(index, "none");
+    for (const player of players) player.held = world.held.get(player.id)!;
+    return { state: { ...state, tick, players: players.map(frozen), requestIds }, messages, outcomes: answer() };
+  }
+
+  // 1. Carrier snapshots.
+  let snapshots = state.snapshots;
+  const boundary = boundaryIndex(tick, config.controlStartTick, config.carrierIntervalTicks);
+  const crossedBoundary = boundary > (snapshots.at(-1)?.boundary ?? -1);
+  if (crossedBoundary) snapshots = [...snapshots, { boundary, tick, entries: world.carriers }].slice(-2);
+
+  // 2. Players; their free triggers are gathered for step 3.
+  const triggers: LeadTrigger[] = [];
+  const starting = new Set<string>();
+  const startCrossed = !state.started;
+  let finalAnnounced = state.finalSectorAnnounced;
+  for (const player of players) {
+    const held = world.held.get(player.id)!;
+    if (startCrossed || !previous.has(player.id)) {
+      player.held = held;
+      starting.add(player.id);
+    } else {
+      const gained = held.filter((type) => !player.held.includes(type));
+      const lost = player.held.filter((type) => !held.includes(type));
+      player.held = held;
+      // Types obtained retire their rumors quietly and cancel their deferred sightings.
+      player.journal = player.journal.map((rumor) => {
+        if (rumor.status !== "active" || !gained.includes(rumor.type)) return rumor;
+        toPlayer(player.id, { kind: "rumor-resolved", tick, entry: rumor.entry, type: rumor.type });
+        return { ...rumor, status: "resolved", closedTick: tick };
+      });
+      const stillWanted = player.pending?.types.filter((pending) => !held.includes(pending.type)) ?? [];
+      player.pending = stillWanted.length > 0 ? { types: stillWanted } : null;
+      // At a boundary the pending types are decided again with this step's other triggers.
+      if (crossedBoundary) {
+        player.pending = null;
+        for (const pending of stillWanted) triggers.push({ playerId: player.id, type: pending.type, free: pending });
+      }
+      // §11: a free fresh rumor for each type lost. Entering a duel is no loss: reserved copies still count as held.
+      for (const type of lost) triggers.push({ playerId: player.id, type, free: { type, reason: "fresh", tick } });
+    }
+
+    // Journal rumors whose island or cache sector no longer holds the type go stale, then get a replacement.
+    player.journal = player.journal.map((rumor) => {
+      if (rumor.status !== "active") return rumor;
+      const { target } = rumor;
+      const holds =
+        target.kind === "island"
+          ? world.sources.some((source) => source.type === rumor.type && source.island === target.island)
+          : world.caches.some((cache) => cache.type === rumor.type && cache.sector === target.sector);
+      if (holds) return rumor;
+      toPlayer(player.id, { kind: "rumor-stale", tick, entry: rumor.entry, type: rumor.type });
+      triggers.push({ playerId: player.id, type: rumor.type, free: { type: rumor.type, reason: "replacement", tick } });
+      return { ...rumor, status: "stale", closedTick: tick };
+    });
+
+    // §5: the first full set announces the final sector to everyone; each holder gets the route while the set is whole.
+    const complete = config.types.every((type) => held.includes(type));
+    if (complete && !player.routeActive) {
+      if (!finalAnnounced) {
+        finalAnnounced = true;
+        const sector = sectorOf(config, config.finalIsland);
+        toEveryone({ kind: "final-sector", tick, sector, name: sectorName(config, sector) });
+      }
+      toPlayer(player.id, { kind: "final-route", tick, x: config.finalIsland.x, y: config.finalIsland.y, restored: player.routeEver });
+      player.routeActive = true;
+      player.routeEver = true;
+    } else if (!complete && player.routeActive) {
+      toPlayer(player.id, { kind: "final-route-inactive", tick });
+      player.routeActive = false;
+    }
+  }
+
+  // 3. Leads. Gather: targeted requests (§11) join the free triggers by (player, type).
+  const byId = new Map(players.map((player) => [player.id, player]));
+  const requestIndex = new Map<string, number>();
+  for (const { index, request } of accepted) {
+    if (!byId.has(request.playerId) || !config.types.includes(request.type)) outcomes.set(index, "none");
+    else {
+      requestIndex.set(request.requestId, index);
+      triggers.push({ playerId: request.playerId, type: request.type, requestId: request.requestId });
+    }
+  }
+  const entries = gatherLeads(triggers);
+  // Decide.
+  const decided = decide(config, world, snapshots, state.rng, byId, entries, starting);
+  for (const lead of decided.leads) {
+    const player = byId.get(lead.playerId)!;
+    if (lead.kind === "no-lead") {
+      toPlayer(player.id, { kind: "no-lead", tick, type: lead.type, reason: lead.reason });
+      continue;
+    }
+    const { type, target, reason } = lead;
+    const entry = player.journal.length + 1;
+    player.journal.push({ entry, type, target, reason, tick, status: "active", closedTick: null });
+    toPlayer(player.id, {
+      kind: "rumor",
+      tick,
+      entry,
+      type,
+      reason,
+      target:
+        target.kind === "island"
+          ? { kind: "island", island: target.island, name: config.islandNames[target.island]! }
+          : { kind: "sector", sector: target.sector, name: sectorName(config, target.sector) },
+    });
+  }
+  // A sighting message spends the player's sighting for this snapshot.
+  for (const { playerId, seenTick, sightings } of decided.sightings) {
+    byId.get(playerId)!.lastSightingBoundary = snapshots.at(-1)!.boundary;
+    toPlayer(playerId, { kind: "carrier-sighting", tick, seenTick, sightings });
+  }
+  for (const [playerId, pending] of decided.pending) byId.get(playerId)!.pending = pending;
+  // Answer.
+  for (const [requestId, result] of answerRequests(decided.deliveries)) outcomes.set(requestIndex.get(requestId)!, result);
+
+  // 4. Timed reveals (§2).
+  let sectorRevealed = state.sectorRevealed;
+  if (!sectorRevealed && tick >= config.sectorRevealTick) {
+    sectorRevealed = true;
+    toEveryone({
+      kind: "sector-reveal",
+      tick,
+      sources: uniqueSorted(world.sources.map((source) => source.sector)).map((sector) => sectorRef(config, sector)),
+      caches: uniqueSorted(world.caches.map((cache) => cache.sector)).map((sector) => sectorRef(config, sector)),
+    });
+  }
+  let lastCarrierBroadcast = state.lastCarrierBroadcast;
+  const broadcast = boundaryIndex(tick, config.carrierRevealTick, config.carrierIntervalTicks);
+  if (broadcast > lastCarrierBroadcast) {
+    lastCarrierBroadcast = broadcast;
+    const newest = snapshots.at(-1)!;
+    const carriers: (SectorRef & { type: RubbingType })[] = [];
+    for (const entry of newest.entries) {
+      if (!carriers.some((carrier) => carrier.sector === entry.sector && carrier.type === entry.type)) {
+        carriers.push({ ...sectorRef(config, entry.sector), type: entry.type });
+      }
+    }
+    toEveryone({ kind: "carrier-report", tick, seenTick: newest.tick, carriers });
+  }
+
+  return {
+    state: {
+      tick,
+      rng: state.rng,
+      started: true,
+      players: players.map(frozen),
+      snapshots,
+      finalSectorAnnounced: finalAnnounced,
+      sectorRevealed,
+      lastCarrierBroadcast,
+      requestIds,
+    },
+    messages,
+    outcomes: answer(),
+  };
+}
+
+export interface IntelReplayTick {
+  readonly view: IntelWorldView;
+  readonly requests?: readonly TargetedRumorRequest[];
+}
+
+export interface IntelReplay {
+  readonly state: IntelState;
+  readonly messages: readonly IntelMessage[];
+  readonly outcomes: readonly TargetedRumorOutcome[];
+  readonly hash: string;
+}
+
+/** Steps a sequence of views from a state, collecting every message and outcome; `hash` is the final `hashState`. */
+export function replayIntel(config: IntelConfig, state: IntelState, ticks: readonly IntelReplayTick[]): IntelReplay {
+  let current = state;
+  const messages: IntelMessage[] = [];
+  const outcomes: TargetedRumorOutcome[] = [];
+  for (const { view, requests } of ticks) {
+    const stepped = stepIntel(config, current, view, requests ?? []);
+    current = stepped.state;
+    messages.push(...stepped.messages);
+    outcomes.push(...stepped.outcomes);
+  }
+  return { state: current, messages, outcomes, hash: hashState(current) };
+}
