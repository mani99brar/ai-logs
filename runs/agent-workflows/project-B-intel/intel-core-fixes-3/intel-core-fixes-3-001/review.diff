+++ b/packages/simulation/src/intel/intel.test.ts
@@ -0,0 +1,978 @@
+import { describe, expect, it } from "vitest";
+import {
+  answerRequests,
+  createIntelConfig,
+  createIntelState,
+  decideLeads,
+  gatherLeads,
+  hashState,
+  intelRules,
+  replayIntel,
+  stepIntel,
+  targetedRumorAvailability,
+  type CarrierSightingReason,
+  type IntelConfig,
+  type IntelMessage,
+  type IntelMessageBody,
+  type IntelPoint,
+  type IntelRubbing,
+  type IntelState,
+  type IntelStepResult,
+  type IntelWorldView,
+  type LeadTrigger,
+  type RubbingType,
+  type TargetedRumorRequest,
+} from "./index.js";
+
+const T = 256;
+const tile = (x: number, y: number): IntelPoint => ({ x: x * T + 128, y: y * T + 128 });
+/** A 30 × 30 test sea: sector bands are tiles 0–9, 10–19 and 20–29. Islands sit in the four corner sectors. */
+const MAP = {
+  widthTiles: 30,
+  heightTiles: 30,
+  subUnitsPerTile: T,
