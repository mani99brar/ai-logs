+        const held = heldTypes(id);
+        const target = pick([...rubbings.values()].filter((rubbing) => rubbing.place.kind === "cache" && !held.includes(rubbing.type)));
+        if (target !== undefined) rubbings.set(target.id, { ...target, place: { kind: "carried", playerId: id } });
+      }
