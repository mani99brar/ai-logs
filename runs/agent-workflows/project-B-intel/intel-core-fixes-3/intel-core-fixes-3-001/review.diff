+/**
+ * A seeded match seen from outside: ships sail and turn, players collect sealed sources and claim caches, fight duels
+ * (reserving their rubbings) that end in a theft or a draw, leave (their rubbings go into a cache where they were)
+ * and join, and buy targeted rumors, sometimes repeating a request id. Some scenarios jump several ticks at once.
+ */
+function randomScript(scenario: Scenario, config: IntelConfig, map: IntelMapShape): IntelReplayTick[] {
+  const draw = generator(scenario.seed);
+  const chance = (perMille: number) => draw(1000) < perMille;
+  const preset = rulesPresets[scenario.preset];
+  const width = map.widthTiles * T;
+  const height = map.heightTiles * T;
