import { rubbingTypeOrder, type RubbingType } from "@pirate-sea-race/content/objectives";
import { fnv1a64, hashState } from "../hash.js";
import { nextInt } from "../random.js";
import {
  requireId,
  requireInteger,
  sectorName,
  sectorOf,
  type CarrierSighting,
  type CarrierSnapshot,
  type CarrierSnapshotEntry,
  type IntelConfig,
  type IntelLeadReason,
  type IntelLeadTarget,
  type IntelMessage,
  type IntelMessageBody,
  type IntelPlayerState,
  type IntelPlayerView,
  type IntelState,
  type IntelStepResult,
  type IntelWorldView,
  type JournalRumor,
  type PendingSighting,
  type PendingSightingType,
  type SectorRef,
  type TargetedRumorOutcome,
