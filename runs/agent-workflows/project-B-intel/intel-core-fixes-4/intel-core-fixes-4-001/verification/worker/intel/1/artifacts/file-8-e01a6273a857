type Draw = (bound: number) => number;

function generator(seed: number): Draw {
  let rng = seed >>> 0;
  return (bound) => {
    const drawn = nextInt(rng, bound);
    rng = drawn.state;
    return drawn.value;
  };
}

/** Recursively frozen, so a step that mutated its input would throw. */
function deepFreeze<T>(value: T): T {
  if (typeof value === "object" && value !== null && !Object.isFrozen(value)) {
    Object.freeze(value);
    for (const child of Object.values(value)) deepFreeze(child);
  }
  return value;
}

const T = 256;
/** A slice-sized sea with four islands, and an alpha-sized one with twelve on a 4 × 3 grid. */
const SLICE_MAP: IntelMapShape = { widthTiles: 224, heightTiles: 208, subUnitsPerTile: T, islands: ["Palm Key", "Ash Isle", "Mist Rock", "Old Ruin"].map((name) => ({ name })) };
const ALPHA_MAP: IntelMapShape = { widthTiles: 300, heightTiles: 240, subUnitsPerTile: T, islands: Array.from({ length: 12 }, (_, index) => ({ name: `Isle ${index + 1}` })) };

function islandPoint(map: IntelMapShape, island: number): { x: number; y: number } {
  const columns = map.islands.length === 4 ? 2 : 4;
  const rows = map.islands.length / columns;
  const column = island % columns;
  const row = Math.floor(island / columns);
  return {
    x: Math.floor(((2 * column + 1) * map.widthTiles * T) / (2 * columns)),
    y: Math.floor(((2 * row + 1) * map.heightTiles * T) / (2 * rows)),
  };
}

